+# Follow package input links in the staging tree before looking at an image.
+# A package-owned target must never be satisfied by an older installed file.
+function input_image(DSO,    path, logical, parent, link, seen, lines, count, depth) {
+	path = DSO
+	if (path !~ /^\//) path = destdir prefix "/" path
+	path = normalize(path)
+	for (depth = 0; depth < 40; depth++) {
+		if (path in seen) { print DSO ": symbolic link cycle"; return "" }
+		seen[path] = 1
+		if (system("test -L " shquote(path)) != 0) return path
+		if (readlink_cmd == "") { print DSO ": missing selected readlink"; return "" }
+		count = tool_lines(readlink_cmd " " shquote(path), lines)
+		if (count != 1) { print DSO ": cannot read symbolic link"; return "" }
+		link = lines[1]
+		logical = path
+		if (destdir != "" && index(logical, destdir "/") == 1)
+			logical = substr(logical, length(destdir) + 1)
+		if (link ~ /^\//) logical = normalize(link)
+		else {
+			parent = logical; sub(/\/[^\/]*$/, "", parent)
+			logical = normalize(parent "/" link)
+		}
+		if ((logical in owned_paths) || system("test -L " shquote(destdir logical)) == 0 || exists(destdir logical))
+			path = destdir logical
+		else path = logical
+	}
+	print DSO ": symbolic link depth exceeded"
+	return ""
+}
