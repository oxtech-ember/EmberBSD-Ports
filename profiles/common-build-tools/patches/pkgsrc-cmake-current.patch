+CONFIGURE_ARGS+=	-DLibArchive_LIBRARY:FILEPATH=${BUILDLINK_PREFIX.libarchive}/lib${LIBABISUFFIX}/libarchive.dylib
+.  endif
+.  if ${USE_BUILTIN.libuv:U:tl} != "yes"
+CONFIGURE_ARGS+=	-DLibUV_INCLUDE_DIR:PATH=${BUILDLINK_PREFIX.libuv}/include
+CONFIGURE_ARGS+=	-DLibUV_LIBRARY:FILEPATH=${BUILDLINK_PREFIX.libuv}/lib${LIBABISUFFIX}/libuv.dylib
+.  endif
+.  if ${USE_BUILTIN.curl:U:tl} != "yes"
+CONFIGURE_ARGS+=	-DCURL_INCLUDE_DIR:PATH=${BUILDLINK_PREFIX.curl}/include
+CONFIGURE_ARGS+=	-DCURL_LIBRARY_RELEASE:FILEPATH=${BUILDLINK_PREFIX.curl}/lib${LIBABISUFFIX}/libcurl.dylib
+.  endif
+.endif
 .include "../../mk/atomic64.mk"
 .include "../../mk/curses.buildlink3.mk"
 
