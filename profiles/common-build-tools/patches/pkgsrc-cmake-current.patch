@@ -0,0 +1,35 @@
+$NetBSD$
+
+Origin: EmberBSD (AI-assisted), not submitted upstream.
+Use the same deployment-target guard for the header and API selection.
+GCC does not implement Clang's __builtin_available extension.
+
+--- Source/cmMachO.cxx.orig
++++ Source/cmMachO.cxx
+@@ -374,15 +374,15 @@
+     for (auto const& header : this->Headers) {
+       char const* archName = "unknown";
+ #if __MAC_OS_X_VERSION_MIN_REQUIRED >= 130000
+-      if (__builtin_available(macOS 13.0, *)) {
++      {
+         if (char const* archNameForCpuType = (header.CpuType & CPU_TYPE_ARM)
+               ? macho_arch_name_for_cpu_type(header.CpuType, header.CpuSubType)
+               : macho_arch_name_for_cpu_type(header.CpuType,
+                                              CPU_SUBTYPE_MULTIPLE)) {
+           archName = archNameForCpuType;
+         }
+-      } else
+-#endif
++      }
++#else
+       {
+ #if defined __clang__
+ #  define CM_MACOS_DEPRECATED_NXGetArchInfoFromCpuType
+@@ -400,6 +400,7 @@
+           archName = archInfo->name;
+         }
+       }
++#endif
+       archs.push_back(archName);
+     }
+   }
