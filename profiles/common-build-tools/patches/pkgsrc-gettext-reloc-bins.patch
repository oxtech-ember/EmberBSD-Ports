Package the relocatable program.bin payloads for the NetBSD cross install.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/devel/gettext-tools/Makefile
+++ b/devel/gettext-tools/Makefile
@@ -81,11 +81,17 @@
 SUBST_SED.offset+=	-e 's/FILE_OFFSET_BITS=64/FILE_OFFSET_BITS=32/g'
 .endif
 
-PLIST_VARS+=	glibc
+PLIST_VARS+=	glibc relocbin
 
 .if !empty(GLIBC_VERSION)
 PLIST.glibc=	yes
 .endif
+# install-reloc keeps the public name as the wrapper and stores the real
+# program in program.bin on the unversioned NetBSD cross triplet. Darwin
+# and a versioned NetBSD host do not install program.bin.
+.if ${OPSYS} == "NetBSD" && ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+PLIST.relocbin=	yes
+.endif
 
 REPLACE_PYTHON=	gettext-tools/src/spit.py.in
 

