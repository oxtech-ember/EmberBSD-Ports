+/* Translate the configured libexec path using the installed executable's
+   directory.  Only paths below the same configured prefix can be moved.  */
+static char *
+relocated_libexec (void)
+{
+  size_t prefix_len = strlen (PREFIX);
+  size_t dir_len = strlen (program_path);
+  char const *bindir_suffix;
+  size_t suffix_len;
+  char *result;
+
+  if (PREFIX[0] != '/')
+    return NULL;
+  if (prefix_len == 1 && PREFIX[0] == '/')
+    prefix_len = 0;
+  if (strncmp (BINDIR, PREFIX, prefix_len) != 0
+      || strncmp (PKGLIBEXECDIR, PREFIX, prefix_len) != 0
+      || BINDIR[prefix_len] != '/' || PKGLIBEXECDIR[prefix_len] != '/')
+    return streq (program_path, BINDIR) ? xstrdup (PKGLIBEXECDIR) : NULL;
+
+  bindir_suffix = &BINDIR[prefix_len];
+  suffix_len = strlen (bindir_suffix);
+  if (dir_len < suffix_len
+      || strcmp (program_path + dir_len - suffix_len, bindir_suffix) != 0)
+    return streq (program_path, BINDIR) ? xstrdup (PKGLIBEXECDIR) : NULL;
+  if (asprintf (&result, "%.*s%s", (int) (dir_len - suffix_len),
+                program_path, &PKGLIBEXECDIR[prefix_len]) < 0)
+    xalloc_die ();
+  return result;
 }
 
