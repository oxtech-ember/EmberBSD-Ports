+/* open one database file in dbenv, as db_open() did in Berkeley DB 2.
+   DB_TRUNCATE is not allowed in a transactional environment, so a
+   database being created is removed first. */
+static int kd_db_open(const char *name, DBTYPE type, u_int32_t flags,
+		      u_int32_t dbflags,
+		      int (*dupcmp)(DB *, const DBT *, const DBT *, size_t *),
+		      DB **dbp)
+{
+   int ret;
+   u_int32_t txnflag = dbenv_txn ? DB_AUTO_COMMIT : 0;
+
+   *dbp = NULL;
+   if (flags & DB_TRUNCATE) {
+      flags &= ~DB_TRUNCATE;
+      ret = dbenv->dbremove(dbenv, NULL, name, NULL, txnflag);
+      if (ret && ret != ENOENT)
+	 return(ret);
+   }
+   if ((ret = db_create(dbp, dbenv, 0)))
+      return(ret);
+   if ((ret = (*dbp)->set_pagesize(*dbp, 8192)) ||
+       (dbflags && (ret = (*dbp)->set_flags(*dbp, dbflags))) ||
+       (dupcmp && (ret = (*dbp)->set_dup_compare(*dbp, dupcmp))) ||
+       (ret = (*dbp)->open(*dbp, NULL, name, NULL, type, flags | txnflag,
+			   0644))) {
+      (*dbp)->close(*dbp, 0);
+      *dbp = NULL;
+   }
+   return(ret);
+}
