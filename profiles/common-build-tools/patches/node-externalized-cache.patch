+TEST_F(BuiltinCacheTest, ExternalizedSourceDoesNotReuseCodeCache) {
+  RestoreBuiltinCache restore;
+  node::builtins::TearDownExternalizedBuiltinCache();
+  node::builtins::InitializeExternalizedBuiltinCache();
+  v8::HandleScope scope(isolate_);
+  v8::Local<v8::Context> context = v8::Context::New(isolate_);
+  v8::Context::Scope context_scope(context);
+  const char* id = "internal/test/cache_probe";
+  TemporaryBuiltin old_source("return parameter + 1;\n");
+  BuiltinLoader old_loader;
+  Load(old_loader, id, old_source.path());
+  v8::LocalVector<v8::String> params(isolate_);
+  params.push_back(v8::String::NewFromUtf8Literal(isolate_, "parameter"));
+  v8::Local<v8::Function> compiled;
+  ASSERT_TRUE(old_loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  auto cache = std::shared_ptr<v8::ScriptCompiler::CachedData>(
+      v8::ScriptCompiler::CreateCodeCacheForFunction(compiled));
+  ASSERT_TRUE(cache && cache->length > 0);
+  node::builtins::TearDownExternalizedBuiltinCache();
+  node::builtins::InitializeExternalizedBuiltinCache();
+  TemporaryBuiltin changed("return parameter + 2;\n");
+  BuiltinLoader loader;
+  Load(loader, id, changed.path());
+  loader.RefreshCodeCache({{id, BuiltinCodeCacheData(cache)}});
+  isolate_->ClearCachesForTesting();
+  ASSERT_TRUE(loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  v8::Local<v8::Value> argv[] = {v8::Integer::New(isolate_, 40)};
+  v8::Local<v8::Value> result;
+  ASSERT_TRUE(compiled->Call(context, v8::Undefined(isolate_), 1, argv)
+                  .ToLocal(&result));
+  EXPECT_EQ(result->Int32Value(context).FromJust(), 42);
+  std::vector<CodeCacheInfo> snapshot;
+  ASSERT_TRUE(loader.CompileAllBuiltinsAndCopyCodeCache(context, {}, &snapshot));
+  EXPECT_TRUE(std::none_of(snapshot.begin(), snapshot.end(),
+                          [id](const CodeCacheInfo& entry) { return entry.id == id; }));
+#ifndef NODE_BUILTIN_MODULES_PATH
+  EXPECT_TRUE(std::any_of(snapshot.begin(), snapshot.end(),
+                          [](const CodeCacheInfo& entry) {
+                            return entry.id == "internal/assert";
+                          }));
+#endif
+  node::builtins::TearDownExternalizedBuiltinCache();
+}
 
