+function dependency_role(pkg,    entry, fields, base, count, patterns, i, role) {
+	if (pkg in resolved_roles) return resolved_roles[pkg]
+	if (!dependencies_read) {
+		while ((getline entry < depends_file) > 0) {
+			if (split(entry, fields) < 3) continue
+			if (fields[1] == "full" || fields[1] == "indirect-full") {
+				dep_roles[fields[3]] = "runtime"
+				base = package_base(fields[3])
+				runtime_patterns[base] = runtime_patterns[base] " " fields[2]
+			} else if (!(fields[3] in dep_roles))
+				dep_roles[fields[3]] = "build"
+		}
+		close(depends_file)
+		dependencies_read = 1
+	}
+	role = dep_roles[pkg]
+	base = package_base(pkg)
+	# A compatible update may have replaced the recorded package version.
+	if (role != "runtime" && (base in runtime_patterns)) {
+		count = split(runtime_patterns[base], patterns)
+		for (i = 1; i <= count; i++) {
+			if (system(pkg_admin_cmd " pmatch " shquote(patterns[i]) " " shquote(pkg)) == 0) {
+				role = "runtime"
+				break
+			}
+		}
+	}
+	resolved_roles[pkg] = role
+	return role
