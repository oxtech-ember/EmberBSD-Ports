Cross php85 records the target configure paths.

php-config85, build-defs.h and php.m4 record the configure command. In a
cross build they named the build host pkg-config and the buildlink
readline in the work directory, and the install stopped in check-wrkref.
Record the target pkg-config and the target readline prefix.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/lang/php85/Makefile.php
+++ b/lang/php85/Makefile.php
@@ -97,5 +97,21 @@
 
 .include "options.mk"
 
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+# The installed php.m4 names pkg-config, and php-config and build-defs.h
+# record the configure command. Name the target pkg-config, not the build
+# host tool.
+SUBST_SED.path+=	-e 's,@TOOLS_PATH\.pkg-config@,${LOCALBASE}/bin/pkg-config,g'
+.  if ${PKG_OPTIONS:Mreadline}
+# options.mk passes the buildlink tree to --with-readline; record the
+# target prefix instead.
+SUBST_CLASSES+=			cross-readline
+SUBST_STAGE.cross-readline=	post-configure
+SUBST_MESSAGE.cross-readline=	Recording the target readline prefix.
+SUBST_FILES.cross-readline=	main/build-defs.h scripts/php-config
+SUBST_SED.cross-readline=	-e 's,--with-readline=${BUILDLINK_DIR},--with-readline=${BUILDLINK_PREFIX.readline},g'
+.  endif
+.endif
+
 DL_AUTO_VARS=		yes
 .include "../../mk/dlopen.buildlink3.mk"
