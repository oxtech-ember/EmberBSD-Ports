@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later
+ * Origin: EmberBSD contributors (AI-assisted).
+ * Internal Darwin SDK path resolution.  No exported ABI.  */
+#ifndef EMBER_RELOC_H
+#define EMBER_RELOC_H
+#define EMBER_LOCALE_RELATIVE "@EMBER_LOCALE_RELATIVE@"
+#define EMBER_ERRORREF_RELATIVE "@EMBER_ERRORREF_RELATIVE@"
+#define EMBER_SYSCONF_RELATIVE "@EMBER_SYSCONF_RELATIVE@"
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+static char *
+ember_resource_path (const char *relative)
+{
+  Dl_info info;
+  char image[PATH_MAX];
+  char *slash, *result;
+  size_t base, suffix;
+
+  if (relative[0] == '/')
+    return strdup (relative);
+  if (!dladdr ((const void *)&ember_resource_path, &info) || !info.dli_fname)
+    {
+      errno = ENOENT;
+      return NULL;
+    }
+  if (!realpath (info.dli_fname, image))
+    return NULL;
+  slash = strrchr (image, '/');
+  if (!slash)
+    {
+      errno = ENOENT;
+      return NULL;
+    }
+  *slash = 0;
+  base = strlen (image);
+  suffix = strlen (relative);
+  if (suffix > SIZE_MAX - base - 2)
+    {
+      errno = ENOMEM;
+      return NULL;
+    }
+  result = malloc (base + suffix + 2);
+  if (!result)
+    return NULL;
+  memcpy (result, image, base);
+  result[base] = '/';
+  memcpy (result + base + 1, relative, suffix + 1);
+  return result;
+}
+#endif
