# Rebuild boost-headers with the NetBSD wait status fix in
# boost/process/v2/exit_code.hpp, and build boost-libs against it.

--- a/devel/boost-headers/Makefile
+++ b/devel/boost-headers/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.76 2026/05/15 09:13:49 adam Exp $
 
 BOOST_PACKAGE=		headers
+PKGREVISION=		1
 BOOST_COMMENT=		(build-time headers)
 BOOST_CONFIG=		generate
 
--- a/devel/boost-libs/Makefile
+++ b/devel/boost-libs/Makefile
@@ -93,3 +93,7 @@
 .include "../../converters/libiconv/buildlink3.mk"
+.if ${OPSYS} == "NetBSD"
+# boost/process/v2/exit_code.hpp needs the NetBSD header fix from nb1.
+BUILDLINK_API_DEPENDS.boost-headers+=	boost-headers>=1.92.0nb1
+.endif
 .include "../../devel/boost-headers/buildlink3.mk"
 .include "../../devel/zlib/buildlink3.mk"
