Origin: EmberBSD, AI-assisted.
EmberBSD keeps one Lua, 5.5 (pkgsrc/versions.mk). The pinned luaversion.mk
defaulted to 5.4 and accepted 5.1 to 5.4 as well. Lua 5.5 is the only default
and accepted version; the selections of the removed versions are gone.
Not submitted upstream.

--- a/lang/lua/luaversion.mk
+++ b/lang/lua/luaversion.mk
@@ -8,8 +8,8 @@
 # LUA_VERSION_DEFAULT
 #	The preferred lua version to use.
 #
-#	Possible values: 51 52 53 54 55
-#	Default: 54
+#	Possible values: 55
+#	Default: 55
 #
 # === Infrastructure variables ===
 #
@@ -27,13 +27,13 @@
 #	is significant; those listed earlier are preferred over those
 #	listed later.
 #
-#	Possible values: 51 52 53 54 55
-#	Default: 55 54 53 52 51
+#	Possible values: 55
+#	Default: 55
 #
 # LUA_VERSIONS_INCOMPATIBLE
 #	The Lua versions that the package *cannot* build against.
 #
-#	Possible values: 51 52 53 54 55
+#	Possible values: 55
 #	Default: <empty>
 #
 # LUA_SELF_CONFLICT
@@ -79,8 +79,8 @@
 BUILD_DEFS+=		LUA_VERSION_DEFAULT
 BUILD_DEFS_EFFECTS+=	LUA_PACKAGE
 
-LUA_VERSION_DEFAULT?=	54
-LUA_VERSIONS_ACCEPTED?=	55 54 53 52 51
+LUA_VERSION_DEFAULT?=	55
+LUA_VERSIONS_ACCEPTED?=	55
 LUA_VERSIONS_INCOMPATIBLE?=# empty
 
 #
@@ -126,31 +126,7 @@
 .endfor
 .endif
 
-.if ${_LUA_VERSION} == "51"
-LUA_PACKAGE=		lua51
-LUA_PKGSRCDIR=		../../lang/lua51
-LUA_PKGPREFIX=		lua51
-LUA_BASEDEPENDS=	lua51>=5.1<5.2:${LUA_PKGSRCDIR}
-
-.elif ${_LUA_VERSION} == "52"
-LUA_PACKAGE=		lua52
-LUA_PKGSRCDIR=		../../lang/lua52
-LUA_PKGPREFIX=		lua52
-LUA_BASEDEPENDS=	lua52>=5.2<5.3:${LUA_PKGSRCDIR}
-
-.elif ${_LUA_VERSION} == "53"
-LUA_PACKAGE=		lua53
-LUA_PKGSRCDIR=		../../lang/lua53
-LUA_PKGPREFIX=		lua53
-LUA_BASEDEPENDS=	lua53>=5.3<5.4:${LUA_PKGSRCDIR}
-
-.elif ${_LUA_VERSION} == "54"
-LUA_PACKAGE=		lua54
-LUA_PKGSRCDIR=		../../lang/lua54
-LUA_PKGPREFIX=		lua54
-LUA_BASEDEPENDS=	lua54>=5.4<5.5:${LUA_PKGSRCDIR}
-
-.elif ${_LUA_VERSION} == "55"
+.if ${_LUA_VERSION} == "55"
 LUA_PACKAGE=		lua55
 LUA_PKGSRCDIR=		../../lang/lua55
 LUA_PKGPREFIX=		lua55
