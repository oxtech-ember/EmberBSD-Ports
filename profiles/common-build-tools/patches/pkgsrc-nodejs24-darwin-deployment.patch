+           'GCC_STRICT_ALIASING': 'NO',              # -fno-strict-aliasing
+           'PREBINDING': 'NO',                       # No -Wl,-prebind
+-          'MACOSX_DEPLOYMENT_TARGET': '13.5',       # -mmacosx-version-min=13.5
++          'MACOSX_DEPLOYMENT_TARGET': '<(mac_deployment_target)',
+           'USE_HEADERMAP': 'NO',
+           'WARNING_CFLAGS': [
+             '-Wall',
--- a/lang/nodejs24/Makefile
+++ b/lang/nodejs24/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.17 2026/09/09 07:30:58 adam Exp $
 
 DISTNAME=	node-v24.22.1
-PKGREVISION=	1
+PKGREVISION=	2
 EXTRACT_SUFX=	.tar.xz
 
 USE_LANGUAGES=	c c++
@@ -13,6 +13,10 @@
 # Darwin uses a platform archive tool, not GNU libtool.
 .if ${OPSYS} == "Darwin" && defined(EMBERBSD_DARWIN_LIBTOOL)
 MAKE_ENV+=	GYP_LIBTOOL=${EMBERBSD_DARWIN_LIBTOOL:Q}
+.endif
+
+.if ${OPSYS} == "Darwin" && defined(MACOSX_DEPLOYMENT_TARGET)
+CONFIGURE_ARGS+=	-Dmac_deployment_target=${MACOSX_DEPLOYMENT_TARGET:Q}
 .endif
 
