Origin: EmberBSD (AI-assisted). Use the profile's Fortran compiler and runtime
(GCC16 gfortran or Flang) instead of GCC 10, which the export does not contain.
Pass -fallow-argument-mismatch only to GFortran; Flang rejects the option and
only warns about MPICH's untyped buffer arguments.

--- a/parallel/mpi-ch/Makefile
+++ b/parallel/mpi-ch/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.103 2026/01/03 12:53:16 wiz Exp $
 
 DISTNAME=	mpich-3.4.3
-PKGREVISION=	1
+PKGREVISION=	3
 CATEGORIES=	parallel
 MASTER_SITES=	http://www.mpich.org/static/tarballs/${PKGVERSION_NOREV}/
 
@@ -53,13 +53,8 @@
 
 TEST_TARGET=	check
 
-.if ${OPSYS} == "NetBSD"
-# Needed for <ISO_Fortran_binding.h>
-USE_PKGSRC_GCC=	yes
-GCC_REQD+=	10
-# needs libgfortran.so
-DEPENDS+=	gcc10-libs-[0-9]*:../../lang/gcc10-libs
-.endif
+# The cross profile provides the Fortran runtime (GCC16 libgfortran or
+# Flang-RT) and <ISO_Fortran_binding.h> for the f90 option.
 
 # Re-enable when at version 2.x.
 #.include "../../parallel/hwloc/buildlink3.mk"
--- a/parallel/mpi-ch/options.mk
+++ b/parallel/mpi-ch/options.mk
@@ -15,7 +15,9 @@
 
 .if !empty(PKG_OPTIONS:Mf90)
 USE_LANGUAGES+=		fortran
-FFLAGS+=		-fallow-argument-mismatch
+# GFortran 10 and later need this flag for MPICH's untyped buffers.
+# Flang rejects the option and only warns about these arguments.
+FFLAGS+=		${PKG_FC:T:M*gfortran*:C/.+/-fallow-argument-mismatch/}
 CONFIGURE_ARGS+=	--enable-fortran=yes
 PLIST.f90=		yes
 .else
