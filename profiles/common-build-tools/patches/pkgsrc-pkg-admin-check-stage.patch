+/* Check whether an alternate root is selected. */
+int
+check_root_active(void)
+{
+	return Destdir != NULL && Destdir[0] != '\0';
+}
+
+/* Resolve a checked path within the selected alternate root. */
+char *
+resolve_check_path(const char *path, int follow_last)
+{
+	char *pending, *cursor, *component, *logical, *candidate, *physical;
+	char *next, *slash;
+	char linkbuf[MaxPathSize];
+	struct stat st;
+	ssize_t count;
+	unsigned int links = 0;
+
+	if (!check_root_active())
+		return xstrdup(path);
+	pending = xstrdup(path);
+	cursor = pending;
+	logical = xstrdup("/");
+	while ((component = strsep(&cursor, "/")) != NULL) {
+		if (component[0] == '\0' || strcmp(component, ".") == 0)
+			continue;
+		if (strcmp(component, "..") == 0) {
+			slash = strrchr(logical, '/');
+			if (slash != logical)
+				*slash = '\0';
+			else
+				logical[1] = '\0';
+			continue;
+		}
+		candidate = xasprintf("%s%s%s", logical,
+		    strcmp(logical, "/") == 0 ? "" : "/", component);
+		physical = destdir_path(candidate);
+		if (lstat(physical, &st) != 0) {
+			free(candidate);
+			free(physical);
+			goto fail;
+		}
+		if (S_ISLNK(st.st_mode) && (follow_last || cursor != NULL)) {
+			if (++links > 40) {
+				errno = ELOOP;
+				free(candidate);
+				free(physical);
+				goto fail;
+			}
+			count = readlink(physical, linkbuf, sizeof(linkbuf));
+			free(candidate);
+			free(physical);
+			if (count < 0)
+				goto fail;
+			if (count == 0 || (size_t)count >= sizeof(linkbuf)) {
+				errno = count == 0 ? EINVAL : ENAMETOOLONG;
+				goto fail;
+			}
+			linkbuf[count] = '\0';
+			next = cursor ? xasprintf("%s/%s", linkbuf, cursor) :
+			    xstrdup(linkbuf);
+			if (linkbuf[0] == '/') {
+				free(logical);
+				logical = xstrdup("/");
+			}
+			free(pending);
+			pending = next;
+			cursor = pending;
+			continue;
+		}
+		if (cursor != NULL && !S_ISDIR(st.st_mode)) {
+			errno = ENOTDIR;
+			free(candidate);
+			free(physical);
+			goto fail;
+		}
+		free(physical);
+		free(logical);
+		logical = candidate;
+	}
+	physical = destdir_path(logical);
+	free(logical);
+	free(pending);
+	return physical;
+fail:
+	free(logical);
+	free(pending);
+	return NULL;
+}
