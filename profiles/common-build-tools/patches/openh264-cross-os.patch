Cross openh264 selects the target platform makefile.

The upstream Makefile derives OS from the build host uname, so a cross
build on macOS used build/platform-darwin.mk and Mach-O link flags.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/multimedia/openh264/Makefile
+++ b/multimedia/openh264/Makefile
@@ -26,6 +26,11 @@
 
 .include "../../mk/bsd.prefs.mk"
 
+# The Makefile otherwise takes OS from the build host uname.
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+MAKE_FLAGS+=	OS=${LOWER_OPSYS:C/^(net|open|free)bsd$/bsd/:S/^sunos$/bsd/}
+.endif
+
 .if ${MACHINE_ARCH} == "i386" || ${MACHINE_ARCH} == "x86_64"
 TOOL_DEPENDS+=	nasm>=2.07:../../devel/nasm
 .endif
