vorbis-tools links libintl through gettext-lib.

With NLS, every program links libintl. On a system without a built-in
libintl (macOS) configure found the installed one, and check-shlibs
rejected the package: gettext-lib is not a runtime dependency. On
NetBSD libintl is built in and the dependency is not added.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/audio/vorbis-tools/Makefile
+++ b/audio/vorbis-tools/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.106 2026/06/14 17:56:00 nia Exp $
 
 DISTNAME=	vorbis-tools-1.4.3
-PKGREVISION=    1
+PKGREVISION=    2
 CATEGORIES=	audio
 MASTER_SITES=	https://ftp.osuosl.org/pub/xiph/releases/vorbis/
 
@@ -29,6 +29,7 @@
 .include "../../audio/libvorbis/buildlink3.mk"
 .include "../../audio/speex/buildlink3.mk"
 .include "../../converters/libiconv/buildlink3.mk"
+.include "../../devel/gettext-lib/buildlink3.mk"
 .include "../../multimedia/libogg/buildlink3.mk"
 .include "../../www/curl/buildlink3.mk"
 .include "../../mk/pthread.buildlink3.mk"
