+-	/((Jan|Feb|Mar|Apr|May|Ju[nl]|Aug|Sep|Oct|Nov|Dec)\s+[0-9]+,\s*[0-9]+\s+[0-9]+:[0-9]+:[0-9]+)$/;
+-
+-	# Prune out old entries if asked to
+-	if ($days_old > 0) {
+-	    # build up time based on date string
+-	    @date = split(/[\s,:]/, $1);
+-	    $sec = $date[5];
+-	    $min = $date[4];
+-	    $hours = $date[3];
+-	    $mday = $date[1] - 1;
+-	    $mon = $months{$date[0]};
+-	    $year = $date[2] - 1900;
+-
++    # Keep undated lines. The database stores full years and calendar days.
++    if ($days_old > 0 &&
++        /\s(Jan|Feb|Mar|Apr|May|Ju[nl]|Aug|Sep|Oct|Nov|Dec)\s+(\d+),\s*(\d{4})\s+(\d+):(\d+):(\d+)$/) {
++            ($mon, $mday, $year, $hours, $min, $sec) =
++                ($months{$1}, $2, $3, $4, $5, $6);
+ 	    $now = time();
+ 	    $then = &timelocal($sec,$min,$hours,$mday,$mon,$year);
+ 	    if (($now - $then) / (60 * 60 * 24) - 1 <= $days_old) {
