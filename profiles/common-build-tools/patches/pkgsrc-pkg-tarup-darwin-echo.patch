Use the selected Darwin echo executable in pkg_tarup.

Origin: EmberBSD contributors (AI-assisted); not submitted upstream.

--- a/pkgtools/pkg_tarup/Makefile
+++ b/pkgtools/pkg_tarup/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.42 2018/01/27 19:07:47 rillig Exp $
 
 PKGNAME=	pkg_tarup-1.9.1
+PKGREVISION=	1
 CATEGORIES=	pkgtools
 
 MAINTAINER=	hubertf@NetBSD.org
@@ -11,11 +12,23 @@
 USE_LANGUAGES=	# none
 AUTO_MKDIRS=	yes
 
+.include "../../mk/bsd.prefs.mk"
+
+# pkg_tarup invokes each command variable as a single executable in mksh.
+# The Darwin bootstrap explicitly provides a single selected echo executable.
+TARUP_ECHO= ${ECHO}
+TARUP_ECHO_N= ${ECHO_N}
+.if ${OPSYS} == "Darwin" && ${USE_CROSS_COMPILE:Uno:tl} != "yes" && \
+    defined(EMBERBSD_DARWIN_TOOL.echo) && !empty(EMBERBSD_DARWIN_TOOL.echo)
+TARUP_ECHO= ${EMBERBSD_DARWIN_TOOL.echo}
+TARUP_ECHO_N=
+.endif
+
 # Set SCRIPT_SUBST to substitute "@VARIABLE@" with "value"
 SUBST_CLASSES+=		tarup
 SUBST_STAGE.tarup=	do-configure
 SUBST_FILES.tarup=	pkg_tarup pkg_tarup_all pkg_tarup.1
-SUBST_VARS.tarup=	ECHO ECHO_N GREP HEAD ID PKG_DBDIR PKG_SUFX PKG_TOOLS_BIN PREFIX SED SH SU_CMD XARGS
+SUBST_VARS.tarup=	TARUP_ECHO TARUP_ECHO_N GREP HEAD ID PKG_DBDIR PKG_SUFX PKG_TOOLS_BIN PREFIX SED SH SU_CMD XARGS
 SUBST_SED.tarup=	-e 's,@ROOT_USER@,${REAL_ROOT_USER},g'
 
 do-extract:
--- a/pkgtools/pkg_tarup/files/pkg_tarup
+++ b/pkgtools/pkg_tarup/files/pkg_tarup
@@ -16,8 +16,8 @@
 
 OS=`uname -s`
 
-ECHO=${ECHO:-@ECHO@}
-ECHO_N=${ECHO_N:-@ECHO_N@}
+ECHO=${ECHO:-@TARUP_ECHO@}
+ECHO_N=${ECHO_N:-@TARUP_ECHO_N@}
 HEAD=${HEAD:-@HEAD@}
 ID=${ID:-@ID@}
 ROOT_USER=${ROOT_USER:-@ROOT_USER@}
@@ -34,7 +34,11 @@
 
 if [ `${ID} -u` != "$root_uid" ]; then
 	${ECHO} "Becoming ${ROOT_USER}@`/bin/hostname` to create a binary package"
-	${ECHO_N} "`${ECHO} ${SU_CMD} | ${SED} -e's/[[:space:]].*//'` ";\
+	if [ -n "$ECHO_N" ]; then
+		${ECHO_N} "`${ECHO} ${SU_CMD} | ${SED} -e's/[[:space:]].*//'` "
+	else
+		${ECHO} -n "`${ECHO} ${SU_CMD} | ${SED} -e's/[[:space:]].*//'` "
+	fi
 	( for arg in "$@"; do echo \"${arg}\"; done ) |
 	${SU_CMD} "exec ${XARGS} \"$0\""
 	exit $?
--- a/pkgtools/pkg_tarup/files/pkg_tarup.1
+++ b/pkgtools/pkg_tarup/files/pkg_tarup.1
@@ -67,7 +67,7 @@
 .It Ev ECHO , ID , SED , SU_CMD , GREP
 Actual commands to use.
 These default to
-.Pa @ECHO@ ,
+.Pa @TARUP_ECHO@ ,
 .Pa @ID@ ,
