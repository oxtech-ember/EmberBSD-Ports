$NetBSD$

Update ImageMagick and PerlMagick to 7.1.2-36 and list the documentation
installed by that release. Include the upstream license with every build.
Origin: EmberBSD (AI-assisted).

--- a/graphics/ImageMagick/Makefile
+++ b/graphics/ImageMagick/Makefile
@@ -1,6 +1,5 @@
 # $NetBSD: Makefile,v 1.372 2026/09/02 19:02:29 wiz Exp $
 
-PKGREVISION= 5
 .include "Makefile.common"
 
 PKGNAME=	ImageMagick-${DISTVERSION}
@@ -82,6 +81,8 @@
 CHECK_PORTABILITY_SKIP+=	app-image/AppRun.in
 
 post-install:
+	${INSTALL_DATA_DIR} ${DESTDIR}${PREFIX}/share/doc/ImageMagick-${IM_MAJOR_LIB_VER}
+	${INSTALL_DATA} ${WRKSRC}/LICENSE ${DESTDIR}${PREFIX}/share/doc/ImageMagick-${IM_MAJOR_LIB_VER}/LICENSE
 	${INSTALL_DATA} ${WRKSRC}/config/policy*xml ${DESTDIR}${EGDIR}
 
 .include "../../archivers/bzip2/buildlink3.mk"

--- a/graphics/ImageMagick/Makefile.common
+++ b/graphics/ImageMagick/Makefile.common
@@ -5,7 +5,7 @@
 # Changelog: https://github.com/ImageMagick/Website/blob/main/ChangeLog.md
 
 IM_MAJOR_VER=		7.1.2
-IM_MINOR_VER=		21
+IM_MINOR_VER=		36
 IM_MAJOR_LIB_VER=	7
 
 .if ${IM_MINOR_VER} != NONE
@@ -18,11 +18,13 @@
 DISTVERSION=	${DISTSUFFIX:S/-/./}
 
 CATEGORIES=	graphics
-MASTER_SITES=	https://imagemagick.org/archive/releases/
+MASTER_SITES=	${MASTER_SITE_GITHUB:=ImageMagick/}
+GITHUB_PROJECT=	ImageMagick
+GITHUB_RELEASE=	${DISTSUFFIX}
 EXTRACT_SUFX=	.tar.xz
 
 HOMEPAGE=	https://www.imagemagick.org/
-LICENSE=	gnu-gpl-v3
+LICENSE=	imagemagick-license
 
 WRKSRC=		${WRKDIR}/ImageMagick-${DISTSUFFIX}
 

