+TEST_F(PerProcessTest, ProcessDefaultCopiesAndOverrides) {
+  ClearProcessDefaultCache clear;
+  BuiltinLoader::SetProcessDefaultCodeCache(nullptr);
+  BuiltinLoader before;
+  std::weak_ptr<v8::ScriptCompiler::CachedData> weak;
+  {
+    auto bytes = new uint8_t[4]{31, 31, 31, 31};
+    auto owned = std::make_shared<v8::ScriptCompiler::CachedData>(
+        bytes, 4, v8::ScriptCompiler::CachedData::BufferOwned);
+    weak = owned;
+    std::vector<CodeCacheInfo> entries = {{"default", BuiltinCodeCacheData(owned)}};
+    BuiltinLoader::SetProcessDefaultCodeCache(&entries);
+  }
+  ASSERT_FALSE(weak.expired());
+  EXPECT_EQ(CacheByte(before, "default"), -1);
+  {
+    BuiltinLoader seeded;
+    EXPECT_EQ(CacheByte(seeded, "default"), 31);
+    seeded.RefreshCodeCache({MakeCodeCacheInfo("default", 42)});
+    EXPECT_EQ(CacheByte(seeded, "default"), 42);
+    BuiltinLoader next;
+    EXPECT_EQ(CacheByte(next, "default"), 31);
+    BuiltinLoader::SetProcessDefaultCodeCache(nullptr);
+    EXPECT_EQ(CacheByte(next, "default"), 31);
+    BuiltinLoader cleared;
+    EXPECT_EQ(CacheByte(cleared, "default"), -1);
+    ASSERT_FALSE(weak.expired());
+  }
+  EXPECT_TRUE(weak.expired());
+}
