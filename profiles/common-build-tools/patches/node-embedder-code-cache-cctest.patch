+TEST_F(BuiltinCacheTest, CustomParametersCacheStatus) {
+  RestoreBuiltinCache restore;
+  node::builtins::TearDownExternalizedBuiltinCache();
+  node::builtins::InitializeExternalizedBuiltinCache();
+  v8::HandleScope scope(isolate_);
+  v8::Local<v8::Context> context = v8::Context::New(isolate_);
+  v8::Context::Scope context_scope(context);
+  const char* id = "internal/test/cache_probe";
+  TemporaryBuiltin valid("return parameter + 1;\n");
+  BuiltinLoader loader;
+  Load(loader, id, valid.path());
+  v8::LocalVector<v8::String> params(isolate_);
+  params.push_back(v8::String::NewFromUtf8Literal(isolate_, "parameter"));
+  v8::Local<v8::Function> compiled;
+  ASSERT_TRUE(loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  std::shared_ptr<v8::ScriptCompiler::CachedData> valid_cache(
+      v8::ScriptCompiler::CreateCodeCacheForFunction(compiled));
+  ASSERT_TRUE(valid_cache && valid_cache->length > 0);
+  loader.RefreshCodeCache({{id, BuiltinCodeCacheData(valid_cache)}});
+  isolate_->ClearCachesForTesting();
+  ASSERT_TRUE(loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_TRUE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  BuiltinLoader follower;
+  follower.CopySourceAndCodeCacheReferenceFrom(&loader);
+  ASSERT_TRUE(follower.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  // A fresh external-source cache is required to load distinct source under
+  // the same ID; loaders retain their original shared source after reset.
+  node::builtins::TearDownExternalizedBuiltinCache();
+  node::builtins::InitializeExternalizedBuiltinCache();
+  TemporaryBuiltin bad_source("return );\n");
+  BuiltinLoader malformed;
+  Load(malformed, id, bad_source.path());
+  {
+    v8::TryCatch caught(isolate_);
+    EXPECT_TRUE(malformed.LookupAndCompileFunction(context, id, &params, nullptr).IsEmpty());
+    EXPECT_TRUE(caught.HasCaught());
+    EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  }
+  ASSERT_TRUE(loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  {
+    v8::TryCatch caught(isolate_);
+    EXPECT_TRUE(malformed.LookupAndCompileFunction(context, id, nullptr).IsEmpty());
+    EXPECT_TRUE(caught.HasCaught());
+    EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  }
+  auto invalid_bytes = std::make_unique<uint8_t[]>(64);
+  std::fill_n(invalid_bytes.get(), 64, 0);
+  auto invalid = std::make_shared<v8::ScriptCompiler::CachedData>(
+      invalid_bytes.release(), 64, v8::ScriptCompiler::CachedData::BufferOwned);
+  loader.RefreshCodeCache({{id, BuiltinCodeCacheData(invalid)}});
+  isolate_->ClearCachesForTesting();
+  ASSERT_TRUE(loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  ASSERT_TRUE(follower.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  loader.RefreshCodeCache({{id, BuiltinCodeCacheData(valid_cache)}});
+  loader.SetEagerCompile();
+  ASSERT_TRUE(loader.LookupAndCompileFunction(context, id, &params, nullptr)
+                  .ToLocal(&compiled));
+  EXPECT_FALSE(node::builtins::GetBuiltinCodeCacheStatus().at(id));
+  node::builtins::TearDownExternalizedBuiltinCache();
+}
