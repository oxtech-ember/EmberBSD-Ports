+TEST_F(EnvironmentTest, WorkerBuiltinCacheHitAndReject) {
+  v8::HandleScope scope(isolate_);
+  auto context = node::NewContext(isolate_);
+  v8::Context::Scope context_scope(context);
+  auto entries = node::EmbedderBuiltinCodeCache::Generate(context);
+  ASSERT_GT(entries.size(), 100u);
+  node::EmbedderBuiltinCodeCache cache(std::move(entries));
+  ASSERT_EQ(node::SetBuiltinCodeCache(isolate_data_, &cache),
+            v8::ScriptCompiler::CachedData::kSuccess);
+  const Argv argv;
+  const char* worker_script =
+      "const { Worker } = require('worker_threads');"
+      "const w = new Worker(`require('node:punycode');`, { eval: true });"
+      "w.on('exit', code => { process.exitCode = code; });";
+  {
+    Env env{scope, argv};
+    ASSERT_FALSE(node::LoadEnvironment(*env, worker_script).IsEmpty());
+    ASSERT_EQ(node::SpinEventLoop(*env).FromJust(), 0);
+    EXPECT_EQ((*env)->principal_realm()->builtins_with_cache.count("punycode"), 0u);
+    EXPECT_EQ((*env)->principal_realm()->builtins_without_cache.count("punycode"), 0u);
+    const auto status = node::builtins::GetBuiltinCodeCacheStatus();
+    ASSERT_NE(status.find("punycode"), status.end());
+    EXPECT_TRUE(status.at("punycode"));
+  }
+  {
+    Env env{scope, argv};
+    auto* bytes = new uint8_t[64]();
+    auto invalid = std::make_shared<v8::ScriptCompiler::CachedData>(
+        bytes, 64, v8::ScriptCompiler::CachedData::BufferOwned);
+    (*env)->builtin_loader()->RefreshCodeCache(
+        {{"punycode", node::builtins::BuiltinCodeCacheData(invalid)}});
+    ASSERT_FALSE(node::LoadEnvironment(*env, worker_script).IsEmpty());
+    ASSERT_EQ(node::SpinEventLoop(*env).FromJust(), 0);
+    EXPECT_EQ((*env)->principal_realm()->builtins_with_cache.count("punycode"), 0u);
+    EXPECT_EQ((*env)->principal_realm()->builtins_without_cache.count("punycode"), 0u);
+    const auto status = node::builtins::GetBuiltinCodeCacheStatus();
+    ASSERT_NE(status.find("punycode"), status.end());
+    EXPECT_FALSE(status.at("punycode"));
+  }
+  node::SetBuiltinCodeCache(isolate_data_, nullptr);
+}
