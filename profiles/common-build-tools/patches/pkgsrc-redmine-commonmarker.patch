+.  endif
+.  if empty(EMBER_CARGO_TARGET)
+PKG_FAIL_REASON+=	"Select the Rust target triple for the cross-built Ruby extension"
+.  endif
+RUBYGEM_ENV+=	CARGO_BUILD_TARGET=${EMBER_CARGO_TARGET:Q}
+_RB_SYS_BINDGEN_FLAGS=	--target=${EMBER_CARGO_TARGET} --sysroot=${CROSS_DESTDIR} ${CPPFLAGS}
+RUBYGEM_ENV+=	BINDGEN_EXTRA_CLANG_ARGS=${_RB_SYS_BINDGEN_FLAGS:Q}
+.endif
+RUBYGEM_ENV+=	RB_SYS_CARGO_MANIFEST_DIR=${WRKSRC:Q}/ext/commonmarker
+RUBYGEM_ENV+=	CARGO_BUILD_JOBS=${_MAKE_JOBS_N}
+RUBYGEM_ENV+=	CARGO=${CARGO:Q} RB_SYS_CARGO_TARGET_DIR=${EMBER_CARGO_OUTPUT:Q}
 .include "../../mk/bsd.pkg.mk"
