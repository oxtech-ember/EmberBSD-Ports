-CONFIGURE_ARGS+= -Dember_v8_libclang=${_NODE_METAGEN_LIBCLANG:Q}
-CONFIGURE_ARGS+= -Dember_v8_python_bindings=${TOOLBASE:Q}/share/clang-python-bindings
-CONFIGURE_ARGS+= -Dember_v8_clang_resource=${_NODE_METAGEN_RESOURCE:Q}
