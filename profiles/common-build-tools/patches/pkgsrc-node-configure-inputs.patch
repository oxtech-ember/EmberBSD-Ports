Prepare Node configure inputs via its shared owner helper.

Origin: EmberBSD contributors (AI-assisted); not submitted upstream.

--- a/lang/nodejs/Makefile
+++ b/lang/nodejs/Makefile
@@ -24,12 +24,18 @@
 MAKE_ENV+= PYTHONDONTWRITEBYTECODE=1
 CONFIGURE_ENV+= PYTHONDONTWRITEBYTECODE=1
 
-CONFIGURE_ARGS+= -Dinspector_protocol_root=${INSPECTOR_PROTOCOL_SOURCE:Q}
-CONFIGURE_ARGS+= -Dv8_inspector_protocol_root=${WRKDIR:Q}/v8-inspector-rolled
-CONFIGURE_ARGS+= -Dv8_inspector_work_root=${WRKDIR:Q}
-CONFIGURE_ARGS+= -Dv8_inspector_sdk_source=${EMBERBSD_SDK_SOURCE:Q}
-CONFIGURE_ARGS+= -Dinspector_jinja_root=${TOOLBASE:Q}/${PYSITELIB:Q}
-CONFIGURE_ARGS+= -Dember_zlib_source=${ZLIB_SOURCE:Q}
+# The Node owner helper prepares the selected shared inputs and invokes the
+# original configure script with these arguments as an argv vector.
+CONFIGURE_SCRIPT= ${FILESDIR}/ember-configure-inputs.py
+CONFIGURE_ARGS+= configure --node-source ${WRKSRC:Q} --work ${WRKDIR:Q}
+CONFIGURE_ARGS+= --v8-source ${V8_SOURCE_DIR:Q} --inspector-source ${INSPECTOR_PROTOCOL_SOURCE:Q}
+CONFIGURE_ARGS+= --sdk-source ${EMBERBSD_SDK_SOURCE:Q} --jinja-root ${TOOLBASE:Q}/${PYSITELIB:Q}
+CONFIGURE_ARGS+= --zlib-source ${ZLIB_SOURCE:Q}
+CONFIGURE_ARGS+= --gyp-source ${GYP_SOURCE_DIR:Q} --gyp-pkgsrc ${_PKGSRCDIR:Q}
+CONFIGURE_ARGS+= --v8-cxx-wrapper ${TOOLBASE:Q}/libexec/cwrappers/c++-wrapper
+CONFIGURE_ARGS+= --v8-selected-clang ${_NODE_METAGEN_CLANG:Q} --v8-libclang ${_NODE_METAGEN_LIBCLANG:Q}
+CONFIGURE_ARGS+= --v8-python-bindings ${TOOLBASE:Q}/share/clang-python-bindings
+CONFIGURE_ARGS+= --v8-clang-resource ${_NODE_METAGEN_RESOURCE:Q} --
 GCC_REQD+=		14
 
 # Explicit replacement host inputs require a separate pkgsrc work directory.
@@ -86,11 +92,6 @@
 .else
 _NODE_METAGEN_LIBCLANG?= ${TOOLBASE}/lib/libclang.so
 .endif
-CONFIGURE_ARGS+= -Dember_v8_cxx_wrapper=${TOOLBASE:Q}/libexec/cwrappers/c++-wrapper
