+
+# Optional isolated runtime for new native GYP generators, not build tools.
+.if defined(NODE_HOST_RUNTIME_VIEW) && !empty(NODE_HOST_RUNTIME_VIEW)
+CONFIGURE_ENV+= EMBERBSD_NODE_HOST_RUNTIME_LAUNCHER=${EMBERBSD_SDK_SOURCE:Q}/scripts/run-darwin-with-runtime.py \
+    EMBERBSD_NODE_HOST_RUNTIME_VIEW=${NODE_HOST_RUNTIME_VIEW:Q}
+BUILD_DEFS+= NODE_HOST_RUNTIME_VIEW
+.endif
+
+# Verify the complete identity as well as the short directory hash.
+.if (defined(NODE_HOST_PROVIDER_PREFIX) && !defined(NODE_HOST_ICU_PREFIX)) || (!defined(NODE_HOST_PROVIDER_PREFIX) && defined(NODE_HOST_ICU_PREFIX))
+.error Select both NODE_HOST_PROVIDER_PREFIX and NODE_HOST_ICU_PREFIX together
+.endif
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+NODE_HOST_PROVIDER_PREFIX?= ${TOOLBASE}
+NODE_HOST_ICU_PREFIX?= ${NODE_HOST_PROVIDER_PREFIX}
+.endif
+.if (defined(NODE_HOST_PROVIDER_PREFIX) && defined(NODE_HOST_ICU_PREFIX)) || (defined(NODE_HOST_RUNTIME_VIEW) && !empty(NODE_HOST_RUNTIME_VIEW))
+_NODE_HOST_SELECTION_SHA:= ${_NODE_HOST_SELECTION_CMD:sh}
+.if empty(WRKDIR_BASENAME:M*-${_NODE_HOST_SELECTION:hash}) || "${WRKDIR}" != "${BUILD_DIR}/${WRKDIR_BASENAME}"
+.error Staged Node host inputs require a keyed pkgsrc work directory
+.endif
+_NODE_HOST_SELECTION_MARKER= ${WRKDIR}/.node-host-selection
+.if exists(${WRKDIR}/.configure_done) && !exists(${_NODE_HOST_SELECTION_MARKER}) && !${_CLEANING}
+.error Configured Node work tree lacks host input identity
+.endif
+.if exists(${_NODE_HOST_SELECTION_MARKER}) && !${_CLEANING}
+_NODE_HOST_RECORDED_CMD= ${_NODE_SELECTION_PYTHON:Q} -c 'import pathlib,sys; print(pathlib.Path(sys.argv[1]).read_text().strip())' ${_NODE_HOST_SELECTION_MARKER:Q}
+_NODE_HOST_RECORDED:= ${_NODE_HOST_RECORDED_CMD:sh}
+.  if ${_NODE_HOST_RECORDED} != ${_NODE_HOST_SELECTION_SHA}
+.error Node host input work directory hash collision
+.  endif
+.endif
+post-configure:
+	${ECHO} ${_NODE_HOST_SELECTION_SHA:Q} > ${_NODE_HOST_SELECTION_MARKER:Q}
+.endif
+
+# Metagen runs on the host, but parses each toolset's exact compiler flags.
+_NODE_METAGEN_CLANG?= ${TOOLBASE}/bin/clang++
+_NODE_METAGEN_RESOURCE_CMD= ${_NODE_METAGEN_CLANG:Q} -print-resource-dir
+_NODE_METAGEN_RESOURCE= ${_NODE_METAGEN_RESOURCE_CMD:sh}
+.if ${NATIVE_OPSYS} == "Darwin"
+_NODE_METAGEN_LIBCLANG?= ${TOOLBASE}/lib/libclang.dylib
+.else
+_NODE_METAGEN_LIBCLANG?= ${TOOLBASE}/lib/libclang.so
+.endif
+CONFIGURE_ARGS+= -Dember_v8_cxx_wrapper=${TOOLBASE:Q}/libexec/cwrappers/c++-wrapper
+CONFIGURE_ARGS+= -Dember_v8_selected_clang=${_NODE_METAGEN_CLANG:Q}
+CONFIGURE_ARGS+= -Dember_v8_libclang=${_NODE_METAGEN_LIBCLANG:Q}
+CONFIGURE_ARGS+= -Dember_v8_python_bindings=${TOOLBASE:Q}/share/clang-python-bindings
+CONFIGURE_ARGS+= -Dember_v8_clang_resource=${_NODE_METAGEN_RESOURCE:Q}
+.if !empty(EMBERBSD_NATIVE_CXX_BINDING_RECORD:U)
