+# Explicit replacement host inputs require a separate pkgsrc work directory.
+_NODE_SELECTION_PYTHON= ${EMBERBSD_CROSS_BUILD_PYTHON:U${TOOLBASE}/bin/python3.15}
+_NODE_HOST_SELECTION= ${NODE_HOST_PROVIDER_PREFIX:U:S,%,%25,g:S,|,%7C,g}|${NODE_HOST_ICU_PREFIX:U:S,%,%25,g:S,|,%7C,g}|${EMBERBSD_NATIVE_CXX_BINDING_RECORD:U:S,%,%25,g:S,|,%7C,g}|ember-host-common-includes${defined(NODE_HOST_RUNTIME_VIEW) && !empty(NODE_HOST_RUNTIME_VIEW):?|${NODE_HOST_RUNTIME_VIEW:S,%,%25,g:S,|,%7C,g}:}
+_NODE_HOST_SELECTION_CMD= ${_NODE_SELECTION_PYTHON:Q} -c 'import hashlib,sys; print(hashlib.sha256(sys.argv[1].encode()).hexdigest())' ${_NODE_HOST_SELECTION:Q}
+_NODE_HOST_KEY_SUFFIX= ${defined(NODE_HOST_PROVIDER_PREFIX) && defined(NODE_HOST_ICU_PREFIX) || defined(NODE_HOST_RUNTIME_VIEW) && !empty(NODE_HOST_RUNTIME_VIEW):?-${_NODE_HOST_SELECTION:hash}:}
+WRKDIR_BASENAME?= work${_CROSSDIR_SUFFIX:U}${_NODE_HOST_KEY_SUFFIX}
+
 .include "../../mk/bsd.prefs.mk"
