+$NetBSD$
+
+Run upstream V8 metagen with selected toolset compiler flags.
+Origin: EmberBSD (AI-assisted).
+
+--- /dev/null
++++ tools/v8_gypfiles/ember_metagen.py
+@@ -0,0 +1,100 @@
++# SPDX-License-Identifier: BSD-2-Clause
++# Origin: EmberBSD (AI-assisted).
++"""Run upstream V8 metagen using the selected compiler's effective argv."""
++import json
++import os
++from pathlib import Path
++import shlex
++import shutil
++import subprocess
++import sys
++import tempfile
++
++sys.dont_write_bytecode = True
++
++
++def DoMain(args):
++    if len(args) == 2 and args[0] == 'binding-input':
++        return shlex.join([args[1]]) if args[1] else ''
++    if len(args) == 4 and args[0] == 'sdk-inputs':
++        if not (args[2] or args[3]):
++            return ''
++        sdk = Path(args[1]) / 'src/emberbsd_sdk'
++        return shlex.join([str(sdk / name) for name in (
++            '__init__.py', 'compiler_bindings.py', 'elf.py', 'errors.py',
++            'jsonio.py', 'paths.py', 'publication.py')])
++    raise ValueError('expected binding-input or sdk-inputs')
++
++
++def main(args):
++    (v8, output, stamp_name, libclang, bindings, resource, compiler, expected_wrapper,
++     sdk_source, host_record, target_record, selected_clang, host_mode, toolset, cross, make_cwd, gyp_flags, tool_flags) = args
++    if toolset not in ("host", "target") or cross not in ("0", "1") or host_mode not in ("wrapper", "direct"):
++        raise ValueError("invalid GYP toolset or cross flag")
++    root = Path(v8).resolve(strict=True)
++    out = Path(output).resolve()
++    stamp = Path(stamp_name).resolve()
++    stamp.unlink(missing_ok=True)
++    os.chdir(make_cwd)
++    out.parent.mkdir(parents=True, exist_ok=True)
++    flags = shlex.split(gyp_flags) + shlex.split(tool_flags)
++    wrapper = shlex.split(compiler)
++    selected = shutil.which(wrapper[0]) if wrapper else None
++    if selected is None:
++        raise RuntimeError('selected C++ compiler was not found')
++    driver = str(root / 'tools/metagen/harvest-driver.cc')
++    direct_host = toolset == "host" and host_mode == "direct"
++    if not direct_host and os.path.samefile(selected, expected_wrapper):
++        env = dict(os.environ, CWRAPPERS_EMIT_ARGV='1')
++        result = subprocess.run([*wrapper, *flags, '-c', driver], env=env,
++                                stdout=subprocess.PIPE, check=True).stdout
++        if not result.endswith(b'\0'):
++            raise RuntimeError('selected wrapper did not emit a complete NUL argv')
++        arguments = [os.fsdecode(word) for word in result[:-1].split(b'\0')]
++    elif direct_host:
++        # GYP uses the explicitly selected native command for host generators.
++        arguments = [selected, *wrapper[1:], *flags, '-c', driver]
++    else:
++        raise RuntimeError('target C++ compiler is not the qualified cwrappers provider')
++    if not host_record.startswith('host=') or not target_record.startswith('target='):
++        raise ValueError('invalid SDK binding selectors')
++    binding_record = target_record[7:] if toolset == 'target' else host_record[5:]
++    if toolset == 'target' and cross == '1' and not binding_record:
++        raise RuntimeError('cross metagen requires the selected SDK compiler binding')
++    if binding_record:
++        record_path = Path(binding_record).resolve(strict=True)
++        if not os.path.samefile(arguments[0], record_path.parent / 'cxx'):
++            raise RuntimeError('wrapper did not select the declared SDK C++ binding')
++        sys.path.insert(0, str(Path(sdk_source).resolve(strict=True) / 'src'))
++        from emberbsd_sdk import compiler_bindings, jsonio
++        if getattr(compiler_bindings, 'COMPILER_BINDINGS_API', None) not in (2, 3):
++            raise RuntimeError('selected SDK lacks a supported compiler binding API (2 or 3)')
++        arguments = compiler_bindings.compiler_argv(jsonio.read_json(record_path), 'cxx', arguments[1:])
++    elif not os.path.samefile(arguments[0], selected_clang):
++        raise RuntimeError('compiler is neither the selected Clang nor declared SDK binding')
++    command = [{'directory': os.getcwd(), 'file': driver, 'arguments': arguments}]
++    commands = out.parent / 'compile_commands.json'
++    commands.write_text(json.dumps(command))
++    subprocess.run([sys.executable, '-B', str(root / 'tools/metagen/metagen.py'),
++                    '--v8-root', str(root), '--driver', driver, '--out', str(out.parent),
++                    '--depfile', str(out) + '.d', '--compile-commands', str(commands),
++                    '--clang-resource-dir', resource, '--libclang-so', libclang,
++                    '--libclang-bindings-dir', bindings], check=True)
++    depfile = Path(str(out) + '.d')
++    deps = depfile.read_text()
++    header_target = os.path.relpath(out).replace(' ', r'\ ') + ':'
++    if not deps.startswith(header_target):
++        raise RuntimeError('unexpected upstream metagen depfile target')
++    stamp_target = os.path.relpath(stamp).replace(' ', r'\ ') + ':'
++    Path(str(stamp) + '.d').write_text(stamp_target + deps[len(header_target):])
++    fd, name = tempfile.mkstemp(prefix='.metagen-stamp-', dir=stamp.parent)
++    try:
++        with os.fdopen(fd, 'w') as f:
++            f.write('ok\n')
++        os.replace(name, stamp)
++    finally:
++        if os.path.exists(name): os.unlink(name)
++
++
++if __name__ == '__main__':
++    main(sys.argv[1:])
