+.  if ${USE_CROSS_COMPILE:Uno:tl} != "yes"
+CONFIGURE_ARGS+= -Dember_v8_target_binding_record=${EMBERBSD_NATIVE_CXX_BINDING_RECORD:Q}
+.  endif
+.endif
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+NODE_HOST_INCLUDES= ${WRKDIR}/ember-host-common-includes
+BUILD_DEFS+= NODE_HOST_PROVIDER_PREFIX NODE_HOST_ICU_PREFIX
+.if ${NATIVE_OPSYS} == "Darwin"
+_NODE_HOST_OS= mac
+.elif ${NATIVE_OPSYS} == "Linux"
+_NODE_HOST_OS= linux
+.elif ${NATIVE_OPSYS} == "NetBSD"
+_NODE_HOST_OS= netbsd
+.else
+PKG_FAIL_REASON+= "Node cross host OS ${NATIVE_OPSYS} is not supported"
+.endif
+CONFIGURE_ARGS+= -Dhost_os=${_NODE_HOST_OS}
+CONFIGURE_ENV+= EMBERBSD_NODE_HOST_ICU_PREFIX=${NODE_HOST_ICU_PREFIX:Q} \
+    EMBERBSD_NODE_HOST_PREFIX=${NODE_HOST_PROVIDER_PREFIX:Q} \
+    EMBERBSD_NODE_HOST_ALIASES=${NODE_HOST_INCLUDES:Q} \
+    EMBERBSD_NODE_LLVM_LIBC_NAMESPACE=${NODE_LLVM_LIBC_NAMESPACE:Q} \
+    EMBERBSD_NODE_HOST_PKGCONF=${TOOLBASE:Q}/bin/pkgconf
+CONFIGURE_ARGS+= -Dember_v8_host_driver_mode=direct
+CONFIGURE_ARGS+= -Dember_v8_target_binding_record=${EMBERBSD_CROSS_TOOLS:Q}/commands/commands.json
+CONFIGURE_ENV+= CC_host=${NATIVE_CC:Q} CXX_host=${NATIVE_CXX:Q} AR_host=${NATIVE_AR:Q}
+MAKE_ENV+= CC_host=${NATIVE_CC:Q} CXX_host=${NATIVE_CXX:Q} AR_host=${NATIVE_AR:Q}
+.endif
+
+# Native GYP links are heavy in both build and install (install depends on all).
+# Use the selected native C++ wrapper and the shared SDK link launcher for both.
+.if ${OPSYS} == "Darwin" && ${EMBERBSD_DARWIN_BOOTSTRAP:Uno:tl} == "yes"
+.  if !empty(EMBERBSD_DARWIN_LINKER_LAUNCHER:U)
+_NODE_DARWIN_LAUNCHER= ${EMBERBSD_DARWIN_LINKER_LAUNCHER}
+.  elif !empty(EMBERBSD_GCC16_LINKER_LAUNCHER:U)
+_NODE_DARWIN_LAUNCHER= ${EMBERBSD_GCC16_LINKER_LAUNCHER}
+.  elif !empty(EMBERBSD_DARWIN_CMAKE_LINKER_LAUNCHER:U)
+_NODE_DARWIN_MISSING_LINKER= yes
+.  endif
+.  if defined(_NODE_DARWIN_LAUNCHER)
+_NODE_DARWIN_LINK= ${_NODE_DARWIN_LAUNCHER} ${WRAPPER_BINDIR:Q}/${CXX:T:Q}
+MAKE_FLAGS+= LINK.target=${_NODE_DARWIN_LINK:Q} LINK.host=${_NODE_DARWIN_LINK:Q}
+.  endif
+.  if defined(_NODE_DARWIN_MISSING_LINKER)
+.PHONY: node-check-link-launcher
+pre-build: node-check-link-launcher
+pre-install: node-check-link-launcher
+node-check-link-launcher:
+	${FAIL_MSG} "Node requires the SDK shell link launcher; update the native configuration."
+.  endif
+.endif
+
+# Darwin uses a platform archive tool, not GNU libtool.
+.if ${OPSYS} == "Darwin" && defined(EMBERBSD_DARWIN_LIBTOOL)
+MAKE_ENV+=	GYP_LIBTOOL=${EMBERBSD_DARWIN_LIBTOOL:Q}
+.endif
+
+.if ${OPSYS} == "Darwin" && defined(MACOSX_DEPLOYMENT_TARGET)
+CONFIGURE_ARGS+=	-Dmac_deployment_target=${MACOSX_DEPLOYMENT_TARGET:Q}
+.endif
+
+# Selected host ABI metadata is data, not a compiler/tool search path.
+.if ${OPSYS} == "Darwin" && \
+    (${EMBERBSD_DARWIN_BOOTSTRAP:Uno:tl} == "yes" || \
+    defined(NODE_GYP_XCODE_VERSION_PLIST) || defined(EMBERBSD_DARWIN_XCODE_VERSION_PLIST))
+NODE_GYP_XCODE_VERSION_PLIST?= ${EMBERBSD_DARWIN_XCODE_VERSION_PLIST:U}
+_NODE_GYP_METADATA_ENV= GYP_MACOS_SDK_PATH=${OSX_SDK_PATH:Q} \
+	GYP_XCODE_VERSION_PLIST=${NODE_GYP_XCODE_VERSION_PLIST:Q}
+CONFIGURE_ENV+=	${_NODE_GYP_METADATA_ENV}
+MAKE_ENV+=	${_NODE_GYP_METADATA_ENV}
+.endif
 
 # XXX: figure out a way to add rpaths to torque
 MAKE_ENV+=	LD_LIBRARY_PATH=${PREFIX}/lib
 
+# Use the common Undici provider for the built-in fetch implementation.
+DEPENDS+=	undici>=8.12.3nb1:../../www/undici
+CONFIGURE_ARGS+=	--shared-builtin-undici/undici-path=${PREFIX:Q}/lib/node_modules/undici/loader.js
+
+CONFIGURE_ARGS+=	--shared-abseil
+CONFIGURE_ARGS+=	--shared-temporal_capi
+CONFIGURE_ARGS+=	--shared-zstd
+CONFIGURE_ARGS+=	--shared-uvwasi
+CONFIGURE_ARGS+=	--shared-simdjson
+CONFIGURE_ARGS+=	--shared-http-parser
+CONFIGURE_ARGS+=	--shared-ada
+CONFIGURE_ARGS+=	--shared-merve
+CONFIGURE_ARGS+=	--shared-nbytes
+CONFIGURE_ARGS+=	--shared-simdutf
+CONFIGURE_ARGS+=	--shared-highway
+CONFIGURE_ARGS+=	--shared-hdr-histogram
+CONFIGURE_ARGS+=	--shared-lief
 CONFIGURE_ARGS+=	--shared-ffi
+CONFIGURE_ARGS+=	--shared-gtest
 CONFIGURE_ARGS+=	--shared-nghttp3
 CONFIGURE_ARGS+=	--shared-ngtcp2
