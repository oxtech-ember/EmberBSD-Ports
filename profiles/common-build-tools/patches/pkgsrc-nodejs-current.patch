+$NetBSD$
+
+Wire the common V8 inspector roll and source identity into GYP.
+Origin: EmberBSD (AI-assisted).
+
+--- /dev/null
++++ tools/v8_gypfiles/ember_inspector_inputs.py
+@@ -0,0 +1,69 @@
++# SPDX-License-Identifier: BSD-2-Clause
++# Origin: EmberBSD (AI-assisted).
++"""Connect the common V8 roll tool to GYP inputs and source identities."""
++import importlib.util
++import json
++import os
++from pathlib import Path
++import re
++import shlex
++import subprocess
++import sys
++
++sys.dont_write_bytecode = True
++
++
++def tree_id(path, package):
++    record = json.loads(Path(path).read_text())
++    digest = record.get('tree_sha256') if isinstance(record, dict) else None
++    if (not isinstance(record, dict) or record.get('format') != 'emberbsd-prepared-source'
++            or record.get('version') != 1 or record.get('package') != package
++            or not isinstance(digest, str) or not re.fullmatch('[0-9a-f]{64}', digest)):
++        raise ValueError('invalid prepared source receipt')
++    return digest
++
++
++def DoMain(args):
++    mode, *args = args
++    if mode == 'identity':
++        return tree_id(args[0], args[1])
++    if mode != 'inputs' or len(args) != 2:
++        raise ValueError('invalid inspector input query')
++    roll, source = map(lambda value: Path(value).resolve(strict=True), args)
++    spec = importlib.util.spec_from_file_location('v8_inspector_roll', roll)
++    module = importlib.util.module_from_spec(spec); spec.loader.exec_module(module)
++    paths = {roll, source / 'emberbsd-prepared-source.json'}
++    for pattern in module.FILES_TO_SYNC:
++        paths.update(path for path in source.glob(pattern) if path.is_file())
++    for name in ('export.h', 'json_platform_v8.cc', 'test_platform_v8.cc', 'test_platform.h'):
++        paths.add(roll.parent / 'crdtp' / name)
++    return shlex.join(str(path) for path in sorted(paths))
++
++
++def main(args):
++    if len(args) != 8:
++        raise ValueError('expected two source identities and six roll arguments')
++    v8_id, inspector_id, roll, source, output, build_root, receipt, sdk = args
++    v8_receipt = Path(roll).resolve().parents[2] / 'emberbsd-prepared-source.json'
++    if tree_id(v8_receipt, 'lang/v8') != v8_id or tree_id(receipt, 'devel/inspector-protocol') != inspector_id:
++        raise ValueError('prepared source identity changed; reconfigure GYP')
++    sys.path.insert(0, str(Path(sdk).resolve(strict=True) / 'src'))
++    from emberbsd_sdk import jsonio, sourceprep
++    if getattr(sourceprep, 'PREPARED_TREE_API', None) != 1:
++        raise ValueError('selected SDK lacks prepared source API 1')
++    v8_record = jsonio.read_json(v8_receipt)
++    if not isinstance(v8_record.get('identity'), dict):
++        raise ValueError('invalid V8 source identity')
++    def verify_v8():
++        sourceprep.validate_prepared_tree(v8_receipt.parent, package='lang/v8', identity=v8_record['identity'])
++    verify_v8()
++    subprocess.run([sys.executable, '-B', roll, '--build-source', source,
++                    '--build-output', output, '--build-root', build_root,
++                    '--build-receipt', receipt, '--build-sdk-source', sdk], check=True)
++    verify_v8()
++    # The roll leaves unchanged files untouched; advance only the action stamp.
++    os.utime(Path(output) / 'ember-v8-inspector-ready.json', None)
++
++
++if __name__ == '__main__':
++    main(sys.argv[1:])
