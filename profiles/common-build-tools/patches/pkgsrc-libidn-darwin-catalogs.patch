Locate Libidn message catalogs beside the installed Darwin libraries.
Origin: EmberBSD contributors (AI-assisted).

--- a/devel/libidn/Makefile
+++ b/devel/libidn/Makefile
@@ -27,6 +27,22 @@
 .include "../../mk/bsd.prefs.mk"
 .include "options.mk"
 
+.if ${OPSYS} == "Darwin" && ${USE_CROSS_COMPILE:Uno:tl} != "yes"
+.  if !empty(PKG_OPTIONS:Mnls)
+PKGREVISION= 1
+# The CLI and public error functions read catalogs from the installed SDK.
+SUBST_CLASSES+= catalogs
+SUBST_STAGE.catalogs= post-patch
+SUBST_FILES.catalogs= src/idn.c lib/strerror-*.c
+SUBST_SED.catalogs= -e 's|"gettext.h"|"../idn-darwin-catalog.h"|' \
+    -e 's|bindtextdomain (PACKAGE, LOCALEDIR)|idn_bind_catalog (PACKAGE)|g' \
+    -e 's|bindtextdomain ("gnulib", GNULIB_LOCALEDIR)|idn_bind_catalog ("gnulib")|g'
+CPPFLAGS+= -DIDN_CATALOG_DIR=\"${PKGLOCALEDIR}/locale\"
+post-extract:
+	${CP} ${FILESDIR}/idn-darwin-catalog.h ${WRKSRC}/
+.  endif
+.endif
+
 .include "../../converters/libiconv/buildlink3.mk"
 .include "../../devel/libgetopt/buildlink3.mk"
