--- /dev/null
+++ b/devel/libidn/files/idn-darwin-catalog.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Origin: EmberBSD contributors (AI-assisted). */
+#ifndef IDN_DARWIN_CATALOG_H
+#define IDN_DARWIN_CATALOG_H
+
+#include "gettext.h"
+#include "idna.h"
+#include <dlfcn.h>
+#include <mach-o/dyld.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+/* Both libraries install in lib below the SDK prefix. Static Libidn
+ * clients can locate the same catalogs through the shared gettext library. */
+static char *
+idn_file_catalog (const char *image, const char *library)
+{
+  char *file, *leaf, *catalog = NULL;
+
+  file = realpath (image, NULL);
+  if (!file)
+    return NULL;
+  leaf = strrchr (file, '/');
+  if (leaf && (!library || strncmp (leaf + 1, library, strlen (library)) == 0))
+    {
+      *leaf = 0;
+      leaf = strrchr (file, '/');
+      if (leaf && (library ? strcmp (leaf, "/lib") == 0
+                   : strcmp (leaf, "/bin") == 0 || strcmp (leaf, "/sbin") == 0))
+        {
+          *leaf = 0;
+          if (asprintf (&catalog, "%s/%s", file, IDN_CATALOG_DIR) < 0)
+            catalog = NULL;
+        }
+    }
+  free (file);
+  return catalog;
+}
+
+static char *
+idn_image_catalog (const void *symbol, const char *library)
+{
+  Dl_info image;
+  if (!dladdr (symbol, &image) || !image.dli_fname)
+    return NULL;
+  return idn_file_catalog (image.dli_fname, library);
+}
+
+static char *
+idn_program_catalog (void)
+{
+  uint32_t size = 0;
+  char *executable, *catalog = NULL;
+
+  _NSGetExecutablePath (NULL, &size);
+  if (!size || !(executable = malloc (size)))
+    return NULL;
+  if (_NSGetExecutablePath (executable, &size) == 0)
+    catalog = idn_file_catalog (executable, NULL);
+  free (executable);
+  return catalog;
+}
+
+static void
+idn_bind_catalog (const char *domain)
+{
+  char *directory = idn_image_catalog ((const void *) idna_strerror, "libidn.");
+  if (!directory)
+    directory = idn_image_catalog ((const void *) dgettext, "libintl.");
+  if (!directory)
+    directory = idn_program_catalog ();
+  if (directory)
+    {
+      bindtextdomain (domain, directory);
+      free (directory);
+    }
+}
+#endif
