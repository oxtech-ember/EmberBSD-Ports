@@ -0,0 +1,42 @@
+$NetBSD$
+
+Origin: EmberBSD (AI-assisted). Keep YJIT in final Ruby links and merge its
+archive members into static libruby without unsupported relocatable linking.
+
+--- defs/jit.mk.orig
++++ defs/jit.mk
+@@ -63,10 +63,32 @@
+ endif # ifneq ($(JIT_CARGO_SUPPORT),no)
+ 
+ RUST_LIB_SYMBOLS = $(RUST_LIB:.a=).symbols
++RUST_LIB_EXPORTS = $(RUST_LIB:.a=).exports
++RUST_LIB_MERGE = :
++RUST_LIB_LINK_FLAGS =
+ $(RUST_LIBOBJ): $(RUST_LIB)
+-	$(ECHO) 'partial linking $(RUST_LIB) into $@'
++	$(ECHO) 'preparing $(RUST_LIB) for final Ruby links'
+ ifneq ($(findstring darwin,$(target_os)),)
+-	$(Q) $(CC) -nodefaultlibs -r -o $@ -exported_symbols_list $(RUST_LIB_SYMBOLS) $(RUST_LIB)
++	$(Q) $(CC) -x c -c /dev/null -o $@
++ifneq ($(strip $(RUST_LIB)),)
++RUST_LIB_MERGE = printf 'create %s.tmp\naddlib %s\naddlib %s\nsave\nend\n' "$@" "$@" "$(RUST_LIB)" | $(AR) -M && $(MV) -f "$@.tmp" "$@"
++# The marker object is needed by Ruby's normal LIBRUBY_A_OBJS list; the archive
++# members themselves are merged below, and the shared link force-loads them.
++RUST_LIB_FORCE_LOAD_FLAGS = -Wl,-force_load,$(RUST_LIB)
++RUST_LIB_LINK_FLAGS = $(RUST_LIB_FORCE_LOAD_FLAGS) -Wl,-exported_symbols_list,$(RUST_LIB_EXPORTS)
++$(LIBRUBY_SO): $(RUST_LIB_EXPORTS)
++$(RUST_LIB_EXPORTS): $(RUST_LIB_SYMBOLS) $(OBJS) $(DLDOBJS)
++	$(NM) -m $(OBJS) $(DLDOBJS) > $@.nm && \
++	{ printf '#!\n'; \
++	  while IFS= read -r line; do \
++	    case "$$line" in *" external "*) \
++	      case "$$line" in *"private external"*|*"(undefined)"*) continue;; esac; \
++	      set -f; set -- $$line; for symbol do :; done; printf '%s\n' "$$symbol";; \
++	    esac; \
++	  done < $@.nm; \
++	  cat $(RUST_LIB_SYMBOLS); \
++	} > $@.tmp && $(MV) -f $@.tmp $@ && $(RM) $@.nm
++endif
+ else
+ 	$(Q) $(LD) -r -o $@ --whole-archive $(RUST_LIB)
+ 	-$(Q) $(OBJCOPY) --wildcard --keep-global-symbol='$(SYMBOL_PREFIX)rb_*' $(@)
