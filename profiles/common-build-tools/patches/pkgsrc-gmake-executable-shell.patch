+Origin: EmberBSD (AI-assisted); not submitted upstream.
+Resolve the selected installed shell relative to GNU make itself.
+
+--- src/main.c.orig
++++ src/main.c
+@@ -25,6 +25,7 @@
+ #include "debug.h"
+ #include "getopt.h"
+ #include "shuffle.h"
++#include "findprog.h"
+ 
+ #include <assert.h>
+ #ifdef _AMIGA
+@@ -1164,6 +1165,43 @@
+     }
+ }
+ 
++/* Resolve the configured SDK shell before -C or MAKEFLAGS can change cwd.
++   Ordinary absolute shell defaults and explicit SHELL assignments retain
++   upstream semantics.  Use the existing Gnulib executable lookup, including
++   empty PATH components, then resolve symlinks to the installed binary.  */
++static void
++init_executable_shell (const char *argv0)
++{
++  static const char token[] = "@executable_path";
++  size_t len = sizeof token - 1;
++
++  if (strncmp (default_shell, token, len) != 0 || default_shell[len] != '/')
++    return;
++
++#ifdef HAVE_REALPATH
++  {
++    const char *candidate = find_in_given_path (argv0, getenv ("PATH"), NULL, false);
++    PATH_VAR (resolved);
++    char *rp = NULL;
++    char *slash;
++
++    if (candidate != NULL)
++      {
++        ENULLLOOP (rp, realpath (candidate, resolved));
++        if (candidate != argv0)
++          free ((char *) candidate);
++      }
++    if (rp == NULL || (slash = strrchr (resolved, '/')) == NULL)
++      O (fatal, NILF, _("cannot resolve executable for the configured shell"));
++
++    *slash = '\0';
++    default_shell = xstrdup (concat (2, resolved, default_shell + len));
++  }
++#else
++  O (fatal, NILF, _("executable-relative shell requires realpath support"));
++#endif
++}
++
+ #ifdef MK_OS_ZOS
+ extern char **environ;
+ #endif
+@@ -1401,6 +1439,8 @@
+         ++program;
+ #endif
+     }
++
++  init_executable_shell (argv[0]);
+ 
+   initialize_global_hash_tables ();
+ 
