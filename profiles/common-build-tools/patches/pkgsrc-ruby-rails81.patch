 # RUBY_RAILS_STRICT_DEP
@@ -41,21 +41,20 @@
 # RUBY_RAILS
 #	Selected Ruby on Rails version.
 #
-#	Possible values: 72 80
+#	Possible values: 81
 #
 
 #
 # current Ruby on Rails versions.
 #
-RUBY_RAILS72_VERSION?=	7.2.3.2
-RUBY_RAILS80_VERSION?=	8.0.5.1
+RUBY_RAILS81_VERSION?=	8.1.4
 
 RUBY_RAILS_ACCEPTED?=	# empty
-RUBY_RAILS_DEFAULT?=	72
