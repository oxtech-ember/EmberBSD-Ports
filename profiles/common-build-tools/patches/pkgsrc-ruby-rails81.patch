@@ -65,6 +64,15 @@
 RUBY_RAILS_ACCEPTED=	${RUBY_RAILS_SUPPORTED}
 .endif
 
+# EmberBSD keeps only Rails 8.1 (pkgsrc/versions.mk). A package that accepts
+# only an older Rails fails instead of selecting it.
+_RUBY_RAILS_LISTED:=	${RUBY_RAILS_ACCEPTED}
+RUBY_RAILS_ACCEPTED:=	${RUBY_RAILS_SUPPORTED:@rr@${_RUBY_RAILS_LISTED:M${rr}}@}
+.if empty(RUBY_RAILS_ACCEPTED)
+PKG_FAIL_REASON+=	"EmberBSD keeps only Rails ${RUBY_RAILS_SUPPORTED}; ${PKGPATH} accepts ${_RUBY_RAILS_LISTED}."
+RUBY_RAILS_ACCEPTED=	${RUBY_RAILS_DEFAULT}
+.endif
+
 .if defined(RUBY_RAILS_REQD)
 .  if empty(RUBY_RAILS_ACCEPTED:M${RUBY_RAILS_REQD})
 .    error Unsupported RUBY_RAILS_REQD: ${RUBY_RAILS_REQD}
@@ -88,10 +96,8 @@
 
 RUBY_RAILS_REQD?=	${RUBY_RAILS}
 
