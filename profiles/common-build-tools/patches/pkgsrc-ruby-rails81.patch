-RAILS_VERSION:=	${RUBY_RAILS80_VERSION}
-.elif ${RUBY_RAILS} == "72"
-RAILS_VERSION:=	${RUBY_RAILS72_VERSION}
+.if ${RUBY_RAILS} == "81"
+RAILS_VERSION:=	${RUBY_RAILS81_VERSION}
 .endif
 
