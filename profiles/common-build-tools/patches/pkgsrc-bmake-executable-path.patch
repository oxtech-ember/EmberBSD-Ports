 	Lst_Init(&opts.create);
 }
 
+/* EmberBSD: resolve only this executable, before processing -C or MAKEFLAGS. */
+static char *executableDir;
+
+static void
+InitExecutableDir(const char *argv0)
+{
+	char resolved[MAXPATHLEN + 1];
+	char *candidate = NULL;
+	const char *path, *start, *end;
+	struct stat st;
+
+	if (strchr(argv0, '/') != NULL) {
+		candidate = bmake_strdup(argv0);
+	} else if ((path = getenv("PATH")) != NULL) {
+		for (start = path;; start = end + 1) {
+			size_t len;
+			end = strchr(start, ':');
+			len = end != NULL ? (size_t)(end - start) : strlen(start);
+			candidate = bmake_malloc(len + strlen(argv0) + 2);
+			memcpy(candidate, start, len);
+			candidate[len] = '/';
+			strcpy(candidate + len + 1, argv0);
+			if (len == 0) {
+				free(candidate);
+				candidate = str_concat3(".", "/", argv0);
+			}
+			if (stat(candidate, &st) == 0 && S_ISREG(st.st_mode) &&
+			    access(candidate, X_OK) == 0)
+				break;
+			free(candidate);
+			candidate = NULL;
+			if (end == NULL)
+				break;
+		}
+	}
+	if (candidate != NULL && realpath(candidate, resolved) != NULL) {
+		char *slash = strrchr(resolved, '/');
+		if (slash != NULL) {
+			if (slash == resolved)
+				slash[1] = '\0';
+			else
+				*slash = '\0';
+			executableDir = bmake_strdup(resolved);
+		}
+	}
+	free(candidate);
+}
+
+char *
+Main_ExpandExecutablePath(const char *value)
+{
+	static const char token[] = "@executable_path";
+	size_t len = sizeof token - 1;
+
+	if (strncmp(value, token, len) != 0 ||
+	    (value[len] != '/' && value[len] != '\0'))
+		return bmake_strdup(value);
+	if (executableDir == NULL)
+		Fatal("cannot resolve bmake executable for %s", value);
+	return str_concat3(executableDir, "", value + len);
+}
+
 /*
  * Initialize MAKE and .MAKE to the path of the executable, so that it can be
  * found by execvp(3) and the shells, even after a chdir.
@@ -1133,6 +1195,8 @@
 	const char *make = argv0;
 	char pathbuf[MAXPATHLEN];
 
+	InitExecutableDir(argv0);
+
 	if (argv0[0] != '/' && strchr(argv0, '/') != NULL) {
 		const char *abspath = cached_realpath(argv0, pathbuf);
 		struct stat st;
@@ -1154,6 +1218,13 @@
 {
 	static char defsyspath[] = _PATH_DEFSYSPATH;
 	char *start, *p;
+	bool useDefault = syspath == NULL || syspath[0] == '\0';
+
+	/* An explicit -m makes the compiled system path unnecessary. */
+	if (useDefault && executableDir == NULL &&
+	    strstr(_PATH_DEFSYSPATH, "@executable_path") != NULL &&
+	    !Lst_IsEmpty(&sysIncPath->dirs))
+		return;
 
 	/*
 	 * If no user-supplied system path was given (through the -m option)
@@ -1178,6 +1249,10 @@
 				(void)SearchPath_Add(defSysIncPath, dir);
 				free(dir);
 			}
+		} else if (useDefault) {
+			char *expanded = Main_ExpandExecutablePath(start);
+			(void)SearchPath_Add(defSysIncPath, expanded);
+			free(expanded);
 		} else {
 			(void)SearchPath_Add(defSysIncPath, start);
 		}
