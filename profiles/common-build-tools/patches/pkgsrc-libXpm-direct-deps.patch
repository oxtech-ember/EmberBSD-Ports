libXpm: declare the libraries sxpm loads on macOS.

On macOS libtool links every dependency_libs entry of libXt.la and
libXext.la into a program, so the native sxpm loads libICE, libSM,
libXau, libXdmcp and libxcb directly, and check-shlibs rejected the
package: libSM is not a runtime dependency. Declare them.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/x11/libXpm/Makefile
+++ b/x11/libXpm/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.34 2026/04/21 13:41:32 wiz Exp $
 
 DISTNAME=		libXpm-3.5.19
+PKGREVISION=		1
 CATEGORIES=		x11 graphics
 MASTER_SITES=		${MASTER_SITE_XORG:=lib/}
 EXTRACT_SUFX=		.tar.xz
@@ -52,8 +53,13 @@
 .include "../../meta-pkgs/modular-xorg/avoid-duplicate.mk"
 .include "../../meta-pkgs/modular-xorg/hacks.mk"
 .include "../../devel/gettext-lib/buildlink3.mk"
+.include "../../x11/libICE/buildlink3.mk"
+.include "../../x11/libSM/buildlink3.mk"
