--- /dev/null
+++ b/mk/pkgformat/pkg/check-provides.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# SPDX-License-Identifier: BSD-2-Clause
+# Origin: EmberBSD contributors (AI-assisted).
+# Check that each PROVIDES entry names a file of this package.
+# The file must be in the PLIST and must exist in the stage directory.
+set -eu
+[ "$#" = 4 ] || { echo 'Usage: check-provides.sh DESTDIR PREFIX PLIST BUILD_INFO' >&2; exit 2; }
+destdir=$1 prefix=$2 plist=$3 build_info=$4
+awk=${AWK:-awk}
+status=0
+while IFS= read -r line; do
+    case "$line" in
+        PROVIDES=*) provided=${line#PROVIDES=} ;;
+        *) continue ;;
+    esac
+    case "$provided" in
+        "$prefix"/*) relative=${provided#"$prefix"/} ;;
+        *) echo "$provided: PROVIDES entry is outside $prefix" >&2; status=1; continue ;;
+    esac
+    if ! "$awk" -v path="$relative" '$0 == path { found = 1 } END { exit !found }' "$plist"; then
+        echo "$provided: PROVIDES entry is not in the PLIST" >&2
+        status=1
+    elif [ ! -e "$destdir$provided" ] && [ ! -L "$destdir$provided" ]; then
+        echo "$provided: PROVIDES entry is not installed in DESTDIR" >&2
+        status=1
+    fi
+done < "$build_info"
+exit "$status"
--- a/mk/pkgformat/pkg/metadata.mk
+++ b/mk/pkgformat/pkg/metadata.mk
