+#if defined(NODE_SHARED_BUILTIN_UNDICI_UNDICI_PATH) || \
+    (HAVE_AMARO && defined(NODE_SHARED_BUILTIN_AMARO_DIST_INDEX_PATH))
+// Shared builtin paths may be absolute, or relative to the executable.
+static std::string ResolveSharedBuiltinPath(const char* path) {
+  if (IsAbsoluteFilePath(path)) return path;
+  char executable[2 * PATH_MAX];
+  size_t length = sizeof(executable);
+  CHECK_EQ(uv_exepath(executable, &length), 0);
+  std::string filename(executable, length);
+#ifdef _WIN32
+  size_t separator = filename.find_last_of("/\\");
+#else
+  size_t separator = filename.find_last_of('/');
+#endif
+  CHECK_NE(separator, std::string::npos);
+  filename.resize(separator + 1);
+  filename.append(path);
+  return filename;
+}
+#endif
