-SUBST_FILES.db4-libname=	modules/berkeley-db/configure
-SUBST_SED.db4-libname=		-e "/names_next_round='db '/s/db/db4/"
+SUBST_CLASSES+=			bdb-libname
+SUBST_STAGE.bdb-libname=	pre-configure
+SUBST_FILES.bdb-libname=	modules/berkeley-db/configure
+SUBST_SED.bdb-libname=		-e "/names_next_round='db '/s/db/db18/"
 
 
