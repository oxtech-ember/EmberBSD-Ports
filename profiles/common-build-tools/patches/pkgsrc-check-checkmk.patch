Origin: EmberBSD (AI-assisted).
Upstream status: not submitted.
configure installs bin/checkmk whenever it finds an awk, but the PLIST
omits it, so every build with an awk fails the PLIST check. Name the
system awk and list the script.

--- a/devel/check/Makefile
+++ b/devel/check/Makefile
@@ -19,6 +19,10 @@
 PKGCONFIG_OVERRIDE=	check.pc.in
 
 CONFIGURE_ARGS+=	--enable-build-docs=no
+# configure installs checkmk when it finds an awk. Name the system awk,
+# so the script is always installed with a target interpreter path and
+# never with a build-host tool path.
+CONFIGURE_ENV+=		ac_cv_path_AWK_PATH=/usr/bin/awk
 
 TEST_TARGET=	check
 
--- a/devel/check/PLIST
+++ b/devel/check/PLIST
@@ -1,4 +1,5 @@
 @comment $NetBSD: PLIST,v 1.11 2019/11/24 09:02:56 ryoon Exp $
+bin/checkmk
 include/check.h
 include/check_stdint.h
 lib/libcheck.la
