Origin: EmberBSD, AI-assisted.
Update the one kept Ruby, lang/ruby40, from 4.0.7 to 4.0.9 (released
2026-10-23). The bundled gems are unchanged; the default prism gem moves
to 1.8.2, and RUBY_RUBYGEMS_VER now records the RubyGems 4.0.20 that the
4.0 tarballs already ship. The existing ruby40 patches apply unchanged.
Not submitted upstream.

--- a/lang/ruby/rubyversion.mk
+++ b/lang/ruby/rubyversion.mk
@@ -212,7 +212,7 @@
 .endif
 
 # current supported Ruby's version
-RUBY40_VERSION=		4.0.7
+RUBY40_VERSION=		4.0.9
 
 # current API compatible version; used for version of shared library
 RUBY40_API_VERSION=	4.0.0
@@ -267,7 +267,7 @@
 RUBY_ABI_VERSION=	${RUBY_VERSION}
 RUBY_SUFFIX=		${_RUBY_VER_MAJOR}${_RUBY_VER_MINOR}
 
-RUBY_RUBYGEMS_VER=		4.0.16
+RUBY_RUBYGEMS_VER=		4.0.20
 
 # default gems
 RUBY_BUNDLER_VER=		4.0.20
@@ -288,7 +288,7 @@
 RUBY_OPTPARSE_VER=		0.8.1
 RUBY_PP_VER=			0.6.3
 RUBY_PRETTYPRINT_VER=		0.2.0
-RUBY_PRISM_VER=			1.8.1
