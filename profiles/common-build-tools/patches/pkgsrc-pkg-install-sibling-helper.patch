+/*
+ * EmberBSD: resolve this executable before package processing can chdir.
+ * Follow the POSIX argv[0]/PATH and realpath pattern used by bmake.
+ */
+char *PkgDeletePath;
+
+static void
+init_pkg_delete_path(const char *argv0)
+{
+	char resolved[PATH_MAX + 1];
+	char *candidate = NULL, *slash;
+	const char *path, *start, *end;
+	struct stat st;
+
+	if (strchr(argv0, '/') != NULL) {
+		candidate = xstrdup(argv0);
+	} else if ((path = getenv("PATH")) != NULL) {
+		for (start = path;; start = end + 1) {
+			size_t len;
+
+			end = strchr(start, ':');
+			len = end != NULL ? (size_t)(end - start) : strlen(start);
+			candidate = xmalloc(len + strlen(argv0) + 3);
+			if (len == 0) {
+				strcpy(candidate, "./");
+				strcpy(candidate + 2, argv0);
+			} else {
+				memcpy(candidate, start, len);
+				candidate[len] = '/';
+				strcpy(candidate + len + 1, argv0);
+			}
+			if (stat(candidate, &st) == 0 && S_ISREG(st.st_mode) &&
+			    access(candidate, X_OK) == 0)
+				break;
+			free(candidate);
+			candidate = NULL;
+			if (end == NULL)
+				break;
+		}
+	}
+	if (candidate != NULL && realpath(candidate, resolved) != NULL &&
+	    (slash = strrchr(resolved, '/')) != NULL) {
+		slash[1] = '\0';
+		PkgDeletePath = xasprintf("%spkg_delete", resolved);
+	}
+	free(candidate);
+}
+
