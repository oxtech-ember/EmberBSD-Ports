--- /dev/null
+++ b/lang/ruby40/install-rbconfig.rb
@@ -0,0 +1,45 @@
+# Keep build-time rbconfig intact. Normalize paths in this installed copy.
+path, build_dir, mode = ARGV
+abort "usage: install-rbconfig.rb path WRKSRC native|cross" unless
+  path && build_dir && %w[native cross].include?(mode)
+target = Module.new
+Kernel.load(path, target)
+config = target::RbConfig::MAKEFILE_CONFIG
+replacements = {}
+if config["RUST_LIB"]
+  replacements["RUST_LIB"] = config["RUST_LIB"].delete_prefix(build_dir + "/")
+end
+if mode == "cross"
+  require "shellwords"
+  replacements.merge!(
+    "INSTALL" => "/usr/bin/install -c",
+    "MKDIR_P" => "/bin/mkdir -p",
+    "MAKEDIRS" => "/bin/mkdir -p",
+    "SHELL" => "/bin/sh",
+  )
+  %w[AR RANLIB RUSTC].each do |name|
+    value = config[name]
+    replacements[name] = File.basename(value) if value&.start_with?("/")
+  end
+  if config["CC_VERSION_MESSAGE"]
+    replacements["CC_VERSION_MESSAGE"] =
+      config["CC_VERSION_MESSAGE"].lines.reject { |line| line.start_with?("InstalledDir: ") }.join.chomp
+  end
+  args = Shellwords.split(config.fetch("configure_args")).map do |arg|
+    option, separator, value = arg.partition("=")
+    if %w[--with-baseruby AR RANLIB RUSTC].include?(option) && value.start_with?("/")
+      option + separator + File.basename(value)
+    else
+      arg
+    end
+  end
+  replacements["configure_args"] = Shellwords.join(args)
+end
+source = File.binread(path)
+replacements.each do |key, value|
+  assignment = /^  CONFIG\[#{Regexp.escape(key.dump)}\] = .*$/
+  raise "missing RbConfig assignment for #{key}" unless source.sub!(assignment) {
+    "  CONFIG[#{key.dump}] = #{value.dump}"
+  }
+end
+File.binwrite(path, source)
