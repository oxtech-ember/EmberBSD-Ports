# Origin: EmberBSD (AI-assisted). Record numeric archive identities without host account lookup.
# Existing named ownership remains unchanged. Numeric IDs omit tar user/group names.

--- a/pkgtools/pkg_install/files/create/util.c
+++ b/pkgtools/pkg_install/files/create/util.c
@@ -39,7 +39,9 @@
 #if HAVE_ERR_H
 #include <err.h>
 #endif
+#include <errno.h>
 #include <fcntl.h>
+#include <inttypes.h>
 #if HAVE_PWD_H
 #include <grp.h>
 #endif
@@ -55,6 +57,54 @@
 #include "lib.h"
 #include "create.h"
 
+static int
+numeric_id(const char *text, uintmax_t *value)
+{
+	char *end;
+
+	if (text[0] < '0' || text[0] > '9')
+		return -1;
+	errno = 0;
+	*value = strtoumax(text, &end, 10);
+	return errno != 0 || *end != '\0' ? -1 : 0;
+}
+
+int
+pkg_create_uid(const char *name, uid_t *uid)
+{
+	uintmax_t value;
+	uid_t parsed;
+
+	if (name == NULL || name[0] != '#')
+		return uid_from_user(name, uid);
+	if (numeric_id(name + 1, &value) == -1)
+		return -1;
+	parsed = (uid_t)value;
+	if ((value != 0 && parsed <= 0) || parsed == (uid_t)-1 ||
+	    (uintmax_t)parsed != value)
+		return -1;
+	*uid = parsed;
+	return 0;
+}
+
+int
+pkg_create_gid(const char *name, gid_t *gid)
+{
+	uintmax_t value;
+	gid_t parsed;
+
+	if (name == NULL || name[0] != '#')
+		return gid_from_group(name, gid);
+	if (numeric_id(name + 1, &value) == -1)
+		return -1;
+	parsed = (gid_t)value;
+	if ((value != 0 && parsed <= 0) || parsed == (gid_t)-1 ||
+	    (uintmax_t)parsed != value)
+		return -1;
+	*gid = parsed;
+	return 0;
+}
