--- a/mk/check/check-shlibs.mk
+++ b/mk/check/check-shlibs.mk
@@ -45,6 +45,11 @@
 CHECK_SHLIBS_SUPPORTED?=	yes
 CHECK_SHLIBS_SKIP?=		# none
 
+# Package metadata uses readelf in the ELF branch independently of CHECK_SHLIBS.
+.if !empty(CHECK_SHLIBS_SUPPORTED:M[yY][eE][sS]) && ${OBJECT_FMT} == "ELF"
+USE_TOOLS+= readelf
+.endif
+
 # All binaries and shared libraries.
 _CHECK_SHLIBS_ERE=	(bin/|sbin/|libexec/|\.(dylib|sl|so)$$|lib/lib.*\.(dylib|sl|so))
 
