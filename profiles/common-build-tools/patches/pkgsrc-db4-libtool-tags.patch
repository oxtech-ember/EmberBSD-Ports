Berkeley DB: select the libtool language for configured compiler commands.

Origin: EmberBSD (AI-assisted), not submitted upstream.
Keep compiler arguments and compile/link modes. Automatic tag inference
fails when the configured libtool compiler includes a language-mode flag.

--- a/databases/db4/Makefile
+++ b/databases/db4/Makefile
@@ -8,7 +8,7 @@
 
 DISTNAME=	db-4.8.30
 PKGNAME=	${DISTNAME:S/db/db4/}
-PKGREVISION=	1
+PKGREVISION=	2
 CATEGORIES=	databases
 MASTER_SITES=	https://download.oracle.com/berkeley-db/
 
@@ -31,6 +31,19 @@
 CONFIGURE_ARGS+=	--includedir=${PREFIX}/include/db4
 CONFIGURE_ARGS+=	--program-transform-name=s,db_,db4_,
 
+# The selected compiler may have fixed arguments, so libtool cannot infer
+# its language from the invocation. Retain the complete configure commands.
+SUBST_CLASSES+=		libtool-tags
+SUBST_STAGE.libtool-tags=	post-configure
+SUBST_MESSAGE.libtool-tags= Set explicit C and C++ libtool language tags.
+SUBST_FILES.libtool-tags=	build_unix/Makefile
+SUBST_SED.libtool-tags+=	-e '/^CC[[:space:]]*=/s/--mode=/--tag=CC --mode=/'
+SUBST_SED.libtool-tags+=	-e '/^CCLINK[[:space:]]*=/s/--mode=/--tag=CC --mode=/'
+SUBST_SED.libtool-tags+=	-e '/^SOLINK[[:space:]]*=/s/--mode=/--tag=CC --mode=/'
+SUBST_SED.libtool-tags+=	-e '/^CXX[[:space:]]*=/s/--mode=/--tag=CXX --mode=/'
+SUBST_SED.libtool-tags+=	-e '/^CXXLINK[[:space:]]*=/s/--mode=/--tag=CXX --mode=/'
+SUBST_SED.libtool-tags+=	-e '/^XSOLINK[[:space:]]*=/s/--mode=/--tag=CXX --mode=/'
+
 .include "options.mk"
 
 # DB4 only want pthreads because it's really after POSIX 1003.1
