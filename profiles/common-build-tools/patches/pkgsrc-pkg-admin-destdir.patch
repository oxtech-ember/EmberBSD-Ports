 /*
+ * Return a path inside the alternate root.
+ */
+static char *
+destdir_path(const char *path)
+{
+	char *root, *result;
+	size_t len;
+
+	if (Destdir == NULL || Destdir[0] == '\0')
+		return xstrdup(path);
+
+	root = xstrdup(Destdir);
+	len = strlen(root);
+	while (len > 1 && root[len - 1] == '/')
+		root[--len] = '\0';
+
+	if (path[0] == '/') {
+		if (strcmp(root, "/") == 0)
+			result = xstrdup(path);
+		else
+			result = xasprintf("%s%s", root, path);
+	} else if (strcmp(root, "/") == 0) {
+		result = xasprintf("/%s", path);
+	} else {
+		result = xasprintf("%s/%s", root, path);
+	}
+
+	free(root);
+	return result;
+}
+
+/*
+ * Convert a package database path below DESTDIR to its target path.
+ */
+static char *
+target_path(const char *path)
+{
+	char *root, *result;
+	size_t len;
+
+	if (Destdir == NULL || Destdir[0] == '\0')
+		return xstrdup(path);
+
+	root = xstrdup(Destdir);
+	len = strlen(root);
+	while (len > 1 && root[len - 1] == '/')
+		root[--len] = '\0';
+
+	if (strcmp(root, "/") != 0 && strlen(path) >= len &&
+	    strncmp(path, root, len) == 0 &&
+	    (path[len] == '/' || path[len] == '\0')) {
+		result = xstrdup(path + len);
+		if (result[0] == '\0') {
+			free(result);
+			result = xstrdup("/");
+		}
+	} else {
+		result = xstrdup(path);
+	}
+
+	free(root);
+	return result;
+}
