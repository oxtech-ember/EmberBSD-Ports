---- lib/Devel/CheckLib.pm.orig	2022-05-04 14:31:10.000000000 +0000
+Cross builds give Makefile.PL the target Config through
+ExtUtils::MakeMaker::Config. The probe program is then a target
+executable that cannot run on the build machine, so only compile and
+link it there. (EmberBSD, AI-assisted; not submitted upstream.)
+
+--- lib/Devel/CheckLib.pm.orig
 +++ lib/Devel/CheckLib.pm
-@@ -295,7 +295,6 @@ sub _compile_cmd {
+@@ -295,7 +295,6 @@
  	    $cfile,
  	    (!defined $lib ? () : (
  	      (map "-L$_", @$libpaths),
@@ -14,7 +19,33 @@
  	      "-l$lib",
  	    )),
  	    @$ld,
-@@ -454,7 +453,7 @@ sub _findcc {
+@@ -332,7 +331,7 @@
+     my @headers = @{$args{header} || []};
+     my @incpaths = @{$args{incpath} || []};
+     my $analyze_binary = $args{analyze_binary};
+-    my $execute = !$args{not_execute};
++    my $execute = !$args{not_execute} && !_cross_build();
+ 
+     my @argv = @ARGV;
+     push @argv, _parse_line('\s+', 0, $ENV{PERL_MM_OPT}||'');
+@@ -420,6 +419,16 @@
+     die("wrong analysis: $analysis_string") if @wronganalysis;
+ }
+ 
++# Makefile.PL runs with ExtUtils::MakeMaker::Config, which a cross build
++# sets to the target Config. Programs built for another system cannot run
++# here, so a cross build only compiles and links them.
++sub _cross_build {
++    require ExtUtils::MakeMaker::Config;
++    my $target = \%ExtUtils::MakeMaker::Config::Config;
++    return 1 if $target->{usecrosscompile};
++    return defined $target->{osname} && $target->{osname} ne $^O;
++}
++
+ sub _cleanup_exe {
+     my ($exefile) = @_;
+     my $ofile = $exefile;
+@@ -454,7 +463,7 @@
          push @Config_ldflags, $config_val if ( $config_val =~ /\S/ );
      }
      my @ccflags = grep { length } _parsewords($Config_ccflags||'', $user_ccflags||'');
