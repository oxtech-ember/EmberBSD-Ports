libXmu links libX11 directly and needs its runtime dependency.

libXmu.6.dylib and libXmuu.1.dylib load libX11.6.dylib, but libX11 came in
only through the libXt buildlink file, so the native package recorded no
direct dependency and the strict Mach-O check rejected it: libX11 is not a
runtime dependency. Include the libX11 buildlink file and bump PKGREVISION.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/x11/libXmu/Makefile
+++ b/x11/libXmu/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.21 2026/01/29 13:59:20 wiz Exp $
 
 DISTNAME=		libXmu-1.3.1
+PKGREVISION=		1
 CATEGORIES=		x11 devel
 MASTER_SITES=		${MASTER_SITE_XORG:=lib/}
 EXTRACT_SUFX=		.tar.xz
@@ -18,6 +19,7 @@
 X11_LIB_NAME?=		libXmu
 .include "../../meta-pkgs/modular-xorg/avoid-duplicate.mk"
 .include "../../meta-pkgs/modular-xorg/hacks.mk"
+.include "../../x11/libX11/buildlink3.mk"
 .include "../../x11/libXext/buildlink3.mk"
 BUILDLINK_API_DEPENDS.libXt+=	libXt>=1.1.0
 .include "../../x11/libXt/buildlink3.mk"
