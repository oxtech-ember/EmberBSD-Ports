# Origin: EmberBSD contributors (AI-assisted), not submitted upstream.
# Refuse unavailable Darwin operations and retain full selected-tool defaults.
--- /dev/null
+++ Modules/Platform/EmberBSD-DarwinTools.cmake
@@ -0,0 +1,33 @@
+# Origin: EmberBSD contributors (AI-assisted), not submitted upstream.
+# Absence is a capability boundary, never a tool path or discovery request.
+set(_EMBERBSD_DARWIN_INITIAL_TOOLS FALSE)
+if(EMBERBSD_CMAKE_NATIVE_TOOLS AND CMAKE_HOST_APPLE AND
+   CMAKE_SYSTEM_NAME STREQUAL "Darwin")
+  if(NOT DEFINED EMBERBSD_DARWIN_TOOL_PHASE)
+    set(EMBERBSD_DARWIN_TOOL_PHASE "full")
+  endif()
+  if(NOT EMBERBSD_DARWIN_TOOL_PHASE STREQUAL "initial" AND
+     NOT EMBERBSD_DARWIN_TOOL_PHASE STREQUAL "full")
+    message(FATAL_ERROR "EMBERBSD_DARWIN_TOOL_PHASE must be initial or full")
+  endif()
+  if(EMBERBSD_DARWIN_TOOL_PHASE STREQUAL "initial")
+    set(_EMBERBSD_DARWIN_INITIAL_TOOLS TRUE)
+    foreach(_ember_tool CMAKE_INSTALL_NAME_TOOL CMAKE_TAPI CMAKE_LIBTOOL)
+      if(DEFINED ${_ember_tool})
+        if(NOT IS_ABSOLUTE "${${_ember_tool}}" OR
+           IS_DIRECTORY "${${_ember_tool}}" OR
+           NOT IS_EXECUTABLE "${${_ember_tool}}")
+          message(FATAL_ERROR "${_ember_tool} must select an existing absolute executable or be absent")
+        endif()
+      endif()
+    endforeach()
+    if(DEFINED CMAKE_TAPI AND
+       (NOT DEFINED EMBERBSD_DARWIN_TAPI_KIND OR
+        (NOT EMBERBSD_DARWIN_TAPI_KIND STREQUAL "apple" AND
+         NOT EMBERBSD_DARWIN_TAPI_KIND STREQUAL "llvm-readtapi")))
+      message(FATAL_ERROR
+        "CMAKE_TAPI requires EMBERBSD_DARWIN_TAPI_KIND apple or llvm-readtapi")
+    endif()
+
+  endif()
+endif()
