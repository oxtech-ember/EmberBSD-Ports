+static int
+is_escaped(const char *start, const char *delim)
+{
+	int escaped = 0;
+
+	if (*delim == '\\')
+		return (0);
+
+	while (delim > start && delim[-1] == '\\') {
+		delim--;
+		escaped = !escaped;
+	}
+
+	return (escaped);
+}
