--- a/mk/tools/ember-autoconf.mk
+++ b/mk/tools/ember-autoconf.mk
@@ -0,0 +1,37 @@
+# SPDX-License-Identifier: BSD-2-Clause
+# Origin: EmberBSD (AI-assisted), explicit native Autoconf build provider.
+.if !defined(_EMBERBSD_HOST_AUTOCONF_CHECKED)
+_EMBERBSD_HOST_AUTOCONF_CHECKED= yes
+_EMBERBSD_AUTOCONF_VALID= yes
+.  if empty(EMBERBSD_BUILD_AUTOCONF:M/*) || !exists(${EMBERBSD_BUILD_AUTOCONF})
+PKG_FAIL_REASON+= "EMBERBSD_BUILD_AUTOCONF must name an existing absolute host executable"
+_EMBERBSD_AUTOCONF_VALID= no
+.  else
+_EMBERBSD_AUTOCONF_VERSION!= if test -x ${EMBERBSD_BUILD_AUTOCONF:Q} && \
+    ember_ac_banner=$$(${EMBERBSD_BUILD_AUTOCONF:Q} --version); then \
+    printf '%s\n' "$$ember_ac_banner" | \
+    ${AWK} '/^autoconf \(GNU Autoconf\) [0-9]/ { print $$4; exit }'; fi
+.    for version in 2.73 ${AUTOCONF_REQD}
+_EMBERBSD_AUTOCONF_SUPPORTED!= ${PKG_ADMIN} pmatch 'autoconf>='${version:Q} \
+    autoconf-${_EMBERBSD_AUTOCONF_VERSION:Q} && echo yes || echo no
+.      if ${_EMBERBSD_AUTOCONF_SUPPORTED} != "yes"
+PKG_FAIL_REASON+= "EMBERBSD_BUILD_AUTOCONF must successfully report Autoconf >=${version}"
+_EMBERBSD_AUTOCONF_VALID= no
+.      endif
+.    endfor
+.    for tool in autoheader autom4te autoreconf autoscan autoupdate ifnames
+_EMBERBSD_AUTOCONF_COMPANION= ${EMBERBSD_BUILD_AUTOCONF:H}/${tool}
+_EMBERBSD_AUTOCONF_COMPANION_VERSION!= if test -x ${_EMBERBSD_AUTOCONF_COMPANION:Q} && \
+    ember_ac_banner=$$(${_EMBERBSD_AUTOCONF_COMPANION:Q} --version); then \
+    printf '%s\n' "$$ember_ac_banner" | ${AWK} -v tool=${tool:Q} \
+    '$$1 == tool && $$2 == "(GNU" && $$3 == "Autoconf)" && $$4 ~ /^[0-9]/ { print $$4; exit }'; fi
+.      if empty(_EMBERBSD_AUTOCONF_COMPANION_VERSION) || ${_EMBERBSD_AUTOCONF_COMPANION_VERSION} != ${_EMBERBSD_AUTOCONF_VERSION}
+PKG_FAIL_REASON+= "EMBERBSD_BUILD_AUTOCONF requires matching executable ${tool} alongside it"
+_EMBERBSD_AUTOCONF_VALID= no
+.      endif
+.    endfor
+.  endif
+.  if ${_EMBERBSD_AUTOCONF_VALID} == "yes"
+_EMBERBSD_HOST_AUTOCONF_SELECTED= yes
+.  endif
+.endif
