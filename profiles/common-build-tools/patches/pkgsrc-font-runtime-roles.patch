Keep modular X font indexers in their target runtime role during cross builds.
Promote the former Plasma-only correction to both shared install frameworks.
Retain font data, index hooks, native tools and strict cross run-tool rejection.
Origin: EmberBSD (AI-assisted), not submitted upstream.

--- a/mk/pkginstall/bsd.pkginstall.mk
+++ b/mk/pkginstall/bsd.pkginstall.mk
@@ -866,8 +866,12 @@
 #
 .if !empty(FONTS_DIRS.ttf:M*)
 .if ${X11_TYPE} == "modular"
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+FILES_SUBST+=		TTF_INDEX_CMD=${X11BASE}/bin/mkfontscale
+.else
 USE_TOOLS+=		mkfontscale:run
 FILES_SUBST+=		TTF_INDEX_CMD=${TOOLS_PATH.mkfontscale:Q}
+.endif
 .else
 USE_TOOLS+=		ttmkfdir:run
 FILES_SUBST+=		TTF_INDEX_CMD=${TOOLS_PATH.ttmkfdir:Q}
@@ -876,8 +880,12 @@
 .endif
 .if !empty(FONTS_DIRS.type1:M*)
 .if ${X11_TYPE} == "modular"
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+FILES_SUBST+=		TYPE1_INDEX_CMD=${X11BASE}/bin/mkfontscale
+.else
 USE_TOOLS+=		mkfontscale:run
 FILES_SUBST+=		TYPE1_INDEX_CMD=${TOOLS_PATH.type1inst:Q}
+.endif
 FILES_SUBST+=		TYPE1_POSTINDEX_CMD=
 .else
 USE_TOOLS+=		type1inst:run
@@ -887,8 +895,14 @@
 FONTS_DIRS.x11+=	${FONTS_DIRS.type1}
 .endif
 .if !empty(FONTS_DIRS.x11:M*)
+# Indexers run in the target install hooks, after the runtime dependency.
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${X11_TYPE} == "modular"
+DEPENDS+=		mkfontscale>=1.2:../../fonts/mkfontscale
+FILES_SUBST+=		MKFONTDIR=${X11BASE}/bin/mkfontdir
+.else
 USE_TOOLS+=		mkfontdir:run
 FILES_SUBST+=		MKFONTDIR=${TOOLS_PATH.mkfontdir:Q}
+.endif
 
 .if ${X11_TYPE} == "modular"
 DEPENDS+=		encodings-[0-9]*:../../fonts/encodings
