# Origin: EmberBSD (AI-assisted). Expose the exact transformed compiler argv without exec.

--- a/pkgtools/cwrappers/Makefile
+++ b/pkgtools/cwrappers/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.29 2026/01/22 15:28:28 jperkin Exp $
 
 PKGNAME=		cwrappers-20220403
-PKGREVISION=		3
+PKGREVISION=		4
 CATEGORIES=		pkgtools sysutils
 
 MAINTAINER=		pkgsrc-users@NetBSD.org
--- a/mk/cwrappers.mk
+++ b/mk/cwrappers.mk
@@ -5,7 +5,7 @@
 .include "../../mk/wrapper/wrapper-defs.mk"
 .include "../../mk/buildlink3/bsd.buildlink3.mk"
 
-TOOL_DEPENDS+=		cwrappers>=20220403nb3:../../pkgtools/cwrappers
+TOOL_DEPENDS+=		cwrappers>=20220403nb4:../../pkgtools/cwrappers
 
 CWRAPPERS_SRC_DIR=	${TOOLBASE}/libexec/cwrappers
 CWRAPPERS_CONFIG_DIR=	${WRKDIR}/.cwrapper/config
--- a/pkgtools/cwrappers/files/bin/base-wrapper.c
+++ b/pkgtools/cwrappers/files/bin/base-wrapper.c
@@ -192,6 +192,23 @@
 
 	fclose(fp);
 
+	/* Emit the transformed argv losslessly without running the compiler. */
+	if (getenv("CWRAPPERS_EMIT_ARGV") != NULL) {
+		if (strcmp(getenv("CWRAPPERS_EMIT_ARGV"), "1") != 0)
+			errx(1, "invalid CWRAPPERS_EMIT_ARGV");
+		if (fwrite(exec_name, 1, strlen(exec_name) + 1, stdout) !=
+		    strlen(exec_name) + 1)
+			err(1, "writing wrapper argv");
+		TAILQ_FOREACH(arg, &args, link) {
+			if (fwrite(arg->val, 1, strlen(arg->val) + 1, stdout) !=
+			    strlen(arg->val) + 1)
+				err(1, "writing wrapper argv");
+		}
+		if (fflush(stdout) == EOF)
+			err(1, "writing wrapper argv");
+		return 0;
+	}
+
 #if defined(WRAPPER_LIBTOOL) || defined(WRAPPER_SHLIBTOOL)
 	do_fork = 1;
 #else
