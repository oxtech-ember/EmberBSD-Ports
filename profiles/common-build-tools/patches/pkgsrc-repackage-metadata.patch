+# SPDX-License-Identifier: BSD-2-Clause
+# Origin: EmberBSD contributors (AI-assisted).
+"""Validate a completed pkgsrc build identity before metadata-only reuse."""
+from pathlib import Path
+import sys
+
+
+def fail(message):
+    raise ValueError(message)
+
+
+def check(argv):
+    if len(argv) not in (6, 7):
+        fail("invalid arguments")
+    work, source, base, version, current, configure = argv[:6]
+    if configure not in ("yes", "no") or not Path(source).is_dir():
+        fail("missing source/build directory or invalid configure selection")
+    def cookie(name):
+        path = Path(work) / name
+        if path.is_symlink() or not path.is_file():
+            fail("missing " + name)
+        return path.read_text(encoding="utf-8").strip()
+    old = cookie(".extract_done")
+    if not old or cookie(".build_done") != old:
+        fail("inconsistent build identity")
+    if configure == "yes" and cookie(".configure_done") != old:
+        fail("inconsistent configure identity")
+    stem = base + "-" + version
+    for name in (old, current):
+        revision(name, stem)
+    if len(argv) == 7 and old != argv[6]:
+        fail("build identity changed")
+    return old
+
+
+def revision(name, stem):
+    if name == stem:
+        return 0
+    prefix = stem + "nb"
+    if not name.startswith(prefix):
+        fail("different package or upstream version")
+    suffix = name[len(prefix):]
+    if not suffix or not suffix.isascii() or not suffix.isdigit():
+        fail("invalid package revision")
+    return int(suffix)
+
+
+def stage_local(work, base, version, current):
+    root = Path(work)
+    stem = base + "-" + version
+    revision(current, stem)
+
+    identity_cookies = (".extract_done", ".configure_done", ".build_done")
+    later_cookies = (".wrapper_done", ".install_done", ".package_done",
+                     ".replace_done")
+    cookies = identity_cookies + later_cookies
+    values = {}
+    for name in cookies:
+        path = root / name
+        if path.is_symlink():
+            fail("symlinked " + name)
+        if path.exists():
+            if not path.is_file():
+                fail("invalid " + name)
+            values[name] = path.read_text(encoding="utf-8").strip()
+
+    extracted = values.get(".extract_done")
+    if extracted is None:
+        if any(name in values for name in cookies[1:]):
+            fail("later phase cookie without extract identity")
+        return "fresh"
+
+    revision(extracted, stem)
+    for name in identity_cookies[1:]:
+        if name in values:
+            revision(values[name], stem)
+    for name in (".install_done", ".package_done"):
+        if name in values:
+            revision(values[name], stem)
+    package_identity = values.get(".package_done") or values.get(".install_done")
+    if package_identity is None:
+        package_identity = extracted
+    else:
+        revision(package_identity, stem)
+    return "same" if revision(package_identity, stem) == revision(current, stem) else "revision"
+
+
+try:
+    if sys.argv[1:2] == ["--stage-local"]:
+        print(stage_local(*sys.argv[2:]))
+    else:
+        print(check(sys.argv[1:]))
+except (OSError, UnicodeError, ValueError) as error:
+    print("repackage-metadata: " + str(error), file=sys.stderr)
+    raise SystemExit(1)
