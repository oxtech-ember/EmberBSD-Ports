+	    _EMBER_REPACKAGE_IDENTITY="$$old" \
+	    _EMBER_REPACKAGE_PKGPATH=${PKGPATH:Q} \
+	    _EMBER_REPACKAGE_WRKDIR=${WRKDIR:Q} package
+.endif
 
