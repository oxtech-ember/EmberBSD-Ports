@@ -55,7 +61,54 @@
 static int cache_connections = 16;
 static int cache_connections_host = 4;
 
-const char     *config_file = SYSCONFDIR"/pkg_install.conf";
+static const char config_file_default[] = SYSCONFDIR "/pkg_install.conf";
+const char     *config_file = config_file_default;
+static const char *pkg_install_bindir;
+
+void
+pkg_install_init_paths(void)
+{
+#ifdef __APPLE__
+	uint32_t size = 0;
+	char *path, resolved[PATH_MAX + 1];
+	char *slash, *bindir;
+	const char *prefix;
+	const char *separator;
+
+	(void)_NSGetExecutablePath(NULL, &size);
+	if (size == 0)
+		errx(1, "cannot resolve executable path for pkg_install defaults");
+	path = xmalloc(size);
+	if (_NSGetExecutablePath(path, &size) != 0 ||
+	    realpath(path, resolved) == NULL) {
+		free(path);
+		errx(1, "cannot resolve executable path for pkg_install defaults");
+	}
+	free(path);
+	slash = strrchr(resolved, '/');
+	if (slash == NULL)
+		return;
+	*slash = '\0';
+	bindir = strrchr(resolved, '/');
+	if (bindir == NULL || strcmp(bindir + 1, "sbin") != 0)
+		return;
+	pkg_install_bindir = xstrdup(resolved);
+	*bindir = '\0';
+	prefix = resolved[0] == '\0' ? "/" : resolved;
+	separator = strcmp(prefix, "/") == 0 ? "" : "/";
+	if (strcmp(config_file, config_file_default) == 0)
+		config_file = xasprintf("%s%setc/pkg_install.conf", prefix, separator);
+	path = xasprintf("%s%spkgdb", prefix, separator);
+	pkgdb_set_dir(path, 0);
+	free(path);
+#endif
+}
+
+const char *
+pkg_install_sbindir(void)
+{
+	return pkg_install_bindir;
+}
 
