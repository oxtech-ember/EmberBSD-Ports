--- a/devel/libtool-base/files/cross-target.awk
+++ b/devel/libtool-base/files/cross-target.awk
@@ -0,0 +1,67 @@
+# SPDX-License-Identifier: BSD-2-Clause
+# Origin: EmberBSD (AI-assisted), not submitted upstream.
+# Convert a cross-configured script into an installed NetBSD target tool.
+# Literal replacements avoid interpreting build directory names as regexps.
+function replace_literal(text, from, to,    result, position) {
+    result = ""
+    while (from != "" && (position = index(text, from)) != 0) {
+        result = result substr(text, 1, position - 1) to
+        text = substr(text, position + length(from))
+    }
+    return result text
+}
+# pkgsrc may name a cross tool by its TOOLDIR path or by its bare name.
+function replace_tool(text, name, to) {
+    text = replace_literal(text, tooldir "/bin/" triplet "-" name, to)
+    return replace_literal(text, triplet "-" name, to)
+}
+{
+    text = $0
+    # Configure ran under host mksh; the target POSIX shell has no print builtin.
+    text = replace_literal(text, "print -r --", "printf %s\\\\n")
+    # Configure writes its CONFIG_SHELL, a host shell, into the scripts.
+    text = replace_literal(text, config_shell, "/bin/sh")
+    text = replace_literal(text, host_shell, "/bin/sh")
+    text = replace_literal(text, host_sed, "/usr/bin/sed")
+    text = replace_literal(text, host_ld, "/usr/bin/ld")
+    if (family == "gcc") {
+        text = replace_tool(text, "g++", target_gcc "/bin/g++")
+        text = replace_tool(text, "gcc", target_gcc "/bin/gcc")
+    } else {
+        # Longest names first: -clang is a prefix of -clang++ and -clang-cpp.
+        text = replace_tool(text, "clang++", target_bin "/clang++")
+        text = replace_tool(text, "clang-cpp", target_bin "/clang-cpp")
+        text = replace_tool(text, "clang", target_bin "/clang")
+    }
+    for (i = 1; i <= 5; i++) {
+        tool = tools[i]
+        text = replace_tool(text, tool, "/usr/bin/" tool)
+    }
+    # NetBSD 11 sys/sys/syslimits.h defines ARG_MAX as 256 KiB.
+    # Apply the upstream BSD 3/4 margin for environment and extra arguments.
+    if (text ~ /^max_cmd_len=/)
+        text = "max_cmd_len=196608"
+    # Clang reports its resource and library directories below the sysroot;
+    # the same paths are the target's. GCC16 names its versioned runtime.
+    if (text ~ /^sys_lib_search_path_spec=/) {
+        if (family == "gcc")
+            text = "sys_lib_search_path_spec=\"" target_gcc "/lib/gcc/" triplet "/" gcc_version " " target_gcc "/lib /usr/lib /lib\""
+        else
+            text = replace_literal(text, sysroot, "")
+    }
+    if (text ~ /^build(_alias)?=/)
+        sub(/=.*/, "=" triplet, text)
+    if (index(text, sysroot) || index(text, tooldir) || index(text, host_prefix)) {
+        print "unconverted build-host path in " FILENAME ":" FNR > "/dev/stderr"
+        bad = 1
+    }
+    print text
+}
+BEGIN {
+    if (family != "gcc" && family != "clang") {
+        print "select the gcc or clang compiler family" > "/dev/stderr"
+        exit 2
+    }
+    split("ar ranlib nm objdump strip", tools, " ")
+}
+END { if (bad) exit 1 }
