--- a/devel/libtool-base/Makefile
+++ b/devel/libtool-base/Makefile
@@ -60,6 +60,8 @@
 CONFIGURE_ARGS+=	--disable-ltdl-install
 CONFIGURE_ARGS+=	F77=no FC=no
 
+# libtoolize discovers GNU M4 at runtime; host tools do not satisfy this.
+DEPENDS+=		m4>=1.4.21:../../devel/m4
 USE_TOOLS+=		echo
 
 REPLACE_SH+=	libtoolize.in
@@ -81,8 +83,33 @@
 		-e "s|@SH@|"${SH:Q}"|g"					\
 		${FILESDIR}/shlibtool.in > ${WRKSRC}/shlibtool
 
+# The installed script runs on NetBSD; cross-libtool remains a host tool.
+.if defined(EMBERBSD_CROSS_HOST_PREFIX) && ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD"
+# Name the installed target compiler of the selected cross family.
+.if ${EMBERBSD_CROSS_COMPILER_FAMILY:Uclang} == "gcc"
+_EMBER_LIBTOOL_COMPILER=	-v family=gcc -v target_gcc=/usr/pkg/gcc16 -v gcc_version=16.2.0
+.else
+_EMBER_LIBTOOL_COMPILER=	-v family=clang -v target_bin=${PREFIX}/bin
+.endif
+post-install: ember-target-libtool
+.PHONY: ember-target-libtool
+ember-target-libtool:
+	${INSTALL_SCRIPT} ${WRKSRC}/shlibtool ${DESTDIR}${PREFIX}/bin/shlibtool
+	set -e; for f in libtool libtoolize shlibtool; do \
+		${AWK} -v host_shell=${SH:Q} -v config_shell=${CONFIG_SHELL:Q} \
+		    -v host_sed=${SED:Q} \
+		    -v host_ld=${LD:Q} -v triplet=${MACHINE_GNU_PLATFORM:Q} \
+		    ${_EMBER_LIBTOOL_COMPILER} \
+		    -v sysroot=${CROSS_DESTDIR:Q} -v tooldir=${TOOLDIR:Q} \
+		    -v host_prefix=${EMBERBSD_CROSS_HOST_PREFIX:Q} \
+		    -f ${FILESDIR}/cross-target.awk \
+		    ${DESTDIR}${PREFIX}/bin/$$f > ${WRKDIR}/$$f.target; \
+		${INSTALL_SCRIPT} ${WRKDIR}/$$f.target ${DESTDIR}${PREFIX}/bin/$$f; \
+	done
+.else
 post-install:
 	${INSTALL_SCRIPT} ${WRKSRC}/shlibtool ${DESTDIR}${PREFIX}/bin/shlibtool
+.endif
 
 BUILDLINK_DEPMETHOD.dlcompat=	build
 
