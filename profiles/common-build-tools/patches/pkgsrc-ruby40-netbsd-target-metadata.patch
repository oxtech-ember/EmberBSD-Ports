--- a/lang/ruby40/Makefile
+++ b/lang/ruby40/Makefile
@@ -21,12 +21,28 @@
 
 # Resolve native Darwin Ruby libraries relative to the installed libruby.
 .include "../../mk/bsd.prefs.mk"
-.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD" && \
-    ${MACHINE_ARCH} == "aarch64"
+PLIST_VARS+=	bundled_ext_makefiles
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD"
+PKGREVISION=	1
+.  if ${MACHINE_ARCH} == "aarch64"
 # NetBSD 11 base sets carry different OpenSSL SONAMEs.
-PKGREVISION=	1
 PREFER.openssl=	pkgsrc
 BUILDLINK_ABI_DEPENDS.openssl+=	openssl>=4.1.0
+.  endif
+
+# Install the target configuration after Ruby has finished using its build tools.
+post-install: ruby-install-target-metadata
+.PHONY: ruby-install-target-metadata
+ruby-install-target-metadata:
+	${TOOLBASE:Q}/bin/${RUBY_NAME:Q} --disable-gems \
+	    ${.CURDIR:Q}/install-rbconfig.rb \
+	    ${DESTDIR:Q}${PREFIX:Q}/${RUBY_ARCHLIB}/rbconfig.rb ${WRKSRC:Q} cross
+# Ruby generates these fragments while building extensions from bundled gems.
+.for gem in bigdecimal debug fiddle nkf racc rbs syslog
+	${RM} -f ${DESTDIR:Q}${PREFIX:Q}/${GEM_HOME}/gems/${gem}-${RUBY_${gem:tu}_VER}/exts.mk
+.endfor
+.else
+PLIST.bundled_ext_makefiles=	yes
 .endif
 .if ${OPSYS} == "Darwin" && ${USE_CROSS_COMPILE:Uno:tl} != "yes"
 CONFIGURE_ARGS+=	--enable-load-relative
