+
+// The selected libuv accepts full-length mixed IPv6 addresses with zones.
+const { AF_INET6 } = internalBinding('block_list');
+const mixed = 'ffff:ffff:ffff:ffff:ffff:ffff:255.255.255.255';
+blockList.addAddress(mixed, 'ipv6');
+const longZone = `${mixed}%${'z'.repeat(200)}`;
+function checkMixed(address) {
+  return handle.checkString(address, AF_INET6);
+}
+eval('%PrepareFunctionForOptimization(checkMixed)');
+assert.strictEqual(checkMixed(longZone), true);
+assert.strictEqual(checkMixed(`${mixed}X%${'z'.repeat(200)}`), true);
+assert.strictEqual(checkMixed(`not-an-ip%${'z'.repeat(200)}`), false);
+eval('%OptimizeFunctionOnNextCall(checkMixed)');
+assert.strictEqual(checkMixed(longZone), true);
+assert.strictEqual(checkMixed(`${mixed}X%${'z'.repeat(200)}`), true);
+assert.strictEqual(checkMixed(`not-an-ip%${'z'.repeat(200)}`), false);
