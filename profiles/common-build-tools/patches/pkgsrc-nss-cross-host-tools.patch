+ OS_CFLAGS=$(NATIVE_FLAGS)
+ endif
+ 
+-ifdef NATIVE_LDFLAGS
++ifneq ($(origin NATIVE_LDFLAGS),undefined)
+ LDFLAGS=$(NATIVE_LDFLAGS)
+ endif
+ 
+@@ -48,6 +48,10 @@
