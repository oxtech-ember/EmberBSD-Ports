+ endif
+ 
++ifneq ($(origin NATIVE_CC),undefined)
++NATIVE_PROGRAM=$(PROGRAM)
++endif
++
+ include $(DEPTH)/coreconf/rules.mk
+ 
+ # Redefine MAKE_OBJDIR for just this directory
