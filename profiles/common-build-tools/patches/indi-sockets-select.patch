Origin: EmberBSD (AI-assisted).
POSIX declares select() and struct timeval in <sys/select.h>. NetBSD's
<sys/socket.h> does not include it, so the socket helpers did not build.

--- libs/sockets/select.h.orig
+++ libs/sockets/select.h
@@ -35,6 +35,7 @@
 #include <unistd.h>
 #include <netdb.h>
 #include <sys/socket.h> // select
+#include <sys/select.h>
 typedef int SocketFileDescriptor;
 static const SocketFileDescriptor SocketInvalid = -1;
 #endif
