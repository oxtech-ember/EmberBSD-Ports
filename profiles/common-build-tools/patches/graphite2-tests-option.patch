--- a/graphics/graphite2/Makefile
+++ b/graphics/graphite2/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.24 2026/06/09 08:36:09 wiz Exp $
 
 DISTNAME=	graphite2-1.3.15
+PKGREVISION=	1
 CATEGORIES=	graphics
 MASTER_SITES=	${MASTER_SITE_GITHUB:=silnrsi/}
 GITHUB_PROJECT=	graphite
@@ -18,6 +19,24 @@
 
 .include "../../mk/bsd.prefs.mk"
 
+PKG_OPTIONS_VAR= PKG_OPTIONS.graphite2
+PKG_SUPPORTED_OPTIONS= tests
+.include "../../mk/bsd.options.mk"
+PLIST_VARS+= tests
+.if !empty(PKG_OPTIONS:Mtests)
+CMAKE_CONFIGURE_ARGS+= -DBUILD_TESTING=ON
+PLIST.tests= yes
+TEST_TARGET= test
+PYTHON_FOR_BUILD_ONLY?= tool
+TOOL_DEPENDS+= ${PYPKGPREFIX}-fonttools-[0-9]*:../../fonts/py-fonttools
+.else
+CMAKE_CONFIGURE_ARGS+= -DBUILD_TESTING=OFF
+do-test:
+	@${FAIL_MSG} "Enable the tests package option before running tests."
+	@${FALSE}
+.endif
+
+
 .if ${OPSYS} == "Linux"
 # Linux seems to need this to build by default, but apparently it is
 # only used for test, so for now use 'build' dependency
--- a/graphics/graphite2/PLIST
+++ b/graphics/graphite2/PLIST
@@ -1,5 +1,5 @@
 @comment $NetBSD: PLIST,v 1.4 2019/01/24 13:42:55 tnn Exp $
-bin/gr2fonttest
+${PLIST.tests}bin/gr2fonttest
 include/graphite2/Font.h
 include/graphite2/Log.h
 include/graphite2/Segment.h
