$NetBSD$

OpenSSL 4 returns certificate names, name entries and extension data
as const and makes ASN1_STRING opaque; use const pointers and accessors.

Origin: EmberBSD contributors (AI-assisted); not submitted upstream.

--- src/core/credentials/transport/tls/grpc_tls_crl_provider.cc.orig
+++ src/core/credentials/transport/tls/grpc_tls_crl_provider.cc
@@ -56,7 +56,7 @@
   if (crl == nullptr) {
     return absl::InvalidArgumentError("crl cannot be null");
   }
-  X509_NAME* issuer = X509_CRL_get_issuer(crl);
+  const X509_NAME* issuer = X509_CRL_get_issuer(crl);
   if (issuer == nullptr) {
     return absl::InvalidArgumentError("crl cannot have null issuer");
   }
