--- /dev/null
+++ b/lang/ruby40/patches/patch-template_coroutine_context
@@ -0,0 +1,20 @@
+$NetBSD$
+
+Build the configured coroutine implementation using its exact filename.
+On case-insensitive build hosts the implicit .s rule skips preprocessing
+of Context.S and its platform symbol definitions.
+
+--- template/Makefile.in.orig
++++ template/Makefile.in
+@@ -504,6 +504,11 @@
+ 	@$(ECHO) assembling $<
+ 	$(Q) $(CC) $(CFLAGS) $(XCFLAGS) $(CPPFLAGS) $(COUTFLAG)$@ "-DPREFIXED_SYMBOL(name)=$($(SYMBOL_PREFIX)PREFIXED_SYMBOL)" -c $<
+ 
++# Use the exact source selected by configure on case-insensitive build hosts.
++$(COROUTINE_OBJ): $(srcdir)/$(COROUTINE_SRC)
++	@$(ECHO) compiling $(COROUTINE_SRC)
++	$(Q) $(CC) $(CFLAGS) $(XCFLAGS) $(CPPFLAGS) $(COUTFLAG)$@ "-DPREFIXED_SYMBOL(name)=$($(SYMBOL_PREFIX)PREFIXED_SYMBOL)" -c $(srcdir)/$(COROUTINE_SRC)
++
+ .c.$(ASMEXT):
+ 	@$(ECHO) translating $<
+ 	$(Q) $(CC) $(CFLAGS) $(XCFLAGS) $(CPPFLAGS) $(COUTFLAG)$@ -S $<
