@@ -0,0 +1,46 @@
+$NetBSD$
+
+Declare future JIT page permissions when reserving address space on NetBSD.
+The reservation starts inaccessible and pages alternate between RW and RX.
+
+--- jit.c.orig
++++ jit.c
+@@ -638,6 +638,11 @@
+ {
+ #ifndef _WIN32
+     uint8_t *mem_block;
++    int reserve_prot = PROT_NONE;
++#ifdef PROT_MPROTECT
++    // NetBSD requires a reservation to declare the later RW and RX transitions.
++    reserve_prot |= PROT_MPROTECT(PROT_READ | PROT_WRITE | PROT_EXEC);
++#endif
+ 
+     // On Linux
+     #if defined(MAP_FIXED_NOREPLACE) && defined(_SC_PAGESIZE)
+@@ -653,7 +658,7 @@
+             mem_block = mmap(
+                 req_addr,
+                 mem_size,
+-                PROT_NONE,
++                reserve_prot,
+                 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE,
+                 -1,
+                 0
+@@ -678,7 +683,7 @@
+         mem_block = mmap(
+             (void *)rb_jit_reserve_addr_space,
+             mem_size,
+-            PROT_NONE,
++            reserve_prot,
+             MAP_PRIVATE | MAP_ANONYMOUS,
+             -1,
+             0
+@@ -691,7 +696,7 @@
+         mem_block = mmap(
+             NULL,
+             mem_size,
+-            PROT_NONE,
++            reserve_prot,
+             MAP_PRIVATE | MAP_ANONYMOUS,
+             -1,
+             0
