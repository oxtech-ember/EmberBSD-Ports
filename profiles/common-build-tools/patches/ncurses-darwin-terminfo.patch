  *
  ****************************************************************************/
 
+#if defined(EMBERBSD_DARWIN_TERMINFO) && NCURSES_USE_DATABASE
+/*
+ * On disk, init_file and reset_file retain their standard FHS names so other
+ * terminfo readers can use them. Return the matching file shipped next to the
+ * selected database when a Darwin SDK is installed in another location.
+ */
+#undef CUR
+#define CUR tp->
+static void
+relocate_tabsets(TERMTYPE2 *tp, const char *filename)
+{
+    static const char standard[] = "/usr/share/tabset/";
+    char **caps[] = { &init_file, &reset_file };
+    char local[2][PATH_MAX];
+    char entry[PATH_MAX], candidate[PATH_MAX];
+    char *leaf, *dir;
+    unsigned i;
+    bool changed = FALSE;
+
+    if (!((VALID_STRING(init_file) && !strncmp(init_file, standard, sizeof(standard) - 1)) ||
+          (VALID_STRING(reset_file) && !strncmp(reset_file, standard, sizeof(standard) - 1))))
+        return;
+    if (realpath(filename, entry) == NULL)
+        return;
+    leaf = strrchr(entry, '/');
+    if (leaf == NULL)
+        return;
+    *leaf = '\0';
+    dir = strrchr(entry, '/');
+    if (dir == NULL)
+        return;
+    *dir = '\0';
+    dir = strrchr(entry, '/');
+    if (dir == NULL || strcmp(dir, "/terminfo") != 0)
+        return;
+    *dir = '\0';
+    for (i = 0; i < SIZEOF(caps); ++i) {
+        char *path = *caps[i];
+        const char *name;
+        int len;
+
+        if (!VALID_STRING(path) || strncmp(path, standard, sizeof(standard) - 1))
+            continue;
+        name = path + sizeof(standard) - 1;
+        if (*name == '\0' || *name == '.' || strchr(name, '/') != NULL)
+            continue;
+        len = snprintf(candidate, sizeof(candidate), "%s/tabset/%s", entry, name);
+        if (len < 0 || (size_t) len >= sizeof(candidate) ||
+            realpath(candidate, local[i]) == NULL || access(local[i], R_OK) != 0)
+            continue;
+        if (strcmp(local[i], path) != 0) {
+            *caps[i] = local[i];
+            changed = TRUE;
+        }
+    }
+    if (changed) {
+        TERMTYPE2 old = *tp;
+        /* Give the entry its own strings before the stack paths go away. */
+        _nc_copy_termtype2(tp, &old);
+        _nc_free_termtype2(&old);
+    }
+}
+#undef CUR
+#define CUR TerminalType(termp).
+#endif
+
 #if NCURSES_USE_DATABASE || NCURSES_USE_TERMCAP
 /*
  * Return 1 if entry found, 0 if not found, -1 if database not accessible,
