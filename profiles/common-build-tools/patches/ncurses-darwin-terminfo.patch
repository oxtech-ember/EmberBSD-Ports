@@ -55,6 +55,53 @@
 #define my_time          _nc_globals.dbd_time
 #define my_vars          _nc_globals.dbd_vars
 
+#ifdef EMBERBSD_DARWIN_TERMINFO
+#include <dlfcn.h>
+#include <pthread.h>
+
+/* Locate the database shipped beside a Darwin library or static SDK consumer. */
+static pthread_once_t terminfo_once = PTHREAD_ONCE_INIT;
+static char image_terminfo[PATH_MAX];
+
+static void
+find_image_terminfo(void)
+{
+    Dl_info info;
+    char image[PATH_MAX];
+    char *name, *libdir;
+    int length;
+
+    if (!dladdr((const void *) &find_image_terminfo, &info) ||
+        !info.dli_fname || !realpath(info.dli_fname, image))
+        return;
+    name = strrchr(image, '/');
+    if (name == NULL)
+        return;
+    *name = '\0';
+    libdir = strrchr(image, '/');
+    if (!libdir || (strcmp(libdir, "/lib") && strcmp(libdir, "/bin") &&
+                    strcmp(libdir, "/sbin")))
+        return;
+    *libdir = '\0';
+    length = snprintf(image_terminfo, sizeof(image_terminfo),
+                      "%s/@TERMINFODIR@", image);
+    if (length < 0 || (size_t) length >= sizeof(image_terminfo) ||
+        access(image_terminfo, R_OK | X_OK) < 0)
+        image_terminfo[0] = '\0';
+}
+
+static const char *
+default_terminfo(const char *configured)
+{
+    if (strcmp(configured, TERMINFO))
+        return configured;
+    pthread_once(&terminfo_once, find_image_terminfo);
+    return image_terminfo[0] ? image_terminfo : configured;
+}
+#else
+#define default_terminfo(path) (path)
+#endif
