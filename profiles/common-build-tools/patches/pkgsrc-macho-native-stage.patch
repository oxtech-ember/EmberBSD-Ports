-function compatible(path, arch,    provider) {
+# Select the physical provider while preserving the logical installed name.
+# An explicitly selected replacement stage must not fall back to active H.
+function provider_path(path) {
+	if (destdir != "" && exists(destdir path)) return destdir path
+	if (cross_destdir != "") return cross_destdir path
