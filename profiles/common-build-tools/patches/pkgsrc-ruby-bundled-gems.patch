-.include "../../lang/ruby/rubyversion.mk"
-# for older Ruby
-.if ${RUBY_VER} < 40
-DEPENDS+=	${RUBY_PKGPREFIX}-benchmark>=0.5<0.6:../../benchmarks/ruby-benchmark
-.endif
-
 .include "../../lang/ruby/gem.mk"
 .include "../../mk/bsd.pkg.mk"
--- a/www/ruby-neocities/Makefile
