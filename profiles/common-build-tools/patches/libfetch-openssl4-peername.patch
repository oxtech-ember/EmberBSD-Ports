+#ifdef WITH_SSL
+static int
+fetch_ssl_set_peername(SSL *ssl, const char *host)
+{
+	if (host == NULL || *host == '\0')
+		return (0);
+	return (SSL_set1_ipaddr(ssl, host) || SSL_set1_dnsname(ssl, host));
+}
+#endif
