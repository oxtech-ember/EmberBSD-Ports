--- /dev/null
+++ b/lang/ruby/install-cross-extensions.rb
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: BSD-2-Clause
+# Origin: EmberBSD contributors (AI-assisted).
+# Match RubyGems' extension layout inside the target package staging directory.
+require "fileutils"
+require "rubygems"
+
+def checked_path(path, root)
+  resolved = File.realpath(path)
+  unless resolved == root || resolved.start_with?(root + File::SEPARATOR)
+    abort "Ruby extension path is outside its staging directory: #{path}"
+  end
+  resolved
+end
+
+def destination_directory(root, components)
+  components.reduce(root) do |parent, name|
+    abort "Invalid relative Ruby extension directory" if name.empty? || name == "." || name == ".."
+    path = File.join(parent, name)
+    Dir.mkdir(path) unless File.exist?(path) || File.symlink?(path)
+    resolved = checked_path(path, root)
+    abort "Ruby extension parent is not a directory: #{path}" unless File.directory?(resolved)
+    resolved
+  end
+end
+
+extensions, gemdir, gemspec, suffix = ARGV
+exit unless Gem.install_extension_in_lib && File.directory?(extensions)
+
+stage = File.realpath(Dir.pwd)
+extensions = checked_path(extensions, stage)
+gemdir = checked_path(gemdir, stage)
+spec = Gem::Specification.load(checked_path(gemspec, stage)) or abort "Missing installed gem specification"
+require_path = spec.raw_require_paths.fetch(0)
+require_dir = File.expand_path(require_path, gemdir)
+unless require_dir == gemdir || require_dir.start_with?(gemdir + File::SEPARATOR)
+  abort "Ruby extension require path is outside the installed gem"
+end
+relative = require_dir.delete_prefix(gemdir).delete_prefix(File::SEPARATOR)
+require_dir = destination_directory(gemdir, relative.split(File::SEPARATOR))
+Dir.glob("**/*.#{suffix}", base: extensions).each do |entry|
+  source = checked_path(File.join(extensions, entry), extensions)
+  abort "Ruby extension is not a regular file: #{entry}" unless File.file?(source)
+  parts = entry.split(File::SEPARATOR)
+  basename = parts.pop
+  parent = destination_directory(require_dir, parts)
+  target = File.join(parent, basename)
+  abort "Ruby extension destination is a symlink: #{entry}" if File.symlink?(target)
+  FileUtils.install(source, target, preserve: true)
+end
