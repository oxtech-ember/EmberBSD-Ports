+# SPDX-License-Identifier: BSD-2-Clause
+# Origin: EmberBSD contributors (AI-assisted).
+# RubyGems and mkmf load the target config in a module on the build host.
+# Use mkmf's compile-time probes inside that module.
+CROSS_COMPILING = true
+Kernel.load ENV.fetch("PKGSRC_RUBY_TARGET_RBCONFIG"), Module.nesting.first
