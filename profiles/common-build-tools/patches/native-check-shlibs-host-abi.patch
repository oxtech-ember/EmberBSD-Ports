--- a/mk/check/check-shlibs-elf.awk
+++ b/mk/check/check-shlibs-elf.awk
@@ -157,6 +157,30 @@
 
 # Expand only a leading standard token. Resolve dot components later, after
 # walking target symlinks, rather than applying lexical host normalization.
+# Native Linux packages may use only their selected prefix and declared
+# system ABI directories. Target checks never enable this fallback.
+function host_realpath(value,    cmd, line, result) {
+	cmd = "readlink -f " shquote(value) " 2>/dev/null"
+	result = ""
+	if ((cmd | getline line) > 0) result = line
+	close(cmd)
+	return result
+}
+function host_abi_file(value,    file, dir, prefixdir, count, dirs, i, allowed) {
+	file = host_realpath(value)
+	if (file == "" || system("test -f " shquote(file)) != 0) return ""
+	prefixdir = host_realpath(prefix)
+	if (prefixdir != "" && index(file, prefixdir "/") == 1) return file
+	dir = file
+	sub(/\/[^\/]*$/, "", dir)
+	count = split(system_rpath, dirs, ":")
+	for (i = 1; i <= count; i++) {
+		allowed = host_realpath(dirs[i])
+		if (allowed != "" && dir == allowed) return file
+	}
+	return ""
+}
+
 function runtime_path(value, origin,    rest) {
 	if (value ~ /^\$ORIGIN(\/|$)/) {
 		rest = substr(value, 8)
