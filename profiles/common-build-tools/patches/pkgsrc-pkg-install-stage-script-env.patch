+/* Keep a nested -P invocation from prefixing an already rooted path twice. */
+char *
+pkgdb_stage_path(const char *root, const char *path)
+{
+	static int initialized;
+	static char *inherited_root;
+	size_t len;
+	const char *value;
+
+	if (!initialized) {
+		value = getenv(PKG_DESTDIR_VNAME);
+		if (value != NULL)
+			inherited_root = xstrdup(value);
+		initialized = 1;
+	}
+	if (root == NULL)
+		return xstrdup(path);
+	len = strlen(root);
+	while (len > 1 && root[len - 1] == '/')
+		len--;
+	if (config_pkg_refcount_from_env && inherited_root != NULL &&
+	    strcmp(inherited_root, root) == 0 &&
+	    ((len == 1 && root[0] == '/' && path[0] == '/') ||
+	    (strncmp(path, root, len) == 0 &&
+	    (path[len] == '/' || path[len] == '\0'))))
+		return xstrdup(path);
+	return xasprintf("%.*s/%s", (int)len, root, path);
+}
+
 /*
  *  Return the location of the package reference counts database directory.
  */
