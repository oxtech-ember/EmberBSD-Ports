$NetBSD$

Query Darwin host and process memory through Mach instead of external tools.
Release the host port acquired for host_statistics, including the existing
sysctl memory query.

Origin: EmberBSD (AI-assisted). Not submitted upstream.

--- a/Source/kwsys/SystemInformation.cxx
+++ b/Source/kwsys/SystemInformation.cxx
@@ -3779,6 +3779,29 @@
   return memAvail;
 }
 
+#if defined(__APPLE__)
+static bool kw_host_vm_statistics(vm_statistics_data_t* vmstat,
+                                  mach_msg_type_number_t* count)
+{
+  if (!vmstat || !count) {
+    return false;
+  }
+  mach_port_t hostPort = mach_host_self();
+  if (hostPort == MACH_PORT_NULL) {
+    return false;
+  }
+
+  kern_return_t const hostStatus =
+    host_statistics(hostPort, HOST_VM_INFO,
+                    reinterpret_cast<host_info_t>(vmstat), count);
+  bool const complete =
+    hostStatus == KERN_SUCCESS && *count >= HOST_VM_INFO_COUNT;
+  kern_return_t const deallocateStatus =
+    mach_port_deallocate(mach_task_self(), hostPort);
+  return complete && deallocateStatus == KERN_SUCCESS;
+}
+#endif
