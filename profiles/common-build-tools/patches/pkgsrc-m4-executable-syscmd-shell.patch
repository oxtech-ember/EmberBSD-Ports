# Origin: EmberBSD (AI-assisted); relocatable GNU M4 syscmd shell.
--- a/devel/m4/Makefile
+++ b/devel/m4/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.84 2026/04/07 12:23:36 wiz Exp $
 
 DISTNAME=	m4-1.4.21
-PKGREVISION=	1
+PKGREVISION=	2
 CATEGORIES=	devel
 MASTER_SITES=	${MASTER_SITE_GNU:=m4/}
 
@@ -21,8 +21,20 @@
 
 # This is the target runtime shell, not the shell that runs configure.
 # Leave upstream selection unchanged unless the consumer sets this path.
+# @executable_path/NAME names one file beside the installed gm4, so a
+# relocated prefix keeps its shell (patch-zz-ember-executable-syscmd-shell).
 .if defined(M4_SYSCMD_SHELL)
-.  if empty(M4_SYSCMD_SHELL) || "${M4_SYSCMD_SHELL:tW:C,^/.*,/,}" != "/"
+.  if !empty(M4_SYSCMD_SHELL:M@executable_path/*)
+_M4_SYSCMD_SHELL_NAME= ${M4_SYSCMD_SHELL:tW:S,^@executable_path/,,}
+.    if "${_M4_SYSCMD_SHELL_NAME:C,^[A-Za-z0-9_+-][A-Za-z0-9_.+-]*$,ok,}" != "ok"
+PKG_FAIL_REASON+= "M4_SYSCMD_SHELL must name one file after @executable_path/."
+.    else
+CONFIGURE_ARGS+= --with-syscmd-shell=${M4_SYSCMD_SHELL:Q}
+# The test suite runs the uninstalled src/m4; give it the same neighbour.
+pre-test:
+	${LN} -sf ${PREFIX}/bin/${_M4_SYSCMD_SHELL_NAME} ${WRKSRC}/src/${_M4_SYSCMD_SHELL_NAME}
+.    endif
+.  elif empty(M4_SYSCMD_SHELL) || "${M4_SYSCMD_SHELL:tW:C,^/.*,/,}" != "/"
 PKG_FAIL_REASON+= "M4_SYSCMD_SHELL must be an absolute target runtime shell path."
 .  else
 CONFIGURE_ARGS+= --with-syscmd-shell=${M4_SYSCMD_SHELL:Q}
