Standard Darwin OpenSSL runtime paths follow the shared library location.
Origin: EmberBSD contributors (AI-assisted). SPDX-License-Identifier: Apache-2.0.

--- crypto/defaults.c.orig
+++ crypto/defaults.c
@@ -132,6 +132,55 @@
 }
 #endif /* defined(_WIN32) && defined(OSSL_WINCTX) */
 
+#if defined(__APPLE__) && !defined(OPENSSL_NO_DSO)
+# include <dlfcn.h>
+# include <limits.h>
+# include <stdlib.h>
+# include <string.h>
+
+/* Origin: EmberBSD (AI-assisted). Keep the standard shared-library layout
+ * relative to libcrypto. Explicit nonstandard configuration paths stay fixed.
+ */
+# define EMBERBSD_OPENSSL_PREFIX "@PREFIX@"
+
+static CRYPTO_ONCE relative_defaults_once = CRYPTO_ONCE_STATIC_INIT;
+static char relative_openssldir[PATH_MAX];
+static char relative_modulesdir[PATH_MAX];
+
+DEFINE_RUN_ONCE_STATIC(set_relative_defaults)
+{
+    Dl_info image;
+    char path[PATH_MAX], *name;
+    size_t length;
+    const char conf_suffix[] = "/etc/openssl";
+    const char modules_suffix[] = "/lib/ossl-modules";
+
+    if (dladdr((void *)&ossl_get_openssldir, &image) == 0
+        || image.dli_fname == NULL || realpath(image.dli_fname, path) == NULL)
+        return 1;
+    name = strrchr(path, '/');
+    if (name == NULL)
+        return 1;
+    *name = '\0';
+    length = strlen(path);
+    if (length < 4 || strcmp(path + length - 4, "/lib") != 0)
+        return 1;
+    path[length - 4] = '\0';
+    length -= 4;
+    if (length + sizeof(modules_suffix) > sizeof(relative_modulesdir))
+        return 1;
+    if (strcmp(OPENSSLDIR, EMBERBSD_OPENSSL_PREFIX "/etc/openssl") == 0) {
+        memcpy(relative_openssldir, path, length);
+        memcpy(relative_openssldir + length, conf_suffix, sizeof(conf_suffix));
+    }
+    if (strcmp(MODULESDIR, EMBERBSD_OPENSSL_PREFIX "/lib/ossl-modules") == 0) {
+        memcpy(relative_modulesdir, path, length);
+        memcpy(relative_modulesdir + length, modules_suffix, sizeof(modules_suffix));
+    }
+    return 1;
+}
+#endif
+
 /**
