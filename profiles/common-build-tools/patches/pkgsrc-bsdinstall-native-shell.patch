BSD install: selected native shell and strip follow the executable; avoid bootstrap checker cycle.

Origin: EmberBSD, AI-assisted adaptation of the pinned pkgsrc bootstrap recipe.
The upstream BSD source and copyright notices remain unchanged.

--- a/sysutils/bsdinstall/Makefile
+++ b/sysutils/bsdinstall/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.8 2025/04/19 08:07:27 wiz Exp $
 
 DISTNAME=	bsdinstall-20160108
-PKGREVISION=	1
+PKGREVISION=	2
 CATEGORIES=	sysutils
 MASTER_SITES=	# empty
 DISTFILES=	# empty
@@ -14,6 +14,9 @@
 
 BOOTSTRAP_PKG=	yes
 
+# checkperms itself requires this bootstrap installer.
+CHECK_PERMS=	no
+
 USE_BSD_MAKEFILE=	yes
 USE_FEATURES=		nbcompat
 
@@ -24,11 +27,29 @@
 	@${TOUCH} ${WRKSRC}/bsdinstall.cat1
 
 CPPFLAGS+=	-D_PATH_DEVNULL=\"/dev/null\"
-CPPFLAGS+=	-DTARGET_STRIP=\"${TOOLS_PLATFORM.strip:Q}\"
 
 CPPFLAGS.SunOS+=	-D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE
 
 .include "../../mk/bsd.prefs.mk"
+
+# Native children use the selected providers; target tools keep donor defaults.
+.if ${USE_CROSS_COMPILE:Uno:tl} != "yes"
+_EMBER_BSDINSTALL_SHELL= ${EMBERBSD_BSDINSTALL_SHELL:U${TOOLS_PLATFORM.sh}}
+.if "${TOOLS_PLATFORM.strip:H}" == "${LOCALBASE}/bin"
+CPPFLAGS+= -DEMBERBSD_EXECUTABLE_RELATIVE=1
+CPPFLAGS+= -DTARGET_STRIP=\"@executable_path/../bin/${TOOLS_PLATFORM.strip:T}\"
+.else
+CPPFLAGS+= -DTARGET_STRIP=\"${TOOLS_PLATFORM.strip:Q}\"
+.endif
+.if !empty(_EMBER_BSDINSTALL_SHELL)
+.if "${_EMBER_BSDINSTALL_SHELL:H}" == "${LOCALBASE}/bin"
+CPPFLAGS+= -DEMBERBSD_EXECUTABLE_RELATIVE=1
+CPPFLAGS+= -DEMBERBSD_BSDINSTALL_SHELL=\"@executable_path/../bin/${_EMBER_BSDINSTALL_SHELL:T}\"
+.else
+CPPFLAGS+= -DEMBERBSD_BSDINSTALL_SHELL=\"${_EMBER_BSDINSTALL_SHELL:Q}\"
+.endif
+.endif
+.endif
 .if !empty(MACHINE_PLATFORM:MSunOS-5.11-*)
 MAKE_ENV+=	NOGCCERROR=yes
 .endif
