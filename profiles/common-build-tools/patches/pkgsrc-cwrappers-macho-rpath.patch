+/* A runtime token is not a build-host relative directory. */
+static int
+macho_rpath(const char *path)
+{
+
+	return ((strncmp(path, "@loader_path", 12) == 0 &&
+	    (path[12] == '\0' || path[12] == '/')) ||
+	    (strncmp(path, "@executable_path", 16) == 0 &&
+	    (path[16] == '\0' || path[16] == '/')));
+}
+
+/* Both cleanup passes use the same explicit RPATH rule contract. */
+int
+macho_rpath_allowed(const char *path, int transformed)
+{
+	struct transform_rule *rule;
+	const char *name;
+	size_t len, n;
+
+	if (!macho_rpath(path))
+		return 0;
+	len = strlen(path);
+	while (len > 1 && isabs(path[len - 1]))
+		--len;
+	TAILQ_FOREACH(rule, &rpath_rules, link) {
+		name = transformed ? rule->dst : rule->src;
+		if (name == NULL)
+			continue;
+		n = strlen(name);
+		if (n == 0)
+			continue;
+		if (transformed) {
+			/* The destination is a literal prefix, not a source pattern. */
+			if (strncmp(path, name, n) == 0 &&
+			    (path[n] == '\0' || isabs(path[n])))
+				return 1;
+			continue;
+		}
+		if (isabs(name[n - 1])) {
+			if (n - 1 != len || memcmp(path, name, len) != 0)
+				continue;
+		} else {
+			if (n > len || (path[n] != '\0' && !isabs(path[n])) ||
+			    strncmp(path, name, n) != 0)
+				continue;
+		}
+		return transformed || rule->dst != NULL;
+	}
+	return 0;
+}
