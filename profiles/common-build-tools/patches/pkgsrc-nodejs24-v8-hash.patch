+$NetBSD$
+
+Backport V8 65ce14d8731e929584344a0d65d6efd2296fa797 by Clemens Backes.
+Remove the broad std::hash partial specialization that changes hashes across
+translation units; explicitly select V8 hashes for its custom consumers.
+https://github.com/v8/v8/commit/65ce14d8731e929584344a0d65d6efd2296fa797
+
+The profiler hunk is inapplicable to this V8 13.6 branch: its line_ticks_ map
+has integer keys, not the newer pair-keyed line_and_column_ticks_ map.
+Backport adaptation: EmberBSD (AI-assisted), not submitted upstream.
+
+--- deps/v8/src/base/hashing.h.orig
++++ deps/v8/src/base/hashing.h
+@@ -360,12 +360,4 @@
+ 
+ }  // namespace v8::base
+ 
+-// Also define std::hash for all classes that can be hashed via v8::base::hash.
+-namespace std {
+-template <typename T>
+-  requires requires { typename v8::base::hash<T>; }
+-struct hash<T> : v8::base::hash<T> {};
+-
+-}  // namespace std
+-
+ #endif  // V8_BASE_HASHING_H_
+--- deps/v8/src/wasm/canonical-types.h.orig
++++ deps/v8/src/wasm/canonical-types.h
+@@ -557,9 +557,12 @@
+ 
+   std::vector<CanonicalTypeIndex> canonical_supertypes_;
+   // Set of all known canonical recgroups of size >=2.
+-  std::unordered_set<CanonicalGroup> canonical_groups_;
++  std::unordered_set<CanonicalGroup, base::hash<CanonicalGroup>>
++      canonical_groups_;
+   // Set of all known canonical recgroups of size 1.
+-  std::unordered_set<CanonicalSingletonGroup> canonical_singleton_groups_;
++  std::unordered_set<CanonicalSingletonGroup,
++                     base::hash<CanonicalSingletonGroup>>
++      canonical_singleton_groups_;
+   // Maps canonical indices back to the types.
+   CanonicalTypeVector canonical_types_;
+   AccountingAllocator allocator_;
