Origin: EmberBSD, AI-assisted.

rspec-expectations 3.13.5 and rspec-mocks 3.13.8, the newest releases,
require diff-lcs < 2.0 in their gemspecs, so with diff-lcs 2.0.0, the
only diff-lcs in Ports, RubyGems refuses to load them.  RSpec 3.13 works
with diff-lcs 2, and only the 4.0 prereleases accept it, so relax the
gemspec bound.
Not submitted upstream.

--- a/devel/ruby-rspec-expectations/Makefile
+++ b/devel/ruby-rspec-expectations/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.43 2026/01/17 16:44:52 taca Exp $
 
 DISTNAME=	rspec-expectations-3.13.5
+PKGREVISION=	1
 CATEGORIES=	devel
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
@@ -11,5 +12,7 @@
 DEPENDS+=	${RUBY_PKGPREFIX}-rspec-support>=3.13.0<3.14:../../devel/ruby-rspec-support
 DEPENDS+=	${RUBY_PKGPREFIX}-diff-lcs>=1.2.0:../../textproc/ruby-diff-lcs
 
+OVERRIDE_GEMSPEC+=	diff-lcs>=1.2.0
+
 .include "../../lang/ruby/gem.mk"
 .include "../../mk/bsd.pkg.mk"
--- a/devel/ruby-rspec-mocks/Makefile
+++ b/devel/ruby-rspec-mocks/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.47 2026/03/01 07:42:31 taca Exp $
 
 DISTNAME=	rspec-mocks-3.13.8
+PKGREVISION=	1
 CATEGORIES=	devel
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
@@ -11,5 +12,7 @@
 DEPENDS+=	${RUBY_PKGPREFIX}-rspec-support>=3.13.0<3.14:../../devel/ruby-rspec-support
 DEPENDS+=	${RUBY_PKGPREFIX}-diff-lcs>=1.2.0:../../textproc/ruby-diff-lcs
 
+OVERRIDE_GEMSPEC+=	diff-lcs>=1.2.0
+
 .include "../../lang/ruby/gem.mk"
 .include "../../mk/bsd.pkg.mk"
