Stop a cross package that would use a cross libtool configured for other
cross tools or another sysroot.

cross-libtool-base and cross-libtool-fortran record the absolute LD, NM
and RANLIB and the library search path of the TOOLDIR and CROSS_DESTDIR
they were configured with. They install into TOOLBASE, and every
configuration that shares one TOOLBASE takes the installed package as the
tool dependency of its cross packages, whatever TOOLDIR and CROSS_DESTDIR
it was configured for. A bulk build then ran ranlib through the tools
directory of another configuration and searched its sysroot copy, and
would break once that directory was removed.

In the wrapper phase of a cross package that uses libtool, check that tool
paths are under TOOLDIR or CROSS_DESTDIR. A prepared Clang may additionally
record its exact bound resource directory in the library search path; query
that directory through the verified TOOLDIR compiler and allow only exact
search-path equality. The canonical selected target runtime root is also
allowed only as a prefix of library search paths. Tool paths never receive
either exception. Native builds are unchanged.

Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/mk/cwrappers.mk
+++ b/mk/cwrappers.mk
@@ -152,6 +152,72 @@
 
 do-wrapper: generate-cwrappers
 
+# A cross libtool records the absolute linker, nm, ranlib and library
+# search path of the TOOLDIR and CROSS_DESTDIR it was configured with.
+# Several configurations can share one TOOLBASE, and an installed
+# cross-libtool configured for another TOOLDIR or CROSS_DESTDIR satisfies
+# the dependency all the same. Stop before the package uses it.
+.if !empty(USE_CROSS_COMPILE:M[yY][eE][sS]) && defined(USE_LIBTOOL) && \
+    !empty(TOOLDIR) && !empty(CROSS_DESTDIR)
+do-wrapper: check-cross-libtool
+.endif
+
+.PHONY: check-cross-libtool
+check-cross-libtool:
+	${RUN} lt=${PKG_LIBTOOL:Q}; bad=; resource_dir=; runtime=${_EMBER_TARGET_RUNTIME_ROOT:U}; runtime_real=; \
+	if [ ! -f "$$lt" ]; then \
+		${ERROR_MSG} "$$lt is missing."; exit 1; \
+	fi; \
+	tool_paths=`${SED} -n -E -e 's/^(LD|NM|RANLIB)="(.*)"$$/\2/p' "$$lt"`; \
+	search_paths=`${SED} -n -E -e 's/^sys_lib_search_path_spec="(.*)"$$/\1/p' "$$lt"`; \
+	for p in $$tool_paths; do \
+		case "$$p" in \
+		${TOOLDIR}/*|${CROSS_DESTDIR}/*|[!/]*) ;; \
+		*) bad="$$bad $$p" ;; \
+		esac; \
+	done; \
+	if [ "${_EMBER_TARGET_FAMILY:U}" = clang ] && \
+	    [ "${_EMBER_TARGET_TOOLS:U}" = "${TOOLDIR}" ] && \
+	    [ "${_EMBER_TARGET_SYSROOT:U}" = "${CROSS_DESTDIR}" ] && \
+	    [ "${CLANGBASE:U}" = "${TOOLDIR}" ]; then \
+		resource_dir=`${CLANGBASE:Q}/bin/clang -print-resource-dir` || { \
+			${ERROR_MSG} "Could not query the selected Clang resource directory."; exit 1; \
+		}; \
+		case "$$resource_dir" in /*) ;; *) \
+			${ERROR_MSG} "Selected Clang returned an invalid resource directory."; exit 1 ;; \
+		esac; \
+		case "$$resource_dir" in *[[:space:]]*) \
+			${ERROR_MSG} "Selected Clang returned an unsupported resource path."; exit 1 ;; \
+		esac; \
+	fi; \
+	if [ -n "$$runtime" ]; then \
+		if [ ! -d "$$runtime" ]; then \
+			${ERROR_MSG} "Selected target runtime root is missing: $$runtime"; exit 1; \
+		fi; \
+		runtime_real=`CDPATH= cd "$$runtime" && pwd -P` || exit 1; \
+		if [ "$$runtime_real" != "$$runtime" ] && \
+		    { [ "${_EMBER_TARGET_RUNTIME_KIND:U}" != sysroot ] || \
+		      [ "$$runtime" != "${CROSS_DESTDIR}" ]; }; then \
+			${ERROR_MSG} "Selected target runtime root is not canonical: $$runtime"; exit 1; \
+		fi; \
+	fi; \
+	for p in $$search_paths; do \
+		case "$$p" in \
+		"$$resource_dir"|${TOOLDIR}/*|${CROSS_DESTDIR}/*|[!/]*) ;; \
+		*) \
+			if [ -n "$$runtime_real" ]; then \
+				case "$$p" in "$$runtime_real"/*) ;; *) bad="$$bad $$p" ;; esac; \
+			else \
+				bad="$$bad $$p"; \
+			fi ;; \
+		esac; \
+	done; \
+	if [ -n "$$bad" ]; then \
+		${ERROR_MSG} "$$lt was configured for other cross tools or another sysroot:$$bad"; \
+		${ERROR_MSG} "Reinstall its cross-libtool package for the selected TOOLDIR, CROSS_DESTDIR and target runtime root."; \
+		exit 1; \
+	fi
+
 .if !target(do-wrapper)
 do-wrapper:
 	@${DO_NADA}
