+#if defined(RANLIBMAG) && !defined(SVR4ARCHIVES)
+/*
+ * Return the header of the GNU symbol table "/" of an archive, or NULL.
+ * llvm-ar writes it as the first member of an ELF archive, which has no
+ * RANLIBMAG member. Only that exact first member is the index.
+ */
+static struct ar_hdr *
+ArchGNUSymbolTable(const char *archive)
+{
+	static struct ar_hdr arh;
+	char magic[SARMAG];
+	FILE *f;
+	bool found;
+
+	if (archive == NULL || (f = fopen(archive, "r")) == NULL)
+		return NULL;
+	found = fread(magic, SARMAG, 1, f) == 1 &&
+	    strncmp(magic, ARMAG, SARMAG) == 0 &&
+	    fread(&arh, sizeof arh, 1, f) == 1 &&
+	    strncmp(arh.ar_fmag, ARFMAG, sizeof arh.ar_fmag) == 0 &&
+	    strncmp(arh.ar_name, "/ ", 2) == 0;
+	(void)fclose(f);
+	return found ? &arh : NULL;
+}
+#endif
