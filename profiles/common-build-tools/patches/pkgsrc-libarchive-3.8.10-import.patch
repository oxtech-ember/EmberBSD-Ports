+	0x01, 0x00,          /* central directory entries on this disk */
+	0x01, 0x00,          /* total central directory entries */
+	0x47, 0x00, 0x00, 0x00, /* size of central directory = 71 */
+	0x3a, 0x00, 0x00, 0x00, /* offset of central directory = 58 */
