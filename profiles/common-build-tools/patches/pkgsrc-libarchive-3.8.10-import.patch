diff --git a/archivers/libarchive/files/libarchive/test/test_write_disk_secure_physicaldrive.c b/archivers/libarchive/files/libarchive/test/test_write_disk_secure_physicaldrive.c
new file mode 100644
index 0000000000000..6b4555ee2ec04
--- /dev/null
+++ b/archivers/libarchive/files/libarchive/test/test_write_disk_secure_physicaldrive.c
@@ -0,0 +1,94 @@
+/*-
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Copyright (c) 2026 EndlssNightmare
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
