+	0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x46, 0x00, 0x00, 0x00, 0x39,
+	0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+DEFINE_TEST(test_read_format_zip_negative_timestamp_pkware_unix)
+{
+	struct archive *a;
+	struct archive_entry *ae;
+
+	assert((a = archive_read_new()) != NULL);
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_support_format_zip_seekable(a));
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_open_memory(a, archive_pkware_unix,
+		sizeof(archive_pkware_unix)));
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_next_header(a, &ae));
+
+	assertEqualString("test.txt", archive_entry_pathname(ae));
+	assertEqualInt(-86400, archive_entry_mtime(ae));
+	assertEqualInt(-172800, archive_entry_atime(ae));
+	assertEqualInt(1001, archive_entry_uid(ae));
+	assertEqualInt(1002, archive_entry_gid(ae));
+
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_close(a));
+	assertEqualInt(ARCHIVE_OK, archive_read_free(a));
+}
+
+/* 0x5455 "UT" extended timestamp: Flags, ModTime, AcTime, CrTime. */
+static const unsigned char archive_ut[] = {
+	0x50, 0x4b, 0x03, 0x04, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x21, 0x00, 0x7a, 0x7a, 0x6f, 0xed, 0x03, 0x00, 0x00, 0x00, 0x03, 0x00,
+	0x00, 0x00, 0x08, 0x00, 0x11, 0x00, 0x74, 0x65, 0x73, 0x74, 0x2e, 0x74,
+	0x78, 0x74, 0x55, 0x54, 0x0d, 0x00, 0x07, 0x80, 0xae, 0xfe, 0xff, 0x00,
+	0x5d, 0xfd, 0xff, 0x80, 0x0b, 0xfc, 0xff, 0x68, 0x69, 0x0a, 0x50, 0x4b,
+	0x01, 0x02, 0x14, 0x00, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x21, 0x00, 0x7a, 0x7a, 0x6f, 0xed, 0x03, 0x00, 0x00, 0x00, 0x03, 0x00,
+	0x00, 0x00, 0x08, 0x00, 0x11, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0xa4, 0x81, 0x00, 0x00, 0x00, 0x00, 0x74, 0x65, 0x73, 0x74,
+	0x2e, 0x74, 0x78, 0x74, 0x55, 0x54, 0x0d, 0x00, 0x07, 0x80, 0xae, 0xfe,
+	0xff, 0x00, 0x5d, 0xfd, 0xff, 0x80, 0x0b, 0xfc, 0xff, 0x50, 0x4b, 0x05,
+	0x06, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x47, 0x00, 0x00,
+	0x00, 0x3a, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+DEFINE_TEST(test_read_format_zip_negative_timestamp_ut)
+{
+	struct archive *a;
+	struct archive_entry *ae;
+
+	assert((a = archive_read_new()) != NULL);
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_support_format_zip_seekable(a));
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_open_memory(a, archive_ut, sizeof(archive_ut)));
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_next_header(a, &ae));
+
+	assertEqualString("test.txt", archive_entry_pathname(ae));
+	assertEqualInt(-86400, archive_entry_mtime(ae));
+	assertEqualInt(-172800, archive_entry_atime(ae));
+	assertEqualInt(-259200, archive_entry_ctime(ae));
+
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_close(a));
+	assertEqualInt(ARCHIVE_OK, archive_read_free(a));
+}
+
+/* 0x5855 "UX" (old): AcTime, ModTime, UID, GID. */
+static const unsigned char archive_ux[] = {
+	0x50, 0x4b, 0x03, 0x04, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x21, 0x00, 0x7a, 0x7a, 0x6f, 0xed, 0x03, 0x00, 0x00, 0x00, 0x03, 0x00,
