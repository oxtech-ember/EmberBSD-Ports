index 0000000000000..408159308cf21
--- /dev/null
+++ b/archivers/libarchive/files/libarchive/test/test_read_format_7zip_deflate_arm64_large.7z.uu
@@ -0,0 +1,1580 @@
+This archive holds a synthetic 127536-byte payload, generated by the script
+below: 62000 bytes of incompressible noise followed by 64 KiB of branch-heavy
+filler. The noise makes the deflate stream (68837 bytes) larger than the
+reader's 64 KiB input window, so the decompressor hands back a chunk whose
+size is not a multiple of the ARM64 filter's 4-byte block; the branch
+instructions after it make any mishandled carry-over show up as a CRC error.
+
+    python3 gen.py bcj-arm64.bin        # prints: 127536 0xfef87379
+
+    import struct, sys, zlib
+    noise_words = 15500        # 62000 bytes of incompressible data
+    words = 16384              # 64 KiB of branch-heavy filler
+    state = 0x2545f491
+    out = bytearray()
+    for i in range(noise_words):
+        state = (state * 1103515245 + 12345) & 0xffffffff
+        out += struct.pack('<I', state)
+    base = len(out)
+    for i in range(words):
+        pc = base + i * 4
+        if i % 16 == 0:
+            w = 0x94000000 | (((0x40000 - pc) >> 2) & 0x03ffffff)     # arm64 bl
+        elif i % 16 == 4:
+            w = 0xEB000000 | (((0x40000 - pc - 8) >> 2) & 0x00ffffff) # arm bl
+        elif i % 16 == 8:
+            w = 0x48000001 | ((0x40000 - pc) & 0x03fffffc)            # ppc bl
+        elif i % 16 == 12:
+            w = 0x40000000 | (((0x40000 - pc) >> 2) & 0x3fffffff)     # sparc call
+        else:
+            w = 0xd503201f                                            # nop
+        out += struct.pack('<I', w)
+    data = bytes(out)
+    open(sys.argv[1],'wb').write(data)
+    print(len(data), '0x%08x' % (zlib.crc32(data) & 0xffffffff))
+
+The same payload serves the ARM, POWERPC and SPARC filters, which is why it
+carries their call instructions too. The archive was then created with
+7zip 26.02:
+
+rm -f libarchive/test/test_read_format_7zip_deflate_arm64_large.7z
+7z a -m0=ARM64 -m1=Deflate -mhc=off -mtm=off libarchive/test/test_read_format_7zip_deflate_arm64_large.7z bcj-arm64.bin -y
+
