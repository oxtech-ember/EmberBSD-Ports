+	0x78, 0x74, 0x55, 0x58, 0x0c, 0x00, 0x00, 0x5d, 0xfd, 0xff, 0x80, 0xae,
+	0xfe, 0xff, 0xe9, 0x03, 0xea, 0x03, 0x68, 0x69, 0x0a, 0x50, 0x4b, 0x01,
+	0x02, 0x14, 0x00, 0x14, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x21,
+	0x00, 0x7a, 0x7a, 0x6f, 0xed, 0x03, 0x00, 0x00, 0x00, 0x03, 0x00, 0x00,
+	0x00, 0x08, 0x00, 0x10, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0xa4, 0x81, 0x00, 0x00, 0x00, 0x00, 0x74, 0x65, 0x73, 0x74, 0x2e,
+	0x74, 0x78, 0x74, 0x55, 0x58, 0x0c, 0x00, 0x00, 0x5d, 0xfd, 0xff, 0x80,
+	0xae, 0xfe, 0xff, 0xe9, 0x03, 0xea, 0x03, 0x50, 0x4b, 0x05, 0x06, 0x00,
+	0x00, 0x00, 0x00, 0x01, 0x00, 0x01, 0x00, 0x46, 0x00, 0x00, 0x00, 0x39,
+	0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+DEFINE_TEST(test_read_format_zip_negative_timestamp_ux)
+{
+	struct archive *a;
+	struct archive_entry *ae;
+
+	assert((a = archive_read_new()) != NULL);
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_support_format_zip_seekable(a));
+	assertEqualIntA(a, ARCHIVE_OK,
+	    archive_read_open_memory(a, archive_ux, sizeof(archive_ux)));
+	assertEqualIntA(a, ARCHIVE_OK, archive_read_next_header(a, &ae));
+
+	assertEqualString("test.txt", archive_entry_pathname(ae));
+	assertEqualInt(-86400, archive_entry_mtime(ae));
+	assertEqualInt(-172800, archive_entry_atime(ae));
+	assertEqualInt(1001, archive_entry_uid(ae));
+	assertEqualInt(1002, archive_entry_gid(ae));
