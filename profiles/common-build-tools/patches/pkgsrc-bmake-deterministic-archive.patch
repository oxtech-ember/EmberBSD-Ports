# Origin: EmberBSD (AI-assisted); OS make fix d996774d467.
# Deterministic archive indexes have zero timestamps; retain container freshness.

--- a/devel/bmake/Makefile
+++ b/devel/bmake/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.87 2025/04/21 16:30:06 wiz Exp $
 
 PKGNAME=	bmake-20260912
+PKGREVISION=	1
 CATEGORIES=	devel
 MASTER_SITES=	https://www.crufty.net/ftp/pub/sjg/
 
--- a/devel/bmake/files/arch.c
+++ b/devel/bmake/files/arch.c
@@ -938,6 +938,12 @@
 	if (DEBUG(ARCH) || DEBUG(MAKE))
 		debug_printf("%s modified %s...",
 		    RANLIBMAG, Targ_FmtTime(tocModTime));
+	/*
+	 * Deterministic archives record zero for the table of contents.  The
+	 * archive file itself is compared with its children in Arch_LibOODate.
+	 */
+	if (tocModTime == 0 && gn->youngestChild != NULL)
+		return false;
 	return gn->youngestChild == NULL ||
 	       gn->youngestChild->mtime > tocModTime;
 #else
