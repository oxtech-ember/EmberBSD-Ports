+++ gidocgen/links.py
@@ -0,0 +1,63 @@
+# SPDX-FileCopyrightText: 2026 EmberBSD
+# SPDX-License-Identifier: Apache-2.0 OR GPL-3.0-or-later
+
+"""Helpers for links to generated API pages."""
+
+
+def type_func_filename(namespace, owner, name):
+    """Return the allocated page filename for a type function."""
+    links = getattr(namespace, "_type_func_links", {})
+    return links.get((owner, name), f"type_func.{owner}.{name}.html")
+
+
+def allocate_type_func_filenames(namespace):
+    """Preallocate case-insensitive unique type-function page names."""
+    functions = {}
+    for getter in (namespace.get_classes, namespace.get_interfaces,
+                   namespace.get_effective_records, namespace.get_enumerations,
+                   namespace.get_bitfields, namespace.get_error_domains,
+                   namespace.get_unions):
+        for owner in getter():
+            for func in getattr(owner, "functions", ()):
+                functions[(owner.name, func.name)] = (
+                    f"type_func.{owner.name}.{func.name}.html")
+
+    groups = {}
+    for key, filename in functions.items():
+        groups.setdefault(filename.casefold(), []).append(key)
+
+    result = {}
+    reserved = {filename.casefold() for filename in functions.values()}
+    occupied = set()
+    for group in sorted(groups):
+        keys = groups[group]
+        keys.sort(key=lambda key: (functions[key].casefold(), key[0].casefold(),
+                                   key[0], key[1].casefold(), key[1]))
+        for index, key in enumerate(keys):
+            filename = functions[key]
+            if index:
+                import hashlib
+                digest = hashlib.sha256((key[0] + "." + key[1]).encode("utf-8")).hexdigest()
+                stem = filename[:-5]
+                width = 8
+                candidate = f"{stem}.case-{digest[:width]}.html"
+                while candidate.casefold() in occupied or candidate.casefold() in reserved:
+                    width += 2
+                    candidate = f"{stem}.case-{digest[:width]}.html"
+                filename = candidate
+            occupied.add(filename.casefold())
+            result[key] = filename
+    namespace._type_func_links = result
+
+
+def allocate_repository_type_func_filenames(repository):
+    """Allocate links for a repository and all of its included namespaces."""
+    pending = [repository]
+    seen = set()
+    while pending:
+        current = pending.pop()
+        if id(current) in seen:
+            continue
+        seen.add(id(current))
+        allocate_type_func_filenames(current.namespace)
+        pending.extend(current.includes.values())
