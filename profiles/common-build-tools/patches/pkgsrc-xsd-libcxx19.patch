--- /dev/null
+++ b/devel/xsd/patches/patch-libxsd-frontend_xsd-frontend_types.hxx
@@ -0,0 +1,78 @@
+$NetBSD$
+
+libc++ 19 removed the generic std::char_traits, so StringTemplate<C> with
+the placeholder narrower type Bits::None no longer compiles.  Default the
+narrower type to char and enable the narrow conversions only for wchar_t.
+Based on FreeBSD ports commit c1c4aae6 (devel/libxsd-frontend), in C++11.
+
+--- libxsd-frontend/xsd-frontend/types.hxx.orig
++++ libxsd-frontend/xsd-frontend/types.hxx
+@@ -7,43 +7,22 @@
+ 
+ #include <string>
+ #include <cstddef> // std::size_t
++#include <type_traits>
+ 
+ namespace XSDFrontend
+ {
+   using std::size_t;
+ 
+-  namespace Bits
+-  {
+-    struct None {};
+-
+-    template <typename C>
+-    struct NarrowerChar
+-    {
+-      typedef None Type;
+-    };
+-
+-    template <>
+-    struct NarrowerChar<wchar_t>
+-    {
+-      typedef char Type;
+-    };
+-  }
+-
+   struct NonRepresentable: std::exception
+   {
+     virtual char const*
+     what () const throw ();
+   };
+ 
+-  template <typename C, typename NC = typename Bits::NarrowerChar<C>::Type>
+-  class StringTemplate;
+-
+-  template <>
+-  class StringTemplate<Bits::None, Bits::None>
+-  {
+-  };
+-
+-  template <typename C, typename NC>
++  // The conversions from the narrower type exist only for wchar_t strings.
++  // libc++ 19 has no std::char_traits for other types, so a placeholder
++  // narrower character type cannot disable them.
++  template <typename C, typename NC = char>
+   class StringTemplate : public std::basic_string<C>
+   {
+     typedef std::basic_string<C> Base;
+@@ -113,16 +92,19 @@
+ 
+     // Conversion from the Narrower type. Experimental.
+     //
++    template <typename WC = C, typename = typename std::enable_if<std::is_same<WC, wchar_t>::value>::type>
+     StringTemplate (NC const* s)
+     {
+       from_narrow (s);
+     }
+ 
++    template <typename WC = C, typename = typename std::enable_if<std::is_same<WC, wchar_t>::value>::type>
+     StringTemplate (StringTemplate<NC> const& other)
+     {
+       from_narrow (other.c_str ());
+     }
+ 
++    template <typename WC = C, typename = typename std::enable_if<std::is_same<WC, wchar_t>::value>::type>
+     StringTemplate (NarrowerBase const& other)
+     {
+       from_narrow (other.c_str ());
