qt5-qtsvg links zlib directly and needs its runtime dependency.

QtSvg uses the system zlib (QMAKE_USE_PRIVATE += zlib), so libQt5Svg loads
libz, but zlib came in only through the qt5-qtbase buildlink file. The
native package recorded no direct dependency and the strict Mach-O check
rejected it: zlib is not a runtime dependency. Include the zlib buildlink
file.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/x11/qt5-qtsvg/Makefile
+++ b/x11/qt5-qtsvg/Makefile
@@ -19,5 +19,7 @@
 	${LN} -f -s ${QTPREFIX}/lib/pkgconfig/${i} ${i}
 .endfor
 
+# QtSvg links the system zlib (QMAKE_USE_PRIVATE += zlib).
+.include "../../devel/zlib/buildlink3.mk"
 .include "../../x11/qt5-qtbase/buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
