Origin: EmberBSD, AI-assisted.
Update PGroonga to 4.1.0 for PostgreSQL 18, the one PostgreSQL in
EmberBSD; 2.3.6 was limited to PostgreSQL 14. PGroonga 4.x builds with
Meson only. Enable MessagePack and xxHash, as in the previous configure
build (the bundled xxhash.h is gone, so xxHash is required).
Not submitted upstream.

--- a/databases/postgresql-pgroonga/Makefile
+++ b/databases/postgresql-pgroonga/Makefile
@@ -1,8 +1,7 @@
 # $NetBSD: Makefile,v 1.14 2026/09/02 19:01:18 wiz Exp $
 
-DISTNAME=	pgroonga-2.3.6
+DISTNAME=	pgroonga-4.1.0
 PKGNAME=	postgresql${PGSQL_VERSION}-${DISTNAME}
-PKGREVISION=	2
 CATEGORIES=	databases
 MASTER_SITES=	https://packages.groonga.org/source/pgroonga/
 
@@ -13,15 +12,20 @@
 
 DEPENDS+=	postgresql${PGSQL_VERSION}-server>=0:../../databases/postgresql${PGSQL_VERSION}-server
 
-PGSQL_VERSIONS_ACCEPTED=	14
+USE_LANGUAGES=	c
+USE_TOOLS+=	pkg-config
 
-USE_GCC_RUNTIME=	yes
-USE_LANGUAGES=		c c++ c99
-USE_LIBTOOL=		yes
-USE_TOOLS+=		gmake pkg-config
+MESON_ARGS+=	-Dpg_config=${PGSQL_PREFIX}/bin/pg_config
+MESON_ARGS+=	-Dmessage_pack=enabled
+MESON_ARGS+=	-Dxxhash=enabled
+MESON_ARGS+=	-Dtest=false
 
-CONFIGURE_ARGS+=	--datadir=${PREFIX}/share/postgresql/contrib
+# pgroonga_tuple_is_alive in post_filter needs Groonga 16.1.3.
+BUILDLINK_API_DEPENDS.groonga+=	groonga>=16.1.3
 
+.include "../../devel/meson/build.mk"
+.include "../../devel/msgpack/buildlink3.mk"
+.include "../../devel/xxhash/buildlink3.mk"
 .include "../../textproc/groonga/buildlink3.mk"
 .include "../../mk/pgsql.buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
