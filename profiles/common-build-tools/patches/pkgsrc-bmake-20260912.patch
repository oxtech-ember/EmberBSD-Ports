+# This makefile is used by top-level makefile
+# or indeed used to replace it:
+#
+#	.if ${.MAKE.LEVEL} == 0 && ${.CURDIR} == ${SRCTOP}
+#	.MAKE.MAKEFILE_PREFERENCE = top.mk
