+.include <jobs.mk>
+.else
+.if ${.MAKE.MAKEFILE_PREFERENCE:U:M*top.mk} != ""
+# Remove ourselves now
+.MAKE.MAKEFILE_PREFERENCE := ${.MAKE.MAKEFILE_PREFERENCE:N*top.mk}
+.endif
+.if ${MK_DIRDEPS_BUILD:Uno} == "yes"
+.include <dirdeps-targets.mk>
+.endif
+.-include <local.top.mk>
+.endif
+.endif
