+static bool
+find_make(const char *cmd, const char *make, size_t len)
+{
+	const char *p;
+
+	for (p = strstr(cmd, make); p != NULL; p = strstr(&p[1], make)) {
+		if (p == cmd || ch_isspace(p[-1])) {
+			if (p[len] == '\0' || ch_isspace(p[len])) {
+				DEBUG4(JOB, "find_make: matched \"%.*s\" in \"%.*s...\"\n",
+				    (int)len, p,
+				    (int)len + 32, cmd);
+
+				return true;
+			}
+		}
+	}
+	return false;
+}
