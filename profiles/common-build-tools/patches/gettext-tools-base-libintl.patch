$NetBSD$

Allow an explicitly selected base libintl after a real public API link.
Origin: EmberBSD (AI-assisted).

--- gettext-tools/configure.ac.orig
+++ gettext-tools/configure.ac
@@ -205,6 +205,36 @@
 dnl These are the only lines required to internationalize the package.
 dnl (OK, not quite, the AC_CONFIG_FILES has also some parts.)
 AM_GNU_GETTEXT([use-libtool], [need-ngettext], [\${top_builddir}/../gettext-runtime/intl])
+
+# Explicit native base mode: require the public Citrus gettext ABI.
+AS_CASE([${EMBER_GETTEXT_BASE_LIBINTL-no}], [yes|no], [],
+  [AC_MSG_ERROR([invalid EMBER_GETTEXT_BASE_LIBINTL value])])
+if test "${EMBER_GETTEXT_BASE_LIBINTL-no}" = yes; then
+  if test "$enable_nls" = no; then
+    AC_MSG_ERROR([base libintl requires NLS enabled])
+  fi
+  saved_LIBS=$LIBS
+  LIBS="-lintl $LIBS"
+  AC_MSG_CHECKING([for the base libintl public API])
+  AC_LINK_IFELSE([AC_LANG_PROGRAM([[#include <libintl.h>
+#include <locale.h>]], [[
+    bindtextdomain("gettext-tools", "/usr/share/locale");
+    bind_textdomain_codeset("gettext-tools", "UTF-8");
+    textdomain("gettext-tools");
+    return !gettext("x") || !dgettext("gettext-tools", "x") ||
+      !dcgettext("gettext-tools", "x", LC_MESSAGES) || !ngettext("x", "xs", 2) ||
+      !dngettext("gettext-tools", "x", "xs", 2) ||
+      !dcngettext("gettext-tools", "x", "xs", 2, LC_MESSAGES);
+  ]])], [AC_MSG_RESULT([yes])],
+    [AC_MSG_FAILURE([base libintl public API link failed])])
+  LIBS=$saved_LIBS
+  USE_NLS=yes
+  LIBINTL=-lintl
+  LTLIBINTL=-lintl
+  INTLLIBS=-lintl
+  AC_DEFINE([ENABLE_NLS], [1], [Define to 1 to enable translation.])
+fi
+
 dnl When not cross-compiling, use the 'msgmerge' program from this package,
 dnl for output consistency with the 'msgfilter' program used to create
 dnl en@quot.po and en@boldquot.po.
--- gettext-tools/configure.orig
+++ gettext-tools/configure
@@ -30069,6 +30069,54 @@
 
 
 
+
+case ${EMBER_GETTEXT_BASE_LIBINTL-no} in
+  yes|no) ;;
+  *) as_fn_error $? "invalid EMBER_GETTEXT_BASE_LIBINTL value" "$LINENO" 5 ;;
+esac
+if test "${EMBER_GETTEXT_BASE_LIBINTL-no}" = yes; then
+  if test "$enable_nls" = no; then
+    as_fn_error $? "base libintl requires NLS enabled" "$LINENO" 5
+  fi
+  saved_LIBS=$LIBS
+  LIBS="-lintl $LIBS"
+  { printf '%s\n' "$as_me:${as_lineno-$LINENO}: checking for the base libintl public API" >&5
+printf %s "checking for the base libintl public API... " >&6; }
+  cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+/* end confdefs.h.  */
+#include <libintl.h>
+#include <locale.h>
+int
+main (void)
+{
+    bindtextdomain("gettext-tools", "/usr/share/locale");
+    bind_textdomain_codeset("gettext-tools", "UTF-8");
+    textdomain("gettext-tools");
+    return !gettext("x") || !dgettext("gettext-tools", "x") ||
+      !dcgettext("gettext-tools", "x", LC_MESSAGES) || !ngettext("x", "xs", 2) ||
+      !dngettext("gettext-tools", "x", "xs", 2) ||
+      !dcngettext("gettext-tools", "x", "xs", 2, LC_MESSAGES);
+  ;
+  return 0;
+}
+_ACEOF
+if ac_fn_c_try_link "$LINENO"
+then :
+  { printf '%s\n' "$as_me:${as_lineno-$LINENO}: result: yes" >&5
+printf '%s\n' "yes" >&6; }
+else
+  as_fn_error $? "base libintl public API link failed" "$LINENO" 5
+fi
+rm -f core conftest.err conftest.$ac_objext conftest.beam \
+    conftest$ac_exeext conftest.$ac_ext
+  LIBS=$saved_LIBS
+  USE_NLS=yes
+  LIBINTL=-lintl
+  LTLIBINTL=-lintl
+  INTLLIBS=-lintl
+printf '%s\n' "#define ENABLE_NLS 1" >>confdefs.h
+fi
+
 if test "$cross_compiling" != yes; then
   MSGMERGE='msgmerge'
   MSGMERGE_FOR_MSGFMT_OPTION='--for-msgfmt'
