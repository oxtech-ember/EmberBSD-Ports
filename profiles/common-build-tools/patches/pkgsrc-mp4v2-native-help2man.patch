Origin: EmberBSD, AI-assisted.
A cross build of multimedia/mp4v2 stopped making its manual pages:
doc/GNUmakefile.mk runs help2man on ./mp4art and the other utilities it
has just linked, and in a cross build those are target executables.
Configure also found help2man only when it happened to be in PATH and
otherwise wrote empty pages. Depend on help2man, and in a cross build on
the native package, whose utilities HELP2MAN.bindir selects in TOOLBASE.
Not submitted upstream.

--- a/multimedia/mp4v2/Makefile
+++ b/multimedia/mp4v2/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.11 2026/01/02 12:17:14 triaxx Exp $
 
 DISTNAME=	mp4v2-5.0.1
-PKGREVISION=	1
+PKGREVISION=	2
 CATEGORIES=	multimedia
 MASTER_SITES=	${MASTER_SITE_GITHUB:=TechSmith/}
 GITHUB_TAG=	Release-ThirdParty-MP4v2-${PKGVERSION_NOREV}
@@ -21,4 +21,16 @@
 GNU_CONFIGURE=		yes
 MAKE_FILE=		GNUmakefile
 
+# Origin: EmberBSD (AI-assisted). The manual pages are help2man output of
+# the utilities. Declare help2man; configure otherwise writes empty pages
+# when it is not in PATH. A cross build runs the native mp4v2 utilities.
+TOOL_DEPENDS+=		help2man-[0-9]*:../../converters/help2man
+
+.include "../../mk/bsd.prefs.mk"
+
+.if ${USE_CROSS_COMPILE:tl} == "yes"
+TOOL_DEPENDS+=		${PKGNAME}:../../multimedia/mp4v2
+MAKE_FLAGS+=		HELP2MAN.bindir=${TOOLBASE}/bin
+.endif
+
 .include "../../mk/bsd.pkg.mk"
