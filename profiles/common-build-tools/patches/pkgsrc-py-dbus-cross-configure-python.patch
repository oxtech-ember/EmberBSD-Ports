py-dbus runs configure with the build machine Python in cross builds.

The recipe passes PYTHON=${PYTHONBIN}, the target path, to configure. A
cross build cannot run it ("/usr/pkg/bin/python3.15: inaccessible or not
found"), and it overrides the PYTHON=${TOOL_PYTHONBIN} that
lang/python/pyversion.mk exports with the cross environment that makes
AX_PYTHON_DEVEL report the target Python settings. Native builds are
unchanged: TOOL_PYTHONBIN and PYTHONBIN are the same file there.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/sysutils/py-dbus/Makefile
+++ b/sysutils/py-dbus/Makefile
@@ -13,7 +13,9 @@
 
 USE_TOOLS+=		pkg-config gmake
 GNU_CONFIGURE=		yes
-CONFIGURE_ARGS+=	PYTHON=${PYTHONBIN}
+# configure runs this interpreter; in cross builds it is the build
+# machine Python, which reports the target settings (pyversion.mk).
+CONFIGURE_ARGS+=	PYTHON=${TOOL_PYTHONBIN}
 
 PY_PATCHPLIST=			yes
 PYTHON_VERSIONS_INCOMPATIBLE=	27
