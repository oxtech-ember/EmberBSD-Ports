diff --git a/archivers/libarchive/files/libarchive/test/test_archive_write_close_callback.c b/archivers/libarchive/files/libarchive/test/test_archive_write_close_callback.c
new file mode 100644
index 0000000000000000000000000000000000000000..05550e161ec0fea4ae88459f69c8efb057c46af7
--- /dev/null
+++ b/archivers/libarchive/files/libarchive/test/test_archive_write_close_callback.c
@@ -0,0 +1,106 @@
+/*-
+ * Copyright (c) 2026 Max Freedom Pollard
+ * All rights reserved.
