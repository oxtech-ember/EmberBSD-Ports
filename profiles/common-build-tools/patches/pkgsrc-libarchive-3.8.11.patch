index 0000000000000000000000000000000000000000..d55911dbc3dc1f671b0e84f47f399642134d32b2
--- /dev/null
+++ b/archivers/libarchive/files/libarchive/test/test_read_format_cpio_newc_resync.c
@@ -0,0 +1,89 @@
+/*-
