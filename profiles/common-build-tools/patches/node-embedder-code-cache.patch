 using v8::Value;
 
 namespace builtins {
+
+static bool ExternalCodeCacheConsumed(
+    const ScriptCompiler::Source& source,
+    ScriptCompiler::CompileOptions options) {
+  if (options != ScriptCompiler::kConsumeCodeCache ||
+      source.GetCachedData() == nullptr || source.GetCachedData()->rejected) {
+    return false;
+  }
+  const auto result = source.GetCompilationDetails().in_memory_cache_result;
+  return result == ScriptCompiler::InMemoryCacheResult::kMiss ||
+         result == ScriptCompiler::InMemoryCacheResult::kPartial;
+}
+
+#if !defined(NDEBUG) || defined(DCHECK_ALWAYS_ON) || defined(NODE_BUILTIN_CACHE_STATUS)
+static Mutex& EmbedderCacheStatusMutex() {
+  static auto* mu = new Mutex();
+  return *mu;
+}
+static std::map<std::string, bool>& EmbedderCacheStatusMap() {
+  static auto* map = new std::map<std::string, bool>();
+  return *map;
+}
+std::map<std::string, bool> GetBuiltinCodeCacheStatus() {
+  Mutex::ScopedLock lock(EmbedderCacheStatusMutex());
+  return EmbedderCacheStatusMap();
+}
+#if defined(NODE_EMBEDDER_BUILTINS) || defined(NODE_BUILTIN_CACHE_STATUS)
+static void RecordEmbedderCacheStatus(const std::string& id, bool accepted) {
+  Mutex::ScopedLock lock(EmbedderCacheStatusMutex());
+  EmbedderCacheStatusMap()[id] = accepted;
+}
+#else
+static inline void RecordEmbedderCacheStatus(const std::string&, bool) {}
+#endif
+#else
+static inline void RecordEmbedderCacheStatus(const std::string&, bool) {}
+#endif
 
