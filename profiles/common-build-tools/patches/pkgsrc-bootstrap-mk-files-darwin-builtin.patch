Origin: EmberBSD, AI-assisted for the native Darwin bootstrap.
The Darwin profile runs [, echo, false, test and true through the shell
helper mk/tools/emberbsd-darwin-builtin.sh. Install that helper, so that
recipes after the make handoff can use ${LOCALBASE} paths. Their installed
files then never name the exported pkgsrc tree. Not submitted upstream.

--- a/pkgtools/bootstrap-mk-files/Makefile
+++ b/pkgtools/bootstrap-mk-files/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.62 2025/06/01 19:07:23 triaxx Exp $
 
 PKGNAME=	bootstrap-mk-files-20250601
-PKGREVISION=	1
+PKGREVISION=	2
 CATEGORIES=	pkgtools
 
 CONFLICTS+=	mk-files-[0-9]*
@@ -22,6 +22,15 @@
 
 INSTALLATION_DIRS=	share/mk
 
+# The native Darwin bootstrap runs shell builtins through this helper.
+# Recipes after the make handoff use the installed copy, so their
+# installed files never name the exported pkgsrc tree.
+.if ${EMBERBSD_DARWIN_BOOTSTRAP:Uno} == "yes"
+PLIST_VARS+=		builtin
+PLIST.builtin=		yes
+INSTALLATION_DIRS+=	libexec
+.endif
+
 do-extract:
 	${RUN} ${CP} -R ${FILESDIR} ${WRKSRC}
 
@@ -45,5 +54,9 @@
 	cd ${WRKSRC} && for file in bsd.* sys.mk; do			\
 		${INSTALL_DATA} $$file ${DESTDIR}${PREFIX}/share/mk/$$file;	\
 	done
+.if ${EMBERBSD_DARWIN_BOOTSTRAP:Uno} == "yes"
+	${INSTALL_SCRIPT} ${PKGSRCDIR}/mk/tools/emberbsd-darwin-builtin.sh \
+		${DESTDIR}${PREFIX}/libexec/emberbsd-darwin-builtin.sh
+.endif
 
 .include "../../mk/bsd.pkg.mk"
--- a/pkgtools/bootstrap-mk-files/PLIST
+++ b/pkgtools/bootstrap-mk-files/PLIST
@@ -1,4 +1,5 @@
 @comment $NetBSD: PLIST,v 1.3 2009/06/14 18:11:02 joerg Exp $
+${PLIST.builtin}libexec/emberbsd-darwin-builtin.sh
 share/mk/bsd.README
 share/mk/bsd.dep.mk
 share/mk/bsd.depall.mk
