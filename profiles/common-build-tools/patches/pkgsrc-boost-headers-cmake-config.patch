# Keep common Boost CMake metadata with the build-only headers package.

--- a/devel/boost-headers/Makefile
+++ b/devel/boost-headers/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.76 2026/05/15 09:13:49 adam Exp $
 
 BOOST_PACKAGE=		headers
-PKGREVISION=		1
+PKGREVISION=		2
 BOOST_COMMENT=		(build-time headers)
 BOOST_CONFIG=		generate
 
@@ -11,7 +11,7 @@
 
 INSTALLATION_DIRS+=	include/boost lib/cmake
 
-CONFLICTS+=	boost-libs<=1.90.0nb2
+CONFLICTS+=	boost-libs<1.92.0nb3
 
 .include "../../devel/boost-jam/bjam.mk"
 
@@ -28,11 +28,6 @@
 	${FIND} ${DESTDIR}${PREFIX}/include/boost \
 		-type d -exec ${CHMOD} ${PKGDIRMODE} {} +
 
-# These are required only for boost-libs
-post-install:
-	${RM} -f ${DESTDIR}${PREFIX}/lib/cmake/Boost-*/*.cmake
-	${RM} -f ${DESTDIR}${PREFIX}/lib/cmake/BoostDetectToolset-*.cmake
-
 PTHREAD_OPTS+=		require
 .include "../../mk/pthread.buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
--- a/devel/boost-headers/PLIST
+++ b/devel/boost-headers/PLIST
@@ -16411,5 +16411,8 @@
 include/boost/yap/print.hpp
 include/boost/yap/user_macros.hpp
 include/boost/yap/yap.hpp
+lib/cmake/Boost-${PKGVERSION}/BoostConfig.cmake
+lib/cmake/Boost-${PKGVERSION}/BoostConfigVersion.cmake
+lib/cmake/BoostDetectToolset-${PKGVERSION}.cmake
 lib/cmake/boost_headers-${PKGVERSION}/boost_headers-config-version.cmake
 lib/cmake/boost_headers-${PKGVERSION}/boost_headers-config.cmake
--- a/devel/boost-libs/Makefile
+++ b/devel/boost-libs/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.127 2026/05/15 09:13:49 adam Exp $
 
 BOOST_PACKAGE=		libs
-PKGREVISION=		2
+PKGREVISION=		3
 BOOST_COMMENT=		(binary libraries)
 BOOST_CONFIG=		installed
 BOOST_INSTALL_LIBS=	yes
@@ -77,6 +77,8 @@
 
 # These are already in boost-headers
 post-install:
+	${RM} -f ${DESTDIR}${PREFIX}/lib/cmake/Boost-*/*.cmake
+	${RM} -f ${DESTDIR}${PREFIX}/lib/cmake/BoostDetectToolset-*.cmake
 	${RM} -f ${DESTDIR}${PREFIX}/lib/cmake/boost_headers-*/*.cmake
 
 PRINT_PLIST_AWK+=	/boost_cobalt/ { $$0 = "$${PLIST.cobalt}"$$0 }
--- a/devel/boost-libs/PLIST
+++ b/devel/boost-libs/PLIST
@@ -1,7 +1,4 @@
 @comment $NetBSD: PLIST,v 1.54 2026/08/24 07:41:49 adam Exp $
-lib/cmake/Boost-${PKGVERSION}/BoostConfig.cmake
-lib/cmake/Boost-${PKGVERSION}/BoostConfigVersion.cmake
-lib/cmake/BoostDetectToolset-${PKGVERSION}.cmake
 lib/cmake/boost_atomic-${PKGVERSION}/boost_atomic-config-version.cmake
 lib/cmake/boost_atomic-${PKGVERSION}/boost_atomic-config.cmake
 lib/cmake/boost_atomic-${PKGVERSION}/libboost_atomic-variant-shared.cmake
