-share/doc/sane-backends/sane-backends-external.html
-share/doc/sane-backends/sane-backends.html
-share/doc/sane-backends/sane-mfgs-external.html
-share/doc/sane-backends/sane-mfgs.html
+${PLIST.html}share/doc/sane-backends/sane-backends-external.html
+${PLIST.html}share/doc/sane-backends/sane-backends.html
+${PLIST.html}share/doc/sane-backends/sane-mfgs-external.html
+${PLIST.html}share/doc/sane-backends/sane-mfgs.html
