diff --git a/gettext-tools/configure.ac b/gettext-tools/configure.ac
index 0b02b3c4..b235a6f7 100644
--- gettext-tools/configure.ac
+++ gettext-tools/configure.ac
@@ -756,13 +756,25 @@ AC_SUBST([ARCHIVE_FORMAT])
 dnl Get versions of files brought in by autopull.sh.
 ARCHIVE_VERSION=1.0
 AC_SUBST([ARCHIVE_VERSION])
-dnl We don't offer a --with-tree-sitter-prefix option, but instead always use
-dnl the tree-sitter version included in the tarball. This is required because
-dnl there is no stability guarantee for grammar elements: grammar elements can
-dnl be changed, extended, or even removed in future tree-sitter-<lang> versions,
-dnl whereas the x-<lang>.c code assumes that certain grammar elements have a
-dnl specific structure. We may need to change x-<lang>.c so that it works with
-dnl a newer version of tree-sitter-<lang>.
+dnl Keep the shipped language grammars: x-<lang>.c relies on their tree shapes.
+dnl The common runtime is independent of those grammar semantics.
+test -n "$PKG_CONFIG" && test -x "$PKG_CONFIG" ||
+  AC_MSG_ERROR([the selected pkg-config is required for tree-sitter])
+TREE_SITTER_CFLAGS=`"$PKG_CONFIG" --cflags tree-sitter` || AC_MSG_ERROR([tree-sitter metadata is required])
+TREE_SITTER_LIBS=`"$PKG_CONFIG" --libs tree-sitter` || AC_MSG_ERROR([tree-sitter link flags are required])
+ember_save_CPPFLAGS=$CPPFLAGS
+ember_save_LIBS=$LIBS
+CPPFLAGS="$CPPFLAGS $TREE_SITTER_CFLAGS"
+LIBS="$TREE_SITTER_LIBS $LIBS"
+AC_LINK_IFELSE([AC_LANG_PROGRAM([[#include <tree_sitter/api.h>
+#if TREE_SITTER_LANGUAGE_VERSION < 14 || TREE_SITTER_MIN_COMPATIBLE_LANGUAGE_VERSION > 14
+#error incompatible tree-sitter grammar ABI
+#endif]], [[TSParser *parser = ts_parser_new (); ts_parser_delete (parser);]])], [],
+  [AC_MSG_ERROR([usable tree-sitter runtime and ABI 14 headers are required])])
+CPPFLAGS=$ember_save_CPPFLAGS
+LIBS=$ember_save_LIBS
+AC_SUBST([TREE_SITTER_CFLAGS])
+AC_SUBST([TREE_SITTER_LIBS])
 . $srcdir/tree-sitter.cfg
 AC_SUBST([TREE_SITTER_VERSION])
 AC_SUBST([TREE_SITTER_GO_VERSION])
