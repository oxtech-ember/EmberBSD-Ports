$NetBSD$

Use the selected build PATH when finding the cat utility.
Origin: EmberBSD (AI-assisted). Upstream status: not submitted.

--- autoopts/mk-tpl-config.sh
+++ autoopts/mk-tpl-config.sh
@@ -139,11 +139,14 @@
     do
         \unalias -a
         unset -f command cat which
-        POSIX_CAT=`which cat`
