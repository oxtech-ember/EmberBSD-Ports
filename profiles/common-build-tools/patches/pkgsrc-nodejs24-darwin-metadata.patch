++def _CheckSelectedMacOSSDK(metadata, sdk):
++    if sdk in ("", "macosx", metadata["name"], metadata["path"]):
++        return
++    if os.path.isabs(sdk) and os.path.realpath(sdk) == os.path.realpath(metadata["path"]):
++        return
++    raise GypError("SDKROOT does not match GYP_MACOS_SDK_PATH: " + sdk)
