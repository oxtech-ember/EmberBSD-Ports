++def _SelectedMacOSMetadata():
++    """Read explicitly selected host ABI metadata without tool discovery."""
++    global SELECTED_MACOS_CACHE
++    sdk = os.environ.get("GYP_MACOS_SDK_PATH", "")
++    xcode_plist = os.environ.get("GYP_XCODE_VERSION_PLIST", "")
++    if not sdk and not xcode_plist:
++        return None
++    inputs = (sdk, xcode_plist)
++    if SELECTED_MACOS_CACHE and SELECTED_MACOS_CACHE["inputs"] == inputs:
++        return SELECTED_MACOS_CACHE
++    if not all(os.path.isabs(path) for path in inputs):
++        raise GypError("GYP_MACOS_SDK_PATH and GYP_XCODE_VERSION_PLIST must both be absolute paths")
++    try:
++        with open(os.path.join(sdk, "SDKSettings.plist"), "rb") as stream:
++            settings = plistlib.load(stream)
++        with open(xcode_plist, "rb") as stream:
++            xcode = plistlib.load(stream)
++        version = settings["Version"]
++        name = settings["CanonicalName"]
++        xcode_version = xcode["CFBundleShortVersionString"]
++        xcode_build = xcode["ProductBuildVersion"]
++        if (not isinstance(version, str) or not re.fullmatch(r"[0-9]+(?:\.[0-9]+){0,2}", version)
++                or name != "macosx" + version
++                or not isinstance(xcode_version, str)
++                or not re.fullmatch(r"[0-9]+(?:\.[0-9]+){0,2}", xcode_version)
++                or not isinstance(xcode_build, str)
++                or not re.fullmatch(r"[A-Za-z0-9]+", xcode_build)):
++            raise ValueError("invalid macOS SDK or Xcode version metadata")
++    except (OSError, ValueError, KeyError, TypeError) as error:
++        raise GypError("Cannot read selected macOS metadata: " + str(error)) from error
++    parts = xcode_version.split(".")
++    parts[0] = parts[0].zfill(2)
++    SELECTED_MACOS_CACHE = {
++        "inputs": inputs, "path": sdk, "name": name, "version": version,
++        "xcode_version": ("".join(parts) + "00")[:4], "xcode_build": xcode_build,
++    }
++    return SELECTED_MACOS_CACHE
++
