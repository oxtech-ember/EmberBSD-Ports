# Origin: EmberBSD (AI-assisted). Keep pkg_alternatives runtime tools on the target.
# Upstream: NetBSD pkgsrc pkgtools/pkg_alternatives Makefile revision1.25.
# No standalone target-shell variable is exported by mk/pkginstall.
--- a/pkgtools/pkg_alternatives/Makefile
+++ b/pkgtools/pkg_alternatives/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.25 2024/07/25 05:41:51 wiz Exp $
 
 PKGNAME=	pkg_alternatives-1.7
+PKGREVISION=	1
 CATEGORIES=	pkgtools
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
@@ -33,8 +34,16 @@
 SUBST_VARS.vars+=	PKG_DBDIR
 SUBST_VARS.vars+=	PREFIX
 SUBST_SED.vars+=	-e 's|@ROOT_USER@|${REAL_ROOT_USER}|g'
+.include "../../mk/bsd.prefs.mk"
+
+# Installed POSIX scripts need target tools, not bootstrap tool paths.
+# Match the NetBSD cross shell contract in mk/pkginstall/bsd.pkginstall.mk.
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD"
+SUBST_SED.vars+=	-e 's|@ID@|/usr/bin/id|g' -e 's|@SH@|/bin/sh|g'
+.else
 SUBST_VARS.vars+=	ID
 SUBST_VARS.vars+=	SH
+.endif
 
 INSTALLATION_DIRS=	${PKGMANDIR}/man8 sbin
 
