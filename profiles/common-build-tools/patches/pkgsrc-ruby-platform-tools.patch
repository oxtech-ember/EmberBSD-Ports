Origin: EmberBSD (AI-assisted). Preserve longest-first Ruby PLIST substitutions without
invoking external text tools during pkgsrc metadata parsing.

--- a/lang/ruby/platform.mk
+++ b/lang/ruby/platform.mk
@@ -11,12 +11,8 @@
 .include "../../lang/ruby/rubyversion.mk"
 .include "../../mk/compiler.mk"
 
-#
-# sort by length of module's name for PLIST_AWK
-#
-_RUBY_BUNDLE_MODULES!=	\
-	echo ${RUBY_BUNDLE_MODULES} | tr ' ' '\012' | \
-	awk '{print length(), $$0}' | sort -nr | awk '{print $$2}'
+# Sort by descending module-name length without external tools.
+_RUBY_BUNDLE_MODULES= ${RUBY_BUNDLE_MODULES:@m@${m:C/./x/g}-${m}@:Or:C/^x*-//}
 
 .for s in ${_RUBY_BUNDLE_MODULES}
 t:=RUBY_${s:tu:S/-/_/g}_VER
