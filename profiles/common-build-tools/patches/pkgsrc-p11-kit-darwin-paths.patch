++/* Resolve only generated installation paths. External configured paths and
++ * caller-supplied overrides retain their original spelling. */
++char *
++p11_path_install (const char *path)
++{
++#ifdef P11_RELOCATABLE_DARWIN
++	static const char marker[] = "@p11-kit-prefix@/";
++	static const char *const dirs[] = { "/lib/pkcs11", "/libexec/p11-kit", "/bin", "/lib" };
++	Dl_info image;
++	char *file, *leaf, *resolved = NULL;
++	size_t i, len, size;
++
++	if (strncmp (path, marker, sizeof (marker) - 1) != 0)
++		return strdup (path);
++	if (!dladdr ((const void *)p11_path_install, &image) || !image.dli_fname) {
++		errno = ENOENT;
++		return NULL;
++	}
++	file = realpath (image.dli_fname, NULL);
++	if (!file)
++		return NULL;
++	leaf = strrchr (file, '/');
++	if (leaf)
++		*leaf = 0;
++	len = strlen (file);
++	errno = ENOENT;
++	for (i = 0; i < sizeof (dirs) / sizeof (dirs[0]); i++) {
++		size = strlen (dirs[i]);
++		if (size <= len && strcmp (file + len - size, dirs[i]) == 0) {
++			file[len - size] = 0;
++			if (asprintf (&resolved, "%s/%s", file, path + sizeof (marker) - 1) < 0)
++				resolved = NULL;
++			break;
++		}
++	}
++	free (file);
++	return resolved;
++#else
++	return strdup (path);
++#endif
++}
