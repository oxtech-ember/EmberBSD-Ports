+$NetBSD$
+
+Use the Ruby ABI selected by mkmf for Rust extension builds.
+
+--- lib/rb_sys/mkmf.rb.orig
++++ lib/rb_sys/mkmf.rb
+@@ -9,6 +9,11 @@
+ # rubocop:disable Style/GlobalVars
+ # Root module
+ module RbSys
++  # Ruby's mkmf loads --target-rbconfig in the MakeMakefile namespace.
++  if defined?(MakeMakefile) && MakeMakefile.const_defined?(:RbConfig, false)
++    RbConfig = MakeMakefile::RbConfig
++  end
++
+   # Helper class for creating Rust Makefiles
+   module Mkmf
+     # Helper for building Rust extensions by creating a Ruby compatible makefile
