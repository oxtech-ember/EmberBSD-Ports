@@ -12,12 +13,19 @@
 DEPENDS+=	tcl-expect>=5.32.1:../../lang/tcl-expect
 
 GNU_CONFIGURE=	yes
+# EmberBSD: cross builds cannot run the target install-info; the info
+# index is registered on the target after installation there.
+.if !defined(USE_CROSS_COMPILE) || ${USE_CROSS_COMPILE:tl} != "yes"
 INFO_FILES=	yes
+.endif
 USE_TOOLS=	gmake
 
 CONFIGURE_ARGS+=	--infodir=${PREFIX}/info
 
 INSTALL_TARGET=	install install-info
+.if defined(USE_CROSS_COMPILE) && ${USE_CROSS_COMPILE:tl} == "yes"
+INSTALL_TARGET=	install
+.endif
 
 # c++ is necessary for make test
 USE_LANGUAGES+=	c c++
@@ -25,3 +33,9 @@
 TEST_ENV=	PATH=/usr/bin:/bin:${PREFIX}/bin
 
 .include "../../mk/bsd.pkg.mk"
+
+# EmberBSD: the plain cross install leaves an unstaged info index.
+.if defined(USE_CROSS_COMPILE) && ${USE_CROSS_COMPILE:tl} == "yes"
+post-install:
+	${RM} -f ${DESTDIR}${PREFIX}/info/dir
+.endif
