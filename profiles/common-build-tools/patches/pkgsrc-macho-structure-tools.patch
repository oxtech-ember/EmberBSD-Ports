+# Read selected tools without relying on the nonportable close(pipe) status.
+function tool_lines(command, lines,    line, status, count) {
+	split("", lines)
+	status = -1
+	count = 0
+	command = command "; printf '\nEMBER_MACHO_STATUS=%s\n' \"$?\""
+	while ((command | getline line) > 0) {
+		if (line ~ /^EMBER_MACHO_STATUS=[0-9]+$/)
+			status = substr(line, 20) + 0
+		else if (line != "") lines[++count] = line
+	}
+	close(command)
+	return status == 0 ? count : -1
+}
