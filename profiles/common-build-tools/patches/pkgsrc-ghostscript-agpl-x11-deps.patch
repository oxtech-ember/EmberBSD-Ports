--- /dev/null
+++ b/print/ghostscript-agpl/patches/patch-freetype-version
@@ -0,0 +1,41 @@
+$NetBSD$
+
+Compare the complete FreeType version in the header-only configure check.
+FreeType 2.15.0 satisfies the required 2.4.2.
+Origin: EmberBSD (AI-assisted); upstream status: not submitted.
+
+--- configure.orig
++++ configure
+@@ -9648,13 +9648,7 @@
+ main (void)
+ {
+ 
+-                 #if FREETYPE_MAJOR < 2
+-                   FAIL
+-                 #endif
+-                 #if FREETYPE_MINOR < 4
+-                   FAIL
+-                 #endif
+-                 #if FREETYPE_PATCH < 2
++                 #if FREETYPE_MAJOR < 2 || (FREETYPE_MAJOR == 2 && FREETYPE_MINOR < 4) || (FREETYPE_MAJOR == 2 && FREETYPE_MINOR == 4 && FREETYPE_PATCH < 2)
+                    FAIL
+                  #endif
+                  return(0);
+
+--- configure.ac.orig
++++ configure.ac
+@@ -1442,13 +1442,7 @@
+             AC_COMPILE_IFELSE(
+               [AC_LANG_PROGRAM([#include "ft2build.h"
+               #include FT_FREETYPE_H], [
+-                 #if FREETYPE_MAJOR < 2
+-                   FAIL
+-                 #endif
+-                 #if FREETYPE_MINOR < 4
+-                   FAIL
+-                 #endif
+-                 #if FREETYPE_PATCH < 2
++                 #if FREETYPE_MAJOR < 2 || (FREETYPE_MAJOR == 2 && FREETYPE_MINOR < 4) || (FREETYPE_MAJOR == 2 && FREETYPE_MINOR == 4 && FREETYPE_PATCH < 2)
+                    FAIL
+                  #endif
+                  return(0);
