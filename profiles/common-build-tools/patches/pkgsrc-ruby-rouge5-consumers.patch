Origin: EmberBSD, AI-assisted.
Ports keeps only rouge 5.1.0. heel 4.0.1 and jekyll 4.4.1 work with it,
but their gemspecs and recipes required rouge < 5, so relax the bound
with OVERRIDE_GEMSPEC and in DEPENDS. heel's directory listing sorts
MIME types, which needs the mime-types columnar sort fix in 3.7.0nb1.
Bump PKGREVISION for the changed dependencies.
Not submitted upstream.

--- a/www/heel/Makefile
+++ b/www/heel/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.20 2024/03/04 15:23:34 taca Exp $
 
 DISTNAME=	heel-4.0.1
+PKGREVISION=	1
 CATEGORIES=	www
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
@@ -11,13 +12,14 @@
 #DEPENDS+=	${RUBY_PKGPREFIX}-rack>=3.0<4:../../www/ruby-rack
 DEPENDS+=	${RUBY_PKGPREFIX}-rackup>=2.1<3:../../www/ruby-rackup
 DEPENDS+=	${RUBY_PKGPREFIX}-puma>=6.0<7:../../www/ruby-puma
-DEPENDS+=	${RUBY_PKGPREFIX}-mime-types>=3.4<4:../../mail/ruby-mime-types
+DEPENDS+=	${RUBY_PKGPREFIX}-mime-types>=3.7.0nb1<4:../../mail/ruby-mime-types
 DEPENDS+=	${RUBY_PKGPREFIX}-launchy>=2.5<3:../../misc/ruby-launchy
-DEPENDS+=	${RUBY_PKGPREFIX}-rouge>=4.0<5:../../www/ruby-rouge
+DEPENDS+=	${RUBY_PKGPREFIX}-rouge>=4.0:../../www/ruby-rouge
 
 CONFLICTS+=	ruby[1-9][0-9][0-9]-heel-[0-9]* heel-[0-9]*
 
 RUBYGEM_OPTIONS+=	--format-executable
+OVERRIDE_GEMSPEC+=	rouge>=4.0
 
 .include "../../lang/ruby/gem.mk"
 .include "../../mk/bsd.pkg.mk"
--- a/www/ruby-jekyll/Makefile
+++ b/www/ruby-jekyll/Makefile
@@ -1,6 +1,7 @@
 # $NetBSD: Makefile,v 1.49 2025/02/09 15:23:53 taca Exp $
 
 DISTNAME=	jekyll-4.4.1
+PKGREVISION=	1
 CATEGORIES=	www
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
@@ -19,7 +20,7 @@
 DEPENDS+=	${RUBY_PKGPREFIX}-liquid>=4.0:../../www/ruby-liquid
 DEPENDS+=	${RUBY_PKGPREFIX}-mercenary>=0.4.0<0.5:../../devel/ruby-mercenary
 DEPENDS+=	${RUBY_PKGPREFIX}-pathutil>=0.9<1:../../devel/ruby-pathutil
-DEPENDS+=	${RUBY_PKGPREFIX}-rouge>=3.0<5.0:../../www/ruby-rouge
+DEPENDS+=	${RUBY_PKGPREFIX}-rouge>=3.0:../../www/ruby-rouge
 DEPENDS+=	${RUBY_PKGPREFIX}-safe_yaml>=1.0<2:../../textproc/ruby-safe_yaml
 DEPENDS+=	${RUBY_PKGPREFIX}-terminal-table>=2.0<4:../../textproc/ruby-terminal-table
 # below packages are not listed in gemspec
@@ -30,7 +31,7 @@
 USE_LANGUAGES=	# empty
 
 RUBYGEM_OPTIONS+=	--format-executable
-OVERRIDE_GEMSPEC+=	liquid>=4.0
+OVERRIDE_GEMSPEC+=	liquid>=4.0 rouge>=3.0
 
 .include "../../lang/ruby/gem.mk"
 .include "../../mk/bsd.pkg.mk"
