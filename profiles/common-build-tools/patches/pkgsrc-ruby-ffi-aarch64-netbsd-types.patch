--- a/devel/ruby-ffi/Makefile
+++ b/devel/ruby-ffi/Makefile
@@ -8,6 +8,21 @@
 COMMENT=	Loading dynamic libraries, binding functions within them
 LICENSE=	modified-bsd
 
+.include "../../mk/bsd.prefs.mk"
+
+PLIST_VARS+=	netbsd_aarch64
+.if ${OPSYS} == "NetBSD" && ${MACHINE_ARCH} == "aarch64"
+PKGREVISION=	1
+PLIST.netbsd_aarch64=	yes
+
+FFI_TYPE_FILE=	lib/ffi/platform/aarch64-netbsd/types.conf
+OVERRIDE_GEMSPEC+=	:files ${FFI_TYPE_FILE}
+
+post-extract:
+	${MKDIR} ${WRKSRC}/${FFI_TYPE_FILE:H}
+	${CP} ${FILESDIR}/types-aarch64-netbsd.conf ${WRKSRC}/${FFI_TYPE_FILE}
+.endif
+
 .include "../../lang/ruby/gem.mk"
 .include "../../devel/libffi/buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
