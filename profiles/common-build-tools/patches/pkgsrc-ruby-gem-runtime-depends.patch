Origin: EmberBSD, AI-assisted.

gssapi 1.3.1 needs ffi >= 1.0.1 at run time, but the package does not
depend on it, so RubyGems cannot activate gssapi (and chef-winrm through
it) unless something else happens to install ffi.  Declare the dependency.
Not submitted upstream.

--- a/security/ruby-gssapi/Makefile
+++ b/security/ruby-gssapi/Makefile
@@ -1,12 +1,15 @@
 # $NetBSD: Makefile,v 1.2 2021/01/14 14:17:06 taca Exp $
 
 DISTNAME=	gssapi-1.3.1
+PKGREVISION=	1
 CATEGORIES=	security
 
 MAINTAINER=	pkgsrc-users@NetBSD.org
 HOMEPAGE=	https://github.com/zenchild/gssapi
 COMMENT=	FFI wrapper around the system GSSAPI library
 LICENSE=	mit
+
+DEPENDS+=	${RUBY_PKGPREFIX}-ffi>=1.0.1:../../devel/ruby-ffi
 
 USE_LANGUAGES=	# none
 
