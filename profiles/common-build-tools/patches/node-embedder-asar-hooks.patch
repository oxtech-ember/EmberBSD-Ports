+void BindingData::OverrideReadFileSync(const FunctionCallbackInfo<Value>& args) {
+  Realm* realm = Realm::GetCurrent(args);
+  if (args.Length() == 0 || args[0]->IsUndefined()) {
+    realm->set_modules_read_file_sync(Local<Function>());
+    return;
+  }
+  if (!args[0]->IsFunction()) {
+    THROW_ERR_INVALID_ARG_TYPE(realm->env(), "package read override must be a function");
+    return;
+  }
+  realm->set_modules_read_file_sync(args[0].As<Function>());
+}
