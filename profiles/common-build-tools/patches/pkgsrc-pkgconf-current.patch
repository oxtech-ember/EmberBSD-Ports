+++ b/devel/pkgconf/patches/patch-libpkgconf_personality.c
@@ -0,0 +1,117 @@
+$NetBSD$
+
+Resolve native Darwin package search paths against the loaded libpkgconf.
+Keep external directories configured by pkgsrc in their original order.
+
+--- libpkgconf/personality.c.orig
++++ libpkgconf/personality.c
+@@ -18,6 +18,11 @@
+ #include <libpkgconf/config.h>
+ #include <libpkgconf/stdinc.h>
+ #include <libpkgconf/libpkgconf.h>
++#ifdef PKGSRC_PKGCONF_RELOCATABLE
++#include <dlfcn.h>
++#include <mach-o/loader.h>
++#include <unistd.h>
++#endif
+ 
+ /*
+  * !doc
+@@ -36,6 +41,79 @@
+ static pkgconf_cross_personality_t default_personality = {
+ 	.name = "default",
+ };
++
++#ifdef PKGSRC_PKGCONF_RELOCATABLE
++/*
++ * dladdr also works for programs linked to the static library. Recognize
++ * their own installation only when the package metadata is alongside them.
++ */
++static bool
++pkgsrc_prefix(char prefix[PATH_MAX])
++{
++	Dl_info image;
++	char *leaf, *dir;
++	bool executable;
++
++	if (!dladdr(&default_personality, &image) || !image.dli_fname ||
++	    !image.dli_fbase || !realpath(image.dli_fname, prefix))
++		return false;
++	leaf = strrchr(prefix, '/');
++	if (leaf == NULL)
++		return false;
++	executable = ((const struct mach_header *)image.dli_fbase)->filetype == MH_EXECUTE;
++	if (!executable && strncmp(leaf, "/libpkgconf.", sizeof("/libpkgconf.") - 1))
++		return false;
++	*leaf = '\0';
++	dir = strrchr(prefix, '/');
++	if (!dir || (executable ? strcmp(dir, "/bin") && strcmp(dir, "/sbin") :
++	    strcmp(dir, "/lib")))
++		return false;
++	*dir = '\0';
++	if (executable)
++	{
++		char pc[PATH_MAX];
++		int n = snprintf(pc, sizeof pc, "%s/lib/pkgconfig/libpkgconf.pc", prefix);
++		if (n < 0 || (size_t)n >= sizeof pc || access(pc, R_OK) != 0)
++			return false;
++	}
++	return true;
++}
++
++static void
++pkgsrc_path_split(const char *paths, pkgconf_list_t *dirlist, bool filter)
++{
++	static const char marker[] = "@pkgsrc_prefix/";
++	const size_t marker_len = sizeof(marker) - 1;
++	char prefix[PATH_MAX], *storage, *cursor, *entry;
++
++	bool has_prefix = pkgsrc_prefix(prefix);
++	storage = strdup(paths);
++	if (storage == NULL)
++		return;
++	cursor = storage;
++	while ((entry = strsep(&cursor, PKG_CONFIG_PATH_SEP_S)) != NULL)
++	{
++		if (!*entry)
++			continue;
++		if (strncmp(entry, marker, marker_len))
++		{
++			pkgconf_path_add(entry, dirlist, filter);
++			continue;
++		}
++		/* A standalone static client can still select external directories
++		 * through the ordinary environment or an explicit personality. */
++		if (!has_prefix)
++			continue;
++		pkgconf_buffer_t path = PKGCONF_BUFFER_INITIALIZER;
++		if (pkgconf_buffer_append_fmt(&path, "%s/%s", prefix, entry + marker_len))
++			pkgconf_path_add(pkgconf_buffer_str(&path), dirlist, filter);
++		pkgconf_buffer_finalize(&path);
++	}
++	free(storage);
++}
++#else
++#define pkgsrc_path_split pkgconf_path_split
++#endif
+ 
+ static inline void
+ build_default_search_path(pkgconf_list_t* dirlist)
+@@ -88,7 +166,7 @@
+ 		paths = NULL;
+ 	}
+ #else
+-	pkgconf_path_split(PKG_DEFAULT_PATH, dirlist, false);
++	pkgsrc_path_split(PKG_DEFAULT_PATH, dirlist, false);
+ #endif
+ }
+ 
+@@ -369,7 +447,7 @@
+ 	pkgconf_path_free(&plist);
+ #endif
+ 
+-	pkgconf_path_split(PERSONALITY_PATH, &plist, true);
++	pkgsrc_path_split(PERSONALITY_PATH, &plist, true);
+ 
