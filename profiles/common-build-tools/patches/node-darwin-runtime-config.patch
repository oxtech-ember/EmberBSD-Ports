+# Keep the full compiler configuration for GYP and the installed developer
+# headers. Only the copy linked into the executable needs relative paths.
+def runtime_config(value, prefix, paths, keys=()):
+  if isinstance(value, dict):
+    return {k: runtime_config(v, prefix, paths, (*keys, k)) for k, v in value.items()}
+  if isinstance(value, list):
+    return [runtime_config(v, prefix, paths, (*keys, i)) for i, v in enumerate(value)]
+  if isinstance(value, str):
+    for flag in ('', '-I', '-L', '-F'):
+      base = flag + prefix
+      if value == base or value.startswith(base + '/'):
+        tail = value[len(base):]
+        if '..' not in tail.split('/'):
+          paths.append([keys, flag])
+          return tail
+  return value
+
+runtime_config_dir = Path('out/pkgsrc-runtime')
+runtime_config_dir.mkdir(parents=True, exist_ok=True)
+prefix_paths = []
+runtime_values = runtime_config(output, variables['node_prefix'], prefix_paths)
+write(runtime_config_dir / 'config.gypi', do_not_edit +
+      json.dumps({'config': runtime_values, 'prefix_paths': prefix_paths}, indent=2) + '\n')
+
 write('config.status', '#!/bin/sh\nset -x\nexec ./configure ' +
       ' '.join([shlex.quote(arg) for arg in original_argv]) + '\n')
 Path('config.status').chmod(0o775)
