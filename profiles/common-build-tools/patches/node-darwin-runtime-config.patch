@@ -0,0 +1,33 @@
+'use strict';
+
+const { JSONParse, ObjectDefineProperty, ObjectFreeze, ObjectKeys } = primordials;
+
+function freezeConfig(value) {
+  if (value !== null && typeof value === 'object') {
+    const keys = ObjectKeys(value);
+    for (let i = 0; i < keys.length; i++) freezeConfig(value[keys[i]]);
+    ObjectFreeze(value);
+  }
+  return value;
+}
+
+// Bootstrapping may run while generating a snapshot. The installed prefix is
+// known once the native process object supplies the current executable path.
+function setConfig(prefix = '@executable_path/..') {
+  const { config, prefix_paths: paths } = JSONParse(internalBinding('builtins').config);
+  for (let n = 0; n < paths.length; n++) {
+    const keys = paths[n][0];
+    let parent = config;
+    for (let i = 0; i < keys.length - 1; i++) parent = parent[keys[i]];
+    const last = keys[keys.length - 1];
+    parent[last] = paths[n][1] + prefix + parent[last];
+  }
+  ObjectDefineProperty(process, 'config', {
+    __proto__: null,
+    configurable: true,
+    enumerable: true,
+    value: freezeConfig(config),
+  });
+}
+
+module.exports = { setConfig };
