gts links libintl through glib2 and needs gettext-lib.

On macOS glib-2.0.pc lists -lintl in Libs, so libgts and every gts
program load libintl directly, and check-shlibs rejected the native
package: gettext-lib is not a runtime dependency. On NetBSD libintl is
built in and the dependency is not added.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/graphics/gts/Makefile
+++ b/graphics/gts/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.13 2026/09/02 19:02:41 wiz Exp $
 
 DISTNAME=	gts-0.7.6
-PKGREVISION=	9
+PKGREVISION=	10
 CATEGORIES=	graphics
 MASTER_SITES=	${MASTER_SITE_SOURCEFORGE:=gts/}
 
@@ -18,6 +18,7 @@
 
 CPPFLAGS+=	-I${BUILDLINK_PREFIX.netpbm}/include/netpbm
 
+.include "../../devel/gettext-lib/buildlink3.mk"
 .include "../../devel/glib2/buildlink3.mk"
 .include "../../graphics/netpbm/buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
