Origin: EmberBSD contributors (AI-assisted).
Build the bundled HTML5 parser with the selected target Ruby and archiver.

--- a/textproc/ruby-nokogiri/Makefile
+++ b/textproc/ruby-nokogiri/Makefile
@@ -8,7 +8,20 @@
 COMMENT=	HTML, XML, SAX, and Reader parser with XPath and CSS selector support
 LICENSE=	mit
 
-DEPENDS+=	${RUBY_PKGPREFIX}-mini_portile2>=2.8.2:../../misc/ruby-mini_portile2
+DEPENDS+=	${RUBY_PKGPREFIX}-mini_portile2>=2.8.2<2.9:../../misc/ruby-mini_portile2
+
+.include "../../mk/bsd.prefs.mk"
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+PKGREVISION=	2
+# The host Ruby runs extconf.rb and loads mini_portile2 to build Gumbo.
+TOOL_DEPENDS+=	${RUBY_PKGPREFIX}-mini_portile2>=2.8.2<2.9:../../misc/ruby-mini_portile2
+# mkmf loads the selected target configuration for a cross extension.
+SUBST_CLASSES+=		target-rbconfig
+SUBST_STAGE.target-rbconfig=	pre-configure
+SUBST_FILES.target-rbconfig=	ext/nokogiri/extconf.rb
+SUBST_SED.target-rbconfig=	-e 's/RbConfig::/MakeMakefile::RbConfig::/g'
+MAKE_ENV+=		AR=${AR:Q} RANLIB=${RANLIB:Q} ARFLAGS=rcs
+.endif
 
 USE_GCC_RUNTIME=	yes
 USE_TOOLS+=		pkg-config
