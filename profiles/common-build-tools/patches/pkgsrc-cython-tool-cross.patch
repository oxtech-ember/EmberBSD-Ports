# Origin: EmberBSD (AI-assisted), not submitted upstream.
# tool.mk linked cython from PREFIX, which names the target prefix in a
# cross build, so configure found no cython and built no Python bindings.
# Take cython from TOOLBASE and depend on it as a tool.

--- a/devel/py-cython/tool.mk
+++ b/devel/py-cython/tool.mk
@@ -13,13 +13,15 @@
 .include "../../lang/python/pyversion.mk"
 .endif
 
+# cython runs on the build machine; in a cross build PREFIX names the target.
+TOOL_DEPENDS+=		${PYPKGPREFIX}-cython-[0-9]*:../../devel/py-cython
 BUILDLINK_TARGETS+=	buildlink-bin-cython
 
 .PHONY: buildlink-bin-cython
 buildlink-bin-cython:
 .for cythontool in cython cythonize
 	${RUN} \
-	f="${PREFIX}/bin/${cythontool}-${PYVERSSUFFIX}"; \
+	f="${TOOLBASE}/bin/${cythontool}-${PYVERSSUFFIX}"; \
 	t="${BUILDLINK_DIR}/bin/${cythontool}"; \
 	if ${TEST} -f $$f -a ! -f $$t ; then \
 		${LN} -sf $$f $$t; \

--- a/devel/py-cython/Makefile
+++ b/devel/py-cython/Makefile
@@ -1,8 +1,7 @@
 # $NetBSD: Makefile,v 1.122 2026/08/25 10:50:00 wiz Exp $
 
-DISTNAME=	cython-3.3.0
+DISTNAME=	cython-3.3.1
 PKGNAME=	${PYPKGPREFIX}-${DISTNAME}
-PKGREVISION=	1
 CATEGORIES=	devel python
 MASTER_SITES=	${MASTER_SITE_PYPI:=C/Cython/}
 
@@ -14,9 +13,19 @@
 TOOL_DEPENDS+=	${PYPKGPREFIX}-setuptools>=78:../../devel/py-setuptools
 TEST_DEPENDS+=	${PYPKGPREFIX}-numpy-[0-9]*:../../math/py-numpy
 
+.include "../../mk/bsd.prefs.mk"
+
+.if ${OPSYS} == "Darwin" && ${USE_CROSS_COMPILE:Uno:tl} != "yes"
+# The wheel installs all three as module data. Keep their upstream shebang
+# so they can travel with the versioned console scripts in a native SDK.
+PKGREVISION=	1
+# Generated C uses __FILE__ for diagnostics in compiled module code.
+CFLAGS+=	-fmacro-prefix-map=${WRKSRC:Q}/=
+.else
 REPLACE_PYTHON+=	Cython/Debugger/Cygdb.py
 REPLACE_PYTHON+=	Cython/Debugger/libpython.py
 REPLACE_PYTHON+=	cython.py
+.endif
 
 PY_RENAME_BINARIES=	cython cythonize cygdb
 

