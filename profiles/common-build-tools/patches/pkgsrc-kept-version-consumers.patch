+$NetBSD$
+
+Build with Lua 5.5: provide the integer API casts and the module
+registration that Lua 5.3 dropped, and load LuaSocket's helper
+without module().
+
+--- src/lua/LuaBit.cpp.orig
++++ src/lua/LuaBit.cpp
+@@ -90,7 +90,11 @@ static UBits barg(lua_State *L, int idx)
+ }
+ 
+ /* Return bit type. */
++#if LUA_VERSION_NUM >= 503
++#define BRET(b)  lua_pushinteger(L, (lua_Integer)(SBits)(b)); return 1;
++#else
+ #define BRET(b)  lua_pushnumber(L, (lua_Number)(SBits)(b)); return 1;
++#endif
+ 
+ static int bit_tobit(lua_State *L) { BRET(barg(L, 1)) }
+ static int bit_bnot(lua_State *L) { BRET(~barg(L, 1)) }
--- /dev/null
+++ b/games/powder-toy/patches/patch-src_lua_LuaCompat.c
@@ -0,0 +1,63 @@
+$NetBSD$
+
+Build with Lua 5.5: provide the integer API casts and the module
+registration that Lua 5.3 dropped, and load LuaSocket's helper
+without module().
+
+--- src/lua/LuaCompat.c.orig
++++ src/lua/LuaCompat.c
+@@ -8,6 +8,54 @@ int luaL_typerror (lua_State *L, int narg, const char *tname)
+ 	return luaL_argerror(L, narg, msg);
+ }
+ 
++#if LUA_VERSION_NUM >= 503 && !defined(LUA_COMPAT_MODULE)
++#include <string.h>
++
++// Implement luaL_openlib as Lua 5.2 does with LUA_COMPAT_MODULE: find or
++// create the module table in package.loaded and in the global table, and
++// register the functions in it, or in the table on the stack if libname is NULL
++void luaL_openlib(lua_State *L, const char *libname, const luaL_Reg *l, int nup)
++{
++	if (libname)
++	{
++		luaL_getsubtable(L, LUA_REGISTRYINDEX, LUA_LOADED_TABLE);
++		if (lua_getfield(L, -1, libname) != LUA_TTABLE)
++		{
++			const char *name = libname, *e;
++			lua_pop(L, 1);
++			lua_pushglobaltable(L);
++			do
++			{
++				e = strchr(name, '.');
++				if (!e)
++					e = name + strlen(name);
++				lua_pushlstring(L, name, e - name);
++				if (lua_rawget(L, -2) == LUA_TNIL)
++				{
++					lua_pop(L, 1);
++					lua_newtable(L);
++					lua_pushlstring(L, name, e - name);
++					lua_pushvalue(L, -2);
++					lua_settable(L, -4);
++				}
++				else if (!lua_istable(L, -1))
++					luaL_error(L, "name conflict for module '%s'", libname);
++				lua_remove(L, -2);
++				name = e + 1;
++			} while (*e == '.');
++			lua_pushvalue(L, -1);
++			lua_setfield(L, -3, libname);
++		}
++		lua_remove(L, -2);
++		lua_insert(L, -(nup + 1));
++	}
++	if (l)
++		luaL_setfuncs(L, l, nup);
++	else
++		lua_pop(L, nup);
++}
++#endif
++
+ #else
+ 
+ // Implement function added in lua 5.2 that we now use
--- /dev/null
+++ b/games/powder-toy/patches/patch-src_lua_LuaCompat.h
@@ -0,0 +1,31 @@
+$NetBSD$
+
+Build with Lua 5.5: provide the integer API casts and the module
+registration that Lua 5.3 dropped, and load LuaSocket's helper
+without module().
+
+--- src/lua/LuaCompat.h.orig
++++ src/lua/LuaCompat.h
+@@ -31,6 +31,22 @@ LUALIB_API void (lua_pushglobaltable) (lua_State *L);
+ #endif
+ int luaL_tostring(lua_State *L, int n);
+ 
++#if LUA_VERSION_NUM >= 503
++/* Lua 5.3 dropped the int casts of the integer API, and names its float type differently. */
++#ifndef luaL_checkint
++#define luaL_checkint(L,n)	((int)luaL_checkinteger(L, (n)))
++#define luaL_optint(L,n,d)	((int)luaL_optinteger(L, (n), (d)))
++#endif
++#if LUA_FLOAT_TYPE == LUA_FLOAT_DOUBLE && !defined(LUA_NUMBER_DOUBLE)
++#define LUA_NUMBER_DOUBLE
++#endif
++#ifndef LUA_COMPAT_MODULE
++/* Module registration as in Lua 5.2 with LUA_COMPAT_MODULE */
++void luaL_openlib(lua_State *L, const char *libname, const luaL_Reg *l, int nup);
++#define luaL_register(L,n,l)	(luaL_openlib(L, (n), (l), 0))
++#endif
++#endif
++
+ #ifdef __cplusplus
+ }
