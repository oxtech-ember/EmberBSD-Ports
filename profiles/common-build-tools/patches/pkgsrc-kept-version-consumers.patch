+$NetBSD$
+
+Build with Lua 5.5, which sets the collector parameters with LUA_GCPARAM
+and takes the step size of LUA_GCSTEP in bytes.
+
+--- cbits/hslua/hslua.c.orig
++++ cbits/hslua/hslua.c
+@@ -208,3 +208,47 @@ int hslua_next(lua_State *L, int index, int *status)
