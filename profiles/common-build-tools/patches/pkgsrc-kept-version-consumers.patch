-$NetBSD: patch-cmake_FindLua.cmake,v 1.1 2020/07/01 10:06:42 nia Exp $
+$NetBSD$
 
 Avoid finding unversioned Lua in NetBSD.
+Read the version numbers of Lua 5.5, which defines them as LUA_VERSION_*_N.
 
---- cmake/FindLua.cmake.orig	2019-01-05 19:54:35.000000000 +0000
+--- cmake/FindLua.cmake.orig
 +++ cmake/FindLua.cmake
 @@ -31,16 +31,11 @@
  # standard syntax, e.g. FIND_PACKAGE(Lua 5.1)
@@ -23,3 +24,19 @@
  ENDIF(Lua_FIND_VERSION_MAJOR AND Lua_FIND_VERSION_MINOR)
  
  # Set up possible search names and locations
+@@ -106,10 +101,11 @@ IF(LUA_INCLUDE_DIR AND EXISTS "${LUA_INCLUDE_DIR}/lua.h")
+ 
+ 	# Lua 5.2+
+ 	IF(NOT LUA_VERSION_STRING)
+-		FILE(STRINGS "${LUA_INCLUDE_DIR}/lua.h" lua_version_str REGEX "^#define LUA_VERSION_[A-Z]+[ \t]+\"[0-9]+\"")
+-		STRING(REGEX REPLACE ".*#define LUA_VERSION_MAJOR[ \t]+\"([0-9]+)\".*" "\\1" LUA_VERSION_MAJOR ${lua_version_str})
+-		STRING(REGEX REPLACE ".*#define LUA_VERSION_MINOR[ \t]+\"([0-9]+)\".*" "\\1" LUA_VERSION_MINOR ${lua_version_str})
+-		STRING(REGEX REPLACE ".*#define LUA_VERSION_RELEASE[ \t]+\"([0-9]+)\".*" "\\1" LUA_VERSION_RELEASE ${lua_version_str})
++		# Lua 5.5 defines the numbers as LUA_VERSION_*_N without quotes
++		FILE(STRINGS "${LUA_INCLUDE_DIR}/lua.h" lua_version_str REGEX "^#define[ \t]+LUA_VERSION_[A-Z]+(_N)?[ \t]+\"?[0-9]+\"?")
++		STRING(REGEX REPLACE ".*#define[ \t]+LUA_VERSION_MAJOR(_N)?[ \t]+\"?([0-9]+)\"?.*" "\\2" LUA_VERSION_MAJOR "${lua_version_str}")
++		STRING(REGEX REPLACE ".*#define[ \t]+LUA_VERSION_MINOR(_N)?[ \t]+\"?([0-9]+)\"?.*" "\\2" LUA_VERSION_MINOR "${lua_version_str}")
++		STRING(REGEX REPLACE ".*#define[ \t]+LUA_VERSION_RELEASE(_N)?[ \t]+\"?([0-9]+)\"?.*" "\\2" LUA_VERSION_RELEASE "${lua_version_str}")
+ 		SET(LUA_VERSION_STRING ${LUA_VERSION_MAJOR}.${LUA_VERSION_MINOR}.${LUA_VERSION_RELEASE})
+ 	ENDIF()
+ 	UNSET(lua_version_str)
