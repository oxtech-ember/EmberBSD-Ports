++
++/* ***************************************************************
++ * Garbage collection
++ * ***************************************************************/
++
++/*
++** Lua 5.5 takes the step size in bytes instead of Kbytes, and sets
++** the collector parameters with LUA_GCPARAM instead of LUA_GCSETPAUSE,
++** LUA_GCSETSTEPMUL, and the arguments to LUA_GCGEN and LUA_GCINC. A zero
++** argument keeps a parameter unchanged, as in Lua 5.4.
++*/
++int hslua_gc(lua_State *L, int what, int data1, int data2, int data3)
++{
++#if LUA_VERSION_NUM >= 505
++  switch (what) {
++  case LUA_GCSTEP:
++    return lua_gc(L, LUA_GCSTEP, (size_t)(data1 > 0 ? data1 : 0) * 1024);
++  case LUA_GCSETPAUSE:
++    return lua_gc(L, LUA_GCPARAM, LUA_GCPPAUSE, data1);
++  case LUA_GCSETSTEPMUL:
++    return lua_gc(L, LUA_GCPARAM, LUA_GCPSTEPMUL, data1);
++  case LUA_GCGEN:
++    if (data1 != 0)
++      lua_gc(L, LUA_GCPARAM, LUA_GCPMINORMUL, data1);
++    if (data2 != 0)
++      lua_gc(L, LUA_GCPARAM, LUA_GCPMINORMAJOR, data2);
++    return lua_gc(L, LUA_GCGEN);
++  case LUA_GCINC:
++    if (data1 != 0)
++      lua_gc(L, LUA_GCPARAM, LUA_GCPPAUSE, data1);
++    if (data2 != 0)
++      lua_gc(L, LUA_GCPARAM, LUA_GCPSTEPMUL, data2);
++    /* Lua 5.4 gives the step size as a base-2 logarithm. */
++    if (data3 > 0 && data3 < 31)
++      lua_gc(L, LUA_GCPARAM, LUA_GCPSTEPSIZE, 1 << data3);
++    return lua_gc(L, LUA_GCINC);
++  default:
++    return lua_gc(L, what);
++  }
++#else
++  return lua_gc(L, what, data1, data2, data3);
++#endif
++}
