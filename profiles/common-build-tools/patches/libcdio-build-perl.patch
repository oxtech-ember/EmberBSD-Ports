+PKGREVISION=	1
 CATEGORIES=	misc
 MASTER_SITES=	${MASTER_SITE_GITHUB:=libcdio/}
 GITHUB_RELEASE=	${PKGVERSION_NOREV}
@@ -14,7 +15,7 @@
 USE_LANGUAGES=		c c++
 USE_LIBTOOL=		yes
 USE_PKGLOCALEDIR=	yes
-USE_TOOLS+=		gmake perl:run pkg-config
+USE_TOOLS+=		gmake perl pkg-config
 GNU_CONFIGURE=		yes
