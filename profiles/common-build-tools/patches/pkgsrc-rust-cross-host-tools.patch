Origin: EmberBSD, AI-assisted.
Cross builds run Cargo with the build-host compiler (RUST_TYPE=native).
Add the host rust-bin and the target std package named by the cross
profile as tool dependencies, so no target Rust compiler is selected.
Native tool dependencies built from the same MAKECONF keep native mode
and need the same host rust-bin as a tool dependency.
Not submitted upstream.

--- a/lang/rust/rust.mk
+++ b/lang/rust/rust.mk
@@ -63,6 +63,18 @@
 .  include "${RUST_DIR}/buildlink3.mk"
 .endif
 
+# A cross build runs the build-host compiler in native mode. It needs
+# the host rust-bin and the std of the target, both as tool dependencies.
+# A native build in native mode, such as a host tool dependency of a cross
+# package, runs the same host compiler without a target std.
+.if ${RUST_TYPE} == "native" && ${USE_CROSS_COMPILE:Uno:tl} == "yes" && \
+    !empty(EMBERBSD_CROSS_RUST_STD)
+TOOL_DEPENDS+=	rust-bin>=${RUST_REQ}:../../lang/rust-bin
+TOOL_DEPENDS+=	${EMBERBSD_CROSS_RUST_STD}-[0-9]*:../../lang/${EMBERBSD_CROSS_RUST_STD}
+.elif ${RUST_TYPE} == "native" && ${USE_CROSS_COMPILE:Uno:tl} != "yes"
+TOOL_DEPENDS+=	rust-bin>=${RUST_REQ}:../../lang/rust-bin
+.endif
+
 .if ${OPSYS} == "NetBSD"
 ALL_ENV+=	PTHREAD_KEYS_MAX=512
 .endif
