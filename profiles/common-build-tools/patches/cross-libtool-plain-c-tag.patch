Keep the cross libtool C tag on the plain selected target compiler.
Autoconf appended its C23 option to CC, so the generated tag held
"aarch64--netbsd-clang -std=gnu23". Packages whose configure calls the
compiler without that option then stopped with "specify a tag with
'--tag'" (libpcap, libdvdplay). A plain C tag also matches commands that
add the option. Hosts that already have the script need the new revision.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/cross/cross-libtool-base/Makefile
+++ b/cross/cross-libtool-base/Makefile
@@ -38,7 +38,7 @@
 # XXX Tweaked for cross-compilation.
 #PKGNAME=	${DISTNAME:S/-/-base-/}
 PKGNAME=	${DISTNAME:S/^libtool-/cross-libtool-base-${MACHINE_PLATFORM}-/}
-PKGREVISION=	4
+PKGREVISION=	5
 
 COMMENT=	Generic shared library support script (the script itself)
 
@@ -74,6 +74,10 @@
 # Configure otherwise falls back to gcc/g++ for these tags independently of
 # the explicitly selected target C and C++ compilers.
 CONFIGURE_ENV+=	OBJC=${CC:Q} OBJCXX=${CXX:Q}
+# Keep the C tag on the plain selected compiler. Autoconf would append its
+# C23 option, and libtool then cannot infer the tag for consumers that call
+# the compiler without that option.
+CONFIGURE_ENV+=	ac_cv_prog_cc_c23=
 
 USE_TOOLS+=		echo
 
