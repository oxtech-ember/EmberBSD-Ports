Origin: EmberBSD (AI-assisted); not submitted upstream.
Build DBD::mysql 5 against MariaDB Connector/C, the one MySQL client
library in EmberBSD.  Map mysql_real_escape_string_quote() to
mysql_real_escape_string(), keep the MySQL 8 compression and named-bind
calls for MySQL only, and translate the SSL modes to MYSQL_OPT_SSL_ENFORCE
and MYSQL_OPT_SSL_VERIFY_SERVER_CERT.  A connection that requires TLS is
refused if the server did not negotiate it, as with SSL_MODE_REQUIRED.
mysql_ssl=0 turns TLS off, which Connector/C 3.4 otherwise enables.
Size server-side prepared ZEROFILL result buffers to the display width,
because Connector/C pads only when the padded value fits.

--- dbdimp.c.orig
+++ dbdimp.c
@@ -13,6 +13,17 @@
  */
 
 #include "dbdimp.h"
+
+#ifdef MARIADB_PACKAGE_VERSION_ID
+/*
+ * MariaDB Connector/C has no mysql_real_escape_string_quote().  Every
+ * caller here quotes with a single quote, and mysql_real_escape_string()
+ * already escapes single quotes (by doubling them when the server runs
+ * with NO_BACKSLASH_ESCAPES), so the result is the same.
+ */
+#define mysql_real_escape_string_quote(mysql, to, from, length, quote) \
+  mysql_real_escape_string((mysql), (to), (from), (length))
+#endif
 
