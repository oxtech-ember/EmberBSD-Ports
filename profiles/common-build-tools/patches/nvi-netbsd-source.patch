--- /dev/null
+++ dist/ember-gen-headers.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# Generate nvi interfaces in the caller's object directory.
+# Origin: NetBSD nvi generators; EmberBSD integration (AI-assisted).
+set -eu
+name=$1
+src=$2
+awk=$3
+sed=$4
+shift 4
+case "$name" in
+  cl_extern.h|common_extern.h|ex_extern.h|ip_extern.h|ipc_extern.h|vi_extern.h)
+    dir=${name%_extern.h}
+    found=no
+    for file do
+      case "$file" in
+        "$src/$dir/"*.c) "$sed" -n 's/^ \* PUBLIC: \(.*\)/\1/p' "$file"; found=yes ;;
+      esac
+    done
+    test "$found" = yes
+    ;;
+  options_def.h) "$awk" -f "$src/common/options.awk" "$src/common/options.c" ;;
+  ex_def.h) "$awk" -f "$src/ex/ex.awk" "$src/ex/ex_cmd.c" ;;
+  ipc_def.h)
+    "$awk" -f "$src/ipc/ipc.awk" "$src/ipc/ipc_cmd.c"
+    "$awk" -f "$src/ipc/vipc.awk" "$src/ip/ip_read.c"
+    ;;
+  *) exit 1 ;;
+esac
