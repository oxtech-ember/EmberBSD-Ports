py-dbus does not build its Sphinx documentation.

configure enables the docs when the build Python can import sphinx. The
doc build then imports the built _dbus_bindings extension; in a cross
build that is a target library the build machine cannot load, so
doc/html/.stamp failed. The PLIST lists no documentation, so disable it.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/sysutils/py-dbus/Makefile
+++ b/sysutils/py-dbus/Makefile
@@ -16,6 +16,9 @@
 # configure runs this interpreter; in cross builds it is the build
 # machine Python, which reports the target settings (pyversion.mk).
 CONFIGURE_ARGS+=	PYTHON=${TOOL_PYTHONBIN}
+# The build Python may have Sphinx, and the doc build imports the built
+# extension, which cannot load in a cross build. The PLIST has no docs.
+CONFIGURE_ARGS+=	--disable-documentation
 
 PY_PATCHPLIST=			yes
 PYTHON_VERSIONS_INCOMPATIBLE=	27
