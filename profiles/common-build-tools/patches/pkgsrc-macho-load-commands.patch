-function checkshlib(DSO,	needed, found) {
+# Resolve only load commands owned by this image. Inherited runpaths need a
+# loader graph and deliberately remain errors rather than guessed providers.
+function normalize(path,    n, parts, out, j) {
+	n = split(path, parts, "/")
+	out = ""
+	for (j = 1; j <= n; j++) {
+		if (parts[j] == "" || parts[j] == ".") continue
+		if (parts[j] == "..") sub(/\/[^\/]*$/, "", out)
+		else out = out "/" parts[j]
+	}
+	return out == "" ? "/" : out
+}
+
+function exists(path) {
+	return system("test -f " shquote(path)) == 0
+}
+
+function expand(path, loader, executable) {
+	if (path == "@loader_path") return loader
+	if (path == "@executable_path" && executable != "") return executable
+	if (path ~ /^@loader_path\//)
+		return normalize(loader "/" substr(path, 14))
+	if (path ~ /^@executable_path\// && executable != "")
+		return normalize(executable "/" substr(path, 18))
+	if (path ~ /^\//) return normalize(path)
+	return ""
+}
+
+function present(path) {
+	if (destdir != "" && exists(destdir path)) return 1
+	if (cross_destdir != "") return exists(cross_destdir path)
+	return exists(path)
+}
+
+function compatible(path, arch,    provider) {
+	if (!present(path)) return 0
+	provider = path
+	if (destdir != "" && exists(destdir path)) provider = destdir path
+	else if (cross_destdir != "") provider = cross_destdir path
+	return system("lipo " shquote(provider) " -verify_arch " shquote(arch) " >/dev/null 2>&1") == 0
+}
+
+function checkshlib(DSO,    physical, kind, command, status, archline, archs, n, i) {
+	physical = DSO
+	if (physical !~ /^\//) physical = destdir prefix "/" physical
+	physical = normalize(physical)
+	if (!exists(physical)) { print DSO ": missing input image"; return }
+	command = "file -b " shquote(physical)
+	status = (command | getline kind)
+	close(command)
+	if (status <= 0) { print DSO ": cannot determine file type"; return }
+	if (kind !~ /Mach-O/) return
+	command = "lipo -archs " shquote(physical) " 2>/dev/null"
+	status = (command | getline archline)
+	if (close(command) != 0 || status <= 0) {
+		print DSO ": cannot read image architectures"
+		return
+	}
+	n = split(archline, archs, /[[:space:]]+/)
+	for (i = 1; i <= n; i++)
+		checkimage(DSO, physical, kind, archs[i])
+}
+
+function checkimage(DSO, physical, kind, arch,    runtime, loader, executable,
+	    command, line, status, name, nneeded, nrpaths, needed, rpaths,
+	    lib, resolved, candidate, provider, i, j) {
+
+	runtime = physical
+	if (destdir != "" && index(runtime, destdir "/") == 1)
+		runtime = substr(runtime, length(destdir) + 1)
+	loader = runtime
+	sub(/\/[^\/]*$/, "", loader)
+	if (kind ~ /executable/) executable = loader
+	command = "otool -arch " shquote(arch) " -l " shquote(physical) " 2>/dev/null"
+	while ((command | getline line) > 0) {
+		if (line ~ /^[[:space:]]*cmd /) {
+			sub(/^[[:space:]]*cmd /, "", line)
+			name = line
+		} else if (name == "LC_RPATH" && line ~ /^[[:space:]]*path /) {
+			sub(/^[[:space:]]*path /, "", line)
+			sub(/ \(offset [0-9]+\)$/, "", line)
+			rpaths[++nrpaths] = line
+		} else if (name ~ /^LC_(LOAD_DYLIB|LOAD_WEAK_DYLIB|REEXPORT_DYLIB|LOAD_UPWARD_DYLIB|LAZY_LOAD_DYLIB)$/ && line ~ /^[[:space:]]*name /) {
+			sub(/^[[:space:]]*name /, "", line)
+			sub(/ \(offset [0-9]+\)$/, "", line)
