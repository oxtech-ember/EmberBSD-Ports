--- a/mk/wrapper/scan
+++ b/mk/wrapper/scan
@@ -29,8 +29,20 @@
 #
 
 # Optional argument processing.
+scan_operand=no
 for arg do
+	if [ "$scan_operand" = yes ]; then
+		scan_operand=no
+		continue
+	fi
 	case $arg in
+	--)	break ;;
+	-o|-I|-L|-l|-D|-U|-x|-arch|-isystem|-idirafter|-iquote|-include|-imacros|\
+	-isysroot|--sysroot|-target|--target|-B|-MF|-MT|-MQ|-Xclang|-Xlinker|\
+	-Xpreprocessor|-Xassembler|-resource-dir|-gcc-toolchain|--gcc-toolchain|\
+	-stdlib++-isystem|-iframework|-F|-isystem-after|--dynamic-linker)
+		scan_operand=yes ;;
+	-c|-E|-S|-fsyntax-only|-M|-MM) append_link_args=no ;;
 	*)	;;
 	esac
 done
--- a/mk/wrapper/wrapper.sh
+++ b/mk/wrapper/wrapper.sh
@@ -94,12 +94,16 @@
 init_queue cmdbuf
 
 append_extra_args=yes
+append_link_args=yes
 . $scan
 
 case $append_extra_args in
 yes)
 	$debug_log $wrapperlog "    (wrapper.sh) append args: @_WRAP_EXTRA_ARGS@"
 	set -- "$@" @_WRAP_EXTRA_ARGS@
+	if [ "$append_link_args" = yes ]; then
+		set -- "$@" @_WRAP_EXTRA_LINK_ARGS@
+	fi
 	;;
 *)
 	;;
