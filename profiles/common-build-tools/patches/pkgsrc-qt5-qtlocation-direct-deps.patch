qt5-qtlocation links zlib and ICU directly and needs their runtime dependencies.

The mapboxgl geoservices plugin, built on Darwin and Linux, uses the system
zlib and ICU (QMAKE_USE_PRIVATE += zlib icu), but both came in only through
the qt5-qtbase buildlink file. The native package would record no direct
dependency and the strict Mach-O check would reject it. Include the zlib
and ICU buildlink files on the platforms that build the plugin.
Origin: EmberBSD (AI-assisted); upstream status: not submitted.

--- a/x11/qt5-qtlocation/Makefile
+++ b/x11/qt5-qtlocation/Makefile
@@ -25,5 +25,11 @@
 .endif
 
 .include "../../x11/qt5-qtdeclarative/buildlink3.mk"
+# The mapboxgl geoservices plugin (PLIST.Darwin, PLIST.Linux) links the
+# system zlib and ICU.
+.if ${OPSYS} == "Darwin" || ${OPSYS} == "Linux"
+.include "../../devel/zlib/buildlink3.mk"
+.include "../../textproc/icu/buildlink3.mk"
+.endif
 .include "../../x11/qt5-qtserialport/buildlink3.mk"
 .include "../../mk/bsd.pkg.mk"
