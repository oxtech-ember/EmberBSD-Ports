+// USB serial endpoints from the kernel's read-only drvctl inventory. The
+// device-instance-id property is required; names alone never identify a grant.
+class SerialDeviceEnumeratorNetBsd : public SerialDeviceEnumerator {
+ public:
+  SerialDeviceEnumeratorNetBsd();
+  ~SerialDeviceEnumeratorNetBsd() override;
+  scoped_refptr<SerialIoHandler> CreateIoHandler(
+      const base::FilePath& path,
+      scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner) override;
+
+ protected:
+  bool RefreshDevices() override;
+
+ private:
+  void Poll() { RefreshDevices(); }
+  struct Entry {
+    std::string device;
+    uint64_t instance;
+    uint64_t rdev;
+    base::UnguessableToken token;
+  };
+  std::map<base::FilePath, Entry> entries_;
+  bool refreshing_ = false;
+  base::RepeatingTimer timer_;
+};
