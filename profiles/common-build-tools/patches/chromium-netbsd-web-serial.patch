@@ -0,0 +1,278 @@
+// Copyright 2026 The EmberBSD Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "services/device/serial/serial_device_enumerator_netbsd.h"
+
+#include <fcntl.h>
+#include <sys/drvctlio.h>
+#include <sys/ioctl.h>
+#include <sys/stat.h>
+
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <optional>
+#include <set>
+#include <utility>
+#include <vector>
+
+#include "base/auto_reset.h"
+#include "base/files/scoped_file.h"
+#include "base/functional/bind.h"
+#include "base/posix/eintr_wrapper.h"
+#include "base/scoped_generic.h"
+#include "base/strings/string_number_conversions.h"
+#include "components/device_event_log/device_event_log.h"
+#include "services/device/serial/serial_io_handler_posix.h"
+
+namespace device {
+namespace {
+
+// NetBSD ucom tty minor ABI (sys/tty.h and etc/MAKEDEV.tmpl). The kernel
+// macros are not exported to userland; derive no device number from a path.
+constexpr uint32_t kUcomUnitMask = 0x3ffff;
+constexpr uint32_t kUcomDialoutMask = 0x80000;
+
+struct DictionaryTraits {
+  static prop_dictionary_t InvalidValue() { return nullptr; }
+  static void Free(prop_dictionary_t value) { prop_object_release(value); }
+};
+using Dictionary = base::ScopedGeneric<prop_dictionary_t, DictionaryTraits>;
+
+Dictionary Properties(int fd, const std::string& device) {
+  Dictionary request(prop_dictionary_create());
+  Dictionary arguments(prop_dictionary_create());
+  if (!request.is_valid() || !arguments.is_valid() ||
+      !prop_dictionary_set_string(request.get(), "drvctl-command", "get-properties") ||
+      !prop_dictionary_set_string(arguments.get(), "device-name", device.c_str()) ||
+      !prop_dictionary_set(request.get(), "drvctl-arguments", arguments.get())) {
+    return Dictionary();
+  }
+  prop_dictionary_t raw = nullptr;
+  const int error = prop_dictionary_sendrecv_ioctl(
+      request.get(), fd, DRVCTLCOMMAND, &raw);
+  Dictionary reply(raw);
+  int result = 0;
+  if (error || !reply.is_valid() ||
+      !prop_dictionary_get_int(reply.get(), "drvctl-error", &result) || result) {
+    return Dictionary();
+  }
+  auto data = prop_dictionary_get(reply.get(), "drvctl-result-data");
+  if (!data || prop_object_type(data) != PROP_TYPE_DICTIONARY) {
+    return Dictionary();
+  }
+  prop_object_retain(data);
+  return Dictionary(static_cast<prop_dictionary_t>(data));
+}
+
+std::string StringProperty(prop_dictionary_t properties, const char* key) {
+  const char* value = nullptr;
+  if (!prop_dictionary_get_string(properties, key, &value)) {
+    return {};
+  }
+  return value;
+}
+
+struct Port {
+  std::string device;
+  uint64_t instance;
+  uint64_t rdev;
+  mojom::SerialPortInfoPtr info;
+};
+
+// Query the kernel tree rather than the pre-created /dev entries. An error in
+// the traversal invalidates the complete snapshot; it is never a partial list.
+std::optional<std::vector<std::string>> Devices(int fd) {
+  constexpr size_t kMaxDevices = 4096;
+  std::vector<std::string> pending = {""};
+  std::set<std::string> seen;
+  for (size_t i = 0; i < pending.size(); ++i) {
+    struct devlistargs args = {};
+    if (pending[i].size() >= sizeof(args.l_devname)) {
+      return std::nullopt;
+    }
+    pending[i].copy(args.l_devname, pending[i].size());
+    if (ioctl(fd, DRVLISTDEV, &args) != 0 || args.l_children > kMaxDevices) {
+      return std::nullopt;
+    }
+    const size_t capacity = args.l_children;
+    if (!capacity) {
+      continue;
+    }
+    auto children = std::make_unique<char[][16]>(capacity);
+    args.l_childname = children.get();
+    if (ioctl(fd, DRVLISTDEV, &args) != 0 || args.l_children != capacity) {
+      return std::nullopt;
+    }
+    for (size_t j = 0; j < args.l_children; ++j) {
+      const size_t length = strnlen(children[j], sizeof(children[j]));
+      if (!length || length == sizeof(children[j]) ||
+          !seen.emplace(children[j], length).second || seen.size() > kMaxDevices) {
+        return std::nullopt;
+      }
+      pending.emplace_back(children[j], length);
+    }
+  }
+  return pending;
+}
+
+std::optional<Port> ReadPort(int fd, const std::string& device) {
+  Dictionary endpoint = Properties(fd, device);
+  uint64_t instance = 0;
+  uint32_t unit = 0;
+  if (!endpoint.is_valid() ||
+      StringProperty(endpoint.get(), "device-driver") != "ucom" ||
+      !prop_dictionary_get_uint64(endpoint.get(), "device-instance-id", &instance) ||
+      !instance || !prop_dictionary_get_uint32(endpoint.get(), "device-unit", &unit) ||
+      device != "ucom" + base::NumberToString(unit)) {
+    return std::nullopt;
+  }
+  auto info = mojom::SerialPortInfo::New();
+  info->path = base::FilePath("/dev/dtyU" + base::NumberToString(unit));
+  struct stat node = {};
+  const devmajor_t expected_major = getdevmajor("ucom", S_IFCHR);
+  if (unit > kUcomUnitMask || expected_major == static_cast<devmajor_t>(-1) ||
+      lstat(info->path.value().c_str(), &node) != 0 || !S_ISCHR(node.st_mode) ||
+      major(node.st_rdev) != expected_major ||
+      static_cast<uint64_t>(minor(node.st_rdev)) != (unit | kUcomDialoutMask)) {
+    return std::nullopt;
+  }
+  std::string parent = StringProperty(endpoint.get(), "device-parent");
+  std::set<std::string> ancestors;
+  while (!parent.empty() && ancestors.size() < 64 && ancestors.insert(parent).second) {
+    Dictionary properties = Properties(fd, parent);
+    if (!properties.is_valid()) {
+      return std::nullopt;
+    }
+    uint16_t vendor = 0, product = 0;
+    if (prop_dictionary_get_uint16(properties.get(), "vendor-id", &vendor) &&
+        prop_dictionary_get_uint16(properties.get(), "product-id", &product)) {
+      info->vendor_id = vendor;
+      info->has_vendor_id = true;
+      info->product_id = product;
+      info->has_product_id = true;
+      info->display_name = StringProperty(properties.get(), "product-string");
+      info->serial_number = StringProperty(properties.get(), "serialnumber");
+      info->connected = true;
+      // The ucom instance must still be the one whose parent we inspected.
+      Dictionary final = Properties(fd, device);
+      uint64_t current = 0;
+      if (!final.is_valid() ||
+          !prop_dictionary_get_uint64(final.get(), "device-instance-id", &current) ||
+          current != instance) {
+        return std::nullopt;
+      }
+      return Port{device, instance, static_cast<uint64_t>(node.st_rdev), std::move(info)};
+    }
+    parent = StringProperty(properties.get(), "device-parent");
+  }
+  return std::nullopt;
+}
+
+// Validate again after open, on the I/O sequence, before configuring or
+// exposing the port. ucom_detach revokes existing vnodes with vdevgone; an
+// already opened old instance cannot become a new device with the same minor.
+class SerialIoHandlerNetBsd final : public SerialIoHandlerPosix {
+ public:
+  SerialIoHandlerNetBsd(const base::FilePath& path,
+                       scoped_refptr<base::SingleThreadTaskRunner> runner,
+                       std::string device, uint64_t instance, uint64_t rdev)
+      : SerialIoHandlerPosix(path, std::move(runner)),
+        device_(std::move(device)), instance_(instance), rdev_(rdev) {}
+
+ private:
+  ~SerialIoHandlerNetBsd() override = default;
+  bool PostOpen() override {
+    struct stat opened = {};
+    base::ScopedFD fd(HANDLE_EINTR(open(DRVCTLDEV, O_RDONLY | O_CLOEXEC)));
+    if (!fd.is_valid() || fstat(file().GetPlatformFile(), &opened) != 0 ||
+        !S_ISCHR(opened.st_mode) || static_cast<uint64_t>(opened.st_rdev) != rdev_) {
+      return false;
+    }
+    Dictionary properties = Properties(fd.get(), device_);
+    uint64_t current = 0;
+    return properties.is_valid() &&
+           prop_dictionary_get_uint64(properties.get(), "device-instance-id", &current) &&
+           current == instance_ && SerialIoHandlerPosix::PostOpen();
+  }
+  const std::string device_;
+  const uint64_t instance_;
+  const uint64_t rdev_;
+};
+
+}  // namespace
+
+SerialDeviceEnumeratorNetBsd::SerialDeviceEnumeratorNetBsd() {
+  // drvctl's event FIFO is shared/destructive and requires write access.
+  // Read-only inventory polling leaves the system device monitor untouched.
+  timer_.Start(FROM_HERE, base::Seconds(1), this,
+               &SerialDeviceEnumeratorNetBsd::Poll);
+}
+
+SerialDeviceEnumeratorNetBsd::~SerialDeviceEnumeratorNetBsd() = default;
+
+bool SerialDeviceEnumeratorNetBsd::RefreshDevices() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (refreshing_) {
+    return false;
+  }
+  base::AutoReset<bool> guard(&refreshing_, true);
+  std::map<base::FilePath, Port> snapshot;
+  base::ScopedFD fd(HANDLE_EINTR(open(DRVCTLDEV, O_RDONLY | O_CLOEXEC)));
+  auto devices = fd.is_valid() ? Devices(fd.get()) : std::nullopt;
+  if (!devices) {
+    SERIAL_LOG(ERROR) << "Cannot obtain complete drvctl serial inventory";
+  } else {
+    for (const auto& device : *devices) {
+      if (!device.starts_with("ucom")) {
+        continue;
+      }
+      auto port = ReadPort(fd.get(), device);
+      if (!port) {
+        // A missing node/property or a raced detach invalidates this scan.
+        // Never retain grants from a partially inspected device inventory.
+        SERIAL_LOG(ERROR) << "Incomplete ucom inventory at " << device;
+        snapshot.clear();
+        break;
+      }
+      auto path = port->info->path;
+      snapshot.emplace(std::move(path), std::move(*port));
+    }
+  }
+  std::vector<base::FilePath> removed;
+  for (const auto& [path, entry] : entries_) {
+    const auto found = snapshot.find(path);
+    if (found == snapshot.end() || found->second.instance != entry.instance ||
+        found->second.rdev != entry.rdev) {
+      removed.push_back(path);
+    }
+  }
+  for (const auto& path : removed) {
+    const auto token = entries_.at(path).token;
+    entries_.erase(path);
+    RemovePort(token);
+  }
+  for (auto& [path, port] : snapshot) {
+    if (entries_.contains(path)) {
+      continue;
+    }
+    port.info->token = base::UnguessableToken::Create();
+    entries_.emplace(path, Entry{port.device, port.instance, port.rdev, port.info->token});
+    AddPort(std::move(port.info));
+  }
+  return true;
+}
+
+scoped_refptr<SerialIoHandler> SerialDeviceEnumeratorNetBsd::CreateIoHandler(
+    const base::FilePath& path,
+    scoped_refptr<base::SingleThreadTaskRunner> ui_task_runner) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  const auto found = entries_.find(path);
+  CHECK(found != entries_.end());
+  const auto& entry = found->second;
+  return new SerialIoHandlerNetBsd(path, std::move(ui_task_runner),
+                                 entry.device, entry.instance, entry.rdev);
+}
