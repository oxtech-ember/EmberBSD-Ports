$NetBSD$

Recognize the NetBSD/AArch64 cross target in system and host-platform checks.
Keep the unknown-host barrier. This matches the added configure cases; the
recipe continues using the shipped configure and inherited pkgsrc adaptations.

Origin: EmberBSD (AI-assisted), common macOS-to-EmberBSD Python build.
Not submitted or accepted upstream.

--- configure.ac.orig
+++ configure.ac
@@ -318,6 +318,9 @@
        # a lot of different things including 'define_xopen_source'
        # in the case statement below.
 	case "$host" in
+	aarch64-*-netbsd*)
+		ac_sys_system=NetBSD
+		;;
 	*-*-linux-android*)
 		ac_sys_system=Linux-android
 		;;
@@ -762,6 +765,9 @@
 AC_SUBST([_PYTHON_HOST_PLATFORM])
 if test "$cross_compiling" = yes; then
 	case "$host" in
+	aarch64-*-netbsd*)
+		_host_ident=$host_cpu
+		;;
 	*-*-linux*)
 		case "$host_cpu" in
 		arm*)
