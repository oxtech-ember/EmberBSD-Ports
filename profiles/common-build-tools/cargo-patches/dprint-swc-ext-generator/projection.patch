+import type { AstEnumDefinition, AstStructDefinition, TypeDefinition } from "./analysis_types.ts";
+
+// SWC 29 moved function blocks and accessor contents into distinct nodes.
+// Refuse to generate a view that silently drops them when its input JSON is stale.
+export function validateAstViewContract(structs: AstStructDefinition[], enums: AstEnumDefinition[]) {
+  function struct(name: string): AstStructDefinition {
+    const result = structs.find(s => s.name === name);
+    if (result == null) throw new Error(`Missing SWC view node ${name}`);
+    return result;
+  }
+  function hasType(type: TypeDefinition, expected: string): boolean {
+    return type.kind === "Reference"
+      && (type.name === expected || type.genericArgs.some(t => hasType(t, expected)));
+  }
+  function field(owner: string, name: string, type: string) {
+    const result = struct(owner).fields.find(f => f.innerName === name);
+    if (result == null || !hasType(result.type, type)) {
+      throw new Error(`Unexpected SWC view field ${owner}.${name}; expected ${type}`);
+    }
+  }
+  function parent(child: string, owner: string) {
+    if (!struct(child).parents.some(p => p.name === owner)) {
+      throw new Error(`Missing SWC view parent ${owner} for ${child}`);
+    }
+  }
+  field("FunctionBody", "stmts", "Stmt");
+  field("TsThisParam", "this_span", "Span");
+  field("TsThisParam", "type_ann", "TsTypeAnn");
+  field("Function", "this_param", "TsThisParam");
+  field("Function", "body", "FunctionBody");
+  field("Function", "params", "Param");
+  field("Function", "type_params", "TsTypeParamDecl");
+  field("Function", "return_type", "TsTypeAnn");
+  field("Constructor", "body", "FunctionBody");
+  field("ArrowExpr", "body", "ArrowFunctionBody");
+  for (const owner of ["GetterProp", "SetterProp"]) {
+    field(owner, "function.this_param", "TsThisParam");
+    field(owner, "function.params", "Param");
+    field(owner, "function.decorators", "Decorator");
+    field(owner, "function.type_params", "TsTypeParamDecl");
+    field(owner, "function.return_type", "TsTypeAnn");
+    field(owner, "function.body", "FunctionBody");
+    for (const name of ["is_async", "is_generator"]) {
+      const flag = struct(owner).fields.find(f => f.innerName === `function.${name}`);
+      if (flag?.type.kind !== "Primitive" || flag.type.text !== "bool") {
+        throw new Error(`Missing ${owner}.function.${name} flag`);
+      }
+    }
+  }
+  field("JSXText", "value", "Wtf8Atom");
+  field("JSXText", "raw", "Atom");
+  parent("TsThisParam", "Function");
+  parent("FunctionBody", "Function");
+  parent("FunctionBody", "Constructor");
+  parent("FunctionBody", "ArrowExpr");
+  parent("TsThisParam", "GetterProp");
+  parent("TsThisParam", "SetterProp");
+  parent("FunctionBody", "GetterProp");
+  parent("FunctionBody", "SetterProp");
+  const arrow = enums.find(e => e.name === "ArrowFunctionBody");
+  if (arrow == null || !arrow.variants.some(v => v.name === "FunctionBody" && v.tupleArg.name === "FunctionBody")
+    || !arrow.variants.some(v => v.name === "Expr" && v.tupleArg.name === "Expr")) {
+    throw new Error("Unexpected SWC ArrowFunctionBody variants");
+  }
+}
