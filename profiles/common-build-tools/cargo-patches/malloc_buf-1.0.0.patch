+#[cfg(test)]
+mod alignment_regression {
+    use super::Malloc;
+    use core::{mem, ptr};
+    use std::rc::Rc;
+    #[repr(align(64))] struct Aligned(u8);
+    #[test] fn null_empty_is_aligned_and_nonowned() {
+        let empty = unsafe { Malloc::<[Aligned]>::from_array(ptr::null_mut(), 0) };
+        assert_eq!(empty.as_ptr() as usize % mem::align_of::<Aligned>(), 0);
+        assert!(!empty.owned); assert!(empty.is_empty()); drop(empty);
+    }
+    #[test] fn nonnull_empty_keeps_ownership() {
+        let ptr = unsafe { libc::malloc(mem::size_of::<u64>()) as *mut u64 }; assert!(!ptr.is_null());
+        let empty = unsafe { Malloc::<[u64]>::from_array(ptr, 0) };
+        assert!(empty.owned); drop(empty);
+    }
+    #[test] fn nonempty_drops_elements() {
+        let value=Rc::new(7); let ptr=unsafe { libc::malloc(mem::size_of::<Rc<i32>>()) as *mut Rc<i32> }; assert!(!ptr.is_null());
+        unsafe { ptr::write(ptr,value.clone()); }
+        let buf=unsafe { Malloc::from_array(ptr,1) }; assert_eq!(Rc::strong_count(&value),2);
+        drop(buf); assert_eq!(Rc::strong_count(&value),1);
+    }
+}
