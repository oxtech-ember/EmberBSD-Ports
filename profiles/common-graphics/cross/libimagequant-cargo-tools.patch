# Origin: EmberBSD (AI-assisted). Build libimagequant with the selected
# build-host and target Cargo tools; build scripts link for the build host.

--- a/graphics/libimagequant/Makefile
+++ b/graphics/libimagequant/Makefile
@@ -1,6 +1,11 @@
 # $NetBSD: Makefile,v 1.42 2025/11/16 08:43:40 adam Exp $
 
 DISTNAME=	libimagequant-4.4.1
+.include "../../mk/bsd.prefs.mk"
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD" && \
+    (!empty(EMBER_LLVM_CXX_STAGE:U) || !empty(EMBER_LLVM_CXX_SYSROOT:U))
+PKGREVISION=	1
+.endif
 CATEGORIES=	graphics
 MASTER_SITES+=	${MASTER_SITE_GITHUB:=ImageOptim/}
 GITHUB_TAG=	${PKGVERSION_NOREV}
@@ -19,8 +24,13 @@
 
 .include "cargo-depends.mk"
 
+# cargo-c builds again in do-install. Cargo does not pass its --config to
+# an external subcommand, and cargo-c names the library for the --target
+# triple only, so give cargo-c the selected host and target tools itself.
 do-install:
-	cd ${WRKSRC} && ${RUN} cargo cinstall --destdir=${DESTDIR} --prefix=${PREFIX} --libdir=${PREFIX}/lib
+	${RUN} cd ${WRKSRC} && ${SETENV} ${MAKE_ENV} ${CARGO} cinstall \
+	    --config ${EMBER_CARGO_CONFIG:Q} ${EMBER_CARGO_TARGET:@t@--target=${t}@} \
+	    --destdir=${DESTDIR} --prefix=${PREFIX} --libdir=${PREFIX}/lib
 
-.include "../../lang/rust/cargo.mk"
+.include "../../lang/rust/emberbsd-cargo.mk"
 .include "../../mk/bsd.pkg.mk"
