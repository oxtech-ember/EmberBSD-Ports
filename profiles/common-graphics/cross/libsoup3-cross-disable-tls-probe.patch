--- a/net/libsoup3/Makefile
+++ b/net/libsoup3/Makefile
@@ -1,8 +1,9 @@
 # $NetBSD: Makefile,v 1.28 2026/09/02 19:03:59 wiz Exp $
+.include "../../mk/bsd.prefs.mk"
 
 DISTNAME=	libsoup-3.6.6
 PKGNAME=	${DISTNAME:S/soup/soup3/}
-PKGREVISION=	2
+PKGREVISION=	3
 CATEGORIES=	net gnome
 MASTER_SITES=	${MASTER_SITE_GNOME:=sources/libsoup/${PKGVERSION_NOREV:R}/}
 EXTRACT_SUFX=	.tar.xz
@@ -12,7 +13,9 @@
 COMMENT=	HTTP library implementation in C (major version 3)
 LICENSE=	gnu-lgpl-v2
 
+.if ${USE_CROSS_COMPILE:Uno:tl} != "yes"
 TOOL_DEPENDS+=	glib2-introspection-[0-9]*:../../devel/glib2-introspection
+.endif
 DEPENDS+=	glib-networking-[0-9]*:../../net/glib-networking
 # not found by meson
 #TOOL_DEPENDS+=	${PYPKGPREFIX}-gi-docgen-[0-9]*:../../devel/py-gi-docgen
@@ -22,6 +25,25 @@
 USE_CC_FEATURES=	c99
 USE_LANGUAGES=		c
 USE_TOOLS+=		msgfmt pkg-config
+
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+# Native generators inspect the target ABI through the shared GI query path.
+DEPENDS+= glib2-introspection>=2.90.1nb1:../../devel/glib2-introspection
+EMBERBSD_GI_MESON_OPTIONS= no
+.include "../../devel/gobject-introspection/cross.mk"
+MAKE_ENV+= XDG_DATA_DIRS=${CROSS_DESTDIR:Q}${CROSS_LOCALBASE:Q}/share
+_EMBERBSD_GI_REAL_SYSROOT!= cd ${CROSS_DESTDIR:Q} && pwd -P
+BUILDLINK_TRANSFORM+= I:${_EMBERBSD_GI_REAL_SYSROOT}${CROSS_LOCALBASE}:${BUILDLINK_DIR}
+MESON_ARGS+= -Dintrospection=enabled -Dtests=false -Dtls_check=false
+TOOL_DEPENDS+= glib2-tools>=0:../../devel/glib2-tools
+MESON_BINARIES+= glib-mkenums g-ir-scanner g-ir-compiler
+MESON_BINARY.glib-mkenums= ${TOOLBASE}/bin/glib-mkenums
+MESON_BINARY.g-ir-scanner= ${TOOLBASE}/bin/g-ir-scanner
+MESON_BINARY.g-ir-compiler= ${TOOLBASE}/bin/g-ir-compiler
+MESON_CROSS_VARS+= emberbsd_gi_cross emberbsd_gi_ldd_wrapper
+MESON_CROSS.emberbsd_gi_cross= true
+MESON_CROSS.emberbsd_gi_ldd_wrapper= '${EMBERBSD_GI_FILESDIR}/elf-needed.sh'
+.endif
 
 PKGCONFIG_OVERRIDE+=		output/meson-private/libsoup-3.0.pc
 PKGCONFIG_OVERRIDE_STAGE=	pre-install
