--- a/www/libproxy/Makefile
+++ b/www/libproxy/Makefile
@@ -1,4 +1,5 @@
 # $NetBSD: Makefile,v 1.73 2026/09/02 19:04:59 wiz Exp $
+.include "../../mk/bsd.prefs.mk"
 
 DISTNAME=	libproxy-0.5.12
 PKGREVISION=	4
@@ -11,7 +12,9 @@
 COMMENT=	Library that provides automatic proxy configuration management
 LICENSE=	gnu-lgpl-v2.1
 
+.if ${USE_CROSS_COMPILE:Uno:tl} != "yes"
 TOOL_DEPENDS+=	glib2-introspection-[0-9]*:../../devel/glib2-introspection
+.endif
 
 USE_CC_FEATURES=	c99
 USE_CXX_FEATURES=	c++11
@@ -20,6 +23,16 @@
 
 PKGCONFIG_OVERRIDE+=		output/meson-private/libproxy-1.0.pc
 PKGCONFIG_OVERRIDE_STAGE=	post-configure
+
+PLIST_VARS+=	docs introspection vapi
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+# Consumers need the C API, not optional GIR or documentation.
+MESON_ARGS+=	-Ddocs=false -Dintrospection=false -Dvapi=false -Dtests=false
+.else
+PLIST.docs=	yes
+PLIST.introspection=	yes
+PLIST.vapi=	yes
+.endif
 
 # For Darwin
 TEST_ENV+=	DYLD_LIBRARY_PATH=${WRKSRC}/output/src/backend:${WRKSRC}/output/src/libproxy
@@ -35,12 +48,16 @@
 
 .include "../../devel/meson/build.mk"
 .include "../../devel/glib2/buildlink3.mk"
+.if ${USE_CROSS_COMPILE:Uno:tl} != "yes"
 .include "../../devel/gobject-introspection/buildlink3.mk"
