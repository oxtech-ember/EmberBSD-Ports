+struct SharedPoolBaseAllocator : CrtAllocator {
+    static unsigned live;
+    SharedPoolBaseAllocator() { ++live; }
+    ~SharedPoolBaseAllocator() { --live; }
+};
+
+unsigned SharedPoolBaseAllocator::live = 0;
+
+TEST(Allocator, SharedBufferOwner) {
+    char buffer[256];
+    {
+        MemoryPoolAllocator<SharedPoolBaseAllocator> pool(buffer, sizeof(buffer), 128);
+        {
+            MemoryPoolAllocator<SharedPoolBaseAllocator> copy(pool);
+            EXPECT_TRUE(copy.Malloc(4096) != 0);
+            EXPECT_EQ(1u, SharedPoolBaseAllocator::live);
+        }
+        pool.Clear();
+        EXPECT_TRUE(pool.Malloc(4096) != 0);
+        EXPECT_EQ(1u, SharedPoolBaseAllocator::live);
+    }
+    EXPECT_EQ(0u, SharedPoolBaseAllocator::live);
+}
