+TEST(Pointer, AppendUserSuppliedTokens) {
+    const Pointer::Token tokens[] = { { "foo suffix", 3, kPointerInvalidIndex }, { "0 suffix", 1, 0 } };
+    Pointer p(tokens, sizeof(tokens) / sizeof(tokens[0]));
+    Pointer q = p.Append("tail");
+    EXPECT_TRUE(Pointer("/foo/0/tail") == q);
+    EXPECT_NE(tokens[0].name, q.GetTokens()[0].name);
+    EXPECT_EQ('\0', q.GetTokens()[0].name[3]);
+    EXPECT_EQ('\0', q.GetTokens()[1].name[1]);
+    q = q.Append("");
+    EXPECT_TRUE(Pointer("/foo/0/tail/") == q);
+    EXPECT_TRUE(Pointer("/foo/0") == p);
+}
