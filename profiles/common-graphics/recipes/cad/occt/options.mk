# $NetBSD$
PKG_OPTIONS_VAR=	PKG_OPTIONS.occt
PKG_SUPPORTED_OPTIONS=	x11 occt-draw
PKG_SUGGESTED_OPTIONS=	occt-draw
.if ${OPSYS} != "Darwin"
PKG_SUGGESTED_OPTIONS+=	x11
.endif
.include "../../mk/bsd.options.mk"
PLIST_VARS+= draw

.if !empty(PKG_OPTIONS:Mx11)
.include "../../graphics/MesaLib/buildlink3.mk"
.include "../../x11/libX11/buildlink3.mk"
CMAKE_CONFIGURE_ARGS+=	-DUSE_XLIB=ON
.else
.if ${OPSYS} != "Darwin"
.include "../../graphics/MesaLib/buildlink3.mk"
.endif
CMAKE_CONFIGURE_ARGS+=	-DUSE_XLIB=OFF
.endif

.if !empty(PKG_OPTIONS:Mocct-draw)
PLIST.draw= yes
BUILDLINK_API_DEPENDS.tcl+=	tcl>=9.1.0nb1
.include "../../lang/tcl/buildlink3.mk"
BUILDLINK_API_DEPENDS.tk+=	tk>=9.1.0
.include "../../x11/tk/buildlink3.mk"
CMAKE_CONFIGURE_ARGS+=	-DBUILD_MODULE_Draw=ON -DUSE_TK=ON
CMAKE_CONFIGURE_ARGS+=	-D3RDPARTY_TCL_DIR=${BUILDLINK_DIR}
CMAKE_CONFIGURE_ARGS+=	-D3RDPARTY_TK_DIR=${BUILDLINK_DIR}
CMAKE_CONFIGURE_ARGS+=	-D3RDPARTY_TCL_INCLUDE_DIR=${BUILDLINK_DIR}/include
CMAKE_CONFIGURE_ARGS+=	-D3RDPARTY_TCL_LIBRARY_DIR=${BUILDLINK_DIR}/lib
CMAKE_CONFIGURE_ARGS+=	-D3RDPARTY_TK_INCLUDE_DIR=${BUILDLINK_DIR}/include
CMAKE_CONFIGURE_ARGS+=	-D3RDPARTY_TK_LIBRARY_DIR=${BUILDLINK_DIR}/lib
.else
CMAKE_CONFIGURE_ARGS+=	-DBUILD_MODULE_Draw=OFF -DUSE_TK=OFF
.endif
