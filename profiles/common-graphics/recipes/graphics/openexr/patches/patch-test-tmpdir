 #    define IMF_PATH_SEPARATOR "/"
 #endif
+
+// Keep test files in the caller's writable temporary directory.
+inline std::string
+imf_test_temp_dir ()
+{
+    const char* selected = std::getenv ("TMPDIR");
+    std::string path = selected && *selected ? selected : IMF_TMP_DIR;
+    if (!path.empty () && path.back () != IMF_PATH_SEPARATOR[0])
+        path += IMF_PATH_SEPARATOR;
+    return path;
+}
