# Origin: EmberBSD, maintained FreeImage source shared by the C and C++ APIs.
# used by graphics/freeimage/Makefile
# used by graphics/freeimageplus/Makefile

DISTNAME=	FreeImage-3.19.25-linux-source
CATEGORIES=	graphics
MASTER_SITES=	https://github.com/danoli3/FreeImage/releases/download/3.19.25/

HOMEPAGE=	https://github.com/danoli3/FreeImage
# The original FreeImage Public License is also shipped verbatim.
LICENSE=	gnu-gpl-v2 OR gnu-gpl-v3

WRKSRC=		${WRKDIR}/FreeImage-3.19.25
PATCHDIR=	${.CURDIR}/../../graphics/freeimage/patches
DISTINFO_FILE=	${.CURDIR}/../../graphics/freeimage/distinfo

USE_LANGUAGES=		c c++
USE_CXX_FEATURES=	c++17
USE_TOOLS+=		pkg-config

# Keep pkgsrc patch input independent of the upstream CRLF source file.
SUBST_CLASSES+=		cr
SUBST_STAGE.cr=		post-extract
SUBST_FILES.cr=		Source/FreeImage/PluginTIFF.cpp
SUBST_FILTER_CMD.cr=	${SETENV} LC_ALL=C ${TR} -d '\r'
SUBST_NOOP_OK.cr=	yes

# pkgsrc disables ELF build RPATHs. Tests must load the library just built.
.include "../../mk/bsd.prefs.mk"
_FREEIMAGE_TEST_PATH=	${WRKSRC}/${CMAKE_BUILD_DIR}:${PREFIX}/lib
.if ${OPSYS} == "Darwin"
.  if defined(DYLD_LIBRARY_PATH) && !empty(DYLD_LIBRARY_PATH)
_FREEIMAGE_TEST_PATH+=	${DYLD_LIBRARY_PATH}
.  endif
TEST_ENV+=	DYLD_LIBRARY_PATH=${_FREEIMAGE_TEST_PATH:ts:}
.else
.  if defined(LD_LIBRARY_PATH) && !empty(LD_LIBRARY_PATH)
_FREEIMAGE_TEST_PATH+=	${LD_LIBRARY_PATH}
.  endif
TEST_ENV+=	LD_LIBRARY_PATH=${_FREEIMAGE_TEST_PATH:ts:}
.endif
