+/* Platform leaves do not require a primary open or a DRM master. */
+static int
+drmNativePlatformIdentity(int maj, int min, struct drm_native_platform_record *r)
+{
+    char name[64];
+    size_t len = sizeof(*r);
+
+    if (maj < 0 || min < 0)
+        return -ENODEV;
+    snprintf(name, sizeof(name), "hw.drm2.platform%d", min);
+    if (sysctlbyname(name, r, &len, NULL, 0))
+        return -errno;
+    if (len != sizeof(*r) || r->length != sizeof(*r) ||
+        r->version != DRM_NATIVE_PLATFORM_VERSION ||
+        r->bus_type != DRM_NATIVE_BUS_PLATFORM ||
+        (r->flags & ~(DRM_NATIVE_PRIMARY | DRM_NATIVE_RENDER)) ||
+        !(r->flags & DRM_NATIVE_PRIMARY) || r->primary_minor >= 64 ||
+        ((r->flags & DRM_NATIVE_RENDER) &&
+         (r->render_minor < 128 || r->render_minor >= 192)) ||
+        !r->fullname[0] || !r->compatible[0] ||
+        !memchr(r->fullname, 0, sizeof(r->fullname)) ||
+        !memchr(r->compatible, 0, sizeof(r->compatible)))
+        return -EPROTO;
+    if (r->primary_major == (uint32_t)maj && r->primary_minor == (uint32_t)min)
+        return DRM_NODE_PRIMARY;
+    if ((r->flags & DRM_NATIVE_RENDER) &&
+        r->render_major == (uint32_t)maj && r->render_minor == (uint32_t)min)
+        return DRM_NODE_RENDER;
+    return -ENODEV;
+}
+
+/* Reuse the internal node-path carrier; PCI fields are never exposed for a
+ * platform device. The two public sysctl schemas remain distinct. */
+static int
+drmNativeNodeIdentity(int maj, int min, struct drm_native_pci_record *r)
+{
+    struct drm_native_platform_record platform;
+    int ret = drmNativeIdentity(maj, min, r);
+
+    if (ret != -ENOENT)
+        return ret;
+    ret = drmNativePlatformIdentity(maj, min, &platform);
+    if (ret < 0)
+        return ret;
+    memset(r, 0, sizeof(*r));
+    r->bus_type = DRM_NATIVE_BUS_PLATFORM;
+    r->flags = platform.flags;
+    r->primary_major = platform.primary_major;
+    r->primary_minor = platform.primary_minor;
+    r->render_major = platform.render_major;
+    r->render_minor = platform.render_minor;
+    return ret;
+}
