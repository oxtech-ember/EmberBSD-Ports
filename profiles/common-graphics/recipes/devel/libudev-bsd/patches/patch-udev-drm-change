Origin: EmberBSD, AI-assisted. Local patch; not submitted upstream.

Forward native DRM card changes through the existing ndevd packet format.
Validate packet bounds and expose the DRM minor type used by KWin.

--- udev-dev.c.orig
+++ udev-dev.c
@@ -525,8 +525,18 @@
 		action = UD_ACTION_ADD;
 	else if (strcmp(msg.event, NDEVD_DETACH_EVENT) == 0)
 		action = UD_ACTION_REMOVE;
-	else
-        return (UD_ACTION_NONE);
+	else if (strcmp(msg.event, "device-change") == 0) {
+		const char *unit;
+
+		/* Native DRM changes name the registered primary node. */
+		if (strncmp(msg.device, "dri/card", 8) != 0)
+			return (UD_ACTION_NONE);
+		unit = msg.device + 8;
+		if (*unit == '\0' || unit[strspn(unit, "0123456789")] != '\0')
+			return (UD_ACTION_NONE);
+		action = UD_ACTION_HOTPLUG;
+	} else
+		return (UD_ACTION_NONE);
 
 	strlcpy(syspath, get_syspath_by_devpath(devpath), syspathlen);
 
