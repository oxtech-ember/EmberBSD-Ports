+    AC_DEFINE_UNQUOTED(DARWIN_LLVM_SDK_VERSION,
+      ["$with_darwin_sdk_version"],
+      [Define the SDK version used by the Darwin LLVM linker.])
+    gcc_darwin_mc_flags="--filetype=obj --triple=arm64-apple-macosx --mcpu=apple-m1"
+    AC_DEFINE(DARWIN_LLVM_MC, 1,
+      [Define to use the LLVM MC command language on AArch64 Darwin.])
+    ;;
