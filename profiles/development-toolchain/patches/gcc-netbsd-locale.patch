++#if !defined(__NetBSD__)
+     char* __old = std::setlocale(LC_NUMERIC, 0);
+     char* __sav = 0;
+     if (__builtin_strcmp(__old, "C"))
+@@ -67,10 +81,15 @@
+ 	std::setlocale(LC_NUMERIC, "C");
+       }
+ 
++#endif
+     __builtin_va_list __args;
+     __builtin_va_start(__args, __fmt);
+ 
+-#if _GLIBCXX_USE_C99_STDIO && !_GLIBCXX_HAVE_BROKEN_VSNPRINTF
++#if defined(__NetBSD__)
++    // LC_C_LOCALE's public object is immutable and needs no allocation/free.
++    const int __ret = ::vsnprintf_l(__out, __size,
++        const_cast<struct _locale*>(&_lc_C_locale), __fmt, __args);
++#elif _GLIBCXX_USE_C99_STDIO && !_GLIBCXX_HAVE_BROKEN_VSNPRINTF
+     const int __ret = __builtin_vsnprintf(__out, __size, __fmt, __args);
+ #else
