++#if defined(__NetBSD__)
++#include <cstddef>
++// These are existing NetBSD libc interfaces.  Declare their exact ABI here
++// as well because feature-test macros can hide the NetBSD C locale constant
++// (or the locale_t typedef) from an otherwise valid ISO C++ application.
++extern "C"
++{
++  struct _locale;
++  extern const struct _locale _lc_C_locale;
++  int vsnprintf_l(char*, size_t, struct _locale*, const char*, __builtin_va_list);
++}
++#endif
++
