Origin: EmberBSD (AI-assisted); not submitted upstream.
Build native GCC16 on macOS AArch64 from the common lang/gcc16 recipe.
Apply Iain Sandoe's Darwin port. Require an accepted SDK GCC16 seed and
explicit LLVM MC, Mach-O LLD, dsymutil, lipo, c++filt and archive tools,
and keep libtool off the unimplemented ld64.lld -r route.
Keep the full GCC bootstrap. Clang cannot build stage 1. All producers
share the source diff.
See profiles/development-toolchain/gcc-darwin-host.md.

--- a/lang/gcc16/Makefile.common
+++ b/lang/gcc16/Makefile.common
@@ -57,6 +57,76 @@
 .if ${OPSYS} == "Darwin"
-BUILDLINK_TRANSFORM+=	rm:-nodefaultrpaths
+.if ${EMBERBSD_DARWIN_BOOTSTRAP:Uno} != "yes"
+BUILDLINK_TRANSFORM+=	rm:-nodefaultrpaths
+.endif
 CONFIGURE_ARGS+=	--disable-darwin-at-rpath
+# The SDK producer validates and pins these inputs before pkgsrc metadata.
+# The seed is a bootstrap input. It is not an ordinary native toolset.
+.if ${PKGSRC_COMPILER} != "gcc"
+PKG_FAIL_REASON+= "Darwin GCC16 bootstrap requires PKGSRC_COMPILER=gcc."
+.endif
+.for _ember_gcc16_input in EMBERBSD_GCC16_SEED_CC EMBERBSD_GCC16_SEED_CXX EMBERBSD_GCC16_SEED_CPP EMBERBSD_GCC16_LLVM_MC EMBERBSD_GCC16_LD64_LLD EMBERBSD_GCC16_DSYMUTIL EMBERBSD_GCC16_AR EMBERBSD_GCC16_RANLIB EMBERBSD_GCC16_NM EMBERBSD_GCC16_STRIP OSX_SDK_PATH
+.  if !defined(${_ember_gcc16_input}) || empty(${_ember_gcc16_input}:M/*)
+PKG_FAIL_REASON+= "Set ${_ember_gcc16_input} from the accepted SDK bootstrap producer plan."
+.  endif
+.endfor
+.if !defined(EMBERBSD_GCC16_DARWIN_SDK_VERSION) || empty(EMBERBSD_GCC16_DARWIN_SDK_VERSION)
+PKG_FAIL_REASON+= "Set EMBERBSD_GCC16_DARWIN_SDK_VERSION from the accepted SDK ABI metadata."
+.endif
+# The seed compiler keeps its own accepted build-tool routes.
+# Installed GCC needs the common source-built Mach-O tools at runtime.
+DEPENDS+= lld>=23.1.4:../../devel/lld
+USE_NATIVE_GCC= yes
+USE_PKGSRC_GCC= no
+CC= ${EMBERBSD_GCC16_SEED_CC}
+CXX= ${EMBERBSD_GCC16_SEED_CXX}
+CPP= ${EMBERBSD_GCC16_SEED_CPP}
+AR= ${EMBERBSD_GCC16_AR}
+RANLIB= ${EMBERBSD_GCC16_RANLIB}
+NM= ${EMBERBSD_GCC16_NM}
+STRIP= ${EMBERBSD_GCC16_STRIP}
+CONFIGURE_ENV+= CC=${EMBERBSD_GCC16_SEED_CC:Q} CXX=${EMBERBSD_GCC16_SEED_CXX:Q} CPP=${EMBERBSD_GCC16_SEED_CPP:Q}
+CONFIGURE_ENV+= AR=${AR:Q} RANLIB=${RANLIB:Q} NM=${NM:Q} STRIP=${STRIP:Q}
+CONFIGURE_ENV+= GCC_COMPARE_DEBUG_STRIP=${STRIP:Q}
+MAKE_ENV+= GCC_COMPARE_DEBUG_STRIP=${STRIP:Q}
+CONFIGURE_ENV+= GCC_COMPARE_DEBUG_OBJDUMP=${LOCALBASE:Q}/bin/llvm-objdump
+CONFIGURE_ENV+= GCC_COMPARE_DEBUG_OBJCOPY=${LOCALBASE:Q}/bin/llvm-objcopy
+MAKE_ENV+= GCC_COMPARE_DEBUG_OBJDUMP=${LOCALBASE:Q}/bin/llvm-objdump
+MAKE_ENV+= GCC_COMPARE_DEBUG_OBJCOPY=${LOCALBASE:Q}/bin/llvm-objcopy
+CONFIGURE_ENV+= AS_FOR_TARGET=${LOCALBASE:Q}/bin/llvm-mc
+CONFIGURE_ENV+= LD_FOR_TARGET=${LOCALBASE:Q}/bin/ld64.lld
+CONFIGURE_ENV+= AR_FOR_TARGET=${AR:Q} RANLIB_FOR_TARGET=${RANLIB:Q}
+CONFIGURE_ENV+= NM_FOR_TARGET=${NM:Q} STRIP_FOR_TARGET=${STRIP:Q}
+CONFIGURE_ENV+= DSYMUTIL_FOR_TARGET=${LOCALBASE:Q}/bin/dsymutil
+CONFIGURE_ENV+= LIPO_FOR_TARGET=${LOCALBASE:Q}/bin/llvm-lipo
+# libstdc++ scripts/make_exports.pl runs a bare "c++filt -_" on Darwin.
+TOOLS_CREATE+= c++filt
+TOOLS_PATH.c++filt= ${LOCALBASE}/bin/llvm-cxxfilt
+# ld64.lld warns that -single_module is obsolete, so libtool would choose
+# its "ld -r" master object, which ld64.lld does not implement.
+MAKE_ENV+= lt_cv_apple_cc_single_mod=yes
+# The SDK validates this optional control-plane resource command.
+.if defined(EMBERBSD_GCC16_LINKER_LAUNCHER) && !empty(EMBERBSD_GCC16_LINKER_LAUNCHER)
+MAKE_ENV+= GCC_HOST_LINKER_LAUNCHER=${EMBERBSD_GCC16_LINKER_LAUNCHER:Q}
+.endif
+CONFIGURE_ARGS+= --without-gnu-as --without-gnu-ld
+CONFIGURE_ARGS+= --with-as=${LOCALBASE:Q}/bin/llvm-mc
+CONFIGURE_ARGS+= --with-ld=${LOCALBASE:Q}/bin/ld64.lld
+CONFIGURE_ARGS+= --with-dsymutil=${LOCALBASE:Q}/bin/dsymutil
+CONFIGURE_ARGS+= --with-darwin-assembler=llvm-mc
+CONFIGURE_ARGS+= --with-darwin-sdk-version=${EMBERBSD_GCC16_DARWIN_SDK_VERSION:Q}
+.endif
+# The common LLVM-MC source patch requires the Darwin port on all hosts.
+# Upstream GCC does not support aarch64-apple-darwin. This diff is
+# Iain Sandoe's Darwin branch (https://github.com/iains/gcc-16-branch)
+# against the release, as published by homebrew-core commit
+# 4a334d2f90f786c3fc86cbc9cf72b2f13961b078 ("gcc 16.2.0").
+# SHA256 578a78ae0bc62a02f260b6a20c7f23e71deee16ed644e9cb5619247be4df5a71.
+# It is GCC source under the GCC license (GPLv3+ with the GCC Runtime
+# Library Exception). It also adds libgcobol support for Darwin, which
+# conflicts with patch-libgcobol_configure.tgt and is not used here.
+PATCHFILES+=		gcc-16.2.0.diff
+PATCH_SITES=		https://raw.githubusercontent.com/Homebrew/homebrew-core/4a334d2f90f786c3fc86cbc9cf72b2f13961b078/Patches/gcc/
+PATCH_DIST_STRIP=	-p1
+PATCH_DIST_CAT.gcc-16.2.0.diff=	${AWK} '/^diff --git / { skip = ($$3 == "a/libgcobol/configure.tgt") } !skip' gcc-16.2.0.diff
-.endif
 
