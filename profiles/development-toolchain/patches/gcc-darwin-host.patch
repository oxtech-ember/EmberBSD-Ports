+# The explicit Darwin gate above rejects Clang before the build.
+.if (!empty(PKGSRC_COMPILER:Mclang) && ${OPSYS} != "Darwin") \
+    || ${OPSYS} == "DragonFly" || ${OPSYS} == "NetBSD"
