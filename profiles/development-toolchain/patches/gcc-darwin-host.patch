--- a/lang/gcc16/Makefile
+++ b/lang/gcc16/Makefile
@@ -7,1 +7,1 @@
-PKGREVISION=	5
+PKGREVISION=	8
@@ -19,6 +19,19 @@
 
 ## The Library rpath to use in end programs.
 LDFLAGS_FOR_TARGET=	${LDFLAGS:M${COMPILER_RPATH_FLAG}*:N*/usr/lib*} ${LDFLAGS:M-Wl,-z*}
+.if ${OPSYS} == "Darwin"
+# COMPILER_RPATH_FLAG is -L on Darwin, so the filter above keeps the
+# -L${LOCALBASE}/lib search path. BOOT_LDFLAGS keeps it for the compilers.
+# libstdc++ selected a GNU libiconv found there for the target libraries.
+# The Darwin target libraries use the system libraries only.
+GCC16_TARGET_LDFLAGS=	${LDFLAGS:M-Wl,-z*}
+# CFLAGS can name ${LOCALBASE}/include, whose GNU iconv.h renames iconv_open.
+# Keep the -g that configure adds to its default target flags.
+CONFIGURE_ENV+=	CFLAGS_FOR_TARGET=-g\ ${CFLAGS:N-I${LOCALBASE}*:N-I${BUILDLINK_DIR}*:Q}
+CONFIGURE_ENV+=	CXXFLAGS_FOR_TARGET=-g\ ${CXXFLAGS:N-I${LOCALBASE}*:N-I${BUILDLINK_DIR}*:Q}
+.else
+GCC16_TARGET_LDFLAGS=	${LDFLAGS_FOR_TARGET}
+.endif
 
 # The "-static-libstdc++ -static-libgcc" flags are normally added to the
 # boot-ldflags by configure but because we are supply the boot-ldflags
@@ -55,3 +68,3 @@
 ## For target librarys and libjava programs.
-CONFIGURE_ENV+=		LDFLAGS_FOR_TARGET=${LDFLAGS_FOR_TARGET:Q}
+CONFIGURE_ENV+=		LDFLAGS_FOR_TARGET=${GCC16_TARGET_LDFLAGS:Q}
 
