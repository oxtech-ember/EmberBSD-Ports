Origin: EmberBSD (AI-assisted); not submitted upstream.
Bind scoped Darwin bootstrap inputs before pkgsrc host and tool discovery.
Keep ordinary Darwin defaults. Use the standard compiler wrappers.

--- a/mk/bsd.prefs.mk
+++ b/mk/bsd.prefs.mk
@@ -46,6 +46,21 @@
 # Let mk.conf know that this is pkgsrc.
 BSD_PKG_MK=1
 __PREFIX_SET__:=${PREFIX}
+
+# A scoped Darwin producer loads accepted inputs before host discovery.
+# The SDK pins MAKECONF and validates its facts, tools and source profile.
+.if defined(EMBERBSD_DARWIN_BOOTSTRAP)
+.  if ${EMBERBSD_DARWIN_BOOTSTRAP} != "yes"
+.error "EMBERBSD_DARWIN_BOOTSTRAP must be yes when defined"
+.  endif
+.  if !defined(MAKECONF) || empty(MAKECONF:M/*) || !exists(${MAKECONF})
+.error "Darwin bootstrap requires an explicit existing absolute MAKECONF"
+.  endif
+.include "${MAKECONF}"
+.  if ${_EMBERBSD_DARWIN_BOOTSTRAP_POLICY:U0} != "1"
+.error "MAKECONF must include the Ports Darwin bootstrap policy"
+.  endif
+.endif
 
 # Set PATH if not already set
