+.for _ember_tool in ${EMBERBSD_DARWIN_SOURCE_TOOLS:Mgzip} ${EMBERBSD_DARWIN_SOURCE_TOOLS:Mgunzip} ${EMBERBSD_DARWIN_SOURCE_TOOLS:Mgzcat}
+.  if defined(EMBERBSD_DARWIN_TOOL.${_ember_tool})
