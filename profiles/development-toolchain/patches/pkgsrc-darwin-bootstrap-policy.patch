--- /dev/null
+++ b/mk/tools/emberbsd-darwin-builtin.sh
@@ -0,0 +1,15 @@
+# Run one builtin of the shell that executes this file.
+# usage: SHELL emberbsd-darwin-builtin.sh NAME [ARGUMENT ...]
+# The calling command has no quoted words, so pkgsrc can pass it in the
+# environment and scripts can run it unquoted, as they run ${TEST}.
+_ember_builtin=$1
+shift
+case $_ember_builtin in
+echo)	echo "$@" ;;
+false)	false ;;
+test)	test "$@" ;;
+\[)	[ "$@" ;;
+true)	true ;;
+*)	echo "emberbsd-darwin-builtin.sh: unsupported builtin $_ember_builtin" >&2
+	exit 2 ;;
+esac
