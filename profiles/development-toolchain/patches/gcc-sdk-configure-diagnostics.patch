+if test "${GCC_CONFIGURE_SDK+set}" = set || test "${EMBERBSD_CONFIGURE_SDK+set}" = set; then
+  . "${srcdir}/../config/emberbsd-sdk-diagnostics.sh" || exit 1
+else
+  emberbsd_host_diagnostic () { "$@"; }
+fi
