# Origin: EmberBSD; AI-assisted bounded bootstrap binding, not upstream.
# This template is bootstrap input. It is not an ordinary compiler override.
# Instantiate only @DEPLOYMENT@ and @SDK_VERSION@ from the accepted plan.
# Bind the SDK version to its accepted ABI metadata. Pin the result.
# The SDK must also pin -B, the seed, the LLVM tools and native ABI inputs.

*self_spec:
+ %{fuse-ld=*:%eThis seed binding owns the Mach-O LLD selector} -fuse-ld=lld %{mmacosx-version-min=*:%{!mmacosx-version-min=@DEPLOYMENT@:%eThis seed binding requires its pinned deployment version}} %{mcpu=*:%{!mcpu=apple-m1:%eThis draft has no LLVM MC mapping for the selected CPU}} %{march=*:%eThis draft has no LLVM MC mapping for explicit architecture extensions} %{mtune=*:%eThis draft has no LLVM MC mapping for explicit tuning options}

*asm:
--filetype=obj --triple=arm64-apple-macosx@DEPLOYMENT@ --mcpu=apple-m1 %{!static:--position-independent} %{w:-W} %{I*} %<asm_macosx_version_min=*

# LLD requires the modern platform record. It recognizes the inherited
# -macos_version_min option but does not derive its platform from it.
# Append to the original link spec. Keep collect2 and link_command unchanged.
*link:
+ %{mmacosx-version-min=*:-platform_version macos %* @SDK_VERSION@}
