Origin: EmberBSD (AI-assisted). Upstream status: not submitted.

EmberBSD keeps one FFmpeg recipe (ffmpeg9). Apply after
pkgsrc-kept-version-consumers.patch. VLC upstream pkgsrc still selects
ffmpeg8, or ffmpeg4 when VA-API is enabled. Point both paths at ffmpeg9
so the common media profile accepts the package.

Plasma on EmberBSD uses Qt6. Leave the optional Qt5 UI available, but do
not suggest it. Prefer X11 output and VA-API on platforms that provide it.

--- a/multimedia/vlc/Makefile
+++ b/multimedia/vlc/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.325 2026/09/02 19:03:50 wiz Exp $
 
 DISTNAME=		vlc-3.0.23
-PKGREVISION=		9
+PKGREVISION=		10
 CATEGORIES=		multimedia
 MASTER_SITES=		https://download.videolan.org/pub/videolan/vlc/${PKGVERSION_NOREV}/
 EXTRACT_SUFX=		.tar.xz
--- a/multimedia/vlc/options.mk
+++ b/multimedia/vlc/options.mk
@@ -3,7 +3,9 @@
 PKG_OPTIONS_VAR=		PKG_OPTIONS.vlc
 PKG_SUPPORTED_OPTIONS=		alsa avahi dbus debug dts jack pulseaudio
 PKG_SUPPORTED_OPTIONS+=		vlc-skins qt5 x11
-PKG_SUGGESTED_OPTIONS=		dbus qt5
+# EmberBSD Plasma ships Qt6. VLC 3 still offers only a Qt5 UI; keep that
+# option available, but do not pull the retired Qt5 stack by default.
+PKG_SUGGESTED_OPTIONS=		dbus
 PKG_SUGGESTED_OPTIONS.Linux+=	alsa
 
 .include "../../mk/bsd.fast.prefs.mk"
@@ -16,6 +18,7 @@
 .include "../../multimedia/libva/available.mk"
 .if ${VAAPI_AVAILABLE} == "yes"
 PKG_SUPPORTED_OPTIONS+= vaapi
+PKG_SUGGESTED_OPTIONS+= vaapi
 .endif
 
 ### Add VDPAU if it is available
@@ -159,10 +162,10 @@
 CONFIGURE_ARGS+=	--enable-libva
 PLIST.vaapi=		yes
 .include "../../multimedia/libva/buildlink3.mk"
-.include "../../multimedia/ffmpeg4/buildlink3.mk"
+.include "../../multimedia/ffmpeg9/buildlink3.mk"
 .else
 CONFIGURE_ARGS+=	--disable-libva
-.include "../../multimedia/ffmpeg8/buildlink3.mk"
+.include "../../multimedia/ffmpeg9/buildlink3.mk"
 .endif
 
 ## VDPAU support
