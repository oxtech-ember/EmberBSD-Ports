 CONFIGURE_ARGS+=	--disable-libplacebo
@@ -152,6 +169,11 @@
 
 post-install:
 	${INSTALL_DATA} ${WRKSRC}/doc/vlc.1 ${DESTDIR}${PREFIX}/${PKGMANDIR}/man1
+# Cross builds skip vlc-cache-gen; VLC recreates the cache on first run.
+.if ${USE_CROSS_COMPILE:U:tl} == "yes"
+	${MKDIR} ${DESTDIR}${PREFIX}/lib/vlc/plugins
