+++ b/multimedia/vlc/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.325 2026/09/02 19:03:50 wiz Exp $
 
-DISTNAME=		vlc-3.0.23
-PKGREVISION=		9
+DISTNAME=		vlc-3.0.24
+PKGREVISION=		1
