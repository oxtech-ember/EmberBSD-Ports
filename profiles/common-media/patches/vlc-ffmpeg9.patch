-.include "../../x11/qt5-qtbase/buildlink3.mk"
-.include "../../x11/qt5-qtsvg/buildlink3.mk"
-PLIST.qt5=		yes
+## QT6 frontend (VLC 3.0.24 qt6.pro / qmake6)
+## Cross builds run host qmake6 with a qt.conf that points target
+## Prefix at the cross sysroot and Host* at the native Qt tools.
+
+PLIST_VARS+=		qt6
+.if !empty(PKG_OPTIONS:Mqt6)
+.include "../../x11/qt6-qtbase/buildlink3.mk"
+.include "../../graphics/qt6-qtsvg/buildlink3.mk"
+PLIST.qt6=		yes
 CONFIGURE_ARGS+=	--enable-qt
+QT6_HOST_PREFIX=	${EMBERBSD_HOST_PREFIX:U${TOOLBASE}}/qt6
+.if ${USE_CROSS_COMPILE:U:tl} == "yes"
+QT6_TARGET_PREFIX=	${EMBERBSD_CROSS_SYSROOT}${PREFIX}/qt6
+.else
+QT6_TARGET_PREFIX=	${PREFIX}/qt6
+.endif
+# pkgsrc wrappers strip PATH; pass absolute QMAKE6 and qt.conf.
+CONFIGURE_ENV+=		QMAKE6=${QT6_HOST_PREFIX}/bin/qmake6
+CONFIGURE_ENV+=		MOC=${QT6_HOST_PREFIX}/libexec/moc
+CONFIGURE_ENV+=		RCC=${QT6_HOST_PREFIX}/libexec/rcc
+CONFIGURE_ENV+=		UIC=${QT6_HOST_PREFIX}/libexec/uic
+CONFIGURE_ARGS+=	--with-qtconf=${WRKDIR}/target_qt.conf
+pre-configure: generate-vlc-qtconf
+.PHONY: generate-vlc-qtconf
+generate-vlc-qtconf:
+	${MKDIR} ${WRKDIR}
+	${PRINTF} '%s\n' \
+		'[Paths]' \
+		'Prefix=${QT6_TARGET_PREFIX}' \
+		'Headers=${QT6_TARGET_PREFIX}/include' \
+		'Libraries=${QT6_TARGET_PREFIX}/lib' \
+		'LibraryExecutables=${QT6_TARGET_PREFIX}/libexec' \
+		'Binaries=${QT6_TARGET_PREFIX}/bin' \
+		'Plugins=${QT6_TARGET_PREFIX}/plugins' \
+		'QmlImports=${QT6_TARGET_PREFIX}/qml' \
+		'Data=${QT6_TARGET_PREFIX}' \
+		'ArchData=${QT6_TARGET_PREFIX}' \
+		'HostPrefix=${QT6_HOST_PREFIX}' \
+		'HostData=${QT6_HOST_PREFIX}' \
+		'HostBinaries=${QT6_HOST_PREFIX}/bin' \
+		'HostLibraries=${QT6_HOST_PREFIX}/lib' \
+		'HostLibraryExecutables=${QT6_HOST_PREFIX}/libexec' \
+		'Sysroot=' \
+		'SysrootifyPrefix=false' \
+		'TargetSpec=netbsd-g++' \
+		'HostSpec=macx-clang' \
+		> ${WRKDIR}/target_qt.conf
 .else
 CONFIGURE_ARGS+=	--disable-qt
 .endif
