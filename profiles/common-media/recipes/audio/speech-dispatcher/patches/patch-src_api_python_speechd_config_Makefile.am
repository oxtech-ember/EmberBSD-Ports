Keep release manpages when cross-compiling; native help2man stays enabled.
Origin: EmberBSD (AI-assisted).

--- src/api/python/speechd_config/Makefile.am.orig
+++ src/api/python/speechd_config/Makefile.am
@@ -61,8 +61,10 @@
 
 if HAVE_PYTHON
 if HAVE_HELP2MAN
-spd-conf.1: buildconfig.py $(abs_builddir)/__init__.py $(abs_builddir)/config.py
-	LC_ALL=C PYTHONPATH=$(builddir)/.. PYTHONDONTWRITEBYTECODE=1 help2man -N -n "configure Speech Dispatcher and diagnose problems" --output=$@ $(srcdir)/spd-conf
+# Use the shipped, version-checked manual when cross-compiling.
+# Native builds retain upstream's help2man regeneration.
+spd-conf.1: $(if $(filter yes,$(EMBERBSD_DIST_MANPAGES)),,buildconfig.py $(abs_builddir)/__init__.py $(abs_builddir)/config.py)
+	if test "$(EMBERBSD_DIST_MANPAGES)" = yes; then test -s "$@"; else LC_ALL=C PYTHONPATH=$(builddir)/.. PYTHONDONTWRITEBYTECODE=1 help2man -N -n "configure Speech Dispatcher and diagnose problems" --output=$@ $(srcdir)/spd-conf; fi
 
 dist_man1_MANS = \
 	spd-conf.1
