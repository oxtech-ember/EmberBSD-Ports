$NetBSD$

Keep release manpages when cross-compiling; native help2man stays enabled.
Origin: EmberBSD (AI-assisted).

--- src/clients/say/Makefile.am.orig
+++ src/clients/say/Makefile.am
@@ -26,8 +26,10 @@
 spd_say_LDADD = $(c_api)/libspeechd.la $(EXTRA_SOCKET_LIBS) $(top_builddir)/src/common/libcommon.la -lpthread
 
 if HAVE_HELP2MAN
-spd-say.1: spd-say$(EXEEXT)
-	LC_ALL=C help2man -n "send text-to-speech output request to speech-dispatcher" --output=$@ ./$<
+# Use the shipped, version-checked manual when cross-compiling.
+# Native builds retain upstream's help2man regeneration.
+spd-say.1: $(if $(filter yes,$(EMBERBSD_DIST_MANPAGES)),,spd-say$(EXEEXT))
+	if test "$(EMBERBSD_DIST_MANPAGES)" = yes; then test -s "$@"; else LC_ALL=C help2man -n "send text-to-speech output request to speech-dispatcher" --output=$@ ./$<; fi
 
 dist_man1_MANS = \
 	spd-say.1
