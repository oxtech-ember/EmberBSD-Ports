             goto fail;
         s->local_rtpport = ff_udp_get_local_port(s->rtp_hd);
         if(s->local_rtpport == 65535) {
+            ffurl_closep(&s->rtp_hd);
             s->local_rtpport = -1;
+            ret = AVERROR(EADDRINUSE);
             continue;
         }
         rtcpflags = flags | AVIO_FLAG_WRITE;
