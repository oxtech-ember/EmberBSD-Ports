if(CASE STREQUAL "usage")
  execute_process(COMMAND "${CONSUMER}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "2" OR NOT error MATCHES "Usage: consumer NEW_DATABASE")
    message(FATAL_ERROR "Expected exact usage failure: ${result}: ${error}")
  endif()
elseif(CASE STREQUAL "existing")
  set(database "${WORK}/preserved.db")
  file(WRITE "${database}" "preserve this existing database\n")
  file(SHA256 "${database}" before)
  execute_process(COMMAND "${CONSUMER}" "${database}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(SHA256 "${database}" after)
  if(NOT result STREQUAL "1" OR NOT before STREQUAL after OR NOT error MATCHES "path already exists")
    message(FATAL_ERROR "Existing database guard failed: ${result}: ${error}")
  endif()
elseif(CASE STREQUAL "missing-parent")
  execute_process(COMMAND "${CONSUMER}" "${WORK}/missing-parent/database.db"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result STREQUAL "1" OR EXISTS "${WORK}/missing-parent/database.db")
    message(FATAL_ERROR "Missing parent guard failed: ${result}: ${error}")
  endif()
else()
  message(FATAL_ERROR "Unknown invalid-input case")
endif()
