+    pub(crate) f_favail: fsfilcnt_t,
+    pub(crate) f_fresvd: fsfilcnt_t,
+    pub(crate) f_syncreads: u64,
+    pub(crate) f_syncwrites: u64,
+    pub(crate) f_asyncreads: u64,
