+    /// Merge `src` into `dst`, preserving destination directories and files
+    /// that are absent from the source. Skip the specified source paths and
+    /// their descendants. Unlike `cp_link_filtered`, this does not replace
+    /// destination directories; prepared target objects must remain in place.
+    #[track_caller]
+    pub fn cp_link_r_excluding(&self, src: &Path, dst: &Path, excluded: &[PathBuf]) {
+        if self.config.dry_run() {
+            return;
+        }
+        for f in self.read_dir(src) {
+            let path = f.path();
+            if excluded.iter().any(|root| path.starts_with(root)) {
+                continue;
+            }
+            let dst = dst.join(path.file_name().unwrap());
+            if t!(f.file_type()).is_dir() {
+                t!(fs::create_dir_all(&dst));
+                self.cp_link_r_excluding(&path, &dst, excluded);
+            } else {
+                self.copy_link(&path, &dst, FileType::Regular);
+            }
+        }
+    }
+
