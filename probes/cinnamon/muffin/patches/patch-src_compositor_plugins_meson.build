$NetBSD$

The default plugin builds as a plain clutter module; the GTK3
dependency is dropped for the GTK-free Wayland profile.

--- src/compositor/plugins/meson.build.orig
+++ src/compositor/plugins/meson.build
@@ -8,9 +8,11 @@
   sources: ['default.c', libmuffin_cogl_path_enum_types_h],
   include_directories: muffin_includes,
   c_args: default_plugin_c_args,
+  # EmberBSD Wayland profile: the default plugin draws no GTK widgets
+  # (plain clutter module); the removed gtk3 dependency kept this
+  # profile off the GTK3 stack.
   dependencies: [
     glib_dep,
-    gtk3_dep,
     json_glib_dep,
     cinnamon_desktop_dep,
     libmuffin_clutter_dep,
