$NetBSD$

Origin: EmberBSD (AI-assisted). Retain introspection during cross
builds: the shared target GType query launcher and ELF ldd wrapper
apply to every generated GIR.

--- src/meson.build.orig
+++ src/meson.build
@@ -17,7 +17,6 @@
   gio_unix_dep,
   glib_dep,
   cinnamon_desktop_dep,
-  gtk3_dep,
   pango_dep,
 ]
 
@@ -118,14 +117,14 @@
 endif
 
 if have_native_backend
+  # EmberBSD (NetBSD): gudev/logind providers stay out (see the root
+  # meson.build); libudev-bsd covers device monitoring.
   muffin_pkg_private_deps += [
     libdrm_dep,
     libinput_dep,
-    gudev_dep,
     libgbm_dep,
-    logind_provider_dep,
-    libudev_dep,
     xkbcommon_dep,
+    dependency('libudev'),
   ]
 endif
 
@@ -384,10 +383,7 @@
   'core/window-private.h',
   'core/workspace.c',
   'core/workspace-private.h',
-  'ui/frames.c',
   'ui/frames.h',
-  'ui/theme.c',
-  'ui/theme-private.h',
   'ui/ui.c',
   'ui/ui.h',
   'x11/atomnames.h',
@@ -1024,7 +1020,15 @@
     endif
   endforeach
 
+  # EmberBSD cross: shared GI machinery (target GType queries + ldd wrapper).
+  gir_extra_args = []
+  gir_env = environment()
+  if meson.is_cross_build() and meson.get_external_property('emberbsd_gi_cross', false)
+    gir_extra_args = ['--use-ldd-wrapper=' + meson.get_external_property('emberbsd_gi_ldd_wrapper')]
+    gir_env.set('LD_LIBRARY_PATH', meson.current_build_dir())
+  endif
   libmuffin_gir = gnome.generate_gir(libmuffin,
+    extra_args: gir_extra_args, env: gir_env,
     sources: [
       muffin_version,
       muffin_enum_types[1],
