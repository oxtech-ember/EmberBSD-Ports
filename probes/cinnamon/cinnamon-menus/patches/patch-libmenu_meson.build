$NetBSD$

Origin: EmberBSD (AI-assisted). Retain introspection during cross
builds: the shared target GType query launcher and ELF ldd wrapper
apply to the CMenu GIR generation.

--- libmenu/meson.build.orig
+++ libmenu/meson.build
@@ -67,8 +67,17 @@
     subdirs: 'cinnamon-menus-3.0'
 )
 
+# EmberBSD cross: target GType queries and ELF resolution run through
+# the shared GI cross machinery (devel/gobject-introspection/cross.mk).
+gir_extra_args = []
+gir_env = environment()
+if meson.is_cross_build() and meson.get_external_property('emberbsd_gi_cross', false)
+  gir_extra_args = ['--use-ldd-wrapper=' + meson.get_external_property('emberbsd_gi_ldd_wrapper')]
+  gir_env.set('LD_LIBRARY_PATH', meson.current_build_dir())
+endif
 gnome.generate_gir(
     libcinnamon_menus,
+    extra_args: gir_extra_args, env: gir_env,
     namespace: 'CMenu',
     nsversion: '3.0',
     sources: public_sources,
@@ -77,2 +86,2 @@
-    includes: 'Gio-2.0',
+    includes: ['Gio-2.0', 'GioUnix-2.0'],
     install: true,
