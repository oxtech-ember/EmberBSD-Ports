# SPDX-License-Identifier: BSD-2-Clause
set(CMAKE_SYSTEM_NAME NetBSD)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES EMBER_TEST_SYSROOT EMBER_TEST_TOOLCHAIN EMBER_TEST_CLANG)
set(CMAKE_SYSROOT "${EMBER_TEST_SYSROOT}")
set(CMAKE_C_COMPILER "${EMBER_TEST_TOOLCHAIN}/bin/aarch64--netbsd-gcc")
if(EMBER_TEST_CLANG)
  set(CMAKE_CXX_COMPILER "${EMBER_TEST_CLANG}")
  set(CMAKE_CXX_COMPILER_TARGET aarch64--netbsd)
  set(CMAKE_CXX_FLAGS_INIT "-nostdinc++ -isystem ${CMAKE_SYSROOT}/usr/pkg/gcc16/include/c++ -isystem ${CMAKE_SYSROOT}/usr/pkg/gcc16/include/c++/aarch64--netbsd -isystem ${CMAKE_SYSROOT}/usr/pkg/gcc16/include/c++/backward")
  set(CMAKE_EXE_LINKER_FLAGS_INIT "-stdlib=libstdc++ --ld-path=${EMBER_TEST_TOOLCHAIN}/bin/aarch64--netbsd-ld -L${CMAKE_SYSROOT}/usr/pkg/gcc16/lib")
else()
  set(CMAKE_CXX_COMPILER "${EMBER_TEST_TOOLCHAIN}/bin/aarch64--netbsd-g++")
endif()
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_PREFIX_PATH "/usr/pkg;/usr/pkg/qt6")
