cmake_minimum_required(VERSION 3.19)

foreach(required BASELINE_FEATURE PATCHED_FEATURE OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "Set ${required}")
    endif()
endforeach()

# qt_feature() also handles user policy and generated headers in a full Qt build.
# Capture only CONDITION here. CMake evaluates the unmodified upstream expression.
function(qt_feature name)
    if(NOT name STREQUAL "ffmpeg")
        message(FATAL_ERROR "Unexpected feature: ${name}")
    endif()
    cmake_parse_arguments(F "PRIVATE" "LABEL" "ENABLE;DISABLE;CONDITION" ${ARGN})
    if(F_UNPARSED_ARGUMENTS OR NOT F_CONDITION)
        message(FATAL_ERROR "Unexpected FFmpeg feature syntax")
    endif()
    if(${F_CONDITION})
        set_property(GLOBAL PROPERTY ffmpeg_condition ON)
    else()
        set_property(GLOBAL PROPERTY ffmpeg_condition OFF)
    endif()
endfunction()

function(check_case platform audio found threads)
    foreach(flag APPLE WIN32 ANDROID QNX NETBSD LINUX FREEBSD OPENBSD)
        set(${flag} OFF)
    endforeach()
    set(${platform} ON)
    set(QT_FEATURE_pulseaudio OFF)
    set(QT_FEATURE_pipewire OFF)
    if(audio STREQUAL "PULSE")
        set(QT_FEATURE_pulseaudio ON)
    elseif(audio STREQUAL "PIPEWIRE")
        set(QT_FEATURE_pipewire ON)
    endif()
    set(FFmpeg_FOUND ${found})
    set(QT_FEATURE_thread ${threads})
    include("${BASELINE_FEATURE}")
    get_property(before GLOBAL PROPERTY ffmpeg_condition)
    include("${PATCHED_FEATURE}")
    get_property(after GLOBAL PROPERTY ffmpeg_condition)

    if(NOT found OR NOT threads)
        if(before OR after)
            message(FATAL_ERROR "FFmpeg and threads must remain required: ${platform}/${audio}/${found}/${threads}")
        endif()
    elseif(platform STREQUAL "NETBSD" AND audio STREQUAL "NONE")
        if(before OR NOT after)
            message(FATAL_ERROR "NetBSD video-only case must change from unavailable to available")
        endif()
    elseif(NOT "${before}" STREQUAL "${after}")
        message(FATAL_ERROR "Unrelated feature selection changed: ${platform}/${audio}/${found}/${threads}")
    endif()

    # Preserve the existing native and audio-backed platforms as positive controls.
    if(found AND threads)
        if(platform MATCHES "^(APPLE|WIN32|ANDROID|QNX)$" OR NOT audio STREQUAL "NONE")
            if(NOT before OR NOT after)
                message(FATAL_ERROR "Existing FFmpeg configuration lost: ${platform}/${audio}")
            endif()
        elseif(platform MATCHES "^(LINUX|FREEBSD|OPENBSD)$")
            if(before OR after)
                message(FATAL_ERROR "The NetBSD change must not widen other platforms")
            endif()
        endif()
    endif()
    file(APPEND "${OUTPUT}" "${platform}\t${audio}\t${found}\t${threads}\t${before}\t${after}\n")
endfunction()

file(WRITE "${OUTPUT}" "platform\taudio\tffmpeg_found\tthreads\tbefore\tafter\n")
set(cases 0)
foreach(platform NETBSD LINUX APPLE WIN32 ANDROID QNX FREEBSD OPENBSD)
    foreach(audio NONE PULSE PIPEWIRE)
        foreach(found OFF ON)
            foreach(threads OFF ON)
                check_case(${platform} ${audio} ${found} ${threads})
                math(EXPR cases "${cases} + 1")
            endforeach()
        endforeach()
    endforeach()
endforeach()
if(NOT cases EQUAL 96)
    message(FATAL_ERROR "Incomplete matrix")
endif()
message(STATUS "PASS: 96 before/after FFmpeg conditions; only NetBSD without audio changes")
