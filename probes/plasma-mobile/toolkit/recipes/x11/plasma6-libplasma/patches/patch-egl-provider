Retain EGL-backed window thumbnails with non-GLVND Mesa.
ECM already discovers EGL::EGL; select and link that target when CMake's
OpenGL::EGL is absent. Preserve the GLVND path and genuine no-EGL builds.
Origin: EmberBSD (AI-assisted), not submitted upstream.

--- CMakeLists.txt.orig
+++ CMakeLists.txt
@@ -113,14 +113,20 @@
     set(HAVE_GLX 0)
 endif()
 
-# OpenGL_EGL_FOUND is defined by FindOpenGL
+# Non-GLVND Mesa exposes EGL through ECM's independent FindEGL module.
+set(PLASMA_EGL_TARGET "")
 if(TARGET OpenGL::EGL)
-    add_feature_info(EGL OpenGL_EGL_FOUND
+    set(PLASMA_EGL_TARGET OpenGL::EGL)
+elseif(TARGET EGL::EGL)
+    set(PLASMA_EGL_TARGET EGL::EGL)
+endif()
+if(PLASMA_EGL_TARGET)
+    add_feature_info(EGL PLASMA_EGL_TARGET
                      "A platform-agnostic mechanism for creating rendering surfaces for use with other graphics libraries, such as OpenGL|ES and OpenVG.")
     set(HAVE_EGL 1)
 else()
     set(HAVE_EGL 0)
-    message(STATUS "OpenGL::EGL is not available")
+    message(STATUS "No EGL target is available")
 endif()
 
 ecm_find_qmlmodule(Qt5Compat.GraphicalEffects REQUIRED)
--- src/declarativeimports/core/CMakeLists.txt.orig
+++ src/declarativeimports/core/CMakeLists.txt
@@ -58,7 +58,7 @@
 endif()
 
 if(HAVE_EGL)
-    target_link_libraries(corebindingsplugin PRIVATE OpenGL::EGL)
+    target_link_libraries(corebindingsplugin PRIVATE ${PLASMA_EGL_TARGET})
 endif()
 
 ecm_finalize_qml_module(corebindingsplugin DESTINATION ${KDE_INSTALL_QMLDIR})
