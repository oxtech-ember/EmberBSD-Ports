$NetBSD$

Install example configuration files for pkgsrc CONF_FILES handling.
Keep the runtime configuration path unchanged.
Adapted from pkgsrc patch-ac,v 1.3 2017/09/02 22:45:04 leot Exp.
Prepared with AI assistance for EmberBSD.

--- data/meson.build.orig
+++ data/meson.build
@@ -1,5 +1,5 @@
 
-xdg_config_dir = get_option('sysconfdir') / 'xdg'
+xdg_config_dir = get_option('prefix') / 'share' / 'examples' / 'xdg'
 install_data(['user-dirs.conf', 'user-dirs.defaults'],
   install_dir: xdg_config_dir
 )
