+AC_ARG_VAR([ember_cv_at_empty_path], [Measured target at_empty_path behavior: yes or no; required for cross builds])
+
 AM_INIT_AUTOMAKE([foreign subdir-objects])
 AC_CONFIG_SRCDIR([configure.ac])
 AC_CONFIG_HEADERS([config.h])
@@ -290,7 +296,11 @@
