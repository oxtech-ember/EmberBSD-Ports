$NetBSD$

Origin: EmberBSD (AI-assisted). Keep both library and mock-service introspection
using native generators and real target GType queries. Native builds are unchanged.

--- libsecret/meson.build.orig
+++ libsecret/meson.build
@@ -1,3 +1,10 @@
+emberbsd_gir_args = []
+emberbsd_gir_env = environment()
+if meson.is_cross_build() and meson.get_external_property('emberbsd_gi_cross', false)
+  emberbsd_gir_args = ['--use-ldd-wrapper=' + meson.get_external_property('emberbsd_gi_ldd_wrapper')]
+  emberbsd_gir_env.set('LD_LIBRARY_PATH', meson.current_build_dir())
+endif
+
 installed_headers_subdir_base = 'libsecret-@0@'.format(api_version_major)
 installed_headers_subdir = installed_headers_subdir_base / 'libsecret'
 
@@ -159,7 +166,8 @@
     export_packages: 'libsecret-@0@'.format(api_version_major),
     includes: [ 'GObject-2.0', 'Gio-2.0' ],
     header: 'libsecret/secret.h',
-    extra_args: [ '-D SECRET_COMPILATION'],
+    extra_args: [ '-D SECRET_COMPILATION'] + emberbsd_gir_args,
+    env: emberbsd_gir_env,
     install: true,
   )
 
@@ -218,6 +226,8 @@
     export_packages: 'mock-service-0',
     includes: [ 'GObject-2.0', 'Gio-2.0' ],
     header: 'libsecret/mock-service.h',
+    extra_args: emberbsd_gir_args,
+    env: emberbsd_gir_env,
   )
 
   if get_option('vapi')
