cmake_minimum_required(VERSION 3.19)
project(FcitxExportConsumer LANGUAGES NONE)
set(CMAKE_INSTALL_LIBDIR lib)
if(NOT MODULE_ONLY)
    find_package(Fcitx5Core 5.1.23 REQUIRED CONFIG)
endif()
find_package(Fcitx5ModuleEmoji 5.1.23 REQUIRED CONFIG)
if(NOT MODULE_ONLY)
foreach(component Utils Config Core)
    get_target_property(includes Fcitx5::${component} INTERFACE_INCLUDE_DIRECTORIES)
    if(NOT includes STREQUAL "${EXPECTED_PREFIX}/include/Fcitx5/${component}")
        message(FATAL_ERROR "Non-relocatable ${component} includes: ${includes}")
    endif()
    if(NOT IS_DIRECTORY "${includes}")
        message(FATAL_ERROR "Missing installed header directory: ${includes}")
    endif()
endforeach()
endif()
get_target_property(module_includes Fcitx5::Module::Emoji INTERFACE_INCLUDE_DIRECTORIES)
if(NOT module_includes STREQUAL "${EXPECTED_PREFIX}/include/Fcitx5/Module/fcitx-module/emoji")
    message(FATAL_ERROR "Non-relocatable module includes: ${module_includes}")
endif()
if(NOT EXISTS "${module_includes}/emoji_public.h")
    message(FATAL_ERROR "Missing installed module header")
endif()
add_library(consumer INTERFACE)
target_link_libraries(consumer INTERFACE Fcitx5::Module::Emoji)
if(NOT MODULE_ONLY)
    target_link_libraries(consumer INTERFACE Fcitx5::Core)
endif()
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/resolved-includes.txt"
    CONTENT "$<TARGET_PROPERTY:consumer,INTERFACE_INCLUDE_DIRECTORIES>\n")
