--- a/www/libproxy/options.mk
+++ b/www/libproxy/options.mk
@@ -0,0 +1,50 @@
+# Origin: EmberBSD (AI-assisted). Runtime proxy backends remain enabled.
+PKG_OPTIONS_VAR= PKG_OPTIONS.libproxy
+PKG_SUPPORTED_OPTIONS= doc vala
+PKG_SUGGESTED_OPTIONS= doc vala
+.include "../../mk/bsd.options.mk"
+PLIST_VARS+= doc vala
+.if !empty(PKG_OPTIONS:Mdoc)
+PLIST.doc= yes
+MESON_ARGS+= -Ddocs=true
+TOOLS_CREATE+= gi-docgen
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && defined(EMBERBSD_GI_DOCGEN_HOST)
+.if empty(EMBERBSD_GI_DOCGEN_HOST:M/*) || !exists(${EMBERBSD_GI_DOCGEN_HOST}/bin/gi-docgen)
+PKG_FAIL_REASON+= "EMBERBSD_GI_DOCGEN_HOST must name an existing native gi-docgen prefix"
+.endif
+TOOLS_PATH.gi-docgen= ${EMBERBSD_GI_DOCGEN_HOST}/bin/gi-docgen
+MESON_BINARIES+= gi-docgen
+MESON_BINARY.gi-docgen= ${TOOLS_PATH.gi-docgen}
+pre-configure: emberbsd-proxy-docgen-check
+.PHONY: emberbsd-proxy-docgen-check
+emberbsd-proxy-docgen-check:
+	${RUN}${TEST} "$$(${TOOLS_PATH.gi-docgen} --version)" = '2026.1'
+.else
+TOOL_DEPENDS+= ${PYPKGPREFIX}-gi-docgen>=2026.1:../../devel/py-gi-docgen
+TOOLS_PATH.gi-docgen= ${TOOLBASE}/bin/gi-docgen
+.endif
+.else
+MESON_ARGS+= -Ddocs=false
+.endif
+.if !empty(PKG_OPTIONS:Mvala)
+PLIST.vala= yes
+MESON_ARGS+= -Dvapi=true
+TOOLS_CREATE+= vapigen
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && defined(EMBERBSD_VALA_HOST)
+.if empty(EMBERBSD_VALA_HOST:M/*) || !exists(${EMBERBSD_VALA_HOST}/bin/vapigen)
+PKG_FAIL_REASON+= "EMBERBSD_VALA_HOST must name an existing native Vala prefix"
+.endif
+TOOLS_PATH.vapigen= ${EMBERBSD_VALA_HOST}/bin/vapigen
+MESON_BINARIES+= vapigen
+MESON_BINARY.vapigen= ${TOOLS_PATH.vapigen}
+pre-configure: emberbsd-proxy-vapigen-check
+.PHONY: emberbsd-proxy-vapigen-check
+emberbsd-proxy-vapigen-check:
+	${RUN}${TEST} "$$(${TOOLS_PATH.vapigen} --version)" = 'Vala API Generator 0.56.19'
+.else
+TOOL_DEPENDS+= vala>=0.56.19:../../lang/vala
+TOOLS_PATH.vapigen= ${TOOLBASE}/bin/vapigen
+.endif
+.else
+MESON_ARGS+= -Dvapi=false
+.endif
--- a/www/libproxy/patches/patch-src_libproxy_meson.build-cross
+++ b/www/libproxy/patches/patch-src_libproxy_meson.build-cross
@@ -0,0 +1,36 @@
+$NetBSD$
+
+Origin: EmberBSD (AI-assisted). Reuse the common target GType query path.
+Native generators inspect cross-built libraries on the real target.
+Link and load both in-tree libraries for the temporary GIR executable.
+
+--- src/libproxy/meson.build.orig
++++ src/libproxy/meson.build
+@@ -85,6 +85,12 @@
+     '--quiet',
+   ]
+ 
++  if meson.is_cross_build() and meson.get_external_property('emberbsd_gi_cross', false)
++    meson.override_find_program('g-ir-scanner', find_program('g-ir-scanner', native: true))
++    meson.override_find_program('g-ir-compiler', find_program('g-ir-compiler', native: true))
++    libproxy_gir_extra_args += ['--use-ldd-wrapper=' + meson.get_external_property('emberbsd_gi_ldd_wrapper')]
++  endif
++
+   libproxy_gir = gnome.generate_gir(
+     libproxy,
+     sources: libproxy_headers + libproxy_sources,
+@@ -93,12 +99,13 @@
+     export_packages: package_api_name,
+     symbol_prefix: 'px',
+     identifier_prefix: 'px',
+-    link_with: libproxy,
++    link_with: [libproxy, px_backend],
+     includes: [ 'Gio-2.0' ],
+     install: true,
+     install_dir_gir: girdir,
+     install_dir_typelib: typelibdir,
+     env: {
++      'LD_LIBRARY_PATH': meson.project_build_root() + '/src/libproxy:' + meson.project_build_root() + '/src/backend',
+       'DYLD_LIBRARY_PATH': meson.project_build_root() + '/src/libproxy'
+     },
+     extra_args: libproxy_gir_extra_args,
--- a/www/libproxy/buildlink3.mk
+++ b/www/libproxy/buildlink3.mk
@@ -10,6 +10,11 @@
 BUILDLINK_PKGSRCDIR.libproxy?=		../../www/libproxy
 
 BUILDLINK_INCDIRS.libproxy+=		include/libroxy
+.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
+# libproxy.so needs its private backend in lib/libproxy. The cross GNU ld
+# has no sysroot, so it finds that DT_NEEDED entry only through rpath-link.
+LDFLAGS+=	-Wl,-rpath-link,${CROSS_DESTDIR}/usr/pkg/lib/libproxy
+.endif
 
 .include "../../devel/glib2/buildlink3.mk"
 .endif # LIBPROXY_BUILDLINK3_MK
