--- a/security/polkit/Makefile
+++ b/security/polkit/Makefile
@@ -1,7 +1,7 @@
 # $NetBSD: Makefile,v 1.62 2026/09/02 19:04:19 wiz Exp $
 
 DISTNAME=	polkit-127
-PKGREVISION=	2
+PKGREVISION=	3
 CATEGORIES=	security
