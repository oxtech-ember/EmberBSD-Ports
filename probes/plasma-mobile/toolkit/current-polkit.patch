--- a/security/polkit/patches/patch-meson-cross.build
+++ b/security/polkit/patches/patch-meson-cross.build
@@ -0,0 +1,48 @@
+$NetBSD$
+
+Origin: EmberBSD (AI-assisted). Preserve full GIR/typelib cross builds.
+Use the shared target-query launcher and inspect target ELF dependencies.
+Link the agent query to both in-tree libraries.
+
+--- meson.build.orig
++++ meson.build
+@@ -41,6 +41,14 @@
+ libversion = '@0@.@1@.@2@'.format(soversion, current, revision)
+ 
+ gnome = import('gnome')
++
++# Native GI tools execute only the temporary GType query on the target.
++emberbsd_gir_args = []
++emberbsd_gir_env = environment()
++if meson.is_cross_build() and meson.get_external_property('emberbsd_gi_cross', false)
++  emberbsd_gir_args += ['--use-ldd-wrapper=' + meson.get_external_property('emberbsd_gi_ldd_wrapper')]
++  emberbsd_gir_env.set('LD_LIBRARY_PATH', meson.project_build_root() / 'src/polkit' + ':' + meson.project_build_root() / 'src/polkitagent')
++endif
+ i18n = import('i18n')
+ pkg = import('pkgconfig')
+ 
+--- src/polkit/meson.build.orig
++++ src/polkit/meson.build
+@@ -124,7 +124,8 @@
+   libpolkit_gobject_gir = gnome.generate_gir(
+     libpolkit_gobject,
+     sources: sources + headers,
+-    extra_args: c_flags,
++    extra_args: [c_flags] + emberbsd_gir_args,
++    env: emberbsd_gir_env,
+     nsversion: pk_gir_version,
+     namespace: pk_gir_ns,
+     export_packages: name,
+--- src/polkitagent/meson.build.orig
++++ src/polkitagent/meson.build
+@@ -91,7 +91,9 @@
+     libpolkit_agent,
+     sources: sources + headers,
+     includes: incs,
+-    extra_args: c_flags,
++    link_with: [libpolkit_agent, libpolkit_gobject],
++    extra_args: c_flags + emberbsd_gir_args,
++    env: emberbsd_gir_env,
+     nsversion: pk_gir_version,
+     namespace: 'PolkitAgent',
+     export_packages: name,
--- a/security/polkit/patches/patch-src_polkit_polkitunixsession.c
+++ b/security/polkit/patches/patch-src_polkit_polkitunixsession.c
@@ -0,0 +1,56 @@
+Origin: Gleb Popov / FreeBSD Ports commit 12b84b980b45573c93be5382a274dbe872a1eb73.
+https://github.com/freebsd/freebsd-ports/commit/12b84b980b45573c93be5382a274dbe872a1eb73
+Adapted for EmberBSD (AI-assisted): use mutable pointers for allocated strings.
+ConsoleKit 2.0 database/session IDs differ from D-Bus object paths.
+Not submitted upstream.
+
+--- src/polkit/polkitunixsession.c.orig	2023-07-28 12:34:38 UTC
++++ src/polkit/polkitunixsession.c
+@@ -364,6 +364,7 @@ polkit_unix_session_exists_sync (PolkitSubject   *subj
+   PolkitUnixSession *session = POLKIT_UNIX_SESSION (subject);
+   GDBusConnection *connection;
+   GVariant *result;
++  gchar *session_path = NULL;
+   gboolean ret;
+ 
+   ret = FALSE;
+@@ -372,9 +373,12 @@ polkit_unix_session_exists_sync (PolkitSubject   *subj
+   if (connection == NULL)
+     goto out;
+ 
++  if (strncmp (session->session_id, "/org/freedesktop/ConsoleKit", strlen ("/org/freedesktop/ConsoleKit") ))
++    session_path = g_build_path("/", "/org/freedesktop/ConsoleKit", session->session_id, NULL);
++
+   result = g_dbus_connection_call_sync (connection,
+                                         "org.freedesktop.ConsoleKit",           /* name */
+-                                        session->session_id,                    /* object path */
++                                        session_path ? session_path : session->session_id,                    /* object path */
+                                         "org.freedesktop.ConsoleKit.Session",   /* interface name */
+                                         "GetUser",                              /* method */
+                                         NULL, /* parameters */
+@@ -383,6 +387,7 @@ polkit_unix_session_exists_sync (PolkitSubject   *subj
+                                         -1,
+                                         cancellable,
+                                         error);
++  g_free (session_path);
+   if (result == NULL)
+     goto out;
+ 
+@@ -472,6 +477,7 @@ polkit_unix_session_initable_init (GInitable     *init
+   PolkitUnixSession *session = POLKIT_UNIX_SESSION (initable);
+   GDBusConnection *connection;
+   GVariant *result;
++  const gchar* session_path;
+   gboolean ret;
+ 
+   connection = NULL;
+@@ -502,7 +508,8 @@ polkit_unix_session_initable_init (GInitable     *init
+   if (result == NULL)
+     goto out;
+ 
+-  g_variant_get (result, "(o)", &session->session_id);
++  g_variant_get (result, "(&o)", &session_path);
++  session->session_id = g_path_get_basename (session_path);
+   g_variant_unref (result);
+ 
+   ret = TRUE;
\ No newline at end of file
--- a/security/polkit/patches/patch-src_polkitbackend_polkitbackendsessionmonitor.c
+++ b/security/polkit/patches/patch-src_polkitbackend_polkitbackendsessionmonitor.c
@@ -0,0 +1,50 @@
+Origin: Gleb Popov / FreeBSD Ports commit 12b84b980b45573c93be5382a274dbe872a1eb73.
+https://github.com/freebsd/freebsd-ports/commit/12b84b980b45573c93be5382a274dbe872a1eb73
+Adapted for EmberBSD (AI-assisted): use mutable pointers for allocated strings.
+ConsoleKit 2.0 database/session IDs differ from D-Bus object paths.
+Not submitted upstream.
+
+--- src/polkitbackend/polkitbackendsessionmonitor.c.orig	2023-07-28 12:34:38 UTC
++++ src/polkitbackend/polkitbackendsessionmonitor.c
+@@ -385,7 +385,8 @@ polkit_backend_session_monitor_get_session_for_subject
+ 
+   if (POLKIT_IS_UNIX_PROCESS (subject))
+     {
+-      const gchar *session_id;
++      const gchar *session_path;
++      gchar *session_id;
+       GVariant *result;
+       result = g_dbus_connection_call_sync (monitor->system_bus,
+                                             "org.freedesktop.ConsoleKit",
+@@ -400,14 +401,17 @@ polkit_backend_session_monitor_get_session_for_subject
+                                             error);
+       if (result == NULL)
+         goto out;
+-      g_variant_get (result, "(&o)", &session_id);
++      g_variant_get (result, "(&o)", &session_path);
++      session_id = g_path_get_basename (session_path);
+       session = polkit_unix_session_new (session_id);
++      g_free (session_id);
+       g_variant_unref (result);
+     }
+   else if (POLKIT_IS_SYSTEM_BUS_NAME (subject))
+     {
+       guint32 pid;
+-      const gchar *session_id;
++      const gchar *session_path;
++      gchar *session_id;
+       GVariant *result;
+ 
+       result = g_dbus_connection_call_sync (monitor->system_bus,
+@@ -439,8 +443,10 @@ polkit_backend_session_monitor_get_session_for_subject
+                                             error);
+       if (result == NULL)
+         goto out;
+-      g_variant_get (result, "(&o)", &session_id);
++      g_variant_get (result, "(&o)", &session_path);
++      session_id = g_path_get_basename (session_path);
+       session = polkit_unix_session_new (session_id);
++      g_free (session_id);
+       g_variant_unref (result);
+     }
+   else
