--- /dev/null
+++ b/base/allocator/partition_allocator/src/partition_alloc/page_allocator_netbsd_unittest.cc
@@ -0,0 +1,112 @@
+// Copyright 2026 The EmberBSD Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "partition_alloc/page_allocator.h"
+#include "partition_alloc/page_allocator_constants.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+#include <errno.h>
+#include <sys/mman.h>
+
+#include <cstdlib>
+
+namespace partition_alloc {
+namespace {
+
+using Permissions = PageAccessibilityConfiguration;
+
+struct ScopedPages {
+  uintptr_t address;
+  size_t size;
+  ~ScopedPages() {
+    if (address)
+      FreePages(address, size);
+  }
+};
+
+TEST(PartitionAllocNetBsdMprotectTest, InaccessibleDecommitAndRecommit) {
+  const size_t size = internal::PageAllocationGranularity();
+  const ScopedPages pages{
+      AllocPages(size, size, Permissions(Permissions::kInaccessible),
+                 PageTag::kPartitionAlloc),
+      size};
+  ASSERT_NE(pages.address, 0u);
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadWrite)));
+  *reinterpret_cast<volatile unsigned char*>(pages.address) = 42;
+  ASSERT_TRUE(DecommitAndZeroSystemPages(pages.address, size,
+                                         PageTag::kPartitionAlloc));
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadWrite)));
+  EXPECT_EQ(*reinterpret_cast<volatile unsigned char*>(pages.address), 0u);
+  EXPECT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadExecute)));
+}
+
+TEST(PartitionAllocNetBsdMprotectTest, ReadCanBecomeReadWrite) {
+  const size_t size = internal::PageAllocationGranularity();
+  const ScopedPages pages{
+      AllocPages(size, size, Permissions(Permissions::kRead),
+                 PageTag::kChromium),
+      size};
+  ASSERT_NE(pages.address, 0u);
+  EXPECT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadWrite)));
+}
+
+TEST(PartitionAllocNetBsdMprotectTest, ReadWriteCanBecomeReadExecute) {
+  const size_t size = internal::PageAllocationGranularity();
+  const ScopedPages pages{
+      AllocPages(size, size, Permissions(Permissions::kReadWrite),
+                 PageTag::kChromium),
+      size};
+  ASSERT_NE(pages.address, 0u);
+  EXPECT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadExecute)));
+}
+
+TEST(PartitionAllocNetBsdMprotectTest, ExplicitJitSurvivesDecommit) {
+  const size_t size = internal::PageAllocationGranularity();
+  const ScopedPages pages{
+      AllocPages(size, size,
+                 Permissions(Permissions::kInaccessibleWillJitLater),
+                 PageTag::kChromium),
+      size};
+  ASSERT_NE(pages.address, 0u);
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadWrite)));
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadExecute)));
+  ASSERT_TRUE(
+      DecommitAndZeroSystemPages(pages.address, size, PageTag::kChromium));
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadWrite)));
+  EXPECT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadExecute)));
+}
+
+TEST(PartitionAllocNetBsdMprotectTest, PaxRejectsActiveRwx) {
+  const char* enabled = std::getenv("EMBERBSD_TEST_PAX_MPROTECT");
+  if (!enabled)
+    GTEST_SKIP() << "Set EMBERBSD_TEST_PAX_MPROTECT=1 only when PaX is active";
+  ASSERT_STREQ(enabled, "1");
+  const size_t size = internal::PageAllocationGranularity();
+  const ScopedPages pages{
+      AllocPages(size, size, Permissions(Permissions::kReadWrite),
+                 PageTag::kChromium),
+      size};
+  ASSERT_NE(pages.address, 0u);
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadWrite)));
+  ASSERT_TRUE(TrySetSystemPagesAccess(pages.address, size,
+                                      Permissions(Permissions::kReadExecute)));
+  errno = 0;
+  EXPECT_EQ(mprotect(reinterpret_cast<void*>(pages.address), size,
+                     PROT_READ | PROT_WRITE | PROT_EXEC),
+            -1);
+  EXPECT_EQ(errno, EACCES);
+}
+
+}  // namespace
+}  // namespace partition_alloc
