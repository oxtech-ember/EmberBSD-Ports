+TEST_F(StunTest, AddAttributeRetainsDerivedOwnerAndLifetime) {
+  std::vector<StunMessage*> owners;
+  int destructions = 0;
+  StunMessage msg(STUN_BINDING_REQUEST, "ABCDABCDABCD");
+  auto attr =
+      std::make_unique<OwnerTrackingByteStringAttribute>(owners, destructions);
+  StunAttribute* original = attr.get();
+  std::unique_ptr<StunAttribute> erased = std::move(attr);
+  msg.AddAttribute(std::move(erased));
+  EXPECT_EQ(owners, (std::vector<StunMessage*>{&msg}));
+  EXPECT_EQ(8U, msg.length());
+  EXPECT_EQ(0, destructions);
+
+  auto removed = msg.RemoveAttribute(STUN_ATTR_USERNAME);
+  EXPECT_EQ(original, removed.get());
+  EXPECT_EQ(owners, (std::vector<StunMessage*>{&msg, nullptr}));
+  EXPECT_EQ(0U, msg.length());
+  EXPECT_EQ(0, destructions);
+
+  msg.AddAttribute(std::move(removed));
+  msg.ClearAttributes();
+  EXPECT_EQ(owners, (std::vector<StunMessage*>{&msg, nullptr, &msg, nullptr}));
+  EXPECT_EQ(0U, msg.length());
+  EXPECT_EQ(1, destructions);
+}
