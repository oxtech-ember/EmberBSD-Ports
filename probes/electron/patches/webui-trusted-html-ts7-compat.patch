Chromium WebUI: preserve TrustedHTML values with TypeScript 7 DOM types.

Origin: EmberBSD, not submitted upstream.
The casts change types only, preserving Trusted Types CSP enforcement.
Boolean preserves the previous truthiness of the hidden attribute.

--- a/ui/webui/resources/js/custom_element.ts
+++ b/ui/webui/resources/js/custom_element.ts
@@ -24,8 +24,11 @@
 
     this.attachShadow({mode: 'open'});
     const template = document.createElement('template');
+    // Host tsc 7.x lib.dom types innerHTML as string only; emptyHTML() is
+    // string|TrustedHTML (Chromium trusted types). Assign via unknown.
     template.innerHTML =
-        (this.constructor as typeof CustomElement).template || emptyHTML();
+        ((this.constructor as typeof CustomElement).template ||
+         emptyHTML()) as unknown as string;
     this.shadowRoot!.appendChild(template.content.cloneNode(true));
   }
 
