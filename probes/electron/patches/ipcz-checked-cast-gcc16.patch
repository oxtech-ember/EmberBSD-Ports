 uint64_t AsUint64(T value) {
   return static_cast<uint64_t>(value);
 }
+
+TEST(SafeMathTest, CheckedCastIntegerBoundaries) {
+  static_assert(checked_cast<int16_t>(int32_t{-32768}) == -32768);
+  static_assert(checked_cast<int16_t>(uint16_t{32767}) == 32767);
+  static_assert(checked_cast<uint8_t>(int16_t{0}) == 0);
+  static_assert(checked_cast<uint8_t>(uint16_t{255}) == 255);
+  static_assert(checked_cast<int64_t>(int32_t{-1}) == -1);
+  static_assert(checked_cast<uint64_t>(uint32_t{0xffffffff}) == 0xffffffff);
+
+  EXPECT_EQ(-32768, checked_cast<int16_t>(int32_t{-32768}));
+  EXPECT_EQ(32767, checked_cast<int16_t>(uint16_t{32767}));
+  EXPECT_EQ(0, checked_cast<uint8_t>(int16_t{0}));
+  EXPECT_EQ(255, checked_cast<uint8_t>(uint16_t{255}));
+  EXPECT_EQ(-1, checked_cast<int64_t>(int32_t{-1}));
+  EXPECT_EQ(uint64_t{0xffffffff}, checked_cast<uint64_t>(uint32_t{0xffffffff}));
+}
+
+#if !defined(NDEBUG) || ABSL_OPTION_HARDENED == 1 || ABSL_OPTION_HARDENED == 2
