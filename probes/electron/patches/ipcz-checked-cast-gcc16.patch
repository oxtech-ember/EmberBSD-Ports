+}
+
+TEST(SafeMathDeathTest, CheckedCastNegativeToUnsigned) {
+  EXPECT_DEATH_IF_SUPPORTED(checked_cast<uint8_t>(int16_t{-1}), "");
+}
+
+TEST(SafeMathDeathTest, CheckedCastUpperOverflow) {
+  EXPECT_DEATH_IF_SUPPORTED(checked_cast<int16_t>(int32_t{32768}), "");
+  EXPECT_DEATH_IF_SUPPORTED(checked_cast<int16_t>(uint16_t{32768}), "");
+  EXPECT_DEATH_IF_SUPPORTED(checked_cast<uint16_t>(uint32_t{65536}), "");
+}
