+// The selected shared provider is explicit for Chromium; standalone DevTools
+// retains upstream package discovery and its checkout binary.
+const providerArgs = process.argv.slice(4);
+const providerFlag = name => {
+  const index = providerArgs.indexOf(name);
+  return index < 0 ? undefined : providerArgs[index + 1];
+};
+const sharedModule = providerFlag('--emberbsdEsbuildModule');
+const sharedBinary = providerFlag('--emberbsdEsbuildBinary');
+const sharedVersion = providerFlag('--emberbsdEsbuildVersion');
+let esbuild;
+if (sharedModule || sharedBinary || sharedVersion) {
+  if (!sharedModule || !sharedBinary || !sharedVersion ||
+      !path.isAbsolute(sharedModule) || !path.isAbsolute(sharedBinary)) {
+    throw new Error('Selected esbuild module, binary and version are required');
+  }
+  process.env.ESBUILD_BINARY_PATH = sharedBinary;
+  esbuild = await import(pathToFileURL(sharedModule).href);
+  if (esbuild.version !== sharedVersion) {
+    throw new Error('Selected esbuild version changed; regenerate GN');
+  }
+} else {
+  const binaryName = os.type() === 'Windows_NT' ? 'esbuild.exe' : 'esbuild';
+  process.env.ESBUILD_BINARY_PATH = path.join(devtoolsRootPath(), 'third_party', 'esbuild', binaryName);
+  esbuild = await import('esbuild');
+}
 
