+++ new/third_party/zlib/google/unicode_zip_extra.h	2026-11-05 15:33:24.380439181 +0300
@@ -0,0 +1,50 @@
+// Copyright 2026 The Chromium Authors and EmberBSD contributors.
+// Adapted from third_party/zlib/contrib/minizip/unzip.c, copyright Gilles
+// Vollant and Chromium contributors, under the zlib license.
+// See third_party/zlib/LICENSE.
+#ifndef THIRD_PARTY_ZLIB_GOOGLE_UNICODE_ZIP_EXTRA_H_
+#define THIRD_PARTY_ZLIB_GOOGLE_UNICODE_ZIP_EXTRA_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <zlib.h>
+
+namespace zip {
+
+// Read an Info-ZIP Unicode Path field (ZIP APPNOTE 4.6.9) without changing
+// the original physical path. Returns false on a malformed extra field.
+inline bool UnicodeZipPath(std::string_view raw,
+                           std::string_view extra,
+                           std::string* name) {
+  name->clear();
+  size_t offset = 0;
+  while (offset < extra.size()) {
+    if (extra.size() - offset < 4)
+      return false;
+    const auto byte = [&extra](size_t i) {
+      return static_cast<uint8_t>(extra.at(i));
+    };
+    const uint16_t type = byte(offset) | (uint16_t{byte(offset + 1)} << 8);
+    const uint16_t size = byte(offset + 2) | (uint16_t{byte(offset + 3)} << 8);
+    offset += 4;
+    if (size > extra.size() - offset)
+      return false;
+    if (type == 0x7075) {
+      if (size < 5)
+        return false;
+      const uint32_t expected = uint32_t{byte(offset + 1)} |
+                                (uint32_t{byte(offset + 2)} << 8) |
+                                (uint32_t{byte(offset + 3)} << 16) |
+                                (uint32_t{byte(offset + 4)} << 24);
+      const uint32_t actual = crc32(0, reinterpret_cast<const Bytef*>(raw.data()),
+                                    static_cast<uInt>(raw.size()));
+      if (byte(offset) == 1 && expected == actual)
+        name->assign(extra.substr(offset + 5, size - 5));
+    }
+    offset += size;
+  }
+  return true;
+}
+}  // namespace zip
+#endif  // THIRD_PARTY_ZLIB_GOOGLE_UNICODE_ZIP_EXTRA_H_
