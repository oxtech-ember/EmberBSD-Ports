+// found in the LICENSE file.
+
+#include "ipcz/api_object.h"
+
+#include "testing/gtest/include/gtest/gtest.h"
+#include "util/ref_counted.h"
+
+namespace ipcz {
+namespace {
+
+class TestAPIObject : public APIObjectImpl<TestAPIObject, APIObject::kBox> {
+ public:
+  explicit TestAPIObject(int& destructions) : destructions_(destructions) {}
+
+  IpczResult Close() override { return IPCZ_RESULT_OK; }
+
+ protected:
+  ~TestAPIObject() override { ++destructions_; }
+
+ private:
+  int& destructions_;
+};
+
+// Deleting through APIObjectImpl must retain virtual dispatch, including when
+// the complete object's destructor is private.
+class DerivedTestAPIObject : public TestAPIObject {
+ public:
+  DerivedTestAPIObject(int& base_destructions, int& derived_destructions)
+      : TestAPIObject(base_destructions),
+        derived_destructions_(derived_destructions) {}
+
+ private:
+  ~DerivedTestAPIObject() override { ++derived_destructions_; }
+
+  int& derived_destructions_;
+};
+
+TEST(APIObjectTest, FinalTypedReferenceRetainsVirtualDestruction) {
+  int base_destructions = 0;
+  int derived_destructions = 0;
+  auto typed = MakeRefCounted<DerivedTestAPIObject>(base_destructions,
+                                                  derived_destructions);
+  Ref<APIObject> erased = typed;
+  erased.reset();
+  EXPECT_EQ(0, base_destructions);
+  EXPECT_EQ(0, derived_destructions);
+
+  typed.reset();
+  EXPECT_EQ(1, base_destructions);
+  EXPECT_EQ(1, derived_destructions);
+}
+
+TEST(APIObjectTest, FinalUntypedReferenceRetainsVirtualDestruction) {
+  int base_destructions = 0;
+  int derived_destructions = 0;
+  auto typed = MakeRefCounted<DerivedTestAPIObject>(base_destructions,
+                                                  derived_destructions);
+  Ref<APIObject> erased = typed;
+  typed.reset();
+  EXPECT_EQ(0, base_destructions);
+  EXPECT_EQ(0, derived_destructions);
+
+  erased.reset();
+  EXPECT_EQ(1, base_destructions);
+  EXPECT_EQ(1, derived_destructions);
+}
+
+}  // namespace
+}  // namespace ipcz
