ui/display/mac: at a macOS 15.0+ deployment target (EmberBSD host toolchains: native runtime is minos 15.0, so a lower target fails the link with -fatal_warnings), CVDisplayLink is deprecated and would fail -Werror. CADisplayLink (macOS 14+) is always available there, so compile CVDisplayLinkMac only below 15.0 and use CADisplayLinkMac as DisplayLinkMac's fallback. No pragma, no -Wno.

--- a/ui/display/mac/display_link_mac.mm
+++ b/ui/display/mac/display_link_mac.mm
@@ -10,7 +10,11 @@
 #include "base/task/bind_post_task.h"
 #include "ui/display/display_features.h"
 #include "ui/display/mac/ca_display_link_mac.h"
+#include <Availability.h>
+
+#if __MAC_OS_X_VERSION_MIN_REQUIRED < 150000
 #include "ui/display/mac/cv_display_link_mac.h"
+#endif
 #include "ui/display/mac/external_display_link_mac.h"
 #include "ui/display/mac/screen_utils_mac.h"
 #include "ui/display/types/display_constants.h"
@@ -70,7 +74,13 @@
     // Fallback to CVDisplayLinkMac if failed.
   }
 
+#if __MAC_OS_X_VERSION_MIN_REQUIRED < 150000
   return CVDisplayLinkMac::GetForDisplay(display_id);
+#else
+  // CVDisplayLink is deprecated from macOS 15.0, and CADisplayLink (macOS
+  // 14.0+) is always available at this deployment target.
+  return CADisplayLinkMac::GetForDisplay(display_id, /*in_gpu_process=*/true);
+#endif
 }
 
 void DisplayLinkMac::RecordDisplayLinkCreation(bool success) {
--- a/ui/display/mac/cv_display_link_mac.mm
