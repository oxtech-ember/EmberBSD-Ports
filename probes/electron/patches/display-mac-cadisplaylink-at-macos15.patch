@@ -4,6 +4,7 @@
 
 #include "ui/display/mac/cv_display_link_mac.h"
 
+#include <Availability.h>
 #import <QuartzCore/CVDisplayLink.h>
 #include <stdint.h>
 
@@ -20,6 +21,10 @@
 #include "third_party/abseil-cpp/absl/container/flat_hash_set.h"
 #include "ui/display/mac/screen_utils_mac.h"
 
+// CVDisplayLink is deprecated from macOS 15.0; DisplayLinkMac uses
+// CADisplayLinkMac at that deployment target.
+#if __MAC_OS_X_VERSION_MIN_REQUIRED < 150000
+
 namespace base::apple {
 
 template <>
@@ -413,3 +418,5 @@
 }
 
 }  // namespace ui
