+// A declined test prompt must leave the remote profile locked.
+TEST_F(ProcessSingletonPosixTest, NotifyOtherProcessOrCreate_RemoteProfileInUse) {
+  CreateProcessSingletonOnThread();
+  BlockWorkerThread();
+  EXPECT_EQ(0, unlink(lock_path_.value().c_str()));
+  EXPECT_EQ(0, symlink("FAKEFOOHOST-1234", lock_path_.value().c_str()));
+  EXPECT_EQ(0, unlink(socket_path_.value().c_str()));
+  ProcessSingleton::SetUserOptedUnlockInUseProfileForTesting(false);
+  EXPECT_EQ(ProcessSingleton::PROFILE_IN_USE,
+            NotifyOtherProcessOrCreate("about:blank"));
+  base::FilePath target_path;
+  EXPECT_TRUE(base::ReadSymbolicLink(lock_path_, &target_path));
+  EXPECT_EQ(base::FilePath("FAKEFOOHOST-1234"), target_path);
+  UnblockWorkerThread();
+}
