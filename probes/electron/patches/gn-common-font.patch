--- /dev/null
+++ b/build/config/emberbsd_font.gni
@@ -0,0 +1,39 @@
+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+import("//build/config/linux/pkg_config.gni")
+
+declare_args() {
+  emberbsd_common_font = false
+  emberbsd_freetype_host_libraries = []
+  emberbsd_freetype_target_libraries = []
+  emberbsd_freetype_host_inputs = []
+  emberbsd_freetype_target_inputs = []
+  emberbsd_harfbuzz_host_libraries = []
+  emberbsd_harfbuzz_target_libraries = []
+  emberbsd_harfbuzz_host_inputs = []
+  emberbsd_harfbuzz_target_inputs = []
+}
+
+template("emberbsd_font_provider") {
+  not_needed(invoker, "*")
+  if (emberbsd_pkg_config_role == "native") {
+    _libraries = invoker.host_libraries
+    _inputs = invoker.host_inputs
+  } else {
+    _libraries = invoker.target_libraries
+    _inputs = invoker.target_inputs
+  }
+  assert(emberbsd_pkg_config_role != "upstream" && _libraries != [] && _inputs != [],
+         "Selected font provider is incomplete")
+  config(target_name + "_selected") {
+    libs = _libraries
+    if (emberbsd_pkg_config_role == "native") {
+      ldflags = [ "-Wl,-rpath=" + rebase_path(get_path_info(_libraries[0], "dir"), "") ]
+    } else {
+      ldflags = [ "-Wl,-rpath=/usr/pkg/lib" ]
+    }
+  }
+  source_set(target_name) {
+    inputs = _inputs
+    all_dependent_configs = [ ":" + target_name + "_selected" ]
+  }
+}
