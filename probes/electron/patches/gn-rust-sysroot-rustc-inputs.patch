$NetBSD$

Origin: EmberBSD (AI-assisted).
Upstream: Chromium with NetBSD cross adaptations.
Status: local cross-build fix; not submitted upstream.

When rust_sysroot_absolute selects a custom sysroot, point rustc_wrapper_inputs
and find_stdlib action inputs at that sysroot's rustc instead of the absent
//third_party/rust-toolchain package. Chromium's in-tree toolchain path remains
unchanged when use_chromium_rust_toolchain is true.

--- a/build/config/rust.gni
+++ b/build/config/rust.gni
@@ -474,8 +474,16 @@
   "//build/rust/gni_impl/rustc_wrapper.py",
 ]
 
-if (host_os == "win") {
-  rustc_wrapper_inputs += [ "//third_party/rust-toolchain/bin/rustc.exe" ]
+# Custom rust_sysroot_absolute builds must depend on that sysroot's rustc, not
+# Chromium's third_party/rust-toolchain package (often absent for cross).
+if (use_chromium_rust_toolchain) {
+  if (host_os == "win") {
+    rustc_wrapper_inputs += [ "//third_party/rust-toolchain/bin/rustc.exe" ]
+  } else {
+    rustc_wrapper_inputs += [ "//third_party/rust-toolchain/bin/rustc" ]
+  }
+} else if (host_os == "win") {
+  rustc_wrapper_inputs += [ "$rust_sysroot/bin/rustc.exe" ]
 } else {
-  rustc_wrapper_inputs += [ "//third_party/rust-toolchain/bin/rustc" ]
-}
+  rustc_wrapper_inputs += [ "$rust_sysroot/bin/rustc" ]
+}
--- a/build/rust/std/BUILD.gn
+++ b/build/rust/std/BUILD.gn
@@ -271,10 +271,16 @@
       out_libdir = rebase_path(target_out_dir, root_build_dir)
       out_depfile = rebase_path(depfile, root_build_dir)
 
-      if (host_os == "win") {
-        inputs = [ "//third_party/rust-toolchain/bin/rustc.exe" ]
+      if (use_chromium_rust_toolchain) {
+        if (host_os == "win") {
+          inputs = [ "//third_party/rust-toolchain/bin/rustc.exe" ]
+        } else {
+          inputs = [ "//third_party/rust-toolchain/bin/rustc" ]
+        }
+      } else if (host_os == "win") {
+        inputs = [ "$rust_sysroot/bin/rustc.exe" ]
       } else {
-        inputs = [ "//third_party/rust-toolchain/bin/rustc" ]
+        inputs = [ "$rust_sysroot/bin/rustc" ]
       }
 
       # For the rustc sysroot we must include even the rlibs we don't pass to
