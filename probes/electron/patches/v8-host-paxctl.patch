V8: apply snapshot-generator PaX flags only on a NetBSD host.

Origin: EmberBSD (AI-assisted), not submitted upstream.
Source: pkgsrc www/chromium NetBSD PaX integration, gitlink
fff4deb639a1a640476203c80f752fb77b6cb14b (patch-v8_BUILD.gn).
The original patch set credits OpenBSD Chromium and pkgsrc QtWebEngine.
Apply from the pinned V8 integration source root.
Keep the existing BSD-style license and copyright notices.
The explicit executable path needs independent native SDK qualification.
This patch does not change target browser PaX or sandbox policy.

--- a/BUILD.gn
+++ b/BUILD.gn
@@ -46,6 +46,10 @@
 
   # Dynamically set an additional dependency from v8/custom_deps.
   v8_custom_deps = ""
+
+  # Absolute qualified host utility path for NetBSD snapshot generators.
+  # Other hosts do not apply NetBSD PaX flags to their native executable.
+  v8_host_paxctl = ""
 
   # Sets -DV8_ENABLE_FUTURE.
   v8_enable_future = false
@@ -2755,21 +2759,30 @@
   ]
 }
 
-action("run_paxctl_mksnapshot") {
+if (host_os == "netbsd") {
+  assert(v8_host_paxctl != "",
+         "NetBSD-host mksnapshot needs an explicit qualified paxctl path")
+  action("run_paxctl_mksnapshot") {
     deps = [ ":mksnapshot($v8_snapshot_toolchain)" ]
 
     script = "tools/run-paxctl.py"
     stamp = "$target_gen_dir/paxctl_stamp"
     outputs = [ stamp ]
+    inputs = [ v8_host_paxctl ]
 
     sources = []
     data = []
 
     args = [
-      rebase_path(stamp, root_build_dir), "/usr/sbin/paxctl", "+m", "./" + rebase_path(get_label_info(":mksnapshot($v8_snapshot_toolchain)",
-                                        "root_out_dir") + "/mksnapshot",
-                         root_build_dir),
-    ]
+      rebase_path(stamp, root_build_dir),
+      v8_host_paxctl,
+      "+m",
+      "./" + rebase_path(
+              get_label_info(":mksnapshot($v8_snapshot_toolchain)",
+                             "root_out_dir") + "/mksnapshot",
+              root_build_dir),
+    ]
+  }
 }
 
 # Template to generate different V8 snapshots based on different runtime flags.
@@ -2790,10 +2803,9 @@
     suffix = "_$name"
   }
   action("run_mksnapshot_" + name) {
-    if (target_os == "netbsd") {
-      deps = [ ":mksnapshot($v8_snapshot_toolchain)", ":run_paxctl_mksnapshot" ]
-    } else {
-      deps = [ ":mksnapshot($v8_snapshot_toolchain)" ]
+    deps = [ ":mksnapshot($v8_snapshot_toolchain)" ]
+    if (host_os == "netbsd") {
+      deps += [ ":run_paxctl_mksnapshot" ]
     }
     if (v8_verify_deterministic_mksnapshot) {
       # We archive the snapshot executable when verifying snapshot
--- a/tools/run-paxctl.py
+++ b/tools/run-paxctl.py
@@ -10,6 +10,10 @@
 import sys
 import os
 
+if len(sys.argv) < 3 or not os.path.isabs(sys.argv[2]):
+  print("paxctl needs an absolute selected host executable path", file=sys.stderr)
+  sys.exit(2)
+
 with open(sys.argv[1], 'w'):
   os.utime(sys.argv[1], None)
 
