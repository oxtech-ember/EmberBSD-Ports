+#!/usr/bin/env python3
+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+# Origin: EmberBSD (AI-assisted).
+"""Bind selected Node providers and their versions to a GN action command."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+
+def package_version(entry, expected):
+    if not entry:
+        return "-"
+    current = Path(entry).resolve(strict=True).parent
+    for directory in (current, *current.parents):
+        metadata = directory / "package.json"
+        if metadata.is_file():
+            package = json.loads(metadata.read_text())
+            if package.get("name") == expected:
+                version = package.get("version")
+                if isinstance(version, str) and version and "\n" not in version:
+                    return version
+                break
+    raise ValueError("selected provider package version missing: " + expected)
+
+
+def check_paths(node, typescript, rollup):
+    for variable, value in (("EMBERBSD_HOST_NODE", node),
+                            ("EMBERBSD_HOST_TYPESCRIPT", typescript),
+                            ("EMBERBSD_HOST_ROLLUP", rollup)):
+        if value and (not os.path.isabs(value) or not os.path.isfile(value)):
+            raise ValueError(variable + " must name an absolute file")
+    if not node:
+        raise ValueError("selected Node is required")
+
+
+def versions(node, typescript, rollup):
+    check_paths(node, typescript, rollup)
+    version = subprocess.check_output([node, "--version"], text=True).strip()
+    if not version or "\n" in version:
+        raise ValueError("selected Node version invalid")
+    return [version, package_version(typescript, "typescript"),
+            package_version(rollup, "rollup")]
+
+
+if sys.argv[1] == "--inspect":
+    print("\n".join(versions(*sys.argv[2:5])))
+else:
+    node, typescript, rollup, node_version, ts_version, rollup_version, script, *args = sys.argv[1:]
+    check_paths(node, typescript, rollup)
+    if [package_version(typescript, "typescript"), package_version(rollup, "rollup")] != [ts_version, rollup_version]:
+        raise RuntimeError("selected Node provider version changed; regenerate GN")
+    for variable, value in (("EMBERBSD_HOST_NODE", node),
+                            ("EMBERBSD_HOST_TYPESCRIPT", typescript),
+                            ("EMBERBSD_HOST_ROLLUP", rollup)):
+        if value:
+            os.environ[variable] = value
+        else:
+            os.environ.pop(variable, None)
+    guard = str(Path(__file__).with_name("node_version_guard.js").resolve(strict=True))
+    options = os.environ.get("NODE_OPTIONS", "")
+    os.environ["NODE_OPTIONS"] = (options + " --require=" + json.dumps(guard)).strip()
+    os.environ["EMBERBSD_HOST_NODE_EXPECTED_VERSION"] = node_version
+    os.execv(sys.executable, [sys.executable, script, *args])
