@@ -0,0 +1,7 @@
+// Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+// Origin: EmberBSD (AI-assisted).
+const expected = process.env.EMBERBSD_HOST_NODE_EXPECTED_VERSION;
+if (expected && process.version !== expected) {
+  console.error("selected Node provider version changed; regenerate GN");
+  process.exit(1);
+}
