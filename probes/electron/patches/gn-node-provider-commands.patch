+#!/usr/bin/env python3
+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+# Origin: EmberBSD (AI-assisted).
+"""Bind native TypeScript action to the version selected at GN generation."""
+import os
+import subprocess
+import sys
+
+expected, executable, *arguments = sys.argv[1:]
+actual = subprocess.check_output([executable, "--version"], text=True).strip()
+if actual != "Version " + expected:
+    raise SystemExit("selected TypeScript version changed; regenerate GN")
+os.execv(executable, [executable, *arguments])
