+#elif BUILDFLAG(IS_NETBSD)
+
+ProcessMemoryInfo ProcessMetric::GetMemoryInfo() const {
+  ProcessMemoryInfo result;
+  const auto pid = process.Pid();
+  if (pid <= 0)
+    return result;
+
+  struct kinfo_proc2 info = {};
+  size_t length = sizeof(info);
+  int mib[] = {CTL_KERN, KERN_PROC2, KERN_PROC_PID, pid,
+               sizeof(info), 1};
+  if (sysctl(mib, std::size(mib), &info, &length, nullptr, 0) != 0 ||
+      length != sizeof(info) || info.p_uvalid == 0) {
+    return result;
+  }
+
+  const int page_size = getpagesize();
+  if (page_size <= 0 || info.p_vm_rssize < 0)
+    return result;
+
+  // KERN_PROC2 reports current RSS in pages and ru_maxrss in KiB.
+  // Match the other platforms' zero-initialized result on query failure.
+  base::CheckedNumeric<size_t> resident = info.p_vm_rssize;
+  resident *= page_size;
+  base::CheckedNumeric<size_t> peak = info.p_uru_maxrss;
+  peak *= 1024;
+  if (!resident.AssignIfValid(&result.working_set_size) ||
+      !peak.AssignIfValid(&result.peak_working_set_size)) {
+    return {};
+  }
+  return result;
+}
+
