+def _selected_tool(variable, *fallback):
+  selected = os.environ.get(variable)
+  if selected is None:
+    return _path_in_node_modules(*fallback)
+  if not selected or not os_path.isabs(selected) or not os_path.isfile(selected):
+    raise RuntimeError(variable + ' must name an absolute JavaScript entry file')
+  return selected
