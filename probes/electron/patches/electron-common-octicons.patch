$NetBSD$

Copy the Electron default_app octicons from the selected common
@primer/octicons provider.

Origin: EmberBSD contributors (AI-assisted); not submitted upstream.

--- a/electron/BUILD.gn
+++ b/electron/BUILD.gn
@@ -11,6 +11,7 @@
 import("//testing/test.gni")
 import("//third_party/electron_node/node.gni")
 import("//third_party/ffmpeg/ffmpeg_options.gni")
+import("//third_party/node/node.gni")
 import("//tools/generate_library_loader/generate_library_loader.gni")
 import("//tools/grit/grit_rule.gni")
 import("//tools/grit/repack.gni")
@@ -341,6 +342,14 @@
 
 copy("default_app_octicon_deps") {
   sources = filenames.default_app_octicon_sources
+  if (emberbsd_node_modules != "") {
+    # Use the selected common @primer/octicons provider.
+    sources = []
+    foreach(_source, filenames.default_app_octicon_sources) {
+      sources += [ emberbsd_node_modules + "/" +
+                   rebase_path(_source, "node_modules") ]
+    }
+  }
   outputs = [ "$target_gen_default_app_js/electron/default_app/octicon/{{source_file_part}}" ]
 }
 
