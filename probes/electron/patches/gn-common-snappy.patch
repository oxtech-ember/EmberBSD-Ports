--- a/build/linux/unbundle/snappy.gn
+++ b/build/linux/unbundle/snappy.gn
@@ -3,6 +3,28 @@
 # found in the LICENSE file.
 
 import("//build/shim_headers.gni")
+import("//build/config/linux/pkg_config.gni")
+import("//build/config/emberbsd_codecs.gni")
+
+declare_args() {
+  emberbsd_common_snappy = false
+  emberbsd_snappy_host_libraries = []
+  emberbsd_snappy_host_inputs = []
+  emberbsd_snappy_target_libraries = []
+  emberbsd_snappy_target_inputs = []
+}
+assert(emberbsd_common_snappy, "A selected common Snappy provider is required")
+
+emberbsd_codec_provider("emberbsd_snappy") {
+  host_libraries = emberbsd_snappy_host_libraries
+  host_inputs = emberbsd_snappy_host_inputs
+  target_libraries = emberbsd_snappy_target_libraries
+  target_inputs = emberbsd_snappy_target_inputs
+}
+pkg_config("system_snappy") {
+  packages = [ "snappy" ]
+  ignore_libs = true
+}
 
 shim_headers("snappy_shim") {
   root_path = "src"
@@ -15,6 +37,6 @@
 }
 
 source_set("snappy") {
-  deps = [ ":snappy_shim" ]
-  libs = [ "snappy" ]
+  public_deps = [ ":emberbsd_snappy", ":snappy_shim" ]
+  public_configs = [ ":system_snappy" ]
 }
