+// Constant array constructors retain each element after checked size conversion.
+TEST_F(IntermNodeTest, ConstantArrayConstructorValues)
+{
+    TType scalarType(EbtInt, EbpHigh, EvqConst);
+    TType arrayType(scalarType);
+    arrayType.makeArray(2);
+
+    TConstantUnion *first = new TConstantUnion[1];
+    first[0].setIConst(11);
+    TConstantUnion *second = new TConstantUnion[1];
+    second[0].setIConst(19);
+    TIntermAggregate *constructor = TIntermAggregate::CreateConstructor(
+        arrayType, {new TIntermConstantUnion(first, scalarType),
+                    new TIntermConstantUnion(second, scalarType)});
+
+    ASSERT_TRUE(constructor->hasConstantValue());
+    const TConstantUnion *values = constructor->getConstantValue();
+    ASSERT_NE(nullptr, values);
+    EXPECT_EQ(11, values[0].getIConst());
+    EXPECT_EQ(19, values[1].getIConst());
+}
+
+// Insertions keep statement order with and without an existing spare slot.
+TEST_F(IntermNodeTest, InsertStatementsAtEveryPosition)
+{
+    for (bool spareCapacity : {false, true})
+    {
+        TIntermBlock block;
+        if (spareCapacity)
+        {
+            block.getSequence()->reserve(8);
+        }
+        TIntermNode *first = createTestSymbol();
+        TIntermNode *middle = createTestSymbol();
+        TIntermNode *last = createTestSymbol();
+        TIntermNode *before = createTestSymbol();
+        TIntermNode *after = createTestSymbol();
+        block.appendStatement(first);
+        block.appendStatement(last);
+        block.insertStatement(1, middle);
+        block.insertStatement(0, before);
+        block.insertStatement(block.getSequence()->size(), after);
+
+        const TIntermSequence &statements = *block.getSequence();
+        ASSERT_EQ(5u, statements.size());
+        EXPECT_EQ(before, statements[0]);
+        EXPECT_EQ(first, statements[1]);
+        EXPECT_EQ(middle, statements[2]);
+        EXPECT_EQ(last, statements[3]);
+        EXPECT_EQ(after, statements[4]);
+    }
+}
