+
+TEST_P(Base64Test, RoundTripAcrossSimdBoundaries) {
+  for (size_t length : {size_t{0}, size_t{1}, size_t{2}, size_t{3},
+                        size_t{15}, size_t{16}, size_t{17}, size_t{31},
+                        size_t{32}, size_t{33}, size_t{63}, size_t{64},
+                        size_t{65}, size_t{127}, size_t{128}, size_t{129}}) {
+    std::string input(length, '\0');
+    for (size_t i = 0; i < length; ++i) {
+      input[i] = static_cast<char>(i & 0xff);
+    }
+    const std::string encoded = Base64Encode(input);
+    EXPECT_EQ(4 * ((length + 2) / 3), encoded.size());
+    std::string decoded;
+    ASSERT_TRUE(Base64Decode(encoded, &decoded));
+    EXPECT_EQ(input, decoded);
+  }
+}
 
