--- a/BUILD.gn
+++ b/BUILD.gn
@@ -40,6 +40,13 @@
   # NetBSD provides major/minor/makedev through <sys/types.h>.
   if (!is_netbsd) {
     cflags += [ "-DMAJOR_IN_SYSMACROS=1" ]
+  } else {
+    # libdrm has no NetBSD bus parsers; its #warning stubs are expected.
+    cflags += [
+      "-Wno-#warnings",
+      # Helpers used only by Linux sysfs paths are unused on NetBSD.
+      "-Wno-unused-function",
+    ]
   }
 
