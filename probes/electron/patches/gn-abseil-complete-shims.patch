--- a/build/ember_absl_shim.gni
+++ b/build/ember_absl_shim.gni
@@ -0,0 +1,15 @@
+import("//build/shim_headers.gni")
+
+declare_args() {
+  emberbsd_abseil_host_headers = []
+  emberbsd_abseil_target_headers = []
+  emberbsd_abseil_host_inputs = []
+  emberbsd_abseil_target_inputs = []
+}
+
+template("absl_shim_headers") {
+  shim_headers(target_name) {
+    forward_variables_from(invoker, "*")
+    extra_deps = [ "//build/config/ember_abseil:complete" ]
+  }
+}
--- a/build/config/ember_abseil/BUILD.gn
+++ b/build/config/ember_abseil/BUILD.gn
@@ -0,0 +1,30 @@
+import("//build/ember_absl_shim.gni")
+
+assert(emberbsd_pkg_config_role != "upstream", "Select an explicit Abseil package role")
+if (emberbsd_pkg_config_role == "native") {
+  _headers = emberbsd_abseil_host_headers
+  _inputs = emberbsd_abseil_host_inputs
+} else {
+  assert(emberbsd_pkg_config_role == "explicit" || emberbsd_pkg_config_role == "target")
+  _headers = emberbsd_abseil_target_headers
+  _inputs = emberbsd_abseil_target_inputs
+}
+assert(_headers != [], "Selected Abseil package inventory is empty")
+_root = "$root_gen_dir/shim_headers/complete_abseil"
+config("config") {
+  include_dirs = [ _root ]
+}
+action("headers") {
+  script = "//tools/generate_shim_headers/generate_shim_headers.py"
+  inputs = _inputs
+  args = [ "--generate", "--headers-root", rebase_path("//third_party/abseil-cpp"),
+           "--output-directory", rebase_path(_root) ] + _headers
+  outputs = []
+  foreach(_header, _headers) {
+    outputs += [ "$_root/third_party/abseil-cpp/$_header" ]
+  }
+}
+group("complete") {
+  deps = [ ":headers" ]
+  all_dependent_configs = [ ":config" ]
+}
