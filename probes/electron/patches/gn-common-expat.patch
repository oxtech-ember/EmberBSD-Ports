--- /dev/null
+++ b/build/linux/unbundle/expat.gn
@@ -0,0 +1,32 @@
+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+import("//build/config/emberbsd_codecs.gni")
+
+declare_args() {
+  emberbsd_common_expat = false
+  emberbsd_expat_host_libraries = []
+  emberbsd_expat_host_inputs = []
+  emberbsd_expat_target_libraries = []
+  emberbsd_expat_target_inputs = []
+}
+assert(emberbsd_common_expat, "A selected common Expat provider is required")
+
+emberbsd_codec_provider("emberbsd_expat") {
+  host_libraries = emberbsd_expat_host_libraries
+  host_inputs = emberbsd_expat_host_inputs
+  target_libraries = emberbsd_expat_target_libraries
+  target_inputs = emberbsd_expat_target_inputs
+}
+pkg_config("expat_config") {
+  packages = [ "expat" ]
+  ignore_libs = true
+}
+source_set("expat") {
+  visibility = [
+    ":*",
+    "//skia:*",
+    "//third_party/libjingle_xmpp:*",
+    "//third_party/wayland:*",
+  ]
+  public_deps = [ ":emberbsd_expat" ]
+  public_configs = [ ":expat_config" ]
+}
