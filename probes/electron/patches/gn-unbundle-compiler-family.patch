Chromium: keep the unbundled host compiler independent of the target.

Origin: EmberBSD (AI-assisted), Chromium 152.0.7977.167; not submitted upstream.
Apply after gn-unbundle-readelf.patch and gn-unbundle-asmflags.patch.
Clang is the host default; GCC requires unbundle_host_is_clang=false.
The target keeps Chromium's existing is_clang selector.
Compiler paths, flags, runtime and ABI remain the caller's SDK inputs.

--- a/build/toolchain/linux/unbundle/BUILD.gn
+++ b/build/toolchain/linux/unbundle/BUILD.gn
@@ -4,6 +4,12 @@
 
 import("//build/toolchain/gcc_toolchain.gni")
 
+# The target keeps Chromium's is_clang argument. Native tools select their own
+# compiler mode, so a GCC target does not silently change the host compiler.
+declare_args() {
+  unbundle_host_is_clang = true
+}
+
 gcc_toolchain("default") {
   cc = getenv("CC")
   cxx = getenv("CXX")
@@ -43,6 +49,7 @@
   extra_ldflags = getenv("BUILD_LDFLAGS")
 
   toolchain_args = {
+    is_clang = unbundle_host_is_clang
     current_cpu = current_cpu
     current_os = current_os
   }
