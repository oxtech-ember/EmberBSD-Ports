+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+
+// UNSUPPORTED: c++03, c++11, c++14
+// A non-assignable first element must not instantiate assignment traits on an
+// incomplete second element. Ordinary pairs retain their assignment operations.
+
+#include <string>
+#include <type_traits>
+#include <utility>
+struct Value;
+struct Proxy { std::pair<const std::string&, Value&> ref; };
+struct Value {
+  Value& operator=(const Value&) = delete;
+  Value& operator=(Value&&) = default;
+};
+using ReferencePair = decltype(Proxy::ref);
+static_assert(!std::is_copy_assignable<ReferencePair>::value);
+static_assert(!std::is_move_assignable<ReferencePair>::value);
+static_assert(std::is_copy_assignable_v<std::pair<int, int>>);
+static_assert(std::is_move_assignable_v<std::pair<int, int>>);
+static_assert(!std::is_copy_assignable_v<std::pair<const int, int>>);
+static_assert(!std::is_move_assignable_v<std::pair<const int, int>>);
+int assign_pair() {
+  std::pair<int, int> first{1, 2}, second{3, 4};
+  first = second;
+  second = std::pair<int, int>{5, 6};
+  return first.first + first.second + second.first + second.second;
+}
