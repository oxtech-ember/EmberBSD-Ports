--- /dev/null
+++ b/electron/script/normalize-flatbuffer-namespace.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+# Copyright 2026 EmberBSD contributors.
+# Use of this source code is governed by a BSD-style license.
+"""Apply LiteRT's configuration schema namespace transformation."""
+
+import os
+from pathlib import Path
+import sys
+import tempfile
+
+source, destination = map(Path, sys.argv[1:])
+data = source.read_bytes()
+old = b"tflite.proto"
+if old not in data:
+    raise SystemExit("configuration schema lacks expected namespace")
+data = data.replace(old, b"tflite")
+if not destination.is_file() or destination.read_bytes() != data:
+    destination.parent.mkdir(parents=True, exist_ok=True)
+    fd, name = tempfile.mkstemp(dir=destination.parent, prefix=".configuration-")
+    try:
+        with os.fdopen(fd, "wb") as output:
+            output.write(data)
+        os.replace(name, destination)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
