+// A persistent watch must deliver both callbacks without invalidating the
+// controller's weak pointers after each dispatch.
+TEST_F(MessagePumpGLibFdWatchTest, PersistentReadWrite) {
+  auto pump = std::make_unique<MessagePumpGlib>();
+  auto controller =
+      std::make_unique<MessagePumpGlib::FdWatchController>(FROM_HERE);
+  int reads = 0;
+  int writes = 0;
+  FdCallbackWatcher watcher(BindLambdaForTesting([&] { ++reads; }),
+                            BindLambdaForTesting([&] { ++writes; }));
+  ASSERT_TRUE(pump->WatchFileDescriptor(
+      pipefds_[1], true, MessagePumpGlib::WATCH_READ_WRITE, controller.get(),
+      &watcher));
+
+  SimulateEvent(pump.get(), controller.get());
+  EXPECT_EQ(reads, 1);
+  EXPECT_EQ(writes, 1);
+  SimulateEvent(pump.get(), controller.get());
+  EXPECT_EQ(reads, 2);
+  EXPECT_EQ(writes, 2);
+}
+
+// Unlike a one-shot watch, a persistent READ_WRITE watch enters the branch
+// that must check for destruction between the two callbacks.
+TEST_F(MessagePumpGLibFdWatchTest, PersistentDeleteControllerOnWrite) {
+  auto pump = std::make_unique<MessagePumpGlib>();
+  auto controller =
+      std::make_unique<MessagePumpGlib::FdWatchController>(FROM_HERE);
+  int reads = 0;
+  int writes = 0;
+  FdCallbackWatcher watcher(BindLambdaForTesting([&] { ++reads; }),
+                            BindLambdaForTesting([&] {
+                              ++writes;
+                              controller.reset();
+                            }));
+  ASSERT_TRUE(pump->WatchFileDescriptor(
+      pipefds_[1], true, MessagePumpGlib::WATCH_READ_WRITE, controller.get(),
+      &watcher));
+
+  SimulateEvent(pump.get(), controller.get());
+  EXPECT_FALSE(controller);
+  EXPECT_EQ(reads, 0);
+  EXPECT_EQ(writes, 1);
+}
+
