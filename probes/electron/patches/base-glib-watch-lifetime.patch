+// Callbacks can delete or replace a controller without leaving a raw pointer
+// in the watcher itself.
+class FdCallbackWatcher : public MessagePumpGlib::FdWatcher {
+ public:
+  FdCallbackWatcher(RepeatingClosure on_read, RepeatingClosure on_write)
+      : on_read_(std::move(on_read)), on_write_(std::move(on_write)) {}
+
+  void OnFileCanReadWithoutBlocking(int /* fd */) override { on_read_.Run(); }
+  void OnFileCanWriteWithoutBlocking(int /* fd */) override { on_write_.Run(); }
+
+ private:
+  RepeatingClosure on_read_;
+  RepeatingClosure on_write_;
+};
