+}
+
+// The nested dispatch must not remove the outer dispatch's destruction check.
+// ASan detects the old implementation's use of the controller after reset().
+TEST_F(MessagePumpGLibFdWatchTest, PersistentNestedDispatchDeletesController) {
+  auto pump = std::make_unique<MessagePumpGlib>();
+  auto controller =
+      std::make_unique<MessagePumpGlib::FdWatchController>(FROM_HERE);
+  int reads = 0;
+  int writes = 0;
+  FdCallbackWatcher watcher(BindLambdaForTesting([&] { ++reads; }),
+                            BindLambdaForTesting([&] {
+                              if (++writes == 1) {
+                                SimulateEvent(pump.get(), controller.get());
+                                controller.reset();
+                              }
+                            }));
+  ASSERT_TRUE(pump->WatchFileDescriptor(
+      pipefds_[1], true, MessagePumpGlib::WATCH_READ_WRITE, controller.get(),
+      &watcher));
+
+  SimulateEvent(pump.get(), controller.get());
+  EXPECT_FALSE(controller);
+  EXPECT_EQ(reads, 1);
+  EXPECT_EQ(writes, 2);
+}
+
+// Reuse the same storage to detect a stale notification without depending on
+// an allocator's reuse policy. The outer event belongs to the old controller.
+TEST_F(MessagePumpGLibFdWatchTest, PersistentNestedDispatchReplacesController) {
+  using Controller = MessagePumpGlib::FdWatchController;
+  auto pump = std::make_unique<MessagePumpGlib>();
+  alignas(Controller) unsigned char storage[sizeof(Controller)];
+  auto destroy_in_place = [](Controller* value) { std::destroy_at(value); };
+  std::unique_ptr<Controller, decltype(destroy_in_place)> controller(
+      new (storage) Controller(FROM_HERE), destroy_in_place);
+  int reads = 0;
+  int writes = 0;
+  FdCallbackWatcher watcher(BindLambdaForTesting([&] { ++reads; }),
+                            BindLambdaForTesting([&] {
+                              if (++writes == 1) {
+                                SimulateEvent(pump.get(), controller.get());
+                                controller.reset();
+                                controller.reset(
+                                    new (storage) Controller(FROM_HERE));
+                                ASSERT_TRUE(pump->WatchFileDescriptor(
+                                    pipefds_[1], true,
+                                    MessagePumpGlib::WATCH_READ_WRITE,
+                                    controller.get(), &watcher));
+                              }
+                            }));
+  ASSERT_TRUE(pump->WatchFileDescriptor(
+      pipefds_[1], true, MessagePumpGlib::WATCH_READ_WRITE, controller.get(),
+      &watcher));
+
+  SimulateEvent(pump.get(), controller.get());
+  EXPECT_EQ(reads, 1);
+  EXPECT_EQ(writes, 2);
+
+  SimulateEvent(pump.get(), controller.get());
+  EXPECT_EQ(reads, 2);
+  EXPECT_EQ(writes, 3);
+}
