Chromium: use actual GN outputs for objects and PCH.

Origin: EmberBSD (AI-assisted), not submitted upstream.
Requires GN 2610nb1 from the common Ports recipe.
Preserves additional compiler outputs and real Clang module tools.
Keep upstream BSD-style copyright and license.

--- a/build/toolchain/gcc_toolchain.gni
+++ b/build/toolchain/gcc_toolchain.gni
@@ -349,7 +349,7 @@
 
     # -fmodule-name is not supported by gcc.
     module_name_flag = ""
-    if (is_clang) {
+    if (is_clang && use_clang_modules) {
       module_name_flag = " -fmodule-name=\"{{cc_module_name}}_Private\""
     }
 
@@ -372,12 +372,12 @@
 
     tool("cc") {
       output = "$object_subdir/{{source_name_part}}.o"
-      depfile = "$output.d"
+      depfile = "{{output}}.d"
       precompiled_header_type = "gcc"
 
-      # {{output}} may contain .dwo file, so use $output instead of {{output}}
-      # in command.
-      command = "$coverage_wrapper$cc $md -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}}${extra_cppflags}${extra_cflags}${module_name_flag} -c {{source}} -o $output"
+      # GN selects the object or language-specific PCH output. Compiler
+      # sidecars are implicit Ninja outputs and are excluded from {{output}}.
+      command = "$coverage_wrapper$cc $md -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_c}}${extra_cppflags}${extra_cflags}${module_name_flag} -c {{source}} -o {{output}}"
       depsformat = "gcc"
       description = "CC {{output}}"
       outputs = [ output ]
@@ -385,12 +385,12 @@
 
     tool("cxx") {
       output = "$object_subdir/{{source_name_part}}.o"
-      depfile = "$output.d"
+      depfile = "{{output}}.d"
       precompiled_header_type = "gcc"
 
-      # {{output}} may contain .dwo file, so use $output instead of {{output}}
-      # in command.
-      command = "$coverage_wrapper$cxx $md -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}}${extra_cppflags}${extra_cxxflags} {{module_deps}}${module_name_flag} -c {{source}} -o $output"
+      # GN selects the object or language-specific PCH output. Compiler
+      # sidecars are implicit Ninja outputs and are excluded from {{output}}.
+      command = "$coverage_wrapper$cxx $md -MF $depfile {{defines}} {{include_dirs}} {{cflags}} {{cflags_cc}}${extra_cppflags}${extra_cxxflags} {{module_deps}}${module_name_flag} -c {{source}} -o {{output}}"
       depsformat = "gcc"
       description = "CXX {{output}}"
       outputs = [ output ]
