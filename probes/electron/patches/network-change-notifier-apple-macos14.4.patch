net: use NetworkPathMonitor for macOS 14.4+ deployment targets

SCNetworkReachability is deprecated starting with macOS 14.4. Compile the
legacy fallback only for older macOS targets; modern-only targets must keep
NetworkPathMonitor active because there is no legacy implementation.

--- a/net/base/network_change_notifier_apple_buildflags.h
+++ b/net/base/network_change_notifier_apple_buildflags.h
@@ -12,10 +12,14 @@
 // When defined, NetworkChangeNotifier uses the legacy SCNetworkReachability API
 // for network change notifications. When this is not defined, the notifier
 // uses the newer NetworkPathMonitor API.
-#if BUILDFLAG(IS_MAC) || !defined(__IPHONE_17_4) || \
-    __IPHONE_OS_VERSION_MIN_REQUIRED < __IPHONE_17_4
+#if BUILDFLAG(IS_MAC)
+#if __MAC_OS_X_VERSION_MIN_REQUIRED < 140400
 #define COMPILE_OLD_NOTIFIER_IMPL 1
-#endif  // BUILDFLAG(IS_MAC) || !defined(__IPHONE_17_4) ||
-        // __IPHONE_OS_VERSION_MIN_REQUIRED < __IPHONE_17_4
+#endif  // __MAC_OS_X_VERSION_MIN_REQUIRED < 140400
+#elif BUILDFLAG(IS_IOS) && \
+    (!defined(__IPHONE_17_4) || \
+     __IPHONE_OS_VERSION_MIN_REQUIRED < __IPHONE_17_4)
+#define COMPILE_OLD_NOTIFIER_IMPL 1
+#endif  // BUILDFLAG(IS_MAC) / BUILDFLAG(IS_IOS)
 
 #endif  // NET_BASE_NETWORK_CHANGE_NOTIFIER_APPLE_BUILDFLAGS_H_
--- a/net/base/network_change_notifier_apple.mm
+++ b/net/base/network_change_notifier_apple.mm
@@ -624,8 +624,13 @@
 #endif  // defined(COMPILE_OLD_NOTIFIER_IMPL)
 
 bool NetworkChangeNotifierApple::ShouldUseNetworkPathMonitor() const {
+#if defined(COMPILE_OLD_NOTIFIER_IMPL)
   return base::FeatureList::IsEnabled(
       features::kUseNetworkPathMonitorForNetworkChangeNotifier);
+#else
+  // There is no legacy notifier in modern-only builds.
+  return true;
+#endif  // defined(COMPILE_OLD_NOTIFIER_IMPL)
 }
 
 bool NetworkChangeNotifierApple::EnsureNetworkPathMonitorStarted() {
--- a/net/base/network_change_notifier_apple_unittest.cc
+++ b/net/base/network_change_notifier_apple_unittest.cc
@@ -396,13 +396,30 @@
 };
 
 TEST_F(NetworkChangeNotifierApplePathMonitorTest,
+       FeatureDefaultMatchesNotifierImplementation) {
+  const auto default_state =
+      features::kUseNetworkPathMonitorForNetworkChangeNotifier.default_state;
+#if defined(COMPILE_OLD_NOTIFIER_IMPL)
+  EXPECT_EQ(base::FEATURE_DISABLED_BY_DEFAULT, default_state);
+#else
+  EXPECT_EQ(base::FEATURE_ENABLED_BY_DEFAULT, default_state);
+#endif
+}
+
+TEST_F(NetworkChangeNotifierApplePathMonitorTest,
        MonitorDisabledWhenFeatureOff) {
   AddScopedFeatureList().InitAndDisableFeature(
       features::kUseNetworkPathMonitorForNetworkChangeNotifier);
 
   auto notifier = CreateNotifier();
+#if defined(COMPILE_OLD_NOTIFIER_IMPL)
   EXPECT_FALSE(ShouldUseMonitor(notifier.get()));
   EXPECT_FALSE(EnsureMonitorStarted(notifier.get()));
+#else
+  // A modern-only build has no legacy fallback, so it must keep the monitor.
+  EXPECT_TRUE(ShouldUseMonitor(notifier.get()));
+  EXPECT_TRUE(EnsureMonitorStarted(notifier.get()));
+#endif
   StopMonitor(notifier.get());
 }
 
