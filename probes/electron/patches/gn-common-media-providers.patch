--- a/third_party/libyuv/BUILD.gn
+++ b/third_party/libyuv/BUILD.gn
@@ -1,3 +1,33 @@
+# Shared EmberBSD libyuv provider; selected separately for each toolchain role.
+import("//build/config/linux/pkg_config.gni")
+declare_args() {
+  emberbsd_libyuv_host_library = ""
+  emberbsd_libyuv_target_library = ""
+  emberbsd_libyuv_host_headers = ""
+  emberbsd_libyuv_target_headers = ""
+  emberbsd_libyuv_host_inputs = []
+  emberbsd_libyuv_target_inputs = []
+}
+if (emberbsd_pkg_config_role != "upstream") {
+  _library = emberbsd_libyuv_target_library
+  _headers = emberbsd_libyuv_target_headers
+  _inputs = emberbsd_libyuv_target_inputs
+  if (emberbsd_pkg_config_role == "native") {
+    _library = emberbsd_libyuv_host_library
+    _headers = emberbsd_libyuv_host_headers
+    _inputs = emberbsd_libyuv_host_inputs
+  }
+  assert(_library != "" && _headers != "" && _inputs != [],
+         "Selected libyuv provider is incomplete")
+  config("emberbsd_libyuv_config") {
+    include_dirs = [ "include" ]
+    libs = [ _library ]
+  }
+  source_set("libyuv") {
+    inputs = _inputs
+    all_dependent_configs = [ ":emberbsd_libyuv_config" ]
+  }
+} else {
