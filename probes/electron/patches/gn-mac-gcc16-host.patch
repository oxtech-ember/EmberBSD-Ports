Chromium: add explicit native macOS GCC16 compiler families.

Origin: EmberBSD (AI-assisted), not submitted upstream.
Source: Chromium 88173c9141d8c62936a1796b58d3fe3b9e60a1ab.
Apply after the carried linker-launcher and host debug-fission patches.
Keep the upstream BSD-style license and copyright notices.
The explicit bindings require an accepted native GCC16 SDK.
This patch does not qualify a compiler or change the NetBSD target ABI.

--- a/build/toolchain/mac/BUILD.gn
+++ b/build/toolchain/mac/BUILD.gn
@@ -7,11 +7,31 @@
 import("//build/toolchain/apple/toolchain.gni")
 import("//build_overrides/build.gni")
 
+# Explicit paths and ordered compiler arguments from an accepted native SDK.
+# Empty inputs preserve the existing toolchains. They do not qualify a compiler.
+declare_args() {
+  mac_gcc_cc = ""
+  mac_gcc_cxx = ""
+  mac_gcc_cc_args = []
+  mac_gcc_cxx_args = []
+  mac_gcc_llvm_bin_path = ""
+}
+
+assert((mac_gcc_cc == "") == (mac_gcc_cxx == ""),
+       "Native GCC needs both qualified compiler paths")
+assert((mac_gcc_cc == "") == (mac_gcc_llvm_bin_path == ""),
+       "Native GCC needs its qualified LLVM utility directory")
+if (mac_gcc_cc == "") {
+  assert(mac_gcc_cc_args == [] && mac_gcc_cxx_args == [],
+         "Native GCC arguments need explicit compiler paths")
+}
+
 # Specialisation of the apple_toolchain template to declare the toolchain
 # and its tools to build target for macOS platform.
 template("mac_toolchain") {
   assert(defined(invoker.toolchain_args),
          "Toolchains must declare toolchain_args")
+  _invoker_toolchain_args = invoker.toolchain_args
 
   apple_toolchain(target_name) {
     forward_variables_from(invoker, "*", [ "toolchain_args" ])
@@ -19,13 +39,13 @@
     bin_path = mac_bin_path
 
     toolchain_args = {
-      forward_variables_from(invoker.toolchain_args, "*")
+      forward_variables_from(_invoker_toolchain_args, "*")
       current_os = "mac"
 
-      # EmberBSD cross profile (E12): the target build sets is_clang=false
-      # globally for its GCC toolchain; the file-scope args override would
-      # leak into this macOS host toolchain. The host stays Clang.
-      is_clang = true
+      # Keep compiler selection local to this toolchain.
+      if (!defined(_invoker_toolchain_args.is_clang)) {
+        is_clang = true
+      }
 
       # The cross target can enable split DWARF, but this macOS host toolchain
       # does not emit .dwo files. Keep it on the Apple default.
@@ -103,3 +123,44 @@
     v8_current_cpu = "arm64"
   }
 }
+
+# Select these labels only after native SDK and driver/runtime acceptance.
+# The target NetBSD toolchain keeps its independent compiler and libc++ policy.
+template("mac_gcc_toolchain") {
+  mac_toolchain(target_name) {
+    cc = mac_gcc_cc
+    cxx = mac_gcc_cxx
+    cc_args = mac_gcc_cc_args
+    cxx_args = mac_gcc_cxx_args
+    llvm_bin_path = mac_gcc_llvm_bin_path
+    toolchain_args = {
+      forward_variables_from(invoker.toolchain_args, "*")
+      is_clang = false
+      use_custom_libcxx = false
+      use_custom_libcxx_for_host = false
+      # Host generators use the platform allocator instead of the Apple shim.
+      # The independent NetBSD target keeps its allocator policy.
+      use_partition_alloc = false
+      use_allocator_shim = false
+      use_partition_alloc_as_malloc = false
+      use_reclient = false
+      cc_wrapper = ""
+      # The qualified GCC driver selects its configured Mach-O linker.
+      use_lld = false
+    }
+  }
+}
+
+if (mac_gcc_cc != "") {
+  mac_gcc_toolchain("gcc_arm64") {
+    toolchain_args = {
+      current_cpu = "arm64"
+    }
+  }
+  mac_gcc_toolchain("gcc_arm64_v8_x64") {
+    toolchain_args = {
+      current_cpu = "arm64"
+      v8_current_cpu = "x64"
+    }
+  }
+}
