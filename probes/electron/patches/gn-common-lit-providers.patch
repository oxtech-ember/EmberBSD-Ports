+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+# Origin: EmberBSD (AI-assisted).
+"""Validate the selected Lit module versions before a build action."""
+import json
+import os
+
+
+def validate(root, versions):
+    if not os.path.isabs(root) or not versions:
+        raise ValueError('common Lit needs an absolute path and versions')
+    for item in versions:
+        name, version = item.rsplit('@', 1)
+        with open(os.path.join(root, name, 'package.json'), encoding='utf-8') as f:
+            metadata = json.load(f)
+        if metadata.get('name') != name or metadata.get('version') != version:
+            raise ValueError('common Lit provider identity changed: ' + name)
