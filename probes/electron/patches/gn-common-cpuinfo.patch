@@ -0,0 +1,22 @@
+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+import("//build/config/emberbsd_codecs.gni")
+
+import("//build/config/emberbsd_cpuinfo.gni")
+
+assert(emberbsd_common_cpuinfo, "A selected common CPUINFO provider is required")
+
+emberbsd_codec_provider("emberbsd_cpuinfo") {
+  host_libraries = emberbsd_cpuinfo_host_libraries
+  host_inputs = emberbsd_cpuinfo_host_inputs
+  target_libraries = emberbsd_cpuinfo_target_libraries
+  target_inputs = emberbsd_cpuinfo_target_inputs
+}
+pkg_config("cpuinfo_config") {
+  packages = [ "libcpuinfo" ]
+  ignore_libs = true
+}
+# Both components link the same shared provider, preserving pre-sandbox state.
+source_set("cpuinfo") {
+  public_deps = [ ":emberbsd_cpuinfo" ]
+  public_configs = [ ":cpuinfo_config" ]
+}
