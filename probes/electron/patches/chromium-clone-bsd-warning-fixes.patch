+TEST_F(StructTest, CloneBoolVector) {
+  std::vector<bool> empty;
+  EXPECT_TRUE(mojo::Clone(empty).empty());
+
+  std::vector<bool> input(130, false);
+  input[0] = true;
+  input[63] = true;
+  input[64] = true;
+  input[129] = true;
+  auto clone = mojo::Clone(input);
+  EXPECT_EQ(input, clone);
+  clone[64] = false;
+  EXPECT_TRUE(input[64]);
+  EXPECT_FALSE(clone[64]);
+
+  std::vector<std::vector<bool>> nested{input, empty};
+  EXPECT_EQ(nested, mojo::Clone(nested));
+}
