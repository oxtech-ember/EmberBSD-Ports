+TEST(DeviceBoundSessionsMojomTraitsTest, RejectsUnknownEventTypeTag) {
+  using Details = net::device_bound_sessions::SessionEventTypeDetails;
+  using Challenge = net::device_bound_sessions::ChallengeEventDetails;
+  using Data = network::mojom::internal::DeviceBoundSessionEventTypeDetails_Data;
+  using DataView = network::mojom::DeviceBoundSessionEventTypeDetailsDataView;
+
+  for (uint32_t tag : {4u, std::numeric_limits<uint32_t>::max()}) {
+    Data input;
+    input.size = sizeof(input);
+    input.tag = static_cast<Data::DeviceBoundSessionEventTypeDetails_Tag>(tag);
+    DataView view(&input, nullptr);
+    Details output = Challenge(net::device_bound_sessions::ChallengeResult::kSuccess,
+                               "unchanged");
+
+    EXPECT_FALSE((UnionTraits<DataView, Details>::Read(view, &output)));
+    ASSERT_TRUE(std::holds_alternative<Challenge>(output));
+    EXPECT_EQ(std::get<Challenge>(output).challenge, "unchanged");
+    EXPECT_EQ(std::get<Challenge>(output).challenge_result,
+              net::device_bound_sessions::ChallengeResult::kSuccess);
+  }
+}
+
