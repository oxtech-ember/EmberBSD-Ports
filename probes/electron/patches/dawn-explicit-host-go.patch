+"""Host Go selection and source-generator invocation contracts."""
+
+import importlib.util
+import os
+from pathlib import Path
+import sys
+from types import SimpleNamespace
+import unittest
+from unittest.mock import patch
+
+
+DAWN_ROOT = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location(
+    'generate_sources_gn', DAWN_ROOT / 'tools/generate-sources-gn.py')
+generator = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(generator)
+cipd_deps = generator.cipd_deps
+
+
+class GenerateSourcesGnTests(unittest.TestCase):
+    def setUp(self):
+        self.clear_platform_cache()
+        self.addCleanup(self.clear_platform_cache)
+
+    def clear_platform_cache(self):
+        for function in (cipd_deps.get_cipd_platform,
+                         cipd_deps.get_cipd_compatible_current_os,
+                         cipd_deps.get_cipd_compatible_current_arch):
+            function.cache_clear()
+
+    def invoke(self, arguments, *, host='darwin', machine='arm64', status=0):
+        observed = {}
+
+        def run(command, **options):
+            observed.update(command=command, options=options,
+                            modules=os.environ['GO111MODULE'],
+                            cgo=os.environ['CGO_ENABLED'])
+            return SimpleNamespace(returncode=status)
+
+        with patch.object(sys, 'argv', ['generate-sources-gn.py', *arguments]), \
+                patch.object(sys, 'platform', host), \
+                patch.object(cipd_deps.platform, 'machine', return_value=machine), \
+                patch.object(cipd_deps.platform, 'processor', return_value=''), \
+                patch.object(generator.os, 'getcwd', return_value='/build dir'), \
+                patch.dict(os.environ, GO111MODULE='off', CGO_ENABLED='1'), \
+                patch.object(generator.subprocess, 'run', side_effect=run):
+            result = generator.main()
+        return result, observed
+
+    def test_default_uses_the_current_host_cipd_package(self):
+        for host, machine, package, executable in (
+                ('darwin', 'arm64', 'mac-arm64', 'go'),
+                ('linux', 'x86_64', 'linux-amd64', 'go'),
+                ('win32', 'AMD64', 'windows-amd64', 'go.exe')):
+            with self.subTest(host=host):
+                self.clear_platform_cache()
+                result, observed = self.invoke(['gen'], host=host, machine=machine)
+                self.assertEqual(result, 0)
+                self.assertEqual(observed['command'][0], os.path.join(
+                    str(DAWN_ROOT), 'tools', 'golang', package, 'bin', executable))
+
+    def test_bsd_and_cygwin_cipd_platform_mapping_is_preserved(self):
+        for host, machine, package in (
+                ('linux2', 'x86_64', 'linux-amd64'),
+                ('cygwin', 'x86_64', 'linux-amd64'),
+                ('openbsd7', 'amd64', 'linux-amd64'),
+                ('freebsd14', 'aarch64', 'linux-arm64'),
+                ('netbsd11', 'evbarm', 'linux-arm64')):
+            with self.subTest(host=host), \
+                    patch.object(sys, 'platform', host), \
+                    patch.object(cipd_deps.platform, 'machine', return_value=machine), \
+                    patch.object(cipd_deps.platform, 'processor', return_value=''):
+                self.clear_platform_cache()
+                self.assertEqual(cipd_deps.get_cipd_platform(), package)
+
+    def test_explicit_windows_executable_keeps_its_suffix(self):
+        executable = r'C:\host tools\go.exe'
+        _, observed = self.invoke(['gen', '--go-binary', executable], host='win32')
+        self.assertEqual(observed['command'][0], executable)
+
+    def test_explicit_host_tool_preserves_module_and_output_contract(self):
+        _, observed = self.invoke(['clang_arm64/gen', '--go-binary', '/host tools/go'])
+        self.assertEqual(observed['command'], [
+            '/host tools/go', 'run', './tools/src/cmd/gen/sources',
+            '/build dir/clang_arm64/gen'])
+        self.assertEqual(observed['options'], {'check': False, 'cwd': str(DAWN_ROOT)})
+        self.assertEqual((observed['modules'], observed['cgo']), ('on', '0'))
+
+    def test_generator_exit_status_is_retained(self):
+        result, _ = self.invoke(['gen', '--go-binary', '/host/go'], status=7)
+        self.assertEqual(result, 7)
+
+    def test_empty_explicit_path_is_refused_before_go_start(self):
+        with patch.object(sys, 'argv', ['generate-sources-gn.py', 'gen', '--go-binary', '']), \
+                patch.object(generator.subprocess, 'run') as run:
+            with self.assertRaises(SystemExit) as error:
+                generator.main()
+        self.assertEqual(error.exception.code, 2)
+        run.assert_not_called()
+
+    def test_unknown_default_host_is_refused(self):
+        with self.assertRaisesRegex(ValueError, 'Unknown platform'):
+            self.invoke(['gen'], host='unknown-os')
+
+
+if __name__ == '__main__':
+    unittest.main()
