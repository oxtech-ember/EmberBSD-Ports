# Origin: EmberBSD contributors (AI-assisted); not submitted upstream.
# Derive target runtime paths from final C/C++ link library directories.

--- a/build/toolchain/wrapper_utils.py
+++ b/build/toolchain/wrapper_utils.py
@@ -55,6 +55,58 @@
     return command
 
 
+def AddTargetRuntimeLibraryPaths(command, sysroot):
+    """Append target runtime paths for sysroot -L inputs without changing them."""
+    if not sysroot:
+        return command
+    if not os.path.isabs(sysroot):
+        raise ValueError('runtime sysroot must be absolute')
+    root = os.path.normpath(sysroot)
+    active = set()
+
+    def tokens(args, depth=0):
+        if depth > 32:
+            raise ValueError('link response nesting exceeds limit')
+        for arg in args:
+            if arg.startswith('@') and len(arg) > 1:
+                path = os.path.abspath(arg[1:])
+                if path in active:
+                    raise ValueError('link response file cycle')
+                active.add(path)
+                try:
+                    with open(path, encoding='utf-8') as stream:
+                        yield from tokens(shlex.split(stream.read()), depth + 1)
+                finally:
+                    active.remove(path)
+            else:
+                yield arg
+
+    expanded = iter(tokens(command))
+    flags = []
+    for arg in expanded:
+        if arg == '-L':
+            try:
+                path = next(expanded)
+            except StopIteration:
+                raise ValueError('missing directory after -L')
+        elif arg.startswith('-L') and len(arg) > 2:
+            path = arg[2:]
+        else:
+            continue
+        if not os.path.isabs(path):
+            continue
+        path = os.path.normpath(path)
+        if os.path.commonpath([root, path]) != root or path == root:
+            continue
+        target = '/' + os.path.relpath(path, root)
+        if any(c in target for c in (':', ',', '\n', '\r')):
+            raise ValueError('target runtime directory cannot be represented')
+        flag = '-Wl,-rpath=' + target
+        if flag not in flags:
+            flags.append(flag)
+    return command + flags
+
+
