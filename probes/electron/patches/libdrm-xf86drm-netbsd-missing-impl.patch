libdrm: add NetBSD to the BSD branch in drmParseSubsystemType.

Origin: EmberBSD (AI-assisted), not submitted upstream.
Source: Chromium third_party/libdrm (electron-source) under EmberBSD.
Apply after netbsd-cross-source.libdrm casts.
NetBSD uses PCI bus like the other BSDs; add __NetBSD__ to the existing
elif so drmParseSubsystemType returns DRM_BUS_PCI instead of falling
through to the generic stub.  Remaining bus parsers (USB, OF, faux) are
genuinely unimplemented on NetBSD and their #warning stubs are silenced
at the BUILD.gn target level (libdrm-build-gn-netbsd-warning-flags).

--- a/xf86drm.c
+++ b/xf86drm.c
@@ -3632,7 +3632,7 @@ static int drmParseSubsystemType(int maj, int min)
             return DRM_BUS_VIRTIO;
         strncat(path, "/..", PATH_MAX);
         subsystem_type = get_subsystem_type(path);
         if (subsystem_type < 0)
             return DRM_BUS_VIRTIO;
      }
     return subsystem_type;
-#elif defined(__OpenBSD__) || defined(__DragonFly__) || defined(__FreeBSD__)
+#elif defined(__OpenBSD__) || defined(__DragonFly__) || defined(__FreeBSD__) || defined(__NetBSD__)
     return DRM_BUS_PCI;
 #else
