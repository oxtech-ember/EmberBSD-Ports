libdrm: treat NetBSD like other BSDs in drmParseSubsystemType; silence #warning under -Werror.

Origin: EmberBSD (AI-assisted), not submitted upstream.
Source: Chromium third_party/libdrm (electron-source) under EmberBSD.
Apply after netbsd-cross-source.libdrm casts.
NetBSD hits the generic #else "#warning Missing implementation*" arms under
-Werror. Add __NetBSD__ to the BSD elif for drmParseSubsystemType (PCI bus)
and wrap every Missing-implementation #warning with #if !defined(__NetBSD__).

--- a/xf86drm.c
+++ b/xf86drm.c
@@ -3632,18 +3632,20 @@ static int drmParseSubsystemType(int maj, int min)
             return DRM_BUS_VIRTIO;
         strncat(path, "/..", PATH_MAX);
         subsystem_type = get_subsystem_type(path);
         if (subsystem_type < 0)
             return DRM_BUS_VIRTIO;
      }
     return subsystem_type;
-#elif defined(__OpenBSD__) || defined(__DragonFly__) || defined(__FreeBSD__)
+#elif defined(__OpenBSD__) || defined(__DragonFly__) || defined(__FreeBSD__) || defined(__NetBSD__)
     return DRM_BUS_PCI;
 #else
+#if !defined(__NetBSD__)
 #warning "Missing implementation of drmParseSubsystemType"
+#endif
     return -EINVAL;
 #endif
 }
 
