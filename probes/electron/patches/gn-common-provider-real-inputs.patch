+declare_args() {
+  emberbsd_icuuc_host_library = ""
+  emberbsd_icuuc_target_library = ""
+  emberbsd_icui18n_host_library = ""
+  emberbsd_icui18n_target_library = ""
+}
+
+_emberbsd_icu_selected = emberbsd_pkg_config_role != "upstream"
