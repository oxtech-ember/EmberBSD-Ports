+    _emberbsd_icuuc_library = emberbsd_icuuc_host_library
+    _emberbsd_icui18n_library = emberbsd_icui18n_host_library
+  } else {
+    _emberbsd_icuuc_library = emberbsd_icuuc_target_library
+    _emberbsd_icui18n_library = emberbsd_icui18n_target_library
+  }
+  assert(_emberbsd_icuuc_library != "" && _emberbsd_icui18n_library != "",
+         "Selected ICU libraries are required")
+  config("emberbsd_icuuc_library") {
+    libs = [ _emberbsd_icuuc_library ]
+  }
+  config("emberbsd_icui18n_library") {
+    libs = [ _emberbsd_icui18n_library ]
+  }
+}
+
 pkg_config("system_icui18n") {
   packages = [ "icu-i18n" ]
+  if (_emberbsd_icu_selected) {
+    extra_args = [ "-v", "^-licui18n$" ]
+  }
 }
 
 pkg_config("system_icuuc") {
   packages = [ "icu-uc" ]
+  if (_emberbsd_icu_selected) {
+    extra_args = [ "-v", "^-licuuc$" ]
+  }
 }
 
