$NetBSD$

Select NetBSD's pkgsrc library metadata and libclang target triple for GN's
x64 CPU alongside arm64. GN uses x64 for NetBSD/amd64.
Origin: EmberBSD (AI-assisted), Chromium commit dd78960ccd8a03a2fe1f629543d27783885b78e9; downstream patch, not submitted upstream.

--- a/build/config/linux/pkg_config.gni
+++ b/build/config/linux/pkg_config.gni
@@ -64,7 +64,7 @@
 _pkg_config_sysroot = sysroot
 _pkg_config_system_libdir = system_libdir
-_emberbsd_cross_pkg_config =
-    host_os == "mac" && current_os == "netbsd" && current_cpu == "arm64" &&
-    emberbsd_target_sysroot != ""
+_emberbsd_cross_pkg_config = host_os == "mac" && current_os == "netbsd" &&
+                             (current_cpu == "arm64" || current_cpu == "x64") &&
+                             emberbsd_target_sysroot != ""
 if (_emberbsd_cross_pkg_config) {
   _pkg_config_sysroot = emberbsd_target_sysroot
   _pkg_config_system_libdir = "pkg/lib"
--- a/build/rust/rust_bindgen_generator.gni
+++ b/build/rust/rust_bindgen_generator.gni
@@ -250,6 +250,8 @@
       args += [ "-isystem${emberbsd_target_sysroot}/usr/include" ]
       if (current_os == "netbsd" && current_cpu == "arm64") {
         args += [ "--target=aarch64-unknown-netbsd" ]
+      } else if (current_os == "netbsd" && current_cpu == "x64") {
+        args += [ "--target=x86_64-unknown-netbsd" ]
       }
     }
