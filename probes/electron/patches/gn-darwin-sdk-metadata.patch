+#!/usr/bin/env python3
+# SPDX-License-Identifier: BSD-2-Clause
+# Copyright (c) 2026 EmberBSD contributors.
+# Origin: EmberBSD (AI-assisted), not submitted upstream.
+"""Format explicit SDK metadata for Chromium; do not discover or run tools."""
+import argparse
+import importlib
+import json
+from pathlib import Path
+import re
+import sys
+
+sys.dont_write_bytecode = True
+
+
+def version(value):
+    if re.fullmatch(r'[0-9]+(?:\.[0-9]+){0,2}', value) is None:
+        raise ValueError('invalid minimum macOS SDK version')
+    return tuple((list(map(int, value.split('.'))) + [0, 0])[:3])
+
+
+def gn_string(value):
+    if any(ord(char) < 32 or ord(char) == 127 for char in value):
+        raise ValueError('GN metadata contains a control character')
+    return json.dumps(value, ensure_ascii=False).replace('$', r'\$')
+
+
+def load_reader(source):
+    if not Path(source).is_absolute():
+        raise ValueError('select an absolute SDK source')
+    package = Path(source).resolve(strict=True) / 'src/emberbsd_sdk'
+    sys.path.insert(0, str(package.parent))
+    sdk = importlib.import_module('emberbsd_sdk')
+    if Path(sdk.__file__).resolve() != package / '__init__.py' or type(getattr(sdk, 'API_VERSION', None)) is not int or sdk.API_VERSION != 1:
+        raise ValueError('selected SDK must provide API 1')
+    reader = importlib.import_module('emberbsd_sdk.darwin_sdk')
+    if Path(reader.__file__).resolve() != package / 'darwin_sdk.py' or type(getattr(reader, 'DARWIN_SDK_API', None)) is not int or reader.DARWIN_SDK_API != 1:
+        raise ValueError('selected SDK must provide Darwin SDK API 1')
+    errors = importlib.import_module('emberbsd_sdk.errors')
+    if Path(errors.__file__).resolve() != package / 'errors.py':
+        raise ValueError('SDK error module origin differs')
+    return reader.read_metadata, errors.SDKError
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    for name in ('sdk-source', 'macos-sdk', 'xcode-version-plist', 'minimum-sdk', 'toolchain-bin'):
+        parser.add_argument('--' + name, required=True)
+    args = parser.parse_args()
+    try:
+        tools = Path(args.toolchain_bin)
+        if not tools.is_absolute() or not tools.is_dir():
+            raise ValueError('select an absolute native toolchain bin directory')
+        # This directory is already selected by the recipe's native-prefix
+        # interface. Metadata does not choose or replace any native tool.
+        read_metadata, SDKError = load_reader(args.sdk_source)
+        try:
+            info = read_metadata(args.macos_sdk, xcode_version_plist=args.xcode_version_plist)
+        except SDKError as error:
+            raise ValueError(str(error)) from error
+        if version(info['sdk_version']) < version(args.minimum_sdk):
+            raise ValueError('selected macOS SDK is older than the requested minimum')
+        parts = (info['xcode_version'].split('.') + ['0', '0'])[:3]
+        # Match upstream sdk_info.py FormatVersion/DTXcode, including padding.
+        xcode = ('%2s%s%s' % tuple(parts)).replace(' ', '0')
+        values = dict(sdk_path=info['sdk_path'], sdk_version=info['sdk_version'],
+                      sdk_build=info['sdk_build'], xcode_version=xcode,
+                      xcode_version_int=int(xcode, 10), xcode_build=info['xcode_build'],
+                      bin_path=str(tools.resolve()) + '/')
+        for name, value in sorted(values.items()):
+            print(name + '=' + (gn_string(value) if isinstance(value, str) else str(value)))
+    except (ImportError, OSError, ValueError) as error:
+        print('Darwin GN metadata: ' + str(error), file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
