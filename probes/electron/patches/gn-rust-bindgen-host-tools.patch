$NetBSD$

Restore Chromium's pinned Rust host-tool and libclang roots. Add the EmberBSD
sysroot only when GN generates a NetBSD toolchain whose OS or CPU differs from
its build host.
Origin: EmberBSD (AI-assisted), Chromium 152.0.7977.167; not submitted upstream.

--- a/build/rust/rust_bindgen.gni
+++ b/build/rust/rust_bindgen.gni
@@ -12,14 +12,14 @@ if (is_win) {
   import("//build/toolchain/win/win_toolchain_data.gni")
 }
 
-_bindgen_path = "bindgen"
+_bindgen_path = "${rust_bindgen_root}/bin/bindgen"
 if (host_os == "win") {
   _bindgen_path = "${_bindgen_path}.exe"
 }
 
 # On Windows, the libclang.dll is beside the bindgen.exe, otherwise it is in
 # ../lib.
-_libclang_path = "/usr/pkg"
+_libclang_path = rust_bindgen_root
 if (!use_chromium_rust_toolchain &&
     (current_cpu == "ppc64" || current_cpu == "s390x")) {
   _libclang_path = rust_sysroot_absolute + "/lib64"
--- a/build/rust/rust_bindgen_generator.gni
+++ b/build/rust/rust_bindgen_generator.gni
@@ -11,15 +11,15 @@ import("//build/rust/rust_static_library.gni")
   import("//build/toolchain/win/win_toolchain_data.gni")
 }
 
-_bindgen_path = "bindgen"
+_bindgen_path = "${rust_bindgen_root}/bin/bindgen"
 if (host_os == "win") {
   _bindgen_path = "${_bindgen_path}.exe"
 }
 
-_rustfmt_path = "rustfmt"
+_rustfmt_path = "${rust_bindgen_root}/bin/rustfmt"
 if (!use_chromium_rust_toolchain &&
     (host_cpu == "ppc64" || host_cpu == "s390x")) {
   _rustfmt_path = rust_sysroot_absolute + "/bin/rustfmt"
 } else if (host_os == "win") {
   _rustfmt_path = "${_rustfmt_path}.exe"
 }
@@ -26,6 +26,6 @@ if (!use_chromium_rust_toolchain &&
 # On Windows, the libclang.dll is beside the bindgen.exe, otherwise it is in
 # ../lib.
-_libclang_path = "clang_base_path"
+_libclang_path = rust_bindgen_root
 if (!use_chromium_rust_toolchain &&
     (host_cpu == "ppc64" || host_cpu == "s390x")) {
   _libclang_path = rust_sysroot_absolute + "/lib64"
@@ -244,6 +244,8 @@ template("rust_bindgen_generator") {
     # for the GCC16 cross target. This only configures libclang's parser; target
     # objects are compiled by the GCC16 toolchain.
-    if (emberbsd_target_sysroot != "") {
+    if (is_a_target_toolchain && current_os == "netbsd" &&
+        (current_os != host_os || current_cpu != host_cpu) &&
+        emberbsd_target_sysroot != "") {
       args += [ "-isystem${emberbsd_target_sysroot}/usr/include" ]
       if (current_os == "netbsd" && current_cpu == "arm64") {
         args += [ "--target=aarch64-unknown-netbsd" ]
