+#if defined(USE_SYSTEM_LCMS2)
+// Keep the allocator local to PDFium; other users of the shared library retain
+// their own allocation policy.
+void* CmsAlloc(cmsContext, cmsUInt32Number size) {
+  return FXMEM_DefaultAlloc(size);
+}
+void CmsFree(cmsContext, void* ptr) {
+  if (ptr)
+    FXMEM_DefaultFree(ptr);
+}
+void* CmsRealloc(cmsContext, void* ptr, cmsUInt32Number size) {
+  return FXMEM_DefaultRealloc(ptr, size);
+}
+void* CmsAllocZero(cmsContext context, cmsUInt32Number size) {
+  void* ptr = CmsAlloc(context, size);
+  if (ptr)
+    std::memset(ptr, 0, size);
+  return ptr;
+}
+void* CmsCalloc(cmsContext context, cmsUInt32Number count, cmsUInt32Number size) {
+  if (!count || !size || count > std::numeric_limits<cmsUInt32Number>::max() / size)
+    return nullptr;
+  cmsUInt32Number total = count * size;
+  if (total >= 512u * 1024u * 1024u)
+    return nullptr;
+  return CmsAllocZero(context, total);
+}
+void* CmsDup(cmsContext context, const void* original, cmsUInt32Number size) {
+  void* ptr = CmsAlloc(context, size);
+  if (ptr && original)
+    std::memmove(ptr, original, size);
+  return ptr;
+}
+cmsPluginMemHandler kPdfiumMemoryPlugin = {
+    {cmsPluginMagicNumber, LCMS_VERSION, cmsPluginMemHandlerSig, nullptr},
+    CmsAlloc, CmsFree, CmsRealloc, CmsAllocZero, CmsCalloc, CmsDup};
+struct CmsContextDeleter {
+  void operator()(cmsContext context) { cmsDeleteContext(context); }
+};
+using ScopedCmsContext = std::unique_ptr<std::remove_pointer_t<cmsContext>, CmsContextDeleter>;
+#endif
 
