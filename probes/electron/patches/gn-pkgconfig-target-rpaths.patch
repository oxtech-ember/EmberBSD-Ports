+def TargetRuntimeLibdirs(lib_dirs, sysroot):
+    """Convert selected sysroot library directories to target runtime paths."""
+    root = os.path.normpath(sysroot)
+    result = []
+    for path in lib_dirs:
+        if not os.path.isabs(path) or '..' in path.split('/'):
+            raise ValueError('target library directory must be absolute without traversal')
+        normalized = os.path.normpath(path)
+        if os.path.commonpath([root, normalized]) != root or normalized == root:
+            raise ValueError('target library directory is outside sysroot')
+        target_path = '/' + os.path.relpath(normalized, root)
+        if any(c in target_path for c in (':', ',', '\n', '\r')):
+            raise ValueError('target runtime path cannot be represented as a linker argument')
+        flag = '-Wl,-rpath=' + target_path
+        if flag not in result:
+            result.append(flag)
+    return result
+
