--- /dev/null
+++ b/build/config/emberbsd_codecs.gni
@@ -0,0 +1,53 @@
+# Copyright 2026 EmberBSD contributors. BSD-2-Clause.
+import("//build/config/linux/pkg_config.gni")
+
+declare_args() {
+  emberbsd_common_codecs = false
+  emberbsd_dav1d_host_libraries = []
+  emberbsd_dav1d_host_inputs = []
+  emberbsd_dav1d_target_libraries = []
+  emberbsd_dav1d_target_inputs = []
+  emberbsd_aom_host_libraries = []
+  emberbsd_aom_host_inputs = []
+  emberbsd_aom_target_libraries = []
+  emberbsd_aom_target_inputs = []
+  emberbsd_vpx_host_libraries = []
+  emberbsd_vpx_host_inputs = []
+  emberbsd_vpx_target_libraries = []
+  emberbsd_vpx_target_inputs = []
+  emberbsd_opus_host_libraries = []
+  emberbsd_opus_host_inputs = []
+  emberbsd_opus_target_libraries = []
+  emberbsd_opus_target_inputs = []
+  emberbsd_flac_host_libraries = []
+  emberbsd_flac_host_inputs = []
+  emberbsd_flac_target_libraries = []
+  emberbsd_flac_target_inputs = []
+
+}
+
+template("emberbsd_codec_provider") {
+  not_needed(invoker, "*")
+  if (emberbsd_pkg_config_role == "native") {
+    _libraries = invoker.host_libraries
+    _inputs = invoker.host_inputs
+  } else {
+    _libraries = invoker.target_libraries
+    _inputs = invoker.target_inputs
+  }
+  assert(emberbsd_pkg_config_role != "upstream" && _libraries != [] && _inputs != [],
+         "Selected codec provider is incomplete")
+  _config = "${target_name}_selected"
+  config(_config) {
+    libs = _libraries
+    if (emberbsd_pkg_config_role == "native") {
+      ldflags = [ "-Wl,-rpath=" + rebase_path(get_path_info(_libraries[0], "dir"), "") ]
+    } else {
+      ldflags = [ "-Wl,-rpath=/usr/pkg/lib" ]
+    }
+  }
+  source_set(target_name) {
+    inputs = _inputs
+    all_dependent_configs = [ ":${_config}" ]
+  }
+}
