@@ -1313,6 +1313,16 @@ TEST(StringUtilTest, GetStringFWithOffsets) {
   offsets.clear();
 }
 
+TEST(StringUtilTest, ReplaceStringPlaceholdersReorderedStableOffsets) {
+  const auto subst = std::to_array<std::u16string>({u"A", u"BB", u"CCC"});
+  std::vector<size_t> offsets;
+
+  EXPECT_EQ(u"CCC|A|CCC|BB|A",
+            ReplaceStringPlaceholders(u"$3|$1|$3|$2|$1", subst, &offsets));
+  const std::vector<size_t> expected_offsets = {4, 13, 10, 0, 6};
+  EXPECT_EQ(expected_offsets, offsets);
+}
