+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_FREEBSD) || \
+    BUILDFLAG(IS_NETBSD)
+TEST(KeycodeConverter, EvdevAndXkbCodes) {
+  struct Expected {
+    int evdev;
+    uint32_t xkb;
+    ui::DomCode dom;
+  };
+  constexpr Expected cases[] = {
+      {30, 38, ui::DomCode::US_A},
+      {28, 36, ui::DomCode::ENTER},
+      {29, 37, ui::DomCode::CONTROL_LEFT},
+      {119, 127, ui::DomCode::PAUSE},
+      {164, 172, ui::DomCode::MEDIA_PLAY_PAUSE},
+      {207, 215, ui::DomCode::MEDIA_PLAY},
+  };
+  for (const auto& expected : cases) {
+    EXPECT_EQ(expected.dom, KeycodeConverter::EvdevCodeToDomCode(expected.evdev));
+    EXPECT_EQ(expected.evdev, KeycodeConverter::DomCodeToEvdevCode(expected.dom));
+    EXPECT_EQ(expected.dom, KeycodeConverter::XkbKeycodeToDomCode(expected.xkb));
+    EXPECT_EQ(expected.xkb, KeycodeConverter::DomCodeToXkbKeycode(expected.dom));
+  }
+  EXPECT_EQ(38, KeycodeConverter::DomCodeToNativeKeycode(ui::DomCode::US_A));
+  EXPECT_EQ(ui::DomCode::US_A, KeycodeConverter::NativeKeycodeToDomCode(38));
+}
+
+TEST(KeycodeConverter, InvalidEvdevCodes) {
+  for (int code : {std::numeric_limits<int>::min(), -1, 0, 0x2ff, 0x300,
+                   std::numeric_limits<int>::max()}) {
+    EXPECT_EQ(ui::DomCode::NONE, KeycodeConverter::EvdevCodeToDomCode(code));
+  }
+  EXPECT_EQ(ui::DomCode::NONE, KeycodeConverter::XkbKeycodeToDomCode(7u));
+  EXPECT_EQ(ui::DomCode::NONE, KeycodeConverter::XkbKeycodeToDomCode(8u));
+  EXPECT_EQ(ui::DomCode::NONE, KeycodeConverter::XkbKeycodeToDomCode(
+                                  std::numeric_limits<uint32_t>::max()));
+  EXPECT_EQ(0, KeycodeConverter::DomCodeToEvdevCode(ui::DomCode::NONE));
+  EXPECT_EQ(0, KeycodeConverter::DomCodeToEvdevCode(
+                   static_cast<ui::DomCode>(0xffffff)));
+}
+
+TEST(KeycodeConverter, PlayCdUsesCanonicalPlayCode) {
+  EXPECT_EQ(ui::DomCode::MEDIA_PLAY, KeycodeConverter::EvdevCodeToDomCode(200));
+  EXPECT_EQ(ui::DomCode::MEDIA_PLAY, KeycodeConverter::EvdevCodeToDomCode(207));
+  EXPECT_EQ(207, KeycodeConverter::DomCodeToEvdevCode(ui::DomCode::MEDIA_PLAY));
+}
