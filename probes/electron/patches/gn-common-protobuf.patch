Use one selected common protobuf provider in the active toolchain.
Origin: EmberBSD contributors (AI-assisted).

--- third_party/protobuf/BUILD.gn
+++ third_party/protobuf/BUILD.gn
@@ -9,6 +9,36 @@
 import("proto_library.gni")
 import("proto_sources.gni")
 import("proto_wkt.gni")
+
+declare_args() {
+  emberbsd_common_protobuf = false
+  emberbsd_protobuf_native_prefix = ""
+  emberbsd_protobuf_target_prefix = ""
+  emberbsd_protoc = ""
+}
+
+if (emberbsd_common_protobuf) {
+  import("//build/config/linux/pkg_config.gni")
+  if (emberbsd_pkg_config_role == "native") {
+    assert(current_os == host_os, "Native protobuf requires a native toolchain")
+    assert(current_cpu == host_cpu, "Common native protobuf does not cover this host CPU")
+    _common_protobuf_prefix = emberbsd_protobuf_native_prefix
+  } else {
+    assert(emberbsd_pkg_config_role == "target" ||
+           (emberbsd_pkg_config_role == "explicit" && current_toolchain == default_toolchain),
+           "Common protobuf requires an explicit toolchain role")
+    assert(current_os == target_os && current_cpu == target_cpu,
+           "Common target protobuf does not cover this toolchain ABI")
+    _common_protobuf_prefix = emberbsd_protobuf_target_prefix
+  }
+  assert(_common_protobuf_prefix != "", "Common protobuf requires a selected prefix")
+  config("common_protobuf_config") {
+    include_dirs = [ "$_common_protobuf_prefix/include" ]
+    lib_dirs = [ "$_common_protobuf_prefix/lib" ]
+    libs = [ "protobuf" ]
+    defines = [ "PROTOBUF_USE_DLLS" ]
+  }
+}
 if (enable_js_protobuf) {
