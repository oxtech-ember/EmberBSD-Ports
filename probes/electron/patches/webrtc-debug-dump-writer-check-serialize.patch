webrtc: check SerializeToString result in debug_dump_writer

--- a/third_party/webrtc/modules/audio_coding/audio_network_adaptor/debug_dump_writer.cc
+++ b/third_party/webrtc/modules/audio_coding/audio_network_adaptor/debug_dump_writer.cc
@@ -44,7 +44,7 @@
 void DumpEventToFile(const Event& event, FileWrapper* dump_file) {
   RTC_CHECK(dump_file->is_open());
   std::string dump_data;
-  event.SerializeToString(&dump_data);
+  RTC_CHECK(event.SerializeToString(&dump_data));
   int32_t size = checked_cast<int32_t>(event.ByteSizeLong());
   dump_file->Write(&size, sizeof(size));
   dump_file->Write(dump_data.data(), dump_data.length());
