+TEST_F(AXPositionTest, UnserializeUnknownPositionKind) {
+  TestPositionType position = CreateTreePosition(root_, 1 /* child_index */);
+  ASSERT_NE(nullptr, position);
+  ASSERT_TRUE(position->IsValid());
+
+  for (int kind : {-1, 3}) {
+    auto serialization = position->Serialize();
+    serialization.kind = static_cast<AXPositionKind>(kind);
+    TestPositionType restored = AXNodePosition::Unserialize(serialization);
+    ASSERT_NE(nullptr, restored);
+    EXPECT_TRUE(restored->IsNullPosition());
+    EXPECT_TRUE(restored->IsValid());
+    EXPECT_EQ(AXPositionKind::NULL_POSITION, restored->kind());
+    EXPECT_EQ(kInvalidAXNodeID, restored->anchor_id());
+    EXPECT_EQ(AXNodePosition::INVALID_INDEX, restored->child_index());
+    EXPECT_EQ(AXNodePosition::INVALID_OFFSET, restored->text_offset());
+  }
