+// UNSUPPORTED: c++03
+
+// The allocator header must be parsed while a caller's max macro is active.
+// <limits> preserves the macro. It must not include the allocator header first.
+#include <limits>
+
+#ifdef _LIBCPP___MEMORY_ALLOCATOR_H
+#  error "allocator.h must be included for the first time below"
+#endif
+
+#define max(a, b) allocator_must_preserve_max_macro
+#include <__memory/allocator.h>
+
+#ifndef max
+#  error "allocator.h must preserve the caller's max macro"
+#endif
+#undef max
+
+int* allocate_one() {
+  return std::allocator<int>().allocate(1);
+}
