+// Object byte sizes above PTRDIFF_MAX are not supported, even when the
+// element count does not overflow size_t. Reject them before operator new.
+template <typename T>
+void test_object_size()
+{
+    const std::size_t max_object_count =
+        static_cast<std::size_t>(std::numeric_limits<std::ptrdiff_t>::max()) / sizeof(T);
+    volatile std::size_t just_too_large = max_object_count + 1;
+    volatile std::size_t largest_count = static_cast<std::size_t>(-1) / sizeof(T);
+    DisableAllocationGuard guard;
+    test_max<T>(just_too_large);
+    test_max<T>(largest_count);
+}
+
+struct TEST_ALIGNAS(64) OverAligned {
+    char data[64];
+};
+
 int main(int, char**)
 {
     test<double>();
+    test_object_size<char>();
+    test_object_size<double>();
+    test_object_size<OverAligned>();
 
   return 0;
 }
