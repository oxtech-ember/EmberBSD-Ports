@@ -36,13 +36,14 @@
-static upb_StringView upb_Clone_StringView(upb_StringView str,
-                                           upb_Arena* arena) {
+static bool upb_Clone_StringView(upb_StringView str, upb_Arena* arena,
+                                upb_StringView* cloned_str) {
   if (str.size == 0) {
-    return upb_StringView_FromDataAndSize(NULL, 0);
+    *cloned_str = upb_StringView_FromDataAndSize(NULL, 0);
+    return true;
   }
   void* cloned_data = upb_Arena_Malloc(arena, str.size);
-  upb_StringView cloned_str =
-      upb_StringView_FromDataAndSize(cloned_data, str.size);
+  if (cloned_data == NULL) return false;
+  *cloned_str = upb_StringView_FromDataAndSize(cloned_data, str.size);
   memcpy(cloned_data, str.data, str.size);
-  return cloned_str;
+  return true;
 }
 
