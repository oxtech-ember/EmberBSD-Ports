 static void cp_free_control(void); /* needed by resetcontrol */
 
+#ifdef SHARED_MODULE
+struct command_frame {
+    wordlist *previous, *current, *following;
+    struct command_frame *outer;
+};
+#if defined(_MSC_VER)
+static __declspec(thread) struct command_frame *active_commands;
+#else
+static _Thread_local struct command_frame *active_commands;
+#endif
+
+void
+cp_free_active_commands(void)
+{
+    while (active_commands) {
+        struct command_frame *frame = active_commands;
+        active_commands = frame->outer;
+        wl_free(frame->previous);
+        wl_free(frame->current);
+        wl_free(frame->following);
+    }
+}
+#endif
