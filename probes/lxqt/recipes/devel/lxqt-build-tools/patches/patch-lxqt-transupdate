$NetBSD$

Use the packaged Qt Linguist in the installed prefix. Quote its path so
relocating the tools below a path with whitespace remains supported.
Origin: EmberBSD (AI-assisted).

--- lxqt-transupdate.orig
+++ lxqt-transupdate
@@ -30,11 +30,9 @@
 # lxqt-transupdate
 # Update LXQt translation files.
 
-# just to be sure - for distributions that user qtchooser
-# Debian and derivatives, Fedora, FreeBSD, Mageia, OpenMandriva, PCLinuxOS
-export QT_SELECT=6
-
-lupdate_executable="$(qmake6 -query QT_INSTALL_BINS)/lupdate"
+# Qt tools are installed under the same pkgsrc prefix as this program.
+lupdate_executable="$(dirname "$0")/../qt6/bin/lupdate"
+[ -x "$lupdate_executable" ] || exit 1
 TEMPLATES=$(find . -name \*.ts | grep -v '_')
 for i in $TEMPLATES; do
   printf "\n\n==== %s ====\n" "$i"
@@ -43,9 +41,9 @@
   # template-update
   printf "== Template Update =="
   printf "lupdate %s -ts %s -locations absolute -no-obsolete\n" "$SOURCEDIR" "$i"
-  $lupdate_executable  $SOURCEDIR -ts $i -locations absolute -no-obsolete
+  "$lupdate_executable" "$SOURCEDIR" -ts "$i" -locations absolute -no-obsolete || exit $?
   echo
   printf "== Language updates =="
   printf "lupdate %s -ts %s/*_*.ts -locations absolute -no-obsolete\n" "$SOURCEDIR" "$i"
-  $lupdate_executable  $SOURCEDIR -ts $TRANSDIR/*_*.ts -locations absolute -no-obsolete
+  "$lupdate_executable" "$SOURCEDIR" -ts "$TRANSDIR"/*_*.ts -locations absolute -no-obsolete || exit $?
 done
