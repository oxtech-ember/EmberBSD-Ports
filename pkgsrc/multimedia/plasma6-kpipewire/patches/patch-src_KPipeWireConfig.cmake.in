$NetBSD$

Locate the public PipeWire and SPA headers in the consumer's CMake context.
Origin: EmberBSD contributors (AI-assisted).

--- src/KPipeWireConfig.cmake.in.orig
+++ src/KPipeWireConfig.cmake.in
@@ -1,10 +1,33 @@
 @PACKAGE_INIT@
 
 include(CMakeFindDependencyMacro)
+
+find_package(PkgConfig QUIET)
+if(PkgConfig_FOUND)
+    pkg_check_modules(PC_KPipeWire_PipeWire QUIET libpipewire-0.3)
+endif()
+find_path(KPipeWire_PipeWire_INCLUDE_DIR pipewire/pipewire.h
+    HINTS ${PC_KPipeWire_PipeWire_INCLUDE_DIRS} "${PACKAGE_PREFIX_DIR}/include"
+    PATH_SUFFIXES pipewire-0.3)
+find_path(KPipeWire_SPA_INCLUDE_DIR spa/param/format-utils.h
+    HINTS ${PC_KPipeWire_PipeWire_INCLUDE_DIRS} "${PACKAGE_PREFIX_DIR}/include"
+    PATH_SUFFIXES spa-0.2)
+if(NOT KPipeWire_PipeWire_INCLUDE_DIR OR NOT KPipeWire_SPA_INCLUDE_DIR)
+    set(KPipeWire_FOUND FALSE)
+    set(KPipeWire_NOT_FOUND_MESSAGE "KPipeWire requires the PipeWire and SPA headers")
+    return()
+endif()
+
 find_dependency(Qt6Core @REQUIRED_QT_VERSION@)
 find_dependency(Qt6Gui @REQUIRED_QT_VERSION@)
+find_dependency(Qt6Quick @REQUIRED_QT_VERSION@)
+find_dependency(Qt6Qml @REQUIRED_QT_VERSION@)
 find_dependency(Qt6QmlIntegration @REQUIRED_QT_VERSION@)
 
 
-include("${CMAKE_CURRENT_LIST_DIR}/KPipeWireTargets.cmake")
+if(NOT TARGET K::KPipeWire)
+    include("${CMAKE_CURRENT_LIST_DIR}/KPipeWireTargets.cmake")
+    set_property(TARGET K::KPipeWire APPEND PROPERTY INTERFACE_INCLUDE_DIRECTORIES
+        "${KPipeWire_PipeWire_INCLUDE_DIR}" "${KPipeWire_SPA_INCLUDE_DIR}")
+endif()
 @PACKAGE_INCLUDE_QCHTARGETS@
