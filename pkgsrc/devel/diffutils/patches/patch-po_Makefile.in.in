$NetBSD$

Retain the NetBSD pkgsrc shell and mkdir repair from patch-po_Makefile.in.in
revision 1.3. Refresh the context for GNU diffutils 3.12.
The upstream gettext copyright and license remain unchanged.

--- po/Makefile.in.in.orig
+++ po/Makefile.in.in
@@ -16,7 +16,6 @@
 PACKAGE_BUGREPORT = @PACKAGE_BUGREPORT@
 
 SED = @SED@
-SHELL = /bin/sh
 @SET_MAKE@
 
 srcdir = @srcdir@
@@ -40,10 +39,10 @@
 # In automake >= 1.10, @mkdir_p@ is derived from ${MKDIR_P}, which is defined
 # either as "/path/to/mkdir -p" or ".../install-sh -c -d". For these automake
 # versions, $(mkinstalldirs) and $(install_sh) are unused.
-mkinstalldirs = $(SHELL) @install_sh@ -d
-install_sh = $(SHELL) @install_sh@
+mkinstalldirs = @install_sh@ -d
+install_sh = @install_sh@
 MKDIR_P = @MKDIR_P@
-mkdir_p = @mkdir_p@
+mkdir_p = $(MKDIR_P)
 
 GMSGFMT_ = @GMSGFMT@
 GMSGFMT_no = @GMSGFMT@
