 	case WSCONS_EVENT_MOUSE_UP:
-	case WSCONS_EVENT_MOUSE_DOWN:
-		button = wscons_button_code(wsevent->value);
-		if (wsevent->type == WSCONS_EVENT_MOUSE_UP) {
-			bstate = LIBINPUT_BUTTON_STATE_RELEASED;
-			if ((unsigned int)wsevent->value < 32) {
-				/* The press was not reported; drop the release. */
-				if (!(dev->sendevents.pressed & bit(wsevent->value)))
-					break;
-				dev->sendevents.pressed &= ~bit(wsevent->value);
-			}
-		} else {
-			bstate = LIBINPUT_BUTTON_STATE_PRESSED;
-			if ((unsigned int)wsevent->value < 32)
-				dev->sendevents.pressed |= bit(wsevent->value);
-		}
-		pointer_notify_button(device, time, button_code_from_uint32_t(button), bstate);
+	case WSCONS_EVENT_MOUSE_DOWN: {
+		unsigned int step;
+
+		button = wscons_button_code(wsevent->value);
+		bstate = wsevent->type == WSCONS_EVENT_MOUSE_UP ?
+		    LIBINPUT_BUTTON_STATE_RELEASED :
+		    LIBINPUT_BUTTON_STATE_PRESSED;
+		step = wscons_button_step(&dev->sendevents.pressed,
+		    (unsigned int)wsevent->value,
+		    bstate == LIBINPUT_BUTTON_STATE_PRESSED);
+		if (step & WSCONS_BUTTON_REPAIR)
+			pointer_notify_button(device, time,
+			    button_code_from_uint32_t(button),
+			    LIBINPUT_BUTTON_STATE_RELEASED);
+		if (step & WSCONS_BUTTON_REPORT)
+			pointer_notify_button(device, time,
+			    button_code_from_uint32_t(button), bstate);
 		break;
+	}
 
