+/* wscons-button-state begin: no libinput dependencies, tested on the host. */
 /*
- * Release the buttons that are still held down. A disabled device
- * must not leave a pressed button in the compositor.
+ * Pairing of the button events of one device.  libinput counts the presses
+ * of a button per seat, and a compositor may drop a press whose count is
+ * not 1 and a release whose count is not 0.  One press without a release
+ * (the kernel event queue lost it) would then disable that button until the
+ * compositor restarts, and the compositor would hold it down for all that
+ * time.  So each press that is reported gets exactly one release:
+ * a press of a button that is already down first reports the lost release,
+ * a release of a button that is not down is dropped.
+ * pressed: wscons button numbers that are down (bits 0..31); other buttons
+ * are passed on as they come.
+ */
+#define WSCONS_BUTTON_REPORT	0x1	/* report this event */
+#define WSCONS_BUTTON_REPAIR	0x2	/* report the lost release first */
+
+static unsigned int
+wscons_button_step(uint32_t *pressed, unsigned int value, bool down)
+{
+	uint32_t mask;
+
+	if (value >= 32)
+		return WSCONS_BUTTON_REPORT;
+	mask = (uint32_t)1 << value;
+	if (down) {
+		if (*pressed & mask)
+			return WSCONS_BUTTON_REPORT | WSCONS_BUTTON_REPAIR;
+		*pressed |= mask;
+		return WSCONS_BUTTON_REPORT;
+	}
+	if (!(*pressed & mask))
+		return 0;
+	*pressed &= ~mask;
+	return WSCONS_BUTTON_REPORT;
+}
+/* wscons-button-state end */
+
+/*
+ * Release the buttons that are still held down. A disabled or removed
+ * device must not leave a pressed button in the compositor.
  */
 static void
 wscons_release_buttons(struct libinput_device *device)
@@ -471,23 +513,25 @@
