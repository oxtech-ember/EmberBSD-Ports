+/* Release the per-device resources that outlive the open node. */
+void
+wscons_device_destroy(struct wscons_device *wscons_device)
+{
+	if (wscons_device->udev_device != NULL) {
+		udev_device_unref(wscons_device->udev_device);
+		wscons_device->udev_device = NULL;
+	}
+}
+
 static int
 wscons_device_init(struct wscons_device *wscons_device)
 {
 	struct libinput_device *device = &wscons_device->base;
+	struct udev_input *input = (struct udev_input *)device->seat->libinput;
 
 	wscons_device->old_value = -1;
 
+	/*
+	 * libudev-bsd names a wscons node by its /dev path and
+	 * supplies the ID_INPUT_* properties that consumers read.
+	 */
+	if (input->udev != NULL)
+		wscons_device->udev_device =
+		    udev_device_new_from_syspath(input->udev, device->devname);
+
