+/* Map a wscons button number to the Linux button code. */
+static uint32_t
+wscons_button_code(int value)
+{
+	switch (value) {
+	case 1:
+		return BTN_MIDDLE;
+	case 2:
+		return BTN_RIGHT;
+	default:
+		return value + BTN_LEFT;
+	}
+}
+
+/*
+ * Release the buttons that are still held down. A disabled device
+ * must not leave a pressed button in the compositor.
+ */
+static void
+wscons_release_buttons(struct libinput_device *device)
+{
+	struct wscons_device *dev = wscons_device(device);
+	struct timespec ts;
+	usec_t time;
+	int value;
+
+	if (dev->sendevents.pressed == 0)
+		return;
+
+	clock_gettime(CLOCK_REALTIME, &ts);
+	time = usec_from_timespec(&ts);
+	for (value = 0; value < 32; value++) {
+		if (!(dev->sendevents.pressed & bit(value)))
+			continue;
+		pointer_notify_button(device, time,
+		    button_code_from_uint32_t(wscons_button_code(value)),
+		    LIBINPUT_BUTTON_STATE_RELEASED);
+	}
+	dev->sendevents.pressed = 0;
+}
+
+static uint32_t
+wscons_sendevents_get_modes(struct libinput_device *device)
+{
+	return LIBINPUT_CONFIG_SEND_EVENTS_DISABLED;
+}
+
+static enum libinput_config_status
+wscons_sendevents_set_mode(struct libinput_device *device,
+    enum libinput_config_send_events_mode mode)
+{
+	struct wscons_device *dev = wscons_device(device);
+
+	if (mode == dev->sendevents.mode)
+		return LIBINPUT_CONFIG_STATUS_SUCCESS;
+
+	switch (mode) {
+	case LIBINPUT_CONFIG_SEND_EVENTS_ENABLED:
+		break;
+	case LIBINPUT_CONFIG_SEND_EVENTS_DISABLED:
+		wscons_release_buttons(device);
+		dev->absolute.pending = false;
+		break;
+	default:
+		return LIBINPUT_CONFIG_STATUS_UNSUPPORTED;
+	}
+
+	dev->sendevents.mode = mode;
+	return LIBINPUT_CONFIG_STATUS_SUCCESS;
+}
+
+static enum libinput_config_send_events_mode
+wscons_sendevents_get_mode(struct libinput_device *device)
+{
+	return wscons_device(device)->sendevents.mode;
+}
+
+static enum libinput_config_send_events_mode
+wscons_sendevents_get_default_mode(struct libinput_device *device)
+{
+	return LIBINPUT_CONFIG_SEND_EVENTS_ENABLED;
+}
+
+static void
+wscons_device_init_sendevents(struct wscons_device *device)
+{
+	device->sendevents.mode = LIBINPUT_CONFIG_SEND_EVENTS_ENABLED;
+	device->sendevents.config.get_modes = wscons_sendevents_get_modes;
+	device->sendevents.config.set_mode = wscons_sendevents_set_mode;
+	device->sendevents.config.get_mode = wscons_sendevents_get_mode;
+	device->sendevents.config.get_default_mode =
+	    wscons_sendevents_get_default_mode;
+	device->base.config.sendevents = &device->sendevents.config;
+}
