 /* wscons-swipe-state end */
 
+#ifdef WSCONS_HAVE_GESTURES
+/*
+ * The kernel sends the X and Y of one swipe step as two events. Pass them
+ * on as one libinput update: compositors pick the swipe axis from the
+ * first update, and a lone X step would make every swipe horizontal.
+ */
+static void
+wscons_flush_swipe(struct libinput_device *device, usec_t time)
+{
+	struct wscons_device *dev = wscons_device(device);
+	struct normalized_coords delta = dev->swipe_motion.delta;
+	bool pending = dev->swipe_motion.has_x || dev->swipe_motion.has_y;
+
+	dev->swipe_motion.delta.x = 0;
+	dev->swipe_motion.delta.y = 0;
+	dev->swipe_motion.has_x = false;
+	dev->swipe_motion.has_y = false;
+	if (!pending || !dev->gestures || !wscons_swipe_update(&dev->swipe))
+		return;
+	gesture_notify_swipe(device, time, LIBINPUT_EVENT_GESTURE_SWIPE_UPDATE,
+	    dev->swipe.fingers, &delta, &delta);
+}
+
+/* wscons-swipe-frame begin: no libinput dependencies, tested on the host. */
+/*
+ * An event ends the pending swipe step unless it adds the missing axis:
+ * any other event, or a second X or Y, starts the next step.
+ */
+static bool
+wscons_swipe_step_ends(unsigned int type, bool has_x, bool has_y)
+{
+	if (type == WSCONS_EVENT_GESTURE_SWIPE_UPDATE_X)
+		return has_x;
+	if (type == WSCONS_EVENT_GESTURE_SWIPE_UPDATE_Y)
+		return has_y;
+	return true;
+}
+/* wscons-swipe-frame end */
+#endif
+
