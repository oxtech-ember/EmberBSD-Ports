#
# Write the key names of input-event-codes.h as a C table for
# wskbd-hwdb.c: the KEY_ and BTN_ names in lower case with their codes.
# A name can have the value of an other name.  KEY_MAX, KEY_CNT and the
# BTN_ ranges are not keys.
# Usage: awk -f keynames.awk input-event-codes.h > wskbd-keynames.h

function number(s,	i, c, n) {
	if (s ~ /^0[xX][0-9a-fA-F]+$/) {
		n = 0
		for (i = 3; i <= length(s); i++) {
			c = index("0123456789abcdef", tolower(substr(s, i, 1)))
			n = n * 16 + c - 1
		}
		return n
	}
	if (s ~ /^[0-9]+$/)
		return s + 0
	return -1
}

$1 == "#define" && $2 ~ /^(KEY|BTN)_[A-Z0-9_]+$/ {
	if ($2 ~ /^KEY_(MAX|CNT|MIN_INTERESTING)$/ || $2 ~ /^BTN_(MISC|MOUSE|JOYSTICK|GAMEPAD|DIGI|WHEEL|TRIGGER_HAPPY)$/)
		next
	if ((v = number($3)) >= 0)
		code[$2] = v
	else if ($3 in code)
		code[$2] = code[$3]
	else
		next
	order[++n] = $2
}

END {
	if (n == 0) {
		print "keynames.awk: no key names in " FILENAME > "/dev/stderr"
		exit 1
	}
	print "/* Generated by keynames.awk from input-event-codes.h. */"
	print "static const struct {"
	print "\tconst char *name;"
	print "\tint code;"
	print "} wskbd_key_names[] = {"
	for (i = 1; i <= n; i++)
		printf "\t{ \"%s\", %d },\n", tolower(order[i]), code[order[i]]
	print "};"
}
