+// Both native APIs use a dynamically allocated cpuset. An empty native mask
+// means unbound, not zero usable CPUs; let the caller use its normal CPU count.
+template <typename Query>
+std::optional<std::vector<bool>> get_netbsd_affinity(Query query)
+{
+    const long count = sysconf(_SC_NPROCESSORS_CONF);
+    if (count <= 0)
+        return std::nullopt;
+    const auto destroy = [](cpuset_t* set) { cpuset_destroy(set); };
+    std::unique_ptr<cpuset_t, decltype(destroy)> set(cpuset_create(), destroy);
+    if (!set || query(cpuset_size(set.get()), set.get()) != 0)
+        return std::nullopt;
+    std::vector<bool> affinity(static_cast<std::size_t>(count));
+    bool bound = false;
+    for (std::size_t i = 0; i < affinity.size(); ++i)
+    {
+        const int member = cpuset_isset(static_cast<cpuid_t>(i), set.get());
+        if (member < 0)
+            return std::nullopt;
+        affinity[i] = member != 0;
+        bound = bound || affinity[i];
+    }
+    return bound ? std::make_optional(std::move(affinity)) : std::nullopt;
+}
+
+template <typename Set>
+bool set_netbsd_affinity(const std::vector<bool>& affinity, Set apply)
+{
+    const long count = sysconf(_SC_NPROCESSORS_CONF);
+    if (count <= 0)
+        return false;
+    const auto destroy = [](cpuset_t* set) { cpuset_destroy(set); };
+    std::unique_ptr<cpuset_t, decltype(destroy)> set(cpuset_create(), destroy);
+    if (!set)
+        return false;
+    bool bound = false;
+    for (std::size_t i = 0; i < affinity.size(); ++i)
+    {
+        if (!affinity[i])
+            continue;
+        if (i >= static_cast<std::size_t>(count) ||
+            cpuset_set(static_cast<cpuid_t>(i), set.get()) != 0)
+            return false;
+        bound = true;
+    }
+    // Do not interpret an invalid empty selection as a request to clear binding.
+    return bound && apply(cpuset_size(set.get()), set.get()) == 0;
+}
