$NetBSD$

Select the C compiler tag for libtool.

--- librsrc/Makefile.in.orig
+++ librsrc/Makefile.in
@@ -110,7 +110,7 @@
 ###############################################################################
 
 $(RSRCTARGET): $(RSRCOBJS)
-	$(LIBTOOL) --mode=link $(CC) -o $(RSRCTARGET) $(RSRCOBJS:.o=.lo) \
+	$(LIBTOOL) --tag=CC --mode=link $(CC) -o $(RSRCTARGET) $(RSRCOBJS:.o=.lo) \
 		-rpath $(LIBDEST) -version-info 1:0
 
 main.o:
@@ -120,7 +120,7 @@
 	$(CC) $(LDFLAGS) -L. -L../libhfs main.o -lhfs -lrsrc -o $@
 
 .c.o:
-	$(LIBTOOL) --mode=compile $(CC) $(CFLAGS) -c $(.IMPSRC)
+	$(LIBTOOL) --tag=CC --mode=compile $(CC) $(CFLAGS) -c $(.IMPSRC)
 
 ### DEPENDENCIES FOLLOW #######################################################
 
