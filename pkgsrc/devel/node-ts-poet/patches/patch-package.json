Load the native dprint-node formatter only when it is installed.
Without it, ts-poet keeps the unformatted, valid TypeScript output.

--- package.json.orig
+++ package.json
@@ -27,8 +27,5 @@
     "ts-jest": "^29.1.1",
     "typescript": "^5.3.3"
   },
-  "dependencies": {
-    "dprint-node": "^1.0.8"
-  },
   "packageManager": "yarn@4.0.2"
 }
\ No newline at end of file
