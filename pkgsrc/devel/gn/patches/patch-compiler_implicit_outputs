+TEST_F(NinjaCBinaryTargetWriterTest, ImplicitAdditionalOutputsWithGccPch) {
+  Err err;
+  TestWithScope setup;
+  Settings settings(setup.build_settings(), "implicit/");
+  Toolchain tc(&settings, Label(SourceDir("//toolchain/"), "implicit"));
+  settings.set_toolchain_label(tc.label());
+  settings.set_default_toolchain_label(setup.toolchain()->label());
+  for (const char* name : {CTool::kCToolCc, CTool::kCToolCxx,
+                           CTool::kCToolObjC, CTool::kCToolObjCxx}) {
+    auto tool = std::make_unique<CTool>(name);
+    TestWithScope::SetCommandForTool("cc {{source}} -o {{output}}", tool.get());
+    if (name == CTool::kCToolCxx) {
+      tool->set_outputs(SubstitutionList::MakeForTest(
+          "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o",
+          "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.meta"));
+    } else {
+      tool->set_outputs(SubstitutionList::MakeForTest(
+          "{{source_out_dir}}/{{target_output_name}}.{{source_name_part}}.o"));
+    }
+    tool->set_precompiled_header_type(CTool::PCH_GCC);
+    tc.SetTool(std::move(tool));
+  }
+  tc.ToolchainSetupComplete();
+  Target target(&settings, Label(SourceDir("//space $dir/"), "test"));
+  target.set_output_type(Target::SOURCE_SET);
+  target.visibility().SetPublic();
+  target.config_values().set_precompiled_source(SourceFile("//build/precompile.h"));
+  for (const char* source : {"//space $dir/a.c", "//space $dir/b.cc",
+                             "//space $dir/c.m", "//space $dir/d.mm"})
+    target.sources().push_back(SourceFile(source));
+  for (auto type : {SourceFile::SOURCE_C, SourceFile::SOURCE_CPP,
+                    SourceFile::SOURCE_M, SourceFile::SOURCE_MM})
+    target.source_types_used().Set(type);
+  for (const char* text : {"{{source_out_dir}}/{{source_name_part}}.dwo",
+                           "{{source_out_dir}}/{{source_name_part}}.json"}) {
+    SubstitutionPattern pattern;
+    ASSERT_TRUE(pattern.Parse(Value(nullptr, text), &err));
+    target.config_values().c_additional_outputs().push_back(std::move(pattern));
+  }
+  target.SetToolchain(&tc);
+  ASSERT_TRUE(target.OnResolved(&err));
+  StringOutputBuffer buffer;
+  NinjaCBinaryTargetWriter(&target, buffer).Run();
+  const std::string result = buffer.str();
+  for (const char* suffix : {".h-c.gch", ".h-cc.gch", ".h-m.gch", ".h-mm.gch"})
+    EXPECT_NE(std::string::npos, result.find(suffix));
+  EXPECT_NE(std::string::npos, result.find(".o | "));
+  EXPECT_NE(std::string::npos, result.find(".meta | "));
+  EXPECT_NE(std::string::npos, result.find(".dwo"));
+  EXPECT_NE(std::string::npos, result.find(".json"));
+  EXPECT_NE(std::string::npos, result.find("$$"));
+}
