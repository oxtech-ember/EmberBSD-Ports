# $NetBSD$
# Origin: EmberBSD (AI-assisted). One KDocTools source for the target
# framework and its native generators.
#
# used by devel/kf6-kdoctools/Makefile
# used by devel/kf6-kdoctools-generators/Makefile

DISTNAME=	kdoctools-${KF6VER}
PKGREVISION=	1
CATEGORIES=	devel

HOMEPAGE=	https://community.kde.org/Frameworks
LICENSE=	gnu-lgpl-v2.1

EMBERBSD_KDOCTOOLS_PKGDIR:=	${.PARSEDIR:tA}
DISTINFO_FILE=	${EMBERBSD_KDOCTOOLS_PKGDIR}/distinfo
PATCHDIR=	${EMBERBSD_KDOCTOOLS_PKGDIR}/patches

.include "../../mk/bsd.prefs.mk"
.if ${OPSYS} == "Darwin" && ${USE_CROSS_COMPILE:Uno:tl} != "yes"
CMAKE_CONFIGURE_ARGS+=	-DRELOCATABLE_DOCBOOK_FILES=ON
CMAKE_CONFIGURE_ARGS+=	-DKDE_SKIP_RPATH_SETTINGS=ON
# meinproc runs from the build tree to generate its own manuals.
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_BUILD_RPATH="${BUILDLINK_DIR}/lib;${BUILDLINK_DIR}/qt6/lib"
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_INSTALL_RPATH="@loader_path/../lib;@loader_path/../qt6/lib"
.endif
