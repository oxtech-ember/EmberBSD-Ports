--- CMakeLists.txt.orig
+++ CMakeLists.txt
@@ -43,7 +43,26 @@
 include(cmake/utils.cmake)
 include(GNUInstallDirs)
 
-add_subdirectory(third_party)
+option(EFFCEE_USE_INSTALLED_DEPS "Use installed dependencies instead of third_party sources" OFF)
+if(EFFCEE_USE_INSTALLED_DEPS)
+  find_package(absl CONFIG REQUIRED)
+  find_package(re2 CONFIG REQUIRED)
+  if(NOT TARGET re2::re2 OR TARGET re2)
+    message(FATAL_ERROR "Installed RE2 must provide only the re2::re2 target")
+  endif()
+  add_library(re2 ALIAS re2::re2)
+  if(EFFCEE_BUILD_TESTING)
+    find_package(GTest 1.18.0 CONFIG REQUIRED)
+    foreach(component gtest gtest_main gmock gmock_main)
+      if(NOT TARGET GTest::${component} OR TARGET ${component})
+        message(FATAL_ERROR "Installed GoogleTest must provide GTest::${component}")
+      endif()
+      add_library(${component} ALIAS GTest::${component})
+    endforeach()
+  endif()
+else()
+  add_subdirectory(third_party)
+endif()
 add_subdirectory(effcee)
 add_subdirectory(fuzzer)
 
--- effcee/CMakeLists.txt.orig
+++ effcee/CMakeLists.txt
@@ -4,9 +4,23 @@
 effcee_default_compile_options(effcee)
 # We need to expose RE2's StringPiece.
 target_include_directories(effcee
-  PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/.. ${EFFCEE_RE2_DIR})
+  PUBLIC
+    $<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/..>
+    $<BUILD_INTERFACE:${EFFCEE_RE2_DIR}>
+    $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}>)
 target_link_libraries(effcee PUBLIC re2 ${CMAKE_THREADS_LIB_INIT})
-set_target_properties(effcee PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON)
+set_target_properties(effcee PROPERTIES WINDOWS_EXPORT_ALL_SYMBOLS ON
+  VERSION ${PROJECT_VERSION} SOVERSION ${PROJECT_VERSION_MAJOR})
+if(APPLE)
+  # Encode year minor as years since 2000; Mach-O components are bytes.
+  math(EXPR EFFCEE_MACHO_YEAR "${PROJECT_VERSION_MINOR} - 2000")
+  if(EFFCEE_MACHO_YEAR LESS 0 OR EFFCEE_MACHO_YEAR GREATER 255 OR
+     PROJECT_VERSION_PATCH GREATER 255)
+    message(FATAL_ERROR "Effcee version cannot be represented in Mach-O")
+  endif()
+  set_target_properties(effcee PROPERTIES MACHO_CURRENT_VERSION
+    "${PROJECT_VERSION_MAJOR}.${EFFCEE_MACHO_YEAR}.${PROJECT_VERSION_PATCH}")
+endif()
 
 # TODO(dneto): Avoid installing gtest and gtest_main. ?!
 install(
@@ -14,9 +18,24 @@
     effcee.h
   DESTINATION
     include/effcee)
