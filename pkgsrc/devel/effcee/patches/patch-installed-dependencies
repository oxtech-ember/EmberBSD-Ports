+install(EXPORT effceeTargets FILE effceeTargets.cmake NAMESPACE effcee::
+  DESTINATION "${effcee_cmake_dir}")
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/effceeConfig.cmake"
+              "${CMAKE_CURRENT_BINARY_DIR}/effceeConfigVersion.cmake"
+  DESTINATION "${effcee_cmake_dir}")
 
