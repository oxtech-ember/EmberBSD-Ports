Run selected host generators with an explicit scoped runtime launcher.
Origin: EmberBSD contributors (AI-assisted); upstream status: not submitted.

--- gn/perfetto.gni
+++ gn/perfetto.gni
@@ -51,6 +51,20 @@
 #    perfetto_build_standalone = false
 #    perfetto_build_with_android = false
 #    perfetto_build_with_embedder = true
+
+# An embedder may run native generators using one explicit runtime view.
+declare_args() {
+  perfetto_host_runtime_launcher = ""
+  perfetto_host_runtime_view = ""
+  perfetto_host_runtime_inputs = []
+}
+assert((perfetto_host_runtime_launcher == "") ==
+       (perfetto_host_runtime_view == ""),
+       "Select the host runtime launcher and view together")
+if (perfetto_host_runtime_launcher != "") {
+  assert(perfetto_host_runtime_inputs != [],
+         "The host runtime launcher requires its actual inputs")
+}
 
