# $NetBSD$

DISTNAME=	highway-1.3.0
CATEGORIES=	devel
MASTER_SITES=	${MASTER_SITE_GITHUB:=google/}
GITHUB_PROJECT=	highway
GITHUB_TAG=	${PKGVERSION_NOREV}

HOMEPAGE=	https://github.com/google/highway
COMMENT=	Performance-portable SIMD library
LICENSE=	apache-2.0

USE_LANGUAGES=	c c++
USE_CXX_FEATURES=	c++17

CMAKE_CONFIGURE_ARGS+=	-DBUILD_TESTING=OFF
CMAKE_CONFIGURE_ARGS+=	-DHWY_ENABLE_TESTS=OFF
CMAKE_CONFIGURE_ARGS+=	-DHWY_ENABLE_EXAMPLES=OFF
CMAKE_CONFIGURE_ARGS+=	-DHWY_ENABLE_CONTRIB=OFF
CMAKE_CONFIGURE_ARGS+=	-DBUILD_SHARED_LIBS=ON

.include "../../devel/cmake/build.mk"
.include "../../mk/bsd.pkg.mk"
