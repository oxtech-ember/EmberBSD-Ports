+ELFTC_VCSID("Id: elf_getversion.c 3977 2022-05-01 06:45:34Z jkoshy");
+
+__RCSID("$NetBSD: elf_getversion.c,v 1.1.1.1 2024/03/03 14:41:47 christos Exp $");
