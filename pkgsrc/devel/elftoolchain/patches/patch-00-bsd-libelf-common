+unsigned int
+elf_getversion(Elf *e)
+{
+	if (e == NULL || e->e_kind != ELF_K_ELF) {
+		LIBELF_SET_ERROR(ARGUMENT, 0);
+		return (EV_NONE);
+	}
+
+	return (e->e_version);
+}
