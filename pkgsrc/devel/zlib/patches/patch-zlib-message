$NetBSD$

Preserve the existing public zlib message types while using the NetBSD
__UNCONST convention for literal message assignments.

Origin: NetBSD zlib integration; EmberBSD adaptation (AI-assisted).

--- zutil.h.orig
+++ zutil.h
@@ -20,6 +20,13 @@
 #endif
 
 #include "zlib.h"
+
+/* NetBSD standalone and base preserve mutable public zlib message types. */
+#if defined(__NetBSD__) || defined(ZLIB_NETBSD_STANDALONE)
+#  define Z_MSG_CAST(s) ((z_const char *)__UNCONST(s))
+#else
+#  define Z_MSG_CAST(s) ((z_const char *)(s))
+#endif
 
 #if defined(STDC) && !defined(Z_SOLO)
 #  if (defined(__NetBSD__) || defined(ZLIB_NETBSD_STANDALONE)) && (defined(_KERNEL) || defined(_STANDALONE))
