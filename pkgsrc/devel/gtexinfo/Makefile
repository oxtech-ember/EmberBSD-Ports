# $NetBSD: Makefile,v 1.131 2026/07/16 19:01:48 wiz Exp $

.include "Makefile.common"
PKGNAME=	g${DISTNAME}
PKGREVISION=	11
CATEGORIES=	devel sysutils

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://www.gnu.org/software/texinfo/texinfo.html
COMMENT=	GNU info documentation utilities
LICENSE=	gnu-gpl-v3

TOOL_DEPENDS+=	help2man-[0-9]*:../../converters/help2man
# otherwise, package installs copies of them itself
DEPENDS+=	p5-Locale-libintl-[0-9]*:../../misc/p5-Locale-libintl
DEPENDS+=	p5-Text-Unidecode-[0-9]*:../../textproc/p5-Text-Unidecode
DEPENDS+=	p5-Unicode-EastAsianWidth-[0-9]*:../../converters/p5-Unicode-EastAsianWidth

# The upstream skipped test has two pairs of filenames that collide on
# case-insensitive hosts. Preserve both original bytes and their archive paths.
CASE_FIXTURE= tta/perl/t/results/init_files_tests/add_lower_case_redirection_file_names/res_html
CASE_ENTRIES= ${DISTNAME}/${CASE_FIXTURE}/Chap.html \
              ${DISTNAME}/${CASE_FIXTURE}/Up-and-Down.html
EXTRACT_OPTS+= -x
EXTRACT_ELEMENTS+= ${CASE_ENTRIES}

post-extract:
	${MKDIR} ${WRKSRC}/.ember-case-preserved
	${EXTRACTOR} ${EXTRACT_OPTS:N-x} -d ${WRKSRC}/.ember-case-preserved \
	    ${_DISTDIR}/${DISTNAME}${EXTRACT_SUFX} ${CASE_ENTRIES}

USE_LIBTOOL=		yes
USE_TOOLS+=		gmake perl:run
GNU_CONFIGURE=		yes
GNU_CONFIGURE_STRICT=	no # otherwise MiscXS.pm won't be installed
CONFIGURE_ARGS+=	--with-external-libintl-perl
CONFIGURE_ARGS+=	--with-external-Text-Unidecode
CONFIGURE_ARGS+=	--with-external-Unicode-EastAsianWidth
CONFIGURE_ARGS+=	--enable-perl-xs
CONFIGURE_ENV+=		PERL_EXT_CC=${CC:Q}
CONFIGURE_ARGS+=	PERL_EXT_CFLAGS=${CFLAGS:Q}
CONFIGURE_ARGS+=	PERL_EXT_LDFLAGS=${LDFLAGS:Q}

INFO_FILES=		yes
TEST_TARGET=		check
PLIST_SRC=		${PKGDIR}/PLIST

# Replace deeply nested config.sub files (in vendored perl libraries)
OVERRIDE_DIRDEPTH=	4

PKGSRC_INFOPATH=	${PREFIX}/${PKGINFODIR}:${X11BASE}/${PKGINFODIR}:${PREFIX}/${PKGINFODIR}
MAKE_ENV+=		PKGSRC_INFOPATH=${PKGSRC_INFOPATH:Q}
CPPFLAGS+=		-DPKGSRC_INFOPATH=\"${PKGSRC_INFOPATH}\"

REPLACE_SH+=		util/texi2dvi util/texi2pdf util/pdftexi2dvi
REPLACE_SH+=		texindex/texindex.in info/info-hooks-default/manual-not-found.in

.include "../../mk/bsd.prefs.mk"
.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD"
# Target scripts use target awk, while configure runs the selected host awk.
CONFIGURE_ARGS+=	ac_cv_path_TI_AWK=/usr/bin/awk
# These scripts are generated by configure using the host Perl.  Correct their
# installed interpreter after installation, leaving build-time generators alone.
SUBST_CLASSES+=		target-perl-scripts
SUBST_STAGE.target-perl-scripts= post-install
SUBST_FILES.target-perl-scripts= ${DESTDIR}${PREFIX}/bin/texi2any \
	${DESTDIR}${PREFIX}/bin/pod2texi \
	${DESTDIR}${PREFIX}/share/texi2any/load_txi_modules
SUBST_SED.target-perl-scripts= -e '1s|^\#!.*perl.*$$|\#!${PREFIX}/bin/perl|'
SUBST_CLASSES+=		target-hook-awk
SUBST_STAGE.target-hook-awk= pre-configure
SUBST_MESSAGE.target-hook-awk= Select target awk in the Info hook
SUBST_FILES.target-hook-awk= info/info-hooks-default/manual-not-found.in
SUBST_SED.target-hook-awk= -e 's,^AWK=@AWK@$$,AWK=/usr/bin/awk,'
.else
CONFIGURE_ARGS+=	ac_cv_path_TI_AWK=${AWK:Q}
.endif
.include "cross.mk"
.include "options.mk"

# The Darwin iconv fails the upstream working-iconv test. Shared XS/C
# libraries require that test to pass. Use the packaged GNU provider.
INCOMPAT_ICONV+=	Darwin-*-*

.include "../../converters/libiconv/buildlink3.mk"
.include "../../lang/perl5/buildlink3.mk"	 # for EXTERN.h in XSParagraph
.if ${USE_CROSS_COMPILE:Uno} == "yes" && defined(EMBERBSD_NATIVE_TOOLSET_MAKECONF)
.include "../../lang/perl5/build-context.mk"
.endif
.include "../../mk/termcap.buildlink3.mk"
.include "../../mk/bsd.pkg.mk"

# This need to be defined here to override the setting in texinfo.mk
INSTALL_INFO=		${PREFIX}/bin/install-info
