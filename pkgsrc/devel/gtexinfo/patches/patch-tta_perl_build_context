--- tta/m4/txi_perl_conf.m4.orig
+++ tta/m4/txi_perl_conf.m4
@@ -53,8 +53,12 @@
 subst_cr=`printf 's/\r//g'`
 fetch_conf ()
 {
-          conf_value=`${PERL} -V:$[]1 | sed $subst_cr`
-          conf_value=`echo $conf_value | sed "$sed_script"`
+          if test -n "${EMBERBSD_PERL_BUILD_CONFIG-}"; then
+            conf_value=`${PERL} -MExtUtils::MakeMaker::Config -e 'print $Config{+shift}' "$[]1"` || exit 1
+          else
+            conf_value=`${PERL} -V:$[]1 | sed $subst_cr`
+            conf_value=`echo $conf_value | sed "$sed_script"`
+          fi
 }
 
