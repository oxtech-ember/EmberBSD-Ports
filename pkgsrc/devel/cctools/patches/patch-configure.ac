$NetBSD$

Use only selected dependency paths. Allow building the tools that do not
need the Blocks runtime and libdispatch (only ld64 uses them) without them.

--- configure.ac.orig
+++ configure.ac
@@ -20,11 +20,6 @@
 
 CXXFLAGS="$CXXFLAGS -std=c++2a"
 
-if test "x$build" = "x$host"; then
-  CFLAGS="$CFLAGS -isystem /usr/local/include -isystem /usr/pkg/include"
-  CXXFLAGS="$CXXFLAGS -isystem /usr/local/include -isystem /usr/pkg/include"
-  LDFLAGS="$LDFLAGS -L/usr/local/lib -L/usr/pkg/lib"
-fi
 
 CWARNINGS=""
 CXXWARNINGS=""
@@ -357,6 +352,15 @@
 CHECK_LLVM
 LDFLAGS="$LDFLAGS $LTO_RPATH"
 
+### Blocks and libdispatch are used only by ld64 ###
+
+AC_ARG_ENABLE([blocks-dispatch],
+    AS_HELP_STRING([--disable-blocks-dispatch],
+                   [do not require the Blocks runtime and libdispatch (needed by ld64 only)]),
+    [], [enable_blocks_dispatch=yes])
+
+if test "x$enable_blocks_dispatch" != "xno"; then
+
 ### Check for Blocks Runtime library ###
 
 AC_ARG_WITH([libblocksruntime],
@@ -443,6 +447,8 @@
   LDFLAGS=$ORIGLDFLAGS
 fi
 
+fi
+
 ### Check for libfts (musl) ###
 
 AC_CHECK_LIB([fts],[fts_open],[
