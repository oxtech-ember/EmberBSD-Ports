$NetBSD: patch-meson.options,v 1.1 2024/10/22 09:50:39 adam Exp $

Add use_cocoa option.

--- meson.options.orig
+++ meson.options
@@ -109,6 +109,11 @@
        yield: true,
        description : 'Enable native language support (translations)')
 
+option('use_cocoa',
+       type : 'boolean',
+       value : false,
+       description : 'Use Cocoa on macOS')
+
 option('oss_fuzz',
        type : 'feature',
        value : 'disabled',
