+/* Anchor to the GLib image itself, never to an arbitrary calling program. */
+#ifdef GLIB_HAVE_LOCALE_DLADDR
+static const char glib_locale_anchor;
+#endif
+
+gchar *
+_glib_get_locale_dir (void)
+{
+#ifdef GLIB_HAVE_LOCALE_DLADDR
+  Dl_info info;
+  if (dladdr (&glib_locale_anchor, &info) != 0 && info.dli_fname != NULL)
+    {
+      char *resolved = realpath (info.dli_fname, NULL);
+      if (resolved != NULL)
+        {
+          gchar *base = g_path_get_basename (resolved);
+          if ((g_str_has_prefix (base, "libglib-2.0.") &&
+               g_str_has_suffix (base, ".dylib")) ||
+              strcmp (base, "libglib-2.0.so") == 0 ||
+              g_str_has_prefix (base, "libglib-2.0.so."))
+            {
+              gchar *libdir = g_path_get_dirname (resolved);
+              gchar *combined = g_build_filename (libdir, GLIB_LOCALE_RELATIVE_TO_LIBDIR, NULL);
+              gchar *result = g_canonicalize_filename (combined, NULL);
+              g_free (combined);
+              g_free (libdir);
+              g_free (base);
+              free (resolved);
+              return result;
+            }
+          g_free (base);
+          free (resolved);
+        }
+    }
+#endif
+  /* Static GLib, unsupported hosts, and explicit absolute layouts retain the
+   * configured upstream path. */
+  return g_strdup (GLIB_LOCALE_DIR);
+}
 #endif /* G_OS_WIN32 */
 
 
