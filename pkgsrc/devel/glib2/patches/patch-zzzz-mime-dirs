+
+/* Caller holds gio_xdgmime. Never call the public getter from here. */
+static void
+ensure_mime_dirs_locked (void)
+{
+  if (global_mime_dirs == NULL)
+    _g_content_type_set_mime_dirs_locked (NULL);
+}
+
+static gchar **
+dup_mime_dirs (void)
+{
+  gchar **dirs;
+  G_LOCK (gio_xdgmime);
+  g_begin_ignore_leaks ();
+  ensure_mime_dirs_locked ();
+  g_end_ignore_leaks ();
+  dirs = g_strdupv (global_mime_dirs);
+  G_UNLOCK (gio_xdgmime);
+  return dirs;
 }
 
