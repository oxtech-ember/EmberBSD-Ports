+
+/* This copy of dconf-common can live in the client, the module, or the CLI. */
+const gchar *
+dconf_sysconfdir (void)
+{
+  static gsize directory;
+
+  if (g_once_init_enter (&directory))
+    {
+      static const gchar * const layouts[] = { "/lib/gio/modules", "/libexec", "/lib", "/bin" };
+      gchar image[PATH_MAX];
+      gchar *result = NULL;
+      Dl_info info;
+
+      if (dladdr ((const void *) dconf_sysconfdir, &info) &&
+          info.dli_fname && realpath (info.dli_fname, image))
+        {
+          gchar *parent = g_path_get_dirname (image);
+
+          for (guint i = 0; i < G_N_ELEMENTS (layouts); i++)
+            if (g_str_has_suffix (parent, layouts[i]))
+              {
+                parent[strlen (parent) - strlen (layouts[i])] = '\0';
+                result = g_strconcat (parent, "/etc", NULL);
+                break;
+              }
+          g_free (parent);
+        }
+
+      g_once_init_leave (&directory, (gsize) (result ? result : g_strdup (SYSCONFDIR)));
+    }
+
+  return (const gchar *) directory;
+}
