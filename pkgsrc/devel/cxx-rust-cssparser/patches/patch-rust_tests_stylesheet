+fn ensure_color_property() {
+    if property_definition("color").is_none() {
+        let definition = Arc::new(
+            PropertyDefinition::from_name_syntax("color", "<color>", "test", 0, 0).unwrap(),
+        );
+        add_property_definition(&definition);
+    }
+}
+
+#[test]
+fn multiline_nested_function_error_keeps_source_boundary() {
+    ensure_color_property();
+    let mut stylesheet = StyleSheet::new(PathBuf::from("inline.css"));
+    stylesheet.parse_string("example {\n  color: unknown-function(\n    red\n  );\n}").unwrap();
+
+    assert_eq!(stylesheet.errors.len(), 1);
+    let error = &stylesheet.errors[0];
+    assert_eq!(error.kind, ParseErrorKind::InvalidPropertyValue);
+    assert_eq!(error.message, "Parsing values for property color failed: Unknown function \"unknown-function\"");
+    assert_eq!(error.location.file, "inline.css");
+    assert_eq!(error.location.line, 2);
+    assert_eq!(error.location.column, 27);
+}
+
+#[test]
+fn multiline_unsupported_pseudo_keeps_name_and_source_boundary() {
+    let mut stylesheet = StyleSheet::new(PathBuf::from("inline.css"));
+    stylesheet.parse_string("a:unknown(\n  arg\n) { color: red; }").unwrap();
+
+    assert_eq!(stylesheet.errors.len(), 1);
+    let error = &stylesheet.errors[0];
+    assert_eq!(error.kind, ParseErrorKind::InvalidSelectors);
+    assert_eq!(error.message, "Invalid Selectors: Unsupported pseudo-class or element unknown");
+    assert_eq!(error.location.file, "inline.css");
+    assert_eq!(error.location.line, 1);
+    assert_eq!(error.location.column, 11);
+}
