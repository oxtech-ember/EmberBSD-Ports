+static void main_timer_cb(uv_timer_t* timer) {
+  main_timer_called++;
+  main_timer_called_at = uv_hrtime();
+  embed_closed = 1;
+
+  uv_close((uv_handle_t*) &embed_async, NULL);
+  uv_close((uv_handle_t*) &main_async, NULL);
