+/* Keep this private: callers' paths and environment overrides must not be
+ * relocated. An executable containing static Pango is not a shared library. */
+static char *
+pango_relocate_default (const char *path)
+{
+#ifdef PANGO_HAVE_DLADDR
+  char *prefix = g_canonicalize_filename (PANGO_INSTALL_PREFIX, NULL);
+  char *libdir = g_canonicalize_filename (LIBDIR, NULL);
+  char *configured = g_canonicalize_filename (path, NULL);
+  gsize plen = strlen (prefix);
+  Dl_info image;
+  char *result = NULL;
+
+  if (plen > 1 &&
+      g_str_has_prefix (configured, prefix) && configured[plen] == '/' &&
+      g_str_has_prefix (libdir, prefix) && libdir[plen] == '/' &&
+      dladdr (&pango_library_anchor, &image) && image.dli_fname)
+    {
+      char *resolved = realpath (image.dli_fname, NULL);
+      if (resolved)
+        {
+          char *base = g_path_get_basename (resolved);
+          if (strcmp (base, "libpango-1.0.so") == 0 ||
+              g_str_has_prefix (base, "libpango-1.0.so.") ||
+              (g_str_has_prefix (base, "libpango-1.0.") &&
+               g_str_has_suffix (base, ".dylib")))
+            {
+              char *directory = g_path_get_dirname (resolved);
+              const char *suffix = libdir + plen;
+              gsize len = strlen (directory), slen = strlen (suffix);
+
+              if (len >= slen && g_str_has_suffix (directory, suffix))
+                {
+                  directory[len - slen] = '\0';
+                  result = g_strconcat (directory, configured + plen, NULL);
+                }
+              g_free (directory);
+            }
+          g_free (base);
+          free (resolved);
+        }
+    }
+  g_free (configured);
+  g_free (libdir);
+  g_free (prefix);
+  if (result)
+    return result;
+#endif
+  return g_strdup (path);
+}
