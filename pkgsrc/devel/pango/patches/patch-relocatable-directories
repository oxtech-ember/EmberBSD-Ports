$NetBSD$

Relocate deprecated directory getter defaults with the loaded Pango library.
Preserve environment overrides, cached ABI results and static configurations.
Origin: EmberBSD contributors (AI-assisted).

--- meson.build.orig
+++ meson.build
@@ -208,6 +208,30 @@
 # Dependencies
 pango_deps = []
 
+# Only prefix-owned defaults follow a relocated shared library. Static and
+# externally configured paths retain their configured meaning.
+if host_system in ['darwin', 'netbsd', 'linux']
+  path_deps = []
+  dl_dep = cc.find_library('dl', required: false)
+  if dl_dep.found()
+    path_deps += dl_dep
+  endif
+  if cc.links('''
+    #define _GNU_SOURCE 1
+    #define _DARWIN_C_SOURCE 1
+    #define _NETBSD_SOURCE 1
+    #include <dlfcn.h>
+    static char anchor;
+    int main(void) { Dl_info info; return !dladdr(&anchor, &info); }
+  ''', dependencies: path_deps, name: 'dladdr and Dl_info for default paths')
+    pango_conf.set('PANGO_HAVE_DLADDR', 1)
+    pango_conf.set('_DARWIN_C_SOURCE', 1)
+    pango_conf.set('_NETBSD_SOURCE', 1)
+    pango_conf.set_quoted('PANGO_INSTALL_PREFIX', pango_prefix)
+    pango_deps += path_deps
+  endif
+endif
+
 glib_major_req = 2
 glib_minor_req = 88
 
