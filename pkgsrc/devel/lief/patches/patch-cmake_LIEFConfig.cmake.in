$NetBSD$

Find the external spdlog and tl::expected targets for shared consumers.
Origin: EmberBSD (AI-assisted), not submitted upstream.

--- cmake/LIEFConfig.cmake.in.orig
+++ cmake/LIEFConfig.cmake.in
@@ -76,10 +76,17 @@
     return()
   endif ()
 
+  include(CMakeFindDependencyMacro)
+  if(@LIEF_EXTERNAL_SPDLOG@)
+    find_dependency(spdlog)
+  endif()
+  if(@LIEF_OPT_EXTERNAL_EXPECTED@)
+    find_dependency(tl-expected)
+  endif()
+
   if("${lib_type}" STREQUAL "static")
     # Need to find all dependencies even if they're private when LIEF is
     # compiled statically
-    include(CMakeFindDependencyMacro)
 
     if(@LIEF_EXTERNAL_MBEDTLS@)
       find_dependency(MbedTLS)
@@ -89,10 +96,6 @@
       find_dependency(utf8cpp)
     endif()
 
-    if(@LIEF_EXTERNAL_SPDLOG@)
-      find_dependency(spdlog)
-    endif()
-
     if(@LIEF_ENABLE_JSON@ AND @LIEF_NLOHMANN_JSON_EXTERNAL@)
       find_dependency(nlohmann_json)
     endif()
@@ -101,9 +104,6 @@
       find_dependency(frozen)
     endif()
 
-    if(@LIEF_OPT_EXTERNAL_EXPECTED@)
-      find_dependency(tl-expected)
-    endif()
 
   endif()
 
