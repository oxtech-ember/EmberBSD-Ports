$NetBSD$

Expose exact PSL rule lookup to consumers without changing suffix policy.

--- include/libpsl.h.in.orig
+++ include/libpsl.h.in
@@ -58,6 +58,12 @@
 extern "C" {
 #endif
 
+/* Exact rule flags returned by psl_lookup_rule(); -1 means no match. */
+#define PSL_RULE_EXCEPTION (1<<0)
+#define PSL_RULE_WILDCARD  (1<<1)
+#define PSL_RULE_ICANN     (1<<2)
+#define PSL_RULE_PRIVATE   (1<<3)
+
 /* types for psl_is_public_suffix2() */
 #define PSL_TYPE_ICANN        (1<<0)
 #define PSL_TYPE_PRIVATE      (1<<1)
@@ -120,6 +126,13 @@
 psl_ctx_t *
 	psl_latest(const char *fname);
 
+/* Look up exactly length bytes, without domain normalization or implicit rules.
+ * Embedded NUL, empty and unrepresentable inputs are rejected.
+ * Returns -1 when absent; otherwise returns the PSL_RULE_* bit flags. */
+PSL_API
+int
+	psl_lookup_rule(const psl_ctx_t *psl, const char *domain, size_t length);
+
 /* checks whether domain is a public suffix or not */
 PSL_API
 int
