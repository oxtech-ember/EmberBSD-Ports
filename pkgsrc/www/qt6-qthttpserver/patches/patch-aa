Origin: https://download.qt.io/official_releases/qt/6.12/CVE-2026-110944-qthttpserver-6.12-0001.diff

From d0b683915dd1d29a161366e074aae50ba932c24f Mon Sep 17 00:00:00 2001
From: Mate Barany <mate.barany@qt.io>
Date: Tue, 08 Sep 2026 17:15:25 +0200
Subject: [PATCH] Cap chunk-size line length to prevent memory exhaustion

getChunkSize() appended the chunk-size line into the shared fragment
buffer byte by byte with no ceiling, and the body-size limit never
applies (it gates decoded body bytes only). A chunked request with an
endless hex string or unterminated chunk-extension thus grew fragment
until OOM.

Bound it per byte via isHeaderFieldSizeAllowed() (48 KiB),
sending 400 and returning -1.

Fixes: QTBUG-150270
Pick-to: 6.12.0 6.11
Change-Id: I104d2adca36710ca812e58024dfc5544dcba52af
Reviewed-by: Mårten Nordheim <marten.nordheim@qt.io>
Reviewed-by: Thiago Macieira <thiago.macieira@intel.com>
(cherry picked from commit 988f1d72679f4fe55442af4f431d1c5b11171656)
Reviewed-by: Qt Cherry-pick Bot <cherrypick_bot@qt-project.org>
---

diff --git a/src/httpserver/qhttpserverparser.cpp b/src/httpserver/qhttpserverparser.cpp
index 4fbec04..dd5b563 100644
--- src/httpserver/qhttpserverparser.cpp.orig
+++ src/httpserver/qhttpserverparser.cpp
@@ -563,7 +563,10 @@
             }
             // Note that chunk size gets stored in currentChunkSize, what is returned is the bytes
             // read
-            bytes += getChunkSize(socket, &currentChunkSize);
+            const qsizetype chunkSizeBytes = getChunkSize(socket, &currentChunkSize);
+            if (chunkSizeBytes < 0)
+                return -1;
+            bytes += chunkSizeBytes;
             if (currentChunkSize == -1)
                 break;
             if (!filter->isBodySizeAllowed(bodyBuffer.byteAmount() + currentChunkSize)) {
@@ -643,6 +646,14 @@
 
             bytes += haveRead;
             fragment.append(c);
+            if (!filter->isHeaderFieldSizeAllowed(fragment.size())) {
+                sendError(socket, QHttpServerResponder::StatusCode::BadRequest);
+                socket->skip(socket->bytesAvailable());
+                qCDebug(lcHttpServerParser) << "Chunk size line too long at" << fragment.size()
+                                            << "bytes from client" << getClientIpAddressAndPort();
+                fragment.clear();
+                return -1;
+            }
         }
     }
 
