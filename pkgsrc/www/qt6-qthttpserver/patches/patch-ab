+++ tests/auto/qabstracthttpserver/tst_qabstracthttpserver.cpp
@@ -156,6 +156,8 @@
     void keepAliveTimeout();
     void chunkedRequest();
     void chunkedSizeLineTooLong();
+    void chunkedInvalidSize_data();
