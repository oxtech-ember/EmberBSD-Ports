# Common source identity for native and WASI llhttp artifacts.
# Node's official source release carries the generated llhttp 9.4.4 source.
# No independent 9.4.4 release archive is published; native and WASI use
# this same upstream source and its original licenses.
LLHTTP_VERSION= 9.4.4
DISTNAME= node-v26.13.1
PKGNAME= llhttp-${LLHTTP_VERSION}
CATEGORIES= www
MASTER_SITES= https://nodejs.org/dist/v26.13.1/
EXTRACT_SUFX= .tar.xz
WRKSRC= ${WRKDIR}/node-v26.13.1/deps/llhttp
HOMEPAGE= https://github.com/nodejs/llhttp
LICENSE= mit
