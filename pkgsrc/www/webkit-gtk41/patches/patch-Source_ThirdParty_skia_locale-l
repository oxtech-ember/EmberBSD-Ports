+// NetBSD supplies explicit-locale libc functions but no uselocale. Keep the
+// requested locale private to synchronous Skia formatting and parsing calls.
+// Other platforms keep their existing libc/thread-locale implementation.
+inline int SkLocaleVsnprintf(char* buffer, size_t size, const char* format, va_list args)
+        SK_PRINTF_LIKE(3, 0);
+inline int SkLocaleVsnprintf(char* buffer, size_t size, const char* format, va_list args) {
+#if defined(__NetBSD__)
+    if (locale_t locale = SkAutoLocaleSetter::CurrentLocale()) {
+        return vsnprintf_l(buffer, size, locale, format, args);
+    }
+#endif
+    return std::vsnprintf(buffer, size, format, args);
+}
+
+inline int SkLocaleSnprintf(char* buffer, size_t size, const char* format, ...)
+        SK_PRINTF_LIKE(3, 4);
+inline int SkLocaleSnprintf(char* buffer, size_t size, const char* format, ...) {
+    va_list args;
+    va_start(args, format);
+    int result = SkLocaleVsnprintf(buffer, size, format, args);
+    va_end(args);
+    return result;
+}
+
+inline double SkLocaleStrtod(const char* string, char** end) {
+#if defined(__NetBSD__)
+    if (locale_t locale = SkAutoLocaleSetter::CurrentLocale()) {
+        return strtod_l(string, end, locale);
+    }
+#endif
+    return std::strtod(string, end);
+}
