+static char *
+drmNativeNodeName(const struct drm_native_pci_record *r, int type)
+{
+    struct stat sb;
+    char path[DRM_NODE_NAME_MAX];
+    const char *format = drmGetDeviceName(type);
+    uint32_t maj, min;
+
+    if (!format || (type != DRM_NODE_PRIMARY && type != DRM_NODE_RENDER)) {
+        errno = EINVAL;
+        return NULL;
+    }
+    if (type == DRM_NODE_RENDER && !(r->flags & DRM_NATIVE_RENDER)) {
+        errno = ENODEV;
+        return NULL;
+    }
+    maj = type == DRM_NODE_PRIMARY ? r->primary_major : r->render_major;
+    min = type == DRM_NODE_PRIMARY ? r->primary_minor : r->render_minor;
+    snprintf(path, sizeof(path), format, DRM_DIR_NAME, min);
+    if (stat(path, &sb))
+        return NULL;
+    if (!S_ISCHR(sb.st_mode) || (uint32_t)major(sb.st_rdev) != maj ||
+        (uint32_t)minor(sb.st_rdev) != min) {
+        errno = ENODEV;
+        return NULL;
+    }
+    return strdup(path);
+}
