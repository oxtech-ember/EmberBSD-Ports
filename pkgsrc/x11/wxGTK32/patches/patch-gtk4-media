+///////////////////////////////////////////////////////////////////////////////
+// GTK4 presentation for the shared GstPlayer backend.
+// Origin: EmberBSD (AI-assisted). Licence: wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#include <gst/video/video.h>
+#include <memory>
+#include <cstring>
+
+// Streaming threads only copy pixels into this bounded mailbox. GTK resources
+// belong to the UI context; a GSource (not g_main_context_invoke) always queues
+// their creation there. No callback retains a wx backend/control pointer.
+struct wxGTKMediaFrame
+{
+    GBytes* bytes;
+    int width, height;
+    double aspect;
+    wxGTKMediaFrame(GBytes* b, int w, int h, double a)
+        : bytes(b), width(w), height(h), aspect(a) {}
+    ~wxGTKMediaFrame() { g_bytes_unref(bytes); }
+};
+
+struct wxGTKMediaPresentation
+{
+    GMutex mutex;
+    GWeakRef widget;
+    GMainContext* context;
+    GSource* source;
+    std::shared_ptr<wxGTKMediaFrame> pending;
+    GdkTexture* texture;
+    double aspect;
+    bool active;
+
+    explicit wxGTKMediaPresentation(GtkWidget* w)
+        : context(g_main_context_ref_thread_default()), source(NULL),
+          texture(NULL), aspect(1), active(true)
+    {
+        g_mutex_init(&mutex);
+        g_weak_ref_init(&widget, G_OBJECT(w));
+    }
+    ~wxGTKMediaPresentation()
+    {
+        // Detach clears UI-owned resources before streaming closures can take
+        // the final reference, possibly on a GStreamer thread.
+        wxASSERT(!source && !texture && !active);
+        g_weak_ref_clear(&widget);
+        g_main_context_unref(context);
+        g_mutex_clear(&mutex);
+    }
+
+    void Detach()
+    {
+        g_mutex_lock(&mutex);
+        active = false;
+        GSource* queued = source;
+        source = NULL;
+        pending.reset();
+        g_mutex_unlock(&mutex);
+        if (queued)
+        {
+            g_source_destroy(queued);
+            g_source_unref(queued);
+        }
+        g_clear_object(&texture);
+        g_weak_ref_set(&widget, NULL);
+    }
+};
+typedef std::shared_ptr<wxGTKMediaPresentation> wxGTKMediaPresentationPtr;
+
+static void wxGTKMediaDeleteState(gpointer data)
+{
+    delete static_cast<wxGTKMediaPresentationPtr*>(data);
+}
+static void wxGTKMediaDeleteClosure(gpointer data, GClosure*)
+{
+    wxGTKMediaDeleteState(data);
+}
+
+static gboolean wxGTKMediaDeliver(gpointer data)
+{
+    const wxGTKMediaPresentationPtr state =
+        *static_cast<wxGTKMediaPresentationPtr*>(data);
+    g_mutex_lock(&state->mutex);
+    GSource* source = state->source;
+    state->source = NULL;
+    std::shared_ptr<wxGTKMediaFrame> frame;
+    frame.swap(state->pending);
+    const bool active = state->active;
+    g_mutex_unlock(&state->mutex);
+    if (source)
+        g_source_unref(source);
+    if (!active || !frame)
+        return G_SOURCE_REMOVE;
+
+    GtkWidget* widget = GTK_WIDGET(g_weak_ref_get(&state->widget));
+    if (widget)
+    {
+        GdkTexture* texture = gdk_memory_texture_new(frame->width, frame->height,
+            GDK_MEMORY_R8G8B8A8, frame->bytes, size_t(frame->width) * 4);
+        g_set_object(&state->texture, texture);
+        g_object_unref(texture);
+        state->aspect = frame->aspect;
+        gtk_widget_queue_draw(widget);
+        g_object_unref(widget);
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static void wxGTKMediaQueue(const wxGTKMediaPresentationPtr& state,
+                            const std::shared_ptr<wxGTKMediaFrame>& frame)
+{
+    g_mutex_lock(&state->mutex);
+    if (state->active)
+    {
+        state->pending = frame;
+        if (!state->source)
+        {
+            state->source = g_idle_source_new();
+            g_source_set_callback(state->source, wxGTKMediaDeliver,
+                new wxGTKMediaPresentationPtr(state), wxGTKMediaDeleteState);
+            g_source_attach(state->source, state->context);
+        }
+    }
+    g_mutex_unlock(&state->mutex);
+}
+
+static GstFlowReturn wxGTKMediaSample(GstElement* sink, gpointer data,
+                                      const char* action)
+{
+    const wxGTKMediaPresentationPtr state =
+        *static_cast<wxGTKMediaPresentationPtr*>(data);
+    GstSample* sample = NULL;
+    // Public appsink action signals avoid a second application-specific media
+    // library: the existing gst-plugins-base app plugin provides this sink.
+    g_signal_emit_by_name(sink, action, &sample);
+    if (!sample)
+        return GST_FLOW_FLUSHING;
+    GstVideoInfo info;
+    gst_video_info_init(&info);
+    GstVideoFrame mapped;
+    GstCaps* caps = gst_sample_get_caps(sample);
+    GstBuffer* buffer = gst_sample_get_buffer(sample);
+    if (!caps || !buffer || !gst_video_info_from_caps(&info, caps) ||
+        GST_VIDEO_INFO_FORMAT(&info) != GST_VIDEO_FORMAT_RGBA ||
+        info.width <= 0 || info.height <= 0 ||
+        size_t(info.width) > G_MAXSIZE / 4 / size_t(info.height) ||
+        !gst_video_frame_map(&mapped, &info, buffer, GST_MAP_READ))
+    {
+        gst_sample_unref(sample);
+        return GST_FLOW_ERROR;
+    }
+    const size_t row = size_t(info.width) * 4;
+    const gint stride = GST_VIDEO_FRAME_PLANE_STRIDE(&mapped, 0);
+    const guchar* input = static_cast<const guchar*>(GST_VIDEO_FRAME_PLANE_DATA(&mapped, 0));
+    // GstVideoMeta may supply custom offsets/strides: successful mapping does
+    // not validate the complete visible plane. Check its span before copying,
+    // using subtraction/division so malformed metadata cannot overflow it.
+    const guintptr start = reinterpret_cast<guintptr>(mapped.map[0].data);
+    const guintptr plane = reinterpret_cast<guintptr>(input);
+    const bool inside = input && mapped.map[0].data && plane >= start &&
+                        plane - start <= mapped.map[0].size;
+    const gsize available = inside ? mapped.map[0].size - (plane - start) : 0;
+    if (stride < 0 || size_t(stride) < row || available < row ||
+        size_t(info.height - 1) > (available - row) / size_t(stride))
+    {
+        gst_video_frame_unmap(&mapped);
+        gst_sample_unref(sample);
+        return GST_FLOW_ERROR;
+    }
+    guchar* pixels = static_cast<guchar*>(g_try_malloc(row * info.height));
+    if (!pixels)
+    {
+        gst_video_frame_unmap(&mapped);
+        gst_sample_unref(sample);
+        return GST_FLOW_ERROR;
+    }
+    for (int y = 0; y < info.height; ++y)
+        std::memcpy(pixels + size_t(y) * row, input + size_t(y) * stride, row);
+    gst_video_frame_unmap(&mapped);
+    gst_sample_unref(sample);
+    const double par = info.par_n > 0 && info.par_d > 0
+                     ? double(info.par_n) / info.par_d : 1;
+    wxGTKMediaQueue(state, std::make_shared<wxGTKMediaFrame>(
+        g_bytes_new_take(pixels, row * info.height), info.width, info.height,
+        double(info.width) * par / info.height));
+    return GST_FLOW_OK;
+}
+static GstFlowReturn wxGTKMediaNewSample(GstElement* sink, gpointer data)
+{
+    return wxGTKMediaSample(sink, data, "pull-sample");
+}
+static GstFlowReturn wxGTKMediaNewPreroll(GstElement* sink, gpointer data)
+{
+    return wxGTKMediaSample(sink, data, "pull-preroll");
+}
+
+static void wxGTKMediaSnapshot(GtkWidget* widget, GtkSnapshot* snapshot,
+                               gpointer data)
+{
+    const wxGTKMediaPresentationPtr state =
+        *static_cast<wxGTKMediaPresentationPtr*>(data);
+    const float width = gtk_widget_get_width(widget);
+    const float height = gtk_widget_get_height(widget);
+    if (width <= 0 || height <= 0)
+        return;
+    graphene_rect_t bounds = GRAPHENE_RECT_INIT(0, 0, width, height);
+    const GdkRGBA black = {0, 0, 0, 1};
+    gtk_snapshot_append_color(snapshot, &black, &bounds);
+    if (state->texture)
+    {
+        float w = width, h = width / state->aspect;
+        if (h > height)
+        {
+            h = height;
+            w = height * state->aspect;
+        }
+        bounds = GRAPHENE_RECT_INIT((width-w)/2, (height-h)/2, w, h);
+        gtk_snapshot_append_texture(snapshot, state->texture, &bounds);
+    }
+}
+
+// GstPlayer's public renderer interface owns a normal, independently referenced
+// appsink. GstPlayer/Play takes its own reference when installing the sink.
+struct wxGTKMediaRenderer { GObject parent; GstElement* sink; };
+struct wxGTKMediaRendererClass { GObjectClass parent; };
+static void wx_gtk_media_renderer_interface_init(GstPlayerVideoRendererInterface* iface);
+G_DEFINE_TYPE_WITH_CODE(wxGTKMediaRenderer, wx_gtk_media_renderer, G_TYPE_OBJECT,
+    G_IMPLEMENT_INTERFACE(GST_TYPE_PLAYER_VIDEO_RENDERER,
+                          wx_gtk_media_renderer_interface_init))
+static GstElement* wxGTKMediaCreateSink(GstPlayerVideoRenderer* renderer, GstPlayer*)
+{
+    return reinterpret_cast<wxGTKMediaRenderer*>(renderer)->sink;
+}
+static void wx_gtk_media_renderer_interface_init(GstPlayerVideoRendererInterface* iface)
+{
+    iface->create_video_sink = wxGTKMediaCreateSink;
+}
+static void wxGTKMediaRendererFinalize(GObject* object)
+{
+    wxGTKMediaRenderer* renderer = reinterpret_cast<wxGTKMediaRenderer*>(object);
+    gst_object_unref(renderer->sink);
+    G_OBJECT_CLASS(wx_gtk_media_renderer_parent_class)->finalize(object);
+}
+static void wx_gtk_media_renderer_class_init(wxGTKMediaRendererClass* klass)
+{
+    G_OBJECT_CLASS(klass)->finalize = wxGTKMediaRendererFinalize;
+}
+static void wx_gtk_media_renderer_init(wxGTKMediaRenderer* renderer)
+{
+    renderer->sink = NULL;
+}
+static GstPlayerVideoRenderer* wxGTKMediaCreateRenderer(const wxGTKMediaPresentationPtr& state)
+{
+    GstElement* sink = gst_element_factory_make("appsink", NULL);
+    if (!sink)
+        return NULL;
+    gst_object_ref_sink(sink);
+    GstCaps* caps = gst_caps_from_string("video/x-raw,format=RGBA,colorimetry=sRGB");
+    g_object_set(sink, "caps", caps, "emit-signals", TRUE, "max-buffers", 1u,
+                 "drop", TRUE, "sync", TRUE, "enable-last-sample", FALSE,
+                 "wait-on-eos", FALSE, NULL);
+    gst_caps_unref(caps);
+    g_signal_connect_data(sink, "new-sample", G_CALLBACK(wxGTKMediaNewSample),
+        new wxGTKMediaPresentationPtr(state), wxGTKMediaDeleteClosure, GConnectFlags(0));
+    g_signal_connect_data(sink, "new-preroll", G_CALLBACK(wxGTKMediaNewPreroll),
+        new wxGTKMediaPresentationPtr(state), wxGTKMediaDeleteClosure, GConnectFlags(0));
+    wxGTKMediaRenderer* renderer = static_cast<wxGTKMediaRenderer*>(
+        g_object_new(wx_gtk_media_renderer_get_type(), NULL));
+    renderer->sink = sink;
+    return GST_PLAYER_VIDEO_RENDERER(renderer);
+}
