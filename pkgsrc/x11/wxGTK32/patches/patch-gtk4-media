+#ifdef __WXGTK4__
+// Resizing/layout can invoke application handlers that delete this backend.
+// Retain only weak wx objects across these callbacks, never a raw parent.
+bool wxGStreamerMediaBackend::NotifyGTK4Size(bool loaded)
+{
+    wxWeakRef<wxMediaCtrl> control(m_ctrl);
+    if (!control->HasFlag(wxMC_NO_AUTORESIZE))
+    {
+        control->InvalidateBestSize();
+        control->SetSize(control->GetSize());
+        if (!control)
+            return false;
+        wxWeakRef<wxWindow> parent(control->GetParent());
+        if (parent && parent->GetSizer())
+        {
+            parent->Layout();
+            if (parent && control)
+                parent->Refresh();
+            if (parent && control)
+                parent->Update();
+            if (!control)
+                return false;
+        }
+    }
+    if (loaded)
+        QueueEvent(wxEVT_MEDIA_LOADED);
+    return true;
+}
+#endif
 
