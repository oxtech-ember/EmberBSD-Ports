 // Margin between the field text and the field rect
 #define wxFIELD_TEXT_MARGIN 2
+
+#ifdef __WXGTK4__
+// The window event dispatcher owns this event for the synchronous wx callback.
+// Use its native device, surface coordinates and serial-bearing timestamp.
+extern GdkEvent* g_lastMouseEvent;
+
+static bool wxGTKBeginStatusDrag(GtkWidget* widget, bool rtl, bool resize)
+{
+    GdkEvent* event = g_lastMouseEvent;
+    const int button = resize ? 1 : 3;
+    if (!event)
+        return false;
+    const GdkEventType type = gdk_event_get_event_type(event);
+    if (type == GDK_BUTTON_PRESS)
+    {
+        if (gdk_button_event_get_button(event) != unsigned(button))
+            return false;
+    }
+    else if (!resize || type != GDK_TOUCH_BEGIN ||
+             !gdk_touch_event_get_emulating_pointer(event))
+        return false;
+
+    GtkRoot* root = gtk_widget_get_root(widget);
+    if (!root || !GTK_IS_NATIVE(root))
+        return false;
+    GdkSurface* surface = gtk_native_get_surface(GTK_NATIVE(root));
+    GdkSurface* source = gdk_event_get_surface(event);
+    GdkDevice* device = gdk_event_get_device(event);
+    double x, y;
+    if (!surface || !GDK_IS_TOPLEVEL(surface) || !source || !device ||
+        !gdk_event_get_position(event, &x, &y))
+        return false;
+    if (source != surface &&
+        !gdk_surface_translate_coordinates(source, surface, &x, &y))
+        return false;
+
+    if (resize)
+        gdk_toplevel_begin_resize(GDK_TOPLEVEL(surface),
+            rtl ? GDK_SURFACE_EDGE_SOUTH_WEST : GDK_SURFACE_EDGE_SOUTH_EAST,
+            device, button, x, y, gdk_event_get_time(event));
+    else
+        gdk_toplevel_begin_move(GDK_TOPLEVEL(surface), device, button,
+                               x, y, gdk_event_get_time(event));
+    return true;
+}
+#endif
 
