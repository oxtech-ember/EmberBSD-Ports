+// from evaluate_javascript_finish. The caller owns the latter reference.
+bool wxGetStringFromJSResult(JSCValue* value, wxString* output)
+{
+    JSCContext* context = jsc_value_get_context(value);
+    gchar* text = jsc_value_is_object(value)
+                    ? jsc_value_to_json(value, 0)
+                    : jsc_value_to_string(value);
+    JSCException* exception = jsc_context_get_exception(context);
+    if ( exception || !text )
+    {
+        if ( output )
+            *output = exception
+                ? wxString::FromUTF8(jsc_exception_get_message(exception))
+                : wxString("JavaScript result cannot be converted to a string");
+        g_free(text);
+        jsc_context_clear_exception(context);
+        return false;
+    }
+    if ( output )
+        *output = wxString::FromUTF8(text);
+    g_free(text);
+    return true;
+}
