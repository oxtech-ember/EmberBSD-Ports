+bool wxWebViewWebKit::GTKRunDOMScript(const wxString& script, wxString* output) const
+{
+    // Private DOM operations must not call author-overridden globals/prototypes.
+    // Keep public RunScript in the normal page world.
+    wxJSScriptWrapper wrapper(script, wxJSScriptWrapper::JS_OUTPUT_STRING);
+    wxGtkObject<WebKitWebView> view(WEBKIT_WEB_VIEW(g_object_ref(m_web_view)));
+    wxGtkObject<GAsyncResult> result;
+    webkit_web_view_evaluate_javascript(view, wrapper.GetWrappedCode().utf8_str(), -1,
+                                      "wxWidgets.DOM", NULL, NULL,
+                                      wxgtk_dom_script_ready, result.Out());
+    GMainContext* context = g_main_context_get_thread_default();
+    while ( !result.get() )
+        g_main_context_iteration(context, TRUE);
+
+    wxGtkError error;
+    wxGtkObject<JSCValue> value(
+        webkit_web_view_evaluate_javascript_finish(view, result, error.Out()));
+    wxString text;
+    if ( !value.get() || !wxGetStringFromJSResult(value, &text) )
+        return false;
+    wxString unwrapped;
+    if ( !wxJSScriptWrapper::ExtractOutput(text, &unwrapped) )
+        return false;
+    if ( output )
+        *output = unwrapped;
+    return true;
+}
+#endif
