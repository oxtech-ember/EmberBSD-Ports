+///////////////////////////////////////////////////////////////////////////////
+// Shared GTK4 native window state requests. Origin: EmberBSD (AI-assisted).
+// Licence: wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#ifndef _WX_GTK_PRIVATE_WINDOWSTATE4_H_
+#define _WX_GTK_PRIVATE_WINDOWSTATE4_H_
+#include <gtk/gtk.h>
+#ifdef GDK_WINDOWING_X11
+#include <gdk/x11/gdkx.h>
+#include <X11/Xlib.h>
+#endif
+namespace wxGTKWindowState4
+{
+// Apply after mapping, when the WM manages the surface. Wayland deliberately
+// has no equivalent public always-on-top protocol; return false there.
+inline bool SetKeepAbove(GtkWindow* window, bool above)
+{
+    if (!gtk_widget_get_mapped(GTK_WIDGET(window))) return false;
+    GdkSurface* surface = gtk_native_get_surface(GTK_NATIVE(window));
+#ifdef GDK_WINDOWING_X11
+    if (surface && GDK_IS_X11_SURFACE(surface))
+    {
+        Display* display = gdk_x11_display_get_xdisplay(gdk_surface_get_display(surface));
+        XEvent event = {};
+        event.xclient.type = ClientMessage;
+        event.xclient.window = gdk_x11_surface_get_xid(surface);
+        event.xclient.message_type = XInternAtom(display, "_NET_WM_STATE", False);
+        event.xclient.format = 32;
+        event.xclient.data.l[0] = above ? 1 : 0;
+        event.xclient.data.l[1] = XInternAtom(display, "_NET_WM_STATE_ABOVE", False);
+        event.xclient.data.l[3] = 1;
+        XSendEvent(display, DefaultRootWindow(display), False,
+                   SubstructureRedirectMask | SubstructureNotifyMask, &event);
+        return true;
+    }
+#endif
+    wxUnusedVar(surface);
+    wxUnusedVar(above);
+    return false;
+}
+}
+#endif
