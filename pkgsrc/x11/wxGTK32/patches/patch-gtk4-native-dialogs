+///////////////////////////////////////////////////////////////////////////////
+// GTK4 native modal responses using the existing wx GUI event loop.
+// Origin: EmberBSD (AI-assisted). wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#ifndef _WX_GTK_PRIVATE_NATIVE_DIALOG4_H_
+#define _WX_GTK_PRIVATE_NATIVE_DIALOG4_H_
+#include <gtk/gtk.h>
+#include "wx/evtloop.h"
+#include "wx/gtk/private/object.h"
+#include "wx/gtk/private/dialogcount.h"
+
+namespace wxGTKNativeDialog4
+{
+inline bool IsToplevel(GtkWindow* window)
+{
+    GListModel* windows = gtk_window_get_toplevels();
+    for (guint i = 0; i < g_list_model_get_n_items(windows); ++i)
+    {
+        wxGtkObject<GObject> candidate(G_OBJECT(g_list_model_get_item(windows, i)));
+        if (candidate.get() == G_OBJECT(window)) return true;
+    }
+    return false;
+}
+inline GtkWindow* Parent(GtkWidget* widget)
+{
+    GtkRoot* root = widget ? gtk_widget_get_root(widget) : NULL;
+    return GTK_IS_WINDOW(root) ? GTK_WINDOW(root) : NULL;
+}
+// Keep a raw native dialog alive after Run returns and destroy it on every
+// exit path, including exceptions and removal from the GTK toplevel registry.
+class DialogOwner
+{
+    wxGtkObject<GtkWidget> m_widget;
+public:
+    explicit DialogOwner(GtkWidget* widget) : m_widget(GTK_WIDGET(g_object_ref(widget))) {}
+    ~DialogOwner() { gtk_window_destroy(GTK_WINDOW(m_widget.get())); }
+private:
+    wxDECLARE_NO_COPY_CLASS(DialogOwner);
+};
+class RunState
+{
+    // OnEventLoopEnter can respond before wxEventLoopBase::Run has set its
+    // running flag. DoRun must observe that response before starting GLib.
+    class Loop : public wxGUIEventLoop
+    {
+        bool& m_done;
+    public:
+        explicit Loop(bool& done) : m_done(done) {}
+        void Stop() { if (IsInsideRun()) ScheduleExit(); }
+    protected:
+        int DoRun() wxOVERRIDE
+        {
+            if (!m_done) return wxGUIEventLoop::DoRun();
+            OnExit();
+            return 0;
+        }
+    };
+    wxGtkObject<GtkDialog> m_dialog;
+    wxGtkObject<GtkWindow> m_parent;
+    bool m_done;
+    gint m_response;
+    Loop m_loop;
+    bool m_wasModal;
+    gulong m_responseHandler, m_closeHandler, m_visibleHandler, m_destroyHandler;
+    gulong m_windowsHandler;
+
+    void Finish(gint response)
+    {
+        if (m_done) return;
+        m_response = response;
+        m_done = true;
+        m_loop.Stop();
+    }
+    static void Disconnect(gpointer object, gulong handler)
+    {
+        if (g_signal_handler_is_connected(object, handler))
+            g_signal_handler_disconnect(object, handler);
+    }
+    static void Response(GtkDialog*, gint response, gpointer data)
+    { static_cast<RunState*>(data)->Finish(response); }
+    static gboolean Close(GtkWindow*, gpointer data)
+    {
+        static_cast<RunState*>(data)->Finish(GTK_RESPONSE_DELETE_EVENT);
+        return TRUE;
+    }
+    static void Hidden(GObject* object, GParamSpec*, gpointer data)
+    {
+        if (!gtk_widget_get_visible(GTK_WIDGET(object)))
+            static_cast<RunState*>(data)->Finish(GTK_RESPONSE_NONE);
+    }
+    static void Destroy(GtkWidget*, gpointer data)
+    { static_cast<RunState*>(data)->Finish(GTK_RESPONSE_NONE); }
+    static void WindowsChanged(GListModel*, guint, guint, guint, gpointer data)
+    {
+        RunState* self = static_cast<RunState*>(data);
+        if (!IsToplevel(GTK_WINDOW(self->m_dialog.get())) ||
+            (self->m_parent.get() && !IsToplevel(self->m_parent)))
+            self->Finish(GTK_RESPONSE_NONE);
+    }
+public:
+    explicit RunState(GtkDialog* dialog)
+        : m_dialog(GTK_DIALOG(g_object_ref(dialog))), m_done(false),
+          m_response(GTK_RESPONSE_NONE), m_loop(m_done),
+          m_wasModal(gtk_window_get_modal(GTK_WINDOW(dialog)))
+    {
+        GtkWindow* parent = gtk_window_get_transient_for(GTK_WINDOW(dialog));
+        if (parent) m_parent = GTK_WINDOW(g_object_ref(parent));
+        m_responseHandler = g_signal_connect(dialog, "response", G_CALLBACK(Response), this);
+        m_closeHandler = g_signal_connect(dialog, "close-request", G_CALLBACK(Close), this);
+        m_visibleHandler = g_signal_connect(dialog, "notify::visible", G_CALLBACK(Hidden), this);
+        m_destroyHandler = g_signal_connect(dialog, "destroy", G_CALLBACK(Destroy), this);
+        m_windowsHandler = g_signal_connect(gtk_window_get_toplevels(), "items-changed",
+                                           G_CALLBACK(WindowsChanged), this);
+    }
+    ~RunState()
+    {
+        Disconnect(gtk_window_get_toplevels(), m_windowsHandler);
+        Disconnect(m_dialog, m_responseHandler);
+        Disconnect(m_dialog, m_closeHandler);
+        Disconnect(m_dialog, m_visibleHandler);
+        Disconnect(m_dialog, m_destroyHandler);
+        if (IsToplevel(GTK_WINDOW(m_dialog.get())))
+            gtk_window_set_modal(GTK_WINDOW(m_dialog.get()), m_wasModal);
+    }
+    gint Run()
+    {
+        wxOpenModalDialogLocker modalCount;
+        WindowsChanged(NULL, 0, 0, 0, this);
+        if (!m_done)
+        {
+            gtk_window_set_modal(GTK_WINDOW(m_dialog.get()), TRUE);
+            if (!m_done) gtk_window_present(GTK_WINDOW(m_dialog.get()));
+            if (!m_done) m_loop.Run();
+        }
+        return m_response;
+    }
+private:
+    wxDECLARE_NO_COPY_CLASS(RunState);
+};
+inline gint Run(GtkDialog* dialog) { RunState state(dialog); return state.Run(); }
+}
+#endif
