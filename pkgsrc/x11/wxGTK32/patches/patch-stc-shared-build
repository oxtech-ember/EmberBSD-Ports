$NetBSD$

Origin: EmberBSD (AI-assisted).
Use the common toolkit-neutral Scintilla core and Lexilla providers.
Keep Autoconf, its generated makefile and the optional CMake path aligned;
no bundled editor core, lexers or automatic wx API regeneration.
Installed static link interfaces resolve the common providers in their
installed prefix, independently of build-time sysroot and staging paths.

--- configure.in.orig
+++ configure.in
@@ -8196,6 +8196,19 @@
     EXTRALIBS_STC="-limm32"
 fi
 
+# Use the common Ports providers; never fall back to bundled source.
+WXCONFIG_LIBS_STC="$EXTRALIBS_STC"
+if test "$wxUSE_STC" = "yes"; then
+    if test -z "$PKG_CONFIG" || ! $PKG_CONFIG --exists scintilla-core lexilla-access; then
+        AC_MSG_ERROR([wxStyledTextCtrl requires the shared Scintilla core and Lexilla providers])
+    fi
+    STC_CFLAGS=`$PKG_CONFIG --cflags scintilla-core lexilla-access`
+    # Installed wx-config uses its own relocatable libdir for the common prefix.
+    # Keep staging/sysroot search directories only in the build link command.
+    WXCONFIG_LIBS_STC="$EXTRALIBS_STC `$PKG_CONFIG --libs-only-l --libs-only-other scintilla-core lexilla-access`"
+    EXTRALIBS_STC="$EXTRALIBS_STC `$PKG_CONFIG --libs scintilla-core lexilla-access`"
+fi
+
