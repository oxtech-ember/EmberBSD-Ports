@@ -178,6 +178,24 @@
 
 include(CMakeFindDependencyMacro)
 
+# Static wx exports retain private STC dependencies as LINK_ONLY targets.
+# Inspect the selected targets: a monolithic wxstc is an interface to wxmono,
+# and an installation may offer both shared and static platform variants.
+if(@wxUSE_STC@)
+    foreach(_wx_stc_owner wx::wxstc wx::wxmono)
+        if(TARGET ${_wx_stc_owner})
+            get_target_property(_wx_stc_type ${_wx_stc_owner} TYPE)
+            if(_wx_stc_type STREQUAL "STATIC_LIBRARY")
+                find_dependency(ScintillaCore CONFIG)
+                find_dependency(Lexilla CONFIG)
+                break()
+            endif()
+        endif()
+    endforeach()
+    unset(_wx_stc_owner)
+    unset(_wx_stc_type)
+endif()
