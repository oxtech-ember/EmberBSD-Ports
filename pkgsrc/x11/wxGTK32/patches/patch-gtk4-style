+///////////////////////////////////////////////////////////////////////////////
+// GTK4 theme queries through real, rooted widgets and public style APIs.
+// Origin: EmberBSD (AI-assisted). Licence: wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+
+namespace
+{
+GtkWidget* FindStyleChild(GtkWidget* widget, const char* name)
+{
+    for (GtkWidget* child = gtk_widget_get_first_child(widget); child;
+         child = gtk_widget_get_next_sibling(child))
+    {
+        if (strcmp(gtk_widget_get_css_name(child), name) == 0)
+            return child;
+        if (GtkWidget* found = FindStyleChild(child, name))
+            return found;
+    }
+    return NULL;
+}
+
+// GtkTooltip's implementation is private. A public GtkWindow subclass gives
+// the measurement widget the standard tooltip CSS name without accessing it.
+struct wxThemeTooltip { GtkWindow parent; };
+struct wxThemeTooltipClass { GtkWindowClass parent; };
+G_DEFINE_TYPE(wxThemeTooltip, wx_theme_tooltip, GTK_TYPE_WINDOW)
+static void wx_theme_tooltip_class_init(wxThemeTooltipClass* klass)
+{
+    gtk_widget_class_set_css_name(GTK_WIDGET_CLASS(klass), "tooltip");
+}
+static void wx_theme_tooltip_init(wxThemeTooltip* self)
+{
+    gtk_window_set_child(GTK_WINDOW(self), gtk_label_new(""));
+}
+
+wxColour SampleStyleColour(GtkStyleContext* context, bool frame)
+{
+    // This is a tiny colour query, not a replacement for GTK's renderer.
+    cairo_surface_t* surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, 16, 16);
+    if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS)
+    {
+        cairo_surface_destroy(surface);
+        return wxColour(0, 0, 0, 0);
+    }
+    cairo_t* cr = cairo_create(surface);
+    if (frame) gtk_render_frame(context, cr, 0, 0, 16, 16);
+    else gtk_render_background(context, cr, 0, 0, 16, 16);
+    cairo_destroy(cr);
+    cairo_surface_flush(surface);
+    const unsigned char* data = cairo_image_surface_get_data(surface);
+    const int stride = cairo_image_surface_get_stride(surface);
+    unsigned pixel = 0;
+    if (frame)
+    {
+        for (int y = 0; y < 16; ++y)
+            for (int x = 0; x < 16; ++x)
+            {
+                unsigned sample;
+                memcpy(&sample, data + y * stride + x * 4, sizeof(sample));
+                if ((sample >> 24) > (pixel >> 24)) pixel = sample;
+            }
+    }
+    else
+        memcpy(&pixel, data + 8 * stride + 8 * 4, sizeof(pixel));
+    cairo_surface_destroy(surface);
+    const unsigned a = pixel >> 24;
+    if (!a) return wxColour(0, 0, 0, 0);
+    return wxColour(((pixel >> 16) & 255) * 255 / a,
+                    ((pixel >> 8) & 255) * 255 / a,
+                    (pixel & 255) * 255 / a, a);
+}
+}
+
+wxGtkStyleContext::wxGtkStyleContext(double scale)
+    : m_context(NULL), m_widget(NULL), m_selection(false), m_scale(wxMax(1, int(scale)))
+{
+}
+
+void wxGtkStyleContext::Select(GtkWidget* widget)
+{
+    if (m_context) gtk_style_context_restore(m_context);
+    if (m_widget) g_object_unref(m_widget);
+    m_widget = GTK_WIDGET(g_object_ref(widget));
+    m_selection = false;
+    m_context = gtk_widget_get_style_context(widget);
+    gtk_style_context_save(m_context);
+    gtk_style_context_set_scale(m_context, m_scale);
+}
+
+wxGtkStyleContext::~wxGtkStyleContext()
+{
+    if (m_context) gtk_style_context_restore(m_context);
+    if (m_widget) g_object_unref(m_widget);
+}
+
+wxGtkStyleContext& wxGtkStyleContext::Add(GType type, const char* name, ...)
+{
+    if (type == G_TYPE_NONE)
+        Add(name);
+    else
+        Select(wxGTKPrivate::GetStyleWidget(type));
+    va_list args;
+    va_start(args, name);
+    while (const char* cssClass = va_arg(args, const char*))
+        gtk_style_context_add_class(m_context, cssClass);
+    va_end(args);
+    return *this;
+}
+
+wxGtkStyleContext& wxGtkStyleContext::Add(const char* name)
+{
+    if (m_widget)
+        if (GtkWidget* child = FindStyleChild(m_widget, name)) Select(child);
+    return *this;
+}
+
+wxGtkStyleContext& wxGtkStyleContext::AddButton()
+{
+    return Add(GTK_TYPE_BUTTON, "button", NULL);
+}
+wxGtkStyleContext& wxGtkStyleContext::AddCheckButton()
+{
+    return Add(GTK_TYPE_CHECK_BUTTON, "checkbutton", NULL);
+}
+wxGtkStyleContext& wxGtkStyleContext::AddRadioButton()
+{
+    Select(wxGTKPrivate::GetRadioButtonWidget());
+    return Add("radio");
+}
+wxGtkStyleContext& wxGtkStyleContext::AddHeaderbar()
+{
+    return Add(GTK_TYPE_HEADER_BAR, "headerbar", "titlebar", NULL);
+}
+wxGtkStyleContext& wxGtkStyleContext::AddLabel()
+{
+    GtkWidget* label = m_widget ? FindStyleChild(m_widget, "label") : NULL;
+    if (!label && m_widget && GTK_IS_BUTTON(m_widget))
+    {
+        gtk_button_set_child(GTK_BUTTON(m_widget), gtk_label_new(""));
+        label = gtk_button_get_child(GTK_BUTTON(m_widget));
+    }
+    if (!label && m_widget && GTK_IS_HEADER_BAR(m_widget))
+    {
+        label = gtk_label_new("");
+        gtk_header_bar_set_title_widget(GTK_HEADER_BAR(m_widget), label);
+    }
+    Select(label ? label : wxGTKPrivate::GetStyleWidget(GTK_TYPE_LABEL));
+    return *this;
+}
+wxGtkStyleContext& wxGtkStyleContext::AddMenu()
+{
+    Select(wxGTKPrivate::GetStyleWidget(GTK_TYPE_POPOVER));
+    return Add("contents");
+}
+wxGtkStyleContext& wxGtkStyleContext::AddMenuItem()
+{
+    GtkWidget* popover = wxGTKPrivate::GetStyleWidget(GTK_TYPE_POPOVER);
+    GtkWidget* button = gtk_popover_get_child(GTK_POPOVER(popover));
+    if (!button)
+    {
+        button = gtk_button_new_with_label("");
+        gtk_widget_add_css_class(button, "flat");
+        gtk_popover_set_child(GTK_POPOVER(popover), button);
+    }
+    Select(button);
+    return *this;
+}
+wxGtkStyleContext& wxGtkStyleContext::AddTextview(const char* child1, const char* child2)
+{
+    Select(wxGTKPrivate::GetStyleWidget(GTK_TYPE_TEXT_VIEW));
+    // "text" and "selection" are CSS nodes, not public GtkWidgets. Query
+    // the theme's selection colours instead of inventing a widget path.
+    m_selection = (child1 && strcmp(child1, "selection") == 0) ||
+                  (child2 && strcmp(child2, "selection") == 0);
+    return *this;
+}
+wxGtkStyleContext& wxGtkStyleContext::AddTooltip()
+{
+    Select(wxGTKPrivate::GetStyleWidget(wx_theme_tooltip_get_type()));
+    return *this;
+}
+wxGtkStyleContext& wxGtkStyleContext::AddTreeview()
+{
+    return Add(GTK_TYPE_TREE_VIEW, "treeview", NULL);
+}
+wxGtkStyleContext& wxGtkStyleContext::AddTreeviewHeaderButton(int pos)
+{
+    Select(pos == 0 ? wxGTKPrivate::GetHeaderButtonWidgetFirst() :
+           pos == 2 ? wxGTKPrivate::GetHeaderButtonWidgetLast() :
+                      wxGTKPrivate::GetHeaderButtonWidget());
+    return *this;
+}
+wxGtkStyleContext& wxGtkStyleContext::AddWindow(const char* cssClass)
+{
+    return Add(GTK_TYPE_WINDOW, "window", "background", cssClass, NULL);
+}
+void wxGtkStyleContext::Bg(wxColour& color, int state) const
+{
+    gtk_style_context_set_state(m_context, GtkStateFlags(state));
+    GdkRGBA rgba;
+    if (m_selection &&
+        (gtk_style_context_lookup_color(m_context, "theme_selected_bg_color", &rgba) ||
+         gtk_style_context_lookup_color(m_context, "accent_bg_color", &rgba)))
+        color = wxColour(rgba);
+    else
+        color = SampleStyleColour(m_context, false);
+    if (!color.Alpha() && !GTK_IS_WINDOW(m_widget))
+        wxGtkStyleContext().AddWindow().Bg(color, state);
+}
+void wxGtkStyleContext::Fg(wxColour& color, int state) const
+{
+    gtk_style_context_set_state(m_context, GtkStateFlags(state));
+    GdkRGBA rgba;
+    if (!(m_selection &&
+          (gtk_style_context_lookup_color(m_context, "theme_selected_fg_color", &rgba) ||
+           gtk_style_context_lookup_color(m_context, "accent_fg_color", &rgba))))
+        gtk_style_context_get_color(m_context, &rgba);
+    color = wxColour(rgba);
+}
+void wxGtkStyleContext::Border(wxColour& color) const
+{
+    color = SampleStyleColour(m_context, true);
+}
