+// One rooted native widget per kind. GTK updates its CSS when settings change;
+// the scoped style helper saves/restores each context instead of mutating it
+// permanently. No GtkWidgetPath or private CSS node API is used.
+GtkWidget* GetStyleWidget(GType type)
+{
+    if (type == GTK_TYPE_WINDOW)
+        return gtk_widget_get_parent(GetContainer());
+    if (type == GTK_TYPE_BUTTON) return GetButtonWidget();
+    if (type == GTK_TYPE_CHECK_BUTTON) return GetCheckButtonWidget();
+    if (type == GTK_TYPE_ENTRY) return GetEntryWidget();
+    if (type == GTK_TYPE_TREE_VIEW) return GetTreeWidget();
+    if (type == GTK_TYPE_NOTEBOOK) return GetNotebookWidget();
+    if (type == GTK_TYPE_PANED) return GetSplitterWidget();
+    if (!gs_styleWidgets)
+        gs_styleWidgets = g_hash_table_new(g_direct_hash, g_direct_equal);
+    GtkWidget* widget = static_cast<GtkWidget*>(
+        g_hash_table_lookup(gs_styleWidgets, GSIZE_TO_POINTER(type)));
+    if (!widget)
+    {
+        if (type == GTK_TYPE_LINK_BUTTON)
+            widget = gtk_link_button_new_with_label("", "");
+        else if (type == GTK_TYPE_SCROLLBAR)
+            widget = gtk_scrollbar_new(GTK_ORIENTATION_VERTICAL, NULL);
+        else
+            widget = GTK_WIDGET(g_object_new(type, NULL));
+        if (!GTK_IS_WINDOW(widget))
+        {
+            if (GTK_IS_POPOVER(widget))
+                gtk_widget_set_parent(widget, GetContainer());
+            else
+                AddToContainer(widget);
+        }
+        g_hash_table_insert(gs_styleWidgets, GSIZE_TO_POINTER(type), widget);
+    }
+    return widget;
+}
+#endif
 
