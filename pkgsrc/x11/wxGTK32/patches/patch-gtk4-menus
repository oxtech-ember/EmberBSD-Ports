+bool wxMenu::GTKPopup(wxWindow* invoking, GtkWidget* anchor, int x, int y)
+{
+    if (m_popupShown || !gtk_widget_get_root(anchor) || !gtk_widget_get_mapped(anchor)) return false;
+    wxGTKMenuPopupScope scope(this, invoking);
+    if (!scope.alive || !scope.invoking || scope.invoking->IsBeingDeleted()) return false;
+    wxEventLoopGuarantor ensureLoop;
+    wxEventLoopBase* loop = wxEventLoopBase::GetActive();
+    GtkWidget* popover = scope.popover;
+    gtk_widget_set_parent(popover, anchor);
+    SetupBitmaps(invoking);
+    if (x == -1 && y == -1)
+    {
+        // Use the real pointer's surface coordinates, translated to anchor.
+        GdkDisplay* display = gtk_widget_get_display(anchor);
+        GdkSeat* seat = gdk_display_get_default_seat(display);
+        GdkDevice* pointer = seat ? gdk_seat_get_pointer(seat) : NULL;
+        double px = 0, py = 0;
+        GdkSurface* surface = pointer ? gdk_device_get_surface_at_position(pointer, &px, &py) : NULL;
+        GtkNative* native = gtk_widget_get_native(anchor);
+        double sx = 0, sy = 0;
+        if (native) gtk_native_get_surface_transform(native, &sx, &sy);
+        graphene_point_t from, to;
+        graphene_point_init(&from, px + sx, py + sy);
+        if (native && surface == gtk_native_get_surface(native) &&
+            gtk_widget_compute_point(GTK_WIDGET(native), anchor, &from, &to))
+        { x = int(to.x); y = int(to.y); }
+        else { x = 0; y = gtk_widget_get_height(anchor); }
+    }
+    const GdkRectangle rect = { x, y, 1, 1 };
+    gtk_popover_set_pointing_to(GTK_POPOVER(popover), &rect);
+    m_popupShown = true;
+    gtk_popover_popup(GTK_POPOVER(popover));
+    const bool shown = scope.alive && gtk_widget_get_visible(popover);
+    while (scope.alive && scope.invoking && !scope.invoking->IsBeingDeleted() &&
+           scope.alive->m_popupShown && gtk_widget_get_visible(popover))
+        if (!loop || loop->DispatchTimeout(50) == 0) break;
+    return shown;
+}
