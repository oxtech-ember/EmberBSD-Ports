+namespace
+{
+class wxGTKMenuPopupScope
+{
+public:
+    wxGTKMenuPopupScope(wxMenu* menu, wxWindow* window)
+        : alive(menu), invoking(window), popover(menu->m_menu), owner(menu->m_owner)
+    {
+        g_object_ref(popover);
+        if (owner) { g_object_ref(owner); gtk_menu_button_set_popover(GTK_MENU_BUTTON(owner), NULL); }
+    }
+    ~wxGTKMenuPopupScope()
+    {
+        if (alive && (!invoking || invoking->IsBeingDeleted())) alive->SetInvokingWindow(NULL);
+        gtk_popover_popdown(GTK_POPOVER(popover));
+        if (gtk_widget_get_parent(popover)) gtk_widget_unparent(popover);
+        if (alive)
+        {
+            alive->m_popupShown = false;
+            if (owner && invoking && !invoking->IsBeingDeleted() && gtk_widget_get_root(owner))
+                gtk_menu_button_set_popover(GTK_MENU_BUTTON(owner), popover);
+        }
+        if (owner) g_object_unref(owner);
+        g_object_unref(popover);
+    }
+    wxWeakRef<wxMenu> alive;
+    wxWeakRef<wxWindow> invoking;
+    GtkWidget *popover, *owner;
+};
+}
