+extern int wxOpenModalDialogsCount;
+
+struct wxGTKMenuItemData
+{
+    wxGTKMenuItemData() : action(NULL), label(NULL), accel(NULL), image(NULL) {}
+    GSimpleAction* action;
+    GtkWidget *label, *accel, *image;
+    std::string name;
+};
+struct wxGTKMenuData
+{
+    wxGTKMenuData() : model(g_menu_new()), actions(g_simple_action_group_new()),
+        shortcuts(g_list_store_new(GTK_TYPE_SHORTCUT)), rebuilding(false), opened(false) {}
+    GMenu* model;
+    GSimpleActionGroup* actions;
+    GListStore* shortcuts;
+    bool rebuilding, opened;
+};
+struct wxGTKMenuBarData
+{
+    wxGTKMenuBarData() : shortcuts(g_list_store_new(GTK_TYPE_SHORTCUT)), controller(NULL), host(NULL) {}
+    GListStore* shortcuts;
+    GtkEventController* controller;
+    GtkWidget* host; // weak, cleared by GObject on host destruction
+};
+
+namespace
+{
+static unsigned wxGTKMenuSerial;
+static bool wxGTKMenuUpdating(wxMenu* menu)
+{
+    for (; menu; menu = menu->GetParent())
+        if (menu->m_gtkMenu->rebuilding) return true;
+    return false;
+}
+static bool wxGTKMenuAllowed(wxMenu* menu)
+{
+    if (!menu || !menu->GetWindow() || menu->GetWindow()->IsBeingDeleted() || !menu->GetWindow()->IsEnabled()) return false;
+    if (wxOpenModalDialogsCount && !wxDynamicCast(wxGetTopLevelParent(menu->GetWindow()), wxDialog))
+        return false;
+    for (wxMenu* parent = menu; parent; parent = parent->GetParent())
+        if (parent->m_owner && !gtk_widget_get_sensitive(parent->m_owner)) return false;
+    return true;
+}
+static void wxGTKMenuEvent(wxMenu* menu, wxEventType type, int id)
+{
+    if (!wxGTKMenuAllowed(menu)) return;
+    wxMenuEvent event(type, id, menu);
+    wxMenu::ProcessMenuEvent(menu, event, menu->GetWindow());
+}
+static wxMenuItem* wxGTKMenuItemFromAction(GObject* action)
+{
+    return static_cast<wxMenuItem*>(g_object_get_data(action, "wx-menu-item"));
+}
+static void wxGTKMenuCloseTree(wxMenu* menu)
+{
+    // Closing emits wx events, which are permitted to delete the menu.
+    wxWeakRef<wxMenu> alive(menu);
+    for (size_t i = 0; alive && i < menu->GetMenuItemCount(); ++i)
+    {
+        wxMenuItem* item = menu->FindItemByPosition(i);
+        if (item->IsSubMenu()) wxGTKMenuCloseTree(item->GetSubMenu());
+    }
+    if (alive) gtk_popover_popdown(GTK_POPOVER(menu->m_menu));
+}
+static void wxGTKMenuActivate(GSimpleAction* action, GVariant*, gpointer)
+{
+    wxMenuItem* item = wxGTKMenuItemFromAction(G_OBJECT(action));
+    if (!item || !item->IsEnabled() || !wxGTKMenuAllowed(item->GetMenu())) return;
+    if (item->IsSubMenu())
+    {
+        std::vector<wxWeakRef<wxMenu> > chain;
+        for (wxMenu* current = item->GetSubMenu(); current; current = current->GetParent())
+            chain.push_back(wxWeakRef<wxMenu>(current));
+        for (auto it = chain.rbegin(); it != chain.rend(); ++it)
+            if (*it && (*it)->m_owner) gtk_menu_button_popup(GTK_MENU_BUTTON((*it)->m_owner));
+        return;
+    }
+    if (item->GetKind() == wxITEM_RADIO && item->IsChecked()) return;
+    if (item->IsCheckable()) item->Check(item->GetKind() == wxITEM_RADIO || !item->IsChecked());
+    const int id = item->GetId(), checked = item->IsCheckable() ? item->IsChecked() : -1;
+    wxWeakRef<wxMenu> alive(item->GetMenu());
+    wxMenu* root = item->GetMenu();
+    while (root->GetParent() && !root->m_popupShown) root = root->GetParent();
+    wxGTKMenuCloseTree(root);
+    if (alive) alive->SendEvent(id, checked);
+    wxWakeUpIdle();
+}
+static void wxGTKMenuHighlight(GObject* action, bool selected)
+{
+    wxMenuItem* item = wxGTKMenuItemFromAction(action);
+    if (item && item->IsEnabled() && item->GetMenu() && !wxGTKMenuUpdating(item->GetMenu()))
+        wxGTKMenuEvent(item->GetMenu(), wxEVT_MENU_HIGHLIGHT, selected ? item->GetId() : wxID_NONE);
+}
+static void wxGTKMenuEnter(GtkEventControllerMotion*, double, double, GObject* action)
+{ wxGTKMenuHighlight(action, true); }
+static void wxGTKMenuLeave(GtkEventControllerMotion*, GObject* action)
+{ wxGTKMenuHighlight(action, false); }
+static void wxGTKMenuFocusIn(GtkEventControllerFocus*, GObject* action)
+{ wxGTKMenuHighlight(action, true); }
+static void wxGTKMenuFocusOut(GtkEventControllerFocus*, GObject* action)
+{ wxGTKMenuHighlight(action, false); }
+static void wxGTKMenuUnref(gpointer data, GClosure*) { g_object_unref(data); }
+static void wxGTKMenuConnect(gpointer object, const char* signal, GCallback callback, GObject* action)
+{
+    g_signal_connect_data(object, signal, callback, g_object_ref(action), wxGTKMenuUnref, G_CONNECT_DEFAULT);
+}
+static gboolean wxGTKMenuRowKey(GtkEventControllerKey*, guint key, guint, GdkModifierType, GObject* action)
+{
+    wxMenuItem* item = wxGTKMenuItemFromAction(action);
+    if (!item || !item->GetMenu()) return FALSE;
+    wxMenu* menu = item->GetMenu();
+    const bool rtl = menu->GetLayoutDirection() == wxLayout_RightToLeft;
+    if (item->IsSubMenu() && key == (rtl ? GDK_KEY_Left : GDK_KEY_Right))
+    {
+        if (item->IsEnabled()) gtk_menu_button_popup(GTK_MENU_BUTTON(item->GetMenuItem()));
+        return TRUE;
+    }
+    if (menu->GetParent() && key == (rtl ? GDK_KEY_Right : GDK_KEY_Left))
+    {
+        GtkWidget* owner = menu->m_owner;
+        if (owner) g_object_ref(owner);
+        gtk_popover_popdown(GTK_POPOVER(menu->m_menu));
+        if (owner) { gtk_widget_grab_focus(owner); g_object_unref(owner); }
+        return TRUE;
+    }
+    if (!menu->GetParent() && menu->GetMenuBar() &&
+        (key == GDK_KEY_Left || key == GDK_KEY_Right))
+    {
+        GtkWidget* owner = menu->m_owner;
+        GtkWidget* bar = owner ? gtk_widget_get_parent(owner) : NULL;
+        if (!bar) return FALSE;
+        const bool next = (key == GDK_KEY_Right) != rtl;
+        GtkWidget* target = owner;
+        do
+        {
+            target = next ? gtk_widget_get_next_sibling(target) : gtk_widget_get_prev_sibling(target);
+            if (!target) target = next ? gtk_widget_get_first_child(bar) : gtk_widget_get_last_child(bar);
+            if (!target) return FALSE;
+            if (gtk_widget_get_sensitive(target)) break;
+        } while (target != owner);
+        g_object_ref(target);
+        wxGTKMenuCloseTree(menu);
+        if (gtk_widget_get_root(target))
+        { gtk_widget_grab_focus(target); gtk_menu_button_popup(GTK_MENU_BUTTON(target)); }
+        g_object_unref(target);
+        return TRUE;
+    }
+    return FALSE;
+}
+static void wxGTKMenuMap(GtkWidget*, wxMenu* menu)
+{
+    if (menu->m_gtkMenu->opened) return;
+    menu->m_gtkMenu->opened = true;
+    wxWeakRef<wxMenu> alive(menu);
+    if (!menu->m_popupShown) menu->UpdateUI();
+    if (alive) wxGTKMenuEvent(menu, wxEVT_MENU_OPEN, menu->m_popupShown ? -1 : 0);
+}
+static void wxGTKMenuClosed(GtkWidget*, wxMenu* menu)
+{
+    // Reparenting custom rows during a structural update can temporarily
+    // unmap an open submenu. GTKRebuild restores it without duplicate events.
+    if (wxGTKMenuUpdating(menu->GetParent())) return;
+    const bool wasOpen = menu->m_gtkMenu->opened;
+    const int id = menu->m_popupShown ? -1 : 0;
+    menu->m_gtkMenu->opened = false;
+    menu->m_popupShown = false;
+    if (wasOpen) wxGTKMenuEvent(menu, wxEVT_MENU_CLOSE, id);
+}
+#if wxUSE_ACCEL
+static wxString wxGTKMenuHotKey(const wxAcceleratorEntry* entry);
+static gboolean wxGTKMenuShortcut(GtkWidget*, GVariant*, gpointer data)
+{
+    GSimpleAction* action = G_SIMPLE_ACTION(data);
+    wxMenuItem* item = wxGTKMenuItemFromAction(G_OBJECT(action));
+    if (!item || !item->IsEnabled() || !wxGTKMenuAllowed(item->GetMenu())) return FALSE;
+    g_action_activate(G_ACTION(action), item->GetKind() == wxITEM_RADIO ?
+                      g_variant_new_string(item->m_gtkItem->name.c_str()) : NULL);
+    return TRUE;
+}
+static void wxGTKMenuAddShortcut(GListStore* list, wxMenuItem* item, const wxAcceleratorEntry* entry)
+{
+    const wxString key = wxGTKMenuHotKey(entry);
+    if (key.empty()) return;
+    GtkShortcutTrigger* trigger = gtk_shortcut_trigger_parse_string(key.utf8_str());
+    if (!trigger) return;
+    GtkShortcutAction* action = gtk_callback_action_new(wxGTKMenuShortcut,
+        g_object_ref(item->m_gtkItem->action), g_object_unref);
+    GtkShortcut* shortcut = gtk_shortcut_new(trigger, action);
+    g_list_store_append(list, shortcut);
+    g_object_unref(shortcut);
+}
+static void wxGTKMenuShortcuts(GListStore* list, wxMenu* menu, wxMenuItem* removing = NULL)
+{
+    for (wxMenuItem* item : menu->GetMenuItems())
+    {
+        if (item == removing || !item->GetMenuItem()) continue;
+        if (item->IsSubMenu()) wxGTKMenuShortcuts(list, item->GetSubMenu());
+        wxScopedPtr<wxAcceleratorEntry> primary(item->GetAccel());
+        wxGTKMenuAddShortcut(list, item, primary.get());
+        for (const wxAcceleratorEntry& extra : item->GetExtraAccels())
+            wxGTKMenuAddShortcut(list, item, &extra);
+    }
+}
+#endif
+static gboolean wxGTKMenuBarFocus(GtkWidget*, GVariant*, gpointer data)
+{
+    GtkWidget* bar = GTK_WIDGET(data);
+    for (GtkWidget* child = gtk_widget_get_first_child(bar); child; child = gtk_widget_get_next_sibling(child))
+        if (gtk_widget_get_sensitive(child)) { gtk_widget_grab_focus(child); return TRUE; }
+    return FALSE;
+}
+static gboolean wxGTKMenuBarKey(GtkEventControllerKey* controller, guint key, guint, GdkModifierType, gpointer)
+{
+    GtkWidget* bar = gtk_event_controller_get_widget(GTK_EVENT_CONTROLLER(controller));
+    GtkRoot* root = gtk_widget_get_root(bar);
+    GtkWidget* focus = root ? gtk_root_get_focus(root) : NULL;
+    GtkWidget* child = focus;
+    while (child && gtk_widget_get_parent(child) != bar) child = gtk_widget_get_parent(child);
+    if (!child) return FALSE;
+    const bool rtl = gtk_widget_get_direction(bar) == GTK_TEXT_DIR_RTL;
+    if (key == GDK_KEY_Down || key == GDK_KEY_Return || key == GDK_KEY_space)
+    { gtk_menu_button_popup(GTK_MENU_BUTTON(child)); return TRUE; }
+    if (key != GDK_KEY_Left && key != GDK_KEY_Right) return FALSE;
+    const bool next = (key == GDK_KEY_Right) != rtl;
+    GtkWidget* candidate = child;
+    do
+    {
+        candidate = next ? gtk_widget_get_next_sibling(candidate) : gtk_widget_get_prev_sibling(candidate);
+        if (!candidate) candidate = next ? gtk_widget_get_first_child(bar) : gtk_widget_get_last_child(bar);
+        if (!candidate) return FALSE;
+        if (gtk_widget_get_sensitive(candidate)) { gtk_widget_grab_focus(candidate); break; }
+    } while (candidate != child);
+    return TRUE;
+}
+}
