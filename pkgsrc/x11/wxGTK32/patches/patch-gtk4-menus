+static void wxGTKMenuQuiesce(wxMenu* menu)
+{
+    g_signal_handlers_disconnect_by_data(menu->m_menu, menu);
+    menu->m_gtkMenu->opened = false;
+    menu->m_popupShown = false;
+    for (wxMenuItem* item : menu->GetMenuItems())
+    {
+        g_object_set_data(G_OBJECT(item->m_gtkItem->action), "wx-menu-item", NULL);
+        if (item->IsSubMenu()) wxGTKMenuQuiesce(item->GetSubMenu());
