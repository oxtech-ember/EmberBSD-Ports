+void wxMenuItem::Check(bool check)
+{
+    wxCHECK_RET(IsCheckable(), "item is not checkable");
+    if (GetKind() == wxITEM_RADIO && !check) return;
+    if (GetKind() == wxITEM_RADIO && GetMenu())
+    {
+        // Radio groups are consecutive runs. Clear only this run, never a
+        // separated group, and do not emit commands for programmatic changes.
+        wxMenu* menu = GetMenu();
+        size_t pos = 0;
+        while (pos < menu->GetMenuItemCount() && menu->FindItemByPosition(pos) != this) ++pos;
+        size_t first = pos;
+        while (first && menu->FindItemByPosition(first - 1)->GetKind() == wxITEM_RADIO) --first;
+        for (size_t i = first; i < menu->GetMenuItemCount(); ++i)
+        {
+            wxMenuItem* item = menu->FindItemByPosition(i);
+            if (item->GetKind() != wxITEM_RADIO) break;
+            const bool selected = item == this;
+            item->wxMenuItemBase::Check(selected);
+            g_simple_action_set_state(item->m_gtkItem->action,
+                g_variant_new_string(selected ? item->m_gtkItem->name.c_str() : ""));
+        }
+    }
+    else
+    {
+        wxMenuItemBase::Check(check);
+        g_simple_action_set_state(m_gtkItem->action, GetKind() == wxITEM_RADIO ?
+            g_variant_new_string(m_gtkItem->name.c_str()) : g_variant_new_boolean(check));
+    }
+}
