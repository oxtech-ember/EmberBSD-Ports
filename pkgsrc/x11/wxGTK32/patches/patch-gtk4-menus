+wxMenuItem* wxMenu::DoRemove(wxMenuItem* item)
+{
+    g_action_map_remove_action(G_ACTION_MAP(m_gtkMenu->actions), item->m_gtkItem->name.c_str());
+    GTKRebuild(item);
+    if (item->IsSubMenu())
+    {
+        wxMenu* sub = item->GetSubMenu();
+        g_signal_handlers_block_matched(sub->m_menu, G_SIGNAL_MATCH_DATA, 0, 0, NULL, NULL, sub);
+        gtk_menu_button_set_popover(GTK_MENU_BUTTON(item->GetMenuItem()), NULL);
+        sub->m_gtkMenu->opened = false;
+        sub->m_popupShown = false;
+        g_signal_handlers_unblock_matched(sub->m_menu, G_SIGNAL_MATCH_DATA, 0, 0, NULL, NULL, sub);
+        sub->m_owner = NULL;
+    }
+    item->SetMenuItem(NULL);
+    item->m_gtkItem->label = item->m_gtkItem->image = item->m_gtkItem->accel = NULL;
+    wxMenuItem* result = wxMenuBase::DoRemove(item);
+    GTKRefreshShortcuts();
+    return result;
