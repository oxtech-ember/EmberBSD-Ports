+void wxMenuBar::Init(size_t n, wxMenu* menus[], const wxString titles[], long style)
+{
+    m_gtkBar = new wxGTKMenuBarData;
+    m_menubar = NULL;
+    if (!PreCreation(NULL, wxDefaultPosition, wxDefaultSize) ||
+        !CreateBase(NULL, -1, wxDefaultPosition, wxDefaultSize, style, wxDefaultValidator, "menubar")) return;
+    m_widget = m_menubar = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+    gtk_widget_add_css_class(m_widget, "menubar");
+    GtkEventController* keys = gtk_event_controller_key_new();
+    g_signal_connect(keys, "key-pressed", G_CALLBACK(wxGTKMenuBarKey), NULL);
+    gtk_widget_add_controller(m_widget, keys);
+    PostCreation();
+    g_object_ref_sink(m_widget);
+    for (size_t i = 0; i < n; ++i) Append(menus[i], titles[i]);
+}
+wxMenuBar::wxMenuBar() { Init(0, NULL, NULL, 0); }
+wxMenuBar::wxMenuBar(long style) { Init(0, NULL, NULL, style); }
+wxMenuBar::wxMenuBar(size_t n, wxMenu* menus[], const wxString titles[], long style) { Init(n, menus, titles, style); }
+wxMenuBar::~wxMenuBar()
+{
+    Detach();
+    g_object_unref(m_gtkBar->shortcuts);
+    delete m_gtkBar;
+}
+void wxMenuBar::GtkAppend(wxMenu* menu, const wxString& title, int pos)
+{
+    menu->SetTitle(title);
+    menu->m_owner = gtk_menu_button_new();
+    gtk_menu_button_set_label(GTK_MENU_BUTTON(menu->m_owner), wxConvertMnemonicsToGTK(title).utf8_str());
+    gtk_menu_button_set_use_underline(GTK_MENU_BUTTON(menu->m_owner), TRUE);
+    gtk_menu_button_set_has_frame(GTK_MENU_BUTTON(menu->m_owner), FALSE);
+    gtk_menu_button_set_always_show_arrow(GTK_MENU_BUTTON(menu->m_owner), FALSE);
+    gtk_menu_button_set_popover(GTK_MENU_BUTTON(menu->m_owner), menu->m_menu);
+    GtkWidget* previous = NULL;
+    for (int i = 0; (pos < 0 || i < pos); ++i)
+    {
+        GtkWidget* next = previous ? gtk_widget_get_next_sibling(previous) : gtk_widget_get_first_child(m_menubar);
+        if (!next) break;
+        previous = next;
+    }
+    gtk_box_insert_child_after(GTK_BOX(m_menubar), menu->m_owner, previous);
+    menu->SetLayoutDirection(GetLayoutDirection());
+    menu->SetupBitmaps(GetFrame());
+    GTKRefreshShortcuts();
+}
+bool wxMenuBar::Append(wxMenu* menu, const wxString& title)
+{ if (!wxMenuBarBase::Append(menu, title)) return false; GtkAppend(menu, title); return true; }
+bool wxMenuBar::Insert(size_t pos, wxMenu* menu, const wxString& title)
+{ if (!wxMenuBarBase::Insert(pos, menu, title)) return false; GtkAppend(menu, title, int(pos)); return true; }
+wxMenu* wxMenuBar::Replace(size_t pos, wxMenu* menu, const wxString& title)
+{ wxMenu* old = Remove(pos); if (old && !Insert(pos, menu, title)) return NULL; return old; }
+wxMenu* wxMenuBar::Remove(size_t pos)
+{
+    wxMenu* menu = wxMenuBarBase::Remove(pos);
+    if (!menu) return NULL;
+    wxWeakRef<wxMenu> alive(menu);
+    wxGTKMenuCloseTree(menu);
+    if (!alive) return NULL;
+    gtk_menu_button_set_popover(GTK_MENU_BUTTON(menu->m_owner), NULL);
+    gtk_box_remove(GTK_BOX(m_menubar), menu->m_owner);
+    menu->m_owner = NULL;
+    GTKRefreshShortcuts();
+    return menu;
+}
+void wxMenuBar::EnableTop(size_t pos, bool enable)
+{ wxCHECK_RET(pos < GetMenuCount(), "invalid menu index"); gtk_widget_set_sensitive(GetMenu(pos)->m_owner, enable); }
+bool wxMenuBar::IsEnabledTop(size_t pos) const
+{ wxCHECK_MSG(pos < GetMenuCount(), false, "invalid menu index"); return gtk_widget_get_sensitive(GetMenu(pos)->m_owner); }
+void wxMenuBar::SetMenuLabel(size_t pos, const wxString& title)
+{ wxCHECK_RET(pos < GetMenuCount(), "invalid menu index"); GetMenu(pos)->SetTitle(title); }
+wxString wxMenuBar::GetMenuLabel(size_t pos) const
+{ wxCHECK_MSG(pos < GetMenuCount(), wxString(), "invalid menu index"); return GetMenu(pos)->GetTitle(); }
+static int wxGTKFindMenuLabel(const wxMenu* menu, const wxString& title, const wxString& label)
+{
+    if (wxMenuItem::GetLabelText(menu->GetTitle()) == wxMenuItem::GetLabelText(title))
+    { const int id = menu->FindItem(label); if (id != wxNOT_FOUND) return id; }
+    for (wxMenuItem* item : menu->GetMenuItems())
+        if (item->IsSubMenu())
+        { int id = wxGTKFindMenuLabel(item->GetSubMenu(), title, label); if (id != wxNOT_FOUND) return id; }
+    return wxNOT_FOUND;
+}
+int wxMenuBar::FindMenuItem(const wxString& title, const wxString& label) const
+{
+    for (wxMenu* menu : m_menus) { const int id = wxGTKFindMenuLabel(menu, title, label); if (id != wxNOT_FOUND) return id; }
+    return wxNOT_FOUND;
+}
+wxMenuItem* wxMenuBar::FindItem(int id, wxMenu** owner) const
+{
+    for (wxMenu* menu : m_menus) { wxMenuItem* item = menu->FindItem(id, owner); if (item) return item; }
+    if (owner) *owner = NULL;
+    return NULL;
+}
+void wxMenuBar::SetLayoutDirection(wxLayoutDirection dir)
+{
+    if (dir == wxLayout_Default) dir = GetFrame() ? GetFrame()->GetLayoutDirection() : wxTheApp->GetLayoutDirection();
+    GTKSetLayout(m_menubar, dir);
+    for (wxMenu* menu : m_menus) menu->SetLayoutDirection(dir);
+}
+wxLayoutDirection wxMenuBar::GetLayoutDirection() const { return GTKGetLayout(m_menubar); }
+void wxMenuBar::Attach(wxFrame* frame)
+{
+    wxMenuBarBase::Attach(frame);
+    m_gtkBar->host = wxGetTopLevelParent(frame)->GetHandle();
+    g_object_add_weak_pointer(G_OBJECT(m_gtkBar->host), reinterpret_cast<gpointer*>(&m_gtkBar->host));
+    m_gtkBar->controller = gtk_shortcut_controller_new_for_model(G_LIST_MODEL(m_gtkBar->shortcuts));
+    gtk_shortcut_controller_set_scope(GTK_SHORTCUT_CONTROLLER(m_gtkBar->controller), GTK_SHORTCUT_SCOPE_GLOBAL);
+    g_object_ref(m_gtkBar->controller);
+    gtk_widget_add_controller(m_gtkBar->host, m_gtkBar->controller);
+    GTKRefreshShortcuts();
+    for (wxMenu* menu : m_menus) menu->SetupBitmaps(frame);
+    SetLayoutDirection(wxLayout_Default);
+}
+void wxMenuBar::Detach()
+{
+    if (m_gtkBar->host)
+    {
+        gtk_widget_remove_controller(m_gtkBar->host, m_gtkBar->controller);
+        g_object_remove_weak_pointer(G_OBJECT(m_gtkBar->host), reinterpret_cast<gpointer*>(&m_gtkBar->host));
+        m_gtkBar->host = NULL;
+    }
+    if (m_gtkBar->controller) { g_object_unref(m_gtkBar->controller); m_gtkBar->controller = NULL; }
+    g_list_store_remove_all(m_gtkBar->shortcuts);
+    if (GetFrame()) wxMenuBarBase::Detach();
+    for (wxMenu* menu : m_menus) wxGTKMenuCloseTree(menu);
