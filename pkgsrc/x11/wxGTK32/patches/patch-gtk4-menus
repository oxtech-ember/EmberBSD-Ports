+///////////////////////////////////////////////////////////////////////////////
+// GTK4 menus: public popover custom slots, native widgets and GActions.
+// Origin: EmberBSD (AI-assisted). wxWindows licence, like upstream.
+///////////////////////////////////////////////////////////////////////////////
+#include "wx/frame.h"
+#include "wx/dialog.h"
+#include "wx/app.h"
+#include "wx/evtloop.h"
+#include "wx/weakref.h"
+#include "wx/bitmap.h"
+#include "wx/gtk/private.h"
+#include "wx/gtk/private/mnemonics.h"
+#if wxUSE_ACCEL
+#include "wx/accel.h"
+#include "wx/scopedptr.h"
+#endif
+#include <gtk/gtk.h>
+#include <string>
+#include <vector>
