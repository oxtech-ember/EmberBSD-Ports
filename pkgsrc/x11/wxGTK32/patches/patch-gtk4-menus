+void wxMenu::GTKRebuild(wxMenuItem* removing)
+{
+    if (m_gtkMenu->rebuilding) return;
+    m_gtkMenu->rebuilding = true;
+    GtkRoot* root = gtk_widget_get_root(m_menu);
+    GtkWidget* focus = root ? gtk_root_get_focus(root) : NULL;
+    if (focus) g_object_ref(focus);
+    std::vector<wxMenu*> reopen;
+    for (wxMenuItem* item : GetMenuItems())
+    {
+        if (item != removing && item->IsSubMenu() && item->GetSubMenu()->m_gtkMenu->opened)
+            reopen.push_back(item->GetSubMenu());
+        if (item->GetMenuItem() && gtk_widget_get_parent(item->GetMenuItem()))
+            gtk_popover_menu_remove_child(GTK_POPOVER_MENU(m_menu), item->GetMenuItem());
+    }
+    g_menu_remove_all(m_gtkMenu->model);
+    GMenu* section = g_menu_new();
+    bool firstSection = true;
+    const auto appendSection = [this, &firstSection](GMenu* value)
+    {
+        if (!g_menu_model_get_n_items(G_MENU_MODEL(value))) return;
+        const wxString title = firstSection && !GetParent() && !GetMenuBar() ? wxMenuItem::GetLabelText(m_title) : wxString();
+        g_menu_append_section(m_gtkMenu->model, title.empty() ? NULL : title.utf8_str().data(), G_MENU_MODEL(value));
+        firstSection = false;
+    };
+    std::vector<wxMenuItem*> radio;
+    const auto finishRadio = [&radio]()
+    {
+        if (radio.empty()) return;
+        wxMenuItem* selected = radio.front();
+        for (wxMenuItem* item : radio) if (item->IsChecked()) { selected = item; break; }
+        GtkCheckButton* first = GTK_CHECK_BUTTON(radio.front()->GetMenuItem());
+        gtk_check_button_set_group(first, NULL);
+        for (size_t i = 1; i < radio.size(); ++i)
+            gtk_check_button_set_group(GTK_CHECK_BUTTON(radio[i]->GetMenuItem()), first);
+        for (wxMenuItem* item : radio)
+        {
+            const bool checked = item == selected;
+            item->wxMenuItemBase::Check(checked);
+            g_simple_action_set_state(item->m_gtkItem->action,
+                g_variant_new_string(checked ? item->m_gtkItem->name.c_str() : ""));
+            gtk_check_button_set_active(GTK_CHECK_BUTTON(item->GetMenuItem()), checked);
+        }
+        radio.clear();
+    };
+    for (wxMenuItem* item : GetMenuItems())
+    {
+        if (item == removing) continue;
+        if (item->GetKind() != wxITEM_RADIO) finishRadio();
+        if (item->IsSeparator())
+        {
+            appendSection(section);
+            g_object_unref(section); section = g_menu_new();
+            continue;
+        }
+        if (item->GetKind() == wxITEM_RADIO) radio.push_back(item);
+        GMenuItem* entry = g_menu_item_new(NULL, NULL);
+        g_menu_item_set_attribute(entry, "custom", "s", item->m_gtkItem->name.c_str());
+        g_menu_append_item(section, entry);
+        g_object_unref(entry);
+    }
+    finishRadio();
+    appendSection(section);
+    g_object_unref(section);
+    for (wxMenuItem* item : GetMenuItems())
+        if (item != removing && item->GetMenuItem())
+            gtk_popover_menu_add_child(GTK_POPOVER_MENU(m_menu), item->GetMenuItem(), item->m_gtkItem->name.c_str());
+    for (wxMenu* menu : reopen) wxGTKMenuRestoreOpen(menu);
+    if (focus)
+    {
+        if (gtk_widget_get_root(focus)) gtk_widget_grab_focus(focus);
+        g_object_unref(focus);
+    }
+    m_gtkMenu->rebuilding = false;
+    GTKRefreshShortcuts();
+}
