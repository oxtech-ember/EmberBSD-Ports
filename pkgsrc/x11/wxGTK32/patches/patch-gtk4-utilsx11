 static bool wxGetKeyStateGTK(wxKeyCode key)
 {
+#ifdef __WXGTK4__
+    GdkDisplay* display = gdk_display_get_default();
+    GdkSeat* seat = display ? gdk_display_get_default_seat(display) : NULL;
+    GdkDevice* keyboard = seat ? gdk_seat_get_keyboard(seat) : NULL;
+    if (!keyboard)
+        return false;
+
+    const GdkModifierType modifiers = gdk_device_get_modifier_state(keyboard);
+    switch (key)
+    {
+        case WXK_ALT:     return (modifiers & GDK_ALT_MASK) != 0;
+        case WXK_CONTROL: return (modifiers & GDK_CONTROL_MASK) != 0;
+        case WXK_SHIFT:   return (modifiers & GDK_SHIFT_MASK) != 0;
+        case WXK_CAPITAL: return gdk_device_get_caps_lock_state(keyboard) != FALSE;
+        case WXK_NUMLOCK: return gdk_device_get_num_lock_state(keyboard) != FALSE;
+        case WXK_SCROLL:  return gdk_device_get_scroll_lock_state(keyboard) != FALSE;
+        default:
+            wxFAIL_MSG(wxString::Format(
+                "Unsupported key %u; supported keys are Ctrl, Alt, Shift, "
+                "Caps Lock, Num Lock and Scroll Lock", key));
+            return false;
+    }
+#else
     if (gtk_check_version(3,4,0) != NULL)
         return false;
 
