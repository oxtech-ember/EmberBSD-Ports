 // 0: no change, 1: focus in, 2: focus out
 static wxUIntPtr gs_focusChange;
 
+#ifdef __WXGTK4__
+static GPtrArray* gs_gtkWindows;
+
+static void wx_gtk4_focus_changed(GObject*, GParamSpec*, gpointer)
+{
+    bool active = false;
+    for (guint i = 0; gs_gtkWindows && i < gs_gtkWindows->len; ++i)
+        active = active || gtk_window_is_active(GTK_WINDOW(g_ptr_array_index(gs_gtkWindows, i)));
+    // Coalesce transitions between windows of the same app before idle.
+    gs_focusChange = active ? 1 : 2;
+    if ( wxTheApp ) wxTheApp->WakeUpIdle();
+}
+
+static void wx_gtk4_clear_windows()
+{
+    if ( !gs_gtkWindows ) return;
+    GPtrArray* windows = gs_gtkWindows;
+    gs_gtkWindows = NULL;
+    for (guint i = 0; i < windows->len; ++i)
+        g_signal_handlers_disconnect_by_func(g_ptr_array_index(windows, i),
+            reinterpret_cast<gpointer>(wx_gtk4_focus_changed), NULL);
+    g_ptr_array_unref(windows);
+}
+
+static void wx_gtk4_windows_changed(GListModel* model, guint, guint, guint, gpointer)
+{
+    // Acquire the new list before releasing old refs: callbacks can remove
+    // windows while their last application reference is being released.
+    GPtrArray* windows = g_ptr_array_new_with_free_func(g_object_unref);
+    for (guint i = 0; i < g_list_model_get_n_items(model); ++i)
+        g_ptr_array_add(windows, g_list_model_get_item(model, i));
+    wx_gtk4_clear_windows();
+    gs_gtkWindows = windows;
+    for (guint i = 0; i < windows->len; ++i)
+        g_signal_connect(g_ptr_array_index(windows, i), "notify::is-active",
+            G_CALLBACK(wx_gtk4_focus_changed), NULL);
+    wx_gtk4_focus_changed(NULL, NULL, NULL);
+}
