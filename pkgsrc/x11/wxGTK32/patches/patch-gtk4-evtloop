+#ifdef __WXGTK4__
+bool wxGUIEventLoop::YieldFor(long eventsToProcess)
+{
+    // GTK4 removed the global event handler used to defer selected native
+    // event categories. Do not dispatch prohibited input or report success.
+    if ( eventsToProcess != wxEVT_CATEGORY_ALL )
+    {
+        static bool reported = false;
+        if ( !reported )
+        {
+            reported = true;
+            wxLogWarning("Selective native event yielding is not supported by wxGTK4.");
+        }
+        return false;
+    }
+    return wxEventLoopBase::YieldFor(eventsToProcess);
+}
+
+void wxGUIEventLoop::DoYieldFor(long eventsToProcess)
+{
+    while ( !m_shouldExit && Pending() )
+        g_main_context_iteration(NULL, FALSE);
+    wxEventLoopBase::DoYieldFor(eventsToProcess);
+}
