 namespace wxGTKWindowState4
 {
+// Request an EWMH window type before mapping; Wayland keeps its native role.
+inline bool RequestWindowType(GtkWindow* window, const char* typeAtom)
+{
+    if (!window || !typeAtom || !*typeAtom ||
+        gtk_widget_get_mapped(GTK_WIDGET(window)))
+        return false;
+#ifdef GDK_WINDOWING_X11
+    if (GDK_IS_X11_DISPLAY(gtk_widget_get_display(GTK_WIDGET(window))))
+    {
+        g_object_set_data_full(G_OBJECT(window), "wx-gtk4-window-type-hint",
+                               g_strdup(typeAtom), g_free);
+        return true;
+    }
+#endif
+    return false;
+}
+
+inline const char* GetRequestedWindowType(GtkWindow* window)
+{
+    return window ? static_cast<const char*>(
+        g_object_get_data(G_OBJECT(window), "wx-gtk4-window-type-hint")) : NULL;
+}
