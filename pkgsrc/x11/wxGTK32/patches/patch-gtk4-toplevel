+void wxTopLevelWindowGTK::GTKHandleRealized()
+{
+    wxNonOwnedWindow::GTKHandleRealized();
+    GdkSurface* surface = gtk_native_get_surface(GTK_NATIVE(m_widget));
+    if (surface == m_gtk4->surface) return;
+    m_gtk4->DisconnectSurface();
+    if (!surface) return;
+    m_gtk4->surface = GDK_SURFACE(g_object_ref(surface));
+    m_gtk4->display = GDK_DISPLAY(g_object_ref(gdk_surface_get_display(surface)));
+    m_gtk4->state = gdk_toplevel_get_state(GDK_TOPLEVEL(surface));
+    g_signal_connect(surface, "notify::state", G_CALLBACK(wxGTKTopLevelData::State), m_gtk4);
+#ifdef GDK_WINDOWING_X11
+    if (GDK_IS_X11_SURFACE(surface))
+    {
+        m_gtk4->xevent = g_signal_connect(m_gtk4->display, "xevent",
+                                        G_CALLBACK(wxGTKTopLevelData::XEventReceived), m_gtk4);
+        if (m_gtk4->showingWithoutActivation) gdk_x11_surface_set_user_time(surface, 0);
+    }
+#endif
+    m_gtk4->ReadServerDecor();
+    m_gtk4->NativeStyle();
+    m_gtk4->SizeHints();
+    SetIcons(GetIcons());
+    if (m_gtk4->positionRequested) m_gtk4->Move(m_x, m_y);
+}
+
+void wxTopLevelWindowGTK::GTKHandleMapped()
+{
+    m_gtk4->NativeStyle();
+#ifdef GDK_WINDOWING_WAYLAND
+    if (m_gtk4->surface && GDK_IS_WAYLAND_TOPLEVEL(m_gtk4->surface) && wxTheApp)
+        gdk_wayland_toplevel_set_application_id(GDK_TOPLEVEL(m_gtk4->surface),
+                                                wxTheApp->GetClassName().utf8_str());
+#endif
+    if (m_gtk4->positionRequested) m_gtk4->Move(m_x, m_y);
+    if (wxWindowBase::Show(true)) GTKDoAfterShow();
+}
