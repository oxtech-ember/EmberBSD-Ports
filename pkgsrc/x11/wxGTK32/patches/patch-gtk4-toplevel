+bool wxTopLevelWindowGTK::Show(bool show)
+{
+    wxWeakRef<wxTopLevelWindowGTK> self(this);
+    if (!show && m_widget) gtk_window_set_focus(GTK_WINDOW(m_widget), NULL);
+    if (!self || IsBeingDeleted()) return false;
+    const bool changed = base_type::Show(show);
+    // cppcheck-suppress knownConditionTrueFalse
+    if (self && !IsBeingDeleted() && changed && show) GTKUpdateClientSizeIfNecessary();
+    return changed;
+}
+void wxTopLevelWindowGTK::ShowWithoutActivating()
+{
+    if (IsShown()) return;
+    m_gtk4->showingWithoutActivation = true;
+#ifdef GDK_WINDOWING_X11
+    if (m_gtk4->surface && GDK_IS_X11_SURFACE(m_gtk4->surface))
+        gdk_x11_surface_set_user_time(m_gtk4->surface, 0);
+#endif
+    wxWeakRef<wxTopLevelWindowGTK> self(this);
+    Show();
+    if (self) m_gtk4->showingWithoutActivation = false;
+}
