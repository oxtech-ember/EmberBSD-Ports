+wxTopLevelWindowGTK::~wxTopLevelWindowGTK()
+{
+    RemoveGrab();
+    wxGTKTopLevelData::ClearUrgency(this);
+    if (m_widget)
+    {
+        g_signal_handlers_disconnect_by_data(m_widget, m_gtk4);
+        g_signal_handlers_disconnect_by_data(gtk_widget_get_settings(m_widget), m_gtk4);
+    }
+    if (m_wxwindow) g_signal_handlers_disconnect_by_data(m_wxwindow, m_gtk4);
+    m_gtk4->DisconnectSurface();
+    SendDestroyEvent();
+    if (m_widget && GTK_IS_WINDOW(m_widget)) gtk_window_set_focus(GTK_WINDOW(m_widget), NULL);
+    delete m_gtk4;
+    m_gtk4 = NULL;
+}
