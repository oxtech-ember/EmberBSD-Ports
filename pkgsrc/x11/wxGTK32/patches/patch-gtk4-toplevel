+void wxTopLevelWindowGTK::SetIcons(const wxIconBundle& icons)
+{
+    base_type::SetIcons(icons);
+    if (!m_gtk4->surface) return;
+    GList* list = NULL;
+    for (size_t i = 0; i < icons.GetIconCount(); ++i)
+    {
+        GdkPixbuf* pixbuf = icons.GetIconByIndex(i).GetPixbuf();
+        if (pixbuf) list = g_list_append(list, gdk_texture_new_for_pixbuf(pixbuf));
+    }
+    gdk_toplevel_set_icon_list(GDK_TOPLEVEL(m_gtk4->surface), list);
+    g_list_free_full(list, g_object_unref);
+}
