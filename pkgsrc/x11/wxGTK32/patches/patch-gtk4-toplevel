+void wxTopLevelWindowGTK::DoMoveWindow(int x, int y, int width, int height)
+    { DoSetSize(x, y, width, height, wxSIZE_ALLOW_MINUS_ONE); }
+void wxTopLevelWindowGTK::GTKDoGetSize(int* width, int* height) const
+{
+    if (width) *width = wxMax(1, m_width - m_gtk4->serverDecor.left - m_gtk4->serverDecor.right);
+    if (height) *height = wxMax(1, m_height - m_gtk4->serverDecor.top - m_gtk4->serverDecor.bottom);
+}
+void wxTopLevelWindowGTK::DoSetSize(int x, int y, int width, int height, int flags)
+{
+    m_gtk4->pendingClientSize = wxDefaultSize;
+#ifdef GDK_WINDOWING_X11
+    const bool canMove = GDK_IS_X11_DISPLAY(gtk_widget_get_display(m_widget));
+#else
+    const bool canMove = false;
+#endif
+    // cppcheck-suppress knownConditionTrueFalse
+    if (canMove && (x != -1 || (flags & wxSIZE_ALLOW_MINUS_ONE))) m_x = x;
+    // cppcheck-suppress knownConditionTrueFalse
+    if (canMove && (y != -1 || (flags & wxSIZE_ALLOW_MINUS_ONE))) m_y = y;
+    if (width >= 0) m_width = width;
+    if (height >= 0) m_height = height;
+    ConstrainSize();
+    m_width = wxMax(1, m_width); m_height = wxMax(1, m_height);
+    if (canMove && (x != -1 || y != -1 || (flags & wxSIZE_ALLOW_MINUS_ONE)))
+    {
+        m_gtk4->positionRequested = true;
+        m_gtk4->Move(m_x, m_y);
+    }
+    int w, h;
+    GTKDoGetSize(&w, &h);
+    gtk_window_set_default_size(GTK_WINDOW(m_widget), w, h);
+    m_useCachedClientSize = false;
+    m_pendingFittingClientSizeFlags &= ~wxSIZE_SET_CURRENT;
+    DoGetClientSize(&m_clientWidth, &m_clientHeight);
+    if (!IsShown()) SendSizeEvent();
+}
+void wxTopLevelWindowGTK::GTKConfigureEvent(int x, int y)
+{
+    const wxPoint position(x, y);
+    if (m_gtk4->havePosition && m_gtk4->reportedPosition == position) return;
+    m_lastPos = m_gtk4->reportedPosition;
+    m_gtk4->reportedPosition = position;
+    m_gtk4->havePosition = true;
+    m_x = x; m_y = y;
+    wxMoveEvent event(wxPoint(x, y), GetId());
+    event.SetEventObject(this);
+    HandleWindowEvent(event);
+}
+void wxTopLevelWindowGTK::DoGetClientSize(int* width, int* height) const
+{
+    if (IsIconized()) { if (width) *width = 0; if (height) *height = 0; }
+    else if (m_useCachedClientSize) base_type::DoGetClientSize(width, height);
+    else
+    {
+        if (width) *width = wxMax(0, m_width - m_decorSize.left - m_decorSize.right);
+        if (height) *height = wxMax(0, m_height - m_decorSize.top - m_decorSize.bottom);
+    }
+}
+void wxTopLevelWindowGTK::DoSetClientSize(int width, int height)
+{
+    wxWeakRef<wxTopLevelWindowGTK> self(this);
+    base_type::DoSetClientSize(width, height);
+    if (self && !IsBeingDeleted())
+    {
+        m_gtk4->pendingClientSize = wxSize(width, height);
+        gtk_widget_queue_allocate(m_wxwindow);
+    }
+}
+void wxTopLevelWindowGTK::DoSetSizeHints(int minW, int minH, int maxW, int maxH, int incW, int incH)
+{
+    base_type::DoSetSizeHints(minW, minH, maxW, maxH, incW, incH);
+    m_incWidth = incW; m_incHeight = incH;
+    m_gtk4->SizeHints();
+}
+void wxTopLevelWindowGTK::GTKUpdateDecorSize(const DecorSize& decor)
+{
+    m_decorSize = decor;
+    m_useCachedClientSize = false;
+    m_gtk4->SizeHints();
+}
+wxTopLevelWindowGTK::DecorSize& wxTopLevelWindowGTK::GetCachedDecorSize()
+{
+    // GTK4 decorations are per-window and per-scale, not a global theme guess.
+    return m_decorSize;
+}
+void wxTopLevelWindowGTK::GTKDoAfterShow()
+{
+    wxWeakRef<wxTopLevelWindowGTK> self(this);
+    GTKUpdateClientSizeIfNecessary();
+    if (!self || IsBeingDeleted()) return;
+    wxShowEvent event(GetId(), true);
+    event.SetEventObject(this);
+    HandleWindowEvent(event);
+}
+void wxTopLevelWindowGTK::GTKUpdateClientSizeIfNecessary()
+{
+    const int flags = m_pendingFittingClientSizeFlags;
+    m_pendingFittingClientSizeFlags = 0;
+    if (flags) WXSetInitialFittingClientSize(flags);
+}
+void wxTopLevelWindowGTK::SetMinSize(const wxSize& size)
+{
+    wxTopLevelWindowBase::SetMinSize(size);
+    m_pendingFittingClientSizeFlags &= ~wxSIZE_SET_MIN;
+}
+void wxTopLevelWindowGTK::WXSetInitialFittingClientSize(int flags, wxSizer* sizer)
+{
+    wxWeakRef<wxTopLevelWindowGTK> self(this);
+    wxTopLevelWindowBase::WXSetInitialFittingClientSize(flags, sizer);
+    if (self && !IsShown()) m_pendingFittingClientSizeFlags = flags;
+}
+
+void wxTopLevelWindowGTK::AddGrab()
+{
+    if (m_grabbedEventLoop) return;
+    wxWeakRef<wxTopLevelWindowGTK> self(this);
+    GtkWindow* widget = GTK_WINDOW(g_object_ref(m_widget));
+    const bool wasModal = gtk_window_get_modal(widget);
+    wxGUIEventLoop loop;
+    m_grabbedEventLoop = &loop;
+    struct Scope
+    {
+        wxWeakRef<wxTopLevelWindowGTK>& win;
+        GtkWindow* widget;
+        bool modal;
+        ~Scope()
+        {
+            if (win) win->RemoveGrab();
+            gtk_window_set_modal(widget, modal);
+            g_object_unref(widget);
+        }
+    } scope = {self, widget, wasModal};
+    wxWindowDisabler disable(this);
+    gtk_window_set_modal(widget, TRUE);
+    if (self && !IsBeingDeleted()) loop.Run();
+}
+void wxTopLevelWindowGTK::RemoveGrab()
+{
+    if (m_grabbedEventLoop)
+    {
+        wxGUIEventLoop* loop = m_grabbedEventLoop;
+        m_grabbedEventLoop = NULL;
+        if (loop->IsRunning()) loop->Exit();
+    }
+}
+bool wxTopLevelWindowGTK::IsGrabbed() const { return m_grabbedEventLoop != NULL; }
+
+void wxTopLevelWindowGTK::RequestUserAttention(int flags)
+{
+    wxGTKTopLevelData::ClearUrgency(this);
+    if (IsActive()) return;
+#ifdef GDK_WINDOWING_X11
+    if (m_gtk4->surface && GDK_IS_X11_SURFACE(m_gtk4->surface))
+    {
+        gdk_x11_surface_set_urgency_hint(m_gtk4->surface, TRUE);
+        m_urgency_hint = (flags & wxUSER_ATTENTION_INFO) ?
+            g_timeout_add(5000, wxGTKTopLevelData::ClearUrgencyTimer, this) : -1;
+        return;
+    }
+#endif
+    wxUnusedVar(flags);
+    wxLogDebug("GTK4: the compositor has no public non-activating attention request");
+}
+void wxTopLevelWindowGTK::SetWindowStyleFlag(long style)
+{
+    wxWindow::SetWindowStyleFlag(style);
+    if (!m_widget) return;
+    gtk_window_set_decorated(GTK_WINDOW(m_widget), !(style & (wxNO_BORDER | wxSIMPLE_BORDER)));
+    gtk_window_set_resizable(GTK_WINDOW(m_widget), (style & wxRESIZE_BORDER) != 0);
+    m_gtk4->closeEnabled = (style & wxCLOSE_BOX) != 0;
+    gtk_window_set_deletable(GTK_WINDOW(m_widget), m_gtk4->closeEnabled);
+    m_gtk4->TitlebarStyle();
+    m_gtk4->NativeStyle();
+}
