+bool wxGLCanvasBase::IsDisplaySupported(const wxGLAttributes& attrs)
+{
+    wxGLCanvasGTK4 probe;
+    if (!probe.InitVisual(attrs)) return false;
+    // IsDisplaySupported tests actual pbuffer allocation, including colorspace.
+    // Destruction releases the bridge and the selected display reference.
+    return true;
+}
+bool wxGLCanvasBase::IsDisplaySupported(const int* attrs)
+{
+    wxGLAttributes display;
+    return ParseAttribList(attrs, display) && IsDisplaySupported(display);
+}
+bool wxGLCanvasBase::IsExtensionSupported(const char* extension)
+{
+    EGLDisplay display = eglGetCurrentDisplay();
+    return display != EGL_NO_DISPLAY && IsExtensionInList(eglQueryString(display, EGL_EXTENSIONS), extension);
+}
+bool wxGLApp::InitGLVisual(const int* attrs) { return wxGLCanvas::IsDisplaySupported(attrs); }
