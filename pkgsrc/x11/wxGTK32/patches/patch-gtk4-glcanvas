+wxGLAttributes& wxGLAttributes::MinRGBA(int r, int g, int b, int a)
+{
+    const int keys[] = { WX_GL_MIN_RED, WX_GL_MIN_GREEN, WX_GL_MIN_BLUE, WX_GL_MIN_ALPHA };
+    const int values[] = { r, g, b, a };
+    for (unsigned i = 0; i != 4; ++i)
+        if (values[i] >= 0) { AddAttribute(keys[i]); AddAttribute(values[i]); }
+    return *this;
+}
