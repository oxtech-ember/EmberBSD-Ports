+static bool wxGTKGLConfig(wxGTKGLCanvasData* data, const wxGLAttributes& attrs)
+{
+    data->display = gdk_display_get_default();
+    if (!data->display) return wxGTKGLFailure("no GTK display");
+    g_object_ref(data->display);
+    wxGTKGLCurrent restore;
+    data->bridge = wxGTKGLBridge(data->display, false, &data->egl);
+    if (!data->bridge) return false;
+
+    std::vector<EGLint> config;
+    wxGTKGLPair(config, EGL_SURFACE_TYPE, EGL_PBUFFER_BIT);
+    wxGTKGLPair(config, EGL_RENDERABLE_TYPE, EGL_OPENGL_BIT);
+    const int* values = attrs.GetGLAttrs();
+    const int count = attrs.GetSize();
+    for (int i = 0; values && i < count && values[i]; i += 2)
+    {
+        if (i + 1 >= count) return wxGTKGLFailure("unterminated display attributes");
+        const int key = values[i], value = values[i + 1];
+        switch (key)
+        {
+        case WX_GL_RGBA: break;
+        case WX_GL_DOUBLEBUFFER:
+            // GTK presents an immutable front texture while GL renders into
+            // a pbuffer. This is presentation buffering, not GL_DOUBLEBUFFER.
+            break;
+        case WX_GL_BUFFER_SIZE: wxGTKGLPair(config, EGL_BUFFER_SIZE, value); break;
+        case WX_GL_MIN_RED: wxGTKGLPair(config, EGL_RED_SIZE, value); break;
+        case WX_GL_MIN_GREEN: wxGTKGLPair(config, EGL_GREEN_SIZE, value); break;
+        case WX_GL_MIN_BLUE: wxGTKGLPair(config, EGL_BLUE_SIZE, value); break;
+        case WX_GL_MIN_ALPHA: wxGTKGLPair(config, EGL_ALPHA_SIZE, value); break;
+        case WX_GL_DEPTH_SIZE: wxGTKGLPair(config, EGL_DEPTH_SIZE, value); break;
+        case WX_GL_STENCIL_SIZE: wxGTKGLPair(config, EGL_STENCIL_SIZE, value); break;
+        case WX_GL_SAMPLE_BUFFERS: wxGTKGLPair(config, EGL_SAMPLE_BUFFERS, value); break;
+        case WX_GL_SAMPLES: wxGTKGLPair(config, EGL_SAMPLES, value); break;
+        case WX_GL_FRAMEBUFFER_SRGB: data->srgb = value != 0; break;
+        case WX_GL_LEVEL: case WX_GL_AUX_BUFFERS: case WX_GL_STEREO:
+        case WX_GL_MIN_ACCUM_RED: case WX_GL_MIN_ACCUM_GREEN:
+        case WX_GL_MIN_ACCUM_BLUE: case WX_GL_MIN_ACCUM_ALPHA:
+            if (value != 0) return wxGTKGLFailure("stereo, overlay, auxiliary and accumulation buffers are unavailable");
+            break;
+        default: return wxGTKGLFailure("unknown display attribute");
+        }
+    }
+    config.push_back(EGL_NONE);
+    EGLint found = 0;
+    if (!eglChooseConfig(data->egl, &config[0], &data->config, 1, &found) || found != 1)
+        return wxGTKGLFailure("no compatible EGL pbuffer configuration");
+    EGLint red = 0, green = 0, blue = 0, alpha = 0;
+    eglGetConfigAttrib(data->egl, data->config, EGL_RED_SIZE, &red);
+    eglGetConfigAttrib(data->egl, data->config, EGL_GREEN_SIZE, &green);
+    eglGetConfigAttrib(data->egl, data->config, EGL_BLUE_SIZE, &blue);
+    eglGetConfigAttrib(data->egl, data->config, EGL_ALPHA_SIZE, &alpha);
+    const int bits = wxMax(wxMax(red, green), wxMax(blue, alpha));
+    if (bits > 16) return wxGTKGLFailure("the selected framebuffer colour precision cannot be presented");
+    if (bits > 8)
+    {
+        data->textureFormat = GL_RGBA16;
+        data->memoryFormat = GDK_MEMORY_R16G16B16A16;
+    }
+    return true;
+}
+
+static EGLSurface wxGTKGLPbuffer(wxGTKGLCanvasData* data, int width, int height)
+{
+    const EGLint attrs[] = { EGL_WIDTH, width, EGL_HEIGHT, height,
+        EGL_GL_COLORSPACE, data->srgb ? EGL_GL_COLORSPACE_SRGB : EGL_GL_COLORSPACE_LINEAR, EGL_NONE };
+    return eglCreatePbufferSurface(data->egl, data->config, attrs);
+}
