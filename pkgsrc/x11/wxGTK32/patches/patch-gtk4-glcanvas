+{
+    wxGTKGLCanvasData() : display(NULL), egl(EGL_NO_DISPLAY), config(NULL),
+        surface(EGL_NO_SURFACE), bridge(NULL), current(EGL_NO_CONTEXT),
+        frame(NULL), width(0), height(0), srgb(false), textureFormat(GL_RGBA8),
+        memoryFormat(GDK_MEMORY_R8G8B8A8) {}
+    GdkDisplay* display;
+    EGLDisplay egl;
+    EGLConfig config;
+    EGLSurface surface;
+    GdkGLContext* bridge;
+    EGLContext current;
+    GdkTexture* frame;
+    int width, height;
+    bool srgb;
+    GLint textureFormat;
+    GdkMemoryFormat memoryFormat;
+};
