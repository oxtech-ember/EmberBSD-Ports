+bool wxGLContext::SetCurrent(const wxGLCanvas& win) const
+{
+    wxGTKGLCanvasData* canvas = win.m_gtkGL;
+    if (!m_isOk || !canvas || canvas->egl != m_gtkGL->egl) return false;
+    const wxSize size = win.GetClientSize();
+    const double scale = win.GetContentScaleFactor();
+    const int width = wxMax(1, wxRound(size.x * scale));
+    const int height = wxMax(1, wxRound(size.y * scale));
+    const bool resize = width != canvas->width || height != canvas->height;
+    EGLSurface surface = resize ? wxGTKGLPbuffer(canvas, width, height) : canvas->surface;
+    if (surface == EGL_NO_SURFACE) return wxGTKGLFailure("unable to allocate canvas pbuffer");
+    wxGTKGLCurrent restore;
+    gdk_gl_context_clear_current();
+    if (!eglBindAPI(m_gtkGL->es ? EGL_OPENGL_ES_API : EGL_OPENGL_API) ||
+        !eglMakeCurrent(canvas->egl, surface, surface, m_gtkGL->context))
+    {
+        if (resize) eglDestroySurface(canvas->egl, surface);
+        return wxGTKGLFailure("unable to make requested context current on canvas");
+    }
+    restore.KeepCurrent();
+    if (resize)
+    {
+        if (canvas->surface != EGL_NO_SURFACE) eglDestroySurface(canvas->egl, canvas->surface);
+        canvas->surface = surface;
+        canvas->width = width;
+        canvas->height = height;
+    }
+    if (canvas->bridge) g_object_unref(canvas->bridge);
+    canvas->bridge = GDK_GL_CONTEXT(g_object_ref(m_gtkGL->bridge));
+    canvas->current = m_gtkGL->context;
+    return true;
+}
+
+wxGLCanvasGTK4::wxGLCanvasGTK4() : m_gtkGL(NULL) {}
+wxGLCanvasGTK4::~wxGLCanvasGTK4()
+{
+    if (!m_gtkGL) return;
+    if (m_wxwindow) g_signal_handlers_disconnect_by_data(m_wxwindow, this);
+    if (m_gtkGL->frame) g_object_unref(m_gtkGL->frame);
+    if (m_gtkGL->surface != EGL_NO_SURFACE)
+    {
+        if (eglGetCurrentSurface(EGL_DRAW) == m_gtkGL->surface ||
+            eglGetCurrentSurface(EGL_READ) == m_gtkGL->surface)
+        {
+            gdk_gl_context_clear_current();
+            eglMakeCurrent(m_gtkGL->egl, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        }
+        eglDestroySurface(m_gtkGL->egl, m_gtkGL->surface);
+    }
+    if (m_gtkGL->bridge) g_object_unref(m_gtkGL->bridge);
+    if (m_gtkGL->display) g_object_unref(m_gtkGL->display);
+    delete m_gtkGL;
+}
+
+bool wxGLCanvasGTK4::InitVisual(const wxGLAttributes& attrs)
+{
+    if (m_gtkGL) return wxGTKGLFailure("canvas visual already initialized");
+    m_gtkGL = new wxGTKGLCanvasData;
+    if (!wxGTKGLConfig(m_gtkGL, attrs)) return false;
+    m_gtkGL->surface = wxGTKGLPbuffer(m_gtkGL, 1, 1);
+    if (m_gtkGL->surface == EGL_NO_SURFACE)
+        return wxGTKGLFailure("the selected EGL configuration cannot allocate the requested pbuffer");
+    m_gtkGL->width = m_gtkGL->height = 1;
+    return true;
+}
+
+bool wxGLCanvasGTK4::SwapBuffers()
+{
+    if (!m_gtkGL || !m_gtkGL->bridge || m_gtkGL->current == EGL_NO_CONTEXT ||
+        eglGetCurrentContext() != m_gtkGL->current ||
+        eglGetCurrentDisplay() != m_gtkGL->egl ||
+        eglGetCurrentSurface(EGL_DRAW) != m_gtkGL->surface ||
+        eglGetCurrentSurface(EGL_READ) != m_gtkGL->surface)
+        return wxGTKGLFailure("SwapBuffers requires a context current on this canvas");
+
+    GLint readFbo = 0, texture = 0, readBuffer = 0, unpackBuffer = 0;
+    glGetIntegerv(GL_READ_FRAMEBUFFER_BINDING, &readFbo);
+    glGetIntegerv(GL_TEXTURE_BINDING_2D, &texture);
+    glGetIntegerv(GL_PIXEL_UNPACK_BUFFER_BINDING, &unpackBuffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, 0);
+    glGetIntegerv(GL_READ_BUFFER, &readBuffer);
+    GLboolean doubleBuffered = GL_TRUE;
+    if (epoxy_is_desktop_gl()) glGetBooleanv(GL_DOUBLEBUFFER, &doubleBuffered);
+    glReadBuffer(doubleBuffered ? GL_BACK : GL_FRONT);
+
+    wxGTKGLFrame* frame = new wxGTKGLFrame;
+    frame->bridge = GDK_GL_CONTEXT(g_object_ref(m_gtkGL->bridge));
+    frame->sync = NULL;
+    glGenTextures(1, &frame->texture);
+    glBindTexture(GL_TEXTURE_2D, frame->texture);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+    // Allocate without interpreting NULL as an offset into a caller's PBO.
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+    glTexImage2D(GL_TEXTURE_2D, 0, m_gtkGL->textureFormat,
+                m_gtkGL->width, m_gtkGL->height, 0, GL_RGBA, GL_UNSIGNED_BYTE, NULL);
+    glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpackBuffer);
+    if (epoxy_is_desktop_gl())
+    {
+        // A blit bypasses legacy pixel-transfer state and resolves MSAA.
+        // Disable sRGB conversion to retain the stored display-encoded values;
+        // the ordinary RGBA texture is explicitly tagged sRGB below. Using an
+        // sRGB texture here would make GL sampling decode it a second time.
+        GLint drawFbo = 0;
+        glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &drawFbo);
+        const GLboolean scissor = glIsEnabled(GL_SCISSOR_TEST);
+        const GLboolean srgb = glIsEnabled(GL_FRAMEBUFFER_SRGB);
+        glDisable(GL_SCISSOR_TEST);
+        glDisable(GL_FRAMEBUFFER_SRGB);
+        GLuint copyFbo = 0;
+        glGenFramebuffers(1, &copyFbo);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, copyFbo);
+        glFramebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                               GL_TEXTURE_2D, frame->texture, 0);
+        glBlitFramebuffer(0, 0, m_gtkGL->width, m_gtkGL->height,
+                          0, 0, m_gtkGL->width, m_gtkGL->height,
+                          GL_COLOR_BUFFER_BIT, GL_NEAREST);
+        glBindFramebuffer(GL_DRAW_FRAMEBUFFER, drawFbo);
+        glDeleteFramebuffers(1, &copyFbo);
+        if (srgb) glEnable(GL_FRAMEBUFFER_SRGB);
+        if (scissor) glEnable(GL_SCISSOR_TEST);
+    }
+    else
+    {
+        // GLES has no legacy pixel-transfer state. CopyTexSubImage copies
+        // stored channel values without sRGB conversion; unlike CopyTexImage,
+        // it does not require matching source/destination colour encodings.
+        glCopyTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, 0, 0,
+                           m_gtkGL->width, m_gtkGL->height);
+    }
+    const GLenum error = glGetError();
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glReadBuffer(readBuffer);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, readFbo);
+    if (error != GL_NO_ERROR)
+    {
+        wxGTKGLReleaseFrame(frame);
+        wxLogError("GTK4 GLCanvas: GPU frame copy failed (GL error 0x%x)", error);
+        return false;
+    }
+    frame->sync = glFenceSync(GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+    if (!frame->sync)
+    {
+        wxGTKGLReleaseFrame(frame);
+        wxLogError("GTK4 GLCanvas: unable to synchronize the completed GL frame");
+        return false;
+    }
+    glFlush();
+    GdkGLTextureBuilder* builder = gdk_gl_texture_builder_new();
+    gdk_gl_texture_builder_set_context(builder, frame->bridge);
+    gdk_gl_texture_builder_set_id(builder, frame->texture);
+    gdk_gl_texture_builder_set_width(builder, m_gtkGL->width);
+    gdk_gl_texture_builder_set_height(builder, m_gtkGL->height);
+    gdk_gl_texture_builder_set_format(builder, m_gtkGL->memoryFormat);
+    gdk_gl_texture_builder_set_color_state(builder, gdk_color_state_get_srgb());
+    gdk_gl_texture_builder_set_sync(builder, frame->sync);
+    GdkTexture* image = gdk_gl_texture_builder_build(builder, wxGTKGLReleaseFrame, frame);
+    g_object_unref(builder);
+    if (!image) { wxGTKGLReleaseFrame(frame); return false; }
+    if (m_gtkGL->frame) g_object_unref(m_gtkGL->frame);
+    m_gtkGL->frame = image;
+    // Pbuffers have no window-system front buffer. Publishing this immutable
+    // GPU image is the actual swap; EGL's pbuffer SwapBuffers does nothing.
+    if (!WX_PIZZA(m_wxwindow)->m_inSnapshot) gtk_widget_queue_draw(m_wxwindow);
+    return true;
+}
+
+void wxGLCanvasGTK4::GTKSnapshot(GtkSnapshot* snapshot)
+{
+    if (!m_gtkGL || !m_gtkGL->frame) return;
+    const float width = gtk_widget_get_width(m_wxwindow);
+    const float height = gtk_widget_get_height(m_wxwindow);
+    graphene_point_t origin;
+    graphene_point_init(&origin, 0, height);
+    graphene_rect_t bounds;
+    graphene_rect_init(&bounds, 0, 0, width, height);
+    gtk_snapshot_save(snapshot);
+    gtk_snapshot_translate(snapshot, &origin);
+    gtk_snapshot_scale(snapshot, 1, -1);
+    gtk_snapshot_append_texture(snapshot, m_gtkGL->frame, &bounds);
+    gtk_snapshot_restore(snapshot);
+}
