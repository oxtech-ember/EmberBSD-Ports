+wxGLContext::wxGLContext(wxGLCanvas* win, const wxGLContext* other, const wxGLContextAttrs* attrs)
+    : m_gtkGL(new wxGTKGLContextData)
+{
+    m_isOk = false;
+    wxGTKGLCanvasData* canvas = win->m_gtkGL;
+    if (!canvas || !canvas->config) return;
+    if (!attrs) attrs = &win->GetGLCTXAttrs();
+    int major = 3, minor = 2, profile = EGL_CONTEXT_OPENGL_COMPATIBILITY_PROFILE_BIT;
+    bool forward = false, debug = false, robust = false;
+    bool majorSpecified = false, minorSpecified = false;
+    int reset = 0, release = -1;
+    const int* values = attrs->GetGLAttrs();
+    for (int i = 0; values && i < attrs->GetSize() && values[i]; i += 2)
+    {
+        if (i + 1 >= attrs->GetSize()) { wxGTKGLFailure("unterminated context attributes"); return; }
+        switch (values[i])
+        {
+        case WX_GL_MAJOR_VERSION: major = values[i + 1]; majorSpecified = true; break;
+        case WX_GL_MINOR_VERSION: minor = values[i + 1]; minorSpecified = true; break;
+        case WX_GL_CORE_PROFILE: profile = EGL_CONTEXT_OPENGL_CORE_PROFILE_BIT; break;
+        case WX_GL_COMPAT_PROFILE: profile = EGL_CONTEXT_OPENGL_COMPATIBILITY_PROFILE_BIT; break;
+        case WX_GL_FORWARD_COMPAT: forward = true; break;
+        case WX_GL_ES2: m_gtkGL->es = true; break;
+        case WX_GL_DEBUG: debug = true; break;
+        case WX_GL_ROBUST_ACCESS: robust = true; break;
+        case WX_GL_NO_RESET_NOTIFY: reset = EGL_NO_RESET_NOTIFICATION; break;
+        case WX_GL_LOSE_ON_RESET: reset = EGL_LOSE_CONTEXT_ON_RESET; break;
+        case WX_GL_RELEASE_FLUSH: release = values[i + 1] ? EGL_CONTEXT_RELEASE_BEHAVIOR_FLUSH_KHR : EGL_CONTEXT_RELEASE_BEHAVIOR_NONE_KHR; break;
+        case WX_GL_RESET_ISOLATION: wxGTKGLFailure("reset isolation is not available through EGL"); return;
+        default: wxGTKGLFailure("unknown context attribute"); return;
+        }
+    }
+    // GTK's shared presentation group requires modern GL entry points. A
+    // compatibility 3.2+ context also supports the caller's older desktop API.
+    if (majorSpecified && !minorSpecified) minor = 0;
+    if (major < 3) { major = 3; minor = m_gtkGL->es ? 0 : 2; }
+    if (!m_gtkGL->es && major == 3 && minor < 2) minor = 2;
+    if (m_gtkGL->es && !minorSpecified) minor = 0;
+    if (other && (!other->IsOK() || other->m_gtkGL->es != m_gtkGL->es))
+    { wxGTKGLFailure("shared contexts must use the same GL client API"); return; }
+
+    wxGTKGLCurrent restore;
+    m_gtkGL->bridge = wxGTKGLBridge(canvas->display, m_gtkGL->es, &m_gtkGL->egl);
+    if (!m_gtkGL->bridge || m_gtkGL->egl != canvas->egl) return;
+    EGLContext share = eglGetCurrentContext();
+    if (other)
+    {
+        if (other->m_gtkGL->egl != m_gtkGL->egl ||
+            !gdk_gl_context_is_shared(m_gtkGL->bridge, other->m_gtkGL->bridge))
+        { wxGTKGLFailure("contexts belong to different native sharing groups"); return; }
+        share = other->m_gtkGL->context;
+    }
+    const EGLenum api = m_gtkGL->es ? EGL_OPENGL_ES_API : EGL_OPENGL_API;
+    std::vector<EGLint> context;
+    wxGTKGLPair(context, EGL_CONTEXT_MAJOR_VERSION, major);
+    wxGTKGLPair(context, EGL_CONTEXT_MINOR_VERSION, minor);
+    if (!m_gtkGL->es) wxGTKGLPair(context, EGL_CONTEXT_OPENGL_PROFILE_MASK, profile);
+    if (forward) wxGTKGLPair(context, EGL_CONTEXT_OPENGL_FORWARD_COMPATIBLE, EGL_TRUE);
+    if (debug) wxGTKGLPair(context, EGL_CONTEXT_OPENGL_DEBUG, EGL_TRUE);
+    if (robust) wxGTKGLPair(context, EGL_CONTEXT_OPENGL_ROBUST_ACCESS, EGL_TRUE);
+    if (reset) wxGTKGLPair(context, EGL_CONTEXT_OPENGL_RESET_NOTIFICATION_STRATEGY, reset);
+    if (release != -1) wxGTKGLPair(context, EGL_CONTEXT_RELEASE_BEHAVIOR_KHR, release);
+    context.push_back(EGL_NONE);
+    if (!eglBindAPI(api)) { wxGTKGLFailure("unable to bind requested GL client API"); return; }
+    m_gtkGL->context = eglCreateContext(canvas->egl, canvas->config, share, &context[0]);
+    m_isOk = m_gtkGL->context != EGL_NO_CONTEXT;
+    if (!m_isOk) wxGTKGLFailure("unable to create requested shared EGL context/profile");
+}
+
+wxGLContext::~wxGLContext()
+{
+    if (m_gtkGL->context != EGL_NO_CONTEXT)
+    {
+        if (eglGetCurrentContext() == m_gtkGL->context)
+        {
+            gdk_gl_context_clear_current();
+            eglMakeCurrent(m_gtkGL->egl, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        }
+        eglDestroyContext(m_gtkGL->egl, m_gtkGL->context);
+    }
+    if (m_gtkGL->bridge) g_object_unref(m_gtkGL->bridge);
+    delete m_gtkGL;
+}
