+struct wxGTKGLContextData
+{
+    wxGTKGLContextData() : bridge(NULL), egl(EGL_NO_DISPLAY), context(EGL_NO_CONTEXT), es(false) {}
+    GdkGLContext* bridge;
+    EGLDisplay egl;
+    EGLContext context;
+    bool es;
+};
