+// GDK caches its current context separately from EGL. Always clear that cache
+// before raw eglMakeCurrent, and restore both APIs after internal operations.
+class wxGTKGLCurrent
+{
+public:
+    wxGTKGLCurrent() : m_gdk(gdk_gl_context_get_current()),
+        m_display(eglGetCurrentDisplay()), m_context(eglGetCurrentContext()),
+        m_draw(eglGetCurrentSurface(EGL_DRAW)), m_read(eglGetCurrentSurface(EGL_READ)),
+        m_api(eglQueryAPI()), m_restore(true)
+    {
+        if (m_gdk) g_object_ref(m_gdk);
+    }
+    ~wxGTKGLCurrent()
+    {
+        if (m_restore)
+        {
+            gdk_gl_context_clear_current();
+            eglBindAPI(m_api);
+            if (m_gdk)
+                gdk_gl_context_make_current(m_gdk);
+            else if (m_display != EGL_NO_DISPLAY)
+                eglMakeCurrent(m_display, m_draw, m_read, m_context);
+            else if (eglGetCurrentDisplay() != EGL_NO_DISPLAY)
+                eglMakeCurrent(eglGetCurrentDisplay(), EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+        }
+        if (m_gdk) g_object_unref(m_gdk);
+    }
+    void KeepCurrent() { m_restore = false; }
+private:
+    GdkGLContext* m_gdk;
+    EGLDisplay m_display;
+    EGLContext m_context;
+    EGLSurface m_draw, m_read;
+    EGLenum m_api;
+    bool m_restore;
+};
+
+static bool wxGTKGLFailure(const char* message)
+{
+    wxLogError("GTK4 GLCanvas: %s (EGL error 0x%x)", message, eglGetError());
+    return false;
+}
+
+static GdkGLContext* wxGTKGLBridge(GdkDisplay* display, bool es, EGLDisplay* eglDisplay)
+{
+    GError* error = NULL;
+    GdkGLContext* bridge = gdk_display_create_gl_context(display, &error);
+    if (bridge)
+    {
+        gdk_gl_context_set_allowed_apis(bridge, es ? GDK_GL_API_GLES : GDK_GL_API_GL);
+        if (!gdk_gl_context_realize(bridge, &error))
+        {
+            g_object_unref(bridge);
+            bridge = NULL;
+        }
+    }
+    if (!bridge)
+    {
+        wxLogError("GTK4 GLCanvas: %s", error ? error->message : "unable to create GL bridge");
+        g_clear_error(&error);
+        return NULL;
+    }
+    // An unrelated raw EGL context must not masquerade as GDK's context on
+    // an X11 GLX display. Clear both APIs first, then inspect what GDK bound.
+    gdk_gl_context_clear_current();
+    if (eglGetCurrentDisplay() != EGL_NO_DISPLAY)
+        eglMakeCurrent(eglGetCurrentDisplay(), EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
+    gdk_gl_context_make_current(bridge);
+    *eglDisplay = eglGetCurrentDisplay();
+    if (*eglDisplay == EGL_NO_DISPLAY || eglGetCurrentContext() == EGL_NO_CONTEXT)
+    {
+        wxGTKGLFailure("the GTK display must use the EGL backend (X11 or Wayland)");
+        g_object_unref(bridge);
+        return NULL;
+    }
+    return bridge;
+}
+
+static void wxGTKGLPair(std::vector<EGLint>& values, EGLint name, EGLint value)
+{
+    values.push_back(name);
+    values.push_back(value);
+}
+
+// A completed frame owns its immutable shared texture until GTK releases it.
+// Never recycle a buffer while a retained snapshot may still sample it.
+struct wxGTKGLFrame
+{
+    GdkGLContext* bridge;
+    GLuint texture;
+    GLsync sync;
+};
+
+static gboolean wxGTKGLDeleteFrame(gpointer data)
+{
+    wxGTKGLFrame* frame = static_cast<wxGTKGLFrame*>(data);
+    wxGTKGLCurrent restore;
+    gdk_gl_context_make_current(frame->bridge);
+    glDeleteTextures(1, &frame->texture);
+    if (frame->sync) glDeleteSync(frame->sync);
+    g_object_unref(frame->bridge);
+    delete frame;
+    return G_SOURCE_REMOVE;
+}
+
+static void wxGTKGLReleaseFrame(gpointer data)
+{
+    // GTK may release its last texture ref from another thread. Queue on the
+    // main loop in that case: g_main_context_invoke may execute immediately on
+    // a worker when the context happens to be unowned.
+    if (wxIsMainThread())
+        wxGTKGLDeleteFrame(data);
+    else
+        g_idle_add_full(G_PRIORITY_DEFAULT, wxGTKGLDeleteFrame, data, NULL);
+}
+
+static void wxGTKGLSnapshot(GtkWidget*, GtkSnapshot* snapshot, wxGLCanvasGTK4* canvas)
+{
+    canvas->GTKSnapshot(snapshot);
+}
+}
