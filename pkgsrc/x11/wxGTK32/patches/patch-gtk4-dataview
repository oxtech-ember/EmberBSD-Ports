+///////////////////////////////////////////////////////////////////////////////
+// GTK4 DataView DnD adapter. Origin: EmberBSD (AI-assisted). wxWindows licence.
+// Uses wxDropTarget's shared MIME transport; GtkTreeDragSource owns native drags.
+///////////////////////////////////////////////////////////////////////////////
+namespace
+{
+class wxDataViewDropTarget4 : public wxDropTarget
+{
+    struct State
+    {
+        wxWeakRef<wxDataViewCtrl> view;
+        bool alive = true;
+        guint timer = 0;
+        unsigned long generation = 0;
+        int x = 0, y = 0;
+        GtkTreeRowReference* hover = NULL;
+        gint64 hoverSince = 0;
+        explicit State(wxDataViewCtrl* value) : view(value) {}
+        ~State() { if (hover) gtk_tree_row_reference_free(hover); }
+        bool Valid() const { return alive && view && !view->IsBeingDeleted(); }
+        void Stop()
+        {
+            if (timer) { g_source_remove(timer); timer = 0; }
+            if (hover) { gtk_tree_row_reference_free(hover); hover = NULL; }
+        }
+        static gboolean Tick(void* data)
+        {
+            auto state = *static_cast<std::shared_ptr<State>*>(data);
+            if (!state->Valid()) { state->timer = 0; return G_SOURCE_REMOVE; }
+            const guint source = state->timer;
+            GtkWidget* widget = state->view->GtkGetTreeView();
+            wxGtkObject<GtkWidget> hold(GTK_WIDGET(g_object_ref(widget)));
+            wxGtkObject<GtkAdjustment> horizontal(GTK_ADJUSTMENT(g_object_ref(gtk_scrollable_get_hadjustment(GTK_SCROLLABLE(widget)))));
+            wxGtkObject<GtkAdjustment> vertical(GTK_ADJUSTMENT(g_object_ref(gtk_scrollable_get_vadjustment(GTK_SCROLLABLE(widget)))));
+            GtkAdjustment* adjustments[] = { horizontal, vertical };
+            const int positions[] = { state->x, state->y };
+            const int limits[] = { gtk_widget_get_width(widget), gtk_widget_get_height(widget) };
+            for (int i = 0; i != 2; ++i)
+            {
+                const int delta = positions[i] < 24 ? positions[i] - 24 :
+                                  positions[i] > limits[i] - 24 ? positions[i] - limits[i] + 24 : 0;
+                if (delta && adjustments[i])
+                    gtk_adjustment_set_value(adjustments[i], gtk_adjustment_get_value(adjustments[i]) + delta);
+                if (state->timer != source) return G_SOURCE_REMOVE;
+                if (!state->Valid()) { state->timer = 0; return G_SOURCE_REMOVE; }
+            }
+            if (state->hover && g_get_monotonic_time() - state->hoverSince > 700000)
+            {
+                wxGtkTreePath path(gtk_tree_row_reference_get_path(state->hover));
+                gtk_tree_row_reference_free(state->hover); state->hover = NULL;
+                if (path) gtk_tree_view_expand_row(GTK_TREE_VIEW(widget), path, FALSE);
+            }
+            if (state->timer != source) return G_SOURCE_REMOVE;
+            if (!state->Valid()) { state->timer = 0; return G_SOURCE_REMOVE; }
+            return G_SOURCE_CONTINUE;
+        }
+        void Hover(GtkTreePath* path)
+        {
+            wxGtkTreePath previous(hover ? gtk_tree_row_reference_get_path(hover) : NULL);
+            if ((!previous && !path) || (previous && path && gtk_tree_path_compare(previous, path) == 0)) return;
+            if (hover) gtk_tree_row_reference_free(hover);
+            hover = path ? gtk_tree_row_reference_new(gtk_tree_view_get_model(GTK_TREE_VIEW(view->GtkGetTreeView())), path) : NULL;
+            hoverSince = g_get_monotonic_time();
+        }
+    };
+    std::shared_ptr<State> m_state;
+    static wxDataObjectComposite* Data(const wxVector<wxDataFormat>& formats)
+    {
+        auto data = new wxDataObjectComposite;
+        for (const auto& format : formats) data->Add(new wxCustomDataObject(format));
+        return data;
+    }
+    static wxDataViewItem Item(wxDataViewCtrl* view, int x, int y, wxGtkTreePath& path,
+                               GtkTreeViewDropPosition& position)
+    {
+        gtk_tree_view_get_dest_row_at_pos(GTK_TREE_VIEW(view->GtkGetTreeView()), x, y, path.ByRef(), &position);
+        return view->GTKPathToItem(path);
+    }
+public:
+    wxDataViewDropTarget4(wxDataViewCtrl* view, const wxVector<wxDataFormat>& formats)
+        : wxDropTarget(Data(formats)), m_state(new State(view)) {}
+    ~wxDataViewDropTarget4()
+    {
+        ++m_state->generation;
+        m_state->Stop();
+        if (m_state->Valid())
+            gtk_tree_view_set_drag_dest_row(GTK_TREE_VIEW(m_state->view->GtkGetTreeView()), NULL, GTK_TREE_VIEW_DROP_BEFORE);
+        m_state->alive = false;
+    }
+    wxDragResult OnDragOver(wxCoord x, wxCoord y, wxDragResult suggested) wxOVERRIDE
+    {
+        auto state = m_state;
+        const unsigned long generation = ++state->generation;
+        // GTK3's tree model DnD likewise requested data before DROP_POSSIBLE.
+        // Keep its size/format contract using the shared asynchronous reader.
+        if (!state->Valid() || !GetData() || !state->Valid() || state->generation != generation) return wxDragNone;
+        wxDataViewCtrl* view = state->view;
+        state->x = x; state->y = y;
+        if (!state->timer)
+            state->timer = g_timeout_add_full(G_PRIORITY_DEFAULT, 100, State::Tick,
+                new std::shared_ptr<State>(state), [](void* value) { delete static_cast<std::shared_ptr<State>*>(value); });
+        wxGtkTreePath path;
+        GtkTreeViewDropPosition position = GTK_TREE_VIEW_DROP_INTO_OR_BEFORE;
+        const wxDataViewItem item = Item(view, x, y, path, position);
+        wxDataViewEvent event(wxEVT_DATAVIEW_ITEM_DROP_POSSIBLE, view, item);
+        auto data = static_cast<wxDataObjectComposite*>(GetDataObject());
+        event.InitData(data, data->GetReceivedFormat());
+        event.SetPosition(x, y);
+        event.SetDropEffect(suggested);
+        const bool accepted = view->HandleWindowEvent(event) && event.IsAllowed();
+        if (!state->Valid() || state->generation != generation) return wxDragNone;
+        gtk_tree_view_set_drag_dest_row(GTK_TREE_VIEW(view->GtkGetTreeView()),
+                                       accepted ? static_cast<GtkTreePath*>(path) : NULL, position);
+        state->Hover(accepted ? static_cast<GtkTreePath*>(path) : NULL);
+        return accepted ? event.GetDropEffect() : wxDragNone;
+    }
+    bool OnDrop(wxCoord x, wxCoord y) wxOVERRIDE
+    { return wxIsDragResultOk(OnDragOver(x, y, GTKFigureOutSuggestedAction())); }
+    void OnLeave() wxOVERRIDE
+    {
+        ++m_state->generation;
+        m_state->Stop();
+        if (m_state->Valid())
+            gtk_tree_view_set_drag_dest_row(GTK_TREE_VIEW(m_state->view->GtkGetTreeView()),
+                                           NULL, GTK_TREE_VIEW_DROP_BEFORE);
+    }
+    wxDragResult OnData(wxCoord x, wxCoord y, wxDragResult suggested) wxOVERRIDE
+    {
+        auto state = m_state;
+        const unsigned long generation = ++state->generation;
+        state->Stop();
+        if (!state->Valid() || !GetData() || !state->Valid() || state->generation != generation) return wxDragNone;
+        wxDataViewCtrl* view = state->view;
+        wxGtkTreePath path;
+        GtkTreeViewDropPosition position = GTK_TREE_VIEW_DROP_INTO_OR_BEFORE;
+        const wxDataViewItem item = Item(view, x, y, path, position);
+        wxDataViewEvent event(wxEVT_DATAVIEW_ITEM_DROP, view, item);
+        auto data = static_cast<wxDataObjectComposite*>(GetDataObject());
+        event.InitData(data, data->GetReceivedFormat());
+        event.SetPosition(x, y);
+        event.SetDropEffect(suggested);
+        const bool accepted = view->HandleWindowEvent(event) && event.IsAllowed();
+        if (!state->Valid() || state->generation != generation) return wxDragNone;
+        gtk_tree_view_set_drag_dest_row(GTK_TREE_VIEW(view->GtkGetTreeView()), NULL, position);
+        return accepted ? event.GetDropEffect() : wxDragNone;
+    }
+};
+}
+bool wxDataViewCtrlInternal::EnableDragSource(const wxDataFormat& format)
+{
+    if (!format.GetFormatId())
+    {
+        gtk_tree_view_unset_rows_drag_source(GTK_TREE_VIEW(m_owner->GtkGetTreeView()));
+        return true;
+    }
+    const char* mime = format.GetFormatId();
+    GdkContentFormats* formats = gdk_content_formats_new(&mime, 1);
+    gtk_tree_view_enable_model_drag_source(GTK_TREE_VIEW(m_owner->GtkGetTreeView()),
+        GDK_BUTTON1_MASK, formats, GDK_ACTION_COPY);
+    gdk_content_formats_unref(formats);
+    return true;
+}
+bool wxDataViewCtrlInternal::EnableDropTarget(const wxVector<wxDataFormat>& formats)
+{
+    wxWeakRef<wxDataViewCtrl> alive(m_owner);
+    m_gtkDropTarget.reset();
+    if (!alive || alive->IsBeingDeleted() || alive->GtkGetInternal() != this) return false;
+    if (formats.empty()) return true;
+    m_gtkDropTarget.reset(new wxDataViewDropTarget4(m_owner, formats));
+    m_gtkDropTarget->GtkRegisterWidget(m_owner->GtkGetTreeView());
+    return true;
+}
