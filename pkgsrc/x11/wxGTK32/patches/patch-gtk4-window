+
+static gboolean key_event4(GtkEventController* controller, GdkEvent* event,
+                           wxWindow* win)
+{
+    GtkWidget* widget = gtk_event_controller_get_widget(controller);
+    // Capture lets wx CHAR_HOOK/accelerators run before native actions, but
+    // only the closest wx owner handles the event. Parent wx windows receive
+    // their documented CHAR_HOOK propagation, never a duplicate KEY_DOWN.
+    if (wxGTKFocusOwner(widget) != win)
+        return false;
+    switch (gdk_event_get_event_type(event))
+    {
+        case GDK_KEY_PRESS:
+            return gtk_window_key_press_callback(widget, event, win);
+        case GDK_KEY_RELEASE:
+            return gtk_window_key_release_callback(widget, event, win);
+        default:
+            return false;
+    }
