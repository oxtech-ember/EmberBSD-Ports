+///////////////////////////////////////////////////////////////////////////////
+// GTK4 widget/surface coordinates. Origin: EmberBSD (AI-assisted).
+// Licence: wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#ifndef _WX_GTK_PRIVATE_SURFACE4_H_
+#define _WX_GTK_PRIVATE_SURFACE4_H_
+
+#include "wx/math.h"
+#ifdef GDK_WINDOWING_X11
+#include <gdk/x11/gdkx.h>
+#endif
+
+// X11 exposes desktop coordinates. On Wayland the desktop origin is private
+// to the compositor: wx screen coordinates are relative to the toplevel.
+// Popups still use their real position relative to that toplevel.
+inline wxPoint wxGTKSurfaceOrigin(GdkSurface* surface)
+{
+    double x = 0, y = 0;
+    while (surface && GDK_IS_POPUP(surface))
+    {
+        x += gdk_popup_get_position_x(GDK_POPUP(surface));
+        y += gdk_popup_get_position_y(GDK_POPUP(surface));
+        surface = gdk_popup_get_parent(GDK_POPUP(surface));
+    }
+#ifdef GDK_WINDOWING_X11
+    if (surface && GDK_IS_X11_SURFACE(surface))
+    {
+        Display* display = gdk_x11_display_get_xdisplay(gdk_surface_get_display(surface));
+        Window root, child;
+        int tx, ty;
+        unsigned width, height, border, depth;
+        const Window xid = gdk_x11_surface_get_xid(surface);
+        if (XGetGeometry(display, xid, &root, &tx, &ty, &width, &height, &border, &depth) &&
+            XTranslateCoordinates(display, xid, root, 0, 0, &tx, &ty, &child))
+        {
+            const double scale = gdk_surface_get_scale(surface);
+            x += tx / scale;
+            y += ty / scale;
+        }
+    }
+#endif
+    return wxPoint(wxRound(x), wxRound(y));
+}
+
+inline bool wxGTKWidgetToScreen(GtkWidget* widget, double* x, double* y)
+{
+    GtkNative* native = gtk_widget_get_native(widget);
+    if (!native || !gtk_native_get_surface(native))
+        return false;
+    graphene_point_t input, output;
+    graphene_point_init(&input, float(*x), float(*y));
+    if (!gtk_widget_compute_point(widget, GTK_WIDGET(native), &input, &output))
+        return false;
+    double dx, dy;
+    gtk_native_get_surface_transform(native, &dx, &dy);
+    const wxPoint origin = wxGTKSurfaceOrigin(gtk_native_get_surface(native));
+    *x = output.x + dx + origin.x;
+    *y = output.y + dy + origin.y;
+    return true;
+}
+
+inline bool wxGTKScreenToWidget(GtkWidget* widget, double* x, double* y)
+{
+    GtkNative* native = gtk_widget_get_native(widget);
+    if (!native || !gtk_native_get_surface(native))
+        return false;
+    const wxPoint origin = wxGTKSurfaceOrigin(gtk_native_get_surface(native));
+    double dx, dy;
+    gtk_native_get_surface_transform(native, &dx, &dy);
+    graphene_point_t input, output;
+    graphene_point_init(&input, float(*x - origin.x - dx), float(*y - origin.y - dy));
+    if (!gtk_widget_compute_point(GTK_WIDGET(native), widget, &input, &output))
+        return false;
+    *x = output.x;
+    *y = output.y;
+    return true;
+}
