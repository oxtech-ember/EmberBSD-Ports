+class wxGTKScrollObserver
+{
+public:
+    typedef void (*Callback)(GtkWidget*, wxWindow*);
+    wxGTKScrollObserver(GtkWidget* widget, wxWindow* owner,
+                        Callback changed, Callback released)
+        : m_widget(widget), m_owner(owner), m_changed(changed),
+          m_released(released), m_releaseSource(0)
+    {
+        m_adjustment = gtk_scrollbar_get_adjustment(GTK_SCROLLBAR(widget));
+        g_object_ref(m_adjustment);
+        m_changeHandler = g_signal_connect(m_adjustment, "value-changed",
+                                           G_CALLBACK(Changed), this);
+        GtkEventController* input = gtk_event_controller_legacy_new();
+        gtk_event_controller_set_propagation_phase(input, GTK_PHASE_CAPTURE);
+        g_signal_connect(input, "event", G_CALLBACK(Input), this);
+        gtk_widget_add_controller(widget, input);
+        g_object_set_data_full(G_OBJECT(widget), "wx-scroll-observer", this, Delete);
+    }
+
+    ~wxGTKScrollObserver()
+    {
+        if (m_releaseSource) g_source_remove(m_releaseSource);
+        g_signal_handler_disconnect(m_adjustment, m_changeHandler);
+        g_object_unref(m_adjustment);
+    }
+
+    static void Block(GtkWidget* widget, bool block)
+    {
+        wxGTKScrollObserver* self = static_cast<wxGTKScrollObserver*>(
+            g_object_get_data(G_OBJECT(widget), "wx-scroll-observer"));
+        if (!self) return;
+        if (block) g_signal_handler_block(self->m_adjustment, self->m_changeHandler);
+        else g_signal_handler_unblock(self->m_adjustment, self->m_changeHandler);
+    }
+
+private:
+    static void Delete(void* data) { delete static_cast<wxGTKScrollObserver*>(data); }
+    static void Changed(GtkAdjustment*, wxGTKScrollObserver* self)
+    {
+        if (self->m_owner)
+            self->m_changed(self->m_widget, self->m_owner.get());
+    }
+    static gboolean Released(void* data)
+    {
+        wxGTKScrollObserver* self = static_cast<wxGTKScrollObserver*>(data);
+        self->m_releaseSource = 0;
+        if (self->m_owner && self->m_owner->m_isScrolling)
+        {
+            self->m_owner->m_isScrolling = false;
+            self->m_released(self->m_widget, self->m_owner.get());
+        }
+        return G_SOURCE_REMOVE;
+    }
+    static gboolean Input(GtkEventController*, GdkEvent* event, wxGTKScrollObserver* self)
+    {
+        wxGtkObject<GtkWidget> keepAlive(GTK_WIDGET(g_object_ref(self->m_widget)));
+        if (!self->m_owner)
+            return false;
+        switch (gdk_event_get_event_type(event))
+        {
+            case GDK_BUTTON_PRESS:
+            case GDK_TOUCH_BEGIN:
+                if (self->m_releaseSource)
+                {
+                    g_source_remove(self->m_releaseSource);
+                    Released(self);
+                    if (!self->m_owner) return false;
+                }
+                self->m_owner->m_mouseButtonDown = true;
+                break;
+            case GDK_BUTTON_RELEASE:
+            case GDK_TOUCH_END:
+            case GDK_TOUCH_CANCEL:
+            case GDK_GRAB_BROKEN:
+                self->m_owner->m_mouseButtonDown = false;
+                // GTK's internal range must finish processing this release
+                // before a wx handler is allowed to change its adjustment.
+                if (!self->m_releaseSource)
+                    self->m_releaseSource = g_idle_add_full(G_PRIORITY_HIGH_IDLE,
+                                                           Released, self, NULL);
+                break;
+            default:
+                break;
+        }
+        return false;
+    }
+
+    GtkWidget* m_widget;
+    wxWeakRef<wxWindow> m_owner;
+    GtkAdjustment* m_adjustment;
+    Callback m_changed, m_released;
+    gulong m_changeHandler;
+    guint m_releaseSource;
+};
