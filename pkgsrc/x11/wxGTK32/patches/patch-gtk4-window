+
+static wxWindow* wxGTKPointerOwner(GtkEventController* controller, GdkEvent* event)
+{
+    GtkWidget* widget = gtk_event_controller_get_widget(controller);
+    GtkNative* native = gtk_widget_get_native(widget);
+    double x, y, dx, dy;
+    if (!native || !gdk_event_get_position(event, &x, &y))
+        return NULL;
+    gtk_native_get_surface_transform(native, &dx, &dy);
+    GtkWidget* picked = gtk_widget_pick(GTK_WIDGET(native), x - dx, y - dy,
+                                         GTK_PICK_DEFAULT);
+    return static_cast<wxWindow*>(wxWindowFromGtkWidget(picked));
+}
+
+class wxGTKMouseEventScope
+{
+public:
+    explicit wxGTKMouseEventScope(GdkEvent* event) : m_previous(g_lastMouseEvent)
+        { g_lastMouseEvent = gdk_event_ref(event); }
+    ~wxGTKMouseEventScope()
+        { gdk_event_unref(g_lastMouseEvent); g_lastMouseEvent = m_previous; }
+private:
+    GdkEvent* m_previous;
+};
+
+static wxEventType wxGTKButtonType(guint button, bool release, bool twice)
+{
+    switch (button)
+    {
+        case 1: return release ? wxEVT_LEFT_UP : twice ? wxEVT_LEFT_DCLICK : wxEVT_LEFT_DOWN;
+        case 2: return release ? wxEVT_MIDDLE_UP : twice ? wxEVT_MIDDLE_DCLICK : wxEVT_MIDDLE_DOWN;
+        case 3: return release ? wxEVT_RIGHT_UP : twice ? wxEVT_RIGHT_DCLICK : wxEVT_RIGHT_DOWN;
+        case 8: return release ? wxEVT_AUX1_UP : twice ? wxEVT_AUX1_DCLICK : wxEVT_AUX1_DOWN;
+        case 9: return release ? wxEVT_AUX2_UP : twice ? wxEVT_AUX2_DCLICK : wxEVT_AUX2_DOWN;
+        default: return wxEVT_NULL;
+    }
+}
+
+static void wxGTKClick(GtkGesture* gesture, int presses, wxWindow* owner, bool release)
+{
+    GtkEventController* controller = GTK_EVENT_CONTROLLER(gesture);
+    GdkEvent* native = gtk_event_controller_get_current_event(controller);
+    if (!native || g_blockEventsOnDrag || g_blockEventsOnScroll)
+        return;
+    wxGtkObject<GtkGesture> keepGesture(GTK_GESTURE(g_object_ref(gesture)));
+    wxWindow* win = g_captureWindow ? static_cast<wxWindow*>(g_captureWindow) : owner;
+    // A release outside the original widget still belongs to its active
+    // gesture, just like GTK's implicit pointer grab.
+    if (!release)
+    {
+        if (g_captureWindow ? !owner->IsTopLevel() : wxGTKPointerOwner(controller, native) != owner)
+            return;
+        g_object_set_data(G_OBJECT(gesture), "wx-pressed", GINT_TO_POINTER(1));
+    }
+    else
+    {
+        if (!g_object_get_data(G_OBJECT(gesture), "wx-pressed"))
+            return;
+        g_object_set_data(G_OBJECT(gesture), "wx-pressed", NULL);
+    }
+    const guint button = gtk_gesture_single_get_current_button(GTK_GESTURE_SINGLE(gesture));
+    const wxEventType type = wxGTKButtonType(button, release, presses == 2);
+    if (type == wxEVT_NULL)
+        return;
+    wxMouseEvent event(type);
+    InitMouseEvent(win, event, native);
+    // GDK's event state describes the state before this button transition.
+    if (button == 1) event.m_leftDown = !release;
+    if (button == 2) event.m_middleDown = !release;
+    if (button == 3) event.m_rightDown = !release;
+    if (button == 8) event.m_aux1Down = !release;
+    if (button == 9) event.m_aux2Down = !release;
+    g_lastButtonNumber = button;
+    wxGTKMouseEventScope current(native);
+    wxWeakRef<wxWindow> alive(win);
+    if (win->GTKProcessEvent(event))
+        gtk_gesture_set_state(gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+    else if (alive && !release && button == 1 && win->AcceptsFocus())
+        win->SetFocus();
+    else if (alive && release && button == 3)
+    {
+        wxContextMenuEvent menu(wxEVT_CONTEXT_MENU, win->GetId(),
+                                win->ClientToScreen(event.GetPosition()));
+        menu.SetEventObject(win);
+        if (win->GTKProcessEvent(menu))
+            gtk_gesture_set_state(gesture, GTK_EVENT_SEQUENCE_CLAIMED);
+    }
+}
+
+extern "C" {
+static void click_pressed4(GtkGesture* gesture, int presses, double, double, wxWindow* win)
+    { wxGTKClick(gesture, presses, win, false); }
+static void click_released4(GtkGesture* gesture, int presses, double, double, wxWindow* win)
+    { wxGTKClick(gesture, presses, win, true); }
+
+static gboolean pointer_event4(GtkEventController* controller, GdkEvent* native, wxWindow* owner)
+{
+    const GdkEventType type = gdk_event_get_event_type(native);
+    if (type != GDK_MOTION_NOTIFY && type != GDK_SCROLL)
+        return false;
+    if (g_blockEventsOnDrag || g_blockEventsOnScroll)
+        return false;
+    if (g_captureWindow)
+    {
+        if (!owner->IsTopLevel())
+            return false;
+    }
+    else if (wxGTKPointerOwner(controller, native) != owner)
+        return false;
+    wxWindow* win = g_captureWindow ? static_cast<wxWindow*>(g_captureWindow) : owner;
+    wxWeakRef<wxWindow> alive(win);
+    wxGTKMouseEventScope current(native);
+    wxMouseEvent event(type == GDK_SCROLL ? wxEVT_MOUSEWHEEL : wxEVT_MOTION);
+    InitMouseEvent(win, event, native);
+    if (type == GDK_MOTION_NOTIFY)
+    {
+        SendSetCursorEvent(win, event.m_x, event.m_y);
+        return alive && win->GTKProcessEvent(event);
+    }
+    double dx = 0, dy = 0;
+    gdk_scroll_event_get_deltas(native, &dx, &dy);
+    event.m_wheelDelta = 120;
+    event.m_linesPerAction = event.m_columnsPerAction = 3;
+    // Convert logical pixel deltas to the configured number of text lines
+    // per wx detent. Wheel units already represent detents.
+    const bool pixels = gdk_scroll_event_get_unit(native) == GDK_SCROLL_UNIT_SURFACE;
+    const double scaleX = pixels ? 120.0 / wxMax(1, win->GetCharWidth() * 3) : 120;
+    const double scaleY = pixels ? 120.0 / wxMax(1, win->GetCharHeight() * 3) : 120;
+    bool handled = false;
+    if (dx != 0)
+    {
+        event.m_wheelAxis = wxMOUSE_WHEEL_HORIZONTAL;
+        event.m_wheelRotation = wxRound(dx * scaleX);
+        handled = win->GTKProcessEvent(event);
+    }
+    if (alive && dy != 0)
+    {
+        event.m_wheelAxis = wxMOUSE_WHEEL_VERTICAL;
+        event.m_wheelRotation = wxRound(-dy * scaleY);
+        handled = win->GTKProcessEvent(event) || handled;
+    }
+    // Unhandled input reaches GtkScrolledWindow's native scroll controller,
+    // which owns adjustments, smooth scrolling and kinetic deceleration.
+    return handled;
+}
+
+static void pointer_enter4(GtkEventController* controller, double, double, wxWindow* owner)
+{
+    GdkEvent* native = gtk_event_controller_get_current_event(controller);
+    if (!native || wxGTKPointerOwner(controller, native) != owner || g_windowUnderMouse == owner)
+        return;
+    g_windowUnderMouse = owner;
+    wxMouseEvent event(wxEVT_ENTER_WINDOW);
+    InitMouseEvent(owner, event, native);
+    owner->GTKProcessEvent(event);
+}
+
+static void pointer_leave4(GtkEventController* controller, wxWindow* owner)
+{
+    if (g_windowUnderMouse != owner)
+        return;
+    g_windowUnderMouse = NULL;
+    GdkEvent* native = gtk_event_controller_get_current_event(controller);
+    if (native)
+    {
+        wxMouseEvent event(wxEVT_LEAVE_WINDOW);
+        InitMouseEvent(owner, event, native);
+        owner->GTKProcessEvent(event);
+    }
+}
+} // extern "C"
+
+static void wxGTKConnectPointer(GtkWidget* widget, wxWindowGTK* win)
+{
+    GtkGesture* click = gtk_gesture_click_new();
+    gtk_gesture_single_set_button(GTK_GESTURE_SINGLE(click), 0);
+    gtk_event_controller_set_propagation_phase(GTK_EVENT_CONTROLLER(click), GTK_PHASE_CAPTURE);
+    g_signal_connect(click, "pressed", G_CALLBACK(click_pressed4), win);
+    g_signal_connect(click, "released", G_CALLBACK(click_released4), win);
+    wxGTKAddController(widget, GTK_EVENT_CONTROLLER(click), win);
+    GtkEventController* pointer = gtk_event_controller_legacy_new();
+    gtk_event_controller_set_propagation_phase(pointer, GTK_PHASE_CAPTURE);
+    g_signal_connect(pointer, "event", G_CALLBACK(pointer_event4), win);
+    wxGTKAddController(widget, pointer, win);
+    GtkEventController* motion = gtk_event_controller_motion_new();
+    g_signal_connect(motion, "enter", G_CALLBACK(pointer_enter4), win);
+    g_signal_connect(motion, "leave", G_CALLBACK(pointer_leave4), win);
+    wxGTKAddController(widget, motion, win);
+}
