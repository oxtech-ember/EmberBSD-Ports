+static void focus_enter4(GtkEventController* controller, wxWindowGTK* win)
+{
+    if (wxGTKFocusOwner(gtk_event_controller_get_widget(controller)) == win)
+        win->GTKHandleFocusIn();
+}
+
+static void focus_leave4(GtkEventController*, wxWindowGTK* win)
+{
