+static wxWindowGTK* wxWindowFromGtkWidget(GtkWidget* widget)
+{
+    for (; widget; widget = gtk_widget_get_parent(widget))
+    {
+        if (void* win = g_object_get_data(G_OBJECT(widget), "wx-window"))
+            return static_cast<wxWindowGTK*>(win);
+    }
+    return NULL;
+}
+
+static wxWindowGTK* wxGTKFocusOwner(GtkWidget* widget)
+{
+    GtkRoot* root = gtk_widget_get_root(widget);
+    return root ? wxWindowFromGtkWidget(gtk_root_get_focus(root)) : NULL;
+}
+
+static void wxGTKAddController(GtkWidget* widget, GtkEventController* controller,
+                               wxWindowGTK* win)
+{
+    g_object_set_data(G_OBJECT(controller), "wx-owner", win);
+    gtk_widget_add_controller(widget, controller);
+}
