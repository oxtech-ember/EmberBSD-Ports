@@ -443,9 +443,11 @@
 {
     wxSize size(sizeOrig);
     size.SetDefaults(GetDefaultSize());
+    // CreateBase uses this list to distinguish top-level windows before the
+    // native widgets exist. Keep the upstream GTK creation order.
+    wxTopLevelWindows.Append(this);
     if (!PreCreation(parent, pos, size) ||
         !CreateBase(parent, id, pos, size, style, wxDefaultValidator, name)) return false;
-    wxTopLevelWindows.Append(this);
     m_title = title;
     if (!m_widget)
     {
