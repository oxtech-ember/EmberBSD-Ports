+const char kFontDialogPendingKey[] = "wx-font-dialog-pending";
+
+struct FontDialogRequest
+{
+    explicit FontDialogRequest(wxFontButton* button, GtkWidget* widget)
+        : m_button(button), m_cancellable(g_cancellable_new()),
+          m_dialog(gtk_font_dialog_new())
+    {
+        g_weak_ref_init(&m_widget, widget);
+    }
+
+    ~FontDialogRequest()
+    {
+        g_weak_ref_clear(&m_widget);
+        g_object_unref(m_dialog);
+        g_object_unref(m_cancellable);
+    }
+
+    wxWeakRef<wxFontButton> m_button;
+    GWeakRef m_widget;
+    GCancellable* m_cancellable;
+    GtkFontDialog* m_dialog;
+};
+
+void CancelFontDialog(gpointer data, GObject*)
+{
+    auto* request = static_cast<FontDialogRequest*>(data);
+    g_cancellable_cancel(request->m_cancellable);
+}
+
+void FontDialogFinished(GObject* source, GAsyncResult* result, gpointer data)
+{
+    auto* request = static_cast<FontDialogRequest*>(data);
+    GError* error = nullptr;
+    PangoFontDescription* description =
+        gtk_font_dialog_choose_font_finish(GTK_FONT_DIALOG(source), result, &error);
+
+    GtkWidget* widget = GTK_WIDGET(g_weak_ref_get(&request->m_widget));
+    if (widget)
+    {
+        if (g_object_get_data(G_OBJECT(widget), kFontDialogPendingKey) == request)
+        {
+            g_object_weak_unref(G_OBJECT(widget), CancelFontDialog, request);
+            g_object_set_data(G_OBJECT(widget), kFontDialogPendingKey, nullptr);
+        }
+        g_object_unref(widget);
+    }
+
+    wxFontButton* button = request->m_button.get();
+    if (button && description && !error)
+    {
+        char* fontname = pango_font_description_to_string(description);
+        button->SetNativeFontInfo(fontname);
+        g_free(fontname);
+
+        // Updating the GTK label can run application callbacks that destroy
+        // the control, so reacquire it before reading it or sending the event.
+        button = request->m_button.get();
+        if (button)
+        {
+            const wxFont selectedFont = button->GetSelectedFont();
+            wxFontPickerEvent event(button, button->GetId(), selectedFont);
+            button = request->m_button.get();
+            if (button)
+                button->HandleWindowEvent(event);
+        }
+    }
+
+    if (description)
+        pango_font_description_free(description);
+    g_clear_error(&error);
+    delete request;
+}
+
+void FontDialogButtonClicked(GtkWidget* widget, wxFontButton* button)
+{
+    if (g_object_get_data(G_OBJECT(widget), kFontDialogPendingKey))
+        return;
+
+    auto* request = new FontDialogRequest(button, widget);
+    g_object_set_data(G_OBJECT(widget), kFontDialogPendingKey, request);
+    g_object_weak_ref(G_OBJECT(widget), CancelFontDialog, request);
+
+    const wxFont selectedFont = button->GetSelectedFont();
+    const wxNativeFontInfo* info = selectedFont.GetNativeFontInfo();
+    GtkRoot* root = gtk_widget_get_root(widget);
+    GtkWindow* parent = root && GTK_IS_WINDOW(root) ? GTK_WINDOW(root) : nullptr;
+    gtk_font_dialog_choose_font(request->m_dialog, parent,
+                                info ? info->description : nullptr,
+                                request->m_cancellable, FontDialogFinished, request);
+}
+} // namespace
