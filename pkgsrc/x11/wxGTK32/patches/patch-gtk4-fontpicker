 void wxFontButton::UpdateFont()
 {
-    const wxNativeFontInfo *info = m_selectedFont.GetNativeFontInfo();
+    const wxFont selectedFont = m_selectedFont;
+    const wxNativeFontInfo *info = selectedFont.GetNativeFontInfo();
     wxASSERT_MSG( info, wxT("The fontbutton's internal font is not valid ?") );
 
+#ifdef __WXGTK4__
+    // GTK label property notifications can reenter application code and
+    // destroy this control. Keep the widget and font data alive and avoid
+    // accessing this object after notifying GTK.
+    GtkWidget* const button = GTK_WIDGET(g_object_ref(m_widget));
+    const long style = m_windowStyle;
+    GtkWidget* const label = GTK_WIDGET(
+        g_object_ref(gtk_button_get_child(GTK_BUTTON(button))));
+    wxString labelText = (style & wxFNTP_FONTDESC_AS_LABEL)
+        ? info->ToString() : selectedFont.GetFaceName();
+    gtk_label_set_text(GTK_LABEL(label), wxGTK_CONV(labelText));
+
+    if (style & wxFNTP_USEFONT_FOR_LABEL)
+    {
+        PangoAttrList* attrs = pango_attr_list_new();
+        pango_attr_list_insert(attrs, pango_attr_font_desc_new(info->description));
+        gtk_label_set_attributes(GTK_LABEL(label), attrs);
+        pango_attr_list_unref(attrs);
+    }
+    else
