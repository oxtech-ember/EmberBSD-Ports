+static int wxGTKFrameMeasure(GtkWidget* widget, GtkOrientation orientation)
+{
+    int size = 0;
+#ifdef __WXGTK4__
+    gtk_widget_measure(widget, orientation, -1, NULL, &size, NULL, NULL);
+#else
+    if (orientation == GTK_ORIENTATION_HORIZONTAL)
+        gtk_widget_get_preferred_width(widget, NULL, &size);
+    else
+        gtk_widget_get_preferred_height(widget, NULL, &size);
+#endif
+    return size;
+}
