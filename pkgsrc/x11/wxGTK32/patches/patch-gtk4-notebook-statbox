+static void wxGTKNotebookChanging(GtkNotebook* native, GtkWidget* page, guint index, wxNotebook* win)
+{
+    const unsigned generation = ++win->m_gtk4SelectionGeneration;
+    wxWeakRef<wxNotebook> self(win);
+    g_object_ref(page);
+    win->m_oldSelection = gtk_notebook_get_current_page(native);
+    const bool allowed = win->SendPageChangingEvent(index);
+    // A nested selection or structural edit supersedes the outer request.
+    // GtkNotebook::switch-page is RUN_LAST, so veto precedes its class handler.
+    if (!self || self->IsBeingDeleted() || !allowed ||
+        generation != self->m_gtk4SelectionGeneration ||
+        gtk_notebook_page_num(native, page) != int(index))
+        g_signal_stop_emission_by_name(native, "switch-page");
+    g_object_unref(page);
+}
+static void wxGTKNotebookChanged(GtkNotebook*, GtkWidget*, guint, wxNotebook* win)
+    { win->GTKOnPageChanged(); }
+
+// Strong native ownership makes unblocking safe even when a wx callback deletes
+// the notebook during a synchronous GTK operation. This never dereferences win.
+struct wxGTKNotebookBlock
+{
+    GtkWidget* widget;
+    wxNotebook* owner;
+    wxGTKNotebookBlock(wxNotebook* win) : widget(GTK_WIDGET(g_object_ref(win->m_widget))), owner(win)
+    {
+        g_signal_handlers_block_by_func(widget, reinterpret_cast<void*>(wxGTKNotebookChanging), owner);
+        g_signal_handlers_block_by_func(widget, reinterpret_cast<void*>(wxGTKNotebookChanged), owner);
+    }
+    wxGTKNotebookBlock(const wxGTKNotebookBlock&) = delete;
+    wxGTKNotebookBlock& operator=(const wxGTKNotebookBlock&) = delete;
+    ~wxGTKNotebookBlock()
+    {
+        g_signal_handlers_unblock_by_func(widget, reinterpret_cast<void*>(wxGTKNotebookChanging), owner);
+        g_signal_handlers_unblock_by_func(widget, reinterpret_cast<void*>(wxGTKNotebookChanged), owner);
+        g_object_unref(widget);
+    }
+};
