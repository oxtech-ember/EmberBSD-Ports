+bool wxNotebook::SetPageImage(size_t index, int image)
+{
+    wxCHECK_MSG(index < GetPageCount(), false, "invalid page index");
+    wxGtkNotebookPage* page = GetNotebookPage(index);
+    const wxBitmapBundle bitmap = GetBitmapBundle(image);
+    if (bitmap.IsOk())
+    {
+        if (!page->m_image)
+        {
+            page->m_image = wxGtkImage::New(this);
+            gtk_box_prepend(GTK_BOX(page->m_box), page->m_image);
+        }
+        WX_GTK_IMAGE(page->m_image)->Set(bitmap);
+    }
+    else if (page->m_image)
+    {
+        GtkWidget* imageWidget = page->m_image;
+        page->m_image = NULL;
+        gtk_box_remove(GTK_BOX(page->m_box), imageWidget);
+    }
+    page->m_imageIndex = image;
+    InvalidateBestSize();
+    return true;
+}
+int wxNotebook::DoSetSelection(size_t index, int flags)
+{
+    wxCHECK_MSG(index < GetPageCount(), wxNOT_FOUND, "invalid page index");
+    const int previous = GetSelection();
+    ++m_gtk4SelectionGeneration;
+    wxWeakRef<wxNotebook> self(this);
+    if (flags & SetSelection_SendEvent)
+        gtk_notebook_set_current_page(GTK_NOTEBOOK(m_widget), index);
+    else
+    {
+        wxGTKNotebookBlock block(this);
+        gtk_notebook_set_current_page(GTK_NOTEBOOK(m_widget), index);
+    }
+    if (self && !IsBeingDeleted())
+    {
+        m_selection = GetSelection();
+        if (m_selection >= 0 && size_t(m_selection) < GetPageCount())
+            GetPage(m_selection)->SetFocus();
+    }
+    return previous;
+}
+void wxNotebook::GTKOnPageChanged()
+{
+    m_selection = GetSelection();
+    SendPageChangedEvent(m_oldSelection);
+}
+bool wxNotebook::InsertPage(size_t index, wxNotebookPage* child,
+                           const wxString& text, bool select, int image)
+{
+    wxCHECK_MSG(child && child->GetParent() == this, false, "invalid page parent");
+    wxCHECK_MSG(index <= GetPageCount(), false, "invalid page index");
+    wxCHECK_MSG(!gtk_widget_get_parent(child->m_widget), false, "page already inserted");
+    ++m_gtk4SelectionGeneration;
+    wxGtkNotebookPage* page = new wxGtkNotebookPage;
+    page->m_box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, wxMax(1, m_padding));
+    g_object_ref_sink(page->m_box);
+    gtk_widget_set_margin_start(page->m_box, m_padding);
+    gtk_widget_set_margin_end(page->m_box, m_padding);
+    gtk_widget_set_size_request(page->m_box, m_gtk4TabSize.x, m_gtk4TabSize.y);
+    page->m_label = gtk_label_new(wxGTK_CONV(wxStripMenuCodes(text)));
+    GtkWidget* labelContainer = page->m_label;
+    if (m_windowStyle & (wxBK_LEFT | wxBK_RIGHT))
+    {
+        wxGTKTabLabel* rotated = reinterpret_cast<wxGTKTabLabel*>(g_object_new(wx_gtk_tab_label_get_type(), NULL));
+        rotated->label = page->m_label;
+        rotated->clockwise = (m_windowStyle & wxBK_RIGHT) != 0;
+        gtk_widget_set_parent(page->m_label, GTK_WIDGET(rotated));
+        labelContainer = GTK_WIDGET(rotated);
+    }
+    gtk_box_append(GTK_BOX(page->m_box), labelContainer);
+    m_pages.insert(m_pages.begin() + index, child);
+    m_pagesData.Insert(index, page);
+    SetPageImage(index, image);
+    GTKApplyStyle(page->m_label, NULL);
+    wxWeakRef<wxNotebook> self(this);
+    {
+        wxGTKNotebookBlock block(this);
+        gtk_notebook_insert_page(GTK_NOTEBOOK(m_widget), child->m_widget, page->m_box, index);
+    }
+    if (!self || IsBeingDeleted()) return false;
+    InvalidateBestSize();
+    DoSetSelectionAfterInsertion(index, select);
+    return true;
+}
+wxNotebookPage* wxNotebook::DoRemovePage(size_t index)
+{
+    wxCHECK_MSG(index < GetPageCount(), NULL, "invalid page index");
+    const unsigned generation = ++m_gtk4SelectionGeneration;
+    wxNotebookPage* child = GetPage(index);
+    wxGtkNotebookPage* page = GetNotebookPage(index);
+    const int previous = GetSelection();
+    wxWeakRef<wxNotebook> self(this);
+    wxWeakRef<wxNotebookPage> childLife(child);
+    if (!m_gtk4Destroying && !IsBeingDeleted() && previous == int(index) && GetPageCount() > 1)
+    {
+        const int next = index ? int(index) - 1 : 1;
+        const bool allowed = SendPageChangingEvent(next);
+        if (!self || !childLife || !allowed || IsBeingDeleted() ||
+            generation != m_gtk4SelectionGeneration) return NULL;
+    }
+    {
+        wxGTKNotebookBlock block(this);
+        gtk_notebook_remove_page(GTK_NOTEBOOK(m_widget), index);
+    }
+    if (!self) return childLife.get();
+    wxNotebookBase::DoRemovePage(index);
+    m_pagesData.DeleteObject(page);
+    delete page;
+    m_selection = GetSelection();
+    InvalidateBestSize();
+    // Native removal is complete and both index lists agree before notifying
+    // the actual resulting selection. Veto was handled before the mutation.
+    if (!m_gtk4Destroying && !IsBeingDeleted() && previous == int(index) && m_selection != wxNOT_FOUND)
+        SendPageChangedEvent(previous);
+    return childLife.get();
+}
+bool wxNotebook::DeleteAllPages()
+{
+    while (GetPageCount())
+    {
+        wxWeakRef<wxNotebook> self(this);
+        if (!DeletePage(GetPageCount() - 1)) return false;
+        if (!self) return true;
+    }
+    return true;
+}
+void wxNotebook::SetPadding(const wxSize& padding)
+{
+    m_padding = wxMax(0, padding.x);
+    for (size_t i = 0; i < GetPageCount(); ++i)
+    {
+        GtkWidget* box = GetNotebookPage(i)->m_box;
+        gtk_box_set_spacing(GTK_BOX(box), wxMax(1, m_padding));
+        gtk_widget_set_margin_start(box, m_padding);
+        gtk_widget_set_margin_end(box, m_padding);
+    }
+    InvalidateBestSize();
+}
+void wxNotebook::SetTabSize(const wxSize& size)
+{
+    m_gtk4TabSize = size;
+    for (size_t i = 0; i < GetPageCount(); ++i)
+        gtk_widget_set_size_request(GetNotebookPage(i)->m_box, size.x, size.y);
+    InvalidateBestSize();
+}
+wxSize wxNotebook::CalcSizeFromPage(const wxSize& pageSize) const
+{
+    // Measure actual themed widgets. GTK includes the tab strip and stack CSS
+    // in its native request, so no fabricated GtkWidgetPath or fixed metrics.
+    wxSize pageNatural(0, 0);
+    for (size_t i = 0; i < GetPageCount(); ++i)
+        pageNatural.IncTo(GTKGetPreferredSize(GetPage(i)->m_widget));
+    const wxSize native = GTKGetPreferredSize(m_widget);
+    return wxSize(pageSize.x + wxMax(0, native.x - pageNatural.x),
+                  pageSize.y + wxMax(0, native.y - pageNatural.y));
+}
+static bool wxGTKNotebookContains(GtkWidget* root, GtkWidget* child, const wxPoint& point)
+{
+    if (!gtk_widget_is_visible(child) || !gtk_widget_get_child_visible(child)) return false;
+    graphene_rect_t bounds;
+    if (!gtk_widget_compute_bounds(child, root, &bounds)) return false;
+    graphene_point_t p;
+    graphene_point_init(&p, float(point.x), float(point.y));
+    return graphene_rect_contains_point(&bounds, &p);
+}
+int wxNotebook::HitTest(const wxPoint& point, long* flags) const
+{
+    for (size_t i = 0; i < GetPageCount(); ++i)
+    {
+        wxGtkNotebookPage* page = GetNotebookPage(i);
+        if (!wxGTKNotebookContains(m_widget, page->m_box, point)) continue;
+        if (flags)
+            *flags = page->m_image && wxGTKNotebookContains(m_widget, page->m_image, point) ?
+                wxBK_HITTEST_ONICON : wxGTKNotebookContains(m_widget, page->m_label, point) ?
+                wxBK_HITTEST_ONLABEL : wxBK_HITTEST_ONITEM;
+        return i;
+    }
+    if (flags)
+    {
+        *flags = wxBK_HITTEST_NOWHERE;
+        wxNotebookPage* page = GetCurrentPage();
+        if (page && wxGTKNotebookContains(m_widget, page->m_widget, point))
+            *flags |= wxBK_HITTEST_ONPAGE;
+    }
+    return wxNOT_FOUND;
+}
+void wxNotebook::OnNavigationKey(wxNavigationKeyEvent& event)
+{
+    if (event.IsWindowChange()) AdvanceSelection(event.GetDirection());
+    else event.Skip();
+}
