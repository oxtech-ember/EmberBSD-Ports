+void wxNotebook::Init()
+{
+    m_padding = 0; m_oldSelection = -1; m_themeEnabled = true;
+    m_gtk4SelectionGeneration = 0;
+    m_gtk4Destroying = false;
+    m_gtk4TabSize = wxDefaultSize;
+}
+wxNotebook::wxNotebook() { Init(); }
+wxNotebook::wxNotebook(wxWindow* parent, wxWindowID id, const wxPoint& pos,
+                      const wxSize& size, long style, const wxString& name)
+{ Init(); Create(parent, id, pos, size, style, name); }
+wxNotebook::~wxNotebook()
+{
+    m_gtk4Destroying = true;
+    if (m_widget) GTKDisconnect(m_widget);
+    DeleteAllPages();
+}
+bool wxNotebook::Create(wxWindow* parent, wxWindowID id, const wxPoint& pos,
+                       const wxSize& size, long style, const wxString& name)
+{
+    if ((style & wxBK_ALIGN_MASK) == wxBK_DEFAULT) style |= wxBK_TOP;
+    if (!PreCreation(parent, pos, size) ||
+        !CreateBase(parent, id, pos, size, style, wxDefaultValidator, name)) return false;
+    m_widget = gtk_notebook_new();
+    g_object_ref(m_widget);
+    gtk_notebook_set_scrollable(GTK_NOTEBOOK(m_widget), TRUE);
+    if (style & wxBK_LEFT) gtk_notebook_set_tab_pos(GTK_NOTEBOOK(m_widget), GTK_POS_LEFT);
+    else if (style & wxBK_RIGHT) gtk_notebook_set_tab_pos(GTK_NOTEBOOK(m_widget), GTK_POS_RIGHT);
+    else if (style & wxBK_BOTTOM) gtk_notebook_set_tab_pos(GTK_NOTEBOOK(m_widget), GTK_POS_BOTTOM);
+    g_signal_connect(m_widget, "switch-page", G_CALLBACK(wxGTKNotebookChanging), this);
+    g_signal_connect_after(m_widget, "switch-page", G_CALLBACK(wxGTKNotebookChanged), this);
+    parent->DoAddChild(this);
+    PostCreation(size);
+    return true;
+}
