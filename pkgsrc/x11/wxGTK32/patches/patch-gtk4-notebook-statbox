+// Public widget allocation/snapshot transforms replace GtkLabel's removed
+// angle property. Only the label rotates; tab icons keep their usual direction.
+struct wxGTKTabLabel
+{
+    GtkWidget parent;
+    GtkWidget* label;
+    bool clockwise;
+};
+struct wxGTKTabLabelClass { GtkWidgetClass parent; };
+G_DEFINE_TYPE(wxGTKTabLabel, wx_gtk_tab_label, GTK_TYPE_WIDGET)
+static void wx_gtk_tab_label_measure(GtkWidget* widget, GtkOrientation orientation,
+    int forSize, int* minimum, int* natural, int* minBaseline, int* natBaseline)
+{
+    wxGTKTabLabel* tab = reinterpret_cast<wxGTKTabLabel*>(widget);
+    gtk_widget_measure(tab->label, orientation == GTK_ORIENTATION_HORIZONTAL ?
+        GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL, forSize,
+        minimum, natural, NULL, NULL);
+    *minBaseline = *natBaseline = -1;
+}
+static void wx_gtk_tab_label_allocate(GtkWidget* widget, int width, int height, int)
+{
+    wxGTKTabLabel* tab = reinterpret_cast<wxGTKTabLabel*>(widget);
+    graphene_point_t point;
+    graphene_point_init(&point, tab->clockwise ? float(width) : 0,
+                               tab->clockwise ? 0 : float(height));
+    GskTransform* transform = gsk_transform_translate(NULL, &point);
+    transform = gsk_transform_rotate(transform, tab->clockwise ? 90 : -90);
+    gtk_widget_allocate(tab->label, height, width, -1, transform);
+}
+static void wx_gtk_tab_label_snapshot(GtkWidget* widget, GtkSnapshot* snapshot)
+{
+    wxGTKTabLabel* tab = reinterpret_cast<wxGTKTabLabel*>(widget);
+    gtk_widget_snapshot_child(widget, tab->label, snapshot);
+}
+static void wx_gtk_tab_label_dispose(GObject* object)
+{
+    wxGTKTabLabel* tab = reinterpret_cast<wxGTKTabLabel*>(object);
+    if (tab->label)
+    {
+        GtkWidget* label = tab->label;
+        tab->label = NULL;
+        gtk_widget_unparent(label);
+    }
+    G_OBJECT_CLASS(wx_gtk_tab_label_parent_class)->dispose(object);
+}
+static void wx_gtk_tab_label_class_init(wxGTKTabLabelClass* klass)
+{
+    GtkWidgetClass* widget = GTK_WIDGET_CLASS(klass);
+    widget->measure = wx_gtk_tab_label_measure;
+    widget->size_allocate = wx_gtk_tab_label_allocate;
+    widget->snapshot = wx_gtk_tab_label_snapshot;
+    G_OBJECT_CLASS(klass)->dispose = wx_gtk_tab_label_dispose;
+    gtk_widget_class_set_css_name(widget, "wx-tab-label");
+}
+static void wx_gtk_tab_label_init(wxGTKTabLabel* tab)
+    { tab->label = NULL; tab->clockwise = false; }
