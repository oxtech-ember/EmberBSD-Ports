+struct wxGTKToolBitmap: wxGtkImage::BitmapProvider
+{
+    wxBitmapBundle normal, disabled;
+    wxSize size;
+    bool enabled = true;
+    mutable wxBitmap disabledSource, disabledResult;
+    mutable unsigned long disabledGeneration = 0;
+    wxBitmap Get(int scale) const wxOVERRIDE
+    {
+        const wxBitmapBundle& bundle = enabled || !disabled.IsOk() ? normal : disabled;
+        if (!bundle.IsOk() || size.x <= 0 || size.y <= 0) return wxNullBitmap;
+        wxBitmap bitmap = bundle.GetBitmap(size * scale);
+        if (!enabled && !disabled.IsOk() && bitmap.IsOk())
+        {
+            if (!disabledSource.IsSameAs(bitmap) ||
+                disabledGeneration != bitmap.GetTextureGeneration())
+            {
+                disabledSource = bitmap;
+                disabledGeneration = bitmap.GetTextureGeneration();
+                disabledResult = bitmap.CreateDisabled();
+            }
+            return disabledResult;
+        }
+        return bitmap;
+    }
+    void Set(const wxBitmapBundle& bitmap) wxOVERRIDE
+    {
+        normal = bitmap;
+        disabledSource = wxBitmap();
+        disabledResult = wxBitmap();
+    }
+};
