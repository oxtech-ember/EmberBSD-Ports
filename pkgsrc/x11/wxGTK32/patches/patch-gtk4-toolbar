+bool wxToolBar::DoInsertTool(size_t pos, wxToolBarToolBase* base)
+{
+    wxToolBarTool* tool = static_cast<wxToolBarTool*>(base);
+    const bool vertical = HasFlag(wxTB_LEFT | wxTB_RIGHT);
+    if (tool->IsControl())
+    {
+        tool->item = tool->GetControl()->m_widget;
+        g_object_ref(tool->item);
+        if (!gtk_widget_get_parent(tool->item)) gtk_box_append(GTK_BOX(m_toolbar), tool->item);
+        const wxSize size = tool->GetControl()->GetBestSize();
+        gtk_widget_set_size_request(tool->item, size.x, size.y);
+    }
+    else
+    {
+        if (tool->IsSeparator())
+        {
+            tool->item = tool->IsStretchable() ? gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0) :
+                gtk_separator_new(vertical ? GTK_ORIENTATION_HORIZONTAL : GTK_ORIENTATION_VERTICAL);
+            gtk_widget_set_hexpand(tool->item, tool->IsStretchable() && !vertical);
+            gtk_widget_set_vexpand(tool->item, tool->IsStretchable() && vertical);
+        }
+        else
+        {
+            tool->button = tool->CanBeToggled() ? gtk_toggle_button_new() : gtk_button_new();
+            tool->item = tool->button;
+            tool->content = gtk_box_new(HasFlag(wxTB_HORZ_LAYOUT) ? GTK_ORIENTATION_HORIZONTAL : GTK_ORIENTATION_VERTICAL, 2);
+            wxGTKToolBitmap* provider = new wxGTKToolBitmap;
+            provider->size = GetToolBitmapSize();
+            tool->image = wxGtkImage::New(provider);
+            tool->labelWidget = gtk_label_new(wxGTK_CONV(wxControl::RemoveMnemonics(tool->GetLabel())));
+            gtk_box_append(GTK_BOX(tool->content), tool->image);
+            gtk_box_append(GTK_BOX(tool->content), tool->labelWidget);
+            gtk_button_set_child(GTK_BUTTON(tool->button), tool->content);
+            gtk_widget_set_visible(tool->image, !HasFlag(wxTB_NOICONS));
+            gtk_widget_set_visible(tool->labelWidget, HasFlag(wxTB_TEXT | wxTB_NOICONS));
+            if (HasFlag(wxTB_FLAT)) gtk_widget_add_css_class(tool->button, "flat");
+            g_object_set_data(G_OBJECT(tool->button), "wx-toolbar-tool", tool);
+            if (tool->CanBeToggled())
+                g_signal_connect(tool->button, "toggled", G_CALLBACK(wxToolBarTool::Toggled), tool);
+            else
+                g_signal_connect(tool->button, "clicked", G_CALLBACK(wxToolBarTool::Clicked), tool);
+            if (tool->GetKind() == wxITEM_DROPDOWN)
+            {
+                tool->item = gtk_box_new(vertical ? GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL, 0);
+                gtk_widget_add_css_class(tool->item, "linked");
+                gtk_box_append(GTK_BOX(tool->item), tool->button);
+                tool->arrow = gtk_button_new_from_icon_name(vertical ? "pan-end-symbolic" : "pan-down-symbolic");
+                gtk_box_append(GTK_BOX(tool->item), tool->arrow);
+                g_object_set_data(G_OBJECT(tool->arrow), "wx-toolbar-tool", tool);
+                g_signal_connect(tool->arrow, "clicked", G_CALLBACK(wxToolBarTool::Dropdown), tool);
+            }
+            tool->SetLabel(tool->GetLabel());
+            tool->SetImage(this);
+        }
+        g_object_ref_sink(tool->item);
+        gtk_box_append(GTK_BOX(m_toolbar), tool->item);
+    }
+    GtkWidget* previous = NULL;
+    if (pos) previous = static_cast<wxToolBarTool*>(GetToolByPos(pos - 1))->item;
+    gtk_box_reorder_child_after(GTK_BOX(m_toolbar), tool->item, previous);
+    gtk_widget_set_sensitive(tool->item, tool->IsEnabled());
+    gtk_widget_set_tooltip_text(tool->item,
+        HasFlag(wxTB_NO_TOOLTIPS) || tool->GetShortHelp().empty() ? NULL : tool->GetShortHelp().utf8_str().data());
+    g_object_set_data(G_OBJECT(tool->item), "wx-toolbar-tool", tool);
+    if (tool->IsButton())
+    {
+        GtkEventController* motion = gtk_event_controller_motion_new();
+        g_signal_connect(motion, "enter", G_CALLBACK(wxToolBarTool::Enter), NULL);
+        g_signal_connect(motion, "leave", G_CALLBACK(wxToolBarTool::Leave), NULL);
+        gtk_widget_add_controller(tool->item, motion);
+        GtkGesture* right = gtk_gesture_click_new();
+        gtk_gesture_single_set_button(GTK_GESTURE_SINGLE(right), 3);
+        g_signal_connect(right, "pressed", G_CALLBACK(wxToolBarTool::RightClick), NULL);
+        gtk_widget_add_controller(tool->item, GTK_EVENT_CONTROLLER(right));
+    }
+    GTKRegroupTools(tool, pos);
+    if (tool->CanBeToggled()) DoToggleTool(tool, tool->IsToggled());
+    InvalidateBestSize();
+    return true;
+}
+bool wxToolBar::DoDeleteTool(size_t, wxToolBarToolBase* base)
+{
+    static_cast<wxToolBarTool*>(base)->DetachNative();
+    GTKRegroupTools(NULL, 0, base);
+    InvalidateBestSize();
+    return true;
+}
+void wxToolBar::DoEnableTool(wxToolBarToolBase* base, bool enabled)
+{
+    wxToolBarTool* tool = static_cast<wxToolBarTool*>(base);
+    if (!tool->item) return;
+    GtkWidget* item = GTK_WIDGET(g_object_ref(tool->item));
+    gtk_widget_set_sensitive(item, enabled);
+    if (wxToolBarTool::Lookup(item) == tool) tool->SetImage();
+    g_object_unref(item);
+}
+void wxToolBar::DoToggleTool(wxToolBarToolBase* base, bool toggled)
+{
+    wxToolBarTool* tool = static_cast<wxToolBarTool*>(base);
+    if (!tool->button || !GTK_IS_TOGGLE_BUTTON(tool->button)) return;
+    GtkWidget* button = GTK_WIDGET(g_object_ref(tool->button));
+    g_signal_handlers_block_by_func(button, reinterpret_cast<void*>(wxToolBarTool::Toggled), tool);
+    gtk_toggle_button_set_active(GTK_TOGGLE_BUTTON(button), toggled);
+    g_signal_handlers_unblock_by_func(button, reinterpret_cast<void*>(wxToolBarTool::Toggled), tool);
+    g_object_unref(button);
+}
+void wxToolBar::DoSetToggle(wxToolBarToolBase* tool, bool)
+{
+    for (size_t i = 0; i < GetToolsCount(); ++i)
+        if (GetToolByPos(i) == tool)
+        {
+            DoDeleteTool(i, tool);
+            DoInsertTool(i, tool);
+            break;
+        }
+}
+wxSize wxToolBar::DoGetBestSize() const
+    { return GTKGetPreferredSize(m_widget); }
+wxToolBarToolBase* wxToolBar::FindToolForPosition(wxCoord x, wxCoord y) const
+{
+    graphene_point_t point;
+    graphene_point_init(&point, float(x), float(y));
+    for (auto base : m_tools)
+    {
+        wxToolBarTool* tool = static_cast<wxToolBarTool*>(base);
+        graphene_rect_t bounds;
+        if (tool->item && gtk_widget_compute_bounds(tool->item, m_widget, &bounds) &&
+            graphene_rect_contains_point(&bounds, &point)) return tool;
+    }
+    return NULL;
+}
+void wxToolBar::SetToolShortHelp(int id, const wxString& help)
+{
+    wxToolBarTool* tool = static_cast<wxToolBarTool*>(FindById(id));
+    if (!tool) return;
+    tool->SetShortHelp(help);
+    if (tool->item) gtk_widget_set_tooltip_text(tool->item, HasFlag(wxTB_NO_TOOLTIPS) ? NULL : help.utf8_str().data());
+}
+void wxToolBar::SetToolNormalBitmap(int id, const wxBitmapBundle& bitmap)
+{
+    wxToolBarTool* tool = static_cast<wxToolBarTool*>(FindById(id));
+    if (!tool || !tool->IsButton()) return;
+    tool->SetNormalBitmap(bitmap); tool->SetImage(); InvalidateBestSize();
+}
+void wxToolBar::SetToolDisabledBitmap(int id, const wxBitmapBundle& bitmap)
+{
+    wxToolBarTool* tool = static_cast<wxToolBarTool*>(FindById(id));
+    if (!tool || !tool->IsButton()) return;
+    tool->SetDisabledBitmap(bitmap); tool->SetImage();
+}
+wxVisualAttributes wxToolBar::GetClassDefaultAttributes(wxWindowVariant)
+{
+    GtkWidget* box = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+    gtk_widget_add_css_class(box, "toolbar");
+    return GetDefaultAttributesFromGTKWidget(box);
+}
