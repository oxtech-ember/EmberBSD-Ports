+class wxToolBarTool: public wxToolBarToolBase
+{
+public:
+    wxToolBarTool(wxToolBar* bar, int id, const wxString& label,
+        const wxBitmapBundle& normal, const wxBitmapBundle& disabled,
+        wxItemKind kind, wxObject* client, const wxString& shortHelp, const wxString& longHelp)
+        : wxToolBarToolBase(bar, id, label, normal, disabled, kind, client, shortHelp, longHelp) {}
+    wxToolBarTool(wxToolBar* bar, wxControl* control, const wxString& label)
+        : wxToolBarToolBase(bar, control, label) {}
+    ~wxToolBarTool() { DetachNative(); }
+    GtkWidget *item = NULL, *button = NULL, *arrow = NULL, *content = NULL,
+              *image = NULL, *labelWidget = NULL;
+
+    void DetachNative()
+    {
+        // Clear every event lookup before signals, unparenting or image finalizers.
+        if (button) { g_object_set_data(G_OBJECT(button), "wx-toolbar-tool", NULL); g_signal_handlers_disconnect_by_data(button, this); }
+        if (arrow) { g_object_set_data(G_OBJECT(arrow), "wx-toolbar-tool", NULL); g_signal_handlers_disconnect_by_data(arrow, this); }
+        if (item)
+        {
+            g_object_set_data(G_OBJECT(item), "wx-toolbar-tool", NULL);
+            GtkWidget* parent = gtk_widget_get_parent(item);
+            if (GTK_IS_BOX(parent)) gtk_box_remove(GTK_BOX(parent), item);
+            else if (parent) gtk_widget_unparent(item);
+            g_object_unref(item);
+        }
+        item = button = arrow = content = image = labelWidget = NULL;
+    }
+    void SetImage(wxToolBarBase* bar = NULL)
+    {
+        if (!image) return;
+        wxGTKToolBitmap* provider = static_cast<wxGTKToolBitmap*>(WX_GTK_IMAGE(image)->m_provider);
+        provider->disabled = GetDisabledBitmapBundle();
+        provider->enabled = IsEnabled();
+        if (!bar) bar = GetToolBar();
+        wxCHECK_RET(bar, "tool has no toolbar");
+        provider->size = bar->GetToolBitmapSize();
+        WX_GTK_IMAGE(image)->Set(GetNormalBitmapBundle());
+    }
+    void SetLabel(const wxString& label) wxOVERRIDE
+    {
+        wxToolBarToolBase::SetLabel(label);
+        const wxScopedCharBuffer text = wxControl::RemoveMnemonics(label).utf8_str();
+        if (labelWidget) gtk_label_set_text(GTK_LABEL(labelWidget), text.data());
+        if (button) gtk_accessible_update_property(GTK_ACCESSIBLE(button), GTK_ACCESSIBLE_PROPERTY_LABEL, text.data(), -1);
+        if (arrow) gtk_accessible_update_property(GTK_ACCESSIBLE(arrow), GTK_ACCESSIBLE_PROPERTY_LABEL, text.data(), -1);
+        if (GetToolBar()) GetToolBar()->InvalidateBestSize();
+    }
+    static wxToolBarTool* Lookup(GtkWidget* widget)
+        { return static_cast<wxToolBarTool*>(g_object_get_data(G_OBJECT(widget), "wx-toolbar-tool")); }
+    static void Clicked(GtkButton* native, wxToolBarTool*)
+    {
+        wxToolBarTool* tool = Lookup(GTK_WIDGET(native));
+        if (!tool || g_blockEventsOnDrag || !tool->IsEnabled() ||
+            !tool->GetToolBar() || tool->GetToolBar()->IsBeingDeleted()) return;
+        tool->GetToolBar()->OnLeftClick(tool->GetId(), false);
+    }
+    static void Toggled(GtkToggleButton* native, wxToolBarTool*)
+    {
+        wxToolBarTool* tool = Lookup(GTK_WIDGET(native));
+        if (!tool) return;
+        const bool active = gtk_toggle_button_get_active(native);
+        if (g_blockEventsOnDrag || !tool->IsEnabled() ||
+            (tool->GetKind() == wxITEM_RADIO && !active))
+        {
+            g_signal_handlers_block_by_func(native, reinterpret_cast<void*>(Toggled), tool);
+            gtk_toggle_button_set_active(native, tool->IsToggled());
+            g_signal_handlers_unblock_by_func(native, reinterpret_cast<void*>(Toggled), tool);
+            return;
+        }
+        wxWeakRef<wxToolBarBase> bar(tool->GetToolBar());
+        if (!bar || bar->IsBeingDeleted()) return;
+        const int id = tool->GetId();
+        const bool before = tool->IsToggled();
+        int previousRadio = wxID_NONE;
+        if (tool->GetKind() == wxITEM_RADIO)
+        {
+            // Native buttons are deliberately not grouped: wx owns contiguous
+            // radio runs and can restore the prior selection if OnLeftClick vetoes.
+            for (size_t i = 0; i < bar->GetToolsCount(); ++i)
+            {
+                if (bar->GetToolByPos(i) != tool) continue;
+                for (int j = int(i) - 1; j >= 0; --j)
+                {
+                    wxToolBarToolBase* other = bar->GetToolByPos(j);
+                    if (!other->IsButton() || other->GetKind() != wxITEM_RADIO) break;
+                    if (other->IsToggled()) previousRadio = other->GetId();
+                }
+                for (size_t j = i + 1; j < bar->GetToolsCount(); ++j)
+                {
+                    wxToolBarToolBase* other = bar->GetToolByPos(j);
+                    if (!other->IsButton() || other->GetKind() != wxITEM_RADIO) break;
+                    if (other->IsToggled()) previousRadio = other->GetId();
+                }
+                break;
+            }
+        }
+        g_object_ref(native);
+        bar->ToggleTool(id, active);
+        const bool allowed = !bar || bar->IsBeingDeleted() || Lookup(GTK_WIDGET(native)) != tool ||
+                             bar->OnLeftClick(id, active);
+        if (bar && !bar->IsBeingDeleted() && Lookup(GTK_WIDGET(native)) == tool && !allowed)
+        {
+            if (previousRadio != wxID_NONE) bar->ToggleTool(previousRadio, true);
+            else bar->ToggleTool(id, before);
+        }
+        g_object_unref(native);
+    }
+    static void Dropdown(GtkButton* native, wxToolBarTool*)
+    {
+        wxToolBarTool* tool = Lookup(GTK_WIDGET(native));
+        if (!tool || !tool->IsEnabled() || g_blockEventsOnDrag) return;
+        wxWeakRef<wxToolBarBase> bar(tool->GetToolBar());
+        if (!bar || bar->IsBeingDeleted()) return;
+        g_object_ref(native);
+        wxCommandEvent event(wxEVT_TOOL_DROPDOWN, tool->GetId());
+        event.SetEventObject(bar.get());
+        const bool handled = bar->HandleWindowEvent(event);
+        if (bar && !bar->IsBeingDeleted() && Lookup(GTK_WIDGET(native)) == tool && !handled)
+        {
+            wxMenu* menu = tool->GetDropdownMenu();
+            if (menu)
+            {
+                graphene_rect_t bounds;
+                if (gtk_widget_compute_bounds(GTK_WIDGET(native), bar->m_widget, &bounds))
+                {
+                    const bool vertical = bar->HasFlag(wxTB_LEFT | wxTB_RIGHT);
+                    bar->PopupMenu(menu, wxRound(bounds.origin.x + (vertical ? bounds.size.width : 0)),
+                                        wxRound(bounds.origin.y + (vertical ? 0 : bounds.size.height)));
+                }
+            }
+        }
+        g_object_unref(native);
+    }
+    static void Enter(GtkEventControllerMotion* controller, double, double, void*)
+    {
+        GtkWidget* item = gtk_event_controller_get_widget(GTK_EVENT_CONTROLLER(controller));
+        wxToolBarTool* tool = item ? Lookup(item) : NULL;
+        if (tool && !g_blockEventsOnDrag && tool->GetToolBar() &&
+            !tool->GetToolBar()->IsBeingDeleted()) tool->GetToolBar()->OnMouseEnter(tool->GetId());
+    }
+    static void Leave(GtkEventControllerMotion* controller, void*)
+    {
+        GtkWidget* item = gtk_event_controller_get_widget(GTK_EVENT_CONTROLLER(controller));
+        wxToolBarTool* tool = item ? Lookup(item) : NULL;
+        if (tool && !g_blockEventsOnDrag && tool->GetToolBar() &&
+            !tool->GetToolBar()->IsBeingDeleted()) tool->GetToolBar()->OnMouseEnter(wxID_NONE);
+    }
+    static void RightClick(GtkGestureClick* gesture, int, double x, double y, void*)
+    {
+        GtkWidget* item = gtk_event_controller_get_widget(GTK_EVENT_CONTROLLER(gesture));
+        wxToolBarTool* tool = item ? Lookup(item) : NULL;
+        if (!tool || g_blockEventsOnDrag || !tool->GetToolBar() ||
+            tool->GetToolBar()->IsBeingDeleted()) return;
+        gtk_gesture_set_state(GTK_GESTURE(gesture), GTK_EVENT_SEQUENCE_CLAIMED);
+        graphene_point_t input, output;
+        graphene_point_init(&input, float(x), float(y));
+        if (gtk_widget_compute_point(item, tool->GetToolBar()->m_widget, &input, &output))
+            tool->GetToolBar()->OnRightClick(tool->GetId(), wxRound(output.x), wxRound(output.y));
+    }
+};
+
+wxIMPLEMENT_DYNAMIC_CLASS(wxToolBar, wxControl);
+void wxToolBar::Init() { m_toolbar = NULL; }
+wxToolBar::~wxToolBar()
+{
+    // Mark deletion before native unparenting can change focus or hover.
+    // wxWindowGTK's later SendDestroyEvent call is deliberately idempotent.
+    SendDestroyEvent();
+    if (m_widget) GTKDisconnect(m_widget);
+    // wxToolBarBase deletes its tools next. Quiesce native callbacks first.
+    for (auto tool : m_tools) static_cast<wxToolBarTool*>(tool)->DetachNative();
+}
+bool wxToolBar::Create(wxWindow* parent, wxWindowID id, const wxPoint& pos,
+    const wxSize& size, long style, const wxString& name)
+{
+    if (!PreCreation(parent, pos, size) ||
+        !CreateBase(parent, id, pos, size, style, wxDefaultValidator, name)) return false;
+    FixupStyle();
+    m_widget = gtk_scrolled_window_new();
+    g_object_ref(m_widget);
+    m_toolbar = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 0);
+    gtk_widget_add_css_class(m_toolbar, "toolbar");
+    GtkWidget* viewport = gtk_viewport_new(NULL, NULL);
+    gtk_viewport_set_scroll_to_focus(GTK_VIEWPORT(viewport), TRUE);
+    gtk_viewport_set_child(GTK_VIEWPORT(viewport), m_toolbar);
+    gtk_scrolled_window_set_child(GTK_SCROLLED_WINDOW(m_widget), viewport);
+    gtk_scrolled_window_set_propagate_natural_width(GTK_SCROLLED_WINDOW(m_widget), TRUE);
+    gtk_scrolled_window_set_propagate_natural_height(GTK_SCROLLED_WINDOW(m_widget), TRUE);
+    GtkSetStyle();
+    parent->DoAddChild(this);
+    PostCreation(size);
+    return true;
+}
+void wxToolBar::AddChildGTK(wxWindowGTK* child)
+{
+    gtk_widget_set_valign(child->m_widget, GTK_ALIGN_CENTER);
+    gtk_widget_set_halign(child->m_widget, GTK_ALIGN_CENTER);
+    gtk_box_append(GTK_BOX(m_toolbar), child->m_widget);
+}
+void wxToolBar::GtkSetStyle()
+{
+    const bool vertical = HasFlag(wxTB_LEFT | wxTB_RIGHT);
+    gtk_orientable_set_orientation(GTK_ORIENTABLE(m_toolbar), vertical ? GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL);
+    gtk_scrolled_window_set_policy(GTK_SCROLLED_WINDOW(m_widget),
+        vertical ? GTK_POLICY_NEVER : GTK_POLICY_AUTOMATIC,
+        vertical ? GTK_POLICY_AUTOMATIC : GTK_POLICY_NEVER);
+    gtk_box_set_spacing(GTK_BOX(m_toolbar), wxMax(0, m_toolPacking));
+    gtk_widget_set_margin_start(m_toolbar, wxMax(0, m_xMargin));
+    gtk_widget_set_margin_end(m_toolbar, wxMax(0, m_xMargin));
+    gtk_widget_set_margin_top(m_toolbar, wxMax(0, m_yMargin));
+    gtk_widget_set_margin_bottom(m_toolbar, wxMax(0, m_yMargin));
+    for (auto item : m_tools)
+    {
+        wxToolBarTool* tool = static_cast<wxToolBarTool*>(item);
+        if (!tool->item) continue;
+        if (tool->IsButton())
+        {
+            gtk_orientable_set_orientation(GTK_ORIENTABLE(tool->content),
+                HasFlag(wxTB_HORZ_LAYOUT) ? GTK_ORIENTATION_HORIZONTAL : GTK_ORIENTATION_VERTICAL);
+            gtk_widget_set_visible(tool->image, !HasFlag(wxTB_NOICONS));
+            gtk_widget_set_visible(tool->labelWidget, HasFlag(wxTB_TEXT | wxTB_NOICONS));
+            if (HasFlag(wxTB_FLAT)) gtk_widget_add_css_class(tool->button, "flat");
+            else gtk_widget_remove_css_class(tool->button, "flat");
+            if (tool->arrow)
+            {
+                gtk_orientable_set_orientation(GTK_ORIENTABLE(tool->item),
+                    vertical ? GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL);
+                gtk_button_set_icon_name(GTK_BUTTON(tool->arrow), vertical ? "pan-end-symbolic" : "pan-down-symbolic");
+            }
+            tool->SetImage();
+        }
+        else if (tool->IsSeparator())
+        {
+            if (tool->IsStretchable())
+            {
+                gtk_widget_set_hexpand(tool->item, !vertical);
+                gtk_widget_set_vexpand(tool->item, vertical);
+            }
+            else
+            {
+                gtk_orientable_set_orientation(GTK_ORIENTABLE(tool->item),
+                    vertical ? GTK_ORIENTATION_HORIZONTAL : GTK_ORIENTATION_VERTICAL);
+                gtk_widget_set_size_request(tool->item, vertical ? -1 : m_toolSeparation,
+                                                        vertical ? m_toolSeparation : -1);
+            }
+        }
+        gtk_widget_set_tooltip_text(tool->item,
+            HasFlag(wxTB_NO_TOOLTIPS) || tool->GetShortHelp().empty() ? NULL : tool->GetShortHelp().utf8_str().data());
+    }
+    InvalidateBestSize();
+}
+void wxToolBar::SetWindowStyleFlag(long style)
+{
+    wxToolBarBase::SetWindowStyleFlag(style);
+    if (m_toolbar)
+    {
+        AdjustToolBitmapSize();
+        GtkSetStyle();
+    }
+}
+void wxToolBar::GTKRegroupTools(wxToolBarToolBase* inserted, size_t pos, wxToolBarToolBase* excluded)
+{
+    std::vector<wxToolBarToolBase*> tools;
+    for (size_t i = 0; i <= GetToolsCount(); ++i)
+    {
+        if (i == pos && inserted) tools.push_back(inserted);
+        if (i < GetToolsCount() && GetToolByPos(i) != inserted && GetToolByPos(i) != excluded)
+            tools.push_back(GetToolByPos(i));
+    }
+    wxToolBarToolBase* first = NULL;
+    bool selected = false;
+    for (size_t i = 0; i <= tools.size(); ++i)
+    {
+        wxToolBarToolBase* tool = i < tools.size() ? tools[i] : NULL;
+        if (!tool || !tool->IsButton() || tool->GetKind() != wxITEM_RADIO)
+        {
+            if (first && !selected) { first->Toggle(true); DoToggleTool(first, true); }
+            first = NULL; selected = false;
+            continue;
+        }
+        if (!first) first = tool;
+        if (tool->IsToggled())
+        {
+            if (selected) { tool->Toggle(false); DoToggleTool(tool, false); }
+            else selected = true;
+        }
+    }
+}
+bool wxToolBar::Realize()
+{
+    if (!wxToolBarBase::Realize()) return false;
+    GTKRegroupTools();
+    GtkSetStyle();
+    // Disabling a focused native control can synchronously run wx focus
+    // handlers. They may remove tools or destroy the whole toolbar.
+    wxWeakRef<wxToolBar> self(this);
+    std::vector<std::pair<int, wxToolBarToolBase*> > tools;
+    for (auto tool : m_tools) tools.push_back(std::make_pair(tool->GetId(), tool));
+    for (const auto& entry : tools)
+    {
+        wxToolBarToolBase* tool = FindById(entry.first);
+        if (tool != entry.second) continue;
+        DoEnableTool(tool, tool->IsEnabled());
+        if (!self || self->IsBeingDeleted()) return false;
+        if (FindById(entry.first) == tool && tool->CanBeToggled())
+            DoToggleTool(tool, tool->IsToggled());
+        if (!self || self->IsBeingDeleted()) return false;
+    }
+    return true;
+}
