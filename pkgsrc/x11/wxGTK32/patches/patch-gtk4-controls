+GObject* wxGtkGetButtonMotionController(GtkWidget* button)
+{
+    const char* key = "wx-motion-controller";
+    GObject* controller = static_cast<GObject*>(g_object_get_data(G_OBJECT(button), key));
+    if (!controller)
+    {
+        controller = G_OBJECT(gtk_event_controller_motion_new());
+        gtk_widget_add_controller(button, GTK_EVENT_CONTROLLER(controller));
+        g_object_set_data(G_OBJECT(button), key, controller);
+    }
+    return controller;
+}
+
+GObject* wxGtkGetButtonPressController(GtkWidget* button)
+{
+    const char* key = "wx-press-controller";
+    GObject* controller = static_cast<GObject*>(g_object_get_data(G_OBJECT(button), key));
+    if (!controller)
+    {
+        GtkGesture* gesture = gtk_gesture_click_new();
+        gtk_gesture_single_set_exclusive(GTK_GESTURE_SINGLE(gesture), FALSE);
+        gtk_gesture_single_set_button(GTK_GESTURE_SINGLE(gesture), GDK_BUTTON_PRIMARY);
+        controller = G_OBJECT(gesture);
+        gtk_event_controller_set_propagation_phase(
+            GTK_EVENT_CONTROLLER(controller), GTK_PHASE_CAPTURE);
+        gtk_widget_add_controller(button, GTK_EVENT_CONTROLLER(controller));
+        g_object_set_data(G_OBJECT(button), key, controller);
+    }
+    return controller;
+}
+
+GtkWidget* wxGtkGetButtonImage(GtkWidget* button)
+{
+    GtkWidget* child = gtk_button_get_child(GTK_BUTTON(button));
+    if (child && WX_GTK_IS_IMAGE(child))
+        return child;
+
+    for (GtkWidget* part = child ? gtk_widget_get_first_child(child) : NULL;
+         part; part = gtk_widget_get_next_sibling(part))
+    {
+        if (WX_GTK_IS_IMAGE(part))
+            return part;
+    }
+    return NULL;
+}
+
+GtkWidget* wxGtkGetButtonLabel(GtkWidget* button)
+{
+    GtkWidget* child = gtk_button_get_child(GTK_BUTTON(button));
+    if (child && GTK_IS_LABEL(child))
+        return child;
+
+    for (GtkWidget* part = child ? gtk_widget_get_first_child(child) : NULL;
+         part; part = gtk_widget_get_next_sibling(part))
+    {
+        if (GTK_IS_LABEL(part))
+            return part;
+    }
+    return NULL;
+}
+
+void wxGtkSetButtonBitmapContent(GtkWidget* button, GtkWidget* image,
+                                 wxDirection direction)
+{
+    GtkWidget* label = wxGtkGetButtonLabel(button);
+
+    GtkOrientation orientation = direction == wxTOP || direction == wxBOTTOM
+        ? GTK_ORIENTATION_VERTICAL : GTK_ORIENTATION_HORIZONTAL;
+    GtkWidget* box = gtk_box_new(orientation, 4);
+    g_object_ref(image);
+    if (label)
+        g_object_ref(label);
+    gtk_button_set_child(GTK_BUTTON(button), NULL);
+
+    if (direction == wxRIGHT || direction == wxBOTTOM)
+    {
+        if (label) gtk_box_append(GTK_BOX(box), label);
+        gtk_box_append(GTK_BOX(box), image);
+    }
+    else
+    {
+        gtk_box_append(GTK_BOX(box), image);
+        if (label) gtk_box_append(GTK_BOX(box), label);
+    }
+    if (label)
+        g_object_unref(label);
+    gtk_button_set_child(GTK_BUTTON(button), box);
+    g_object_unref(image);
+}
+
+void wxGtkRemoveButtonBitmap(GtkWidget* button, GtkWidget* image)
+{
+    GtkWidget* child = gtk_button_get_child(GTK_BUTTON(button));
+    if (child == image)
+    {
+        gtk_button_set_child(GTK_BUTTON(button), NULL);
+        return;
+    }
+
+    GtkWidget* label = wxGtkGetButtonLabel(button);
+    if (label)
+        g_object_ref(label);
+    gtk_button_set_child(GTK_BUTTON(button), NULL);
+    gtk_button_set_child(GTK_BUTTON(button), label);
+    if (label)
+        g_object_unref(label);
+}
+}
