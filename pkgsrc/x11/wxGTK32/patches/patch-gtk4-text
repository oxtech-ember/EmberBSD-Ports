+#ifdef __WXGTK4__
+// GtkText already emits one changed signal per native edit. GtkTextBuffer
+// exposes the corresponding begin/end-user-action boundary explicitly.
+class wxTextCoalesceData
+{
+public:
+    wxTextCoalesceData(wxTextEntry* entry, GtkTextBuffer* buffer)
+        : m_entry(entry), m_buffer(GTK_TEXT_BUFFER(g_object_ref(buffer))),
+          m_depth(0), m_pending(false)
+    {
+        g_signal_connect(buffer, "begin-user-action", G_CALLBACK(Begin), this);
+        g_signal_connect_after(buffer, "end-user-action", G_CALLBACK(End), this);
+    }
+    ~wxTextCoalesceData()
+    {
+        g_signal_handlers_disconnect_by_data(m_buffer, this);
+        g_object_unref(m_buffer);
+    }
+    bool SetPendingIfInKeyPress()
+    {
+        if (!m_depth) return false;
+        m_pending = true;
+        return true;
+    }
+private:
+    static void Begin(GtkTextBuffer*, wxTextCoalesceData* self) { ++self->m_depth; }
+    static void End(GtkTextBuffer*, wxTextCoalesceData* self)
+    {
+        if (--self->m_depth == 0 && self->m_pending)
+        {
+            self->m_pending = false;
+            // The event handler can destroy the entry and this helper.
+            self->m_entry->GTKOnTextChanged();
+        }
+    }
+    wxTextEntry* m_entry;
+    GtkTextBuffer* m_buffer;
+    unsigned m_depth;
+    bool m_pending;
+};
