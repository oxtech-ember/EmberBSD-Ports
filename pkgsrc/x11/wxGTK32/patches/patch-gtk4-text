+///////////////////////////////////////////////////////////////////////////////
+// GTK4 spell checking for wxTextCtrl, using the shared libspelling adapter.
+// Origin: EmberBSD (AI-assisted). Licence: wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#ifndef _WX_GTK_PRIVATE_SPELLING_H_
+#define _WX_GTK_PRIVATE_SPELLING_H_
+
+#include <libspelling.h>
+#include "wx/weakref.h"
+
+// GtkEntry has no libspelling adapter. Mirror its short text in a GtkSourceBuffer
+// and reuse the same checker, word boundaries, corrections and async engine as
+// the multiline control. Character offsets belong to GTK; Pango uses bytes.
+class wxGtkSpelling
+{
+public:
+    wxGtkSpelling(wxTextCtrl* owner, GtkWidget* widget, GtkTextBuffer* buffer)
+        : m_owner(owner), m_widget(widget), m_single(GTK_IS_ENTRY(widget)), m_syncing(false),
+          m_actionDepth(0), m_highlightIdle(0), m_attributes(NULL), m_oldMenu(NULL)
+    {
+        m_buffer = buffer ? GTK_TEXT_BUFFER(g_object_ref(buffer))
+                          : GTK_TEXT_BUFFER(gtk_source_buffer_new(NULL));
+        SpellingChecker* checker = spelling_checker_new(spelling_provider_get_default(), NULL);
+        m_adapter = spelling_text_buffer_adapter_new(GTK_SOURCE_BUFFER(m_buffer), checker);
+        g_object_unref(checker);
+        gtk_widget_insert_action_group(widget, "spelling", G_ACTION_GROUP(m_adapter));
+        if (m_single)
+        {
+            PangoAttrList* attrs = gtk_entry_get_attributes(GTK_ENTRY(widget));
+            if (attrs) m_attributes = pango_attr_list_copy(attrs);
+            m_oldMenu = gtk_entry_get_extra_menu(GTK_ENTRY(widget));
+            g_signal_connect(widget, "changed", G_CALLBACK(EntryChanged), this);
+            g_signal_connect(widget, "notify::cursor-position", G_CALLBACK(CursorChanged), this);
+            g_signal_connect(widget, "notify::selection-bound", G_CALLBACK(CursorChanged), this);
+            g_signal_connect(m_buffer, "changed", G_CALLBACK(BufferChanged), this);
+            g_signal_connect(m_buffer, "begin-user-action", G_CALLBACK(BeginAction), this);
+            g_signal_connect(m_buffer, "end-user-action", G_CALLBACK(EndAction), this);
+            g_signal_connect_after(m_buffer, "apply-tag", G_CALLBACK(TagsChanged), this);
+            g_signal_connect_after(m_buffer, "remove-tag", G_CALLBACK(TagsChanged), this);
+            SyncEntry();
+        }
+        else
+            m_oldMenu = gtk_text_view_get_extra_menu(GTK_TEXT_VIEW(widget));
+        if (m_oldMenu) g_object_ref(m_oldMenu);
+        m_menu = g_menu_new();
+        if (m_oldMenu) g_menu_append_section(m_menu, NULL, m_oldMenu);
+        g_menu_append_section(m_menu, NULL, spelling_text_buffer_adapter_get_menu_model(m_adapter));
+        // update_corrections follows the insertion mark for both native and
+        // mirrored buffers, including keyboard-invoked context menus.
+        g_signal_connect_after(m_buffer, "mark-set", G_CALLBACK(MarkSet), this);
+    }
+
+    ~wxGtkSpelling()
+    {
+        if (m_highlightIdle) g_source_remove(m_highlightIdle);
+        g_signal_handlers_disconnect_by_data(m_buffer, this);
+        g_object_unref(m_adapter);
+        g_object_unref(m_buffer);
+        g_object_unref(m_menu);
+        if (m_oldMenu) g_object_unref(m_oldMenu);
+        if (m_attributes) pango_attr_list_unref(m_attributes);
+    }
+
+    void Configure(const wxTextProofOptions& options)
+    {
+        if (!options.GetLang().empty())
+            spelling_text_buffer_adapter_set_language(m_adapter, options.GetLang().utf8_str());
+        const bool enabled = options.IsSpellCheckEnabled();
+        spelling_text_buffer_adapter_set_enabled(m_adapter, enabled);
+        spelling_text_buffer_adapter_update_corrections(m_adapter);
+        GMenuModel* menu = enabled ? G_MENU_MODEL(m_menu) : m_oldMenu;
+        if (m_single)
+        {
+            gtk_entry_set_extra_menu(GTK_ENTRY(m_widget), menu);
+            Highlight();
+        }
+        else
+            gtk_text_view_set_extra_menu(GTK_TEXT_VIEW(m_widget), menu);
+    }
+
+    wxTextProofOptions GetOptions() const
+    {
+        wxTextProofOptions options = wxTextProofOptions::Disable();
+        options.SpellCheck(spelling_text_buffer_adapter_get_enabled(m_adapter));
+        const char* language = spelling_text_buffer_adapter_get_language(m_adapter);
+        if (language) options.Language(wxString::FromUTF8(language));
+        return options;
+    }
+
+    static void Delete(gpointer self) { delete static_cast<wxGtkSpelling*>(self); }
+
+private:
+    static void EntryChanged(GtkEditable*, wxGtkSpelling* self) { self->SyncEntry(); }
+    static void CursorChanged(GObject*, GParamSpec*, wxGtkSpelling* self) { self->SyncCursor(); }
+    static void BufferChanged(GtkTextBuffer*, wxGtkSpelling* self)
+        { if (!self->m_actionDepth) self->SyncBuffer(); }
+    static void BeginAction(GtkTextBuffer*, wxGtkSpelling* self) { ++self->m_actionDepth; }
+    static void EndAction(GtkTextBuffer*, wxGtkSpelling* self)
+        { if (--self->m_actionDepth == 0) self->SyncBuffer(); }
+    static void MarkSet(GtkTextBuffer*, const GtkTextIter*, GtkTextMark*, wxGtkSpelling* self)
+        { spelling_text_buffer_adapter_update_corrections(self->m_adapter); }
+    static void TagsChanged(GtkTextBuffer*, GtkTextTag*, const GtkTextIter*, const GtkTextIter*, wxGtkSpelling* self)
