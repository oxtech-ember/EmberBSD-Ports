+        if (!self->m_highlightIdle)
+            self->m_highlightIdle = g_idle_add(HighlightIdle, self);
+    }
+    static gboolean HighlightIdle(gpointer data)
+    {
+        wxGtkSpelling* self = static_cast<wxGtkSpelling*>(data);
+        self->m_highlightIdle = 0;
+        self->Highlight();
+        return G_SOURCE_REMOVE;
+    }
+
+    void SyncEntry()
+    {
+        if (m_syncing) return;
+        m_syncing = true;
+        gtk_text_buffer_set_text(m_buffer, gtk_editable_get_text(GTK_EDITABLE(m_widget)), -1);
+        m_syncing = false;
+        SyncCursor();
+    }
+    void SyncCursor()
+    {
+        if (m_syncing) return;
+        GtkEditable* entry = GTK_EDITABLE(m_widget);
+        const int pos = gtk_editable_get_position(entry);
+        int from = pos, to = pos;
+        gtk_editable_get_selection_bounds(entry, &from, &to);
+        const int bound = pos == from ? to : from;
+        GtkTextIter insert, selection;
+        gtk_text_buffer_get_iter_at_offset(m_buffer, &insert, pos);
+        gtk_text_buffer_get_iter_at_offset(m_buffer, &selection, bound);
+        gtk_text_buffer_select_range(m_buffer, &insert, &selection);
+        spelling_text_buffer_adapter_update_corrections(m_adapter);
+    }
+    void SyncBuffer()
+    {
+        if (m_syncing) return;
+        m_syncing = true;
+        GtkTextIter first, last, insert;
+        gtk_text_buffer_get_bounds(m_buffer, &first, &last);
+        gchar* text = gtk_text_buffer_get_text(m_buffer, &first, &last, TRUE);
+        wxWeakRef<wxTextCtrl> owner(m_owner);
+        if (!owner) { g_free(text); m_syncing = false; return; }
+        owner->SetValue(wxString::FromUTF8(text));
+        g_free(text);
+        if (!owner) return; // a wxEVT_TEXT handler may destroy the control
+        owner->MarkDirty();
+        gtk_text_buffer_get_iter_at_mark(m_buffer, &insert, gtk_text_buffer_get_insert(m_buffer));
+        gtk_editable_set_position(GTK_EDITABLE(m_widget), gtk_text_iter_get_offset(&insert));
+        m_syncing = false;
+        SyncEntry(); // reflect max-length/uppercase constraints of the entry
+    }
+    void Highlight()
+    {
+        PangoAttrList* attributes = m_attributes ? pango_attr_list_copy(m_attributes) : pango_attr_list_new();
+        if (spelling_text_buffer_adapter_get_enabled(m_adapter))
+        {
+            GtkTextTag* tag = spelling_text_buffer_adapter_get_tag(m_adapter);
+            GtkTextIter iter, end;
+            gtk_text_buffer_get_bounds(m_buffer, &iter, &end);
+            const char* text = gtk_editable_get_text(GTK_EDITABLE(m_widget));
+            while (!gtk_text_iter_is_end(&iter))
+            {
+                if (!gtk_text_iter_has_tag(&iter, tag))
+                {
+                    if (!gtk_text_iter_forward_to_tag_toggle(&iter, tag)) break;
+                    continue;
+                }
+                const int start = gtk_text_iter_get_offset(&iter);
+                if (!gtk_text_iter_forward_to_tag_toggle(&iter, tag)) iter = end;
+                const int stop = gtk_text_iter_get_offset(&iter);
+                PangoAttribute* underline = pango_attr_underline_new(PANGO_UNDERLINE_ERROR);
+                underline->start_index = g_utf8_offset_to_pointer(text, start) - text;
+                underline->end_index = g_utf8_offset_to_pointer(text, stop) - text;
+                pango_attr_list_insert(attributes, underline);
+            }
+        }
+        gtk_entry_set_attributes(GTK_ENTRY(m_widget), attributes);
+        pango_attr_list_unref(attributes);
+    }
+
+    wxWeakRef<wxTextCtrl> m_owner;
+    GtkWidget* m_widget;
+    GtkTextBuffer* m_buffer;
+    SpellingTextBufferAdapter* m_adapter;
+    bool m_single;
+    bool m_syncing;
+    int m_actionDepth;
+    guint m_highlightIdle;
+    PangoAttrList* m_attributes;
+    GMenuModel* m_oldMenu;
+    GMenu* m_menu;
+};
+#endif
