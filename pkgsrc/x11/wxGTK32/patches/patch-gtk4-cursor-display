+static void wxGtkDialogResponse(GtkDialog*, gint response, gpointer data)
+{
+    wxGtkDialogRunState* const state = static_cast<wxGtkDialogRunState*>(data);
+    state->response = response;
+    state->done = true;
+    if (g_main_loop_is_running(state->loop))
+        g_main_loop_quit(state->loop);
