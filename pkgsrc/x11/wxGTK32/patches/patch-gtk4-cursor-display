+
+static gint wxGtkDialogRun(GtkDialog* dialog)
+{
+    wxGtkDialogRunState state = { g_main_loop_new(NULL, FALSE), GTK_RESPONSE_NONE, false };
+    const gulong handler = g_signal_connect(dialog, "response",
+        G_CALLBACK(wxGtkDialogResponse), &state);
+    gtk_window_set_modal(GTK_WINDOW(dialog), TRUE);
+    gtk_window_present(GTK_WINDOW(dialog));
+    if (!state.done)
+        g_main_loop_run(state.loop);
+    g_signal_handler_disconnect(dialog, handler);
+    g_main_loop_unref(state.loop);
+    return state.response;
