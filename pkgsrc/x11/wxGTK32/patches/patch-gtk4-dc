+#ifdef __WXGTK4__
+GdkTexture* wxBitmap::GetTexture() const
+{
+    wxCHECK_MSG(IsOk(), NULL, "invalid bitmap");
+
+    wxBitmapRefData* bmpData = M_BMPDATA;
+    const bool mutablePixels = bmpData->m_surface != NULL || bmpData->m_pixbufExposed;
+    if (!mutablePixels && bmpData->m_texture)
+        return bmpData->m_texture;
+
+    GdkPixbuf* pixbuf;
+    if (mutablePixels)
+    {
+        // A MemoryDC can keep writing to its surface, and callers can retain
+        // writable pixbuf pointers. Re-copy current pixels for every
+        // snapshot instead of keeping a texture from an earlier draw.
+        wxBitmapInvalidateTexture(bmpData);
+        if (bmpData->m_surface)
+        {
+            cairo_surface_flush(bmpData->m_surface);
+            if (bmpData->m_pixbufNoMask)
+            {
+                g_object_unref(bmpData->m_pixbufNoMask);
+                bmpData->m_pixbufNoMask = NULL;
+            }
+            if (bmpData->m_pixbufMask)
+            {
+                g_object_unref(bmpData->m_pixbufMask);
+                bmpData->m_pixbufMask = NULL;
+            }
+        }
+        bmpData->m_textureRead = true;
+        pixbuf = GetPixbuf();
+        bmpData->m_textureRead = false;
+    }
+    else
+    {
+        bmpData->m_textureRead = true;
+        pixbuf = GetPixbuf();
+        bmpData->m_textureRead = false;
+    }
+    if (!pixbuf || gdk_pixbuf_get_colorspace(pixbuf) != GDK_COLORSPACE_RGB ||
+        gdk_pixbuf_get_bits_per_sample(pixbuf) != 8)
+    {
+        return NULL;
+    }
+
+    const int channels = gdk_pixbuf_get_n_channels(pixbuf);
+    if (channels != 3 && channels != 4)
+    {
+        return NULL;
+    }
+
+    const gsize length = gdk_pixbuf_get_byte_length(pixbuf);
+    // GdkMemoryTexture may outlive this bitmap generation in retained render
+    // nodes, so its backing pixels must not alias mutable wxBitmap storage.
+    GBytes* bytes = g_bytes_new(gdk_pixbuf_read_pixels(pixbuf), length);
+    const GdkMemoryFormat format = channels == 4
+        ? GDK_MEMORY_R8G8B8A8
+        : GDK_MEMORY_R8G8B8;
+    bmpData->m_texture = gdk_memory_texture_new(
+        gdk_pixbuf_get_width(pixbuf), gdk_pixbuf_get_height(pixbuf),
+        format, bytes, gdk_pixbuf_get_rowstride(pixbuf));
+    g_bytes_unref(bytes);
+    return bmpData->m_texture;
+}
+
+unsigned long wxBitmap::GetTextureGeneration() const
+{
+    wxCHECK_MSG(IsOk(), 0, "invalid bitmap");
+    return M_BMPDATA->m_textureGeneration;
+}
+
+bool wxBitmap::HasMutablePixels() const
+{
+    wxCHECK_MSG(IsOk(), false, "invalid bitmap");
+    const wxBitmapRefData* const bmpData = M_BMPDATA;
+    return bmpData->m_surface != NULL || bmpData->m_pixbufExposed;
+}
