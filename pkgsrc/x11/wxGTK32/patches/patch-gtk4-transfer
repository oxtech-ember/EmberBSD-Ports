+///////////////////////////////////////////////////////////////////////////////
+// Shared GTK4 clipboard/DnD MIME transport.
+// Origin: EmberBSD (AI-assisted). wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#ifndef WX_GTK_PRIVATE_TRANSFER4_H
+#define WX_GTK_PRIVATE_TRANSFER4_H
+#include "wx/dataobj.h"
+#include "wx/evtloop.h"
+#include "wx/gtk/private/object.h"
+#include <gtk/gtk.h>
+#include <memory>
+#include <vector>
+#include <set>
+#include <string>
+#include <limits>
+
+namespace wxGTKTransfer
+{
+inline bool IsText(const wxDataFormat& format)
+{ return format.GetType() == wxDF_TEXT || format.GetType() == wxDF_UNICODETEXT; }
+
+inline std::vector<wxDataFormat> Formats(wxDataObject& data, wxDataObject::Direction direction)
+{
+    std::vector<wxDataFormat> result;
+    const size_t count = data.GetFormatCount(direction);
+    if (!count) return result;
+    result.push_back(data.GetPreferredFormat(direction));
+    std::vector<wxDataFormat> all(count);
+    data.GetAllFormats(all.data(), direction);
+    for (const auto& format : all)
+        if (format != result.front()) result.push_back(format);
+    return result;
+}
+
+class Providers
+{
+public:
+    Providers() = default;
+    Providers(const Providers&) = delete;
+    Providers& operator=(const Providers&) = delete;
+    std::vector<GdkContentProvider*> values;
+    ~Providers() { for (auto value : values) g_object_unref(value); }
+    GdkContentProvider* Union()
+    {
+        if (values.empty()) return NULL;
+        // GDK copies the pointer array and takes ownership of each provider.
+        GdkContentProvider* result = gdk_content_provider_new_union(values.data(), values.size());
+        values.clear();
+        return result;
+    }
+};
+
+inline GdkContentProvider* Snapshot(wxDataObject& data)
+{
+    Providers providers;
+    std::set<std::string> supplied;
+    for (const auto& format : Formats(data, wxDataObject::Get))
+    {
+        const char* mime = format.GetFormatId();
+        if (!mime || !*mime) continue;
+        if (IsText(format) && supplied.count("text/plain;charset=utf-8")) continue;
+        if (!IsText(format) && supplied.count(mime)) continue;
+        const size_t size = data.GetDataSize(format);
+        if (size == std::numeric_limits<size_t>::max()) continue;
+        // Some wx data objects write a terminator; retain room even for empty data.
+        std::vector<unsigned char> buffer(size + 1, 0);
+        if (!data.GetDataHere(format, buffer.data())) continue;
+        const void* bytes = buffer.data();
+        size_t length = size;
+        wxScopedCharBuffer converted;
+        if (format.GetType() == wxDF_TEXT)
+        {
+            const wxString text(reinterpret_cast<const char*>(bytes), wxConvLocal, length);
+            converted = text.utf8_str();
+            if (!converted && length) continue;
+            bytes = converted.data(); length = converted.length();
+        }
+        if (IsText(format) || format.GetType() == wxDF_FILENAME)
+            while (length && static_cast<const char*>(bytes)[length - 1] == '\0') --length;
+        GBytes* content = g_bytes_new(bytes, length);
+        if (IsText(format))
+        {
+            providers.values.push_back(gdk_content_provider_new_for_bytes("text/plain;charset=utf-8", content));
+            providers.values.push_back(gdk_content_provider_new_for_bytes("text/plain", content));
+            supplied.insert("text/plain;charset=utf-8"); supplied.insert("text/plain");
+        }
+        else
+        {
+            providers.values.push_back(gdk_content_provider_new_for_bytes(mime, content));
+            supplied.insert(mime);
+        }
+        g_bytes_unref(content);
+    }
+    return providers.Union();
+}
+
+inline const char* Match(GdkContentFormats* available, const wxDataFormat& wanted)
+{
+    // Native GTypes (e.g. G_TYPE_STRING/GDK_TYPE_TEXTURE) also expose their
+    // standard MIME serializations through GDK's registered serializers.
+    GdkContentFormats* formats = gdk_content_formats_union_serialize_mime_types(gdk_content_formats_ref(available));
+    const char* result = NULL;
+    if (IsText(wanted))
+    {
+        if (gdk_content_formats_contain_mime_type(formats, "text/plain;charset=utf-8"))
+            result = "text/plain;charset=utf-8";
+        else if (gdk_content_formats_contain_mime_type(formats, "text/plain"))
+            result = "text/plain";
+    }
+    else if (wanted.GetFormatId() && gdk_content_formats_contain_mime_type(formats, wanted.GetFormatId()))
+        result = wanted.GetFormatId();
+    gdk_content_formats_unref(formats);
+    return result;
+}
+
+struct Operation
+{
+    wxGtkObject<GCancellable> cancel;
+    wxGtkObject<GInputStream> input;
+    wxGtkObject<GOutputStream> output;
+    GBytes* bytes = NULL;
+    bool done = false, success = false;
+    Operation() : cancel(g_cancellable_new()) {}
+    Operation(const Operation&) = delete;
+    Operation& operator=(const Operation&) = delete;
+    ~Operation() { if (bytes) g_bytes_unref(bytes); }
+};
+typedef std::shared_ptr<Operation> Pending;
+inline Pending Take(void* data)
+{
+    std::unique_ptr<Pending> holder(static_cast<Pending*>(data));
+    return *holder;
+}
+inline void Spliced(GObject* source, GAsyncResult* result, void* data)
+{
+    Pending pending = Take(data);
+    GError* error = NULL;
+    pending->success = g_output_stream_splice_finish(G_OUTPUT_STREAM(source), result, &error) >= 0;
+    if (pending->success)
+        pending->bytes = g_memory_output_stream_steal_as_bytes(G_MEMORY_OUTPUT_STREAM(source));
+    g_clear_error(&error);
+    pending->done = true;
+}
+inline void ReadReady(GObject* source, GAsyncResult* result, void* data)
+{
+    Pending pending = Take(data);
+    GError* error = NULL;
+    const char* mime = NULL;
+    pending->input = GDK_IS_CLIPBOARD(source)
+        ? gdk_clipboard_read_finish(GDK_CLIPBOARD(source), result, &mime, &error)
+        : gdk_drop_read_finish(GDK_DROP(source), result, &mime, &error);
+    g_clear_error(&error);
+    if (!pending->input.get()) { pending->done = true; return; }
+    pending->output = g_memory_output_stream_new_resizable();
+    g_output_stream_splice_async(pending->output, pending->input,
+        GOutputStreamSpliceFlags(G_OUTPUT_STREAM_SPLICE_CLOSE_SOURCE | G_OUTPUT_STREAM_SPLICE_CLOSE_TARGET),
+        G_PRIORITY_DEFAULT, pending->cancel, Spliced, new Pending(pending));
+}
+inline Pending Read(GObject* source, const char* mime)
+{
+    Pending pending(new Operation);
+    const char* types[] = { mime, NULL };
+    if (GDK_IS_CLIPBOARD(source))
+        gdk_clipboard_read_async(GDK_CLIPBOARD(source), types, G_PRIORITY_DEFAULT,
+            pending->cancel, ReadReady, new Pending(pending));
+    else
+        gdk_drop_read_async(GDK_DROP(source), types, G_PRIORITY_DEFAULT,
+            pending->cancel, ReadReady, new Pending(pending));
+    return pending;
+}
+inline void Stored(GObject* source, GAsyncResult* result, void* data)
+{
+    Pending pending = Take(data);
+    GError* error = NULL;
+    pending->success = gdk_clipboard_store_finish(GDK_CLIPBOARD(source), result, &error);
+    g_clear_error(&error);
+    pending->done = true;
+}
+inline Pending Store(GdkClipboard* clipboard)
+{
+    Pending pending(new Operation);
+    gdk_clipboard_store_async(clipboard, G_PRIORITY_DEFAULT, pending->cancel, Stored, new Pending(pending));
+    return pending;
+}
+inline bool Wait(const Pending& pending)
+{
+    struct CancelOnExit
+    {
+        GCancellable* cancel;
+        ~CancelOnExit() { g_cancellable_cancel(cancel); }
+    } cancel = { pending->cancel.get() };
+    wxEventLoopGuarantor ensureLoop;
+    wxEventLoopBase* loop = wxEventLoopBase::GetActive();
+    while (!pending->done && !g_cancellable_is_cancelled(pending->cancel))
+        if (!loop || loop->DispatchTimeout(50) == 0) break;
+    return pending->done && pending->success;
+}
+inline bool Receive(wxDataObject& object, const wxDataFormat& format, GBytes* bytes)
+{
+    gsize length = 0;
+    const char* content = static_cast<const char*>(g_bytes_get_data(bytes, &length));
+    wxScopedCharBuffer converted;
+    if (IsText(format))
+    {
+        if (length && !g_utf8_validate(content, length, NULL)) return false;
+        if (format.GetType() == wxDF_TEXT)
+        {
+            converted = wxString::FromUTF8(content ? content : "", length).mb_str(wxConvLocal);
+            if (!converted && length) return false;
+            content = converted.data(); length = converted.length();
+        }
+    }
+    if (length == std::numeric_limits<size_t>::max()) return false;
+    std::vector<char> terminated(length + 1, 0);
+    if (length) memcpy(terminated.data(), content, length);
+    return object.SetData(format, length, terminated.data());
+}
+
+// Owner destruction cancels requests without invalidating callback storage.
+class Requests
+{
+public:
+    Requests() = default;
+    Requests(const Requests&) = delete;
+    Requests& operator=(const Requests&) = delete;
+    std::vector<std::weak_ptr<Operation> > pending;
+    ~Requests() { Cancel(); }
+    void Add(const Pending& request)
+    {
+        for (auto i = pending.begin(); i != pending.end(); )
+            if (i->expired()) i = pending.erase(i); else ++i;
+        pending.push_back(request);
+    }
+    void Cancel()
+    {
+        // GCancellable emits synchronously. A provider's cancellation handler
+        // may reenter owner teardown, so detach the list before notifying it.
+        std::vector<std::weak_ptr<Operation> > active;
+        active.swap(pending);
+        for (const auto& weak : active)
+            if (Pending request = weak.lock()) g_cancellable_cancel(request->cancel);
+    }
+};
+}
