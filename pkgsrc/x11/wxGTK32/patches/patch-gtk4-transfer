+///////////////////////////////////////////////////////////////////////////////
+// GTK4 clipboard transport. Origin: EmberBSD (AI-assisted). wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#if wxUSE_CLIPBOARD
+#include "wx/clipbrd.h"
+#include "wx/gtk/private/transfer4.h"
+
+struct wxGTKClipboardData
+{
+    GdkClipboard* clipboard[2] = { NULL, NULL };
+    GdkContentProvider* owned[2] = { NULL, NULL };
+    bool stored[2] = { false, false };
+    bool alive = true;
+    wxGTKTransfer::Requests requests;
+    wxGTKClipboardData()
+    {
+        GdkDisplay* display = gdk_display_get_default();
+        if (!display) return;
+        clipboard[wxClipboard::Primary] = GDK_CLIPBOARD(g_object_ref(gdk_display_get_primary_clipboard(display)));
+        clipboard[wxClipboard::Clipboard] = GDK_CLIPBOARD(g_object_ref(gdk_display_get_clipboard(display)));
+        for (auto item : clipboard) g_signal_connect(item, "changed", G_CALLBACK(Changed), this);
+    }
+    ~wxGTKClipboardData()
+    {
+        for (int i = 0; i < 2; ++i)
+        {
+            if (clipboard[i]) g_signal_handlers_disconnect_by_data(clipboard[i], this);
+            g_clear_object(&owned[i]);
+            g_clear_object(&clipboard[i]);
+        }
+    }
+    static void Changed(GdkClipboard* clipboard, wxGTKClipboardData* state)
+    {
+        for (int i = 0; i < 2; ++i)
+            if (state->clipboard[i] == clipboard && state->owned[i] != gdk_clipboard_get_content(clipboard))
+            { g_clear_object(&state->owned[i]); state->stored[i] = false; }
+    }
+    void Clear(int kind)
+    {
+        GdkContentProvider* old = owned[kind];
+        owned[kind] = NULL;
+        stored[kind] = false;
+        if (old && clipboard[kind] && gdk_clipboard_get_content(clipboard[kind]) == old)
+            gdk_clipboard_set_content(clipboard[kind], NULL);
+        if (old) g_object_unref(old);
+    }
+};
+
+wxIMPLEMENT_DYNAMIC_CLASS(wxClipboard, wxClipboardBase);
+wxClipboard::wxClipboard() : m_gtk4(new wxGTKClipboardData), m_open(false) {}
+wxClipboard::~wxClipboard()
+{
+    auto state = m_gtk4;
+    state->alive = false;
+    state->requests.Cancel();
+    for (int i = 0; i < 2; ++i)
+        if (!state->stored[i]) state->Clear(i);
+}
+bool wxClipboard::Open()
+{
+    wxCHECK_MSG(!m_open, false, "clipboard already open");
+    m_open = m_gtk4->clipboard[m_usePrimary ? Primary : Clipboard] != NULL;
+    return m_open;
+}
+void wxClipboard::Close()
+{
+    wxCHECK_RET(m_open, "clipboard not open");
+    m_open = false;
+}
+bool wxClipboard::IsOpened() const { return m_open; }
+bool wxClipboard::SetData(wxDataObject* data) { return GTKSetData(data, false); }
+bool wxClipboard::AddData(wxDataObject* data) { return GTKSetData(data, true); }
+bool wxClipboard::GTKSetData(wxDataObject* data, bool append)
+{
+    wxCHECK_MSG(m_open && data, false, "clipboard must be open with valid data");
+    const int kind = m_usePrimary ? Primary : Clipboard;
+    auto state = m_gtk4;
+    // Transfer ownership at the API boundary. Native providers retain immutable
+    // bytes, never a callback into a data object after its owner has gone away.
+    std::unique_ptr<wxDataObject> transferred(data);
+    wxGtkObject<GdkContentProvider> provider(wxGTKTransfer::Snapshot(*data));
+    if (!provider.get() || !state->alive) return false;
+    if (append && state->owned[kind] &&
+        gdk_clipboard_get_content(state->clipboard[kind]) == state->owned[kind])
+    {
+        GdkContentProvider* members[] = {
+            GDK_CONTENT_PROVIDER(g_object_ref(provider.get())),
+            GDK_CONTENT_PROVIDER(g_object_ref(state->owned[kind]))
+        };
+        provider = gdk_content_provider_new_union(members, 2);
+    }
+    wxGtkObject<GdkContentProvider> old(state->owned[kind]);
+    state->owned[kind] = GDK_CONTENT_PROVIDER(g_object_ref(provider.get()));
+    state->stored[kind] = false;
+    const bool result = gdk_clipboard_set_content(state->clipboard[kind], provider);
+    if (!result && state->alive)
+    {
+        g_clear_object(&state->owned[kind]);
+        if (old.get() && gdk_clipboard_get_content(state->clipboard[kind]) == old.get())
+            state->owned[kind] = GDK_CONTENT_PROVIDER(g_object_ref(old.get()));
+    }
+    return result && state->alive;
+}
+void wxClipboard::Clear()
+{
+    auto state = m_gtk4;
+    state->Clear(m_usePrimary ? Primary : Clipboard);
+}
+bool wxClipboard::IsSupported(const wxDataFormat& format)
+{
+    auto state = m_gtk4;
+    GdkClipboard* clipboard = state->clipboard[m_usePrimary ? Primary : Clipboard];
+    return clipboard && wxGTKTransfer::Match(gdk_clipboard_get_formats(clipboard), format);
+}
+bool wxClipboard::IsSupportedAsync(wxEvtHandler* sink)
+{
+    wxCHECK_MSG(sink, false, "no clipboard event sink");
+    auto state = m_gtk4;
+    GdkClipboard* clipboard = state->clipboard[m_usePrimary ? Primary : Clipboard];
+    if (!clipboard) return false;
+    GdkContentFormats* formats = gdk_content_formats_union_serialize_mime_types(
+        gdk_content_formats_ref(gdk_clipboard_get_formats(clipboard)));
+    wxClipboardEvent* event = new wxClipboardEvent(wxEVT_CLIPBOARD_CHANGED);
+    gsize count = 0;
+    const char* const* names = gdk_content_formats_get_mime_types(formats, &count);
+    for (gsize i = 0; i < count; ++i) event->AddFormat(wxDataFormat(names[i]));
+    if (wxGTKTransfer::Match(formats, wxDataFormat(wxDF_UNICODETEXT)))
+    {
+        event->AddFormat(wxDataFormat(wxDF_UNICODETEXT));
+        event->AddFormat(wxDataFormat(wxDF_TEXT));
+    }
+    gdk_content_formats_unref(formats);
+    // QueueEvent owns the event and removes it safely if its sink is destroyed.
+    wxQueueEvent(sink, event);
+    return true;
+}
+bool wxClipboard::GetData(wxDataObject& data)
+{
+    wxCHECK_MSG(m_open, false, "clipboard not open");
+    auto state = m_gtk4;
+    GdkClipboard* clipboard = state->clipboard[m_usePrimary ? Primary : Clipboard];
+    if (!clipboard) return false;
+    for (const auto& format : wxGTKTransfer::Formats(data, wxDataObject::Set))
+    {
+        const char* mime = wxGTKTransfer::Match(gdk_clipboard_get_formats(clipboard), format);
+        if (!mime) continue;
+        if (!state->alive) return false;
+        auto request = wxGTKTransfer::Read(G_OBJECT(clipboard), mime);
+        state->requests.Add(request);
+        // Starting a GDK read may call a native provider synchronously. Both
+        // it and the nested wx loop can run application destruction callbacks.
+        // cppcheck-suppress identicalConditionAfterEarlyExit
+        if (!state->alive) { g_cancellable_cancel(request->cancel); return false; }
+        // cppcheck-suppress identicalConditionAfterEarlyExit
+        if (!wxGTKTransfer::Wait(request) || !state->alive) return false;
+        return wxGTKTransfer::Receive(data, format, request->bytes);
+    }
+    return false;
+}
+bool wxClipboard::Flush()
+{
+    if (m_usePrimary) return false;
+    auto state = m_gtk4;
+    GdkClipboard* clipboard = state->clipboard[Clipboard];
+    if (!clipboard) return false;
+    GdkContentProvider* current = gdk_clipboard_get_content(clipboard);
+    wxGtkObject<GdkContentProvider> offered(current ? GDK_CONTENT_PROVIDER(g_object_ref(current)) : NULL);
+    auto request = wxGTKTransfer::Store(clipboard);
+    state->requests.Add(request);
+    if (!state->alive) { g_cancellable_cancel(request->cancel); return false; }
+    const bool result = wxGTKTransfer::Wait(request);
+    const bool unchanged = state->alive && gdk_clipboard_get_content(clipboard) == offered.get();
+    if (unchanged && result) state->stored[Clipboard] = true;
+    return result && unchanged;
+}
