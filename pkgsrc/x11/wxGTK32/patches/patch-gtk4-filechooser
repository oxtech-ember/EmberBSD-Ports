+///////////////////////////////////////////////////////////////////////////////
+// GTK4 chooser GFile ownership and local-path conversion.
+// Origin: EmberBSD (AI-assisted). wxWindows licence.
+///////////////////////////////////////////////////////////////////////////////
+#ifndef _WX_GTK_PRIVATE_FILECHOOSER4_H_
+#define _WX_GTK_PRIVATE_FILECHOOSER4_H_
+#include <gtk/gtk.h>
+#include "wx/gtk/private/object.h"
+#include "wx/gtk/private/string.h"
+#include "wx/filename.h"
+namespace wxGTKFileChooser4
+{
+inline char* Filename(GtkFileChooser* chooser)
+{
+    wxGtkObject<GFile> file(gtk_file_chooser_get_file(chooser));
+    return file.get() ? g_file_get_path(file) : NULL;
+}
+inline char* Directory(GtkFileChooser* chooser)
+{
+    wxGtkObject<GFile> file(gtk_file_chooser_get_current_folder(chooser));
+    return file.get() ? g_file_get_path(file) : NULL;
+}
+inline bool Paths(GtkFileChooser* chooser, wxArrayString& paths)
+{
+    paths.Clear();
+    wxArrayString result;
+    wxGtkObject<GListModel> files(gtk_file_chooser_get_files(chooser));
+    if (!files.get()) return false;
+    for (guint i = 0; i < g_list_model_get_n_items(files); ++i)
+    {
+        wxGtkObject<GFile> file(G_FILE(g_list_model_get_item(files, i)));
+        wxGtkString path(g_file_get_path(file));
+        if (!path) return false; // Never turn a remote URI into a local pathname.
+        result.Add(wxString::FromUTF8(path));
+    }
+    paths.swap(result);
+    return true;
+}
+inline bool SetDirectory(GtkFileChooser* chooser, const wxString& path)
+{
+    wxGtkObject<GFile> file(g_file_new_for_path(wxFileName::DirName(path).GetAbsolutePath().utf8_str()));
+    return gtk_file_chooser_set_current_folder(chooser, file, NULL) != FALSE;
+}
+inline bool SetFile(GtkFileChooser* chooser, const wxString& path)
+{
+    wxGtkObject<GFile> file(g_file_new_for_path(wxFileName(path).GetAbsolutePath().utf8_str()));
+    return gtk_file_chooser_set_file(chooser, file, NULL) != FALSE;
+}
+inline void ShowHidden(GtkFileChooser* chooser, bool show)
+{
+    // Public concrete-class property supplied by the shared GTK4 provider.
+    g_object_set(chooser, "show-hidden", gboolean(show), NULL);
+}
+}
+#endif
