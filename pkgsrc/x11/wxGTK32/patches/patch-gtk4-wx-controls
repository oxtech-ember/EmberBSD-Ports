+    {
+        wxNavigationKeyEvent event;
+        event.SetEventObject(rb->GetParent());
+        event.SetDirection(keyval == GDK_KEY_Tab);
+        event.SetWindowChange((state & GDK_CONTROL_MASK) != 0);
+        event.SetCurrentFocus(rb);
+        return rb->GetParent()->HandleWindowEvent(event);
+    }
+    if (keyval != GDK_KEY_Up && keyval != GDK_KEY_Down &&
+        keyval != GDK_KEY_Left && keyval != GDK_KEY_Right)
+        return FALSE;
+    wxRadioBoxButtonsInfoList::compatibility_iterator node = rb->m_buttonsInfo.GetFirst();
+    while (node && node->GetData()->button != widget) node = node->GetNext();
+    if (!node) return FALSE;
+    if (keyval == GDK_KEY_Up || keyval == GDK_KEY_Left)
+        node = node == rb->m_buttonsInfo.GetFirst() ? rb->m_buttonsInfo.GetLast() : node->GetPrevious();
+    else
+        node = node == rb->m_buttonsInfo.GetLast() ? rb->m_buttonsInfo.GetFirst() : node->GetNext();
+    GtkWidget* nextButton = node->GetData()->button;
+    wxWeakRef<wxWindow> alive(rb);
+    gtk_widget_grab_focus(node->GetData()->button);
+    if (!alive)
+        return TRUE;
+    gtk_check_button_set_active(GTK_CHECK_BUTTON(nextButton), TRUE);
