 static GtkAboutDialog *gs_aboutDialog = NULL;
 
 extern "C" {
+#ifdef __WXGTK4__
+static void wxGtkAboutDialogReset(GtkWidget* about, void*)
+{
+    if (about == GTK_WIDGET(gs_aboutDialog))
+        gs_aboutDialog = NULL;
+}
+
+static gboolean wxGtkAboutDialogOnClose(GtkWindow* about, void*)
+{
+    wxGtkAboutDialogReset(GTK_WIDGET(about), NULL);
+    return FALSE; // GtkWindow performs its normal close/destroy operation.
+}
+#else
 static void wxGtkAboutDialogOnClose(GtkAboutDialog *about)
 {
     gtk_widget_destroy(GTK_WIDGET(about));
     if ( about == gs_aboutDialog )
         gs_aboutDialog = NULL;
 }
+#endif
 }
 
