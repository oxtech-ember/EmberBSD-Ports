+#ifdef __WXGTK4__
+static void
+wx_gtk_entry_motion(GtkEventControllerMotion* controller, double x, double y,
+                    wxSearchCtrl* ctrl)
+{
+    // GtkEntry's icon interaction no longer emits a widget event. Observe
+    // motion on the whole widget so hovering over either icon still enters wx.
+    if (!wxGTKImpl::SetWindowUnderMouse(ctrl))
+        return;
+
+    wxMouseEvent mouseEvent(wxEVT_ENTER_WINDOW);
+    GdkEvent* event = gtk_event_controller_get_current_event(
+        GTK_EVENT_CONTROLLER(controller));
+    if (event)
+        wxGTKImpl::InitMouseEvent(ctrl, mouseEvent, event);
+    else
+    {
+        mouseEvent.SetEventObject(ctrl);
+        mouseEvent.SetId(ctrl->GetId());
+        mouseEvent.SetPosition(wxPoint(wxRound(x), wxRound(y)));
+    }
+    ctrl->GTKProcessEvent(mouseEvent);
+}
