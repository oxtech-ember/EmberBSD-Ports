+void wxPizza::set_focus_order(GList* widgets)
+{
+    g_list_free(m_focusOrder);
+    m_focusOrder = g_list_copy(widgets);
+}
+
+void wxPizza::put(GtkWidget* widget, int x, int y, int width, int height)
+{
+    // A wx toplevel can have an owner, but cannot become a GTK child.
+    if (GTK_IS_WINDOW(widget))
+        return;
+    g_return_if_fail(gtk_widget_get_parent(widget) == NULL);
+    g_object_ref(this);
+    g_object_ref(widget);
+    wxPizzaChild* child = new wxPizzaChild();
+    child->widget = widget;
+    child->x = x;
+    child->y = y;
+    child->width = width;
+    child->height = height;
+    child->parentHandler = g_signal_connect(widget, "notify::parent",
+        G_CALLBACK(pizza_child_parent_changed), this);
+    m_children = g_list_append(m_children, child);
+    // Parent notification can synchronously unparent the child or destroy
+    // its wx owner. Register first and retain both GTK objects across it.
+    gtk_widget_set_parent(widget, GTK_WIDGET(this));
+    gtk_widget_queue_allocate(GTK_WIDGET(this));
+    g_object_unref(widget);
+    g_object_unref(this);
+}
+
+void wxPizza::move(GtkWidget* widget, int x, int y, int width, int height)
+{
+    for (const GList* p = m_children; p; p = p->next)
+    {
+        wxPizzaChild* child = static_cast<wxPizzaChild*>(p->data);
+        if (child->widget != widget)
+            continue;
+        if (child->x != x || child->y != y ||
+            child->width != width || child->height != height)
+        {
+            child->x = x;
+            child->y = y;
+            child->width = width;
+            child->height = height;
+            gtk_widget_queue_allocate(GTK_WIDGET(this));
+        }
+        return;
+    }
+}
+
+void wxPizza::size_allocate_child(GtkWidget* child, int x, int y,
+                                  int width, int height, int parentWidth)
+{
+    if (parentWidth < 0)
+        parentWidth = gtk_widget_get_width(GTK_WIDGET(this));
+    width = wxMax(0, width);
+    height = wxMax(0, height);
+    x -= m_scroll_x;
+    y -= m_scroll_y;
+    if (gtk_widget_get_direction(GTK_WIDGET(this)) == GTK_TEXT_DIR_RTL)
+        x = parentWidth - x - width;
+    graphene_point_t origin;
+    graphene_point_init(&origin, x, y);
+    // gtk_widget_allocate() takes ownership of the transform.
+    gtk_widget_allocate(child, width, height, -1, gsk_transform_translate(NULL, &origin));
+}
+
+void wxPizza::scroll(int dx, int dy)
+{
+    InvalidateClientDC();
+    m_scroll_x -= dx;
+    m_scroll_y -= dy;
+    gtk_widget_queue_allocate(GTK_WIDGET(this));
+    gtk_widget_queue_draw(GTK_WIDGET(this));
+}
+
+// Immediate wx DCs use a copy of the last client content. They must never
+// detach the GSK renderer from its GtkNative surface. This path deliberately
+// performs a GPU readback; ordinary paint and GL snapshot presentation do not.
+struct wxPizzaClientDC
+{
+    GWeakRef widget;
+    cairo_surface_t* surface;
+    guint references;
+    guint64 serial;
+    int width, height;
+    wxPizzaClientDC(wxPizza* pizza, cairo_surface_t* pixels, int w, int h)
+        : surface(pixels), references(1), serial(pizza->m_paintSerial), width(w), height(h)
+        { g_weak_ref_init(&widget, pizza); }
+    ~wxPizzaClientDC()
+        { g_weak_ref_clear(&widget); cairo_surface_destroy(surface); }
+};
+
+void wxPizza::InvalidateClientDC()
+{
+    ++m_paintSerial;
+    m_useClientContent = false;
+    m_contentInvalidated = true;
+}
+
+cairo_t* wxPizza::BeginClientDC(void** token)
+{
+    *token = NULL;
+    GtkWidget* widget = GTK_WIDGET(this);
+    if (m_inSnapshot || !m_contentSnapshot || !gtk_widget_get_mapped(widget))
+        return NULL;
+    const int width = gtk_widget_get_width(widget);
+    const int height = gtk_widget_get_height(widget);
+    if (width <= 0 || height <= 0)
+        return NULL;
+    wxPizzaClientDC* current = static_cast<wxPizzaClientDC*>(
+        g_object_get_data(G_OBJECT(this), "wx-client-dc"));
+    if (current && current->serial == m_paintSerial &&
+        current->width == width && current->height == height)
+    {
+        ++current->references;
+        *token = current;
+        return cairo_create(current->surface);
+    }
+    GtkNative* native = gtk_widget_get_native(widget);
+    GskRenderer* renderer = native ? gtk_native_get_renderer(native) : NULL;
+    if (!renderer)
+        return NULL;
+    const double scale = gdk_surface_get_scale(gtk_native_get_surface(native));
+    const int pixelWidth = int(std::ceil(width * scale));
+    const int pixelHeight = int(std::ceil(height * scale));
+    GtkSnapshot* copy = gtk_snapshot_new();
+    gtk_snapshot_scale(copy, scale, scale);
+    // Include the widget's own CSS background in the destination pixels, but
+    // not child widgets: children retain their normal independent z order.
+    gtk_snapshot_render_background(copy, gtk_widget_get_style_context(widget),
+                                   0, 0, width, height);
+    gtk_snapshot_append_node(copy, m_contentSnapshot);
+    GskRenderNode* node = gtk_snapshot_free_to_node(copy);
+    const graphene_rect_t bounds = GRAPHENE_RECT_INIT(0, 0, pixelWidth, pixelHeight);
+    GdkTexture* texture = gsk_renderer_render_texture(renderer, node, &bounds);
+    gsk_render_node_unref(node);
+    if (!texture)
+        return NULL;
+    cairo_surface_t* surface = cairo_image_surface_create(CAIRO_FORMAT_ARGB32, pixelWidth, pixelHeight);
+    if (cairo_surface_status(surface) != CAIRO_STATUS_SUCCESS)
+    {
+        cairo_surface_destroy(surface);
+        g_object_unref(texture);
+        return NULL;
+    }
+    gdk_texture_download(texture, cairo_image_surface_get_data(surface),
+                         cairo_image_surface_get_stride(surface));
+    g_object_unref(texture);
+    cairo_surface_mark_dirty(surface);
+    cairo_surface_set_device_scale(surface, scale, scale);
+    current = new wxPizzaClientDC(this, surface, width, height);
+    g_object_set_data(G_OBJECT(this), "wx-client-dc", current);
+    *token = current;
+    return cairo_create(surface);
+}
+
+void wxPizza::EndClientDC(void* token)
+{
+    wxPizzaClientDC* state = static_cast<wxPizzaClientDC*>(token);
+    if (!state || --state->references)
+        return;
+    GtkWidget* widget = GTK_WIDGET(g_weak_ref_get(&state->widget));
+    if (widget)
+    {
+        wxPizza* pizza = WX_PIZZA(widget);
+        if (g_object_get_data(G_OBJECT(widget), "wx-client-dc") == state)
+            g_object_set_data(G_OBJECT(widget), "wx-client-dc", NULL);
+        // A normal repaint requested during the DC lifetime supersedes the
+        // transient pixels, just as it does with immediate window drawing.
+        if (pizza->m_paintSerial == state->serial && !pizza->m_contentInvalidated &&
+            gtk_widget_get_mapped(widget) && gtk_widget_get_width(widget) == state->width &&
+            gtk_widget_get_height(widget) == state->height)
+        {
+            cairo_surface_flush(state->surface);
+            const int stride = cairo_image_surface_get_stride(state->surface);
+            const int height = cairo_image_surface_get_height(state->surface);
+            GBytes* pixels = g_bytes_new(cairo_image_surface_get_data(state->surface), gsize(stride) * height);
+            GdkTexture* texture = gdk_memory_texture_new(
+                cairo_image_surface_get_width(state->surface), height,
+                GDK_MEMORY_DEFAULT, pixels, stride);
+            g_bytes_unref(pixels);
+            GtkSnapshot* snapshot = gtk_snapshot_new();
+            const graphene_rect_t bounds = GRAPHENE_RECT_INIT(0, 0, state->width, state->height);
+            gtk_snapshot_append_texture(snapshot, texture, &bounds);
+            g_object_unref(texture);
+            GskRenderNode* node = gtk_snapshot_free_to_node(snapshot);
+            g_clear_pointer(&pizza->m_contentSnapshot, gsk_render_node_unref);
+            pizza->m_contentSnapshot = node;
+            pizza->m_useClientContent = true;
+            gtk_widget_queue_draw(widget);
+        }
+        g_object_unref(widget);
+    }
+    delete state;
+}
+
+void wxPizza::set_virtual_size(int width, int height)
+{
+    width = wxMax(0, width);
+    height = wxMax(0, height);
+    if (width == m_virtual_width && height == m_virtual_height)
+        return;
+    m_virtual_width = width;
+    m_virtual_height = height;
+    gtk_widget_queue_resize(GTK_WIDGET(this));
+}
+
+void wxPizza::get_border(GtkBorder& border)
+{
+    GtkStyleContext* style = gtk_widget_get_style_context(GTK_WIDGET(this));
+    gtk_style_context_get_border(style, &border);
+    GtkBorder padding;
+    gtk_style_context_get_padding(style, &padding);
+    border.left += padding.left;
+    border.right += padding.right;
+    border.top += padding.top;
+    border.bottom += padding.bottom;
+}
