+std::string ScintillaWX::UTF8FromEncoded(std::string_view encoded) const {
+    if (pdoc->dbcsCodePage == SC_CP_UTF8)
+        return std::string(encoded);
+    wxCSConv converter = pdoc->dbcsCodePage
+        ? wxCSConv(wxString::Format("CP%d", pdoc->dbcsCodePage))
+        : wxCSConv(wxFONTENCODING_SYSTEM);
+    const wxString text(encoded.data(), converter, encoded.size());
+    const wxScopedCharBuffer utf8 = text.utf8_str();
+    return std::string(utf8.data() ? utf8.data() : "", utf8.length());
+}
+
+std::string ScintillaWX::EncodedFromUTF8(std::string_view utf8) const {
+    if (pdoc->dbcsCodePage == SC_CP_UTF8)
+        return std::string(utf8);
+    wxCSConv converter = pdoc->dbcsCodePage
+        ? wxCSConv(wxString::Format("CP%d", pdoc->dbcsCodePage))
+        : wxCSConv(wxFONTENCODING_SYSTEM);
+    const wxString text = wxString::FromUTF8(utf8.data(), utf8.size());
+    const wxScopedCharBuffer encoded = text.mb_str(converter);
+    return std::string(encoded.data() ? encoded.data() : "", encoded.length());
+}
 
