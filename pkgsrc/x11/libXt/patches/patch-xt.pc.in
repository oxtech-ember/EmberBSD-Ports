$NetBSD$

Preserve prefix-owned default paths when the native package is moved.
Origin: EmberBSD contributors (AI-assisted); not submitted upstream.

--- xt.pc.in.orig
+++ xt.pc.in
@@ -13,4 +13,5 @@
 Requires: xproto x11
 Requires.private: ice sm
 Cflags: -I${includedir}
-Libs: -L${libdir} -lXt
+Libs: -Wl,-rpath,${libdir} -L${libdir} -lXt
+Libs.private: @X11_RELOC_DL_LIBS@
