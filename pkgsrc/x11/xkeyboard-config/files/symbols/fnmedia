// Laptop function rows with the printed actions as the primary layer.
//
// Some laptops send F1-F12 without Fn and the printed actions with Fn,
// and their firmware has no Fn lock.  Each variant swaps the two layers
// of one keyboard: the printed action works without Fn (Shift too, for
// the fine volume step), Control, Alt or Super with the key gives the
// F-key (Alt+F4, Ctrl+F4), Control+Alt switches the console, and Fn with
// the key gives the F-key.  The key type is in types/fnmedia.

// QBOOK15.  Fn+F6/F7 reach the system through ACPI, not through the
// keyboard, so plain F6 and F7 are not available until an Intel HID
// driver handles them.
partial function_keys
xkb_symbols "qbook15" {
    replace key <FK02> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioMute, F2, XF86Switch_VT_2 ] };
    replace key <FK03> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioLowerVolume, F3, XF86Switch_VT_3 ] };
    replace key <FK04> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioRaiseVolume, F4, XF86Switch_VT_4 ] };
    replace key <FK06> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86MonBrightnessDown, F6, XF86Switch_VT_6 ] };
    replace key <FK07> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86MonBrightnessUp, F7, XF86Switch_VT_7 ] };
    replace key <FK08> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioPrev, F8, XF86Switch_VT_8 ] };
    replace key <FK09> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioNext, F9, XF86Switch_VT_9 ] };
    replace key <MUTE> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F2 ] };
    replace key <VOL-> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F3 ] };
    replace key <VOL+> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F4 ] };
    replace key <I173> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F8 ] };
    replace key <I171> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F9 ] };
};

// MSI Vector 17 HX AI A2XW.  Fn+F8, Fn+F9 and Fn+F10 send no event to the
// system, so F8, F9 and F10 come only with Control, Alt or Super.  Fn+F4
// sends Control+Super+F24 (touchpad toggle) and Fn+F11 sends Super+P;
// they keep these meanings.  Fn+F5, Fn+F6 and Fn+F7 need the vendor scan
// codes of libopeninput.
partial function_keys
xkb_symbols "msi_vector" {
    replace key <FK01> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioMute, F1, XF86Switch_VT_1 ] };
    replace key <FK02> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioLowerVolume, F2, XF86Switch_VT_2 ] };
    replace key <FK03> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioRaiseVolume, F3, XF86Switch_VT_3 ] };
    replace key <FK04> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86TouchpadToggle, F4, XF86Switch_VT_4 ] };
    replace key <FK05> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86AudioMicMute, F5, XF86Switch_VT_5 ] };
    replace key <FK06> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86Bluetooth, F6, XF86Switch_VT_6 ] };
    replace key <FK07> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86Tools, F7, XF86Switch_VT_7 ] };
    replace key <FK08> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86KbdLightOnOff, F8, XF86Switch_VT_8 ] };
    replace key <FK09> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86MonBrightnessDown, F9, XF86Switch_VT_9 ] };
    replace key <FK10> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86MonBrightnessUp, F10, XF86Switch_VT_10 ] };
    replace key <FK11> { type[Group1] = "FNMEDIA", symbols[Group1] = [ XF86Display, F11, XF86Switch_VT_11 ] };
    replace key <MUTE> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F1 ] };
    replace key <VOL-> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F2 ] };
    replace key <VOL+> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F3 ] };
    replace key <FK20> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F5 ] };
    replace key <I245> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F6 ] };
    replace key <I179> { type[Group1] = "ONE_LEVEL", symbols[Group1] = [ F7 ] };
};
