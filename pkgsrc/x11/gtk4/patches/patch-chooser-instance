+/* Selection changes often originate inside native model/entry transitions.
+ * Deliver application callbacks after those transitions have unwound, rather
+ * than exposing partially updated state or letting a callback dispose it. */
+static gboolean
+emit_selection_changed (gpointer data)
+{
+  GtkFileChooserWidget *impl = data;
+  impl->selection_changed_id = 0;
+  g_object_ref (impl);
+  g_signal_emit_by_name (impl, "selection-changed");
+  g_object_unref (impl);
+  return G_SOURCE_REMOVE;
+}
+
+static void
+queue_selection_changed (GtkFileChooserWidget *impl)
+{
+  if (!impl->chooser_disposing && impl->selection_changed_id == 0)
+    impl->selection_changed_id = g_idle_add (emit_selection_changed, impl);
+}
