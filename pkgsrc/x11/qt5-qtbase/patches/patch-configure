$NetBSD: patch-configure,v 1.5 2018/01/17 19:30:47 markd Exp $

Don't use SDKs on OS X
Add NetBSD/sparc{,64} support
Find tools with POSIX command -v; which(1) is not in minimal tool paths

--- configure.orig
+++ configure
@@ -40,7 +40,9 @@
 # the current directory is the "build tree" or "object tree"
 outpath=`/bin/pwd`
 
-WHICH="which"
+# which(1) is not POSIX and is absent from minimal tool paths.
+qt_which() { command -v "$1"; }
+WHICH=qt_which
 
 PERL=`$WHICH perl 2>/dev/null`
 
@@ -287,7 +289,6 @@
 {
     if [ -z "$specvals" ]; then
         specvals=`expandQMakeConf "$QMAKESPEC/qmake.conf" | extractQMakeVariables`
-        if [ "$BUILD_ON_MAC" = "yes" ]; then specvals=$(macSDKify "$specvals"); fi
     fi
     getSingleQMakeVariable "$1" "$specvals"
 }
@@ -608,6 +609,19 @@
      LynxOS*:*)
         PLATFORM=lynxos-g++
         ;;
+    NetBSD:*:sparc)
+        if [ "$OPT_VERBOSE" = "yes" ]; then
+            echo "    NetBSD on SPARC"
+        fi
+        CFG_HOST_ARCH=sparc
+        ;;
+    NetBSD:*:sparc64)
+        if [ "$OPT_VERBOSE" = "yes" ]; then
+            echo "    NetBSD on SPARC64"
+        fi
+        CFG_HOST_ARCH=sparc
+        CFG_HOST_BITSIZE=64
+        ;;
      QNX:*)
         PLATFORM=unsupported/qnx-g++
         ;;
