# $NetBSD: Makefile.common,v 1.2 2026/06/01 13:31:40 wiz Exp $
# used by x11/libxkbcommon-docs/Makefile

DISTNAME=	xkbcommon-1.13.2
PKGNAME=	lib${DISTNAME}
CATEGORIES=	x11
MASTER_SITES=	${MASTER_SITE_GITHUB:=xkbcommon/}
GITHUB_TAG=	${DISTNAME}

MAINTAINER=	ryoon@NetBSD.org
HOMEPAGE=	https://xkbcommon.org/
COMMENT=	Library to handle keyboard descriptions
LICENSE=	mit

PATCHDIR=	${.CURDIR}/../../x11/libxkbcommon/patches
DISTINFO_FILE=	${.CURDIR}/../../x11/libxkbcommon/distinfo

USE_TOOLS+=	bison pkg-config

MESON_ARGS+=	-Denable-wayland=false

MAKE_ENV+=	LD_LIBRARY_PATH=${WRKSRC}/output

WRKSRC=		${WRKDIR}/libxkbcommon-xkbcommon-${PKGVERSION_NOREV}

PYTHON_FOR_BUILD_ONLY=	tool

PKGCONFIG_OVERRIDE+=		output/meson-private/xkbcommon.pc
PKGCONFIG_OVERRIDE+=		output/meson-private/xkbcommon-x11.pc
PKGCONFIG_OVERRIDE_STAGE=	post-configure

.include "../../mk/bsd.prefs.mk"

# Origin: EmberBSD (AI-assisted). pkgconf prepends the target sysroot even
# for --variable queries. These directories are consumed at target runtime.
.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
MESON_ARGS+= -Dxkb-config-root=${PREFIX}/share/xkeyboard-config-2
MESON_ARGS+= -Dxkb-legacy-root=${PREFIX}/share/X11/xkb
MESON_ARGS+= -Dxkb-config-unversioned-extensions-path=${PREFIX}/share/xkeyboard-config.d
MESON_ARGS+= -Dxkb-config-versioned-extensions-path=${PREFIX}/share/xkeyboard-config-2.d

post-configure: emberbsd-xkb-runtime-paths
.PHONY: emberbsd-xkb-runtime-paths
emberbsd-xkb-runtime-paths:
	${RUN} for definition in \
	    'DFLT_XKB_CONFIG_ROOT "${PREFIX}/share/xkeyboard-config-2"' \
	    'DFLT_XKB_LEGACY_ROOT "${PREFIX}/share/X11/xkb"' \
	    'DFLT_XKB_CONFIG_UNVERSIONED_EXTENSIONS_PATH "${PREFIX}/share/xkeyboard-config.d"' \
	    'DFLT_XKB_CONFIG_VERSIONED_EXTENSIONS_PATH "${PREFIX}/share/xkeyboard-config-2.d"'; do \
		${GREP} -F -x "#define $$definition" ${WRKSRC:Q}/output/config.h || exit 1; \
	done
	${RUN} if ${GREP} -F ${CROSS_DESTDIR:Q} ${WRKSRC:Q}/output/config.h \
	    ${WRKSRC:Q}/output/meson-private/xkbcommon.pc; then \
		echo 'Target XKB runtime metadata contains the cross sysroot' >&2; exit 1; \
	fi
.endif

# native X has a different locale path (lib) than modular X (share)
.if ${X11_TYPE} == native
MESON_ARGS+=	-Dx-locale-root=${X11BASE}/lib/X11/locale
.endif

.if ${OPSYS} == "Darwin" || ${OPSYS} == "SunOS"
BUILDLINK_TRANSFORM+=	rm:-Wl,--version-script=./xkbcommon.map
BUILDLINK_TRANSFORM+=	rm:-Wl,--version-script=./xkbcommon-x11.map
.endif

.include "../../devel/xorg-util-macros/buildlink3.mk"
BUILDLINK_API_DEPENDS.libxcb+=	libxcb>=1.10
.include "../../x11/libxcb/buildlink3.mk"
.include "../../x11/xkeyboard-config/buildlink3.mk"
.include "../../textproc/libxml2/buildlink3.mk"
.include "../../devel/meson/build.mk"
# for tests
.include "../../lang/python/tool.mk"
