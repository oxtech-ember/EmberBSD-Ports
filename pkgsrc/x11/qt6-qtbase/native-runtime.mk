.if !defined(EMBERBSD_QT_NATIVE_RUNTIME_MK)
EMBERBSD_QT_NATIVE_RUNTIME_MK:= yes
_EMBERBSD_QT_TOOL_WRAPPER:= ${.PARSEDIR:tA}/files/qt-tool-runtime.sh
_EMBERBSD_QT_TOOL_CACHE:= ${.PARSEDIR:tA}/files/qt-tool-runtime-cache.cmake
.if defined(EMBERBSD_QT_HOST_RUNTIME_VIEW) && !empty(EMBERBSD_QT_HOST_RUNTIME_VIEW)
.if empty(EMBERBSD_QT_HOST_RUNTIME_VIEW:M/*) || \
    empty(EMBERBSD_CROSS_BUILD_PYTHON:M/*) || \
    empty(EMBERBSD_SDK_SOURCE:M/*) || \
    !exists(${EMBERBSD_QT_HOST_RUNTIME_VIEW}) || \
    !exists(${EMBERBSD_CROSS_BUILD_PYTHON}) || \
    !exists(${EMBERBSD_SDK_SOURCE}/scripts/run-darwin-with-runtime.py)
PKG_FAIL_REASON+= "Select an absolute Qt native runtime view, host Python and SDK source"
.else
_EMBERBSD_QT_RUNTIME_EXEC= ${EMBERBSD_CROSS_BUILD_PYTHON:Q} -I -S ${EMBERBSD_SDK_SOURCE:Q}/scripts/run-darwin-with-runtime.py --runtime-view ${EMBERBSD_QT_HOST_RUNTIME_VIEW:Q} --
CONFIGURE_ENV+= QT_NATIVE_RUNTIME_WRAPPER=${_EMBERBSD_QT_TOOL_WRAPPER:Q} QT_NATIVE_RUNTIME_PYTHON=${EMBERBSD_CROSS_BUILD_PYTHON:Q} QT_NATIVE_RUNTIME_LAUNCHER=${EMBERBSD_SDK_SOURCE:Q}/scripts/run-darwin-with-runtime.py QT_NATIVE_RUNTIME_VIEW=${EMBERBSD_QT_HOST_RUNTIME_VIEW:Q}
MAKE_ENV+= QT_NATIVE_RUNTIME_PYTHON=${EMBERBSD_CROSS_BUILD_PYTHON:Q} QT_NATIVE_RUNTIME_LAUNCHER=${EMBERBSD_SDK_SOURCE:Q}/scripts/run-darwin-with-runtime.py QT_NATIVE_RUNTIME_VIEW=${EMBERBSD_QT_HOST_RUNTIME_VIEW:Q}
CMAKE_CONFIGURE_ARGS+= -C ${_EMBERBSD_QT_TOOL_CACHE:Q}
BUILD_DEFS+= EMBERBSD_QT_HOST_RUNTIME_VIEW
.endif
.else
_EMBERBSD_QT_RUNTIME_EXEC=
.endif
.endif
