# $NetBSD: Makefile.common,v 1.44 2026/04/30 06:38:37 adam Exp $
# used by audio/qt6-qtspeech/Makefile
# used by comms/qt6-qtconnectivity/Makefile
# used by databases/qt6-odbc/Makefile
# used by databases/qt6-psql/Makefile
# used by devel/qt6-qt5compat/Makefile
# used by devel/qt6-qttools/Makefile
# used by devel/qt6-qtwayland/Makefile
# used by geography/qt6-qtlocation/Makefile
# used by geography/qt6-qtpositioning/Makefile
# used by graphics/qt6-qt3d/Makefile
# used by graphics/qt6-qtcharts/Makefile
# used by graphics/qt6-qtdatavis3d/Makefile
# used by graphics/qt6-qtimageformats/Makefile
# used by graphics/qt6-qtlottie/Makefile
# used by graphics/qt6-qtquick3d/Makefile
# used by graphics/qt6-qtquicktimeline/Makefile
# used by graphics/qt6-qtshadertools/Makefile
# used by graphics/qt6-qtsvg/Makefile
# used by inputmethod/qt6-qtvirtualkeyboard/Makefile
# used by lang/qt6-qtdeclarative/Makefile
# used by lang/qt6-qtlanguageserver/Makefile
# used by lang/qt6-qtscxml/Makefile
# used by misc/qt6-qtsensors/Makefile
# used by multimedia/qt6-qtmultimedia/Makefile
# used by net/qt6-qtgrpc/Makefile
# used by net/qt6-qtremoteobjects/Makefile
# used by net/qt6-qtwebsockets/Makefile
# used by security/qt6-qtnetworkauth/Makefile
# used by www/qt6-qthttpserver/Makefile
# used by www/qt6-qtwebchannel/Makefile
# used by www/qt6-qtwebengine/Makefile
# used by x11/qt6-qtbase/Makefile
# used by x11/qt6-qtserialport/Makefile
# used by x11/qt6-qttranslations/Makefile

.if !defined(EMBERBSD_QT_MAKEFILE_COMMON)
EMBERBSD_QT_MAKEFILE_COMMON= yes
EMBERBSD_QTBASE_PKGDIR:= ${.PARSEDIR:tA}
.if defined(EMBERBSD_QTBASE_DEVEL) && defined(EMBERBSD_QTBASE_SHARED_STAGE)
_EMBERBSD_QTBASE_SHARED_DEVEL= yes
.endif
# The SDK recipe and the SQL driver recipes build from this exact qtbase
# source, so they share its checksums and every patch.
.if defined(EMBERBSD_QTBASE_DEVEL) || ${.CURDIR:M*/databases/qt6-psql} || \
    ${.CURDIR:M*/databases/qt6-odbc}
DISTINFO_FILE= ${EMBERBSD_QTBASE_PKGDIR}/distinfo
PATCHDIR= ${EMBERBSD_QTBASE_PKGDIR}/patches
FILESDIR= ${EMBERBSD_QTBASE_PKGDIR}/files
.endif

.include "../../meta-pkgs/qt6/Makefile.common"

# Qtbase uses its own configure wrapper, but the selected generator and
# build/install targets come from pkgsrc's standard CMake fragment.
CMAKE_GENERATOR?=	ninja
CMAKE_BUILD_DIR=	.
CONFIGURE_DIR=	.
.if ${PKGPATH} == "x11/qt6-qtbase" || defined(EMBERBSD_QTBASE_DEVEL)
.if !defined(_EMBERBSD_QTBASE_SHARED_DEVEL)
do-configure:
	${RUN}${_ULIMIT_CMD} \
	cd ${WRKSRC} && \
	${PKGSRC_SETENV} ${_CONFIGURE_SCRIPT_ENV} \
		${CONFIG_SHELL} ${CONFIG_SHELL_FLAGS} \
			${CONFIGURE_SCRIPT} ${CONFIGURE_ARGS}
.endif
.if !defined(_EMBERBSD_QTBASE_SHARED_DEVEL)
.include "../../devel/cmake/build.mk"
.endif
.endif

.include "../../mk/dlopen.buildlink3.mk"
BUILDLINK_TRANSFORM+=	opt:-ldl:${BUILDLINK_LDADD.dl:Q}

USE_LANGUAGES=		c c++
USE_TOOLS+=		cmake gmake perl:build pkg-config
#TOOL_DEPENDS+=		ninja-build-[0-9]*:../../devel/ninja-build

.include "../../devel/wayland/platform.mk"
# Origin: EmberBSD (AI-assisted). Qt otherwise forces its own minimum macOS.
.if ${OPSYS} == "Darwin" && defined(MACOSX_DEPLOYMENT_TARGET)
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_OSX_DEPLOYMENT_TARGET:STRING=${MACOSX_DEPLOYMENT_TARGET}
.endif
# Origin: EmberBSD (AI-assisted). Record the native C++ runtime of every module.
.include "../../mk/emberbsd-native-cxx-runtime.mk"
# Origin: EmberBSD (AI-assisted). Generators run on the development host.
.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
.include "host-tools.mk"
CMAKE_CONFIGURE_ARGS+= -DQT_FORCE_BUILD_TOOLS:BOOL=ON
.if ${EMBERBSD_CROSS_COMPILER_FAMILY:U} == "clang"
QT_TARGET_CC=	${PREFIX}/bin/clang
QT_TARGET_CXX=	${PREFIX}/bin/clang++
.elif ${EMBERBSD_CROSS_COMPILER_FAMILY:U} == "gcc"
QT_TARGET_CC=	${PREFIX}/gcc16/bin/gcc
QT_TARGET_CXX=	${PREFIX}/gcc16/bin/g++
.else
PKG_FAIL_REASON+=	"Qt target metadata requires an explicitly selected Clang or GCC family"
.endif
.if !empty(PLATFORM_SUPPORTS_WAYLAND:Myes) && empty(PKG_OPTIONS.qt6-qtbase:Mvulkan-offscreen)
.if empty(EMBERBSD_WAYLAND_SCANNER:M/*) || !exists(${EMBERBSD_WAYLAND_SCANNER})
PKG_FAIL_REASON+= "EMBERBSD_WAYLAND_SCANNER must select the native Wayland scanner"
.endif
CMAKE_CONFIGURE_ARGS+= -DWaylandScanner_EXECUTABLE:FILEPATH=${EMBERBSD_WAYLAND_SCANNER}
CMAKE_CONFIGURE_ARGS+= -DFEATURE_wayland_client:BOOL=ON -DFEATURE_wayland_egl:BOOL=ON
.endif
# CMake validates imported include directories before compiler wrappers run.
# Give native pkg-config the target root during configure and regeneration.
CONFIGURE_ENV+= PKG_CONFIG_SYSROOT_DIR=${CROSS_DESTDIR:Q}
MAKE_ENV+= PKG_CONFIG_SYSROOT_DIR=${CROSS_DESTDIR:Q}
.endif

# required for -msse2
.if ${MACHINE_ARCH} == "i386"
CFLAGS+=		-mstackrealign
.endif

# Avoid failures to due 'register' usage in X11 headers.
CXXFLAGS+=		-Wno-register

# wcstof(3) etc. is used in C++ code.
CFLAGS.NetBSD+=		-D_NETBSD_SOURCE

CFLAGS.SunOS+=		-D__EXTENSIONS__

# include/openssl/e_os2.h:283:25: error: '_Noreturn' does not name a type
CXXFLAGS.SunOS+=	-D_Noreturn=""

# for GL_GLEXT_LEGACY with GL/gl.h error, GL_ARB_shader_objects is not defined.
BUILDLINK_TRANSFORM+=	rm:-Wundef

MAKE_ENV+=		QTPREFIX=${QTPREFIX:Q}

# pkgsrc does not set rpath during build
# but qdbuscpp2xml and qdbuscpp2xml are
# executed during build,
# some libs also link to libs in lib so
# this is needed by some ld:s to not
# cause linking errors.
.if ${OPSYS} == "Darwin"
CMAKE_INSTALL_NAME_DIR=	${QTPREFIX}/lib
.if ${USE_CROSS_COMPILE:Uno:tl} != "yes"
CMAKE_CONFIGURE_ARGS+= -DCMAKE_INSTALL_RPATH:STRING=${PREFIX}/lib
.endif
MAKE_ENV+=		DYLD_LIBRARY_PATH=${WRKSRC}/lib
# Ports Clang builds Qt; the selected CMAKE_OSX_SYSROOT gives the SDK metadata.
CMAKE_CONFIGURE_ARGS+=	-DQT_NO_XCODE_MIN_VERSION_CHECK:BOOL=ON
.else
MAKE_ENV+=		LD_LIBRARY_PATH=${WRKSRC}/lib
.endif

# avoid creating a .qt directory in the users home directory
SCRIPTS_ENV+=		HOME=${WRKDIR}

.if "${PKGPATH}" != "x11/qt6-qtbase" && !defined(EMBERBSD_QTBASE_DEVEL)
CMAKE_INSTALL_PREFIX=	${QTPREFIX}
# Native CMake tool checks need the PKG_* tools that compiler.mk selects.
.include "../../mk/compiler.mk"
.include "../../devel/cmake/configure-settings.mk"
CONFIGURE_ARGS+=	-cmake-generator ${_CMAKE_BUILD_SYSTEM:Q}
CONFIGURE_ARGS+=	-- ${CMAKE_CONFIGURE_ARGS}
QTCONFDIR?=		.
QT_CONFIGURE_MODULE=	${QTPREFIX}/bin/qt-configure-module
.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
# This is a shell script; its CMake and code generators still run on the host.
QT_CONFIGURE_MODULE=	${CROSS_DESTDIR}${QTPREFIX}/bin/qt-configure-module
.endif
do-configure:
	${RUN}${_ULIMIT_CMD} \
	cd ${WRKSRC} && \
	${PKGSRC_SETENV} ${_CONFIGURE_SCRIPT_ENV} \
		${CONFIG_SHELL} ${CONFIG_SHELL_FLAGS} \
			${QT_CONFIGURE_MODULE:Q} ${QTCONFDIR} ${CONFIGURE_ARGS}
.include "../../devel/cmake/build.mk"
.endif

PKGCONFIG_OVERRIDE_STAGE=	post-build
.PHONY: pkgconfig-link
post-install: pkgconfig-link
pkgconfig-link:
	${RUN}	if ${TEST} -d ${DESTDIR}${QTPREFIX}/lib/pkgconfig; then			\
		${ECHO} -- Linking pkg-config files to pkgconfig dir in prefix;		\
		${INSTALL_DATA_DIR} ${DESTDIR}${PREFIX}/lib/pkgconfig;			\
		${FIND} ${DESTDIR}${QTPREFIX}/lib/pkgconfig -name "*.pc" -print |	\
			while read pcpath; do						\
			pcfile=`basename $${pcpath}`;					\
			cd ${DESTDIR}${PREFIX}/lib/pkgconfig && 			\
			${LN} -f -s ${QTPREFIX}/lib/pkgconfig/$${pcfile} $${pcfile};	\
		done									\
		fi

.if ${USE_CROSS_COMPILE:Uno:tl} == "yes" && ${OPSYS} == "NetBSD" && ${PKGPATH} != "x11/qt6-qtbase" && !defined(EMBERBSD_QTBASE_DEVEL)
post-install: qt-module-target-metadata
.PHONY: qt-module-target-metadata
qt-module-target-metadata:
	${EMBERBSD_CROSS_BUILD_PYTHON:Q} -B ${.CURDIR:Q}/../../x11/qt6-qtbase/files/target-metadata.py \
	    ${DESTDIR:Q}${QTPREFIX:Q} ${CROSS_DESTDIR:Q} ${WRKDIR:Q} ${PREFIX:Q} \
	    ${TOOLBASE:Q} ${QT_TARGET_CC:Q} ${QT_TARGET_CXX:Q} --module
.endif
.endif # EMBERBSD_QT_MAKEFILE_COMMON
