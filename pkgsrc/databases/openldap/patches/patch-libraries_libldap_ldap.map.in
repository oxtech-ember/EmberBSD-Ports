$NetBSD$

Export the Cyrus SASL functions only when the library defines them.

--- libraries/libldap/ldap.map.in.orig
+++ libraries/libldap/ldap.map.in
@@ -140,7 +140,9 @@
     ldap_get_message_ber;
     ldap_get_option;
     ldap_get_values_len;
+#ifdef HAVE_CYRUS_SASL
     ldap_host_connected_to;
+#endif
     ldap_init_fd;
     ldap_initialize;
     ldap_install_tls;
@@ -166,12 +168,18 @@
     ldap_int_put_controls;
     ldap_int_sasl_bind;
     ldap_int_sasl_close;
+#ifdef HAVE_CYRUS_SASL
     ldap_int_sasl_config;
+#endif
     ldap_int_sasl_external;
+#ifdef HAVE_CYRUS_SASL
     ldap_int_sasl_get_option;
+#endif
     ldap_int_sasl_init;
+#ifdef HAVE_CYRUS_SASL
     ldap_int_sasl_open;
     ldap_int_sasl_set_option;
+#endif
     ldap_int_select;
     ldap_int_timeval_dup;
     ldap_int_tls_destroy;
