# Preserve the target Rust producer native static link dependencies.
# Origin: EmberBSD.
--- cmake/external/tdesktop_rust/CMakeLists.txt.orig
+++ cmake/external/tdesktop_rust/CMakeLists.txt
@@ -11,7 +11,9 @@
 # allocator, panic hook and backtrace machinery at run time.
 
-if (DESKTOP_APP_USE_PACKAGED OR LINUX)
+if (DESKTOP_APP_USE_PACKAGED)
+    find_library(DESKTOP_APP_TDESKTOP_RUST_LIBRARY tdesktop_rust REQUIRED)
+elseif (LINUX)
     find_library(DESKTOP_APP_TDESKTOP_RUST_LIBRARY tdesktop_rust)
     if (NOT DESKTOP_APP_TDESKTOP_RUST_LIBRARY)
         return()
     endif()
@@ -43,6 +45,16 @@
     external_tdesktop_rust_native
 )
 
+if (DESKTOP_APP_USE_PACKAGED)
+    # The Rust static archive requires the producer's target-specific system
+    # libraries, recorded in the provider's pkg-config Libs.private.
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(TDESKTOP_RUST REQUIRED tdesktop-rust)
+    set(tdesktop_rust_native_deps ${TDESKTOP_RUST_STATIC_LDFLAGS})
+    list(REMOVE_ITEM tdesktop_rust_native_deps "-ltdesktop_rust")
+    target_link_libraries(external_tdesktop_rust INTERFACE ${tdesktop_rust_native_deps})
+endif()
+
