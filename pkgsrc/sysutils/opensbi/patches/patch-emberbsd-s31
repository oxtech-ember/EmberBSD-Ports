diff --git a/platform/generic/espressif/esp32s31/esp32s31.c b/platform/generic/espressif/esp32s31/esp32s31.c
new file mode 100644
index 0000000..8460862
--- /dev/null
+++ b/platform/generic/espressif/esp32s31/esp32s31.c
@@ -0,0 +1,247 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * ESP32-S31 platform_override module.
+ *
+ */
+
+#include <sbi/riscv_asm.h>
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_console.h>
+#include <sbi/sbi_domain.h>
+#include <sbi/sbi_ecall.h>
+#include <sbi/sbi_ecall_interface.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_heap.h>
+#include <sbi/sbi_scratch.h>
+#include <sbi/sbi_system.h>
+#include <libfdt.h>
+#include <platform_override.h>
+#include <sbi_utils/fdt/fdt_helper.h>
+#include <sbi_utils/serial/esp_uart.h>
+
+#include "cache_mmu.h"
+#include "platform.h"
+
+/* Espressif PMA (Physical Memory Attributes) CSR base addresses — custom
+ * extension on top of standard PMP. 16 entries each: bit 0 = EN, bit 2 =
+ * X, bit 3 = W, bit 4 = R, bit 29 = L, bits 30-31 = address-mode A
+ * field. */
+#define ESP32S31_PMACFG0_CSR         0xBC0
+#define ESP32S31_PMAADDR0_CSR        0xBD0
+
+#define ESP32S31_PMA_EN              (1U << 0)
+#define ESP32S31_PMA_X               (1U << 2)
+#define ESP32S31_PMA_W               (1U << 3)
+#define ESP32S31_PMA_R               (1U << 4)
+#define ESP32S31_PMA_NAPOT           0xC0000000U
+
+/* PSRAM XIP window. Size is power-of-2 and the base is naturally
+ * aligned, so the range is NAPOT-encodable. */
+#define ESP32S31_PMA_PSRAM_BASE      0x50000000U
+#define ESP32S31_PMA_PSRAM_SIZE      0x04000000U
+#define ESP32S31_PMA_PSRAM_NAPOT_ADDR \
+	((ESP32S31_PMA_PSRAM_BASE | ((ESP32S31_PMA_PSRAM_SIZE >> 1) - 1U)) >> 2)
+#define ESP32S31_PMA_PSRAM_CFG \
+	(ESP32S31_PMA_NAPOT | ESP32S31_PMA_R | ESP32S31_PMA_W | \
+	 ESP32S31_PMA_X | ESP32S31_PMA_EN)
+
+/* Entry index used for the PSRAM overlay. */
+#define ESP32S31_PMA_PSRAM_ENTRY     7
+
+/* Slack over the source dtb for the generic platform's in-place fixups. */
+#define S31_FIXUP_FDT_SIZE	0x3000
+
+/* LP_AONCLKRST_HPCORE0_RESET_CTRL_REG @ 0x2070103C — bit 20 is the
+ * write-to-trigger HP core 0 software reset, used to service SBI
+ * shutdown / reboot requests. */
+#define LP_AONCLKRST_HPCORE0_RESET_CTRL_REG  0x2070103CU
+#define HPCORE_SW_RESET                      (1U << 20)
+
+static int s31_system_reset_check(u32 type, u32 reason)
+{
+	switch (type) {
+	case SBI_SRST_RESET_TYPE_COLD_REBOOT:
+	case SBI_SRST_RESET_TYPE_WARM_REBOOT:
+	case SBI_SRST_RESET_TYPE_SHUTDOWN:
+		return 1;
+	}
+	return 0;
+}
+
+static void s31_system_reset(u32 type, u32 reason)
+{
+	writel(HPCORE_SW_RESET, (void *)LP_AONCLKRST_HPCORE0_RESET_CTRL_REG);
+
+	/* If the reset doesn't take effect (e.g. shutdown on a chip with no
+	 * power-down path), spin in WFI so we don't return into garbage. */
+	while (1)
+		__asm__ __volatile__("wfi");
+}
+
+static struct sbi_system_reset_device s31_reset = {
+	.name               = "esp32s31-reset",
+	.system_reset_check = s31_system_reset_check,
+	.system_reset       = s31_system_reset,
+};
+
+/* Add higher-priority PMA entry 7 (NAPOT, RWX) over the PSRAM XIP window. */
+static void s31_pma_init(void)
+{
+	csr_write(ESP32S31_PMAADDR0_CSR + ESP32S31_PMA_PSRAM_ENTRY,
+		  ESP32S31_PMA_PSRAM_NAPOT_ADDR);
+	csr_write(ESP32S31_PMACFG0_CSR + ESP32S31_PMA_PSRAM_ENTRY,
+		  ESP32S31_PMA_PSRAM_CFG);
+}
+
+/* The SPL supplies a writable PSRAM FDT; its header declares its capacity.
+ * Generic fixups use a temporary M-only buffer and may expand it in-place.
+ */
+static unsigned long s31_uboot_dtb;
+static unsigned int s31_uboot_dtb_size;
+static void *s31_fdt_buffer;
+static int esp32s31_early_init(bool cold_boot)
+{
+	void *fbuf;
+	int rc;
+
+	s31_pma_init();
+	if (!cold_boot)
+		return generic_early_init(false);
+	rc = generic_early_init(true);
+	if (rc)
+		return rc;
+	sbi_printf("OpenSBI: ESP32-S31 firmware active\n");
+
+	s31_uboot_dtb = root.next_arg1;
+	if (fdt_check_header((void *)s31_uboot_dtb))
+		return SBI_EINVAL;
+	s31_uboot_dtb_size = fdt_totalsize((void *)s31_uboot_dtb);
+	if (s31_uboot_dtb_size > S31_FIXUP_FDT_SIZE)
+		return SBI_ENOSPC;
+	if (fdt_check_full((void *)s31_uboot_dtb, s31_uboot_dtb_size))
+		return SBI_EINVAL;
+	fbuf = sbi_malloc(S31_FIXUP_FDT_SIZE);
+	if (!fbuf)
+		return SBI_ENOMEM;
+	if (fdt_open_into((void *)s31_uboot_dtb, fbuf, s31_uboot_dtb_size) ||
+	    fdt_pack(fbuf)) {
+		sbi_free(fbuf);
+		return SBI_EINVAL;
+	}
+	s31_fdt_buffer = fbuf;
+	fdt_fixup_buffer_begin(fbuf, S31_FIXUP_FDT_SIZE);
+	root.next_arg1 = (unsigned long)fbuf;
+	s31_apm_init();
+	sbi_system_reset_add_device(&s31_reset);
+	s31_hsm_register();
+	return 0;
+}
+
+static int esp32s31_final_init(bool cold_boot)
+{
+	int rc = generic_final_init(cold_boot);
+	bool fixup_failed;
+
+	if (!cold_boot)
+		return rc;
+	fixup_failed = fdt_fixup_buffer_end();
+	if (rc || fixup_failed) {
+		if (!rc)
+			rc = SBI_ENOSPC;
+		goto fail;
+	}
+	/* Compact the fixed-up tree and copy it back only within the capacity
+	 * declared by the SPL. The SPL must provide padding for fixups. */
+	if (fdt_pack(s31_fdt_buffer) ||
+	    fdt_open_into(s31_fdt_buffer, (void *)s31_uboot_dtb,
+			  s31_uboot_dtb_size)) {
+		rc = SBI_ENOSPC;
+		goto fail;
+	}
+	s31_tee_supervisor_priv_sel_to_m();
+	root.next_arg1 = s31_uboot_dtb;
+	sbi_scratch_thishart_ptr()->next_arg1 = s31_uboot_dtb;
+	sbi_free(s31_fdt_buffer);
+	s31_fdt_buffer = NULL;
+	return 0;
+fail:
+	root.next_arg1 = s31_uboot_dtb;
+	sbi_free(s31_fdt_buffer);
+	s31_fdt_buffer = NULL;
+	return rc;
+}
+
+/* Vendor SBI extension: DMA cache maintenance. */
+#define S31_SBI_CACHE_WBACK        0
+#define S31_SBI_CACHE_INVAL        1
+#define S31_SBI_CACHE_WBACK_INVAL  2
+#define S31_SBI_ICACHE_SYNC        3
+#define S31_SBI_ICACHE_SYNC_RANGE  4
+#define S31_SBI_DCACHE_WBACK_ALL   5
+
+static int esp32s31_vendor_ext_provider(long funcid,
+					struct sbi_trap_regs *regs,
+					struct sbi_ecall_return *out)
+{
+	u32 vaddr = (u32)regs->a0;
+	u32 size  = (u32)regs->a1;
+
+	/* Reject out-of-window ranges from S-mode: an address outside the
+	 * flash/PSRAM windows faults M-mode inside the ROM Cache_*_Addr
+	 * helpers. The whole-cache sync (funcid 3) takes no address. */
+	switch (funcid) {
+	case S31_SBI_CACHE_WBACK:
+	case S31_SBI_CACHE_INVAL:
+	case S31_SBI_CACHE_WBACK_INVAL:
+	case S31_SBI_ICACHE_SYNC_RANGE:
+		if (!s31_cache_range_valid(vaddr, size))
+			return SBI_ERR_INVALID_PARAM;
+		break;
+	}
+
+	switch (funcid) {
+	case S31_SBI_CACHE_WBACK:
+		s31_dcache_writeback(vaddr, size);
+		break;
+	case S31_SBI_CACHE_INVAL:
+		s31_dcache_invalidate(vaddr, size);
+		break;
+	case S31_SBI_CACHE_WBACK_INVAL:
+		s31_dcache_writeback_invalidate(vaddr, size);
+		break;
+	case S31_SBI_ICACHE_SYNC:
+		s31_icache_sync_all();
+		break;
+	case S31_SBI_ICACHE_SYNC_RANGE:
+		s31_icache_sync_range(vaddr, size);
+		break;
+	case S31_SBI_DCACHE_WBACK_ALL:
+		s31_dcache_writeback_all();
+		break;
+	default:
+		return SBI_ENOTSUPP;
+	}
+
+	out->value = 0;
+	return 0;
+}
+
+static const struct fdt_match esp32s31_match[] = {
+	{ .compatible = "espressif,esp32s31" },
+	{ /* sentinel */ }
+};
+
+static int esp32s31_platform_init(const void *fdt, int nodeoff,
+				   const struct fdt_match *match)
+{
+	generic_platform_ops.early_init = esp32s31_early_init;
+	generic_platform_ops.final_init = esp32s31_final_init;
+	generic_platform_ops.vendor_ext_provider = esp32s31_vendor_ext_provider;
+	return 0;
+}
+
+const struct fdt_driver esp32s31 = {
+	.match_table = esp32s31_match,
+	.init = esp32s31_platform_init,
+};
diff --git a/platform/generic/espressif/esp32s31/hsm.c b/platform/generic/espressif/esp32s31/hsm.c
new file mode 100644
index 0000000..5e364d3
--- /dev/null
+++ b/platform/generic/espressif/esp32s31/hsm.c
@@ -0,0 +1,81 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ */
+
+#include <sbi/riscv_asm.h>
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_hsm.h>
+
+#include "platform.h"
+
+#include "rom.h"
+
+/* HP_SYS_CLKRST_HPCORE1_CTRL0 */
+#define S31_HPCORE1_CTRL0_REG		0x20587020U
+#define S31_HPCORE1_CLIC_CLK_EN		(1U << 0)
+#define S31_HPCORE1_CPU_CLK_EN		(1U << 1)
+#define S31_HPCORE1_GLOBAL_RST_EN	(1U << 2)
+
+/*
+ * PMU_CPU_STALL_SW_REG (DR_REG_PMU_BASE + 0x1ec). HPCORE1's stall code is
+ * bits[23:16] (core0's is bits[31:24]). Magic values per IDF
+ * hal/cpu_utility_ll.h: 0x86 stalls, 0xFF releases. Note this is NOT
+ * LP_AONCLKRST_HPCORE1_RESET_CTRL_REG
+ */
+#define S31_PMU_CPU_STALL_SW_REG	0x207041ECU
+#define S31_HART1_STALL_SHIFT		16
+#define S31_HART1_STALL_MASK		(0xFFU << S31_HART1_STALL_SHIFT)
+#define S31_HART1_UNSTALL_CODE		(0xFFU << S31_HART1_STALL_SHIFT)
+
+static int s31_hart_start(u32 hartid, ulong saddr)
+{
+	u32 v;
+
+	if (hartid != 1)
+		return SBI_EINVAL;
+
+	ROM_Ets_Set_Cpu_Boot_Addr(0);
+
+	/* Release the software stall (RMW: core0's code shares this word). */
+	v = readl((void *)S31_PMU_CPU_STALL_SW_REG);
+	v = (v & ~S31_HART1_STALL_MASK) | S31_HART1_UNSTALL_CODE;
+	writel(v, (void *)S31_PMU_CPU_STALL_SW_REG);
+
+	/* Clocks on, then reset off. RMW to preserve sticky bits. */
+	v = readl((void *)S31_HPCORE1_CTRL0_REG);
+	v |= S31_HPCORE1_CLIC_CLK_EN | S31_HPCORE1_CPU_CLK_EN;
+	v &= ~S31_HPCORE1_GLOBAL_RST_EN;
+	writel(v, (void *)S31_HPCORE1_CTRL0_REG);
+
+	ROM_Ets_Set_Cpu_Boot_Addr(saddr);
+
+	return 0;
+}
+
+static int s31_hart_stop(void)
+{
+	u32 v;
+
+	if (current_hartid() != 1)
+		return SBI_ENOTSUPP;
+
+	v = readl((void *)S31_HPCORE1_CTRL0_REG);
+	v &= ~(S31_HPCORE1_CLIC_CLK_EN | S31_HPCORE1_CPU_CLK_EN);
+	v |= S31_HPCORE1_GLOBAL_RST_EN;
+	writel(v, (void *)S31_HPCORE1_CTRL0_REG);
+
+	while (1)
+		wfi();
+}
+
+static const struct sbi_hsm_device s31_hsm = {
+	.name		= "esp32s31-hsm",
+	.hart_start	= s31_hart_start,
+	.hart_stop	= s31_hart_stop,
+};
+
+void s31_hsm_register(void)
+{
+	sbi_hsm_set_device(&s31_hsm);
+}
