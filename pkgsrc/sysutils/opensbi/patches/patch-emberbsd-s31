diff --git a/lib/utils/serial/esp_uart.c b/lib/utils/serial/esp_uart.c
new file mode 100644
index 0000000..a3c17f5
--- /dev/null
+++ b/lib/utils/serial/esp_uart.c
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: BSD-2-Clause
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_console.h>
+#include <sbi_utils/serial/esp_uart.h>
+
+static unsigned long esp_uart_base;
+
+void esp_uart_putc(char ch)
+{
+    while (((readl((unsigned int *)(esp_uart_base + UART_STATUS_OFF)) >> UART_STATUS_TX_CNT_S) & UART_STATUS_TX_CNT_M) >= UART_FIFO_FULL_CNT) {}
+    writel(ch, (unsigned int *)(esp_uart_base + UART_FIFO_OFF));
+}
+
+int esp_uart_getc(void)
+{
+    /* Check the RX FIFO count first: reading the FIFO when it is empty
+     * returns undefined data, indistinguishable from a real received NUL. */
+    unsigned int status = readl((unsigned int *)(esp_uart_base + UART_STATUS_OFF));
+
+    if (((status >> UART_STATUS_RX_CNT_S) & UART_STATUS_RX_CNT_M) == 0)
+        return -1;
+
+    return readl((unsigned int *)(esp_uart_base + UART_FIFO_OFF)) & 0xFF;
+}
+
+static struct sbi_console_device esp_console = {
+    .name = "espressif uart",
+    .console_putc = esp_uart_putc,
+    .console_getc = esp_uart_getc
+};
+
+int esp_uart_init(unsigned long base)
+{
+    esp_uart_base = base;
+    sbi_console_set_device(&esp_console);
+    return 0;
+}
