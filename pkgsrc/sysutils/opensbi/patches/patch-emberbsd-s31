diff --git a/platform/generic/espressif/esp32s31/rom.h b/platform/generic/espressif/esp32s31/rom.h
new file mode 100644
index 0000000..5e54b5e
--- /dev/null
+++ b/platform/generic/espressif/esp32s31/rom.h
@@ -0,0 +1,39 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * ESP32-S31 mask-ROM entry points used from M-mode.
+ *
+ * The chip ROM exports a fixed function table; addresses are chip
+ * constants from the ROM's own linker map. Only the cache-maintenance
+ * helpers and CPU1's boot-address setter are needed here — the SPL owns
+ * cache/flash-MMU bring-up and any other ROM entry points it needs (see
+ * esp-uboot's own rom.h).
+ */
+
+#ifndef _ESP32S31_ROM_H_
+#define _ESP32S31_ROM_H_
+
+#include <sbi/sbi_bitops.h>
+#include <sbi/sbi_types.h>
+
+/* Range cache maintenance (map, vaddr, size). */
+typedef int (*rom_cache_range_fn_t)(uint32_t map, uint32_t vaddr, uint32_t size);
+#define ROM_Cache_Invalidate_Addr          ((rom_cache_range_fn_t)0x2F8005E8U)
+#define ROM_Cache_WriteBack_Addr           ((rom_cache_range_fn_t)0x2F8005F0U)
+
+/* Whole-cache maintenance (map arg). */
+typedef int (*rom_cache_all_fn_t)(uint32_t map);
+#define ROM_Cache_WriteBack_All            ((rom_cache_all_fn_t)0x2F800600U)
+#define ROM_Cache_Invalidate_All           ((rom_cache_all_fn_t)0x2F8005F8U)
+
+/* The map argument selects the L1 caches to act on. */
+#define CACHE_MAP_L1_ICACHE_0               BIT(0)
+#define CACHE_MAP_L1_ICACHE_1               BIT(1)
+#define CACHE_MAP_L1_ICACHE                 (CACHE_MAP_L1_ICACHE_0 | CACHE_MAP_L1_ICACHE_1)
+#define CACHE_MAP_L1_DCACHE                  BIT(4)
+
+/* Set the address CPU1's ROM jumps to once it leaves reset. */
+typedef void (*rom_set_cpu_boot_addr_fn_t)(uint32_t addr);
+#define ROM_Ets_Set_Cpu_Boot_Addr          ((rom_set_cpu_boot_addr_fn_t)0x2F8000A8U)
+
+#endif /* _ESP32S31_ROM_H_ */
