diff --git a/platform/generic/espressif/esp32s31/apm.c b/platform/generic/espressif/esp32s31/apm.c
new file mode 100644
index 0000000..c14eb9f
--- /dev/null
+++ b/platform/generic/espressif/esp32s31/apm.c
@@ -0,0 +1,111 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * ESP32-S31 APM (Access Permission Manager).
+ */
+
+#include <sbi/riscv_io.h>
+
+#include "platform.h"
+
+/* APM controller bases:
+ *   TEE       @ 0x20504000  master security-mode router
+ *   HP_APM    @ 0x20504400  HP-bus peripheral filter, 16 regions, 7 paths
+ *   HP_MEM_APM@ 0x20504800  HP-mem (HP RAM / cache) filter, 8 regions, 6 paths
+ *   CPU_APM   @ 0x20504C00  HP-CPU filter (covers 0x40000000-0x5FFFFFFF
+ *                            Flash+PSRAM XIP window), 8 regions, 4 paths
+ *   LP_TEE    @ 0x20706800
+ *   LP_APM    @ 0x20706C00  LP-bus filter, 8 regions, 4 paths
+ *
+ * Per-controller register offsets are uniform:
+ *   +0x00  REGION_FILTER_EN  (one bit per region, default 0x01)
+ *   +0x04  REGION0_ADDR_START
+ *   +0x08  REGION0_ADDR_END
+ *   +0x0C  REGION0_ATTR (LOCK@16, TEE_RWX@[14:12], REE2_RWX@[10:8],
+ *                       REE1_RWX@[6:4], REE0_RWX@[2:0])
+ *   stride 0xC for further regions
+ *   +0xC4  FUNC_CTRL (per-master/path enable; defaults all 1)
+ *   (LP_APM FUNC_CTRL is at +0xBC; only LP_APM is irregular.)
+ */
+#define ESP32S31_TEE_BASE                0x20504000U
+#define ESP32S31_HP_APM_BASE             0x20504400U
+#define ESP32S31_HP_MEM_APM_BASE         0x20504800U
+#define ESP32S31_CPU_APM_BASE            0x20504C00U
+#define ESP32S31_LP_APM_BASE             0x20706C00U
+
+#define ESP32S31_APM_REGION_FILTER_EN_OFF    0x00
+#define ESP32S31_APM_REGION0_ATTR_OFF        0x0C
+#define ESP32S31_APM_REGION_STRIDE           0x0C
+/* Signed offsets from REGION_ATTR to START/END for the same region. */
+#define ESP32S31_APM_REGION_START_REL        (-0x08)
+#define ESP32S31_APM_REGION_END_REL          (-0x04)
+#define ESP32S31_APM_FUNC_CTRL_OFF           0xC4
+#define ESP32S31_LP_APM_FUNC_CTRL_OFF        0xBC
+
+/* ATTR field layout: a 3-bit RWX nibble per sec-mode at bits
+ * [2:0]=REE0, [6:4]=REE1, [10:8]=REE2, [14:12]=TEE. 0x7 = R|W|X. */
+#define ESP32S31_APM_ATTR_ALL_RWX        0x7777U
+
+/* TEE supervisor-mode privilege mapping. Maps
+ * each HP core's S-mode to the TEE access-path of U-mode (reset value)
+ * or M-mode. With the reset default, mret-to-S silently hangs on real
+ * silicon — the CPU does not resume at next_addr. Setting bit-per-core
+ * unblocks S-mode at the cost of TEE/REE isolation against S-mode
+ * payloads, acceptable for our single-tenant OpenSBI -> S-mode flow. */
+#define ESP32S31_TEE_SUPERVISOR_PRIV_SEL_REG  (ESP32S31_TEE_BASE + 0x200)
+#define ESP32S31_TEE_CORE0_SUPER_AS_M         (1U << 0)
+#define ESP32S31_TEE_CORE1_SUPER_AS_M         (1U << 1)
+
+#define APM_ALLOW_ADDR_START_MAX     0x00000000U
+#define APM_ALLOW_ADDR_END_MAX       0xFFFFFFFFU
+
+/* APM_LL_*_MAX_REGION / MAX_ACCESS_PATH from the ROM HAL. */
+static const struct apm_ctrl {
+	u32 base;
+	u32 n_regions;
+	u32 path_mask;
+	u32 func_ctrl_off;
+} apm_ctrls[] = {
+	{ ESP32S31_CPU_APM_BASE,    8,  0x0F, ESP32S31_APM_FUNC_CTRL_OFF },
+	{ ESP32S31_HP_APM_BASE,     16, 0x7F, ESP32S31_APM_FUNC_CTRL_OFF },
+	{ ESP32S31_HP_MEM_APM_BASE, 8,  0x3F, ESP32S31_APM_FUNC_CTRL_OFF },
+	{ ESP32S31_LP_APM_BASE,     8,  0x0F, ESP32S31_LP_APM_FUNC_CTRL_OFF },
+};
+
+static void apm_grant_all(const struct apm_ctrl *c)
+{
+	u32 i, attr_reg;
+
+	for (i = 0; i < c->n_regions; i++) {
+		attr_reg = c->base + ESP32S31_APM_REGION0_ATTR_OFF +
+			   ESP32S31_APM_REGION_STRIDE * i;
+		writel(APM_ALLOW_ADDR_START_MAX,
+		       (void *)(attr_reg + ESP32S31_APM_REGION_START_REL));
+		writel(APM_ALLOW_ADDR_END_MAX,
+		       (void *)(attr_reg + ESP32S31_APM_REGION_END_REL));
+		writel(ESP32S31_APM_ATTR_ALL_RWX, (void *)attr_reg);
+	}
+
+	writel((1U << c->n_regions) - 1U,
+	       (void *)(c->base + ESP32S31_APM_REGION_FILTER_EN_OFF));
+	writel(c->path_mask, (void *)(c->base + c->func_ctrl_off));
+}
+
+void s31_apm_init(void)
+{
+	u32 i;
+
+	for (i = 0; i < array_size(apm_ctrls); i++)
+		apm_grant_all(&apm_ctrls[i]);
+}
+
+/* TEE_SUPERVISOR_PRIV_SEL: empirically must be flipped AFTER OpenSBI's
+ * banner prints. Setting it during s31_early_init wedges subsequent
+ * M-mode UART output (TEE module appears to pulse peripheral-access
+ * plumbing on this bit's edge; the UART status read in esp_uart_putc
+ * then spins). Banner-then-flip works reliably. */
+void s31_tee_supervisor_priv_sel_to_m(void)
+{
+	writel(ESP32S31_TEE_CORE0_SUPER_AS_M | ESP32S31_TEE_CORE1_SUPER_AS_M,
+	       (void *)ESP32S31_TEE_SUPERVISOR_PRIV_SEL_REG);
+}
diff --git a/platform/generic/espressif/esp32s31/cache_mmu.c b/platform/generic/espressif/esp32s31/cache_mmu.c
new file mode 100644
index 0000000..64d0b23
--- /dev/null
+++ b/platform/generic/espressif/esp32s31/cache_mmu.c
@@ -0,0 +1,89 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * ESP32-S31 DMA cache maintenance for the external-memory (flash/PSRAM)
+ * L1 cache, exposed to S-mode via the platform vendor SBI ecall.
+ *
+ * The flash and PSRAM share one cache controller with no fence.i/Zicbom
+ * reach, so S-mode (Linux, U-Boot) delegates writeback/invalidate to these
+ * M-mode helpers. The cache/flash-MMU *bring-up* is done earlier by the
+ * U-Boot SPL, not here. Entry-point addresses come from the chip ROM
+ * link map.
+ */
+
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_console.h>
+#include <sbi/sbi_types.h>
+
+#include "cache_mmu.h"
+#include "config.h"
+#include "rom.h"
+
+/* True iff [vaddr, vaddr+size) lies wholly within the flash XIP window or
+ * wholly within the PSRAM window (overflow-safe, no straddle). The ROM
+ * Cache_*_Addr helpers fault M-mode on an out-of-window address, so the
+ * vendor ecall provider must reject S-mode-supplied ranges that fail this
+ * before dispatching any cache op. */
+bool s31_cache_range_valid(u32 vaddr, u32 size)
+{
+	if (size == 0)
+		return false;
+	if (vaddr >= FLASH_START && size <= FLASH_SIZE &&
+	    vaddr - FLASH_START <= FLASH_SIZE - size)
+		return true;
+	if (vaddr >= PSRAM_START && size <= PSRAM_SIZE &&
+	    vaddr - PSRAM_START <= PSRAM_SIZE - size)
+		return true;
+	return false;
+}
+
+/* DMA cache maintenance over the external-memory (flash/PSRAM) L1 D-cache,
+ * exposed to S-mode via the platform vendor SBI ecall (see platform.c). */
+void s31_dcache_writeback(u32 vaddr, u32 size)
+{
+	if (size)
+		ROM_Cache_WriteBack_Addr(CACHE_MAP_L1_DCACHE, vaddr, size);
+}
+
+void s31_dcache_invalidate(u32 vaddr, u32 size)
+{
+	if (size)
+		ROM_Cache_Invalidate_Addr(CACHE_MAP_L1_DCACHE, vaddr, size);
+}
+
+void s31_dcache_writeback_invalidate(u32 vaddr, u32 size)
+{
+	if (!size)
+		return;
+	ROM_Cache_WriteBack_Addr(CACHE_MAP_L1_DCACHE, vaddr, size);
+	ROM_Cache_Invalidate_Addr(CACHE_MAP_L1_DCACHE, vaddr, size);
+}
+
+/* Whole-cache D writeback (no invalidate), e.g. U-Boot's flush_dcache_all. */
+void s31_dcache_writeback_all(void)
+{
+	ROM_Cache_WriteBack_All(CACHE_MAP_L1_DCACHE);
+}
+
+/* Whole-cache writeback-D + invalidate-I, for Linux flush_icache_all (no range). */
+void s31_icache_sync_all(void)
+{
+	ROM_Cache_WriteBack_All(CACHE_MAP_L1_DCACHE);
+	ROM_Cache_Invalidate_All(CACHE_MAP_L1_ICACHE);
+}
+
+/* Range variant, per exec page from flush_icache_pte. Flash is read-only (no
+ * dirty DCache) so it only needs ICache invalidated; PSRAM exec pages need
+ * writeback-D first. Skip vaddrs outside the windows (a bad ROM Cache_*_Addr
+ * faults M-mode); per-page calls don't straddle the flash/PSRAM boundary. */
+void s31_icache_sync_range(u32 vaddr, u32 size)
+{
+	bool in_flash = vaddr >= FLASH_START && vaddr - FLASH_START < FLASH_SIZE;
+	bool in_psram = vaddr >= PSRAM_START && vaddr - PSRAM_START < PSRAM_SIZE;
+
+	if (!size || (!in_flash && !in_psram))
+		return;
+	if (in_psram)
+		s31_dcache_writeback(vaddr, size);
+	ROM_Cache_Invalidate_Addr(CACHE_MAP_L1_ICACHE, vaddr, size);
+}
