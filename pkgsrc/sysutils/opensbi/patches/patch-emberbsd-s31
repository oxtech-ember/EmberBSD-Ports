diff --git a/lib/utils/irqchip/fdt_irqchip_clic.c b/lib/utils/irqchip/fdt_irqchip_clic.c
new file mode 100644
index 0000000..5a341b0
--- /dev/null
+++ b/lib/utils/irqchip/fdt_irqchip_clic.c
@@ -0,0 +1,98 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * CLIC v0.9 FDT irqchip driver: enables S-mode privilege selection
+ * (cliccfg.nmbits=2 on S31 rev0.0) and delegates selected sources to S-mode.
+ * Per-chip source policy comes from match-table quirks data.
+ */
+
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_irqchip.h>
+#include <sbi/sbi_scratch.h>
+#include <sbi_utils/fdt/fdt_helper.h>
+#include <sbi_utils/irqchip/clic.h>
+#include <sbi_utils/irqchip/fdt_irqchip.h>
+
+struct clic_quirks {
+	u32 smode_src_first;	/* first/last CLIC source delegated to S-mode */
+	u32 smode_src_last;
+};
+
+static const struct clic_quirks esp_clic_quirks = {
+	.smode_src_first = 16,	/* INTMTX-routed external slots */
+	.smode_src_last  = 47,
+};
+
+static unsigned long clic_base;
+static const struct clic_quirks *clic_quirks;
+
+static int irqchip_clic_warm_init(struct sbi_irqchip_device *dev)
+{
+	u32 cfg, i;
+
+	if (!clic_base || !clic_quirks)
+		return SBI_EINVAL;
+
+	/* The measured rev0.0 layout enables M/S/U routing with nmbits=2.
+	 * Check actual readback; ESP-IDF's register description differs. */
+	writel(CLICCFG_S31_VALUE, (void *)clic_base);
+	cfg = readl((void *)clic_base);
+	if ((cfg & (CLICCFG_NMBITS_MASK | 0x0fU)) != CLICCFG_S31_VALUE)
+		return SBI_ENOTSUPP;
+
+	/* Delegate the platform's peripheral sources: S-mode at max
+	 * priority but masked (ie=0), left for S-mode to enable. */
+	for (i = clic_quirks->smode_src_first;
+	     i <= clic_quirks->smode_src_last; i++) {
+		clic_set_source((void *)clic_base, i,
+				CLIC_ATTR_S_LEVEL, CLIC_CTL_MAX_PRIO, 0);
+		/* S31 documentation describes mode as read-only on some revisions. */
+		if ((readb((u8 *)clic_base + CLIC_INTATTR_OFF(i)) &
+		    CLIC_ATTR_MODE_MASK) != CLIC_ATTR_S_LEVEL)
+			return SBI_ENOTSUPP;
+	}
+
+	return 0;
+}
+
+static struct sbi_irqchip_device clic_device = {
+	.warm_init = irqchip_clic_warm_init,
+};
+
+/*
+ * Discovery only. sbi_irqchip_init() calls the warm_init hooks straight after
+ * this on the same hart, so the boot hart's bank is still programmed during
+ * cold boot.
+ */
+static int irqchip_clic_cold_init(const void *fdt, int nodeoff,
+				  const struct fdt_match *match)
+{
+	uint64_t addr;
+	int rc;
+
+	if (!match->data)
+		return SBI_EINVAL;
+
+	rc = fdt_get_node_addr_size(fdt, nodeoff, 0, &addr, NULL);
+	if (rc)
+		return rc;
+
+	clic_base = addr;
+	clic_quirks = match->data;
+
+	clic_device.num_hwirq = clic_quirks->smode_src_last + 1;
+	sbi_for_each_hartindex(i)
+		sbi_hartmask_set_hartindex(i, &clic_device.target_harts);
+	return sbi_irqchip_add_device(&clic_device);
+}
+
+static const struct fdt_match irqchip_clic_match[] = {
+	{ .compatible = "espressif,esp-clic", .data = &esp_clic_quirks },
+	{ /* sentinel */ }
+};
+
+const struct fdt_driver fdt_irqchip_clic = {
+	.match_table = irqchip_clic_match,
+	.init = irqchip_clic_cold_init,
+};
