diff --git a/include/sbi_utils/irqchip/clic.h b/include/sbi_utils/irqchip/clic.h
new file mode 100644
index 0000000..4bae594
--- /dev/null
+++ b/include/sbi_utils/irqchip/clic.h
@@ -0,0 +1,60 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * RISC-V CLIC v0.9 register layout: a memory-mapped per-source byte
+ * array within each CLIC instance (bank). Consumed by both the CLIC FDT
+ * irqchip driver and the CLINT-backed S-timer driver.
+ */
+
+#ifndef __IRQCHIP_CLIC_H__
+#define __IRQCHIP_CLIC_H__
+
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_types.h>
+
+/*
+ * Spec-fixed offset of the per-source control array within a CLIC
+ * instance; each source is 4 bytes:
+ *   +0 clicintip  +1 clicintie  +2 clicintattr  +3 clicintctl
+ */
+#define CLIC_CTRL_OFFSET        0x1000U
+
+/* ESP32-S31 rev0.0 measured CLIC layout (BSD-2-Clause):
+ * Marco Müller, annoyedmilk/esp32-s31-linux 086e52a6,
+ * opensbi/platform/esp32s31/platform.c.
+ * nmbits[5:4]=2 enables S-mode; mnlbits[3:0]=3, snlbits=0.
+ * ESP-IDF d445e947 describes a different, older register layout.
+ */
+#define CLICCFG_NMBITS_MASK     0x00000030U
+#define CLICCFG_S31_VALUE       0x00000023U
+#define CLIC_ATTR_MODE_MASK     0xc0U
+
+#define CLIC_INTIP_OFF(s)       (CLIC_CTRL_OFFSET + (s) * 4 + 0)
+#define CLIC_INTIE_OFF(s)       (CLIC_CTRL_OFFSET + (s) * 4 + 1)
+#define CLIC_INTATTR_OFF(s)     (CLIC_CTRL_OFFSET + (s) * 4 + 2)
+#define CLIC_INTCTL_OFF(s)      (CLIC_CTRL_OFFSET + (s) * 4 + 3)
+
+/* clicintattr byte: bits[7:6]=mode (0x40 = Supervisor), bits[2:1]=trigger
+ * (00 = level), bit 0 = SHV (0 = no hardware vectoring). */
+#define CLIC_ATTR_S_LEVEL       0x40U
+/* clicintctl byte: high level/priority (ctlbits=3). A source left at 0 may
+ * sit below the S-mode delivery threshold and never be taken. */
+#define CLIC_CTL_MAX_PRIO       0xE0U
+
+/*
+ * Program one CLIC source on the given bank: clear pending, set the
+ * mode/trigger attr and the priority ctl, then set the enable LAST so the
+ * source never goes live with a stale attr/ctl. nmbits=2 must already be
+ * set for the mode field to be writable. Pass ie=0 to delegate a source
+ * while leaving it masked.
+ */
+static inline void clic_set_source(u8 *bank, unsigned int id,
+				   u8 attr, u8 ctl, u8 ie)
+{
+	writeb(0,    bank + CLIC_INTIP_OFF(id));
+	writeb(attr, bank + CLIC_INTATTR_OFF(id));
+	writeb(ctl,  bank + CLIC_INTCTL_OFF(id));
+	writeb(ie,   bank + CLIC_INTIE_OFF(id));
+}
+
+#endif
