@@ -18,6 +18,43 @@
 #include <sbi_utils/irqchip/imsic.h>
 #include <sbi_utils/irqchip/plic.h>
 
+/* Optional bounds for the single cold-boot FDT fixup transaction. */
+static void *fixup_buffer;
+static int fixup_capacity;
+static bool fixup_failed;
+
+void fdt_fixup_buffer_begin(void *buffer, int capacity)
+{
+	fixup_buffer = buffer;
+	fixup_capacity = capacity;
+	fixup_failed = false;
+}
+
+bool fdt_fixup_buffer_end(void)
+{
+	bool failed = fixup_failed;
+
+	fixup_buffer = NULL;
+	fixup_capacity = 0;
+	fixup_failed = false;
+	return failed;
+}
+
+int fdt_fixup_open_into(const void *fdt, void *buf, int size)
+{
+	int rc;
+
+	if (fixup_buffer && buf == fixup_buffer &&
+	    (size < 0 || size > fixup_capacity)) {
+		fixup_failed = true;
+		return -FDT_ERR_NOSPACE;
+	}
+	rc = fdt_open_into(fdt, buf, size);
+	if (fixup_buffer && buf == fixup_buffer && rc)
+		fixup_failed = true;
+	return rc;
+}
