// SPDX-License-Identifier: GPL-2.0+
/dts-v1/;
/ {
    description = "ESP32-S31 NOR firmware and RAM root";
    #address-cells = <1>;
    images {
        firmware { description = "OpenSBI dynamic"; data = /incbin/("opensbi.bin"); type = "firmware"; arch = "riscv"; os = "opensbi"; compression = "none"; load = <0x2f000000>; entry = <0x2f000000>; hash { algo = "sha256"; }; };
        uboot { description = "U-Boot proper"; data = /incbin/("u-boot.bin"); type = "firmware"; arch = "riscv"; os = "u-boot"; compression = "none"; load = <0x50400000>; entry = <0x50400000>; hash { algo = "sha256"; }; };
        fdt { description = "Firmware FDT"; data = /incbin/("firmware.dtb"); type = "flat_dt"; arch = "riscv"; compression = "none"; load = <0x50430000>; hash { algo = "sha256"; }; };
        root { description = "RAM root filesystem"; data = /incbin/("root.fs"); type = "firmware"; arch = "riscv"; compression = "none"; load = <0x50000000>; hash { algo = "sha256"; }; };
        kernel { description = "Nested kernel FIT"; data = /incbin/("kernel.itb"); type = "firmware"; arch = "riscv"; compression = "none"; load = <0x50c00000>; hash { algo = "sha256"; }; };
    };
    configurations {
        default = "conf";
        conf { description = "ESP32-S31 NOR"; firmware = "firmware"; fdt = "fdt"; loadables = "uboot", "root", "kernel"; };
    };
};
