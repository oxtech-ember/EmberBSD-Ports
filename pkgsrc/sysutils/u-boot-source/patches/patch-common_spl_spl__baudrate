$NetBSD$

--- a/common/spl/Kconfig
+++ b/common/spl/Kconfig
@@ -19,5 +19,16 @@ menu "SPL configuration options"
 	depends on SPL
 
+config SPL_BAUDRATE
+	int "SPL serial baudrate"
+	depends on SPL_SERIAL && SERIAL
+	depends on SPL_DM_SERIAL && CONSOLE_FLUSH_SUPPORT
+	default BAUDRATE
+	help
+	  Set the SPL serial console baudrate independently of U-Boot proper.
+	  The host uses this rate for SPL output and image transfer. When the
+	  rate differs from BAUDRATE, SPL flushes pending output and restores
+	  BAUDRATE before firmware handoff.
+
 config SPL_FRAMEWORK
 	bool "Support SPL based upon the common SPL framework"
 	default y
--- a/common/spl/spl.c
+++ b/common/spl/spl.c
@@ -757,13 +757,21 @@ void board_init_r(gd_t *dummy1, ulong dummy2)
 	ret = boot_from_devices(&spl_image, spl_boot_list,
 				ARRAY_SIZE(spl_boot_list));
 	if (ret) {
 		if (CONFIG_IS_ENABLED(SHOW_ERRORS))
 			printf(PHASE_PROMPT "failed to boot from all boot devices (err=%d)\n",
 			       ret);
 		else
 			puts(PHASE_PROMPT "failed to boot from all boot devices\n");
 		hang();
 	}
 
+#if defined(CONFIG_SPL_BUILD) && !defined(CONFIG_TPL_BUILD) && \
+	!defined(CONFIG_VPL_BUILD) && defined(CONFIG_SPL_BAUDRATE) && \
+	CONFIG_SPL_BAUDRATE != CONFIG_BAUDRATE
+	serial_flush();
+	gd->baudrate = CONFIG_BAUDRATE;
+	serial_setbrg();
+#endif
+
 	spl_perform_arch_fixups(&spl_image);
 	spl_perform_board_fixups(&spl_image);
@@ -861,6 +869,11 @@ void preloader_console_init(void)
 {
 #if CONFIG_IS_ENABLED(SERIAL)
+#if defined(CONFIG_SPL_BUILD) && !defined(CONFIG_TPL_BUILD) && \
+	!defined(CONFIG_VPL_BUILD) && defined(CONFIG_SPL_BAUDRATE)
+	gd->baudrate = CONFIG_SPL_BAUDRATE;
+#else
 	gd->baudrate = CONFIG_BAUDRATE;
+#endif
 
 	serial_init();		/* serial communications setup */
 
