 {
-    Q_UNUSED(pid);
-    Q_UNUSED(affinityMask);
-    return Processes::NotSupported;
+    cpuset_t *mask = cpuset_create();
+    if (mask == nullptr) {
+        return Processes::Unknown;
+    }
+    cpuset_zero(mask);
+    for (int cpu = 0; cpu < affinityMask.size(); ++cpu) {
+        if (affinityMask.testBit(cpu) && cpuset_set(cpu, mask) != 0) {
+            cpuset_destroy(mask);
+            return Processes::InvalidParameter;
+        }
+    }
+    const int result = _sched_setaffinity(pid, 0, cpuset_size(mask), mask);
+    const int error = errno;
+    cpuset_destroy(mask);
+    if (result == 0) {
+        return Processes::NoError;
+    }
+    switch (error) {
+    case EPERM:
+    case EACCES:
+        return Processes::InsufficientPermissions;
+    case ESRCH:
+        return Processes::ProcessDoesNotExistOrZombie;
+    case EINVAL:
+        return Processes::InvalidParameter;
+    default:
+        return Processes::Unknown;
+    }
 }
 
 QBitArray ProcessesLocal::getAffinity(long pid)
 {
-    Q_UNUSED(pid);
-    return {};
+    cpuset_t *mask = cpuset_create();
+    if (mask == nullptr) {
+        return {};
+    }
+    const size_t bytes = cpuset_size(mask);
+    if (_sched_getaffinity(pid, 0, bytes, mask) != 0) {
+        cpuset_destroy(mask);
+        return {};
+    }
+    QBitArray bits(bytes * 8);
+    for (int cpu = 0; cpu < bits.size(); ++cpu) {
+        if (cpuset_isset(cpu, mask) > 0) {
+            bits.setBit(cpu);
+        }
+    }
+    cpuset_destroy(mask);
+    return bits;
 }
 
