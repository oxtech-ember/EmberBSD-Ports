EmberBSD local portability repair, AI-assisted; not submitted upstream.
Retain warnings while omitting GCC-only options for the selected Clang.

--- generate/unix/Makefile.config.orig
+++ generate/unix/Makefile.config
@@ -251,10 +251,13 @@
     ifneq ($(ACPI_HOST), _APPLE)
         CWARNINGFLAGS += \
             -Woverride-init\
-            -Wlogical-op\
-            -Wmissing-parameter-type\
-            -Wold-style-declaration\
             -Wtype-limits
+        ifneq ($(ACPICA_CLANG),yes)
+            CWARNINGFLAGS += \
+                -Wlogical-op\
+                -Wmissing-parameter-type\
+                -Wold-style-declaration
+        endif
     endif
 endif
 
