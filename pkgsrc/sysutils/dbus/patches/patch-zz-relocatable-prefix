+/* Resolve configured prefix-owned paths using this shared libdbus image.
+ * Unknown layouts, static executables and unsupported platforms retain the
+ * configured path; explicitly external paths are never rewritten. */
+#if defined(HAVE_DBUS_DLADDR) && defined(DBUS_PREFIX) && defined(DBUS_LIBDIR)
+static const char _dbus_relocation_anchor = 0;
+
+/* Refuse non-canonical spelling instead of rewriting paths that can escape
+ * their configured prefix through dot components or duplicate separators. */
+static dbus_bool_t
+_dbus_relocation_safe_path (const char *path)
+{
+  const char *p = path;
+  if (p == NULL || *p != '/')
+    return FALSE;
+  while (*p != '\0')
+    {
+      const char *start;
+      size_t length;
+      if (*p++ != '/' || *p == '/' || *p == '\0')
+        return FALSE;
+      start = p;
+      while (*p != '\0' && *p != '/')
+        p++;
+      length = p - start;
+      if ((length == 1 && start[0] == '.') ||
+          (length == 2 && start[0] == '.' && start[1] == '.'))
+        return FALSE;
+    }
+  return TRUE;
+}
+
+/* Require a shared-library filename, not an executable with a prefix match. */
+static dbus_bool_t
+_dbus_relocation_is_library (const char *name)
+{
+  const char *suffix;
+  if (strncmp (name, "libdbus-1.", 10) != 0)
+    return FALSE;
+  suffix = name + 10;
+  if (strncmp (suffix, "so", 2) == 0)
+    {
+      suffix += 2;
+      if (*suffix == '\0')
+        return TRUE;
+      if (*suffix++ != '.')
+        return FALSE;
+      while (*suffix >= '0' && *suffix <= '9')
+        {
+          while (*suffix >= '0' && *suffix <= '9') suffix++;
+          if (*suffix == '\0') return TRUE;
+          if (*suffix++ != '.') return FALSE;
+        }
+      return FALSE;
+    }
+  if (strcmp (suffix, "dylib") == 0)
+    return TRUE;
+  while (*suffix >= '0' && *suffix <= '9')
+    {
+      while (*suffix >= '0' && *suffix <= '9') suffix++;
+      if (*suffix++ != '.') return FALSE;
+      if (strcmp (suffix, "dylib") == 0) return TRUE;
+    }
+  return FALSE;
+}
+
+#endif /* HAVE_DBUS_DLADDR and configured paths */
+
+dbus_bool_t
+_dbus_relocate_install_prefix (DBusString *path)
+{
+#if defined(HAVE_DBUS_DLADDR) && defined(DBUS_PREFIX) && defined(DBUS_LIBDIR)
+  Dl_info info;
+  char actual[PATH_MAX];
+  char *base, *last;
+  const char *lib_suffix;
+  size_t prefix_len = strlen (DBUS_PREFIX);
+  size_t suffix_len, actual_len;
+  DBusString runtime;
+  dbus_bool_t result;
+
+  if (!_dbus_relocation_safe_path (DBUS_PREFIX) ||
+      !_dbus_relocation_safe_path (DBUS_LIBDIR) ||
+      !_dbus_relocation_safe_path (_dbus_string_get_const_data (path)) ||
+      strncmp (DBUS_LIBDIR, DBUS_PREFIX, prefix_len) != 0 ||
+      DBUS_LIBDIR[prefix_len] != '/' ||
+      !_dbus_string_starts_with_c_str (path, DBUS_PREFIX "/"))
+    return TRUE;
+  lib_suffix = DBUS_LIBDIR + prefix_len;
+  suffix_len = strlen (lib_suffix);
+  if (dladdr ((const void *) &_dbus_relocation_anchor, &info) == 0 ||
+      info.dli_fname == NULL || realpath (info.dli_fname, actual) == NULL)
+    return TRUE;
+  base = strrchr (actual, '/');
+  if (base == NULL || !_dbus_relocation_is_library (base + 1))
+    return TRUE;
+  *base = '\0';
+  actual_len = strlen (actual);
+  if (actual_len <= suffix_len ||
+      strcmp (actual + actual_len - suffix_len, lib_suffix) != 0)
+    return TRUE;
+  last = actual + actual_len - suffix_len;
+  *last = '\0';
+  _dbus_string_init_const (&runtime, actual);
+  result = _dbus_string_replace_len (&runtime, 0, _dbus_string_get_length (&runtime),
+                                     path, 0, prefix_len);
+  return result;
+#else
+  (void) path;
+  return TRUE;
+#endif
+}
 
