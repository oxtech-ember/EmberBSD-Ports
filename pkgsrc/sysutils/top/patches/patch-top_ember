+
+	ORDERKEY_STATE
+	ORDERKEY_PCTCPU
+	ORDERKEY_CPTICKS
+	ORDERKEY_PRIO
+	ORDERKEY_RSSIZE
+	ORDERKEY_MEM
+	;
+
+	return (result);
+}
+
+/* compare_time - the comparison function for sorting by total cpu time */
+
+static int
+compare_time(pp1, pp2)
+	struct proc **pp1, **pp2;
+{
+	struct kinfo_proc2 *p1;
+	struct kinfo_proc2 *p2;
+	int result;
