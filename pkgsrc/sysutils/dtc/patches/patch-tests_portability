--- /dev/null
+++ tests/adapt_asm_to_macho.sh
@@ -0,0 +1,99 @@
+#!/bin/sh
+# Diagnostic-only POSIX adapter for DTC -Oasm output used by Darwin tests.
+set -eu
+if [ "$#" -ne 2 ]; then
+    echo "usage: $0 input.s output.s" >&2
+    exit 2
+fi
+input=$1
+output=$2
+tmp=${output}.tmp.$$
+trap 'rm -f "$tmp"' EXIT HUP INT TERM
+awk '
+function is_private_label(name) {
+    return name == "_dt_blob_start" || name == "_dt_header" ||
+        name == "_dt_reserve_map" || name == "_dt_struct_start" ||
+        name == "_dt_struct_end" || name == "_dt_strings_start" ||
+        name == "_dt_strings_end" || name == "_dt_blob_end" ||
+        name == "_dt_blob_abs_end"
+}
+function replace_private_refs(text, comment, pos, tail, result, i, start, ch, token) {
+    pos = index(text, "/*")
+    if (pos) {
+        comment = substr(text, pos)
+        text = substr(text, 1, pos - 1)
+    }
+    result = ""
+    i = 1
+    while (i <= length(text)) {
+        ch = substr(text, i, 1)
+        if (ch ~ /[[:alpha:]_.$]/) {
+            start = i
+            i++
+            while (i <= length(text) && substr(text, i, 1) ~ /[[:alnum:]_.$]/)
+                i++
+            token = substr(text, start, i - start)
+            if (token == "_dt_blob_start") token = "Ldt_blob_start"
+            else if (token == "_dt_header") token = "Ldt_header"
+            else if (token == "_dt_reserve_map") token = "Ldt_reserve_map"
+            else if (token == "_dt_struct_start") token = "Ldt_struct_start"
+            else if (token == "_dt_struct_end") token = "Ldt_struct_end"
+            else if (token == "_dt_strings_start") token = "Ldt_strings_start"
+            else if (token == "_dt_strings_end") token = "Ldt_strings_end"
+            else if (token == "_dt_blob_end") token = "Ldt_blob_end"
+            else if (token == "_dt_blob_abs_end") token = "Ldt_blob_abs_end"
+            result = result token
+        } else {
+            result = result ch
+            i++
+        }
+    }
+    return result comment
+}
+{
+    line = $0
+    if (line ~ /^[[:space:]]*\.data([[:space:]]|$)/)
+        has_data = 1
+    if (line ~ /^[[:space:]]*\.globl[[:space:]]+/) {
+        symbol = $2
+        sub(/,$/, "", symbol)
+        if (!(symbol in seen)) {
+            seen[symbol] = 1
+            symbols[++count] = symbol
+        }
+        indent = line
+        sub(/[^[:space:]].*$/, "", indent)
+        if (global_count++ > 0)
+            before[NR] = indent ".alt_entry " symbol
+    }
+    trimmed = line
+    sub(/^[[:space:]]*/, "", trimmed)
+    sub(/:[[:space:]]*$/, "", trimmed)
+    if (is_private_label(trimmed)) {
+        sub("_dt_", "Ldt_", line)
+    } else if (line ~ /^[[:space:]]*\.(byte|space)[[:space:]]/) {
+        line = replace_private_refs(line)
+    }
+    lines[NR] = line
+}
+END {
+    if (!has_data)
+        print "\t.data"
+    for (i = 1; i <= NR; i++) {
+        if (before[i] != "")
+            print before[i]
+        print lines[i]
+    }
+    if (count) {
+        print ""
+        print "/* Mach-O C-name aliases for DTC public assembly labels. */"
+        for (i = 1; i <= count; i++) {
+            alias = "_" symbols[i]
+            print "\t.globl\t" alias
+            print alias " = " symbols[i]
+        }
+    }
+}
+' "$input" > "$tmp"
+mv -f "$tmp" "$output"
+trap - EXIT HUP INT TERM
