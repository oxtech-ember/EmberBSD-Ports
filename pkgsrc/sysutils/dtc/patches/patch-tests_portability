+static int write_tree(const char *filename, const struct buf *b)
+{
+	size_t offset = 0;
+	int fd;
+
+	fd = open(filename, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	if (fd < 0) {
+		perror("open()");
+		return -1;
+	}
+
+	while (offset < b->cursor) {
+		ssize_t ret = write(fd, b->data + offset, b->cursor - offset);
+
+		if (ret < 0) {
+			if (errno == EINTR)
+				continue;
+			perror("write()");
+			close(fd);
+			return -1;
+		}
+		if (ret == 0) {
+			fprintf(stderr, "write(): zero-length write\n");
+			close(fd);
+			return -1;
+		}
+		offset += ret;
+	}
+
+	if (close(fd) != 0) {
+		perror("close()");
+		return -1;
+	}
+	return 0;
