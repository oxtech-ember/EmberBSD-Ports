+		s = emit_string(&b, "#size-cells");
+		fill_prop_name(&b, strs, p_size_cells, s);
+		fill_prop_name(&b, strs, p_s2_size_cells, s);
+
+		finish_strings_block(&b, hdr, strs);
+	}
+
+	finish_totalsize(&b, hdr);
+
+	return b;
+}
