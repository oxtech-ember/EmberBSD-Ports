$NetBSD$

Keep exported include paths relative to the installed package prefix.

Origin: EmberBSD (AI-assisted). Not submitted upstream.

--- src/lib/fcitx-utils/Fcitx5ModuleTemplate.cmake.in.orig
+++ src/lib/fcitx-utils/Fcitx5ModuleTemplate.cmake.in
@@ -1,7 +1,9 @@
+@PACKAGE_INIT@
+
 if (TARGET Fcitx5::Module::@FEM_EXPORTNAME@ AND TARGET @FEM_TARGET@-interface)
     return()
 endif()
 
 add_library(@FEM_TARGET@-interface INTERFACE)
 add_library(Fcitx5::Module::@FEM_EXPORTNAME@ ALIAS @FEM_TARGET@-interface)
-set_target_properties(@FEM_TARGET@-interface PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "@_MODULE_HEADER_DIR@")
+set_target_properties(@FEM_TARGET@-interface PROPERTIES INTERFACE_INCLUDE_DIRECTORIES "@PACKAGE__MODULE_HEADER_DIR@")
