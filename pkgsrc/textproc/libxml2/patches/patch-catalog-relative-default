 	xmlCatalogEntryPtr *nextent;
 
 	catalogs = (const char *) getenv("XML_CATALOG_FILES");
-	if (catalogs == NULL)
-	    catalogs = XML_XML_DEFAULT_CATALOG;
+	if (catalogs == NULL) {
+	    catalogs = emberbsd_relative_xml_catalog();
+	    if (catalogs == NULL)
