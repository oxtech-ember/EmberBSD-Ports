EMBERBSD_SONNET_PKGDIR:=	${.PARSEDIR:tA}
DISTINFO_FILE=	${EMBERBSD_SONNET_PKGDIR}/distinfo
PATCHDIR=	${EMBERBSD_SONNET_PKGDIR}/patches
