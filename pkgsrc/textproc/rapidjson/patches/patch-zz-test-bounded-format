+#ifndef RAPIDJSON_CHECKED_TEST_FORMAT_H_
+#define RAPIDJSON_CHECKED_TEST_FORMAT_H_
+#include <cstdio>
+#include <cstdlib>
+#include <cstddef>
+
+template <std::size_t N>
+int checked_test_format_result(char (&)[N], int length) {
+    if (length < 0 || static_cast<std::size_t>(length) >= N)
+        std::abort();
+    return length;
+}
+#define checked_test_format(buffer, ...) \
+    checked_test_format_result(buffer, std::snprintf(buffer, sizeof(buffer), __VA_ARGS__))
+#endif
