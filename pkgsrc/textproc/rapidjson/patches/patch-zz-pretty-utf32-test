+TEST(PrettyWriter, Utf32NullTerminatedStringAndKey) {
+    StringBuffer buffer;
+    PrettyWriter<StringBuffer, UTF32<> > writer(buffer);
+    const UTF32<>::Ch key[] = {'k', 0};
+    const UTF32<>::Ch value[] = {'v', 0};
+    EXPECT_TRUE(writer.StartObject());
+    EXPECT_TRUE(writer.Key(key));
+    EXPECT_TRUE(writer.String(value));
+    EXPECT_TRUE(writer.EndObject());
+    EXPECT_STREQ("{\n    \"k\": \"v\"\n}", buffer.GetString());
+}
