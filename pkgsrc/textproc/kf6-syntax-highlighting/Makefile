PKGREVISION=	1

.include "Makefile.common"

COMMENT=	Syntax highlighting engine for structured text and code

.include "../../meta-pkgs/kde/kf6.mk"

.include "../../mk/bsd.prefs.mk"
.if ${USE_CROSS_COMPILE:Uno:tl} == "yes"
# The definition index is generated by a native katehighlightingindexer;
# upstream accepts it through KATEHIGHLIGHTINGINDEXER_EXECUTABLE.
TOOL_DEPENDS+=	kf6-syntax-highlighting-indexer-${KF6VER}{,nb[0-9]*}:../../textproc/kf6-syntax-highlighting-indexer
CMAKE_CONFIGURE_ARGS+=	-DKATEHIGHLIGHTINGINDEXER_EXECUTABLE=${TOOLBASE}/bin/katehighlightingindexer
.endif

USE_TOOLS+=	perl pkg-config

CHECK_PORTABILITY_SKIP+=	autotests/input/highlight.sh
CHECK_PORTABILITY_SKIP+=	autotests/folding/highlight.sh.fold

.include "../../devel/qt6-qttools/buildlink3.mk"
.include "../../lang/qt6-qtdeclarative/buildlink3.mk"
.include "../../textproc/xerces-c/buildlink3.mk"
.include "../../x11/qt6-qtbase/buildlink3.mk"
.include "../../mk/atomic64.mk"
.include "../../mk/bsd.pkg.mk"
