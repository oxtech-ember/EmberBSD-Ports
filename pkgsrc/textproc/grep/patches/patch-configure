@@ -61092,6 +61086,48 @@
 
 
     INTLLIBS="$LIBINTL"
+
+# An explicitly selected base libintl is checked via its public API.
+case ${with_base_libintl-no} in
+  yes|no) ;;
+  *) as_fn_error $? "invalid --with-base-libintl value" "$LINENO" 5 ;;
+esac
+if test "${with_base_libintl-no}" = yes; then
+  if test "${enable_nls-yes}" = no; then
+    as_fn_error $? "base libintl requires NLS" "$LINENO" 5
+  fi
+  saved_LIBS=$LIBS
+  LIBS="-lintl $LIBS"
+  { printf '%s\n' "$as_me:${as_lineno-$LINENO}: checking for the base libintl public API" >&5
+    printf %s "checking for the base libintl public API... " >&6; }
+  cat confdefs.h - <<_ACEOF >conftest.$ac_ext
+#include <libintl.h>
+#include <locale.h>
+int main (void) {
+  bindtextdomain("grep", "/usr/share/locale");
+  bind_textdomain_codeset("grep", "UTF-8");
+  textdomain("grep");
+  return !gettext("x") || !dgettext("grep", "x") ||
+    !dcgettext("grep", "x", LC_MESSAGES) || !ngettext("x", "xs", 2) ||
+    !dngettext("grep", "x", "xs", 2) ||
+    !dcngettext("grep", "x", "xs", 2, LC_MESSAGES);
+}
+_ACEOF
+  if ac_fn_c_try_link "$LINENO"; then
+    { printf '%s\n' "$as_me:${as_lineno-$LINENO}: result: yes" >&5
+      printf '%s\n' yes >&6; }
+  else
+    as_fn_error $? "base libintl public API link failed" "$LINENO" 5
+  fi
+  rm -f core conftest.err conftest.$ac_objext conftest.beam conftest$ac_exeext conftest.$ac_ext
+  LIBS=$saved_LIBS
+  USE_NLS=yes
+  POSUB=po
+  LIBINTL=-lintl
+  LTLIBINTL=-lintl
+  INTLLIBS=-lintl
+  printf '%s\n' '#define ENABLE_NLS 1' '#define HAVE_GETTEXT 1' '#define HAVE_DCGETTEXT 1' >>confdefs.h
+fi
 
 
 
