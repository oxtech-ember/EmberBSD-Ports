# $NetBSD$

Export the OpenSSL target required by the public libSRTP target.

--- Config.cmake.in.orig
+++ Config.cmake.in
@@ -1,3 +1,8 @@
 @PACKAGE_INIT@
 
+if(@ENABLE_OPENSSL@)
+  include(CMakeFindDependencyMacro)
+  find_dependency(OpenSSL 1.1.0)
+endif()
+
 include ( "${CMAKE_CURRENT_LIST_DIR}/libSRTPTargets.cmake" )
