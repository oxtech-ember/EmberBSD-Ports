+/* OpenSSL lists provider key managers using EVP_KEYMGMT_do_all_provided. */
+static void
+info_key_manager(EVP_KEYMGMT *keymgmt, void *arg)
+{
+    const char *kind = NULL;
+    const OSSL_PROVIDER *provider;
+    const char *name;
+
+    (void)arg;
+    if (EVP_KEYMGMT_is_a(keymgmt, "RSA"))
+        kind = "rsa";
+    else if (EVP_KEYMGMT_is_a(keymgmt, "DH"))
+        kind = "dh";
+    else if (EVP_KEYMGMT_is_a(keymgmt, "EC"))
+        kind = "ecdsa";
+    if (kind == NULL)
+        return;
+    provider = EVP_KEYMGMT_get0_provider(keymgmt);
+    name = provider == NULL ? NULL : OSSL_PROVIDER_get0_name(provider);
+    printf("%s provider: %s\n", kind, name == NULL ? "unknown provider" : name);
+}
+#endif
