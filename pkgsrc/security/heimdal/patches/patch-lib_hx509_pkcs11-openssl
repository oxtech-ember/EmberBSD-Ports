+#if defined(HEIMDAL_P11_OPAQUE_OPENSSL)
+static int
+p11_collect_private_native(hx509_context context, struct p11_module *p,
+                           struct p11_slot *slot, CK_SESSION_HANDLE session,
+                           CK_OBJECT_HANDLE object, struct p11_collect_state *state,
+                           CK_ATTRIBUTE *query)
+{
+    struct p11_cert_pub *certpub;
+    struct p11_rsa *p11rsa = NULL;
+    heim_octet_string localKeyId;
+    hx509_private_key key = NULL;
+    BIGNUM *n = NULL, *e = NULL;
+    RSA *rsa = NULL;
+    int ret = 0, held_ref = 0;
+    CK_KEY_TYPE key_type;
+    CK_ATTRIBUTE type_query = { CKA_KEY_TYPE, &key_type, sizeof(key_type) };
+    CK_RV rv;
+
+    rv = P11FUNC(p, GetAttributeValue, (session, object, &type_query, 1));
+    if (rv != CKR_OK || type_query.ulValueLen != sizeof(key_type))
+        return EIO;
+    if (key_type != CKK_RSA)
+        return 0; /* Other token key types do not use the RSA backend. */
+
+    localKeyId.data = query[0].pValue;
+    localKeyId.length = query[0].ulValueLen;
+    certpub = p11_find_cert_pub(state, localKeyId.data, localKeyId.length);
+    if (certpub == NULL)
+        goto out; /* The original NULL-ops path had no usable unmatched key. */
+    ret = p11_getattr_bn_optional(p, session, object, CKA_MODULUS, &n);
+    if (ret != 0)
+        goto out;
+    ret = p11_getattr_bn_optional(p, session, object, CKA_PUBLIC_EXPONENT, &e);
+    if (ret != 0)
+        goto out;
+    if (certpub->ambiguous || certpub->n == NULL || certpub->e == NULL ||
+        (n != NULL && BN_cmp(n, certpub->n) != 0) ||
+        (e != NULL && BN_cmp(e, certpub->e) != 0)) {
+        ret = EINVAL;
+        hx509_set_error_string(context, 0, ret, "ambiguous or mismatching PKCS11 certificate key");
+        goto out;
+    }
+    if (n == NULL && (n = BN_dup(certpub->n)) == NULL) { ret = ENOMEM; goto out; }
+    if (e == NULL && (e = BN_dup(certpub->e)) == NULL) { ret = ENOMEM; goto out; }
+    if (CRYPTO_THREAD_run_once(&p11_method_once, p11_make_rsa_method) != 1 ||
+        p11_rsa_pkcs1_method == NULL) { ret = ENOMEM; goto out; }
+    ret = hx509_private_key_init(&key, NULL, NULL);
+    if (ret != 0)
+        goto out;
+    rsa = RSA_new();
+    if (rsa == NULL) { ret = ENOMEM; goto out; }
+    if (RSA_set0_key(rsa, n, e, NULL) != 1) { ret = ENOMEM; goto out; }
+    n = e = NULL; /* RSA owns both values after successful set0. */
+    p11rsa = calloc(1, sizeof(*p11rsa));
+    if (p11rsa == NULL) { ret = ENOMEM; goto out; }
+    p11rsa->p = p;
+    p11rsa->slot = slot;
+    p11rsa->private_key = object;
+    if (p->ref == 0 || p->ref >= UINT_MAX - 1)
+        _hx509_abort("invalid pkcs11 ref on alloc");
+    p->ref++;
+    held_ref = 1;
+    if (RSA_set_app_data(rsa, p11rsa) != 1) { ret = ENOMEM; goto out; }
+    if (RSA_set_method(rsa, p11_rsa_pkcs1_method) != 1) {
+        (void)RSA_set_app_data(rsa, NULL);
+        ret = ENOMEM;
+        goto out;
+    }
+    p11rsa = NULL; /* RSA method finish owns the module reference and state. */
+    held_ref = 0;
+    hx509_private_key_assign_rsa(key, rsa);
+    key->backend_free = p11_rsa_owner_free;
+    rsa = NULL; /* The key now owns RSA. */
+    /* The general collector matches only by ID, which can also name an EC
+     * certificate.  Attach to the RSA certificate verified above instead. */
+    ret = _hx509_cert_assign_key(certpub->cert, key);
+out:
+    if (held_ref)
+        p11_release_module(p);
+    free(p11rsa);
+    BN_free(n); BN_free(e);
+    RSA_free(rsa);
+    hx509_private_key_free(&key);
+    return ret;
+}
+#endif
