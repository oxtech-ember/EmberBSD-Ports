+#if defined(HEIMDAL_P11_OPAQUE_OPENSSL)
+/* Distinguish an unavailable attribute from token or allocation failure. */
+static int
+p11_getattr_bn_optional(struct p11_module *p, CK_SESSION_HANDLE session,
+                        CK_OBJECT_HANDLE object, unsigned int type, BIGNUM **out)
+{
+    CK_ATTRIBUTE query;
+    CK_RV rv;
+    CK_ULONG allocated;
+
+    *out = NULL;
+    query.type = type;
+    query.pValue = NULL;
+    query.ulValueLen = 0;
+    rv = P11FUNC(p, GetAttributeValue, (session, object, &query, 1));
+    if (rv == CKR_ATTRIBUTE_TYPE_INVALID || rv == CKR_ATTRIBUTE_SENSITIVE ||
+        (rv == CKR_OK && query.ulValueLen == CK_UNAVAILABLE_INFORMATION))
+        return 0;
+    if (rv != CKR_OK)
+        return EIO;
+    if (query.ulValueLen == 0 || query.ulValueLen > INT_MAX)
+        return EINVAL;
+    allocated = query.ulValueLen;
+    query.pValue = malloc(allocated);
+    if (query.pValue == NULL)
+        return ENOMEM;
+    rv = P11FUNC(p, GetAttributeValue, (session, object, &query, 1));
+    if (rv != CKR_OK || query.ulValueLen > allocated || query.ulValueLen == 0) {
+        free(query.pValue);
+        return EIO;
+    }
+    *out = BN_bin2bn(query.pValue, (int)query.ulValueLen, NULL);
+    free(query.pValue);
+    return *out != NULL ? 0 : ENOMEM;
+}
+
+/* Certificates are visited before private objects: PKCS#11 permits only one
+ * active FindObjects operation per session. */
+struct p11_cert_pub {
+    unsigned char *id;
+    size_t id_len;
+    BIGNUM *n, *e;
+    hx509_cert cert;
+    int ambiguous;
+    struct p11_cert_pub *next;
+};
+
+struct p11_collect_state {
+    struct hx509_collector *collector;
+    struct p11_cert_pub *public_keys;
+};
+
+static struct p11_cert_pub *
+p11_find_cert_pub(struct p11_collect_state *state, const void *id, size_t len)
+{
+    struct p11_cert_pub *entry;
+    if (len == 0 || id == NULL)
+        return NULL;
+    for (entry = state->public_keys; entry != NULL; entry = entry->next)
+        if (entry->id_len == len && memcmp(entry->id, id, len) == 0)
+            return entry;
+    return NULL;
+}
+
+static void
+p11_free_cert_pubs(struct p11_collect_state *state)
+{
+    struct p11_cert_pub *entry, *next;
+    for (entry = state->public_keys; entry != NULL; entry = next) {
+        next = entry->next;
+        BN_free(entry->n); BN_free(entry->e);
+        hx509_cert_free(entry->cert);
+        free(entry->id);
+        free(entry);
+    }
+    state->public_keys = NULL;
+}
+
+static BIGNUM *
+p11_integer_to_bn(const heim_integer *value)
+{
+    BIGNUM *result;
+    if (value->length > INT_MAX)
+        return NULL;
+    result = BN_bin2bn(value->data, (int)value->length, NULL);
+    if (result != NULL)
+        BN_set_negative(result, value->negative);
+    return result;
+}
+
+static int
+p11_cache_cert_pub(struct p11_collect_state *state, const void *id, size_t id_len,
+                   hx509_cert cert)
+{
+    const Certificate *certificate;
+    const SubjectPublicKeyInfo *spi;
+    struct p11_cert_pub *entry;
+    RSAPublicKey pub;
+    BIGNUM *n = NULL, *e = NULL;
+    size_t used = 0, len;
+    int decoded;
+
+    if (id == NULL || id_len == 0)
+        return 0;
+    certificate = _hx509_get_cert(cert);
+    spi = &certificate->tbsCertificate.subjectPublicKeyInfo;
+    if (der_heim_oid_cmp(&spi->algorithm.algorithm,
+                         ASN1_OID_ID_PKCS1_RSAENCRYPTION) != 0)
+        return 0; /* Keep non-RSA certificates in the general collector. */
+    len = spi->subjectPublicKey.length / 8;
+    decoded = decode_RSAPublicKey(spi->subjectPublicKey.data, len, &pub, &used);
+    if (decoded == 0) {
+        if (used == len) {
+            n = p11_integer_to_bn(&pub.modulus);
+            e = p11_integer_to_bn(&pub.publicExponent);
+        }
+        free_RSAPublicKey(&pub);
+        if (used == len && (n == NULL || e == NULL)) {
+            BN_free(n); BN_free(e);
+            return ENOMEM;
+        }
+    }
+    entry = p11_find_cert_pub(state, id, id_len);
+    if (entry != NULL) {
+        if (entry->n == NULL || entry->e == NULL || n == NULL || e == NULL ||
+            BN_cmp(entry->n, n) != 0 || BN_cmp(entry->e, e) != 0)
+            entry->ambiguous = 1;
+        BN_free(n); BN_free(e);
+        return 0;
+    }
+    entry = calloc(1, sizeof(*entry));
+    if (entry == NULL) {
+        BN_free(n); BN_free(e);
+        return ENOMEM;
+    }
+    entry->id = malloc(id_len);
+    if (entry->id == NULL) {
+        BN_free(n); BN_free(e); free(entry);
+        return ENOMEM;
+    }
+    memcpy(entry->id, id, id_len);
+    entry->id_len = id_len;
+    entry->n = n; entry->e = e;
+    entry->cert = hx509_cert_ref(cert);
+    entry->next = state->public_keys;
+    state->public_keys = entry;
+    return 0;
+}
+#endif
