+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "tcpd.h"
+
+/* clean_exit - clean up and exit */
+
+void
+clean_exit(struct request_info *request)
+{
+
+    /*
+     * In case of unconnected protocols we must eat up the not-yet received
+     * data or inetd will loop.
+     */
