+		ch == 'A' ? eval_hostaddr(request->server) :
+		ch == 'c' ? eval_client(request) :
+		ch == 'd' ? eval_daemon(request) :
+		ch == 'h' ? eval_hostinfo(request->client) :
+		ch == 'H' ? eval_hostinfo(request->server) :
