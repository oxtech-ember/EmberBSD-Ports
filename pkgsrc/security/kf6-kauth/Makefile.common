DISTNAME=	kauth-${KF6VER}
CATEGORIES=	security

HOMEPAGE=	https://community.kde.org/Frameworks
LICENSE=	gnu-lgpl-v2.1

EMBERBSD_KAUTH_PKGDIR:=	${.PARSEDIR:tA}
DISTINFO_FILE=	${EMBERBSD_KAUTH_PKGDIR}/distinfo
PATCHDIR=	${EMBERBSD_KAUTH_PKGDIR}/patches
