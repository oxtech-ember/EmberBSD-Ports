+long
+k5_relocate_default(const char *input, char **output)
+{
+    char *result = NULL;
+    long status = 0;
+#if !defined(_WIN32) && K5_RELOC_HAVE_DLADDR && K5_RELOC_CONFIG_OK
+    Dl_info info;
+    char *image = NULL, *dir = NULL, *name = NULL, *prefix = NULL;
+    char *libdir = NULL, *path = NULL, *moved_prefix = NULL;
+    const char *relative;
+    size_t plen, dlen, rlen;
+#endif
+
+    *output = NULL;
+#if !defined(_WIN32) && K5_RELOC_HAVE_DLADDR && K5_RELOC_CONFIG_OK
+    if (dladdr(&k5_reloc_anchor, &info) == 0 || info.dli_fname == NULL)
+        goto fallback;
+    image = realpath(info.dli_fname, NULL);
+    if (image == NULL) {
+        if (errno == ENOMEM)
+            status = ENOMEM;
+        goto fallback;
+    }
+    status = k5_path_split(image, &dir, &name);
+    if (status != 0) goto fallback;
+    if (!reloc_valid_basename(name))
+        goto fallback;
+    if (!k5_path_isabs(input) || !k5_path_isabs(K5_RELOC_PREFIX) ||
+        !k5_path_isabs(K5_RELOC_LIBDIR)) goto fallback;
+    prefix = reloc_normalize(K5_RELOC_PREFIX);
+    libdir = reloc_normalize(K5_RELOC_LIBDIR);
+    path = reloc_normalize(input);
+    if (prefix == NULL || libdir == NULL || path == NULL) {
+        status = ENOMEM;
+        goto fallback;
+    }
+    plen = strlen(prefix);
+    if (plen <= 1 || strncmp(prefix, libdir, plen) || libdir[plen] != '/' ||
+        strncmp(prefix, path, plen) || (path[plen] != '/' && path[plen] != '\0')) goto fallback;
+    relative = libdir + plen + 1;
+    rlen = strlen(relative); dlen = strlen(dir);
+    if (rlen == 0 || dlen < rlen + 1 || dir[dlen-rlen-1] != '/' ||
+        strcmp(dir+dlen-rlen, relative) != 0) goto fallback;
+    moved_prefix = strndup(dir, dlen-rlen-1);
+    if (moved_prefix == NULL) {
