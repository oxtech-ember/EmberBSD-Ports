+
+dnl Private relocated defaults: no shell eval of user-supplied paths.
+dnl Support standard Autoconf directory forms; unknown forms retain defaults.
+K5_RELOC_CONFIG_OK=1
+AC_PATH_PROG([K5_RELOC_OD], [od])
+if test -z "$K5_RELOC_OD"; then
+  K5_RELOC_CONFIG_OK=0
+fi
+case "$prefix" in
+  NONE) k5_reloc_prefix=$ac_default_prefix ;;
+  /*) k5_reloc_prefix=$prefix ;;
+  *) K5_RELOC_CONFIG_OK=0 ;;
+esac
+case "$exec_prefix" in
+  NONE|'${prefix}') k5_reloc_exec=$k5_reloc_prefix ;;
+  '${prefix}/'*) k5_reloc_exec=$k5_reloc_prefix${exec_prefix#'${prefix}'} ;;
+  /*) k5_reloc_exec=$exec_prefix ;;
+  *) K5_RELOC_CONFIG_OK=0 ;;
+esac
+case "$libdir" in
+  '${exec_prefix}') k5_reloc_lib=$k5_reloc_exec ;;
+  '${exec_prefix}/'*) k5_reloc_lib=$k5_reloc_exec${libdir#'${exec_prefix}'} ;;
+  '${prefix}') k5_reloc_lib=$k5_reloc_prefix ;;
+  '${prefix}/'*) k5_reloc_lib=$k5_reloc_prefix${libdir#'${prefix}'} ;;
+  /*) k5_reloc_lib=$libdir ;;
+  *) K5_RELOC_CONFIG_OK=0 ;;
+esac
+case "$k5_reloc_prefix$k5_reloc_lib" in
+  *'
+'*) K5_RELOC_CONFIG_OK=0 ;;
+esac
+K5_RELOC_PREFIX_C=
+K5_RELOC_LIBDIR_C=
+if test "$K5_RELOC_CONFIG_OK" = 1; then
+  dnl Encode each byte as a fixed-width C octal escape; no quote or slash leaks.
+  K5_RELOC_PREFIX_C=$(printf '%s' "$k5_reloc_prefix" | "$K5_RELOC_OD" -An -v -t u1 | "$AWK" '{for (i=1; i<=NF; i++) printf "\\%03o", [$]i}')
+  K5_RELOC_LIBDIR_C=$(printf '%s' "$k5_reloc_lib" | "$K5_RELOC_OD" -An -v -t u1 | "$AWK" '{for (i=1; i<=NF; i++) printf "\\%03o", [$]i}')
+  if test -z "$K5_RELOC_PREFIX_C" || test -z "$K5_RELOC_LIBDIR_C"; then
+    K5_RELOC_CONFIG_OK=0
+    AC_MSG_NOTICE([private default-path relocation disabled: cannot encode directories])
+  fi
+else
+  AC_MSG_NOTICE([private default-path relocation disabled for unsupported directory form])
+fi
+AC_SUBST([K5_RELOC_CONFIG_OK])
+AC_SUBST([K5_RELOC_PREFIX_C])
+AC_SUBST([K5_RELOC_LIBDIR_C])
