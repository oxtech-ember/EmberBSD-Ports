+static int
+reloc_valid_basename(const char *name)
+{
+    const char *p, *end;
+
+    if (strncmp(name, "libkrb5support.", 15) != 0)
+        return 0;
+    p = name + 15;
+    if (strcmp(p, "dylib") == 0 || strcmp(p, "so") == 0)
+        return 1;
+    if (strncmp(p, "so.", 3) == 0) {
+        p += 3;
+        end = p + strlen(p);
+    } else {
+        end = strstr(p, ".dylib");
+        if (end == NULL || end[6] != '\0')
+            return 0;
+    }
+    if (p == end)
+        return 0;
+    for (; p < end; p++) {
+        if (*p == '.') {
+            if (p == name + 15 || p + 1 == end || p[-1] == '.')
+                return 0;
+        } else if (*p < '0' || *p > '9') {
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static char *
+reloc_normalize(const char *input)
+{
+    char *copy, *out, *save = NULL, *part, *cut;
+    size_t len = 1, n;
+
+    if (!k5_path_isabs(input))
+        return NULL;
+    copy = strdup(input);
+    if (copy == NULL)
+        return NULL;
+    out = malloc(strlen(input) + 2);
+    if (out == NULL) {
+        free(copy);
+        return NULL;
+    }
+    out[0] = '/';
+    out[1] = '\0';
+    for (part = strtok_r(copy, "/", &save); part != NULL;
+         part = strtok_r(NULL, "/", &save)) {
+        if (!strcmp(part, "."))
+            continue;
+        if (!strcmp(part, "..")) {
+            if (len > 1) {
+                cut = strrchr(out, '/');
+                len = (cut == out) ? 1 : (size_t)(cut - out);
+                out[len] = '\0';
+            }
+            continue;
+        }
+        if (len > 1)
+            out[len++] = '/';
+        n = strlen(part);
+        memcpy(out + len, part, n);
+        len += n;
+        out[len] = '\0';
+    }
+    free(copy);
+    return out;
+}
