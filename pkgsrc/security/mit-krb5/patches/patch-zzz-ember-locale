$NetBSD$

Relocate the compiled default locale directory through libkrb5support.

--- lib/krb5/krb5_libinit.c.orig
+++ lib/krb5/krb5_libinit.c
@@ -23,6 +23,15 @@
 int krb5int_lib_init(void)
 {
     int err;
+#ifdef ENABLE_NLS
+    char *locale_dir = NULL;
+#endif
+
+#ifdef ENABLE_NLS
+    err = k5_relocate_default(LOCALEDIR, &locale_dir);
+    if (err)
+        return err;
+#endif
 
     k5_set_error_info_callout_fn(error_message);
 
@@ -37,7 +46,10 @@
     add_error_table(&et_asn1_error_table);
     add_error_table(&et_k524_error_table);
 
-    bindtextdomain(KRB5_TEXTDOMAIN, LOCALEDIR);
+#ifdef ENABLE_NLS
+    bindtextdomain(KRB5_TEXTDOMAIN, locale_dir);
+    free(locale_dir);
+#endif
 
 #ifndef LEAN_CLIENT
     err = krb5int_kt_initialize();
