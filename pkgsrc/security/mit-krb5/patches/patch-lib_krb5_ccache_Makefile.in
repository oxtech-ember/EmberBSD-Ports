$NetBSD$

Generate Darwin KCM RPC files with one selected MIG producer.

--- lib/krb5/ccache/Makefile.in.orig
+++ lib/krb5/ccache/Makefile.in
@@ -100,6 +100,8 @@
 
 all-windows: subdirs $(OBJFILE)
 
+generate-files-mac: $(KCMRPC_DEPS)
+
 ##DOS##subdirs: ccapi\$(OUTPRE)file.lst
 
 ##DOS##ccapi\$(OUTPRE)file.lst:
@@ -113,9 +115,20 @@
 ##WIN32##	$(LIBECHO) -p $(PREFIXDIR)\ $(OUTPRE)*.obj \
 ##WIN32##		ccapi\$(OUTPRE)*.obj > $(OBJFILE)
 
-kcmrpc.h kcmrpc.c: kcmrpc.defs
-	mig -header kcmrpc.h -user kcmrpc.c -sheader /dev/null \
-		-server /dev/null -I$(srcdir) $(srcdir)/kcmrpc.defs
+MIG ?= mig
+# Publish the header last: it is the readiness target for both outputs.
+KCMRPC_MIG = set -e; tmp=$$(mktemp -d ./kcmrpc.XXXXXXXX); \
+	trap 'rm -rf "$$tmp"' 0; \
+	$(MIG) -header "$$tmp/kcmrpc.h" -user "$$tmp/kcmrpc.c" \
+	-sheader /dev/null -server /dev/null -I$(srcdir) $(srcdir)/kcmrpc.defs; \
+	rm -f kcmrpc.h; mv "$$tmp/kcmrpc.c" kcmrpc.c; \
+	mv "$$tmp/kcmrpc.h" kcmrpc.h
+
+kcmrpc.h: kcmrpc.defs
+	$(KCMRPC_MIG)
+
+kcmrpc.c: kcmrpc.h
+	@test -f $@ || { $(KCMRPC_MIG); }
 
 clean-unix:: clean-libobjs
 
