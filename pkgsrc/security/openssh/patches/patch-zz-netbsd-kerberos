+#if defined(EMBERBSD_BASE_OPENSSH) && defined(KRB5)
+/* NetBSD Kerberos-2 authentication uses the privileged monitor. */
+int
+mm_answer_krb5(struct ssh *ssh, int sock, struct sshbuf *m)
+{
+	krb5_data ticket = {0}, reply = {0};
+	char *user = NULL;
+	u_char *data = NULL;
+	size_t len = 0;
+	int r, success;
+
+	if ((r = sshbuf_get_string(m, &data, &len)) != 0)
+		fatal_fr(r, "parse ticket");
+	ticket.data = data;
+	ticket.length = len;
+	success = options.kerberos_authentication && authctxt->valid &&
+	    auth_krb5(ssh, &ticket, &user, &reply);
+	free(ticket.data);
+	sshbuf_reset(m);
+	if ((r = sshbuf_put_u32(m, success)) != 0 ||
+	    (success && ((r = sshbuf_put_cstring(m, user)) != 0 ||
+	    (r = sshbuf_put_string(m, reply.data, reply.length)) != 0)))
+		fatal_fr(r, "serialize result");
+	free(user);
+	free(reply.data);
+	mm_request_send(sock, MONITOR_ANS_KRB5, m);
+	auth_method = "kerberos-2@ssh.com";
+	return success;
+}
+#endif
