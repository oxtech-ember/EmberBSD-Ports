+	if ((r = sshbuf_put_string(m, ticket->data, ticket->length)) != 0)
+		fatal_fr(r, "serialize ticket");
+	mm_request_send(pmonitor->m_recvfd, MONITOR_REQ_KRB5, m);
+	mm_request_receive_expect(pmonitor->m_recvfd, MONITOR_ANS_KRB5, m);
+	if ((r = sshbuf_get_u32(m, &success)) != 0)
+		fatal_fr(r, "parse result");
+	if (success && ((r = sshbuf_get_cstring(m, userp, NULL)) != 0 ||
+	    (r = sshbuf_get_string(m, &data, &len)) != 0))
+		fatal_fr(r, "parse result details");
+	reply->data = data;
+	reply->length = len;
+	sshbuf_free(m);
+	return success != 0;
