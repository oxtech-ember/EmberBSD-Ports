+/* import */
+extern ServerOptions options;
+extern struct authmethod_cfg methodcfg_krb5;
+
+static int
+userauth_kerberos(struct ssh *ssh, const char *method)
+{
+	krb5_data tkt = {0}, reply = {0};
+	size_t dlen;
+	u_char *ticket = NULL;
+	char *client = NULL;
+	int authenticated = 0, r;
+
+	(void)method;
+	if ((r = sshpkt_get_string(ssh, &ticket, &dlen)) != 0 ||
+	     (r = sshpkt_get_end(ssh)) != 0)
+		 fatal("%s: %s", __func__, ssh_err(r));
+
+	tkt.data = ticket;
+	tkt.length = dlen;
+	authenticated = mm_auth_krb5(ssh, &tkt, &client, &reply);
+	free(reply.data);
+	free(client);
+	free(tkt.data);
+	return (authenticated);
+}
+
+Authmethod method_kerberos = {
+	&methodcfg_krb5,
+	userauth_kerberos,
+};
