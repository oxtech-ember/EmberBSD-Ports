+/* Based on NetBSD auth-krb5.c; keep intermediate ownership local. */
+int
+auth_krb5(struct ssh *ssh, krb5_data *auth, char **client, krb5_data *reply)
+{
+	Authctxt *authctxt = ssh->authctxt;
+	krb5_auth_context auth_ctx = NULL;
+	krb5_principal server = NULL, user = NULL;
+	krb5_ticket *ticket = NULL;
+	krb5_data local_reply = {0};
+	krb5_error_code problem;
+	char *local_client = NULL;
+	int fd, success = 0;
+
+	*client = NULL;
+	memset(reply, 0, sizeof(*reply));
+	problem = krb5_init(authctxt);
+	if (problem != 0)
+		goto out;
+	problem = krb5_auth_con_init(authctxt->krb5_ctx, &auth_ctx);
+	if (problem != 0)
+		goto out;
+	fd = ssh_packet_get_connection_in(ssh);
+	problem = krb5_auth_con_setaddrs_from_fd(authctxt->krb5_ctx,
+	    auth_ctx, &fd);
+	if (problem != 0)
+		goto out;
+	problem = krb5_sname_to_principal(authctxt->krb5_ctx, NULL, NULL,
+	    KRB5_NT_SRV_HST, &server);
+	if (problem != 0)
+		goto out;
+	problem = krb5_rd_req(authctxt->krb5_ctx, &auth_ctx, auth, server,
+	    NULL, NULL, &ticket);
+	if (problem != 0)
+		goto out;
+	problem = krb5_copy_principal(authctxt->krb5_ctx, ticket->client,
+	    &user);
+	if (problem != 0)
+		goto out;
+	problem = krb5_mk_rep(authctxt->krb5_ctx, auth_ctx, &local_reply);
+	if (problem != 0)
+		goto out;
+	if (!krb5_kuserok(authctxt->krb5_ctx, user, authctxt->pw->pw_name))
+		goto out;
+	problem = krb5_unparse_name(authctxt->krb5_ctx, user, &local_client);
+	if (problem != 0)
+		goto out;
+	if (authctxt->krb5_user != NULL)
+		krb5_free_principal(authctxt->krb5_ctx, authctxt->krb5_user);
+	authctxt->krb5_user = user;
+	user = NULL;
+	*client = local_client;
+	local_client = NULL;
+	*reply = local_reply;
+	memset(&local_reply, 0, sizeof(local_reply));
+	success = 1;
+out:
+	if (problem != 0)
+		debug("Kerberos v5 authentication failed: %d", problem);
+	free(local_client);
+	free(local_reply.data);
+	if (ticket != NULL)
+		krb5_free_ticket(authctxt->krb5_ctx, ticket);
+	if (user != NULL)
+		krb5_free_principal(authctxt->krb5_ctx, user);
+	if (server != NULL)
+		krb5_free_principal(authctxt->krb5_ctx, server);
+	if (auth_ctx != NULL)
+		krb5_auth_con_free(authctxt->krb5_ctx, auth_ctx);
+	return success;
+}
