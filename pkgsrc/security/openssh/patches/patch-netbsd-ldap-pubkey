+}
+
+/* free keys */
+void ldap_keys_free(ldap_key_t * k) {
+    ldap_value_free_len(k->keys);
+    free(k);
+    return;
+}
+
+ldap_key_t *ldap_getuserkey(ldap_opt_t *l, const char *user)
+{
+	ldap_key_t *k;
+	LDAPMessage *res, *e;
+	char *filter, *escaped;
+	char *attrs[2];
+	int i;
+
+	if (l == NULL || user == NULL || (k = calloc(1, sizeof(*k))) == NULL)
+		return NULL;
+	attrs[0] = l->pub_key_attr;
+	attrs[1] = NULL;
+
+	/* Am i still connected ? RETRY n times */
+	/* XXX TODO: setup some conf value for retrying */
+	if (!(l->flags & FLAG_CONNECTED))
+		for (i = 0; i < 2; i++)
+			if (ldap_xconnect(l) == 0)
+				break;
+	if (!(l->flags & FLAG_CONNECTED)) {
+		free(k);
+		return NULL;
+	}
+
+	escaped = ldap_escape_value(user);
+	if (escaped == NULL ||
+	    asprintf(&filter,
+	             "(&(objectclass=posixAccount)(objectclass=ldapPublicKey)("
+	             "uid=%s)%s)",
+	             escaped, l->filter != NULL ? l->filter : "") == -1) {
+		ber_memfree(escaped);
+		free(k);
+		return NULL;
+	}
+	ber_memfree(escaped);
+
+	if (ldap_search_st(l->ld, l->u_basedn, LDAP_SCOPE_SUBTREE, filter,
+	                   attrs, 0, &l->s_timeout, &res) != LDAP_SUCCESS) {
+
+		ldap_perror(l->ld, "ldap_search_st()");
+
+		free(filter);
+		free(k);
+
+		/* XXX error on search, timeout etc.. close ask for reconnect */
+		ldap_close(l);
+
+		return NULL;
+	}
+
+	/* free */
+	free(filter);
+
+	/* check if any results */
+	i = ldap_count_entries(l->ld, res);
+	if (i <= 0) {
+		ldap_msgfree(res);
+		free(k);
+		return NULL;
+	}
+
+	if (i > 1)
+		debug(
+		    "[LDAP] duplicate entries, using the FIRST entry returned");
+
+	e = ldap_first_entry(l->ld, res);
+	k->keys = ldap_get_values_len(l->ld, e, l->pub_key_attr);
+	ldap_msgfree(res);
+	if (k->keys == NULL) {
+		free(k);
+		return NULL;
+	}
+	i = ldap_count_values_len(k->keys);
+	if (i < 0) {
+		ldap_value_free_len(k->keys);
+		free(k);
+		return NULL;
+	}
+	k->num = (unsigned int)i;
+	return k;
+}
+
+/* -1 if trouble
+   0 if user is NOT member of current server group
+   1 if user IS MEMBER of current server group
+ */
+int
+ldap_ismember(ldap_opt_t *l, const char *user)
+{
+	LDAPMessage *res;
+	char *filter, *escaped;
+	int i;
+
+	if ((!l->sgroup) || !(l->g_basedn))
+		return 1;
+
+	/* Am i still connected ? RETRY n times */
+	/* XXX TODO: setup some conf value for retrying */
+	if (!(l->flags & FLAG_CONNECTED))
+		for (i = 0; i < 2; i++)
+			if (ldap_xconnect(l) == 0)
+				break;
+	if (!(l->flags & FLAG_CONNECTED))
+		return FAILURE;
+
+	escaped = ldap_escape_value(user);
+	if (escaped == NULL || l->fgroup == NULL ||
+	    asprintf(&filter, "%s(memberUid=%s))", l->fgroup, escaped) == -1) {
+		ber_memfree(escaped);
+		return FAILURE;
+	}
+	ber_memfree(escaped);
+
+	if (ldap_search_st(l->ld, l->g_basedn, LDAP_SCOPE_SUBTREE, filter, NULL,
+	                   0, &l->s_timeout, &res) != LDAP_SUCCESS) {
+
+		ldap_perror(l->ld, "ldap_search_st()");
+
+		free(filter);
+
+		/* XXX error on search, timeout etc.. close ask for reconnect */
+		ldap_close(l);
+
+		return FAILURE;
+	}
+
+	free(filter);
+
+	/* check if any results */
+	if (ldap_count_entries(l->ld, res) > 0) {
+		ldap_msgfree(res);
+		return 1;
+	}
+
+	ldap_msgfree(res);
+	return 0;
+}
+
+/*
+ * ldap.conf simple parser
+ * XXX TODO:  sanity checks
+ * must either
+ * - free the previous ldap_opt_before replacing entries
+ * - free each necessary previously parsed elements
+ * ret:
+ * -1 on FAILURE, 0 on SUCCESS
+ */
+int
+ldap_parse_lconf(ldap_opt_t *l)
+{
+	FILE *lcd; /* ldap.conf descriptor */
+	char buf[BUFSIZ];
+	char *s = NULL, *k = NULL, *v = NULL, *replacement;
+	size_t li, len;
+	int result = SUCCESS;
+
+	lcd = fopen(l->l_conf, "r");
+	if (lcd == NULL) {
+		/* debug("Cannot open %s", l->l_conf); */
+		perror("ldap_parse_lconf()");
+		return FAILURE;
+	}
+
+	while (fgets(buf, sizeof(buf), lcd) != NULL) {
+
+		if (*buf == '\n' || *buf == '#')
+			continue;
+
+		k = buf;
+		v = k;
+		while (*v != '\0' && *v != ' ' && *v != '\t')
+			v++;
+
+		if (*v == '\0')
+			continue;
+
+		*(v++) = '\0';
+
+		while (*v == ' ' || *v == '\t')
+			v++;
+
+		li = strlen(v);
+		while (li > 0 && (v[li - 1] == ' ' || v[li - 1] == '\t' ||
+		                  v[li - 1] == '\n' || v[li - 1] == '\r'))
+			--li;
+		v[li] = '\0';
+
+		if (!strcasecmp(k, "uri")) {
+			replacement = ldap_parse_servers(v);
+			if (replacement == NULL) {
+				result = FAILURE;
+				break;
+			}
+			free(l->servers);
+			l->servers = replacement;
+		} else if (!strcasecmp(k, "base")) {
+			s = strchr(v, '?');
+			len = s != NULL ? (size_t)(s - v) : strlen(v);
+			replacement = strndup(v, len);
+			if (replacement == NULL) {
+				result = FAILURE;
+				break;
+			}
+			free(l->u_basedn);
+			l->u_basedn = replacement;
+		} else if (!strcasecmp(k, "binddn")) {
+			replacement = strdup(v);
+			if (replacement == NULL) {
+				result = FAILURE;
+				break;
+			}
+			free(l->binddn);
+			l->binddn = replacement;
+		} else if (!strcasecmp(k, "bindpw")) {
+			replacement = strdup(v);
+			if (replacement == NULL) {
+				result = FAILURE;
+				break;
+			}
+			if (l->bindpw != NULL)
+				freezero(l->bindpw, strlen(l->bindpw));
+			l->bindpw = replacement;
+		} else if (!strcasecmp(k, "timelimit")) {
