+/* filter building infos */
+#define FILTER_GROUP_PREFIX "(&(objectclass=posixGroup)"
+#define FILTER_OR_PREFIX "(|"
+#define FILTER_OR_SUFFIX ")"
+#define FILTER_CN_PREFIX "(cn="
+#define FILTER_CN_SUFFIX ")"
+/* Split a writable list on spaces and tabs, retaining room for NULL. */
+static int
+tokenize(char **o, size_t size, char *input)
+{
+	size_t i = 0;
+	char *ptr = input;
+
+	while (*(ptr += strspn(ptr, " \t")) != '\0') {
+		if (i + 1 >= size)
+			return -1;
+		o[i++] = ptr;
+		ptr += strcspn(ptr, " \t");
+		if (*ptr != '\0')
+			*ptr++ = '\0';
+	}
+	o[i] = NULL;
+	return SUCCESS;
+}
+
+void
+ldap_close(ldap_opt_t *ldap)
+{
+
+	if (!ldap)
+		return;
+
+	if (ldap->ld != NULL)
+		ldap_unbind_ext(ldap->ld, NULL, NULL);
+
+	ldap->ld = NULL;
+	FLAG_SET_DISCONNECTED(ldap->flags);
+
+	return;
+}
+
+/* Initialize and connect using the complete, ordered URI list. */
+static int
+ldap_connect_selected(ldap_opt_t *ldap)
+{
+	int version = LDAP_VERSION3;
+
+	if (ldap_initialize(&ldap->ld, ldap->servers) != LDAP_SUCCESS ||
+	    ldap->ld == NULL)
+		return FAILURE;
+	if (ldap_set_option(ldap->ld, LDAP_OPT_PROTOCOL_VERSION, &version) !=
+	    LDAP_OPT_SUCCESS) {
+		ldap_close(ldap);
+		return FAILURE;
+	}
+	if (ldap_set_option(ldap->ld, LDAP_OPT_NETWORK_TIMEOUT,
+	                    &ldap->b_timeout) != LDAP_SUCCESS)
+		ldap_perror(ldap->ld, "LDAP network timeout");
+	if (ldap_set_option(ldap->ld, LDAP_OPT_TIMEOUT, &ldap->s_timeout) !=
+	    LDAP_SUCCESS)
+		ldap_perror(ldap->ld, "LDAP timeout");
+	if (ldap_connect(ldap->ld) != LDAP_SUCCESS) {
+		ldap_close(ldap);
+		return FAILURE;
+	}
+	return SUCCESS;
+}
+
+/* Bind only after applying the requested transport policy. */
+int
+ldap_xconnect(ldap_opt_t *ldap)
+{
+	if (ldap->servers == NULL || ldap_connect_selected(ldap) != SUCCESS)
+		return FAILURE;
+	if ((ldap->tls == -1 || ldap->tls == 1) &&
+	    !ldap_tls_inplace(ldap->ld)) {
+		if (ldap_start_tls_s(ldap->ld, NULL, NULL) != LDAP_SUCCESS) {
+			ldap_perror(ldap->ld, "LDAP StartTLS");
+			ldap_close(ldap);
+			if (ldap->tls == 1 ||
+			    ldap_connect_selected(ldap) != SUCCESS)
+				return FAILURE;
+		}
+	}
+	if (ldap_simple_bind_s(ldap->ld, ldap->binddn, ldap->bindpw) !=
+	    LDAP_SUCCESS) {
+		ldap_perror(ldap->ld, "LDAP bind");
+		ldap_close(ldap);
+		return FAILURE;
+	}
+	FLAG_SET_CONNECTED(ldap->flags);
+	return SUCCESS;
+}
+
+/* Escape assertion values, keeping administrator filters separate. */
+static char *
+ldap_escape_value(const char *value)
+{
+	struct berval in, out;
+	int rc;
+
+	in.bv_len = strlen(value);
+	if (in.bv_len == 0)
+		return ber_strdup("");
+	if ((in.bv_val = ber_strdup(value)) == NULL)
+		return NULL;
+	rc = ldap_bv2escaped_filter_value(&in, &out);
+	ber_memfree(in.bv_val);
+	if (rc != 0)
+		return NULL;
+	return out.bv_val;
+}
+
+/* Construct the group part; the member UID is appended at lookup time. */
+char *
+ldap_parse_groups(const char *groups)
+{
+	char *copy, *buffer = NULL, *next, *escaped, *garray[32];
+	size_t i;
+
+	if (groups == NULL || (copy = strdup(groups)) == NULL)
+		return NULL;
+	if (tokenize(garray, sizeof(garray) / sizeof(*garray), copy) < 0)
+		goto out;
+	buffer = strdup(FILTER_GROUP_PREFIX FILTER_OR_PREFIX);
+	if (buffer == NULL)
+		goto out;
+	for (i = 0; garray[i] != NULL; i++) {
+		escaped = ldap_escape_value(garray[i]);
+		if (escaped == NULL ||
+		    asprintf(&next, "%s" FILTER_CN_PREFIX "%s" FILTER_CN_SUFFIX,
+		             buffer, escaped) == -1) {
+			ber_memfree(escaped);
+			free(buffer);
+			buffer = NULL;
+			goto out;
+		}
+		ber_memfree(escaped);
+		free(buffer);
+		buffer = next;
+	}
+	if (asprintf(&next, "%s" FILTER_OR_SUFFIX, buffer) == -1) {
+		free(buffer);
+		buffer = NULL;
+		goto out;
+	}
+	free(buffer);
+	buffer = next;
+out:
+	free(copy);
+	return buffer;
+}
+
+/* Validate the URI list while retaining schemes and endpoint order. */
+char *
+ldap_parse_servers(const char *servers)
+{
+	char *copy, *result = NULL, *urls[32];
+	LDAPURLDesc *url;
+	size_t i;
+
+	if (servers == NULL || (copy = strdup(servers)) == NULL)
+		return NULL;
+	if (tokenize(urls, sizeof(urls) / sizeof(*urls), copy) < 0 ||
+	    urls[0] == NULL)
+		goto out;
+	for (i = 0; urls[i] != NULL; i++) {
+		url = NULL;
+		if (!ldap_is_ldap_url(urls[i]) ||
+		    ldap_url_parse(urls[i], &url) != 0)
+			goto out;
+		ldap_free_urldesc(url);
+	}
+	result = calloc(strlen(servers) + 1, 1);
+	if (result == NULL)
+		goto out;
+	for (i = 0; urls[i] != NULL; i++) {
+		if (i != 0)
+			strlcat(result, " ", strlen(servers) + 1);
+		strlcat(result, urls[i], strlen(servers) + 1);
+	}
+out:
+	free(copy);
+	return result;
+}
