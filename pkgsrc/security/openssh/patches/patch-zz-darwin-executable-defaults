+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Resolve configured prefix-owned defaults once, before privileges change. */
+#define SSH_DARWIN_DEFAULTS_IMPL
+#include "includes.h"
+#include "pathnames.h"
+
+#include "platform.h"
+
+#include <mach-o/dyld.h>
+#include <membership.h>
+#include <sys/acl.h>
+#include <sys/param.h>
+#include <sys/stat.h>
+#include <err.h>
+#include <errno.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+char ssh_darwin_defaults[sizeof(templates) / sizeof(templates[0])][PATH_MAX];
+
+enum acl_scope {
+	EXISTING, SYMLINK, NEW_FILE, NEW_DIRECTORY, NEW_SUBTREE
+};
+
+static void
+check_acl(const char *path, const uuid_t root_user, enum acl_scope scope)
+{
+	const acl_permset_mask_t change = ACL_WRITE_DATA | ACL_APPEND_DATA |
+	    ACL_DELETE | ACL_DELETE_CHILD | ACL_WRITE_ATTRIBUTES |
+	    ACL_WRITE_EXTATTRIBUTES | ACL_WRITE_SECURITY | ACL_CHANGE_OWNER;
+	acl_t acl;
+	acl_entry_t entry;
+	acl_tag_t tag;
+	acl_permset_mask_t rights;
+	acl_flagset_t flags;
+	void *owner;
+	int id = ACL_FIRST_ENTRY, only, files, dirs, limit;
+
+	acl = scope == SYMLINK ? acl_get_link_np(path, ACL_TYPE_EXTENDED) :
+	    acl_get_file(path, ACL_TYPE_EXTENDED);
+	if (acl == NULL) {
+		/* Darwin reports ENOENT when an existing path has no ACL. */
+		if (errno == ENOENT || errno == ENOTSUP)
+			return;
+		err(1, "cannot inspect OpenSSH installation ACL: %s", path);
+	}
+	while (acl_get_entry(acl, id, &entry) == 0) {
+		id = ACL_NEXT_ENTRY;
+		if (acl_get_tag_type(entry, &tag) != 0 ||
+		    acl_get_permset_mask_np(entry, &rights) != 0 ||
+		    acl_get_flagset_np(entry, &flags) != 0 ||
+		    (only = acl_get_flag_np(flags, ACL_ENTRY_ONLY_INHERIT)) < 0 ||
+		    (files = acl_get_flag_np(flags, ACL_ENTRY_FILE_INHERIT)) < 0 ||
+		    (dirs = acl_get_flag_np(flags, ACL_ENTRY_DIRECTORY_INHERIT)) < 0 ||
+		    (limit = acl_get_flag_np(flags, ACL_ENTRY_LIMIT_INHERIT)) < 0)
+			err(1, "cannot read OpenSSH installation ACL: %s", path);
+		if (tag != ACL_EXTENDED_ALLOW || !(rights & change))
+			continue;
+		/* A new intermediate directory can itself grant access to its children. */
+		if (only && !((scope == NEW_FILE && files) ||
+		    (scope == NEW_DIRECTORY && dirs) ||
+		    (scope == NEW_SUBTREE && (dirs || (files && !limit)))))
+			continue;
+		if ((owner = acl_get_qualifier(entry)) == NULL)
+			err(1, "cannot identify OpenSSH installation ACL: %s", path);
+		if (memcmp(owner, root_user, sizeof(uuid_t)) != 0)
+			errx(1, "unsafe privileged OpenSSH installation ACL: %s", path);
+		acl_free(owner);
+	}
+	if (errno != EINVAL)
+		err(1, "cannot enumerate OpenSSH installation ACL: %s", path);
+	acl_free(acl);
+}
+
+/*
+ * Walk the path as the kernel will, including the recorded spelling of each
+ * symlink target. Every existing parent must be protected before its child is
+ * examined. An optional default may end below a protected, absent component.
+ */
+static void
+check_trusted_path(const char *path, const uuid_t root_user, enum acl_scope absent,
+    unsigned int links)
+{
+	char current[PATH_MAX] = "/", target[PATH_MAX], next[PATH_MAX];
+	const char *p = path, *end;
+	size_t len, used;
+	ssize_t n;
+	struct stat st;
+	int written;
+
+	if (*p != '/')
+		errx(1, "expected an absolute OpenSSH default: %s", path);
+	for (;;) {
+		if (lstat(current, &st) != 0) {
+			if (absent != EXISTING && errno == ENOENT) {
+				char *sep = strrchr(current, '/');
+				sep[sep == current ? 1 : 0] = '\0';
+				check_acl(current, root_user, *p ? NEW_SUBTREE : absent);
+				return;
+			}
+			err(1, "cannot inspect OpenSSH installation: %s", current);
+		}
+		if (!platform_sys_dir_uid(st.st_uid))
+			errx(1, "unsafe privileged OpenSSH owner: %s", current);
+		if (S_ISLNK(st.st_mode)) {
+			if (links >= MAXSYMLINKS)
+				errx(1, "too many links in OpenSSH path: %s", path);
+			check_acl(current, root_user, SYMLINK);
+			n = readlink(current, target, sizeof(target));
+			if (n < 0 || (size_t)n >= sizeof(target))
+				errx(1, "cannot read OpenSSH path link: %s", current);
+			target[n] = '\0';
+			if (*target == '/')
+				written = snprintf(next, sizeof(next), "%s%s", target, p);
+			else {
+				*strrchr(current, '/') = '\0';
+				written = snprintf(next, sizeof(next), "%s/%s%s",
+				    current, target, p);
+			}
+			if (written < 0 || (size_t)written >= sizeof(next))
+				errx(1, "OpenSSH link target is too long");
+			check_trusted_path(next, root_user, absent, links + 1);
+			return;
+		}
+		if ((st.st_mode & 022) != 0 ||
+		    (!S_ISDIR(st.st_mode) && !S_ISREG(st.st_mode)))
+			errx(1, "unsafe privileged OpenSSH path: %s", current);
+		check_acl(current, root_user, EXISTING);
+		while (*p == '/')
+			p++;
+		if (*p == '\0')
+			return;
+		if (!S_ISDIR(st.st_mode))
+			errx(1, "invalid OpenSSH path component: %s", current);
+		end = p + strcspn(p, "/");
+		len = (size_t)(end - p);
+		if (len == 2 && strncmp(p, "..", len) == 0) {
+			if (current[1] != '\0') {
+				char *sep = strrchr(current, '/');
+				sep[sep == current ? 1 : 0] = '\0';
+			}
+		} else if (!(len == 1 && *p == '.')) {
+			used = strlen(current);
+			if (used > 1 && used < sizeof(current) - 1)
+				current[used++] = '/';
+			if (len >= sizeof(current) - used)
+				errx(1, "OpenSSH default path is too long");
+			memcpy(current + used, p, len);
+			current[used + len] = '\0';
+		}
+		p = end;
+	}
+}
+
+__attribute__((constructor)) static void
+init_darwin_defaults(void)
+{
+	char image[PATH_MAX], prefix[PATH_MAX], *role, *file, *dst;
+	const char *input;
+	int privileged = geteuid() == 0 || issetugid();
+	uuid_t root_user;
+	uint32_t cap = sizeof(image);
+	size_t i, len, room;
+
+	if (_NSGetExecutablePath(image, &cap) != 0 || realpath(image, prefix) == NULL)
+		errx(1, "cannot locate the installed OpenSSH executable");
+	if (privileged) {
+		if (mbr_uid_to_uuid(0, root_user) != 0)
+			errx(1, "cannot identify the root account");
+		check_trusted_path(prefix, root_user, EXISTING, 0);
+	}
+	file = strrchr(prefix, '/');
+	if (file == NULL || file == prefix)
+		errx(1, "invalid OpenSSH executable location");
+	*file = '\0';
+	role = strrchr(prefix, '/');
+	if (role != NULL && (strcmp(role, "/bin") == 0 ||
+	    strcmp(role, "/sbin") == 0 || strcmp(role, "/libexec") == 0))
+		*role = '\0';
+	else if (privileged)
+		errx(1, "unknown privileged OpenSSH executable directory: %s", prefix);
+	len = strlen(prefix);
+	for (i = 0; i < sizeof(templates) / sizeof(templates[0]); i++) {
+		dst = ssh_darwin_defaults[i];
+		room = sizeof(ssh_darwin_defaults[i]);
+		for (input = templates[i]; *input != '\0'; input++) {
+			if (*input == '\001') {
+				if (privileged) {
+					char owned[PATH_MAX];
+					size_t suffix = lists[i] ? strcspn(input + 1, ":") :
+					    strlen(input + 1);
+					if (len + suffix >= sizeof(owned))
+						errx(1, "OpenSSH default path is too long");
+					memcpy(owned, prefix, len);
+					memcpy(owned + len, input + 1, suffix);
+					owned[len + suffix] = '\0';
+					check_trusted_path(owned, root_user,
+					    directories[i] ? NEW_DIRECTORY : NEW_FILE, 0);
+				}
+				if (room <= len)
+					errx(1, "OpenSSH default path is too long");
+				memcpy(dst, prefix, len);
+				dst += len;
+				room -= len;
+			} else {
+				if (room <= 1)
+					errx(1, "OpenSSH default path is too long");
+				*dst++ = *input;
+				room--;
+			}
+		}
+		*dst = '\0';
+	}
+}
+
+const char *
+ssh_darwin_rc_command(void)
+{
+	static char command[sizeof(_PATH_BSHELL) + 4 * PATH_MAX + 4];
+	const char *src = _PATH_SSH_SYSTEM_RC;
+	char *dst = command;
+
+	memcpy(dst, _PATH_BSHELL, sizeof(_PATH_BSHELL) - 1);
+	dst += sizeof(_PATH_BSHELL) - 1;
+	*dst++ = ' ';
+	*dst++ = '\'';
+	while (*src != '\0') {
+		if (*src == '\'') {
+			memcpy(dst, "'\\''", 4);
+			dst += 4;
+		} else
+			*dst++ = *src;
+		src++;
+	}
+	*dst++ = '\'';
+	*dst = '\0';
+	return command;
+}
