+/* SPDX-License-Identifier: BSD-2-Clause */
+/* Generate recipient-relative defaults from the values selected by configure. */
+#define SSH_DARWIN_GENERATING_DEFAULTS
+#include "includes.h"
+#include "pathnames.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#define ENTRY(name) { #name, name, 0, 0 }
+#define DIRECTORY(name) { #name, name, 0, 1 }
+#define PATH_LIST(name) { #name, name, 1, 1 }
+static const struct {
+	const char *name;
+	const char *value;
+	int is_list;
+	int directory;
+} defaults[] = {
+	DIRECTORY(SSHDIR), ENTRY(_PATH_SSH_SYSTEM_HOSTFILE),
+	ENTRY(_PATH_SSH_SYSTEM_HOSTFILE2), ENTRY(_PATH_SERVER_CONFIG_FILE),
+	ENTRY(_PATH_HOST_CONFIG_FILE), ENTRY(_PATH_HOST_ECDSA_KEY_FILE),
+	ENTRY(_PATH_HOST_RSA_KEY_FILE), ENTRY(_PATH_HOST_ED25519_KEY_FILE),
+	ENTRY(_PATH_HOST_MLDSA44_ED25519_KEY_FILE), ENTRY(_PATH_DH_MODULI),
+	ENTRY(_PATH_SSH_PROGRAM), ENTRY(_PATH_SSHD_SESSION), ENTRY(_PATH_SSHD_AUTH),
+	DIRECTORY(_PATH_SSH_PIDDIR), ENTRY(_PATH_SSH_DAEMON_PID_FILE),
+	ENTRY(_PATH_SSH_SYSTEM_RC), ENTRY(_PATH_SSH_HOSTS_EQUIV),
+	ENTRY(_PATH_SSH_ASKPASS_DEFAULT), ENTRY(_PATH_SSH_KEY_SIGN),
+	ENTRY(_PATH_SSH_PKCS11_HELPER), ENTRY(_PATH_SSH_SK_HELPER),
+	ENTRY(_PATH_XAUTH), ENTRY(_PATH_SFTP_SERVER), DIRECTORY(_PATH_PRIVSEP_CHROOT_DIR),
+	PATH_LIST(_PATH_STDPATH),
+#ifdef XAUTH_PATH
+	ENTRY(XAUTH_PATH),
+#endif
+#ifdef SUPERUSER_PATH
+	PATH_LIST(SUPERUSER_PATH),
+#endif
+};
+
+static void
+write_template(const char *value, const char *prefix, size_t prefixlen, int list)
+{
+	const char *p;
+	unsigned char c;
+
+	putchar('"');
+	for (p = value; *p != '\0';) {
+		if ((p == value || (list && p[-1] == ':')) &&
+		    strncmp(p, prefix, prefixlen) == 0 &&
+		    (p[prefixlen] == '\0' || p[prefixlen] == '/' ||
+		    (list && p[prefixlen] == ':'))) {
+			fputs("\\001", stdout);
+			p += prefixlen;
+			continue;
+		}
+		c = (unsigned char)*p++;
+		if (c == 1) {
+			fputs("unsupported control character in OpenSSH defaults\n", stderr);
+			exit(1);
+		}
+		if (c < ' ' || c > '~' || c == '"' || c == '\\')
+			printf("\\%03o", c);
+		else
+			putchar(c);
+	}
+	putchar('"');
+}
+
+int
+main(int argc, char **argv)
+{
+	size_t i, n = sizeof(defaults) / sizeof(defaults[0]);
+
+	if (argc != 2 || argv[1][0] != '/')
+		return 1;
+	puts("#ifndef SSH_DARWIN_DEFAULTS_H\n#define SSH_DARWIN_DEFAULTS_H");
+	puts("#include <sys/syslimits.h>");
+	printf("extern char ssh_darwin_defaults[%zu][PATH_MAX];\n", n);
+	puts("extern const char *ssh_darwin_rc_command(void);");
+	puts("#ifdef SSH_DARWIN_DEFAULTS_IMPL\nstatic const char *const templates[] = {");
+	for (i = 0; i < n; i++) {
+		write_template(defaults[i].value, argv[1], strlen(argv[1]), defaults[i].is_list);
+		puts(",");
+	}
+	puts("};\nstatic const int lists[] = {");
+	for (i = 0; i < n; i++)
+		printf("%d,\n", defaults[i].is_list);
+	puts("};\nstatic const int directories[] = {");
+	for (i = 0; i < n; i++)
+		printf("%d,\n", defaults[i].directory);
+	puts("};\n#endif");
+	for (i = 0; i < n; i++)
+		printf("#undef %s\n#define %s ssh_darwin_defaults[%zu]\n",
+		    defaults[i].name, defaults[i].name, i);
+	puts("#endif");
+	return ferror(stdout) != 0;
+}
