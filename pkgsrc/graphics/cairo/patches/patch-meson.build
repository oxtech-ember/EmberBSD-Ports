Look for library providing backtrace_symbols()

--- meson.build.orig
+++ meson.build
@@ -189,6 +189,7 @@
 ]
 
 m_dep = cc.find_library('m', required: false)
+backtrace_dep = cc.find_library('execinfo', required: false)
 # Used in util
 gtk_dep = dependency('gtk+-2.0', required: get_option('gtk2-utils'))
 
