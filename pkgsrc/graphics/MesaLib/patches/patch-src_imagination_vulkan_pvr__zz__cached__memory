+/* Clean (and optionally invalidate) CPU cache lines of non-coherent ranges.
+ * EL0 data cache maintenance needs SCTLR_EL1.UCI, which NetBSD enables.
+ */
+static void pvr_maintain_mapped_ranges(VkDevice _device,
+                                       uint32_t memoryRangeCount,
+                                       const VkMappedMemoryRange *pMemoryRanges,
+                                       bool invalidate)
+{
+#if defined(__aarch64__)
+   VK_FROM_HANDLE(pvr_device, device, _device);
+   bool done = false;
+
+   util_pre_flush_fence();
+
+   for (uint32_t i = 0; i < memoryRangeCount; i++) {
+      VK_FROM_HANDLE(pvr_device_memory, mem, pMemoryRanges[i].memory);
+      const VkMemoryType *mem_type =
+         &device->pdevice->memory.memoryTypes[mem->vk.memory_type_index];
+
+      if ((mem_type->propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) ||
+          !mem->bo->map) {
+         continue;
+      }
+
+      const VkDeviceSize size = vk_device_memory_range(&mem->vk,
+                                                       pMemoryRanges[i].offset,
+                                                       pMemoryRanges[i].size);
+      void *start = (char *)mem->bo->map + pMemoryRanges[i].offset;
+
+      if (invalidate)
+         util_flush_inval_range_no_fence(start, size);
+      else
+         util_flush_range_no_fence(start, size);
+      done = true;
+   }
+
+   if (done) {
+      if (invalidate)
+         util_post_flush_inval_fence();
+      else
+         util_post_flush_fence();
+   }
+#endif
+}
+
 VkResult pvr_FlushMappedMemoryRanges(VkDevice _device,
                                      uint32_t memoryRangeCount,
                                      const VkMappedMemoryRange *pMemoryRanges)
 {
+   pvr_maintain_mapped_ranges(_device, memoryRangeCount, pMemoryRanges, false);
    return VK_SUCCESS;
 }
 
