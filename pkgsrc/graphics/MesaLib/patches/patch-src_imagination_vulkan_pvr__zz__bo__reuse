+/* Keep transient command storage bounded across all heaps of one device. */
+#define PVR_BO_CACHE_MAX_BYTES (1024U * 1024U)
+#define PVR_BO_CACHE_MAX_COUNT 16U
+
+static void pvr_bo_destroy(struct pvr_device *device, struct pvr_bo *bo);
+
+void pvr_bo_cache_init(struct pvr_device *device)
+{
+   struct pvr_bo_cache *cache = &device->bo_cache;
+
+   list_inithead(&cache->free_bos);
+   cache->bytes = 0;
+   cache->count = 0;
+   simple_mtx_init(&cache->mutex, mtx_plain);
+}
+
+static void pvr_bo_cache_flush(struct pvr_device *device)
+{
+   struct pvr_bo_cache *cache = &device->bo_cache;
+   struct list_head retired;
+
+   list_inithead(&retired);
+   simple_mtx_lock(&cache->mutex);
+   if (!list_is_empty(&cache->free_bos)) {
+      list_replace(&cache->free_bos, &retired);
+      list_inithead(&cache->free_bos);
+   }
+   cache->bytes = 0;
+   cache->count = 0;
+   simple_mtx_unlock(&cache->mutex);
+
+   /* Drain only this snapshot; other command pools may keep freeing BOs. */
+   list_for_each_entry_safe (struct pvr_bo, bo, &retired, link) {
+      list_del(&bo->link);
+      pvr_bo_destroy(device, bo);
+   }
+}
+
+void pvr_bo_cache_fini(struct pvr_device *device)
+{
+   pvr_bo_cache_flush(device);
+   simple_mtx_destroy(&device->bo_cache.mutex);
+}
+
+static struct pvr_bo *pvr_bo_cache_take(struct pvr_device *device,
+                                      struct pvr_winsys_heap *heap,
+                                      uint64_t size,
+                                      uint64_t alignment,
+                                      uint64_t flags)
+{
+   struct pvr_bo_cache *cache = &device->bo_cache;
+
+   if (!(flags & PVR_BO_ALLOC_FLAG_CACHE))
+      return NULL;
+
+   simple_mtx_lock(&cache->mutex);
+   list_for_each_entry (struct pvr_bo, bo, &cache->free_bos, link) {
+      if (bo->alloc_heap == heap && bo->alloc_size == size &&
+          bo->alloc_alignment == alignment && bo->alloc_flags == flags) {
+         list_del(&bo->link);
+         cache->bytes -= bo->bo->size;
+         cache->count--;
+         assert(bo->ref_count == 1);
+         simple_mtx_unlock(&cache->mutex);
+         return bo;
+      }
+   }
+   simple_mtx_unlock(&cache->mutex);
+   return NULL;
+}
+
+static bool pvr_bo_cache_put(struct pvr_device *device, struct pvr_bo *bo)
+{
+   struct pvr_bo_cache *cache = &device->bo_cache;
+   struct list_head retired;
+
+   if (!(bo->alloc_flags & PVR_BO_ALLOC_FLAG_CACHE) ||
+       bo->bo->size > PVR_BO_CACHE_MAX_BYTES)
+      return false;
+
+   list_inithead(&retired);
+   simple_mtx_lock(&cache->mutex);
+   /* A baked CSB can leave stale list links. Do not dereference them. */
+   list_addtail(&bo->link, &cache->free_bos);
+   bo->ref_count = 1;
+   cache->bytes += bo->bo->size;
+   cache->count++;
+   while (cache->bytes > PVR_BO_CACHE_MAX_BYTES ||
+          cache->count > PVR_BO_CACHE_MAX_COUNT) {
+      struct pvr_bo *old = list_first_entry(&cache->free_bos, struct pvr_bo, link);
+      list_del(&old->link);
+      cache->bytes -= old->bo->size;
+      cache->count--;
+      list_addtail(&old->link, &retired);
+   }
+   simple_mtx_unlock(&cache->mutex);
+
+   list_for_each_entry_safe (struct pvr_bo, old, &retired, link) {
+      list_del(&old->link);
+      pvr_bo_destroy(device, old);
+   }
+   return true;
+}
