Origin: EmberBSD; AI-assisted Mesa 26.2.4 adaptation.
Status: local; not submitted upstream.

NetBSD plain atexit does not record a DSO owner. Register using the native
__cxa_atexit ABI so dlclose removes callbacks before code is unmapped.
Preserve call-time reverse registration order, including C++ destructors,
rather than unconditional per-file destructor order. The trampoline retains
the real callback type and frees its allocation on registration failure.

Supersedes pkgsrc HAVE_NOATEXIT adaptations from revision
0491f5e57e8fba00998bf1a6c0958ef421fefaa1 (NetBSD patch identifiers and
individual disposition recorded in ../../mesa-patches.md). New helper code
is MIT-licensed; original Mesa licenses and copyright remain unchanged.

--- src/util/u_atexit.c.orig
+++ src/util/u_atexit.c
@@ -0,0 +1,46 @@
+/* Copyright 2026 EmberBSD contributors
+ * SPDX-License-Identifier: MIT
+ */
+#include <stdlib.h>
+
+#include "u_atexit.h"
+
+#if defined(__NetBSD__)
+extern int __cxa_atexit(void (*)(void *), void *, void *);
+extern void *__dso_handle __attribute__((visibility("hidden")));
+
+struct util_exit_callback {
+   void (*func)(void);
+};
+
+static void
+util_run_exit_callback(void *data)
+{
+   struct util_exit_callback *callback = data;
+   void (*func)(void) = callback->func;
+
+   free(callback);
+   func();
+}
+#endif
+
+int
+util_atexit(void (*func)(void))
+{
+#if defined(__NetBSD__)
+   /* NetBSD's plain atexit does not bind callbacks to their owning DSO.
+    * Keep registration order and remove callbacks before that DSO unloads.
+    */
+   struct util_exit_callback *callback = malloc(sizeof(*callback));
+   if (!callback)
+      return -1;
+
+   callback->func = func;
+   int result = __cxa_atexit(util_run_exit_callback, callback, &__dso_handle);
+   if (result != 0)
+      free(callback);
+   return result;
+#else
+   return atexit(func);
+#endif
+}
