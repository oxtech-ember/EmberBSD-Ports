$NetBSD$

Origin: EmberBSD contributors (AI-assisted); not submitted upstream.
Use the common GoogleTest provider only when Mesa tests are enabled.

--- src/gtest/meson.build.orig
+++ src/gtest/meson.build
@@ -1,16 +1,10 @@
 # Copyright © 2017 Intel Corporation
 # SPDX-License-Identifier: MIT
 
-libgtest = static_library(
-  'gtest',
-  files('src/gtest-all.cc', 'src/gtest_main.cc'),
-  include_directories : include_directories('include'),
-  override_options: 'warning_level=1',
-  build_by_default : false,
-)
-
+if with_tests or with_radv_tests or with_aco_tests or with_gallium_mediafoundation_test
+configure_file(input : 'include/mesa-gtest-extras.h', output : 'mesa-gtest-extras.h', copy : true)
 idep_gtest = declare_dependency(
-  link_with : libgtest,
-  include_directories : include_directories('include', is_system : true),
+  include_directories : include_directories('.'),
-  dependencies : [dep_thread],
+  dependencies : [dependency('gtest_main', method : 'pkg-config'), dep_thread],
 )
+endif
