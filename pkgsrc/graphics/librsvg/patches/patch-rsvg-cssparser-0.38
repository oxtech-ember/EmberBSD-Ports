     use crate::document::Document;
     use crate::is_element_of_type;
+
+    #[test]
+    fn unsupported_pseudo_class_reports_rule_boundary_and_name() {
+        let css = "rect { fill: red; }\n\nrect:unknown-rsvg-pseudo { fill: blue; }\n";
+        let mut input = Parser::new(css);
+        let mut rule_parser = RuleParser {
+            session: Session::new_for_test_suite(),
+        };
+        let mut stylesheet = StyleSheetParser::new(&mut input, &mut rule_parser);
+
+        assert!(stylesheet.next().unwrap().is_ok());
+        let (error, source, boundary) = stylesheet.next().unwrap().unwrap_err();
+
+        assert!(source.starts_with("rect:unknown-rsvg-pseudo"));
+        assert_eq!(boundary.line, 2);
+        assert!(matches!(
+            error.kind,
+            cssparser::ParseErrorKind::Custom(ValueErrorKind::Parse(ref message))
+                if message.contains("unknown-rsvg-pseudo")
+        ));
+    }
+
+    #[test]
+    fn unsupported_at_rule_reports_rule_boundary_and_name() {
+        let css = "@unknown-rsvg-rule value;\n";
+        let mut input = Parser::new(css);
+        let mut rule_parser = RuleParser {
+            session: Session::new_for_test_suite(),
+        };
+        let (error, source, boundary) = StyleSheetParser::new(&mut input, &mut rule_parser)
+            .next()
+            .unwrap()
+            .unwrap_err();
+
+        assert!(source.starts_with("@unknown-rsvg-rule"));
+        assert_eq!(boundary.line, 0);
+        assert!(matches!(
+            error.kind,
+            cssparser::ParseErrorKind::Custom(ValueErrorKind::Parse(ref message))
+                if message.contains("@unknown-rsvg-rule")
+        ));
+    }
 
