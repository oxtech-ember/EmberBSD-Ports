 /// Errors from the CSS parsing process
 #[allow(dead_code)] // looks like we are not actually using this yet?
 #[derive(Debug)]
-pub enum ParseErrorKind<'i> {
-    Selector(selectors::parser::SelectorParseErrorKind<'i>),
-}
-
-impl<'i> From<selectors::parser::SelectorParseErrorKind<'i>> for ParseErrorKind<'i> {
-    fn from(e: selectors::parser::SelectorParseErrorKind<'_>) -> ParseErrorKind<'_> {
+pub enum ParseErrorKind {
+    Selector(selectors::parser::SelectorParseErrorKind),
+    UnsupportedPseudoClassOrElement(String),
+}
+
+// cssparser 0.38 errors no longer carry token text or source positions. The
+// stylesheet iterators provide the rule/declaration boundary for diagnostics.
+
+impl From<selectors::parser::SelectorParseErrorKind> for ParseErrorKind {
+    fn from(e: selectors::parser::SelectorParseErrorKind) -> ParseErrorKind {
         ParseErrorKind::Selector(e)
+    }
+}
+
+impl From<ParseErrorKind> for ValueErrorKind {
+    fn from(error: ParseErrorKind) -> ValueErrorKind {
+        match error {
+            ParseErrorKind::Selector(_) => ValueErrorKind::parse_error("Could not parse selector"),
+            ParseErrorKind::UnsupportedPseudoClassOrElement(name) => {
+                ValueErrorKind::parse_error(&format!("Unsupported pseudo-class or element: {name}"))
+            }
+        }
     }
 }
 
