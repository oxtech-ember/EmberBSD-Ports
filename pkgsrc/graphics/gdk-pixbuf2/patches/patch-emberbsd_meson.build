$NetBSD$

Use native generators and real EmberBSD queries; retain the full thumbnailer.
Native and unselected cross builds retain their existing execution paths.
Origin: EmberBSD (AI-assisted); not submitted upstream.

--- meson.build.orig
+++ meson.build
@@ -422,7 +422,11 @@
 # Auxiliary scripts
 gen_resources = find_program('build-aux/gen-resources.py')
 gen_installed_test = find_program('build-aux/gen-installed-test.py')
-gen_thumbnailer = find_program('build-aux/gen-thumbnailer.py')
+if meson.is_cross_build() and meson.get_external_property('emberbsd_gi_cross', false)
+  gen_thumbnailer = [find_program(meson.get_external_property('emberbsd_pixbuf_python'), native: true), files('build-aux/gen-thumbnailer.py')]
+else
+  gen_thumbnailer = find_program('build-aux/gen-thumbnailer.py')
+endif
 
 # Needed by gen-resources.py
 glib_compile_resources = find_program('glib-compile-resources')
@@ -438,6 +442,9 @@
   if get_option('tests')
     subdir('tests')
   endif
+endif
+
+if not meson.is_cross_build() or emberbsd_gi_cross
   thumbnailer_opt = get_option('thumbnailer').disable_auto_if(glycin_dep.found())
   if not thumbnailer_opt.disabled()
     subdir('thumbnailer')
