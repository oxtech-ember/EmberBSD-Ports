+def main(args):
+  output = None
+  if args and args[0] == "--header":
+    if len(args) != 6 or args[2] != "--build-root" or args[4] != "--receipt":
+      raise ValueError("use --header OUTPUT --build-root ROOT --receipt RECEIPT")
+    output, build_root, args = args[1], os.path.realpath(args[3]), args[4:]
+    output = os.path.realpath(output)
+    if (not os.path.isdir(build_root) or output == build_root or
+        os.path.commonpath([build_root, output]) != build_root):
+      raise ValueError("header must be inside the build root")
+  if args and args[0] == "--receipt":
+    if len(args) != 2:
+      raise ValueError("use --receipt RECEIPT")
+    with open(args[1], encoding="utf-8") as source:
+      receipt = json.load(source)
+    if (not isinstance(receipt, dict) or
+        receipt.get("format") != "emberbsd-prepared-source" or
+        type(receipt.get("version")) is not int or receipt["version"] != 1 or
+        receipt.get("package") != "lang/v8" or
