 # The first two arguments can be used to specify a file to redirect the
 # stdout to.
+
+# EmberBSD: optional scoped runtime launcher for host tools (see
+# build/gn_run_binary.py); may precede or follow --redirect-stdout.
+def _emberbsd_runtime_launcher(cmd):
+  import os
+  if cmd[:1] != ['--runtime-launcher']:
+    return [], cmd
+  if len(cmd) < 5 or cmd[2] != '--runtime-view':
+    sys.exit('runtime launcher and view must be selected together')
+  return [sys.executable, '-B', cmd[1], '--runtime-view',
+          os.path.abspath(cmd[3]), '--'], cmd[4:]
+
 cmd = sys.argv[1:]
 kwargs = {}
 stdout_file = None
+launcher, cmd = _emberbsd_runtime_launcher(cmd)
 if cmd and cmd[0] == '--redirect-stdout':
   stdout_file = Path(cmd[1])
   kwargs = dict(stdout=subprocess.PIPE)
   cmd = cmd[2:]
+if not launcher:
+  launcher, cmd = _emberbsd_runtime_launcher(cmd)
+cmd = launcher + cmd
 
 process = subprocess.Popen(cmd, **kwargs)
 stdout, _ = process.communicate()
