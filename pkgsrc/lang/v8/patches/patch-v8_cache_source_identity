+declare_args() {
+  # An arbitrary string that is mixed into the hash that keys code caches and
+  # serialized wasm modules (see Version::Hash). Embedders that carry patches
+  # on top of a V8 release should derive this from their patch set so that
+  # serialized code produced by a differently-patched build of the same V8
+  # version is rejected instead of deserialized.
+  v8_version_hash_salt = ""
+
+  # Alternatively, a list of files (for example the embedder's patch series)
+  # whose contents are fingerprinted at gn gen time to produce the salt.
+  # Changing any of them re-runs gn gen.
+  v8_version_hash_salt_files = []
+
+  # Receipt for the selected common prepared source tree.
+  v8_prepared_source_receipt = ""
+}
+
+if (v8_prepared_source_receipt != "") {
+  assert(v8_version_hash_salt == "" && v8_version_hash_salt_files == [],
+         "Select one V8 source identity")
+  v8_version_hash_salt =
+      exec_script("../tools/gen-version-hash-salt.py",
+                  [ "--receipt", rebase_path(v8_prepared_source_receipt, root_build_dir) ],
+                  "trim string",
+                  [ v8_prepared_source_receipt ])
+} else if (v8_version_hash_salt_files != []) {
+  assert(v8_version_hash_salt == "",
+         "Set either v8_version_hash_salt or v8_version_hash_salt_files")
+  v8_version_hash_salt =
+      exec_script("../tools/gen-version-hash-salt.py",
+                  rebase_path(v8_version_hash_salt_files, root_build_dir),
+                  "trim string",
+                  v8_version_hash_salt_files)
+}
