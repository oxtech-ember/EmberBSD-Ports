@@ -0,0 +1,43 @@
+// Copyright 2026 the V8 project authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Unicode 18 simple folding relates a BMP character to a supplementary one.
+const bmp = '\u00df';
+const supplementary = '\u{1df95}';
+for (const legacy of [/^\u00df$/i, /^[\u00df]$/i, /^[s\u00df]$/i]) {
+  assertFalse(legacy.test(supplementary));
+  assertTrue(legacy.test(bmp));
+}
+assertFalse(new RegExp('^' + supplementary + '$', 'i').test(bmp));
+assertFalse(/^(\u00df)\1$/i.test(bmp + supplementary));
+for (const unicode of [/^\u00df$/iu, /^[\u00df]$/iu, /^\u00df$/iv,
+                       /^[\u00df]$/iv]) {
+  assertTrue(unicode.test(supplementary));
+}
+assertTrue(/^\u{1df95}$/iu.test(bmp));
+assertTrue(/^[\u{1df95}]$/iu.test(bmp));
+assertTrue(/^(\u00df)\1$/iu.test(bmp + supplementary));
+assertTrue(/^\xDF$/iu.test(supplementary));
+assertTrue(/^\u00df+$/iu.test(supplementary + supplementary));
+assertTrue(/^(\u00df)+$/iv.test(supplementary + supplementary));
+assertTrue(/^A\u00dfZ$/iu.test('A' + supplementary + 'Z'));
+const capture = /^(\u00df)$/iu.exec(supplementary);
+assertNotNull(capture);
+assertEquals(supplementary, capture[1]);
+assertTrue(/^(\u{1df95})\1$/iu.test(supplementary + bmp));
+assertTrue(/(?<=(\u00df))\1$/iu.test(bmp + supplementary));
+assertTrue(/(?<=(\u{1df95}))\1$/iu.test(supplementary + bmp));
+assertFalse(/^(\u00df)\1$/i.test(bmp + supplementary));
+// Inside lookbehind, the capture is evaluated before the backwards backreference.
+assertTrue(/(?<=\1(\u00df))$/iu.test(supplementary + bmp));
+assertTrue(/(?<=\1(\u{1df95}))$/iu.test(bmp + supplementary));
+assertFalse(/^([\u00df])\1$/iu.test(bmp + 'x'));
+assertFalse(/^([\u00df])\1$/iu.test(bmp));
+assertFalse(/(?<=\1([\u00df]))$/iu.test('x' + bmp));
+assertTrue(/^(\u00df?)\1$/iu.test(''));
+assertFalse(/^([\u00df])\1$/iu.test(bmp + '\ud837'));
+assertTrue(/^(\u00df)\1$/iv.test(bmp + supplementary));
+assertTrue(/^(\u{1df95})\1$/iv.test(supplementary + bmp));
+assertTrue(/(?<=\1(\u00df))$/iv.test(supplementary + bmp));
+assertTrue(/(?<=\1(\u{1df95}))$/iv.test(bmp + supplementary));
