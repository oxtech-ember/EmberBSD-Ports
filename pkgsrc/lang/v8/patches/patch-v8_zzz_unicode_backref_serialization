+  DCHECK_LE(capture_bytes, input_end - capture_start);
+  DCHECK_EQ(capture_start % alignof(char16_t), 0);
+  DCHECK_EQ(input_start % alignof(char16_t), 0);
+  DCHECK_EQ(input_end % alignof(char16_t), 0);
+  DCHECK_EQ(current % alignof(char16_t), 0);
+  DCHECK_EQ(capture_bytes % sizeof(char16_t), 0);
+  DCHECK_LE(capture_bytes / sizeof(char16_t),
+            static_cast<size_t>(std::numeric_limits<int32_t>::max()));
+  DCHECK_LE((input_end - input_start) / sizeof(char16_t),
+            static_cast<size_t>(std::numeric_limits<int32_t>::max()));
+  const auto* captured = reinterpret_cast<const char16_t*>(capture_start);
+  const auto* input = reinterpret_cast<const char16_t*>(input_start);
+  const int32_t capture_length = static_cast<int32_t>(capture_bytes / sizeof(char16_t));
+  const int32_t input_length = static_cast<int32_t>((input_end - input_start) / sizeof(char16_t));
