+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+// Origin: EmberBSD (AI-assisted).
+// RUN: %clang_profgen -o %t %s
+// RUN: %run %t
+// A truncated header must be rejected before any header field is read.
+#include <assert.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+uint64_t __llvm_profile_get_size_for_buffer(void);
+int __llvm_profile_write_buffer(char *);
+int __llvm_profile_check_compatibility(const char *, uint64_t);
+
+int main(void) {
+  uint64_t size = __llvm_profile_get_size_for_buffer();
+  assert(size > 32);
+  char *full = malloc((size_t)size);
+  assert(full && __llvm_profile_write_buffer(full) == 0);
+  assert(__llvm_profile_check_compatibility(full, size) == 0);
+  assert(__llvm_profile_check_compatibility(NULL, 0) != 0);
+  for (size_t n = 0; n < 32; n++) {
+    char *shortbuf = malloc(n ? n : 1);
+    assert(shortbuf);
+    memcpy(shortbuf, full, n);
+    assert(__llvm_profile_check_compatibility(shortbuf, n) != 0);
+    free(shortbuf);
+  }
+  free(full);
+  return 0;
+}
