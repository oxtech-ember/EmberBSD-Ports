+/* The package installs CLI and debugger programs in bin and CGI in libexec.
+ * Build-tree programs and other SAPIs retain their configured directories. */
+static const char *const php_program_suffixes[] = {
+    "/bin/php" PHP_LAYOUT_VERSION,
+    "/bin/phpdbg" PHP_LAYOUT_VERSION,
+    "/libexec/cgi-bin/php" PHP_LAYOUT_VERSION,
+    "/sbin/php-fpm" PHP_LAYOUT_VERSION
+};
+static const char *const configured_dirs[] = {
+    PHP_INCLUDE_PATH, PEAR_INSTALLDIR, PHP_EXTENSION_DIR, PHP_PREFIX,
+    PHP_BINDIR, PHP_SBINDIR, PHP_MANDIR, PHP_LIBDIR, PHP_DATADIR,
+    PHP_SYSCONFDIR, PHP_LOCALSTATEDIR, PHP_CONFIG_FILE_PATH, PHP_CONFIG_FILE_SCAN_DIR
+};
+static char *installed_dirs[sizeof(configured_dirs) / sizeof(configured_dirs[0])];
+static pthread_once_t php_layout_once = PTHREAD_ONCE_INIT;
+
+/* PHP path lists use a colon on Darwin. Replace complete prefix components. */
+static char *php_map_directories(const char *configured, const char *prefix)
+{
+    const size_t old_len = strlen(PHP_PREFIX), new_len = strlen(prefix);
+    size_t size = strlen(configured) + 1;
+    const char *entry = configured;
+    do {
+        size_t len = strcspn(entry, ":");
+        if (len >= old_len && !memcmp(entry, PHP_PREFIX, old_len)
+                && (len == old_len || entry[old_len] == '/')) {
+            size = size - old_len + new_len;
+        }
+        entry += len;
+    } while (*entry++ == ':');
+    char *result = malloc(size);
+    if (result == NULL) {
+        zend_error_noreturn(E_CORE_ERROR, "Cannot allocate PHP installation paths");
+    }
+    char *dest = result;
+    entry = configured;
+    for (;;) {
+        size_t len = strcspn(entry, ":");
+        if (len >= old_len && !memcmp(entry, PHP_PREFIX, old_len)
+                && (len == old_len || entry[old_len] == '/')) {
+            memcpy(dest, prefix, new_len);
+            dest += new_len;
+            entry += old_len;
+            len -= old_len;
+        }
+        memcpy(dest, entry, len);
+        dest += len;
+        entry += len;
+        *dest++ = *entry;
+        if (!*entry++) {
+            break;
+        }
+    }
+    return result;
+}
+
+static void php_initialize_package_layout(void)
+{
+    char executable[PATH_MAX], canonical[PATH_MAX];
+    uint32_t capacity = sizeof(executable);
+    if (_NSGetExecutablePath(executable, &capacity) || !realpath(executable, canonical)) {
+        return;
+    }
+    const size_t len = strlen(canonical);
+    for (size_t i = 0; i < sizeof(php_program_suffixes) / sizeof(php_program_suffixes[0]); ++i) {
+        const char *suffix = php_program_suffixes[i];
+        const size_t tail = strlen(suffix);
+        if (len <= tail || strcmp(canonical + len - tail, suffix)) {
+            continue;
+        }
+        canonical[len - tail] = 0;
+        for (size_t j = 0; j < sizeof(configured_dirs) / sizeof(configured_dirs[0]); ++j) {
+            installed_dirs[j] = php_map_directories(configured_dirs[j], canonical);
+        }
+        break;
+    }
+}
+
+PHPAPI const char *php_package_path(const char *configured)
+{
+    pthread_once(&php_layout_once, php_initialize_package_layout);
+    for (size_t i = 0; i < sizeof(configured_dirs) / sizeof(configured_dirs[0]); ++i) {
+        if (installed_dirs[i] && !strcmp(configured_dirs[i], configured)) {
+            return installed_dirs[i];
+        }
+    }
+    return configured;
+}
