+#if defined(PERL_RELOCATABLE_INC) && defined(__APPLE__)
+PERL_CALLCONV const char *
+Perl_ember_runtime_shell(pTHX)
+{
+#ifdef PERL_IS_MINIPERL
+    return PL_sh_path;
+#else
+    const char *build_shell = PerlEnv_getenv("PERL_BUILD_SHELL");
+    SV *shell;
+
+    /* The build invokes the full interpreter before installing it. Keep the
+     * explicitly selected build shell; never infer a fallback from PATH. */
+    if (!TAINTING_get && build_shell && build_shell[0] == '/')
+        return build_shell;
+    if (!EMBERBSD_PERL_SHELL_RELATIVE[0])
+        return PL_sh_path;
+    shell = S_mayberelocate(aTHX_ STR_WITH_LEN(EMBERBSD_PERL_SHELL_RELATIVE),
+                           INCPUSH_CAN_RELOCATE);
+    return SvPV_nolen(sv_2mortal(shell));
+#endif
