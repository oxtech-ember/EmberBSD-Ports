$NetBSD$

Make the tfork fixture available to build-tree and installed smbtorture.

--- wscript_build.orig
+++ wscript_build
@@ -5,6 +5,7 @@
 srcdir = "."
 
 import samba_version
+from samba_utils import MODE_755
 
 bld.env.suffix3 = "3"
 bld.env.suffix4 = "4"
@@ -98,6 +99,12 @@
 bld.RECURSE('source4/utils/oLschema2ldif')
 bld.RECURSE('source4/ntvfs')
 bld.RECURSE('source4/torture')
+if bld.PYTHON_BUILD_IS_ENABLED():
+    tfork_script = 'testprogs/blackbox/tfork.sh'
+    bld.SAMBA_SCRIPT('tfork.sh', pattern=tfork_script, installdir='.',
+                     installname='tfork.sh')
+    bld.INSTALL_FILES('${SAMBA_LIBEXECDIR}', tfork_script,
+                      flat=True, chmod=MODE_755)
 bld.RECURSE('librpc')
 bld.RECURSE('source4')
 bld.RECURSE('source4/libcli')
