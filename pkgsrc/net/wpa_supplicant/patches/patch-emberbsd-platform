+static const char *skip_priority(const char *msg)
+{
+	const char *pos = msg;
+
+	if (*msg != '<')
+		return msg;
+
+	for (pos = msg + 1; isdigit((unsigned char)*pos); pos++)
+		continue;
+
+	if (*pos != '>')
+		return msg;
+
+	return ++pos;
+}
