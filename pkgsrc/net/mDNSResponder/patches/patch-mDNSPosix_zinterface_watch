$NetBSD$

Subscribe to interface changes before the initial address snapshot. This prevents
DHCP address events between enumeration and watcher setup from being lost. Keep
routing socket setup failure cleanup valid on both Netlink and PF_ROUTE systems.

--- mDNSPosix/mDNSPosix.c.orig
+++ mDNSPosix/mDNSPosix.c
@@ -1665,7 +1665,10 @@
     if (0 == ret)
         *pFD = sock;
     else
+    {
         err = errno;
+        (void) close(sock);
+    }
 
     return err;
 }
@@ -1930,15 +1933,36 @@
         return mStatus_NoMemoryErr;
 
     pChgRec->mDNS = m;
+    pChgRec->NotifySD = -1;
     err = OpenIfNotifySocket(&pChgRec->NotifySD);
     if (err == 0)
         err = mDNSPosixAddFDToEventLoop(pChgRec->NotifySD, InterfaceChangeCallback, pChgRec);
-    if (err)
+    if (err != mStatus_NoError)
+    {
+        if (pChgRec->NotifySD != -1)
+            (void) close(pChgRec->NotifySD);
         mDNSPlatformMemFree(pChgRec);
+    }
+    else
+    {
+        m->p->ifChangeRec = pChgRec;
+    }
 
     return err;
 }
 
+mDNSlocal void StopWatchingForInterfaceChange(mDNS *const m)
+{
+    IfChangeRec *pChgRec = (IfChangeRec *)m->p->ifChangeRec;
+    if (pChgRec != NULL)
+    {
+        m->p->ifChangeRec = NULL;
+        (void) mDNSPosixRemoveFDFromEventLoop(pChgRec->NotifySD);
+        (void) close(pChgRec->NotifySD);
+        mDNSPlatformMemFree(pChgRec);
+    }
+}
+
