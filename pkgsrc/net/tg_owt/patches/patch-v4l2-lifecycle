 bool VideoCaptureModuleV4L2::DeAllocateVideoBuffers() {
   RTC_CHECK_RUNS_SERIALIZED(&capture_checker_);
+
+  // Stop DMA before unmapping buffers. Partial StartCapture failures may have
+  // mapped buffers without ever having started a stream.
+  if (_streaming) {
+    enum v4l2_buf_type type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+    if (ioctl(_deviceFd, VIDIOC_STREAMOFF, &type) < 0) {
+      RTC_LOG(LS_INFO) << "VIDIOC_STREAMOFF error. errno: " << errno;
+      // Closing the device also stops capture if STREAMOFF failed.
+      close(_deviceFd);
+      _deviceFd = -1;
+    }
+    _streaming = false;
+  }
+
   // unmap buffers
-  for (int i = 0; i < _buffersAllocatedByDevice; i++)
+  for (int i = 0; i < _buffersMapped; i++)
     munmap(_pool[i].start, _pool[i].length);
 
   delete[] _pool;
-
-  // turn off stream
-  enum v4l2_buf_type type;
-  type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
-  if (ioctl(_deviceFd, VIDIOC_STREAMOFF, &type) < 0) {
-    RTC_LOG(LS_INFO) << "VIDIOC_STREAMOFF error. errno: " << errno;
-  }
+  _pool = nullptr;
+  _buffersMapped = 0;
 
   return true;
+}
+
+void VideoCaptureModuleV4L2::ReleaseDevice() {
+  DeAllocateVideoBuffers();
+  if (_deviceFd != -1) {
+    close(_deviceFd);
+    _deviceFd = -1;
+  }
+  _captureStarted = false;
+  _requestedCapability = configured_capability_ = VideoCaptureCapability();
 }
 
