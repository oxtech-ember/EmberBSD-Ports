+/*
+ * ppp_check_kernel_support - check whether the system has any ppp interfaces
+ * (in fact we check whether we can create one)
+ */
+int
+ppp_check_kernel_support(void)
+{
+    int s;
+    extern char *no_ppp_msg;
+    struct ifreq ifr;
+
+
+    if ((s = socket(AF_INET, SOCK_DGRAM, 0)) < 0)
+	fatal("%s: socket: %m", __func__);
+
+    (void)memset(&ifr, 0, sizeof(ifr));
+    strlcpy(ifr.ifr_name, "ppp0", sizeof(ifr.ifr_name));
+    if (ioctl(s, SIOCIFCREATE, &ifr) == -1) {
+	int notmine = errno == EEXIST;
+	(void)close(s);
+	if (notmine)
+	    return 1;
+	goto out;
+    }
+    (void)ioctl(s, SIOCIFDESTROY, &ifr);
+    (void)close(s);
+    return 1;
+
+out:
+    no_ppp_msg = "\
+This system lacks kernel support for PPP.  To include PPP support\n\
+in the kernel, please read the ppp(4) manual page.\n";
+    return 0;
+}
