--- data/meson.build.orig	2024-07-02 12:38:46.000000000 +0300
+++ data/meson.build	2026-11-08 13:55:01.417073352 +0300
@@ -32,10 +32,12 @@
 service_data.set('bindir', bindir)
 service_file = 'org.mobian_project.CallAudio.service'
 
-configure_file(
-  input : service_file + '.in',
-  output : service_file,
-  configuration : service_data,
-  install : true,
-  install_dir: servicedir,
-)
+if get_option('daemon')
+  configure_file(
+    input : service_file + '.in',
+    output : service_file,
+    configuration : service_data,
+    install : true,
+    install_dir: servicedir,
+  )
+endif
