Match the NEON FFT alignment check to vector pointer access and use NEON
load intrinsics for aligned and unaligned float pointers.

--- src/simd/pf_neon_float.h.orig
+++ src/simd/pf_neon_float.h
@@ -52,7 +52,7 @@
 } v4sf_union;
 
 #  define VARCH "NEON"
-#  define VREQUIRES_ALIGN 0  /* usually no alignment required */
+#  define VREQUIRES_ALIGN 1  /* FFT vector pointers require 16-byte alignment */
 #  define VZERO() vdupq_n_f32(0)
 #  define VMUL(a,b) vmulq_f32(a,b)
 #  define VADD(a,b) vaddq_f32(a,b)
@@ -111,7 +111,7 @@
 /* reverse/flip complex floats */
 #  define VREV_C(a)    vextq_f32(a, a, 2)
 
-#  define VALIGNED(ptr) ((((uintptr_t)(ptr)) & 0x3) == 0)
+#  define VALIGNED(ptr) ((((uintptr_t)(ptr)) & 0xF) == 0)
 
 #endif
 
--- include/pffft/pffft.h.orig
+++ include/pffft/pffft.h
@@ -65,8 +65,8 @@
    128<=N<=8192.
 
