+static GdkSurface* native_surface( GtkWidget* aWidget )
+{
+    GtkNative* native = aWidget ? gtk_widget_get_native( aWidget ) : nullptr;
+    return native ? gtk_native_get_surface( native ) : nullptr;
+}
+
+
+static bool widget_to_surface( GtkWidget* aWidget, double& aX, double& aY )
+{
+    GtkNative* native = aWidget ? gtk_widget_get_native( aWidget ) : nullptr;
+
+    if( !native || !gtk_native_get_surface( native ) )
+        return false;
+
+    const graphene_point_t input = GRAPHENE_POINT_INIT( static_cast<float>( aX ),
+                                                       static_cast<float>( aY ) );
+    graphene_point_t output;
+
+    if( !gtk_widget_compute_point( aWidget, GTK_WIDGET( native ), &input, &output ) )
+        return false;
+
+    double dx, dy;
+    gtk_native_get_surface_transform( native, &dx, &dy );
+    // GTK rendering adds this transform; event dispatch subtracts it.
+    // Match the actual snapshot/input implementation for widget-to-surface.
+    aX = output.x + dx;
+    aY = output.y + dy;
+    return true;
+}
