+#define VECTOR2D_ORDERED_H_
+
+#include <map>
+#include <set>
+
+#include <math/vector2d.h>
+
+/** Strict lexicographical ordering for VECTOR2I ordered containers. */
+struct VECTOR2I_LEXICOGRAPHICAL_LESS
+{
+    bool operator()( const VECTOR2I& aA, const VECTOR2I& aB ) const;
+};
+
+template <typename T>
+using VECTOR2I_MAP = std::map<VECTOR2I, T, VECTOR2I_LEXICOGRAPHICAL_LESS>;
