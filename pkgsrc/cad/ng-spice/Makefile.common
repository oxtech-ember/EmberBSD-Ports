# $NetBSD: Makefile.common,v 1.6 2025/11/17 11:00:26 wiz Exp $
# Used by cad/ng-spice and cad/ng-spice-shared.
# Origin: EmberBSD (AI-assisted); current ngspice with both installed interfaces.

VERSION=	47
PKGREVISION=	1
DISTNAME=	ngspice-${VERSION}
CATEGORIES=	cad
MASTER_SITES=	https://downloads.sourceforge.net/project/ngspice/ng-spice-rework/${VERSION}/

DISTINFO_FILE=	${.CURDIR}/../../cad/ng-spice/distinfo
PATCHDIR=	${.CURDIR}/../../cad/ng-spice/patches
PATCH_STRIP=	-p1

MAINTAINER=	pkgsrc-users@NetBSD.org
HOMEPAGE=	https://ngspice.sourceforge.net/
LICENSE=	modified-bsd AND gnu-lgpl-v2.1 AND gnu-gpl-v2 AND mpl-2.0

USE_LIBTOOL=	yes
USE_TOOLS+=	gmake autoconf autoheader pkg-config
USE_LANGUAGES=	c c++
GNU_CONFIGURE=	yes
CONFIGURE_HAS_LIBDIR=	yes
CONFIGURE_ARGS+=	--enable-cider --enable-xspice --enable-osdi --enable-klu
CONFIGURE_ARGS+=	--with-fftw3=yes
CONFIGURE_ARGS+=	--enable-shared --disable-static --disable-maintainer-mode
CONFIGURE_ARGS+=	--disable-silent-rules
PKGCONFIG_OVERRIDE+=	ngspice.pc.in

.include "../../mk/bsd.prefs.mk"
# GCC provides OpenMP through its libgomp runtime. Clang needs the LLVM
# OpenMP runtime of its own LLVM version, and Ports has none for LLVM 23
# (parallel/openmp is LLVM 21). A Clang build disables OpenMP rather than
# mixing LLVM versions. Configure defines USE_OMP unless OpenMP is disabled,
# even when the compiler has no OpenMP support.
_NGSPICE_FEATURES=	CIDER XSPICE OSDI KLU HAVE_LIBFFTW3
.if ${PKGSRC_COMPILER:Mclang}
CONFIGURE_ARGS+=	--disable-openmp
_NGSPICE_ABSENT=	USE_OMP
.else
CONFIGURE_ARGS+=	--enable-openmp
_NGSPICE_FEATURES+=	USE_OMP
_NGSPICE_ABSENT=	# none
.endif
.if ${USE_CROSS_COMPILE:U:tl} == "yes"
# XSPICE selects module linker flags from uname; pass the target through
# recursive gmake calls so a Darwin host does not select Darwin flags.
MAKE_FLAGS+=	uname=${OPSYS}
# Preserve the complete native command, including its host-binutils prefix.
CONFIGURE_ENV+=	CC_FOR_BUILD=${NATIVE_CC:Q}
CONFIGURE_ENV+=	CFLAGS_FOR_BUILD=${NATIVE_CFLAGS:U-O2:Q}
CONFIGURE_ENV+=	CPPFLAGS_FOR_BUILD= LDFLAGS_FOR_BUILD=
.endif

pre-configure:
	cd ${WRKSRC} && ${TOOLS_PATH.autoconf} && ${TOOLS_PATH.autoheader}

post-configure: ngspice-feature-check
.PHONY: ngspice-feature-check
ngspice-feature-check:
	${RUN} for feature in ${_NGSPICE_FEATURES}; do \
		${GREP} "^\#define $$feature " ${WRKSRC}/src/include/ngspice/config.h > /dev/null || exit 1; \
	done; \
	for feature in ${_NGSPICE_ABSENT}; do \
		! ${GREP} "^\#define $$feature " ${WRKSRC}/src/include/ngspice/config.h > /dev/null || exit 1; \
	done

BUILDLINK_API_DEPENDS.fftw+=	fftw>=3.3.11
.include "../../math/fftw/buildlink3.mk"
