$NetBSD$

Mark a failed karaoke formatter as an output stream error.
The shared output close check reports the existing input failure status.

--- examples/cli/cli.cpp.orig	2026-10-15 00:00:00.000000000 +0000
+++ examples/cli/cli.cpp
@@ -819,6 +819,7 @@ static bool output_wts(struct whisper_context * ctx,
     std::ifstream fin(font);
     if (!fin.is_open()) {
         fprintf(stderr, "%s: font not found at '%s', please specify a monospace font with -fp\n", __func__, font);
+        fout.setstate(std::ios::failbit);
         return false;
     }
 
