-static char * escape_double_quotes_and_backslashes(const char * str) {
-    if (str == NULL) {
-        return NULL;
+static std::string escape_json_string(const char * str) {
+    std::string escaped;
+    if (str == nullptr) {
+        return escaped;
     }
 
-    size_t escaped_length = strlen(str) + 1;
-
-    for (size_t i = 0; str[i] != '\0'; i++) {
-        if (str[i] == '"' || str[i] == '\\') {
-            escaped_length++;
-        }
-    }
-
-    char * escaped = (char *)calloc(escaped_length, 1); // pre-zeroed
-    if (escaped == NULL) {
-        return NULL;
-    }
-
-    size_t pos = 0;
-    for (size_t i = 0; str[i] != '\0'; i++) {
-        if (str[i] == '"' || str[i] == '\\') {
-            escaped[pos++] = '\\';
