# EmberBSD: CPU runtime package, based on upstream whisper.cpp 1.9.4.
DISTNAME=	whisper.cpp-1.9.4
PKGNAME=	whisper-cpp-1.9.4
CATEGORIES=	audio
MASTER_SITES=	${MASTER_SITE_GITHUB:=ggml-org/}
GITHUB_PROJECT=	whisper.cpp
GITHUB_TAG=	927cfce34f31707e17f2bff35c349632fb9e2c3a
WRKSRC=		${WRKDIR}/${GITHUB_PROJECT}-${GITHUB_TAG}

HOMEPAGE=	https://github.com/ggml-org/whisper.cpp
COMMENT=	Local CPU speech recognition with Whisper models
LICENSE=	mit AND unlicense

AI_PROGRAMS=	whisper-cli whisper-bench whisper-quantize
BUILD_TARGET=	${AI_PROGRAMS}

CMAKE_CONFIGURE_ARGS+=	-DWHISPER_BUILD_IS_DEV=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_BUILD_TESTS=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_BUILD_EXAMPLES=ON
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_BUILD_SERVER=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_CURL=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_SDL2=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_COMMON_FFMPEG=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_COREML=OFF
CMAKE_CONFIGURE_ARGS+=	-DWHISPER_OPENVINO=OFF

.include "../cpu.mk"
.include "../../mk/bsd.pkg.mk"
