@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <sys/lwpctl.h>
+#include <lwp.h>
+
+namespace onnxruntime {
+
+inline int GetNetBSDCurrentCpu() {
+  struct lwpctl* control = nullptr;
+  if (_lwp_ctl(LWPCTL_FEATURE_CURCPU, &control) != 0) {
+    return -1;
+  }
+  // The kernel owns this per-LWP mapping and updates the volatile CPU field.
+  return control->lc_curcpu;
+}
+
+}  // namespace onnxruntime
