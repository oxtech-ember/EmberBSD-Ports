# SPDX-License-Identifier: BSD-2-Clause
# Shared current Boost CMake profile. Both packages use the same source/features.
DISTNAME=	boost-1.92.0-cmake
PKGNAME=	boost-${BOOST_COMPONENT_PACKAGE}-1.92.0
WRKSRC=		${WRKDIR}/boost-1.92.0
CATEGORIES=	devel
MASTER_SITES=	https://github.com/boostorg/boost/releases/download/boost-1.92.0/
EXTRACT_SUFX=	.tar.xz
DISTINFO_FILE=	${.CURDIR}/../boost-libs/distinfo

HOMEPAGE=	https://www.boost.org/
COMMENT=	Common Boost 1.92.0 ${BOOST_COMPONENT_PACKAGE} for the planning profile
LICENSE=	boost-license

USE_LANGUAGES=		c c++
USE_CXX_FEATURES=	c++17
GCC_REQD+=		16.2
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_BUILD_TYPE=Release -DCMAKE_CXX_STANDARD=17
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_INSTALL_LIBDIR=lib
CMAKE_CONFIGURE_ARGS+=	-DBUILD_SHARED_LIBS=ON -DBUILD_TESTING=OFF
CMAKE_CONFIGURE_ARGS+=	-DBOOST_INCLUDE_LIBRARIES=serialization\;program_options\;test
CMAKE_CONFIGURE_ARGS+=	-DBOOST_INSTALL_LAYOUT=system
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON
CMAKE_CONFIGURE_ARGS+=	-DCMAKE_INSTALL_RPATH=${PREFIX}/lib\;${PREFIX}/gcc16/lib

INSTALLATION_DIRS+=	share/licenses/boost-${BOOST_COMPONENT_PACKAGE}

# The upstream install has no package components. Split the complete install
# within DESTDIR; no files in the live prefix are removed.
post-install:
.if ${BOOST_COMPONENT_PACKAGE} == "headers"
	${RUN} for directory in ${WRKSRC}/libs/*/include ${WRKSRC}/libs/numeric/*/include; do \
		if test -d "$$directory/boost"; then \
			${CP} -R "$$directory/boost" ${DESTDIR}${PREFIX}/include/; \
		fi; \
	done
	${RUN} ${FIND} ${DESTDIR}${PREFIX}/lib -maxdepth 1 -type f \
		\( -name '*.so*' -o -name '*.a' \) -exec ${RM} -f {} +
	${RUN} ${FIND} ${DESTDIR}${PREFIX}/lib -maxdepth 1 -type l \
		-name '*.so*' -exec ${RM} -f {} +
	${RUN} for directory in ${DESTDIR}${PREFIX}/lib/cmake/*; do \
		case "$${directory##*/}" in \
		boost_atomic-*|boost_chrono-*|boost_container-*|boost_date_time-*|boost_thread-*|boost_serialization-*|boost_wserialization-*|boost_program_options-*|boost_prg_exec_monitor-*|boost_test_exec_monitor-*|boost_unit_test_framework-*) ${RM} -r "$$directory";; \
		esac; \
	done
.else
	${RM} -r ${DESTDIR}${PREFIX}/include ${DESTDIR}${PREFIX}/share/boost-1.92.0
	${RUN} for directory in ${DESTDIR}${PREFIX}/lib/cmake/*; do \
		case "$${directory##*/}" in \
		boost_atomic-*|boost_chrono-*|boost_container-*|boost_date_time-*|boost_thread-*|boost_serialization-*|boost_wserialization-*|boost_program_options-*|boost_prg_exec_monitor-*|boost_test_exec_monitor-*|boost_unit_test_framework-*) ;; \
		*) ${RM} -r "$$directory";; \
		esac; \
	done
.endif
	${INSTALL_DATA} ${WRKSRC}/LICENSE_1_0.txt ${DESTDIR}${PREFIX}/share/licenses/boost-${BOOST_COMPONENT_PACKAGE}/LICENSE
	${INSTALL_DATA} ${FILESDIR}/SOURCE ${DESTDIR}${PREFIX}/share/licenses/boost-${BOOST_COMPONENT_PACKAGE}/SOURCE

.include "../../devel/cmake/build.mk"
.include "../../mk/bsd.pkg.mk"
