# SPDX-License-Identifier: MIT
# Origin: EmberBSD (AI-assisted). Shared CPU geometry and point-cloud I/O.
set(CMAKE_CXX_STANDARD 17 CACHE STRING "")
set(CMAKE_CXX_STANDARD_REQUIRED ON CACHE BOOL "")
set(CMAKE_CXX_EXTENSIONS OFF CACHE BOOL "")
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "")
set(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "")
set(PCL_SHARED_LIBS ON CACHE BOOL "")
set(PCL_ONLY_CORE_POINT_TYPES ON CACHE BOOL "Upstream core template instantiations")
set(PCL_ENABLE_MARCHNATIVE OFF CACHE BOOL "")
set(PCL_ENABLE_SSE OFF CACHE BOOL "")
set(PCL_ENABLE_AVX OFF CACHE BOOL "")
foreach(feature OPENMP VTK OPENGL GLEW CUDA OPENNI OPENNI2 LIBUSB PCAP PNG QHULL)
  set(WITH_${feature} OFF CACHE BOOL "")
endforeach()
set(WITH_QT NO CACHE STRING "")
set(CMAKE_DISABLE_FIND_PACKAGE_nanoflann ON CACHE BOOL "")
set(PCL_FLANN_REQUIRED_TYPE SHARED CACHE STRING "")
foreach(module common kdtree octree search sample_consensus filters 2d features registration io)
  set(BUILD_${module} ON CACHE BOOL "")
endforeach()
foreach(module geometry keypoints ml outofcore people recognition segmentation stereo surface tracking visualization apps examples tools simulation GPU CUDA)
  set(BUILD_${module} OFF CACHE BOOL "")
endforeach()
set(BUILD_global_tests OFF CACHE BOOL "The acceptance helper enables source-based tests")
