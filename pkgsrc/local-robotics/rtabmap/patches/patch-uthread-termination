 	runningMutex_.lock();
+#ifndef _WIN32
+	// A concurrent start may publish a new worker before we acquire the lock.
+	// Let that worker enter ThreadMain before waiting for its OS termination.
+	while(state_ == kSCreating)
+	{
+		runningMutex_.unlock();
+		uSleep(1);
+		runningMutex_.lock();
+	}
+	if(handle_ != 0)
+	{
+		const int result = Join(handle_);
+		if(result == 0)
+		{
+			handle_ = 0;
+			threadId_ = 0;
+		}
+		else
+		{
+			UERROR("Cannot join thread: error=%d", result);
+		}
+	}
+#endif
 	runningMutex_.unlock();
 
