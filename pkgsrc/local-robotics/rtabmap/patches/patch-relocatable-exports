Keep installed CMake targets independent of the build sysroot.

External imported OpenCV/PCL targets propagate their own current includes.
The compiler supplies pthread headers. Preserve build-only include hints,
and resolve the same pinned shared providers when a consumer imports RTABMap.

Origin: EmberBSD (AI-assisted), not submitted upstream.

--- a/corelib/src/CMakeLists.txt
+++ b/corelib/src/CMakeLists.txt
@@ -891,8 +891,7 @@
   "$<INSTALL_INTERFACE:${INSTALL_INCLUDE_DIR}>")
 
 target_include_directories(rtabmap_core SYSTEM PUBLIC 
-  "$<BUILD_INTERFACE:${PUBLIC_INCLUDE_DIRS};${INCLUDE_DIRS}>"
-  "$<INSTALL_INTERFACE:${PUBLIC_INCLUDE_DIRS}>")
+  "$<BUILD_INTERFACE:${PUBLIC_INCLUDE_DIRS};${INCLUDE_DIRS}>")
   
 TARGET_LINK_LIBRARIES(rtabmap_core 
   PUBLIC 
--- a/utilite/src/CMakeLists.txt
+++ b/utilite/src/CMakeLists.txt
@@ -21,7 +21,7 @@
 
 target_include_directories(rtabmap_utilite PUBLIC 
   "$<BUILD_INTERFACE:${CMAKE_CURRENT_SOURCE_DIR}/../include;${CMAKE_CURRENT_BINARY_DIR}/include;${PTHREADS_INCLUDE_DIR}>"
-  "$<INSTALL_INTERFACE:${INSTALL_INCLUDE_DIR};${PTHREADS_INCLUDE_DIR}>")
+  "$<INSTALL_INTERFACE:${INSTALL_INCLUDE_DIR}>")
 
 IF(MINGW)
     TARGET_LINK_LIBRARIES(rtabmap_utilite PRIVATE ${PTHREADS_LIBRARY} "-lpsapi")
