+namespace {
+class RvlInput
+{
+public:
+    RvlInput(const unsigned char *input, std::size_t size) :
+        input_(input), remaining_(size), word_(0), nibbles_(0) {}
+
+    bool read(uint32_t &value)
+    {
+        value = 0;
+        for (unsigned int shift = 0; shift <= 30; shift += 3)
+        {
+            if (!nibbles_)
+            {
+                if (remaining_ < sizeof(word_)) return false;
+                std::memcpy(&word_, input_, sizeof(word_));
+                input_ += sizeof(word_);
+                remaining_ -= sizeof(word_);
+                nibbles_ = 8;
+            }
+            const uint32_t nibble = word_ >> 28;
+            const uint32_t payload = nibble & 7u;
+            if (payload > (std::numeric_limits<uint32_t>::max() >> shift)) return false;
+            value |= payload << shift;
+            word_ <<= 4;
+            --nibbles_;
+            if (!(nibble & 8u)) return true;
+        }
+        return false;
+    }
+
+private:
+    const unsigned char *input_;
+    std::size_t remaining_;
+    uint32_t word_;
+    int nibbles_;
+};
+}
+
+bool RvlCodec::DecompressRVL(const unsigned char *input, std::size_t inputSize,
+                            uint16_t *output, int numPixels)
+{
+    if (!input || !output || numPixels <= 0 || inputSize % sizeof(uint32_t)) return false;
+    RvlInput reader(input, inputSize);
+    uint32_t remaining = static_cast<uint32_t>(numPixels);
+    int previous = 0;
+    while (remaining)
+    {
+        uint32_t zeros, nonzeros;
+        if (!reader.read(zeros) || zeros > remaining) return false;
+        std::fill_n(output, zeros, uint16_t(0));
+        output += zeros;
+        remaining -= zeros;
+        if (!reader.read(nonzeros) || nonzeros > remaining || (!zeros && !nonzeros)) return false;
+        remaining -= nonzeros;
+        for (uint32_t i = 0; i < nonzeros; ++i)
+        {
+            uint32_t positive;
+            if (!reader.read(positive) || positive > 131070u) return false;
+            const int delta = positive & 1u ? -int(positive / 2) - 1 : int(positive / 2);
+            const int current = previous + delta;
+            if (current <= 0 || current > std::numeric_limits<uint16_t>::max()) return false;
+            *output++ = static_cast<uint16_t>(current);
+            previous = current;
+        }
+    }
+    return true;
+}
