# SPDX-License-Identifier: MIT
# Origin: EmberBSD (AI-assisted). Shared C++ CPU factor-graph profile.
set(BUILD_SHARED_LIBS ON CACHE BOOL "")
# NetBSD and the native POSIX controls provide libm. Keep its exported link
# interface independent of the absolute sysroot used during configuration.
set(MATH_LIBRARY m CACHE STRING "Base OS math linker name")
# The stable CPU library uses std::thread even when TBB is disabled.
set(GTSAM_ADDITIONAL_LIBRARIES pthread CACHE STRING "Base POSIX thread library")
set(GTSAM_BUILD_TESTS ON CACHE BOOL "")
set(GTSAM_BUILD_WITH_WERROR ON CACHE BOOL "")
set(GTSAM_BUILD_TYPE_POSTFIXES OFF CACHE BOOL "")
set(GTSAM_USE_SYSTEM_EIGEN ON CACHE BOOL "")
set(GTSAM_USE_SYSTEM_CCOLAMD OFF CACHE BOOL "Upstream private namespaced vendor")
set(GTSAM_USE_SYSTEM_SPECTRA OFF CACHE BOOL "Upstream private headers")
set(GTSAM_SUPPORT_NESTED_DISSECTION OFF CACHE BOOL "")
set(GTSAM_USE_BOOST_FEATURES OFF CACHE BOOL "")
set(GTSAM_ENABLE_BOOST_SERIALIZATION OFF CACHE BOOL "")
set(GTSAM_WITH_TBB OFF CACHE BOOL "")
set(GTSAM_WITH_EIGEN_MKL OFF CACHE BOOL "")
set(GTSAM_ENABLE_CUDA OFF CACHE BOOL "")
set(GTSAM_ENABLE_GEOGRAPHICLIB OFF CACHE BOOL "")
set(GTSAM_BUILD_EXAMPLES_ALWAYS OFF CACHE BOOL "")
set(GTSAM_BUILD_TIMING_ALWAYS OFF CACHE BOOL "")
set(GTSAM_BUILD_UNSTABLE OFF CACHE BOOL "")
set(GTSAM_BUILD_PYTHON OFF CACHE BOOL "")
set(GTSAM_INSTALL_MATLAB_TOOLBOX OFF CACHE BOOL "")
set(GTSAM_BUILD_WITH_MARCH_NATIVE OFF CACHE BOOL "")
set(GTSAM_BUILD_WITH_PRECOMPILED_HEADERS OFF CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_CHOLMOD ON CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_Ceres ON CACHE BOOL "")
set(CMAKE_DISABLE_FIND_PACKAGE_Doxygen ON CACHE BOOL "")
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "")
set(FETCHCONTENT_UPDATES_DISCONNECTED ON CACHE BOOL "")
