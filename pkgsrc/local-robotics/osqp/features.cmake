# SPDX-License-Identifier: MIT
# Origin: EmberBSD, AI-assisted shared native and cross OSQP build policy.
set(CMAKE_BUILD_TYPE Release CACHE STRING "Package build type")
set(CMAKE_INSTALL_LIBDIR lib CACHE PATH "Library and CMake export directory")
set(OSQP_ALGEBRA_BACKEND builtin CACHE STRING "QDLDL direct algebra backend")
set(OSQP_BUILD_SHARED_LIB ON CACHE BOOL "Install the upstream shared library")
set(OSQP_BUILD_STATIC_LIB OFF CACHE BOOL "Keep test archives outside the package")
set(OSQP_BUILD_DEMO_EXE OFF CACHE BOOL "Library package")
set(OSQP_BUILD_UNITTESTS OFF CACHE BOOL "Use a separate static upstream test build")
set(OSQP_USE_FLOAT OFF CACHE BOOL "Use double precision")
set(OSQP_USE_LONG ON CACHE BOOL "Use 64-bit indices")
set(OSQP_ENABLE_DERIVATIVES ON CACHE BOOL "Preserve adjoint derivative support")
set(OSQP_ENABLE_PROFILING ON CACHE BOOL "Measure solver timing")
set(OSQP_ENABLE_PRINTING ON CACHE BOOL "Preserve solver diagnostics")
set(OSQP_ENABLE_INTERRUPT ON CACHE BOOL "Preserve the POSIX signal listener")
set(OSQP_CODEGEN OFF CACHE BOOL "Package the solver without code generation")
set(OSQP_PROFILER_ANNOTATIONS OFF CACHE STRING "No external profiler dependency")
set(FETCHCONTENT_FULLY_DISCONNECTED ON CACHE BOOL "Use verified package archives")
set(FETCHCONTENT_UPDATES_DISCONNECTED ON CACHE BOOL "Do not fetch during configure")
