set(CMAKE_CXX_STANDARD 17 CACHE STRING "")
set(CMAKE_CXX_STANDARD_REQUIRED ON CACHE BOOL "")
set(CMAKE_CXX_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "")
set(CMAKE_C_FLAGS_RELEASE "-O2 -DNDEBUG" CACHE STRING "")
set(BUILD_SHARED_LIBS ON CACHE BOOL "")
set(BUILD_LIST "core,imgproc,imgcodecs,features,geometry,stereo,calib,video,stitching,photo,videoio" CACHE STRING "")
foreach(feature TESTS PERF_TESTS EXAMPLES opencv_apps JAVA opencv_python3 opencv_python2)
  set(BUILD_${feature} OFF CACHE BOOL "")
endforeach()
foreach(feature LAPACK OPENCL IPP ITT KLEIDICV CAROTENE VULKAN CUDA PROTOBUF UNIFONT FFMPEG GSTREAMER V4L OBSENSOR GTK QT AVIF TIFF WEBP OPENEXR OPENJPEG JASPER)
  set(WITH_${feature} OFF CACHE BOOL "")
endforeach()
set(WITH_EIGEN ON CACHE BOOL "")
set(WITH_JPEG ON CACHE BOOL "")
set(BUILD_JPEG OFF CACHE BOOL "")
set(WITH_PNG ON CACHE BOOL "")
set(BUILD_PNG OFF CACHE BOOL "")
set(BUILD_ZLIB OFF CACHE BOOL "")
set(OPENCV_GENERATE_PKGCONFIG ON CACHE BOOL "")
set(OPENCV_DOWNLOAD_TRIES_LIST "" CACHE STRING "")
